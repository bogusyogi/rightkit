{
  "name": "rke2e",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "prepare": "rightkit-gate install-hook",
    "check": "rightkit-gate check",
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "pnpm exec vite build",
    "typecheck": "tsc --noEmit",
    "brand:sync": "rightkit-theme generate assets/brand/brand.json --out src/brand.css --format tailwind",
    "brand:check": "rightkit-theme generate assets/brand/brand.json --out src/brand.css --format tailwind --check",
    "test": "pnpm run test:rust && pnpm run test:e2e",
    "test:rust": "rightkit-gate --to test",
    "test:e2e": "pnpm run build && rightkit-qa journeys run",
    "dev:build:win": "right-release dev --platform win",
    "dev:build:mac": "right-release dev --platform mac",
    "release:doctor": "right-release doctor",
    "release:build:mac": "right-release build --platform mac",
    "release:build:win": "right-release build --platform win",
    "release:upload:patch:mac": "right-release upload --config right-release.config.json --platform mac --tier patch",
    "release:upload:patch:win": "right-release upload --config right-release.config.json --platform win --tier patch",
    "release:upload:update:mac": "right-release upload --config right-release.config.json --platform mac --tier update",
    "release:upload:update:win": "right-release upload --config right-release.config.json --platform win --tier update",
    "deps:check": "right-release deps --check",
    "deps:audit": "right-release deps --audit",
    "deps:update": "right-release deps --update",
    "probes": "rke2e-engine probe all"
  },
  "dependencies": {
    "@rightkit/app-update": "link:../packages/app-update",
    "@rightkit/doc-render": "link:../packages/doc-render",
    "@rightkit/i18n": "link:../packages/i18n",
    "@rightkit/legal": "link:../packages/legal",
    "@rightkit/legal-ui": "link:../packages/legal-ui",
    "@rightkit/license": "link:../packages/license",
    "@rightkit/logs": "link:../packages/logs",
    "@rightkit/media-ui": "link:../packages/media-ui",
    "@rightkit/onboarding": "link:../packages/onboarding",
    "@rightkit/pdf-ui": "link:../packages/pdf-ui",
    "@rightkit/platform-ui": "link:../packages/platform-ui",
    "@rightkit/react-shell": "link:../packages/react-shell",
    "@rightkit/settings-ui": "link:../packages/settings-ui",
    "@rightkit/tauri": "link:../packages/tauri",
    "@rightkit/tauri-shell": "link:../packages/tauri-shell",
    "@rightkit/theme": "link:../packages/theme",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-os": "2.4.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@rightkit/ax": "link:../packages/ax",
    "@rightkit/build-control-policy": "link:../packages/build-control-policy",
    "@rightkit/ci": "link:../packages/ci",
    "@rightkit/hooks": "link:../packages/hooks",
    "@rightkit/issues-tracker": "link:../packages/issues-tracker",
    "@rightkit/outdated": "link:../packages/outdated",
    "@rightkit/qa": "link:../packages/qa",
    "@rightkit/qa-chrome": "link:../packages/qa-chrome",
    "@rightkit/release": "link:../packages/release",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}

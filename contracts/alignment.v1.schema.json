{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rightkit:contract:alignment:v1",
  "title": "RightKit alignment (v1)",
  "description": "The result of aligning a written script to the timed words an ASR engine returned (rightkit-align, local route). The document has one token row per script token, in script order, each echoing its word_id, step_id and, when designated, target_id. Rows are never identified by label text. Accepted rows carry a span in milliseconds and in ASR samples at the sample rate the aligner was given. timing_confidence is the lattice bound clamp(timing_tolerance_ms / lattice_ms, 0, 1) for model-timed words, multiplied by lexical_confidence. Clauses are split on script punctuation, newlines and step changes, and a clause is emitted only when its first and last spoken tokens are accepted. The identity is the contract and contractVersion keys, as in the sibling contracts: contract rightkit.alignment, version 1.0.x. CutRight's proposed schema rightkit.alignment.v1 maps onto these two keys. Consumers reject any other contract name or version.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contractVersion", "route", "tokens", "clauses", "coverage", "timing_tolerance_ms"],
  "properties": {
    "contract": { "const": "rightkit.alignment" },
    "contractVersion": { "$ref": "#/$defs/contractVersion" },
    "route": { "$ref": "#/$defs/route" },
    "tokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/token" }
    },
    "clauses": {
      "type": "array",
      "items": { "$ref": "#/$defs/clause" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "timing_tolerance_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.[0-9]+$"
    },
    "route": {
      "type": "string",
      "enum": ["local"]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "start_sample", "end_sample", "sample_rate"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "start_sample": { "type": "integer", "minimum": 0 },
        "end_sample": { "type": "integer", "minimum": 0 },
        "sample_rate": { "type": "integer", "minimum": 1 }
      }
    },
    "outcome": {
      "description": "Discriminated by status. An accepted outcome carries the span fields flat, not nested.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "start_ms", "end_ms", "start_sample", "end_sample", "sample_rate"],
          "properties": {
            "status": { "const": "accepted" },
            "start_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 0 },
            "start_sample": { "type": "integer", "minimum": 0 },
            "end_sample": { "type": "integer", "minimum": 0 },
            "sample_rate": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "rejected" },
            "reason": { "$ref": "#/$defs/rejectReason" }
          }
        }
      ]
    },
    "rejectReason": {
      "type": "string",
      "enum": ["no_spoken_form", "unaligned", "ambiguous", "word_differs"]
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_id",
        "step_id",
        "target_id",
        "text",
        "outcome",
        "lexical_confidence",
        "timing_confidence",
        "asr_confidence",
        "asr_text"
      ],
      "properties": {
        "word_id": { "type": "string", "minLength": 1 },
        "step_id": { "type": "string", "minLength": 1 },
        "target_id": { "type": ["string", "null"], "minLength": 1 },
        "text": { "type": "string" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "lexical_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "timing_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "asr_confidence": { "type": ["number", "null"] },
        "asr_text": { "type": ["string", "null"] }
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "step_id", "first_word_id", "last_word_id", "start", "end"],
      "properties": {
        "clause_id": { "type": "string", "minLength": 1 },
        "step_id": { "type": "string", "minLength": 1 },
        "first_word_id": { "type": "string", "minLength": 1 },
        "last_word_id": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/span" },
        "end": { "$ref": "#/$defs/span" }
      }
    },
    "coverageFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_id", "target_id", "reason"],
      "properties": {
        "word_id": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 },
        "reason": {
          "oneOf": [
            { "$ref": "#/$defs/rejectReason" },
            { "type": "null" }
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designated", "accepted", "failures"],
      "properties": {
        "designated": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "integer", "minimum": 0 },
        "failures": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverageFailure" }
        }
      }
    }
  }
}

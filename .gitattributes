# Shell scripts run under bash on every runner, including Windows: always LF.
*.sh text eol=lf
# CI contracts & workflow bytes must match native checkouts & hosted runners.
/scripts/ci/*.mjs text eol=lf
/.github/workflows/*.yml text eol=lf
# Reviewed registry-consumer recipes are pinned by raw file hash.
/ci/consumers/** -text
# Vendored sources are hashed byte for byte: never convert their line endings.
crates/rightkit-tts-qwen-sys/vendor/** -text
# PDFs are binary even when every byte is ASCII: a converted line ending breaks the xref offsets.
*.pdf binary
# The vendored plugin schemas are pinned by digest (packages/ax/plugin/schemas/pins.json, invariant I4):
# a converted line ending changes the hash and right-ax refuses to run from the checkout.
packages/ax/plugin/schemas/*.json -text
# The ownership fixtures are compared byte for byte with what generate.mjs writes (LF): never convert them.
packages/release/fixtures/ownership/** -text
# The EmbeddingGemma 2 export scripts are listed with SHA-256 in their FILES.txt: never convert their line endings.
scripts/embed-export/** -text
# The MSIX repair guard is pinned by sha256 in consumers (SwiftRightBridge): always LF, never converted.
packages/release/msix-repair-guard.ps1 text eol=lf
# Vendored tauri-runtime-wry (docs/design/tauri-runtime-wry-windows-rc.md): keep upstream bytes, never convert line endings.
vendor/tauri-runtime-wry/** -text
# Named npm consumer evidence binds source & recipe bytes across both native hosts.
/ci/consumers/npm-logs/** text eol=lf
/ci/consumer-recipes.json text eol=lf
/package.json text eol=lf
/packages/logs/package.json text eol=lf
/packages/logs/README.md text eol=lf
/packages/logs/src/index.ts text eol=lf
/packages/logs/src/crash.ts text eol=lf
/packages/logs/src/recorder.ts text eol=lf
/crates/rightkit-logs/tests/scrub-parity.v1.json text eol=lf
/crates/rightkit-logs/benches/workloads.json text eol=lf

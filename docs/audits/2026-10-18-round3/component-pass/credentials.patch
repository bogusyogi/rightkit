diff --git a/crates/rightkit-credentials/src/owner_key.rs b/crates/rightkit-credentials/src/owner_key.rs
new file mode 100644
index 0000000..7f371ea
--- /dev/null
+++ b/crates/rightkit-credentials/src/owner_key.rs
@@ -0,0 +1,98 @@
+//! Verifying approvals signed by a hardware-backed owner key.
+//!
+//! The signing side lives where the key does: a P-256 key in the Secure Enclave, created and used
+//! by RightKitSwift's `OwnerKey` (CryptoKit). A TPM-backed signing key on Windows is not part of
+//! this crate (see the changelog). This module is the Rust verify side, for the process
+//! that decides whether an approval is genuine: it takes the enrolled public key (the 65-byte
+//! uncompressed X9.63 point, CryptoKit `x963Representation`), the exact signed bytes, and the
+//! signature, either 64 raw bytes (`r | s`, CryptoKit `rawRepresentation`) or ASN.1 DER.
+//!
+//! It checks the signature only. The signed message's format, freshness window and nonce
+//! consumption are the caller's policy and must be enforced there.
+
+use ring::digest::{digest, SHA256};
+use ring::signature::{UnparsedPublicKey, ECDSA_P256_SHA256_ASN1, ECDSA_P256_SHA256_FIXED};
+
+/// Length of an uncompressed P-256 public key (`0x04 | x | y`).
+pub const P256_PUBLIC_KEY_LEN: usize = 65;
+
+/// The stable identifier of an owner key: the first 16 bytes of SHA-256 over the public key, as
+/// lowercase hex (32 characters). Matches RightKitSwift `OwnerKey.keyId(of:)`.
+pub fn owner_key_id(public_key: &[u8]) -> String {
+    crate::seal::to_hex(&digest(&SHA256, public_key).as_ref()[..16])
+}
+
+/// Whether `signature` is an ECDSA P-256 / SHA-256 signature of `message` under `public_key`.
+/// A 64-byte signature is read as raw `r | s` and any other length as ASN.1 DER; a 64-byte
+/// signature that does not verify raw is also tried as DER (a DER signature with short integers can
+/// be 64 bytes long). Either way the answer is a real ECDSA verification: nothing else passes. A
+/// public key that is not a 65-byte uncompressed point never verifies.
+pub fn verify_p256(public_key: &[u8], message: &[u8], signature: &[u8]) -> bool {
+    if public_key.len() != P256_PUBLIC_KEY_LEN || public_key[0] != 0x04 {
+        return false;
+    }
+    let ok = |algorithm: &'static dyn ring::signature::VerificationAlgorithm| {
+        UnparsedPublicKey::new(algorithm, public_key)
+            .verify(message, signature)
+            .is_ok()
+    };
+    if signature.len() == 64 {
+        ok(&ECDSA_P256_SHA256_FIXED) || ok(&ECDSA_P256_SHA256_ASN1)
+    } else {
+        ok(&ECDSA_P256_SHA256_ASN1)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ring::rand::SystemRandom;
+    use ring::signature::{EcdsaKeyPair, KeyPair, ECDSA_P256_SHA256_ASN1_SIGNING, ECDSA_P256_SHA256_FIXED_SIGNING};
+
+    fn pair(alg: &'static ring::signature::EcdsaSigningAlgorithm) -> EcdsaKeyPair {
+        let rng = SystemRandom::new();
+        let pkcs8 = EcdsaKeyPair::generate_pkcs8(alg, &rng).unwrap();
+        EcdsaKeyPair::from_pkcs8(alg, pkcs8.as_ref(), &rng).unwrap()
+    }
+
+    #[test]
+    fn raw_and_der_signatures_verify_and_tampering_does_not() {
+        let rng = SystemRandom::new();
+        let fixed = pair(&ECDSA_P256_SHA256_FIXED_SIGNING);
+        let message = b"app.approval.v1\nkind:unlock";
+        let raw = fixed.sign(&rng, message).unwrap();
+        assert_eq!(raw.as_ref().len(), 64);
+        let public = fixed.public_key().as_ref().to_vec();
+        assert!(verify_p256(&public, message, raw.as_ref()));
+        assert!(!verify_p256(&public, b"other message", raw.as_ref()));
+        let mut bad = raw.as_ref().to_vec();
+        bad[10] ^= 1;
+        assert!(!verify_p256(&public, message, &bad));
+
+        let der = pair(&ECDSA_P256_SHA256_ASN1_SIGNING);
+        let signature = der.sign(&rng, message).unwrap();
+        assert!(verify_p256(der.public_key().as_ref(), message, signature.as_ref()));
+        // Another key's public point does not verify this signature.
+        assert!(!verify_p256(&public, message, signature.as_ref()));
+    }
+
+    #[test]
+    fn malformed_public_keys_and_signatures_never_verify() {
+        let rng = SystemRandom::new();
+        let key = pair(&ECDSA_P256_SHA256_FIXED_SIGNING);
+        let raw = key.sign(&rng, b"m").unwrap();
+        let public = key.public_key().as_ref().to_vec();
+        assert!(!verify_p256(&public[..64], b"m", raw.as_ref()));
+        let mut compressed_tag = public.clone();
+        compressed_tag[0] = 0x02;
+        assert!(!verify_p256(&compressed_tag, b"m", raw.as_ref()));
+        assert!(!verify_p256(&public, b"m", &[]));
+        assert!(!verify_p256(&[], b"m", raw.as_ref()));
+    }
+
+    #[test]
+    fn key_id_is_sixteen_bytes_of_sha256_in_hex() {
+        // SHA-256("abc") = ba7816bf8f01cfea414140de5dae2223...
+        assert_eq!(owner_key_id(b"abc"), "ba7816bf8f01cfea414140de5dae2223");
+    }
+}
diff --git a/crates/rightkit-credentials/src/partition.rs b/crates/rightkit-credentials/src/partition.rs
new file mode 100644
index 0000000..3950e32
--- /dev/null
+++ b/crates/rightkit-credentials/src/partition.rs
@@ -0,0 +1,512 @@
+//! Keychain partition-list verification (macOS), plus the platform-independent parsing and policy.
+//!
+//! Security gives every keychain item a partition list when it is created, from the code signature
+//! of the creating process: `teamid:<team>` for Developer ID code, `cdhash:<hash>` for ad-hoc code,
+//! `apple-tool:` for the `security` command, `apple:` for Apple's own. Another process cannot change
+//! the list without the keychain password, so an item that carries exactly the expected team was
+//! created by code signed by that team.
+//!
+//! The read and the check are pinned to the user's LOGIN keychain by path (taken from the account
+//! database, not `$HOME`): an item in any other keychain, for example one an attacker made the
+//! default, is never read or trusted, and the call fails closed unless the default keychain is the
+//! login keychain.
+//!
+//! This is defence in depth, not a boundary: a process of the same user can make a keychain of its
+//! own with a matching partition list and move it onto the login keychain's path. Seal the stored
+//! value too (see [`crate::Sealer`] and [`crate::PinSealKey`]).
+
+use crate::error::{Error, Result};
+#[cfg(target_os = "macos")]
+pub use mac::{read_login_keychain_item, verify_login_keychain_item};
+
+/// Which partition lists are accepted.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PartitionPolicy {
+    /// Every partition entry is exactly `teamid:<team>`. Build it with [`PartitionPolicy::team`].
+    Team(String),
+    /// TEST ONLY: any partition except Apple's own tools, so an unsigned test build still works.
+    /// Compiled only in this crate's tests and under the `isolated-test-keychain` feature.
+    #[cfg(any(test, feature = "isolated-test-keychain"))]
+    AnyNonApple,
+}
+
+impl PartitionPolicy {
+    /// A policy for one Apple Developer team id (10 ASCII letters and digits, e.g. `6KLGD3LLKF`).
+    pub fn team(team_id: &str) -> Result<Self> {
+        if team_id.len() == 10 && team_id.bytes().all(|b| b.is_ascii_uppercase() || b.is_ascii_digit()) {
+            Ok(PartitionPolicy::Team(team_id.to_string()))
+        } else {
+            Err(Error::Invalid {
+                what: "team id",
+                reason: "must be 10 uppercase letters or digits".into(),
+            })
+        }
+    }
+}
+
+/// Judges the partition tokens of an item against `policy`. An item with no tokens is refused.
+pub fn judge_partitions(tokens: &[String], policy: &PartitionPolicy) -> Result<()> {
+    if tokens.is_empty() {
+        return Err(untrusted("the keychain item carries no partition list"));
+    }
+    let accepted = match policy {
+        PartitionPolicy::Team(team) => {
+            let own = format!("teamid:{team}");
+            tokens.iter().all(|t| *t == own)
+        }
+        #[cfg(any(test, feature = "isolated-test-keychain"))]
+        PartitionPolicy::AnyNonApple => tokens.iter().all(|t| !t.starts_with("apple")),
+    };
+    if accepted {
+        Ok(())
+    } else {
+        Err(untrusted("the keychain item was not created by the expected signed code (its partition list differs)"))
+    }
+}
+
+fn untrusted(reason: &str) -> Error {
+    Error::Invalid {
+        what: "keychain item",
+        reason: reason.to_string(),
+    }
+}
+
+/// Every partition token in the description text of an item's partition-ID entries (the list is a
+/// property list, usually hex-encoded; either form is read).
+pub fn partition_tokens_from_description(text: &str) -> Vec<String> {
+    partition_tokens(&description_bytes(text))
+}
+
+/// The description is the partition list as a property list, usually hex-encoded; read either form
+/// as bytes (a binary list keeps its strings as plain ASCII).
+fn description_bytes(text: &str) -> Vec<u8> {
+    let hex = text.trim();
+    if !hex.is_empty() && hex.len().is_multiple_of(2) && hex.bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        let decoded: Option<Vec<u8>> = (0..hex.len() / 2)
+            .map(|i| u8::from_str_radix(&hex[2 * i..2 * i + 2], 16).ok())
+            .collect();
+        if let Some(bytes) = decoded {
+            return bytes;
+        }
+    }
+    text.as_bytes().to_vec()
+}
+
+/// Every partition token in `bytes`: `teamid:<team>`, `cdhash:<hex>`, `apple-tool:`, `apple:`.
+fn partition_tokens(bytes: &[u8]) -> Vec<String> {
+    const PREFIXES: [&str; 4] = ["teamid:", "cdhash:", "apple-tool:", "apple:"];
+    let mut tokens = Vec::new();
+    let mut run = String::new();
+    let mut flush = |run: &mut String| {
+        let mut rest = run.as_str();
+        loop {
+            let found = PREFIXES
+                .iter()
+                .filter_map(|p| rest.find(p).map(|at| (at, *p)))
+                .min_by_key(|(at, _)| *at);
+            let Some((at, prefix)) = found else { break };
+            let after = &rest[at + prefix.len()..];
+            let tail = if prefix.starts_with("team") || prefix.starts_with("cdhash") {
+                after
+                    .find(|c: char| !c.is_ascii_alphanumeric())
+                    .unwrap_or(after.len())
+            } else {
+                0
+            };
+            tokens.push(format!("{prefix}{}", &after[..tail]));
+            rest = &after[tail..];
+        }
+        run.clear();
+    };
+    for &b in bytes {
+        if b.is_ascii_alphanumeric() || matches!(b, b':' | b'-' | b'_' | b'.') {
+            run.push(b as char);
+        } else {
+            flush(&mut run);
+        }
+    }
+    flush(&mut run);
+    tokens
+}
+
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn team() -> PartitionPolicy {
+        PartitionPolicy::team("6KLGD3LLKF").unwrap()
+    }
+
+    fn tokens(list: &[&str]) -> Vec<String> {
+        list.iter().map(|s| s.to_string()).collect()
+    }
+
+    #[test]
+    fn team_ids_are_validated() {
+        assert!(PartitionPolicy::team("6KLGD3LLKF").is_ok());
+        for bad in ["", "6klgd3llkf", "6KLGD3LLK", "6KLGD3LLKFX", "6KLGD3LLK:"] {
+            assert!(PartitionPolicy::team(bad).is_err(), "{bad}");
+        }
+    }
+
+    #[test]
+    fn only_the_exact_team_is_trusted() {
+        assert!(judge_partitions(&tokens(&["teamid:6KLGD3LLKF"]), &team()).is_ok());
+        assert!(judge_partitions(&tokens(&["teamid:6KLGD3LLKF", "teamid:6KLGD3LLKF"]), &team()).is_ok());
+        assert!(judge_partitions(&tokens(&["teamid:6KLGD3LLKF", "apple:"]), &team()).is_err());
+        assert!(judge_partitions(&tokens(&["teamid:ABCDEFGHIJ"]), &team()).is_err());
+        assert!(judge_partitions(&tokens(&["cdhash:abcdef"]), &team()).is_err());
+        assert!(judge_partitions(&tokens(&["apple-tool:"]), &team()).is_err());
+        assert!(judge_partitions(&[], &team()).is_err());
+        // A longer team id with the expected one as a prefix is a different team.
+        assert!(judge_partitions(&tokens(&["teamid:6KLGD3LLKFX"]), &team()).is_err());
+    }
+
+    #[test]
+    fn the_test_policy_refuses_apple_partitions() {
+        let any = PartitionPolicy::AnyNonApple;
+        assert!(judge_partitions(&tokens(&["cdhash:abcdef"]), &any).is_ok());
+        assert!(judge_partitions(&tokens(&["apple-tool:"]), &any).is_err());
+        assert!(judge_partitions(&tokens(&["apple:"]), &any).is_err());
+        assert!(judge_partitions(&[], &any).is_err());
+    }
+
+    #[test]
+    fn tokens_are_found_in_text_and_hex_descriptions() {
+        let plain = partition_tokens_from_description("junk teamid:6KLGD3LLKF\0cdhash:0123abcd apple-tool: apple:");
+        assert!(plain.contains(&"teamid:6KLGD3LLKF".to_string()));
+        assert!(plain.contains(&"cdhash:0123abcd".to_string()));
+        assert!(plain.contains(&"apple-tool:".to_string()));
+        assert!(plain.contains(&"apple:".to_string()));
+
+        let hex: String = b"\x00teamid:6KLGD3LLKF\x00".iter().map(|b| format!("{b:02x}")).collect();
+        assert_eq!(partition_tokens_from_description(&hex), vec!["teamid:6KLGD3LLKF".to_string()]);
+        assert!(partition_tokens_from_description("").is_empty());
+    }
+}
+
+#[cfg(target_os = "macos")]
+mod mac {
+    use super::{judge_partitions, PartitionPolicy};
+    use crate::error::{Error, Result};
+    use crate::secret::Secret;
+    use std::ffi::{c_char, c_void, CString, OsStr};
+    use std::os::unix::ffi::OsStrExt;
+    use std::path::{Path, PathBuf};
+    use std::ptr::{null, null_mut};
+
+    type OSStatus = i32;
+    type CFIndex = isize;
+
+    /// `kSecPreferencesDomainUser`; the same domain `rightkit-credentials` writes to.
+    const DOMAIN_USER: i32 = 0;
+    const UTF8: u32 = 0x0800_0100;
+    /// `errSecItemNotFound`.
+    const NOT_FOUND: OSStatus = -25300;
+
+    #[link(name = "Security", kind = "framework")]
+    extern "C" {
+        fn SecKeychainCopyDomainDefault(domain: i32, out: *mut *mut c_void) -> OSStatus;
+        fn SecKeychainOpen(path: *const c_char, out: *mut *mut c_void) -> OSStatus;
+        fn SecKeychainGetPath(kc: *const c_void, len: *mut u32, path: *mut c_char) -> OSStatus;
+        fn SecKeychainItemCopyKeychain(item: *mut c_void, kc: *mut *mut c_void) -> OSStatus;
+        fn SecKeychainItemFreeContent(attrs: *const c_void, data: *mut c_void) -> OSStatus;
+        fn SecKeychainSetUserInteractionAllowed(allowed: u8) -> OSStatus;
+        fn SecKeychainGetUserInteractionAllowed(allowed: *mut u8) -> OSStatus;
+        fn SecKeychainFindGenericPassword(
+            kc: *const c_void,
+            service_len: u32,
+            service: *const c_char,
+            account_len: u32,
+            account: *const c_char,
+            password_len: *mut u32,
+            password: *mut *mut c_void,
+            item: *mut *mut c_void,
+        ) -> OSStatus;
+        fn SecKeychainItemCopyAccess(item: *mut c_void, access: *mut *mut c_void) -> OSStatus;
+        fn SecAccessCopyMatchingACLList(access: *mut c_void, tag: *const c_void) -> *const c_void;
+        fn SecACLCopyContents(
+            acl: *mut c_void,
+            applications: *mut *const c_void,
+            description: *mut *const c_void,
+            prompt_selector: *mut u16,
+        ) -> OSStatus;
+    }
+
+    #[link(name = "CoreFoundation", kind = "framework")]
+    extern "C" {
+        fn CFRelease(cf: *const c_void);
+        fn CFArrayGetCount(array: *const c_void) -> CFIndex;
+        fn CFArrayGetValueAtIndex(array: *const c_void, index: CFIndex) -> *const c_void;
+        fn CFStringCreateWithCString(
+            allocator: *const c_void,
+            text: *const c_char,
+            encoding: u32,
+        ) -> *const c_void;
+        fn CFStringGetLength(text: *const c_void) -> CFIndex;
+        fn CFStringGetMaximumSizeForEncoding(length: CFIndex, encoding: u32) -> CFIndex;
+        fn CFStringGetCString(
+            text: *const c_void,
+            buffer: *mut c_char,
+            size: CFIndex,
+            encoding: u32,
+        ) -> u8;
+    }
+
+    /// Releases a Core Foundation object on drop.
+    struct Cf(*const c_void);
+
+    impl Drop for Cf {
+        fn drop(&mut self) {
+            if !self.0.is_null() {
+                // SAFETY: the pointer came from a Create or Copy call and is released exactly once.
+                unsafe { CFRelease(self.0) };
+            }
+        }
+    }
+
+    fn cf_string(text: *const c_void) -> Option<String> {
+        if text.is_null() {
+            return None;
+        }
+        // SAFETY: `text` is a live CFString owned by the caller; the buffer is sized by
+        // CFStringGetMaximumSizeForEncoding plus the terminator and CFStringGetCString NUL-terminates.
+        unsafe {
+            let size = CFStringGetMaximumSizeForEncoding(CFStringGetLength(text), UTF8) + 1;
+            let mut buffer = vec![0 as c_char; usize::try_from(size).ok()?];
+            if CFStringGetCString(text, buffer.as_mut_ptr(), size, UTF8) == 0 {
+                return None;
+            }
+            Some(
+                std::ffi::CStr::from_ptr(buffer.as_ptr())
+                    .to_string_lossy()
+                    .into_owned(),
+            )
+        }
+    }
+
+    /// The login keychain file of the current user, from the account database (not `$HOME`, which any
+    /// parent process can set).
+    fn login_path() -> std::result::Result<PathBuf, String> {
+        // SAFETY: `getpwuid_r` fills `pwd` with strings that live in `buffer`, which outlives the copy.
+        unsafe {
+            let mut buffer = vec![0 as c_char; 4096];
+            let mut pwd: libc::passwd = std::mem::zeroed();
+            let mut found: *mut libc::passwd = null_mut();
+            let rc = libc::getpwuid_r(
+                libc::geteuid(),
+                &mut pwd,
+                buffer.as_mut_ptr(),
+                buffer.len(),
+                &mut found,
+            );
+            if rc != 0 || found.is_null() || pwd.pw_dir.is_null() {
+                return Err("the home folder is unknown".into());
+            }
+            let home = std::ffi::CStr::from_ptr(pwd.pw_dir).to_bytes();
+            let keychains = PathBuf::from(OsStr::from_bytes(home)).join("Library/Keychains");
+            // Older accounts keep the legacy name; the current one is `login.keychain-db`.
+            let current = keychains.join("login.keychain-db");
+            let legacy = keychains.join("login.keychain");
+            Ok(if !current.exists() && legacy.exists() {
+                legacy
+            } else {
+                current
+            })
+        }
+    }
+
+    /// The file a keychain reference points at, resolved.
+    fn keychain_file(keychain: *const c_void) -> std::result::Result<PathBuf, String> {
+        let mut buffer = vec![0 as c_char; 1025];
+        let mut len: u32 = 1024;
+        // SAFETY: the buffer holds `len` bytes; `len` is set to the length written.
+        let status = unsafe { SecKeychainGetPath(keychain, &mut len, buffer.as_mut_ptr()) };
+        if status != 0 {
+            return Err(format!("a keychain's file cannot be read ({status})"));
+        }
+        let bytes: Vec<u8> = buffer[..len as usize].iter().map(|&c| c as u8).collect();
+        std::fs::canonicalize(OsStr::from_bytes(&bytes))
+            .map_err(|_| "a keychain's file cannot be resolved".to_string())
+    }
+
+    /// The user's login keychain, opened by its path. Fails closed unless the user's default keychain
+    /// is that same file, because the engine writes its item through the default (`rightkit-credentials`)
+    /// and an attacker's keychain made the default must not be where the app writes, or reads.
+    fn login_keychain() -> std::result::Result<(Cf, PathBuf), String> {
+        let login = std::fs::canonicalize(login_path()?)
+            .map_err(|_| "the login keychain file is missing".to_string())?;
+        let path = CString::new(login.as_os_str().as_bytes()).map_err(|_| "the keychain path")?;
+        // SAFETY: the path is a NUL-terminated string; the references returned are owned by `Cf`.
+        unsafe {
+            let mut opened: *mut c_void = null_mut();
+            let status = SecKeychainOpen(path.as_ptr(), &mut opened);
+            if status != 0 || opened.is_null() {
+                return Err(format!("the login keychain cannot be opened ({status})"));
+            }
+            let opened = Cf(opened);
+            let mut default: *mut c_void = null_mut();
+            let status = SecKeychainCopyDomainDefault(DOMAIN_USER, &mut default);
+            if status != 0 || default.is_null() {
+                return Err(format!("the default keychain cannot be opened ({status})"));
+            }
+            let default = Cf(default);
+            if keychain_file(opened.0)? != login || keychain_file(default.0)? != login {
+                return Err("the default keychain is not the login keychain".into());
+            }
+            Ok((opened, login))
+        }
+    }
+
+    /// Finds the item in the login keychain only (a non-null keychain restricts the search to it), and
+    /// refuses one whose own keychain is not the login file. `None`: no such item.
+    fn find_item(
+        keychain: &Cf,
+        login: &Path,
+        service: &str,
+        account: &str,
+        want_data: bool,
+    ) -> std::result::Result<Option<(Cf, zeroize::Zeroizing<Vec<u8>>)>, String> {
+        let service = CString::new(service).map_err(|_| "the item name is not valid")?;
+        let account = CString::new(account).map_err(|_| "the item name is not valid")?;
+        // SAFETY: every pointer is valid for the call; the item is owned by a `Cf`; the password bytes
+        // are copied and then freed with SecKeychainItemFreeContent.
+        unsafe {
+            let mut item: *mut c_void = null_mut();
+            let mut length: u32 = 0;
+            let mut data: *mut c_void = null_mut();
+            let status = SecKeychainFindGenericPassword(
+                keychain.0,
+                service.as_bytes().len() as u32,
+                service.as_ptr(),
+                account.as_bytes().len() as u32,
+                account.as_ptr(),
+                if want_data { &mut length } else { null_mut() },
+                if want_data { &mut data } else { null_mut() },
+                &mut item,
+            );
+            if status == NOT_FOUND {
+                return Ok(None);
+            }
+            let bytes = if want_data && !data.is_null() {
+                let copy = zeroize::Zeroizing::new(
+                    std::slice::from_raw_parts(data as *const u8, length as usize).to_vec(),
+                );
+                SecKeychainItemFreeContent(null(), data);
+                copy
+            } else {
+                zeroize::Zeroizing::new(Vec::new())
+            };
+            if status != 0 || item.is_null() {
+                return Err(format!("the keychain item cannot be read ({status})"));
+            }
+            let item = Cf(item);
+            let mut home: *mut c_void = null_mut();
+            let status = SecKeychainItemCopyKeychain(item.0 as *mut c_void, &mut home);
+            if status != 0 || home.is_null() {
+                return Err(format!(
+                    "the keychain item's keychain is unknown ({status})"
+                ));
+            }
+            let home = Cf(home);
+            if keychain_file(home.0)?.as_path() != login {
+                return Err("the keychain item is not in the login keychain".into());
+            }
+            Ok(Some((item, bytes)))
+        }
+    }
+
+    /// The partition descriptions of the item's partition-ID ACL entries, as text.
+    fn partition_descriptions(item: &Cf) -> std::result::Result<Vec<String>, String> {
+        let tag = CString::new("ACLAuthorizationPartitionID").map_err(|_| "tag")?;
+        // SAFETY: every pointer passed is valid for the call; each object returned by a Copy or Create
+        // call is owned by a `Cf` that releases it; the arrays are read only within their length.
+        unsafe {
+            let mut access: *mut c_void = null_mut();
+            let status = SecKeychainItemCopyAccess(item.0 as *mut c_void, &mut access);
+            if status != 0 || access.is_null() {
+                return Err(format!(
+                    "the keychain item's access cannot be read ({status})"
+                ));
+            }
+            let access = Cf(access);
+            let tag = Cf(CFStringCreateWithCString(null(), tag.as_ptr(), UTF8));
+            if tag.0.is_null() {
+                return Err("the partition tag cannot be made".into());
+            }
+            let list = Cf(SecAccessCopyMatchingACLList(access.0 as *mut c_void, tag.0));
+            if list.0.is_null() {
+                return Err("the keychain item has no partition list".into());
+            }
+            let mut out = Vec::new();
+            for index in 0..CFArrayGetCount(list.0) {
+                let acl = CFArrayGetValueAtIndex(list.0, index) as *mut c_void;
+                let mut applications: *const c_void = null();
+                let mut description: *const c_void = null();
+                let mut selector: u16 = 0;
+                let status =
+                    SecACLCopyContents(acl, &mut applications, &mut description, &mut selector);
+                let _applications = Cf(applications);
+                let description = Cf(description);
+                if status != 0 {
+                    return Err(format!("a partition entry cannot be read ({status})"));
+                }
+                if let Some(text) = cf_string(description.0) {
+                    out.push(text);
+                }
+            }
+            Ok(out)
+        }
+    }
+
+
+
+    /// Every partition entry of `item` judged against `policy`.
+    fn verify(item: &Cf, policy: &PartitionPolicy) -> Result<()> {
+        let mut tokens = Vec::new();
+        for description in partition_descriptions(item).map_err(Error::Unavailable)? {
+            tokens.extend(super::partition_tokens_from_description(&description));
+        }
+        judge_partitions(&tokens, policy)
+    }
+
+    /// Checks the item in the login keychain (`Invalid` when it is absent: an item that is not there
+    /// cannot be trusted).
+    pub fn verify_login_keychain_item(service: &str, account: &str, policy: &PartitionPolicy) -> Result<()> {
+        let (keychain, login) = login_keychain().map_err(Error::Unavailable)?;
+        let (item, _) = find_item(&keychain, &login, service, account, false)
+            .map_err(Error::Unavailable)?
+            .ok_or_else(|| Error::Invalid { what: "keychain item", reason: "not found".into() })?;
+        verify(&item, policy)
+    }
+
+    /// Reads the item from the login keychain only, never from whichever keychain is the default or
+    /// first on the search list. The partition list is checked before the value is read and again
+    /// after, and an item in any other keychain is refused. Never prompts: a locked keychain fails.
+    /// `Ok(None)`: no item in the login keychain.
+    pub fn read_login_keychain_item(service: &str, account: &str, policy: &PartitionPolicy) -> Result<Option<Secret>> {
+        let (keychain, login) = login_keychain().map_err(Error::Unavailable)?;
+        let Some((before, _)) = find_item(&keychain, &login, service, account, false).map_err(Error::Unavailable)? else {
+            return Ok(None);
+        };
+        verify(&before, policy)?;
+        // The interaction policy is process-wide and shared with the Store backend: take its lock.
+        let _interaction = crate::macos::UI_LOCK.lock().map_err(|_| Error::Unavailable("keychain UI lock poisoned".into()))?;
+        let mut allowed: u8 = 1;
+        // SAFETY: plain out-parameter calls.
+        unsafe {
+            SecKeychainGetUserInteractionAllowed(&mut allowed);
+            SecKeychainSetUserInteractionAllowed(0);
+        }
+        let read = find_item(&keychain, &login, service, account, true);
+        // SAFETY: restores the setting read above.
+        unsafe { SecKeychainSetUserInteractionAllowed(allowed) };
+        let (after, bytes) = read
+            .map_err(Error::Unavailable)?
+            .ok_or_else(|| Error::Invalid { what: "keychain item", reason: "vanished while it was read".into() })?;
+        verify(&after, policy)?;
+        Ok(Some(Secret::from_bytes(bytes.to_vec())))
+    }
+}
diff --git a/crates/rightkit-credentials/src/pin.rs b/crates/rightkit-credentials/src/pin.rs
new file mode 100644
index 0000000..4ea9c0a
--- /dev/null
+++ b/crates/rightkit-credentials/src/pin.rs
@@ -0,0 +1,433 @@
+//! PIN-derived keys and the PIN-bound seal key.
+//!
+//! * [`derive_pin_key`]: PBKDF2-HMAC-SHA-256, 310,000 rounds, 32 bytes.
+//! * [`wrap_key`] / [`unwrap_key`]: a 32-byte key sealed under a PIN-derived key (`salt (16) |
+//!   nonce (12) | ciphertext (32) | tag (16)`).
+//! * [`PinSealKey`]: the HMAC key that vouches for a stored blob, kept as one item **in the
+//!   credential store** (Keychain, Credential Manager, Secret Service), never in a file. Without a
+//!   PIN the item holds the key and the OS store protects it. With a PIN the item holds the key
+//!   wrapped under the owner's PIN, and it cannot be opened until the PIN has been verified in this
+//!   process ([`PinSealKey::pin_entered`]). Only a key opened under the PIN vouches for a blob that
+//!   loosens a gate ([`PinSealKey::key_from_pin`]).
+//!
+//! The PIN wrap protects against offline guessing of the key and against a store item copied
+//! elsewhere, not against code running as this user that already knows the PIN. Seals are not
+//! versioned: an older valid blob can be put back (rollback). A store failure is never read as
+//! "no key": a key is minted only when the store authoritatively reports the item absent.
+
+use crate::error::{Error, Result};
+use crate::seal::{aead_open, aead_seal, check_mac, from_hex, random_bytes, seal_mac, to_hex, KEY_LEN};
+use crate::secret::Secret;
+use crate::store::Store;
+use std::num::NonZeroU32;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Mutex;
+use zeroize::Zeroizing;
+
+/// PBKDF2 rounds for a PIN-derived key.
+pub const PIN_KDF_ITERATIONS: u32 = 310_000;
+/// Salt length of a PIN-wrapped key.
+pub const PIN_SALT_LEN: usize = 16;
+
+fn kdf(pin: &str, salt: &[u8], iterations: u32) -> Zeroizing<[u8; KEY_LEN]> {
+    let mut out = Zeroizing::new([0u8; KEY_LEN]);
+    if let Some(rounds) = NonZeroU32::new(iterations) {
+        ring::pbkdf2::derive(ring::pbkdf2::PBKDF2_HMAC_SHA256, rounds, salt, pin.as_bytes(), &mut *out);
+    }
+    out
+}
+
+/// A 32-byte key from `pin` and `salt` (PBKDF2-HMAC-SHA-256, [`PIN_KDF_ITERATIONS`] rounds).
+pub fn derive_pin_key(pin: &str, salt: &[u8]) -> Zeroizing<[u8; KEY_LEN]> {
+    kdf(pin, salt, PIN_KDF_ITERATIONS)
+}
+
+fn wrap_with(key: &[u8; KEY_LEN], pin: &str, aad: &[u8], iterations: u32) -> Result<Vec<u8>> {
+    let salt: [u8; PIN_SALT_LEN] = random_bytes()?;
+    let derived = kdf(pin, &salt, iterations);
+    let sealed = aead_seal(&*derived, aad, key)?;
+    let mut out = Vec::with_capacity(PIN_SALT_LEN + sealed.len());
+    out.extend_from_slice(&salt);
+    out.extend_from_slice(&sealed);
+    Ok(out)
+}
+
+fn unwrap_with(wrapped: &[u8], pin: &str, aad: &[u8], iterations: u32) -> Result<Zeroizing<[u8; KEY_LEN]>> {
+    if wrapped.len() <= PIN_SALT_LEN {
+        return Err(Error::Invalid { what: "wrapped key", reason: "too short".into() });
+    }
+    let (salt, sealed) = wrapped.split_at(PIN_SALT_LEN);
+    let derived = kdf(pin, salt, iterations);
+    let plain = aead_open(&*derived, aad, sealed)?;
+    let mut key = Zeroizing::new([0u8; KEY_LEN]);
+    if plain.len() != KEY_LEN {
+        return Err(Error::Invalid { what: "wrapped key", reason: "wrong length".into() });
+    }
+    key.copy_from_slice(plain.expose_bytes());
+    Ok(key)
+}
+
+/// Seals `key` under a key derived from `pin`. `aad` is authenticated (bind it to the purpose).
+pub fn wrap_key(key: &[u8; KEY_LEN], pin: &str, aad: &[u8]) -> Result<Vec<u8>> {
+    wrap_with(key, pin, aad, PIN_KDF_ITERATIONS)
+}
+
+/// Opens the output of [`wrap_key`]. A wrong PIN or `aad` is `Error::Invalid`.
+pub fn unwrap_key(wrapped: &[u8], pin: &str, aad: &[u8]) -> Result<Zeroizing<[u8; KEY_LEN]>> {
+    unwrap_with(wrapped, pin, aad, PIN_KDF_ITERATIONS)
+}
+
+const MAGIC: &[u8; 8] = b"RKPSEAL2";
+const FLAG_CLEAR: u8 = b'N';
+const FLAG_PIN: u8 = b'P';
+const HEADER_LEN: usize = MAGIC.len() + 1;
+
+struct Parsed {
+    pinned: bool,
+    body: Vec<u8>,
+}
+
+/// What the store holds for the seal key.
+enum Slot {
+    Absent,
+    /// Present but not in the expected form. Never overwritten by a first-run mint.
+    Damaged,
+    Found(Parsed),
+}
+
+/// The seal key of one stored blob, kept as one credential-store item. See the module notes.
+///
+/// `label` names the purpose (for example `myapp.protected-settings.seal.v1`): it is authenticated
+/// data of the PIN wrap, so an item written for another purpose does not open. One value per
+/// process and item; the type does not coordinate several processes writing the same item.
+pub struct PinSealKey {
+    store: Store,
+    account: String,
+    label: String,
+    iterations: u32,
+    key: Mutex<Option<Zeroizing<[u8; KEY_LEN]>>>,
+    pinned: AtomicBool,
+}
+
+impl PinSealKey {
+    /// The seal key lives in `store` under `account`.
+    pub fn new(store: Store, account: &str, label: &str) -> Self {
+        Self::with_iterations(store, account, label, PIN_KDF_ITERATIONS)
+    }
+
+    fn with_iterations(store: Store, account: &str, label: &str, iterations: u32) -> Self {
+        Self {
+            store,
+            account: account.to_string(),
+            label: label.to_string(),
+            iterations,
+            key: Mutex::new(None),
+            pinned: AtomicBool::new(false),
+        }
+    }
+
+    fn slot(&self) -> std::sync::MutexGuard<'_, Option<Zeroizing<[u8; KEY_LEN]>>> {
+        self.key.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    fn aad(&self) -> Vec<u8> {
+        let mut out = self.label.as_bytes().to_vec();
+        out.push(0);
+        out.extend_from_slice(MAGIC);
+        out.push(FLAG_PIN);
+        out
+    }
+
+    fn read(&self) -> Result<Slot> {
+        let Some(secret) = self.store.get(&self.account)? else {
+            return Ok(Slot::Absent);
+        };
+        let parsed = (|| {
+            let bytes = from_hex(secret.expose_str().ok()?.trim())?;
+            let bytes = Zeroizing::new(bytes);
+            if bytes.len() <= HEADER_LEN || &bytes[..MAGIC.len()] != MAGIC {
+                return None;
+            }
+            let pinned = match bytes[MAGIC.len()] {
+                FLAG_PIN => true,
+                FLAG_CLEAR => false,
+                _ => return None,
+            };
+            Some(Parsed { pinned, body: bytes[HEADER_LEN..].to_vec() })
+        })();
+        Ok(parsed.map_or(Slot::Damaged, Slot::Found))
+    }
+
+    /// `Ok(true)` when written. `create_only` writes only if the item is still absent.
+    fn write(&self, key: &[u8; KEY_LEN], pin: Option<&str>, create_only: bool) -> Result<bool> {
+        let mut bytes = Zeroizing::new(MAGIC.to_vec());
+        match pin {
+            None => {
+                bytes.push(FLAG_CLEAR);
+                bytes.extend_from_slice(key);
+            }
+            Some(pin) => {
+                bytes.push(FLAG_PIN);
+                bytes.extend_from_slice(&wrap_with(key, pin, &self.aad(), self.iterations)?);
+            }
+        }
+        let text = Secret::from_string(to_hex(&bytes));
+        if create_only {
+            self.store.add_if_absent(&self.account, &text)
+        } else {
+            self.store.set(&self.account, &text).map(|()| true)
+        }
+    }
+
+    fn open(&self, parsed: &Parsed, pin: Option<&str>) -> Option<Zeroizing<[u8; KEY_LEN]>> {
+        if parsed.pinned != pin.is_some() {
+            return None;
+        }
+        match pin {
+            None => {
+                let mut key = Zeroizing::new([0u8; KEY_LEN]);
+                if parsed.body.len() != KEY_LEN {
+                    return None;
+                }
+                key.copy_from_slice(&parsed.body);
+                Some(key)
+            }
+            Some(pin) => unwrap_with(&parsed.body, pin, &self.aad(), self.iterations).ok(),
+        }
+    }
+
+    /// The cached key, else the key of a clear item (cached). A PIN item needs `pin_entered`.
+    /// `Ok(None)` for a PIN item, an absent item or a damaged one; `Err` for a store failure.
+    fn key_without_pin(&self) -> Result<Option<Zeroizing<[u8; KEY_LEN]>>> {
+        let mut slot = self.slot();
+        if let Some(key) = slot.as_ref() {
+            return Ok(Some(key.clone()));
+        }
+        let Slot::Found(parsed) = self.read()? else {
+            return Ok(None);
+        };
+        if parsed.pinned {
+            return Ok(None);
+        }
+        let Some(key) = self.open(&parsed, None) else {
+            return Ok(None);
+        };
+        *slot = Some(key.clone());
+        Ok(Some(key))
+    }
+
+    /// Whether the cached key is one this process made or opened under the owner's PIN. A key read
+    /// from a clear item does not count: any process able to write the item could plant one.
+    pub fn key_from_pin(&self) -> bool {
+        self.pinned.load(Ordering::SeqCst)
+    }
+
+    /// Whether the item exists and is wrapped with a PIN. A store failure reads as `false`.
+    pub fn pin_bound(&self) -> bool {
+        matches!(self.read(), Ok(Slot::Found(p)) if p.pinned)
+    }
+
+    /// The seal (hex HMAC-SHA-256) over `message`, or `None` when the key cannot be used: a PIN is
+    /// set and has not been entered since start, the item is damaged, or the store refused. The
+    /// first run (item authoritatively absent, no PIN) mints the key.
+    pub fn make_seal(&self, message: &[u8], pin_set: bool) -> Option<String> {
+        let key = match self.key_without_pin().ok()? {
+            Some(key) => key,
+            None if !pin_set && matches!(self.read(), Ok(Slot::Absent)) => {
+                let fresh = Zeroizing::new(random_bytes::<KEY_LEN>().ok()?);
+                if !self.write(&fresh, None, true).ok()? {
+                    // Another writer minted first: adopt its key, never ours.
+                    return self.key_without_pin().ok()?.map(|key| seal_mac(&key[..], message));
+                }
+                *self.slot() = Some(fresh.clone());
+                fresh
+            }
+            None => return None,
+        };
+        Some(seal_mac(&key[..], message))
+    }
+
+    /// Whether `mac` is this key's seal over `message`.
+    pub fn check_seal(&self, message: &[u8], mac: Option<&str>) -> bool {
+        match self.key_without_pin() {
+            Ok(Some(key)) => check_mac(&key[..], message, mac),
+            _ => false,
+        }
+    }
+
+    /// The owner's PIN was just verified: opens a PIN item. With no item or a clear one the old
+    /// key is NOT adopted (a planted item's key is not ours): a fresh key is wrapped under the
+    /// PIN, so blobs sealed under the old key stop verifying and loosened gates are set again.
+    pub fn pin_entered(&self, pin: &str) {
+        if self.key_from_pin() {
+            return;
+        }
+        let opened = match self.read() {
+            Ok(Slot::Found(parsed)) if parsed.pinned => self.open(&parsed, Some(pin)),
+            // A store failure: change nothing.
+            Err(_) => return,
+            _ => None,
+        };
+        let key = opened.or_else(|| {
+            let fresh = Zeroizing::new(random_bytes::<KEY_LEN>().ok()?);
+            matches!(self.write(&fresh, Some(pin), false), Ok(true)).then_some(fresh)
+        });
+        if let Some(key) = key {
+            *self.slot() = Some(key);
+            self.pinned.store(true, Ordering::SeqCst);
+        }
+    }
+
+    /// The PIN was set or changed: wraps the key under the new PIN (a fresh key unless the cached
+    /// one already came from a PIN).
+    pub fn pin_changed(&self, pin: &str) {
+        let cached = if self.key_from_pin() { self.slot().clone() } else { None };
+        let key = cached.or_else(|| random_bytes::<KEY_LEN>().ok().map(Zeroizing::new));
+        let Some(key) = key else {
+            return;
+        };
+        if matches!(self.write(&key, Some(pin), false), Ok(true)) {
+            *self.slot() = Some(key);
+            self.pinned.store(true, Ordering::SeqCst);
+        }
+    }
+
+    /// Forgets the key and deletes the store item (the owner reset the protected store). The
+    /// in-memory key is dropped even when the store cannot be reached; that failure is returned.
+    pub fn reset(&self) -> Result<()> {
+        *self.slot() = None;
+        self.pinned.store(false, Ordering::SeqCst);
+        self.store.delete(&self.account).map(|_| ())
+    }
+}

+        std::fs::write(&outside, b"x").unwrap();
+        let inside_real = root.join("Contents/real");
+        std::fs::write(&inside_real, b"x").unwrap();
+        let bad = root.join("Contents/bad");
+        let good = root.join("Contents/good");
+        std::os::unix::fs::symlink(&outside, &bad).unwrap();
+        std::os::unix::fs::symlink(&inside_real, &good).unwrap();
+        assert!(contain_in_bundle(&bad, &root).is_err());
+        assert_eq!(
+            contain_in_bundle(&good, &root).unwrap(),
+            inside_real.canonicalize().unwrap()
+        );
+    }
+
+    #[test]
+    fn the_signing_target_is_the_enclosing_app_of_a_main_executable() {
+        assert_eq!(
+            signing_target(Path::new("/x/A.app/Contents/MacOS/A")),
+            PathBuf::from("/x/A.app")
+        );
+        assert_eq!(
+            signing_target(Path::new("/x/A.app/Contents/Library/LoginItems/H.app/Contents/MacOS/H")),
+            PathBuf::from("/x/A.app/Contents/Library/LoginItems/H.app")
+        );
+        // Not a main executable of an app: the file itself.
+        for plain in ["/x/A.app/Contents/Helpers/tool", "/x/A/Contents/MacOS/A", "/x/tool"] {
+            assert_eq!(signing_target(Path::new(plain)), PathBuf::from(plain));
+        }
+    }
+
+    #[test]
+    fn team_id_parsing_and_validation() {
+        let out = "Executable=/x\nIdentifier=a.b\nTeamIdentifier=6KLGD3LLKF\nSealed Resources=none\n";
+        assert_eq!(parse_team_identifier(out).as_deref(), Some("6KLGD3LLKF"));
+        assert_eq!(parse_team_identifier("TeamIdentifier=not set\n"), None);
+        assert_eq!(parse_team_identifier("nothing here"), None);
+        assert_eq!(parse_team_identifier("TeamIdentifier=short\n"), None);
+        assert!(valid_team_id("6KLGD3LLKF").is_ok());
+        assert!(valid_team_id("6KLGD3LLK\"").is_err());
+        assert!(valid_team_id("").is_err());
+        assert_eq!(
+            team_requirement("6KLGD3LLKF"),
+            "anchor apple generic and certificate leaf[subject.OU] = \"6KLGD3LLKF\""
+        );
+    }
+
+    #[test]
+    fn a_malformed_fixed_team_is_refused_before_any_check() {
+        let d = tempfile::tempdir().unwrap();
+        let root = d.path().join("A.app");
+        std::fs::create_dir_all(&root).unwrap();
+        let helper = root.join("h");
+        std::fs::write(&helper, b"x").unwrap();
+        let t = HelperTrust::new(&root).team(TeamPolicy::Fixed("bad\" or true".into()));
+        assert!(t.verify(&helper).is_err());
+    }
+
+    #[test]
+    fn skip_keeps_containment_and_a_signature_policy_fails_closed_off_macos() {
+        let d = tempfile::tempdir().unwrap();
+        let root = d.path().join("A.app");
+        std::fs::create_dir_all(&root).unwrap();
+        let helper = root.join("h");
+        std::fs::write(&helper, b"x").unwrap();
+        let outside = d.path().join("o");
+        std::fs::write(&outside, b"x").unwrap();
+        let skip = HelperTrust::new(&root).team(TeamPolicy::Skip);
+        assert!(skip.verify(&helper).is_ok());
+        assert!(skip.verify(&outside).is_err());
+        // An unsigned file never passes a signature policy (no signing exists off macOS; on macOS
+        // a plain text file carries no signature).
+        let signed = HelperTrust::new(&root).team(TeamPolicy::Fixed("6KLGD3LLKF".into()));
+        assert!(signed.verify(&helper).is_err());
+        assert!(HelperTrust::new(&root).verify(&helper).is_err());
+    }
+}

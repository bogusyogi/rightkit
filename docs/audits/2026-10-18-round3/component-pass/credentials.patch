+//! Blob sealing: AES-256-GCM under a key kept in the credential store (macOS Keychain and every
+//! other platform), or Windows DPAPI (`CryptProtectData`, user scope), plus the HMAC seal helper.
+//!
+//! Layouts (the CryptoKit "combined box" and `magic | body` forms, so files an app already wrote that way stay readable):
+//!
+//! * AEAD body: `nonce (12) | ciphertext | tag (16)`, the CryptoKit "combined box"; the
+//!   associated data is supplied by the caller ([`seal_blob`] passes the magic header).
+//! * Sealed file: `magic | body`. The magic is the caller's (`PULSECL1`, `PULSECL2`, ...).
+//! * DPAPI body: the raw `CryptProtectData` blob. DPAPI has no associated data, so `aad` is ignored
+//!   there; bind a blob to its purpose with the `entropy` instead.
+//!
+//! Nothing here prints or returns a key in an error. Decrypted bytes come back as a [`Secret`].
+
+use crate::error::{Error, Result};
+use crate::secret::Secret;
+use crate::store::Store;
+use ring::aead::{Aad, LessSafeKey, Nonce, UnboundKey, AES_256_GCM, NONCE_LEN};
+use ring::hmac;
+use zeroize::{Zeroize, Zeroizing};
+
+/// Length of an AES-256 key.
+pub const KEY_LEN: usize = 32;
+const TAG_LEN: usize = 16;
+
+fn invalid(what: &'static str, reason: &str) -> Error {
+    Error::Invalid {
+        what,
+        reason: reason.to_string(),
+    }
+}
+
+/// `N` random bytes from the OS CSPRNG.
+pub(crate) fn random_bytes<const N: usize>() -> Result<[u8; N]> {
+    let mut out = [0u8; N];
+    getrandom::fill(&mut out).map_err(|_| Error::Unavailable("OS CSPRNG failed".into()))?;
+    Ok(out)
+}
+
+fn cipher(key: &[u8]) -> Result<LessSafeKey> {
+    if key.len() != KEY_LEN {
+        return Err(invalid("seal key", "must be 32 bytes"));
+    }
+    let unbound = UnboundKey::new(&AES_256_GCM, key).map_err(|_| invalid("seal key", "rejected"))?;
+    Ok(LessSafeKey::new(unbound))
+}
+
+/// Encrypts `plain` with AES-256-GCM under `key` and a fresh random nonce.
+/// Returns `nonce (12) | ciphertext | tag (16)`.
+pub fn aead_seal(key: &[u8], aad: &[u8], plain: &[u8]) -> Result<Vec<u8>> {
+    let cipher = cipher(key)?;
+    let nonce: [u8; NONCE_LEN] = random_bytes()?;
+    // Allocated at its final size so the plaintext copy is never left behind by a reallocation.
+    let mut body = Vec::with_capacity(plain.len() + TAG_LEN);
+    body.extend_from_slice(plain);
+    let sealed =
+        cipher.seal_in_place_append_tag(Nonce::assume_unique_for_key(nonce), Aad::from(aad), &mut body);
+    if sealed.is_err() {
+        body.zeroize();
+        return Err(Error::Backend {
+            op: "aead seal",
+            code: 0,
+        });
+    }
+    let mut out = Vec::with_capacity(NONCE_LEN + body.len());
+    out.extend_from_slice(&nonce);
+    out.extend_from_slice(&body);
+    Ok(out)
+}
+
+/// Opens the output of [`aead_seal`]. A wrong key, wrong `aad` or any change to the blob is
+/// `Error::Invalid` (the cause is not distinguished).
+pub fn aead_open(key: &[u8], aad: &[u8], combined: &[u8]) -> Result<Secret> {
+    let cipher = cipher(key)?;
+    if combined.len() < NONCE_LEN + TAG_LEN {
+        return Err(invalid("sealed blob", "too short"));
+    }
+    let nonce: [u8; NONCE_LEN] = combined[..NONCE_LEN]
+        .try_into()
+        .map_err(|_| invalid("sealed blob", "too short"))?;
+    let mut buffer = Zeroizing::new(combined[NONCE_LEN..].to_vec());
+    let plain = cipher
+        .open_in_place(Nonce::assume_unique_for_key(nonce), Aad::from(aad), &mut buffer)
+        .map_err(|_| invalid("sealed blob", "authentication failed"))?;
+    Ok(Secret::from_bytes(plain.to_vec()))
+}
+
+/// Standard base64 (RFC 4648, padded) decoder for the key text `Store::get_or_create_key` returns.
+pub(crate) fn base64_decode(text: &str) -> Option<Zeroizing<Vec<u8>>> {
+    let bytes = text.trim().as_bytes();
+    if bytes.is_empty() || bytes.len() % 4 != 0 {
+        return None;
+    }
+    let mut out = Zeroizing::new(Vec::with_capacity(bytes.len() / 4 * 3));
+    let chunks = bytes.len() / 4;
+    for (index, chunk) in bytes.chunks(4).enumerate() {
+        let last = index + 1 == chunks;
+        let mut value = 0u32;
+        let mut pad = 0;
+        for &c in chunk {
+            let digit = match c {
+                b'A'..=b'Z' => c - b'A',
+                b'a'..=b'z' => c - b'a' + 26,
+                b'0'..=b'9' => c - b'0' + 52,
+                b'+' => 62,
+                b'/' => 63,
+                b'=' if last => {
+                    pad += 1;
+                    0
+                }
+                _ => return None,
+            };
+            if pad > 0 && c != b'=' {
+                return None;
+            }
+            value = (value << 6) | u32::from(digit);
+        }
+        if pad > 2 {
+            return None;
+        }
+        let triple = value.to_be_bytes();
+        out.extend_from_slice(&triple[1..4 - pad]);
+    }
+    Some(out)
+}
+
+/// The 32-byte AES key held in `store` under `account`, minted on first use (add-if-absent, so
+/// concurrent processes adopt one winner). A read failure is never treated as absence.
+fn store_key(store: &Store, account: &str) -> Result<Zeroizing<Vec<u8>>> {
+    let (text, _created) = store.get_or_create_key(account, KEY_LEN)?;
+    let decoded = base64_decode(text.expose_str()?)
+        .ok_or_else(|| invalid("seal key", "the stored key is not valid base64"))?;
+    if decoded.len() != KEY_LEN {
+        return Err(invalid("seal key", "the stored key is not 32 bytes"));
+    }
+    Ok(decoded)
+}
+
+/// What seals and opens a blob.
+#[derive(Clone, Copy)]
+pub enum Sealer<'a> {
+    /// AES-256-GCM under a 256-bit key kept in the credential store under `account` (the macOS
+    /// Keychain, Credential Manager, Secret Service). The key is created on first seal.
+    StoreKey { store: &'a Store, account: &'a str },
+    /// Windows DPAPI, user scope, never prompting. `entropy` is mixed into the protection (empty:
+    /// none). `Error::Unavailable` on every other platform.
+    Dpapi { entropy: &'a [u8] },
+}
+
+impl<'a> Sealer<'a> {
+    /// DPAPI on Windows, the store-held key everywhere else.
+    pub fn platform(store: &'a Store, account: &'a str) -> Sealer<'a> {
+        if cfg!(windows) {
+            Sealer::Dpapi { entropy: &[] }
+        } else {
+            Sealer::StoreKey { store, account }
+        }
+    }
+
+    /// Seals `plain`. `aad` is authenticated for `StoreKey` and ignored by DPAPI.
+    pub fn seal(&self, aad: &[u8], plain: &[u8]) -> Result<Vec<u8>> {
+        match self {
+            Sealer::StoreKey { store, account } => {
+                let key = store_key(store, account)?;
+                aead_seal(&key, aad, plain)
+            }
+            Sealer::Dpapi { entropy } => dpapi_protect(plain, entropy),
+        }
+    }
+
+    /// Opens what [`Sealer::seal`] returned. `StoreKey` never mints a key here: an absent key is
+    /// an error, because a fresh key could not open anything.
+    pub fn open(&self, aad: &[u8], sealed: &[u8]) -> Result<Secret> {
+        match self {
+            Sealer::StoreKey { store, account } => {
+                let text = store
+                    .get(account)?
+                    .filter(|s| !s.is_empty())
+                    .ok_or_else(|| invalid("seal key", "no key is stored"))?;
+                let key = base64_decode(text.expose_str()?)
+                    .ok_or_else(|| invalid("seal key", "the stored key is not valid base64"))?;
+                aead_open(&key, aad, sealed)
+            }
+            Sealer::Dpapi { entropy } => dpapi_unprotect(sealed, entropy),
+        }
+    }
+}
+
+/// Whether `bytes` start with `magic`.
+pub fn is_sealed(bytes: &[u8], magic: &[u8]) -> bool {
+    !magic.is_empty() && bytes.starts_with(magic)
+}
+
+/// `magic | sealer.seal(aad = magic, plain)`.
+pub fn seal_blob(sealer: &Sealer<'_>, magic: &[u8], plain: &[u8]) -> Result<Vec<u8>> {
+    if magic.is_empty() {
+        return Err(invalid("magic", "must not be empty"));
+    }
+    let body = sealer.seal(magic, plain)?;
+    let mut out = Vec::with_capacity(magic.len() + body.len());
+    out.extend_from_slice(magic);
+    out.extend_from_slice(&body);
+    Ok(out)
+}
+
+/// Opens a file written by [`seal_blob`] (or by Pulse's `PULSECL1` / `PULSECL2` layouts).
+/// `Error::Invalid` when the magic is absent.
+pub fn open_blob(sealer: &Sealer<'_>, magic: &[u8], bytes: &[u8]) -> Result<Secret> {
+    let body = bytes
+        .strip_prefix(magic)
+        .filter(|_| !magic.is_empty())
+        .ok_or_else(|| invalid("sealed blob", "missing header"))?;
+    sealer.open(magic, body)
+}
+
+/// HMAC-SHA-256 of `message` under `key`, as lowercase hex.
+pub fn seal_mac(key: &[u8], message: &[u8]) -> String {
+    let tag = hmac::sign(&hmac::Key::new(hmac::HMAC_SHA256, key), message);
+    to_hex(tag.as_ref())
+}
+
+/// Whether `mac` (hex) is the HMAC-SHA-256 of `message` under `key`. Constant time over the tag;
+/// a missing or malformed `mac` is `false`.
+pub fn check_mac(key: &[u8], message: &[u8], mac: Option<&str>) -> bool {
+    let Some(tag) = mac.and_then(from_hex) else {
+        return false;
+    };
+    hmac::verify(&hmac::Key::new(hmac::HMAC_SHA256, key), message, &tag).is_ok()
+}
+
+/// Lowercase hex.
+pub fn to_hex(bytes: &[u8]) -> String {
+    const DIGITS: &[u8; 16] = b"0123456789abcdef";
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for b in bytes {
+        out.push(DIGITS[usize::from(b >> 4)] as char);
+        out.push(DIGITS[usize::from(b & 0x0f)] as char);
+    }
+    out
+}
+
+/// Decodes hex (either case); `None` for odd length or a non-hex character.
+pub fn from_hex(text: &str) -> Option<Vec<u8>> {
+    if text.len() % 2 != 0 || !text.is_ascii() {
+        return None;
+    }
+    (0..text.len() / 2)
+        .map(|i| u8::from_str_radix(&text[2 * i..2 * i + 2], 16).ok())
+        .collect()
+}
+
+// ---- DPAPI -------------------------------------------------------------------------------------
+
+/// Protects `plain` with DPAPI (`CryptProtectData`, current user, `CRYPTPROTECT_UI_FORBIDDEN`).
+/// Windows only; `Error::Unavailable` elsewhere.
+pub fn dpapi_protect(plain: &[u8], entropy: &[u8]) -> Result<Vec<u8>> {
+    #[cfg(windows)]
+    {
+        dpapi::protect(plain, entropy)
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = (plain, entropy);
+        Err(Error::Unavailable("DPAPI exists only on Windows".into()))
+    }
+}
+
+/// Opens a DPAPI blob (`CryptUnprotectData`, never prompting). Windows only.
+pub fn dpapi_unprotect(blob: &[u8], entropy: &[u8]) -> Result<Secret> {
+    #[cfg(windows)]
+    {
+        dpapi::unprotect(blob, entropy)
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = (blob, entropy);
+        Err(Error::Unavailable("DPAPI exists only on Windows".into()))
+    }
+}
+
+#[cfg(windows)]
+mod dpapi {
+    use super::*;
+    use std::ffi::c_void;
+    use windows_sys::Win32::Foundation::{GetLastError, LocalFree};
+    use windows_sys::Win32::Security::Cryptography::{
+        CryptProtectData, CryptUnprotectData, CRYPT_INTEGER_BLOB,
+    };
+
+    /// `CRYPTPROTECT_UI_FORBIDDEN`: DPAPI never shows a prompt.
+    const UI_FORBIDDEN: u32 = 0x1;
+
+    fn input(bytes: &[u8]) -> Result<CRYPT_INTEGER_BLOB> {
+        Ok(CRYPT_INTEGER_BLOB {
+            cbData: u32::try_from(bytes.len()).map_err(|_| invalid("DPAPI input", "too large"))?,
+            pbData: bytes.as_ptr() as *mut u8,
+        })
+    }
+
+    /// Copies the OS-allocated output, wipes the OS buffer and frees it.
+    fn take(out: &CRYPT_INTEGER_BLOB) -> Zeroizing<Vec<u8>> {
+        if out.pbData.is_null() {
+            return Zeroizing::new(Vec::new());
+        }
+        // SAFETY: DPAPI returned `cbData` bytes at `pbData` (LocalAlloc). They are copied, then the
+        // buffer is overwritten and freed exactly once.
+        unsafe {
+            let copy = std::slice::from_raw_parts(out.pbData, out.cbData as usize).to_vec();
+            std::ptr::write_bytes(out.pbData, 0, out.cbData as usize);
+            LocalFree(out.pbData as *mut c_void);
+            Zeroizing::new(copy)
+        }
+    }
+
+    pub fn protect(plain: &[u8], entropy: &[u8]) -> Result<Vec<u8>> {
+        let data = input(plain)?;
+        let extra = input(entropy)?;
+        let mut out = CRYPT_INTEGER_BLOB {
+            cbData: 0,
+            pbData: std::ptr::null_mut(),
+        };
+        let extra_ptr: *const CRYPT_INTEGER_BLOB = if entropy.is_empty() { std::ptr::null() } else { &extra };
+        // SAFETY: `data` and `extra` point at slices that live through the call; `out` is written by
+        // the call and released by `take`. No description, reserved field or prompt is passed.
+        let ok = unsafe {
+            CryptProtectData(
+                &data,
+                std::ptr::null(),
+                extra_ptr,
+                std::ptr::null(),
+                std::ptr::null(),
+                UI_FORBIDDEN,
+                &mut out,
+            )
+        };
+        if ok == 0 {
+            return Err(Error::Backend {
+                op: "CryptProtectData",
+                code: unsafe { GetLastError() } as i64,
+            });
+        }
+        let blob = take(&out);
+        Ok(blob.to_vec())
+    }
+
+    pub fn unprotect(blob: &[u8], entropy: &[u8]) -> Result<Secret> {
+        let data = input(blob)?;
+        let extra = input(entropy)?;
+        let mut out = CRYPT_INTEGER_BLOB {
+            cbData: 0,
+            pbData: std::ptr::null_mut(),
+        };
+        let extra_ptr: *const CRYPT_INTEGER_BLOB = if entropy.is_empty() { std::ptr::null() } else { &extra };
+        // SAFETY: as in `protect`; DPAPI only reads `data` and `extra` for the call. No description
+        // output is requested, so there is nothing else to free.
+        let ok = unsafe {
+            CryptUnprotectData(
+                &data,
+                std::ptr::null_mut(),
+                extra_ptr,
+                std::ptr::null(),
+                std::ptr::null(),
+                UI_FORBIDDEN,
+                &mut out,
+            )
+        };
+        if ok == 0 {
+            return Err(Error::Backend {
+                op: "CryptUnprotectData",
+                code: unsafe { GetLastError() } as i64,
+            });
+        }
+        let plain = take(&out);
+        Ok(Secret::from_bytes(plain.to_vec()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{Config, MemoryBackend, Namespace};
+    use std::sync::Arc;
+
+    fn store() -> Store {
+        Store::open(
+            Config::new(Namespace::new("dev.rightkit.credentials.test.seal").unwrap())
+                .backend(Arc::new(MemoryBackend::new())),
+        )
+    }
+
+    #[test]
+    fn aead_round_trips_and_binds_key_and_aad() {
+        let key = [7u8; KEY_LEN];
+        let sealed = aead_seal(&key, b"aad", b"hello").unwrap();
+        assert_eq!(sealed.len(), NONCE_LEN + 5 + TAG_LEN);
+        assert_eq!(aead_open(&key, b"aad", &sealed).unwrap().expose_bytes(), b"hello");
+        assert!(aead_open(&key, b"other", &sealed).is_err());
+        assert!(aead_open(&[8u8; KEY_LEN], b"aad", &sealed).is_err());
+        let mut tampered = sealed.clone();
+        *tampered.last_mut().unwrap() ^= 1;
+        assert!(aead_open(&key, b"aad", &tampered).is_err());
+        assert!(aead_open(&key, b"aad", &sealed[..10]).is_err());
+        assert!(aead_seal(&[1u8; 16], b"", b"x").is_err());
+    }
+
+    #[test]
+    fn nonces_are_fresh() {
+        let key = [1u8; KEY_LEN];
+        let a = aead_seal(&key, b"", b"same").unwrap();
+        let b = aead_seal(&key, b"", b"same").unwrap();
+        assert_ne!(a, b);
+    }
+
+    #[test]
+    fn base64_decodes_rfc4648_vectors_and_rejects_bad_text() {
+        for (text, want) in [("Zg==", &b"f"[..]), ("Zm8=", b"fo"), ("Zm9v", b"foo"), ("Zm9vYg==", b"foob"), ("+/+/", &[0xfb, 0xff, 0xbf])] {
+            assert_eq!(base64_decode(text).unwrap().as_slice(), want);
+        }
+        for bad in ["", "Zg=", "Z===", "Zg==Zg==", "Zm9!", "Zm=v"] {
+            assert!(base64_decode(bad).is_none(), "{bad}");
+        }
+    }
+
+    #[test]
+    fn store_key_sealer_round_trips_with_magic_and_mints_one_key() {
+        let store = store();
+        let sealer = Sealer::StoreKey { store: &store, account: "history-key-1" };
+        let file = seal_blob(&sealer, b"PULSECL1", b"clipboard text").unwrap();
+        assert!(is_sealed(&file, b"PULSECL1"));
+        assert!(!is_sealed(b"plain", b"PULSECL1"));
+        assert_eq!(open_blob(&sealer, b"PULSECL1", &file).unwrap().expose_bytes(), b"clipboard text");
+        // The same key opens a second blob: the key was minted once.
+        let second = seal_blob(&sealer, b"PULSECL1", b"two").unwrap();
+        assert_eq!(open_blob(&sealer, b"PULSECL1", &second).unwrap().expose_bytes(), b"two");
+        // A different magic is a different AAD.
+        assert!(open_blob(&sealer, b"PULSECL9", &file).is_err());
+        let mut renamed = b"PULSECL9".to_vec();
+        renamed.extend_from_slice(&file[8..]);
+        assert!(open_blob(&sealer, b"PULSECL9", &renamed).is_err());
+        assert!(open_blob(&sealer, b"PULSECL1", b"plain file").is_err());
+    }
+
+    #[test]
+    fn opening_never_mints_a_key() {
+        let store = store();
+        let sealer = Sealer::StoreKey { store: &store, account: "absent" };
+        assert!(sealer.open(b"m", &[0u8; 64]).is_err());
+        assert!(!store.exists("absent").unwrap());
+    }
+
+    #[cfg(not(windows))]
+    #[test]
+    fn dpapi_is_unavailable_off_windows() {
+        let sealer = Sealer::Dpapi { entropy: b"e" };
+        assert!(matches!(sealer.seal(b"", b"x"), Err(Error::Unavailable(_))));
+        assert!(matches!(sealer.open(b"", b"x"), Err(Error::Unavailable(_))));
+    }
+
+    #[test]
+    fn mac_and_hex() {
+        let key = [3u8; 32];
+        let mac = seal_mac(&key, b"msg");
+        assert_eq!(mac.len(), 64);
+        assert!(check_mac(&key, b"msg", Some(&mac)));
+        assert!(check_mac(&key, b"msg", Some(&mac.to_uppercase())));
+        assert!(!check_mac(&key, b"msh", Some(&mac)));
+        assert!(!check_mac(&[4u8; 32], b"msg", Some(&mac)));
+        assert!(!check_mac(&key, b"msg", None));
+        assert!(!check_mac(&key, b"msg", Some("zz")));
+        assert!(!check_mac(&key, b"msg", Some(&mac[..62])));
+        assert_eq!(from_hex("00ff10").unwrap(), vec![0, 255, 16]);
+        assert!(from_hex("abc").is_none());
+        assert_eq!(to_hex(&[0, 255, 16]), "00ff10");
+    }
+}

--- /dev/null
+++ b/crates/rightkit-credentials/tests/no_credential_files.rs
@@ -0,0 +1,30 @@
+//! D4 (rightkit#771): no credential sits in a file. The sealing, PIN-wrap and owner-key code keeps
+//! its keys in the credential store or in memory and never writes a file. Scans the source of those
+//! modules (outside their unit tests) for file-writing calls.
+
+#[test]
+fn seal_pin_owner_key_partition_and_verify_write_no_file() {
+    let sources = [
+        ("seal.rs", include_str!("../src/seal.rs")),
+        ("pin.rs", include_str!("../src/pin.rs")),
+        ("owner_key.rs", include_str!("../src/owner_key.rs")),
+        ("partition.rs", include_str!("../src/partition.rs")),
+        ("verify.rs", include_str!("../src/verify.rs")),
+    ];
+    for (name, source) in sources {
+        let code = source.split("#[cfg(test)]").next().unwrap();
+        for banned in [
+            "fs::write",
+            "File::create",
+            "create_new",
+            "OpenOptions",
+            "fs::copy",
+            "fs::rename",
+            "write_private",
+            "atomic_write",
+            "set_permissions",
+        ] {
+            assert!(!code.contains(banned), "{name} must not write a file: found {banned}");
+        }
+    }
+}
diff --git a/crates/rightkit-credentials/tests/seal.rs b/crates/rightkit-credentials/tests/seal.rs
new file mode 100644
index 0000000..ada52e5
--- /dev/null
+++ b/crates/rightkit-credentials/tests/seal.rs
@@ -0,0 +1,75 @@
+//! The public sealing, PIN and approval APIs, through the crate root only.
+
+use std::sync::Arc;
+
+#[allow(unused_imports)]
+use rightkit_credentials::{
+    aead_open, aead_seal, check_mac, derive_pin_key, is_sealed, open_blob, owner_key_id, seal_blob,
+    seal_mac, unwrap_key, verify_p256, verify_user, wrap_key, Config, Error, MemoryBackend,
+    Namespace, PartitionPolicy, PinSealKey, Sealer, Store, KEY_LEN,
+};
+
+fn store() -> Store {
+    Store::open(
+        Config::new(Namespace::new("dev.rightkit.credentials.test.seal-public").unwrap())
+            .backend(Arc::new(MemoryBackend::new())),
+    )
+}
+
+#[test]
+fn a_sealed_file_opens_only_with_its_magic_and_key() {
+    let store = store();
+    let sealer = Sealer::StoreKey { store: &store, account: "history-key-1" };
+    let file = seal_blob(&sealer, b"PULSECL1", b"payload").unwrap();
+    assert!(is_sealed(&file, b"PULSECL1"));
+    assert_eq!(open_blob(&sealer, b"PULSECL1", &file).unwrap().expose_bytes(), b"payload");
+    assert!(open_blob(&sealer, b"PULSECL2", &file).is_err());
+
+    let other_store = Store::open(
+        Config::new(Namespace::new("dev.rightkit.credentials.test.seal-other").unwrap())
+            .backend(Arc::new(MemoryBackend::new())),
+    );
+    let other = Sealer::StoreKey { store: &other_store, account: "history-key-1" };
+    assert!(open_blob(&other, b"PULSECL1", &file).is_err());
+}
+
+#[test]
+fn the_pin_wrap_and_mac_helpers_agree_with_each_other() {
+    let key = [5u8; KEY_LEN];
+    // The slow derivation is exercised once here with the real round count.
+    assert_eq!(derive_pin_key("1234", b"0123456789abcdef").len(), KEY_LEN);
+    let wrapped = wrap_key(&key, "1234", b"purpose").unwrap();
+    assert_eq!(*unwrap_key(&wrapped, "1234", b"purpose").unwrap(), key);
+    assert!(unwrap_key(&wrapped, "1235", b"purpose").is_err());
+
+    let sealed = aead_seal(&key, b"a", b"m").unwrap();
+    assert_eq!(aead_open(&key, b"a", &sealed).unwrap().expose_bytes(), b"m");
+    let mac = seal_mac(&key, b"blob");
+    assert!(check_mac(&key, b"blob", Some(&mac)));
+    assert!(!check_mac(&key, b"blob!", Some(&mac)));
+}
+
+#[test]
+fn a_pin_seal_key_lives_in_the_store_and_needs_its_pin_after_a_restart() {
+    let store = store();
+    let first = PinSealKey::new(store.clone(), "seal-key", "test.public.seal.v1");
+    let mac = first.make_seal(b"blob", false).unwrap();
+    assert!(first.check_seal(b"blob", Some(&mac)));
+    // The key is a store item, not a file.
+    assert!(store.exists("seal-key").unwrap());
+    first.reset().unwrap();
+    assert!(!store.exists("seal-key").unwrap());
+}
+
+#[test]
+fn approval_helpers_reject_nonsense() {
+    assert!(!verify_p256(&[4u8; 65], b"m", &[0u8; 64]));
+    assert_eq!(owner_key_id(b"").len(), 32);
+    assert!(PartitionPolicy::team("not a team").is_err());
+}
+
+#[cfg(not(all(windows, feature = "windows-hello")))]
+#[test]
+fn user_verification_fails_closed_where_it_is_not_built() {
+    assert!(matches!(verify_user("test"), Err(Error::Unavailable(_))));
+}
diff --git a/crates/rightkit-credentials/tests/secret_file_feature.rs b/crates/rightkit-credentials/tests/secret_file_feature.rs
new file mode 100644
index 0000000..66a9239
--- /dev/null
+++ b/crates/rightkit-credentials/tests/secret_file_feature.rs
@@ -0,0 +1,70 @@
+//! `env-file` is an opt-in feature for headless daemons: off by default, the fs dependency
+//! optional and only behind it, the module and its exports gated. Reads the manifest and source,
+//! so it runs (and checks) in a build without the feature.
+
+const MANIFEST: &str = include_str!("../Cargo.toml");
+const LIB: &str = include_str!("../src/lib.rs");
+const SOURCE: &str = include_str!("../src/secret_file.rs");
+
+#[test]
+fn env_file_is_off_by_default() {
+    assert!(
+        !MANIFEST.lines().any(|l| l.trim_start().starts_with("default")),
+        "the crate has no default feature, so env-file is off"
+    );
+    assert!(
+        MANIFEST.lines().any(|l| l.trim() == r#"env-file = ["dep:rightkit-fs"]"#),
+        "env-file enables only the optional fs dependency"
+    );
+}
+
+#[test]
+fn the_fs_dependency_is_optional() {
+    let line = MANIFEST
+        .lines()
+        .find(|l| l.trim_start().starts_with("rightkit-fs"))
+        .expect("rightkit-fs dependency");
+    assert!(line.contains("optional = true"), "{line}");
+}
+
+#[test]
+fn no_other_feature_enables_env_file() {
+    let features = MANIFEST.split("[features]").nth(1).expect("[features]");
+    let features = features.split("\n[").next().unwrap();
+    let users = features
+        .lines()
+        .filter(|l| l.contains("env-file") && !l.trim_start().starts_with("env-file ="))
+        .filter(|l| !l.trim_start().starts_with('#'))
+        .count();
+    assert_eq!(users, 0, "only the env-file feature itself names env-file");
+}
+
+#[test]
+fn the_module_and_exports_are_gated() {
+    let at = |needle: &str| LIB.find(needle).unwrap_or_else(|| panic!("{needle} missing"));
+    for needle in ["mod secret_file;", "pub use secret_file::"] {
+        let line_start = LIB[..at(needle)].rfind('\n').map_or(0, |i| i + 1);
+        let before = LIB[..line_start].trim_end().lines().last().unwrap_or("");
+        assert_eq!(before.trim(), r#"#[cfg(feature = "env-file")]"#, "{needle} must be gated");
+    }
+}
+
+/// D4 (rightkit#771): no credential is written to a file. The secret-file reader only reads.
+#[test]
+fn the_reader_never_writes_a_file() {
+    let code = SOURCE.split("#[cfg(test)]").next().unwrap();
+    for banned in [
+        "fs::write",
+        "File::create",
+        "create_new",
+        "OpenOptions",
+        "fs::copy",
+        "fs::rename",
+        "remove_file",
+        "set_permissions",
+        "write_private",
+        "atomic_write",
+    ] {
+        assert!(!code.contains(banned), "secret_file.rs must only read: found {banned}");
+    }
+}

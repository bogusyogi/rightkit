+//! Trust checks the [`crate::apple_helper::AppleHelper`] enforces itself, so a caller cannot forget
+//! them: **bundle containment** and a **same-team code signature**. Both fail closed.
+//!
+//! * Containment ([`contain_in_bundle`], all platforms): the helper path and the bundle root are
+//!   both canonicalized (symlinks and `..` resolved); the helper must be a regular file strictly
+//!   inside the root. A symlink that leaves the bundle is refused, one that stays inside is fine.
+//! * Signature (macOS): the helper must pass a strict static validity check and satisfy the
+//!   requirement `anchor apple generic and certificate leaf[subject.OU] = "<team>"`, where
+//!   `<team>` is the Team ID of the host executable ([`TeamPolicy::SameAsHost`]) or a fixed
+//!   Team ID ([`TeamPolicy::Fixed`]). The check uses `SecStaticCode` / `SecRequirement`; when the
+//!   Security API cannot be set up it falls back to `/usr/bin/codesign --verify --strict` and
+//!   `codesign -dv` (parsing `TeamIdentifier=`). An unsigned host or helper, an ad-hoc signature
+//!   (no Team ID), a failed check, a timeout or an unrunnable tool is a refusal, never a pass.
+//!   On other platforms there is no code signature to check, so a signature policy other than
+//!   [`TeamPolicy::Skip`] is refused rather than silently ignored.
+//!
+//! When the code is the main executable of an `.app`, the signature of the whole `.app` is checked
+//! (see `signing_target`), so nested code and resources are covered too.
+//!
+//! What this does not do: a process able to replace files inside the install directory can replace
+//! the host executable as well. This guards against a swapped or foreign-signed helper, not a
+//! fully compromised install. The check runs before every spawn, narrowing (not closing) the gap
+//! between check and exec.
+
+use crate::error::{Error, Result};
+use std::path::{Path, PathBuf};
+
+/// Which Team ID the helper must be signed with.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum TeamPolicy {
+    /// The helper's Team ID must equal the running host executable's Team ID (which must exist).
+    SameAsHost,
+    /// The helper must be signed by this ten-character Team ID.
+    Fixed(String),
+    /// No signature check. Development only; containment is still enforced. The caller chooses
+    /// this by name: nothing selects it by default.
+    Skip,
+}
+
+/// What the helper must satisfy before it is executed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HelperTrust {
+    bundle_root: PathBuf,
+    team: TeamPolicy,
+}
+
+impl HelperTrust {
+    /// Require containment in `bundle_root` and a signature by the host's own Team ID.
+    pub fn new(bundle_root: impl Into<PathBuf>) -> Self {
+        Self {
+            bundle_root: bundle_root.into(),
+            team: TeamPolicy::SameAsHost,
+        }
+    }
+
+    /// Root of the `.app` that contains the running executable (`<App>.app/Contents/MacOS/<bin>`).
+    /// Errors when this process is not running from a bundle: there is nothing to contain the
+    /// helper in, so none is trusted.
+    pub fn for_running_app() -> Result<Self> {
+        let exe = std::env::current_exe()
+            .and_then(|p| p.canonicalize())
+            .map_err(|e| Error::Helper(format!("cannot locate the running app: {}", e.kind())))?;
+        let root = exe
+            .parent()
+            .and_then(Path::parent)
+            .and_then(Path::parent)
+            .filter(|r| r.extension().is_some_and(|e| e == "app"))
+            .ok_or_else(|| Error::Helper("the running executable is not inside an .app bundle".into()))?;
+        Ok(Self::new(root))
+    }
+
+    pub fn team(mut self, team: TeamPolicy) -> Self {
+        self.team = team;
+        self
+    }
+
+    /// Check `helper` and return the canonical path to execute. The caller runs the returned
+    /// path, not the one it passed in.
+    pub fn verify(&self, helper: &Path) -> Result<PathBuf> {
+        let canonical = contain_in_bundle(helper, &self.bundle_root)?;
+        match &self.team {
+            TeamPolicy::Skip => {}
+            TeamPolicy::Fixed(id) => {
+                let id = valid_team_id(id)?;
+                check_signature(&canonical, id)?;
+            }
+            TeamPolicy::SameAsHost => {
+                let host = host_team_id()?;
+                check_signature(&canonical, &host)?;
+            }
+        }
+        Ok(canonical)
+    }
+}
+
+/// Canonicalize `helper` and `root`; the helper must be a regular file strictly inside the root.
+pub fn contain_in_bundle(helper: &Path, root: &Path) -> Result<PathBuf> {
+    let refuse = |why: &str| Error::Helper(format!("helper {} refused: {why}", helper.display()));
+    let canonical = helper
+        .canonicalize()
+        .map_err(|e| refuse(&format!("cannot resolve it ({:?})", e.kind())))?;
+    let root = root
+        .canonicalize()
+        .map_err(|e| refuse(&format!("bundle root cannot be resolved ({:?})", e.kind())))?;
+    if canonical == root || !canonical.starts_with(&root) {
+        return Err(refuse("it resolves outside the app bundle"));
+    }
+    if !std::fs::metadata(&canonical).is_ok_and(|m| m.is_file()) {
+        return Err(refuse("it is not a regular file"));
+    }
+    Ok(canonical)
+}
+
+/// A Team ID is ten ASCII letters or digits. Anything else is refused before it can reach a
+/// requirement string.
+fn valid_team_id(id: &str) -> Result<&str> {
+    if id.len() == 10 && id.bytes().all(|b| b.is_ascii_alphanumeric()) {
+        Ok(id)
+    } else {
+        Err(Error::Helper("team identifier is not a ten-character alphanumeric id".into()))
+    }
+}
+
+/// The requirement a helper must satisfy for `team`.
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+pub(crate) fn team_requirement(team: &str) -> String {
+    format!("anchor apple generic and certificate leaf[subject.OU] = \"{team}\"")
+}
+
+/// What is checked for the code at `exe`: when `exe` is the main executable of an app bundle
+/// (`<Name>.app/Contents/MacOS/<exe>`), the enclosing `.app` (so its resources and nested code are
+/// covered by the signature check, not just one Mach-O file); otherwise `exe` itself.
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+pub(crate) fn signing_target(exe: &Path) -> PathBuf {
+    let in_app = || {
+        let macos_dir = exe.parent()?;
+        let contents = macos_dir.parent()?;
+        let app = contents.parent()?;
+        let is = macos_dir.file_name()? == "MacOS"
+            && contents.file_name()? == "Contents"
+            && app.extension().is_some_and(|e| e.eq_ignore_ascii_case("app"));
+        is.then(|| app.to_path_buf())
+    };
+    in_app().unwrap_or_else(|| exe.to_path_buf())
+}
+
+/// `TeamIdentifier=` from `codesign -dv` output. `not set` (ad-hoc or unsigned) is `None`.
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+pub(crate) fn parse_team_identifier(text: &str) -> Option<String> {
+    text.lines()
+        .find_map(|l| l.trim().strip_prefix("TeamIdentifier="))
+        .map(str::trim)
+        .filter(|id| valid_team_id(id).is_ok())
+        .map(str::to_string)
+}
+
+#[cfg(not(target_os = "macos"))]
+fn host_team_id() -> Result<String> {
+    Err(Error::Helper(
+        "a same-team signature check needs macOS code signing; use TeamPolicy::Skip off macOS".into(),
+    ))
+}
+
+#[cfg(not(target_os = "macos"))]
+fn check_signature(_helper: &Path, _team: &str) -> Result<()> {
+    Err(Error::Helper(
+        "a signature check needs macOS code signing; use TeamPolicy::Skip off macOS".into(),
+    ))
+}
+
+#[cfg(target_os = "macos")]
+fn host_team_id() -> Result<String> {
+    static HOST: std::sync::OnceLock<std::result::Result<String, String>> =
+        std::sync::OnceLock::new();
+    HOST.get_or_init(|| {
+        let exe = std::env::current_exe()
+            .and_then(|p| p.canonicalize())
+            .map_err(|e| format!("cannot locate the running executable ({:?})", e.kind()))?;
+        sign::team_of(&signing_target(&exe)).map_err(|e| format!("the host executable has no usable signature: {e}"))
+    })
+    .clone()
+    .map_err(Error::Helper)
+}
+
+#[cfg(target_os = "macos")]
+fn check_signature(helper: &Path, team: &str) -> Result<()> {
+    sign::verify_team(&signing_target(helper), team).map_err(|e| {
+        Error::Helper(format!("helper {} failed its signature check: {e}", helper.display()))
+    })
+}
+
+#[cfg(target_os = "macos")]
+mod sign {
+    use super::{parse_team_identifier, team_requirement};
+    use std::ffi::c_void;
+    use std::os::raw::c_char;
+    use std::path::Path;
+    use std::process::{Command, Stdio};
+    use std::time::{Duration, Instant};
+
+    type CFTypeRef = *const c_void;
+    type OSStatus = i32;
+    const UTF8: u32 = 0x0800_0100;
+    const CS_CHECK_ALL_ARCH: u32 = 1 << 0;
+    const CS_CHECK_NESTED: u32 = 1 << 3;
+    const CS_STRICT: u32 = 1 << 4;
+    const CS_SIGNING_INFORMATION: u32 = 1 << 1;
+    const CODESIGN: &str = "/usr/bin/codesign";
+    const CODESIGN_TIMEOUT: Duration = Duration::from_secs(20);
+
+    #[link(name = "CoreFoundation", kind = "framework")]
+    extern "C" {
+        fn CFRelease(cf: CFTypeRef);
+        fn CFURLCreateFromFileSystemRepresentation(
+            alloc: CFTypeRef,
+            buf: *const u8,
+            len: isize,
+            is_directory: u8,
+        ) -> CFTypeRef;
+        fn CFStringCreateWithCString(alloc: CFTypeRef, c: *const c_char, enc: u32) -> CFTypeRef;
+        fn CFStringGetCString(s: CFTypeRef, buf: *mut c_char, size: isize, enc: u32) -> u8;
+        fn CFDictionaryGetValue(d: CFTypeRef, key: CFTypeRef) -> CFTypeRef;
+    }
+
+    #[link(name = "Security", kind = "framework")]
+    extern "C" {
+        fn SecStaticCodeCreateWithPath(path: CFTypeRef, flags: u32, out: *mut CFTypeRef) -> OSStatus;
+        fn SecRequirementCreateWithString(text: CFTypeRef, flags: u32, out: *mut CFTypeRef) -> OSStatus;
+        fn SecStaticCodeCheckValidity(code: CFTypeRef, flags: u32, requirement: CFTypeRef) -> OSStatus;
+        fn SecCodeCopySigningInformation(code: CFTypeRef, flags: u32, out: *mut CFTypeRef) -> OSStatus;
+        static kSecCodeInfoTeamIdentifier: CFTypeRef;
+    }
+
+    /// Owned CoreFoundation object, released on drop.
+    struct Cf(CFTypeRef);
+    impl Drop for Cf {
+        fn drop(&mut self) {
+            if !self.0.is_null() {
+                // SAFETY: the pointer came from a Create/Copy call that returned a +1 object.
+                unsafe { CFRelease(self.0) };
+            }
+        }
+    }
+
+    /// The outcome of the Security API: a verdict, or "could not be asked" (use the CLI).
+    enum Api<T> {
+        Done(T),
+        Refused(String),
+        Unavailable,
+    }
+
+    fn static_code(path: &Path) -> Api<Cf> {
+        use std::os::unix::ffi::OsStrExt;
+        let bytes = path.as_os_str().as_bytes();
+        // SAFETY: a valid buffer and length; a null result is handled.
+        let url = Cf(unsafe {
+            CFURLCreateFromFileSystemRepresentation(
+                std::ptr::null(),
+                bytes.as_ptr(),
+                bytes.len() as isize,
+                u8::from(path.is_dir()),
+            )
+        });
+        if url.0.is_null() {
+            return Api::Unavailable;
+        }
+        let mut code: CFTypeRef = std::ptr::null();
+        // SAFETY: `url` is a live CFURL; `code` is a valid out pointer.
+        let status = unsafe { SecStaticCodeCreateWithPath(url.0, 0, &mut code) };
+        if status != 0 || code.is_null() {
+            return Api::Unavailable;
+        }
+        Api::Done(Cf(code))
+    }
+
+    fn api_team_of(path: &Path) -> Api<String> {
+        let code = match static_code(path) {
+            Api::Done(c) => c,
+            Api::Unavailable => return Api::Unavailable,
+            Api::Refused(r) => return Api::Refused(r),
+        };
+        let mut info: CFTypeRef = std::ptr::null();
+        // SAFETY: live code object, valid out pointer.
+        let status = unsafe { SecCodeCopySigningInformation(code.0, CS_SIGNING_INFORMATION, &mut info) };
+        if status != 0 || info.is_null() {
+            return Api::Refused(format!("signing information unavailable (status {status}): unsigned?"));
+        }
+        let info = Cf(info);
+        // SAFETY: info is a CFDictionary; the key is a framework constant. The value is not owned.
+        let value = unsafe { CFDictionaryGetValue(info.0, kSecCodeInfoTeamIdentifier) };
+        if value.is_null() {
+            return Api::Refused("it has no Team ID (unsigned or ad-hoc signed)".into());
+        }
+        let mut buf = [0 as c_char; 64];
+        // SAFETY: the value is a CFString (documented for this key); the buffer length is passed.
+        let ok = unsafe { CFStringGetCString(value, buf.as_mut_ptr(), buf.len() as isize, UTF8) };
+        if ok == 0 {
+            return Api::Refused("its Team ID could not be read".into());
+        }
+        // SAFETY: CFStringGetCString NUL-terminates inside the buffer on success.
+        let text = unsafe { std::ffi::CStr::from_ptr(buf.as_ptr()) }.to_string_lossy().into_owned();
+        match super::valid_team_id(&text) {
+            Ok(id) => Api::Done(id.to_string()),
+            Err(_) => Api::Refused("its Team ID is malformed".into()),
+        }
+    }
+
+    fn api_verify(path: &Path, team: &str) -> Api<()> {
+        let code = match static_code(path) {
+            Api::Done(c) => c,
+            Api::Unavailable => return Api::Unavailable,
+            Api::Refused(r) => return Api::Refused(r),
+        };
+        let text = team_requirement(team);
+        let Ok(c_text) = std::ffi::CString::new(text) else {
+            return Api::Unavailable;
+        };
+        // SAFETY: valid NUL-terminated string.
+        let req_text = Cf(unsafe { CFStringCreateWithCString(std::ptr::null(), c_text.as_ptr(), UTF8) });
+        if req_text.0.is_null() {
+            return Api::Unavailable;
+        }
+        let mut req: CFTypeRef = std::ptr::null();
+        // SAFETY: live CFString, valid out pointer.
+        let status = unsafe { SecRequirementCreateWithString(req_text.0, 0, &mut req) };
+        if status != 0 || req.is_null() {
+            return Api::Unavailable;
+        }
+        let req = Cf(req);
+        // SAFETY: live code and requirement objects.
+        let status = unsafe {
+            SecStaticCodeCheckValidity(code.0, CS_CHECK_ALL_ARCH | CS_CHECK_NESTED | CS_STRICT, req.0)
+        };
+        if status == 0 {
+            Api::Done(())
+        } else {
+            Api::Refused(format!("strict validity or requirement check failed (status {status})"))
+        }
+    }
+
+    /// Run a tool with a deadline; returns (success, stderr text).
+    fn run(args: &[&str], path: &Path) -> Result<(bool, String), String> {
+        use std::io::Read;
+        let mut child = Command::new(CODESIGN)
+            .args(args)
+            .arg(path)
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::piped())
+            .spawn()
+            .map_err(|e| format!("cannot run codesign ({:?})", e.kind()))?;
+        let mut stderr = child.stderr.take().ok_or("no codesign stderr")?;
+        let reader = std::thread::spawn(move || {
+            let mut text = String::new();
+            let _ = stderr.by_ref().take(64 * 1024).read_to_string(&mut text);
+            text
+        });
+        let started = Instant::now();
+        let status = loop {
+            match child.try_wait() {
+                Ok(Some(s)) => break s,
+                Ok(None) if started.elapsed() < CODESIGN_TIMEOUT => {
+                    std::thread::sleep(Duration::from_millis(20))
+                }
+                Ok(None) => {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                    return Err("codesign timed out".into());
+                }
+                Err(e) => {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                    return Err(format!("waiting on codesign failed ({:?})", e.kind()));
+                }
+            }
+        };
+        let text = reader.join().unwrap_or_default();
+        Ok((status.success(), text))
+    }
+
+    fn cli_team_of(path: &Path) -> Result<String, String> {
+        let (ok, text) = run(&["-dv", "--verbose=4"], path)?;
+        if !ok {
+            return Err(format!("codesign -dv failed: {}", text.trim()));
+        }
+        parse_team_identifier(&text).ok_or_else(|| "it has no Team ID (unsigned or ad-hoc signed)".into())
+    }
+
+    fn cli_verify(path: &Path, team: &str) -> Result<(), String> {
+        let requirement = format!("={}", team_requirement(team));
+        let (ok, text) = run(&["--verify", "--strict", "-R", &requirement], path)?;
+        if !ok {
+            return Err(format!("codesign --verify failed: {}", text.trim()));
+        }
+        // The requirement proves the leaf OU; reading the Team ID back confirms the same value.
+        if cli_team_of(path)? != team {
+            return Err("its Team ID differs from the required one".into());
+        }
+        Ok(())
+    }
+
+    pub(super) fn team_of(path: &Path) -> Result<String, String> {
+        match api_team_of(path) {
+            Api::Done(id) => Ok(id),
+            Api::Refused(why) => Err(why),
+            Api::Unavailable => cli_team_of(path),
+        }
+    }
+
+    pub(super) fn verify_team(path: &Path, team: &str) -> Result<(), String> {
+        match api_verify(path, team) {
+            Api::Done(()) => {
+                // Belt and braces: the Team ID read back must be the required one.
+                match api_team_of(path) {
+                    Api::Done(id) if id == team => Ok(()),
+                    Api::Done(_) => Err("its Team ID differs from the required one".into()),
+                    Api::Refused(why) => Err(why),
+                    Api::Unavailable => cli_verify(path, team),
+                }
+            }
+            Api::Refused(why) => Err(why),
+            Api::Unavailable => cli_verify(path, team),
+        }
+    }
+}

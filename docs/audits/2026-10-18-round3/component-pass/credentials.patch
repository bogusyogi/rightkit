+        assert!(restarted.make_seal(b"blob", true).is_none());
+        restarted.pin_entered("0000");
+        // A wrong PIN replaces the item with a fresh key: the old seal no longer verifies.
+        assert!(!restarted.check_seal(b"blob", Some(&mac)));
+        assert!(restarted.key_from_pin());

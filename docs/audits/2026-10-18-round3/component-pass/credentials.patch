+    #[test]
+    fn another_label_or_damage_does_not_open() {
+        let store = store("dev.rightkit.credentials.test.pin6");
+        let seal = seal_key(&store, "test.seal.v1");
+        seal.pin_changed("2468");
+        let other = seal_key(&store, "other.label");
+        other.pin_entered("2468");
+        // The label differs, so the PIN item did not open: a fresh key replaced it.
+        assert!(other.key_from_pin());
+        store.set_str("seal-key", "garbage").unwrap();
+        // A damaged item is never overwritten by a first-run mint.
+        assert!(seal_key(&store, "test.seal.v1").make_seal(b"x", false).is_none());
+        assert_eq!(store.get("seal-key").unwrap().unwrap().expose_str().unwrap(), "garbage");

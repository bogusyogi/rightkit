+    }
+
+    #[test]
+    fn first_run_makes_a_key_that_verifies_and_is_not_from_a_pin() {
+        let store = store("dev.rightkit.credentials.test.pin1");
+        let seal = seal_key(&store, "test.seal.v1");
+        let mac = seal.make_seal(b"blob", false).unwrap();
+        assert!(seal.check_seal(b"blob", Some(&mac)));
+        assert!(!seal.check_seal(b"other", Some(&mac)));
+        assert!(!seal.check_seal(b"blob", None));
+        assert!(!seal.key_from_pin());
+        assert!(!seal.pin_bound());
+        // A second instance (a restart) reads the same clear key from the store.
+        let again = seal_key(&store, "test.seal.v1");
+        assert!(again.check_seal(b"blob", Some(&mac)));
+    }
+
+    #[test]

new file mode 100644
index 0000000..dfe2dd0
--- /dev/null
+++ b/crates/rightkit-credentials/src/secret_file.rs
@@ -0,0 +1,318 @@
+//! Read one secret from a file whose path is named by an environment variable (rightkit#458).
+//!
+//! Feature `env-file`, off by default, **for headless server daemons only**: a container or a
+//! service unit is handed a secret as a path (`APP_TOKEN_FILE=/run/secrets/token`, the Docker and
+//! systemd `*_FILE` convention), so the value never appears in the process environment or on a
+//! command line. A desktop app's release build takes its secrets from the OS credential store
+//! ([`crate::Store`]) and must not enable the feature.
+//!
+//! This module only **reads**. It never creates, writes, copies or deletes a file, and it never
+//! puts a credential in a file: the file is something the operator provisioned.
+//!
+//! It fails closed. The path is not followed through a symlink; the file must be a regular file,
+//! non-empty after trimming, at most [`MAX_SECRET_FILE_BYTES`], owned by the current user and
+//! owner-only (`rightkit_fs::private::verify_owner_only`: Unix mode bits and the macOS ACL;
+//! Windows owner and DACL). The check runs before the read and again after it, so a file swapped
+//! for a readable one while it was being read is refused. No error value, message or `Debug`
+//! output carries the secret, and the read buffer is wiped on drop.
+
+use crate::error::Error;
+use crate::secret::Secret;
+use rightkit_fs::FsError;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use zeroize::Zeroizing;
+
+/// Largest secret file accepted, in bytes (before trimming). 64 KiB holds a PEM private key.
+pub const MAX_SECRET_FILE_BYTES: u64 = 64 * 1024;
+
+/// Why a secret file was refused. Messages name the variable and the path, never the content.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum SecretFileError {
+    /// The environment variable is unset or empty.
+    #[error("{var} is not set: set it to the path of a file holding the secret")]
+    NotSet { var: String },
+    /// The named file does not exist.
+    #[error("{var}: secret file {path} does not exist")]
+    Missing { var: String, path: PathBuf },
+    /// The file is not safe to trust: a symlink or other non-regular file, owned by someone else,
+    /// accessible to anyone but the owner, or its permissions could not be proven private.
+    /// Nothing was read.
+    #[error("{var}: secret file {path} is not safe to use: {reason}")]
+    Unsafe {
+        var: String,
+        path: PathBuf,
+        reason: String,
+    },
+    /// Larger than [`MAX_SECRET_FILE_BYTES`].
+    #[error("{var}: secret file {path} is larger than {max} bytes")]
+    TooLarge {
+        var: String,
+        path: PathBuf,
+        max: u64,
+    },
+    /// The file holds nothing after trimming surrounding ASCII whitespace.
+    #[error("{var}: secret file {path} is empty")]
+    Empty { var: String, path: PathBuf },
+    /// Any other i/o failure (kind only, never contents).
+    #[error("{var}: cannot read secret file {path}: {kind:?}")]
+    Io {
+        var: String,
+        path: PathBuf,
+        kind: std::io::ErrorKind,
+    },
+}
+
+impl From<SecretFileError> for Error {
+    fn from(e: SecretFileError) -> Self {
+        match e {
+            SecretFileError::Missing { .. } | SecretFileError::Io { .. } => Error::Io(e.to_string()),
+            _ => Error::Invalid {
+                what: "secret file",
+                reason: e.to_string(),
+            },
+        }
+    }
+}
+
+/// Read the secret from the file named by environment variable `var`.
+pub fn secret_from_env_file(var: &str) -> Result<Secret, SecretFileError> {
+    secret_from_env_file_with(var, &|name| std::env::var_os(name))
+}
+
+/// [`secret_from_env_file`] with an injectable environment reader (tests never touch the process
+/// environment).
+pub fn secret_from_env_file_with(
+    var: &str,
+    env: &dyn Fn(&str) -> Option<std::ffi::OsString>,
+) -> Result<Secret, SecretFileError> {
+    match env(var) {
+        Some(p) if !p.is_empty() => secret_from_file_named(var, Path::new(&p)),
+        _ => Err(SecretFileError::NotSet { var: var.into() }),
+    }
+}
+
+/// Read the secret from `path` under the same rules; `var` only labels errors.
+pub fn secret_from_file_named(var: &str, path: &Path) -> Result<Secret, SecretFileError> {
+    let io_err = |e: std::io::Error| {
+        if e.kind() == std::io::ErrorKind::NotFound {
+            SecretFileError::Missing {
+                var: var.into(),
+                path: path.to_path_buf(),
+            }
+        } else {
+            SecretFileError::Io {
+                var: var.into(),
+                path: path.to_path_buf(),
+                kind: e.kind(),
+            }
+        }
+    };
+    let unsafe_ = |reason: String| SecretFileError::Unsafe {
+        var: var.into(),
+        path: path.to_path_buf(),
+        reason,
+    };
+    let too_large = || SecretFileError::TooLarge {
+        var: var.into(),
+        path: path.to_path_buf(),
+        max: MAX_SECRET_FILE_BYTES,
+    };
+    let empty = || SecretFileError::Empty {
+        var: var.into(),
+        path: path.to_path_buf(),
+    };
+
+    // A symlink is refused, never followed: its target could be swapped, and the link's own mode
+    // says nothing about the file a read would reach.
+    let meta = std::fs::symlink_metadata(path).map_err(io_err)?;
+    if !meta.is_file() {
+        return Err(unsafe_(
+            "not a regular file (a symlink, directory or device is refused)".into(),
+        ));
+    }
+    if meta.len() > MAX_SECRET_FILE_BYTES {
+        return Err(too_large());
+    }
+    check_owner_only(path, &unsafe_)?;
+
+    let mut file = std::fs::File::open(path).map_err(io_err)?;
+    // The opened file must be the regular file inspected above (not swapped for another object).
+    let opened = file.metadata().map_err(io_err)?;
+    if !opened.is_file() || opened.len() > MAX_SECRET_FILE_BYTES {
+        return Err(unsafe_("the file changed while it was being opened".into()));
+    }
+    let mut buf = Zeroizing::new(Vec::with_capacity(MAX_SECRET_FILE_BYTES as usize + 1));
+    (&mut file)
+        .take(MAX_SECRET_FILE_BYTES + 1)
+        .read_to_end(&mut buf)
+        .map_err(io_err)?;
+    drop(file);
+    if buf.len() as u64 > MAX_SECRET_FILE_BYTES {
+        return Err(too_large());
+    }
+    // Again after the read: a file made readable (or replaced) while it was read is refused and
+    // the buffer is wiped on drop.
+    check_owner_only(path, &unsafe_)?;
+
+    let trimmed = buf.trim_ascii();
+    if trimmed.is_empty() {
+        return Err(empty());
+    }
+    Ok(Secret::from_bytes(trimmed.to_vec()))
+}
+
+fn check_owner_only(
+    path: &Path,
+    unsafe_: &dyn Fn(String) -> SecretFileError,
+) -> Result<(), SecretFileError> {
+    match rightkit_fs::private::verify_owner_only(path) {
+        Ok(()) => Ok(()),
+        Err(FsError::NotOwned(_)) => Err(unsafe_("owned by another user".into())),
+        Err(FsError::TooPermissive(_)) | Err(FsError::UnsafeAcl(_)) => Err(unsafe_(
+            "group, other or an extra principal can access it; make it owner-only (chmod 600)"
+                .into(),
+        )),
+        Err(FsError::Symlink(_)) => Err(unsafe_("a symlink is refused".into())),
+        // Unreadable security metadata or an unsupported filesystem cannot be proven private.
+        Err(_) => Err(unsafe_("owner-only access could not be verified".into())),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::ffi::OsString;
+
+    fn env_with(var: &'static str, path: &Path) -> impl Fn(&str) -> Option<OsString> {
+        let p = path.as_os_str().to_owned();
+        move |n| (n == var).then(|| p.clone())
+    }
+
+    fn private_file(dir: &Path, name: &str, body: &[u8]) -> PathBuf {
+        let p = dir.join(name);
+        rightkit_fs::write_private_file(&p, body).unwrap();
+        p
+    }
+
+    #[test]
+    fn reads_trims_and_returns_the_secret() {
+        let d = tempfile::tempdir().unwrap();
+        let p = private_file(d.path(), "t", b"  s3cret-token\n");
+        let s = secret_from_env_file_with("V", &env_with("V", &p)).unwrap();
+        assert_eq!(s.expose_str().unwrap(), "s3cret-token");
+        assert!(!format!("{s:?}").contains("s3cret"));
+    }
+
+    #[test]
+    fn unset_or_empty_variable_is_not_set() {
+        assert!(matches!(
+            secret_from_env_file_with("V", &|_| None),
+            Err(SecretFileError::NotSet { .. })
+        ));
+        assert!(matches!(
+            secret_from_env_file_with("V", &|_| Some(OsString::new())),
+            Err(SecretFileError::NotSet { .. })
+        ));
+    }
+
+    #[test]
+    fn missing_file_is_typed() {
+        let d = tempfile::tempdir().unwrap();
+        let p = d.path().join("absent");
+        assert!(matches!(
+            secret_from_env_file_with("V", &env_with("V", &p)),
+            Err(SecretFileError::Missing { .. })
+        ));
+    }
+
+    #[test]
+    fn empty_blank_oversized_and_directory_are_refused() {
+        let d = tempfile::tempdir().unwrap();
+        let empty = private_file(d.path(), "e", b"");
+        let blank = private_file(d.path(), "b", b" \n\t ");
+        let big = private_file(d.path(), "big", &vec![b'a'; MAX_SECRET_FILE_BYTES as usize + 1]);
+        let edge = private_file(d.path(), "edge", &vec![b'a'; MAX_SECRET_FILE_BYTES as usize]);
+        assert!(matches!(secret_from_file_named("V", &empty), Err(SecretFileError::Empty { .. })));
+        assert!(matches!(secret_from_file_named("V", &blank), Err(SecretFileError::Empty { .. })));
+        assert!(matches!(secret_from_file_named("V", &big), Err(SecretFileError::TooLarge { .. })));
+        assert_eq!(
+            secret_from_file_named("V", &edge).unwrap().len(),
+            MAX_SECRET_FILE_BYTES as usize
+        );
+        assert!(matches!(
+            secret_from_file_named("V", d.path()),
+            Err(SecretFileError::Unsafe { .. })
+        ));
+    }
+
+    #[test]
+    fn a_multi_line_value_is_kept_whole_and_only_the_ends_are_trimmed() {
+        let d = tempfile::tempdir().unwrap();
+        let p = private_file(d.path(), "pem", b"\n-----BEGIN-----\nabc\n-----END-----\n\n");
+        let s = secret_from_file_named("V", &p).unwrap();
+        assert_eq!(s.expose_str().unwrap(), "-----BEGIN-----\nabc\n-----END-----");
+    }
+
+    #[test]
+    fn errors_never_carry_the_value() {
+        let d = tempfile::tempdir().unwrap();
+        let big = private_file(d.path(), "big", &vec![b'~'; MAX_SECRET_FILE_BYTES as usize + 1]);
+        let e = secret_from_file_named("V", &big).unwrap_err();
+        assert!(!format!("{e} {e:?}").contains("~~~~"));
+        let converted: Error = e.into();
+        assert!(!format!("{converted} {converted:?}").contains("~~~~"));
+        let blank = private_file(d.path(), "blank", b"  \n");
+        let converted: Error = secret_from_file_named("V", &blank).unwrap_err().into();
+        assert!(matches!(converted, Error::Invalid { .. }));
+        let missing: Error = secret_from_file_named("V", &d.path().join("none")).unwrap_err().into();
+        assert!(matches!(missing, Error::Io(_)));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn group_or_other_access_is_refused_and_owner_only_is_read() {
+        use std::os::unix::fs::PermissionsExt;
+        let d = tempfile::tempdir().unwrap();
+        let p = private_file(d.path(), "t", b"hunter2");
+        for mode in [0o640, 0o604, 0o644, 0o666, 0o660] {
+            std::fs::set_permissions(&p, std::fs::Permissions::from_mode(mode)).unwrap();
+            let e = secret_from_file_named("V", &p).unwrap_err();
+            assert!(matches!(e, SecretFileError::Unsafe { .. }), "mode {mode:o}");
+            assert!(!format!("{e} {e:?}").contains("hunter2"));
+        }
+        std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o400)).unwrap();
+        assert!(secret_from_file_named("V", &p).is_ok());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_symlink_is_refused() {
+        let d = tempfile::tempdir().unwrap();
+        let p = private_file(d.path(), "t", b"tok");
+        let l = d.path().join("link");
+        std::os::unix::fs::symlink(&p, &l).unwrap();
+        assert!(matches!(
+            secret_from_file_named("V", &l),
+            Err(SecretFileError::Unsafe { .. })
+        ));
+    }
+
+    #[cfg(windows)]
+    #[test]
+    fn a_hardened_file_is_read_and_a_loose_acl_is_refused() {
+        let d = tempfile::tempdir().unwrap();
+        let ok = private_file(d.path(), "ok", b"tok");
+        assert_eq!(secret_from_file_named("V", &ok).unwrap().expose_str().unwrap(), "tok");
+        // A plain write inherits the parent's DACL. Whether that is owner-only depends on the
+        // temp directory's ACL, so only the refusal direction is asserted.
+        let loose = d.path().join("loose");
+        std::fs::write(&loose, b"tok").unwrap();
+        if rightkit_fs::private::verify_owner_only(&loose).is_err() {
+            assert!(matches!(
+                secret_from_file_named("V", &loose),
+                Err(SecretFileError::Unsafe { .. })
+            ));
+        }
+    }
+}
diff --git a/crates/rightkit-credentials/src/verify.rs b/crates/rightkit-credentials/src/verify.rs
new file mode 100644
index 0000000..72e90a8
--- /dev/null
+++ b/crates/rightkit-credentials/src/verify.rs
@@ -0,0 +1,215 @@
+//! User verification: proving the person at the keyboard is the account owner.
+//!
+//! * Windows: Windows Hello through the WinRT `UserConsentVerifier`, behind the `windows-hello`
+//!   feature.
+//! * macOS: not in this crate. Touch ID / the login password needs `LocalAuthentication`, which has
+//!   no C API; use `RightKitCredentials.UserVerification` in RightKitSwift. Here every call reports
+//!   unsupported.
+//! * Other platforms: unsupported.
+//!
+//! Call [`verify_user`] from a worker thread, never from a UI thread: it blocks until the prompt
+//! is answered.
+
+use crate::error::{Error, Result};
+
+/// What the user did with the prompt.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum VerifyOutcome {
+    /// The user proved who they are.
+    Verified,
+    /// The user dismissed the prompt.
+    Cancelled,
+    /// The prompt ended without verifying (too many failed tries, or the device was busy).
+    NotVerified,
+}
+
+/// Whether [`verify_user`] can work now.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum VerifyAvailability {
+    Available,
+    /// No Hello-capable device.
+    NoDevice,
+    /// The user has not set Hello up.
+    NotConfigured,
+    DisabledByPolicy,
+    /// The verifier is busy with another request.
+    Busy,
+    /// This platform or build has no verifier (see the module notes).
+    Unsupported,
+}
+
+impl VerifyAvailability {
+    pub fn is_available(self) -> bool {
+        self == VerifyAvailability::Available
+    }
+}
+
+/// Maps `UserConsentVerifierAvailability` (Available 0, DeviceNotPresent 1, NotConfiguredForUser 2,
+/// DisabledByPolicy 3, DeviceBusy 4); any other value is `Unsupported`.
+#[cfg_attr(not(all(windows, feature = "windows-hello")), allow(dead_code))]
+pub(crate) fn availability_from_code(code: i32) -> VerifyAvailability {
+    match code {
+        0 => VerifyAvailability::Available,
+        1 => VerifyAvailability::NoDevice,
+        2 => VerifyAvailability::NotConfigured,
+        3 => VerifyAvailability::DisabledByPolicy,
+        4 => VerifyAvailability::Busy,
+        _ => VerifyAvailability::Unsupported,
+    }
+}
+
+/// Maps `UserConsentVerificationResult` (Verified 0, DeviceNotPresent 1, NotConfiguredForUser 2,
+/// DisabledByPolicy 3, DeviceBusy 4, RetriesExhausted 5, Canceled 6). A result that means the
+/// verifier cannot run at all is `Error::Unavailable`, not a refusal.
+#[cfg_attr(not(all(windows, feature = "windows-hello")), allow(dead_code))]
+pub(crate) fn outcome_from_code(code: i32) -> Result<VerifyOutcome> {
+    match code {
+        0 => Ok(VerifyOutcome::Verified),
+        6 => Ok(VerifyOutcome::Cancelled),
+        4 | 5 => Ok(VerifyOutcome::NotVerified),
+        1 => Err(Error::Unavailable("no Windows Hello device".into())),
+        2 => Err(Error::Unavailable("Windows Hello is not set up for this user".into())),
+        3 => Err(Error::Unavailable("Windows Hello is disabled by policy".into())),
+        _ => Err(Error::Unavailable("unknown verification result".into())),
+    }
+}
+
+/// Whether Windows Hello can verify this user now. An OS error counts as unsupported.
+pub fn verification_availability() -> VerifyAvailability {
+    imp::availability()
+}
+
+/// Asks the OS to verify the user, with `reason` shown in the prompt.
+/// `Error::Unavailable` when this platform or build cannot (or Hello cannot run), so a caller can
+/// fall back to a PIN.
+pub fn verify_user(reason: &str) -> Result<VerifyOutcome> {
+    imp::verify(None, reason)
+}
+
+/// Like [`verify_user`], parented to the window `parent` (an `HWND` as an integer) so the prompt
+/// comes in front of it. Falls back to the unparented prompt when the parented one cannot start.
+pub fn verify_user_for_window(parent: isize, reason: &str) -> Result<VerifyOutcome> {
+    imp::verify(Some(parent), reason)
+}
+
+#[cfg(not(all(windows, feature = "windows-hello")))]
+mod imp {
+    use super::*;
+
+    pub fn availability() -> VerifyAvailability {
+        VerifyAvailability::Unsupported
+    }
+
+    pub fn verify(parent: Option<isize>, reason: &str) -> Result<VerifyOutcome> {
+        let _ = (parent, reason);
+        Err(Error::Unavailable(
+            "user verification needs Windows with the windows-hello feature (macOS: RightKitSwift UserVerification)".into(),
+        ))
+    }
+}
+
+#[cfg(all(windows, feature = "windows-hello"))]
+mod imp {
+    use super::*;
+    use std::ffi::c_void;
+    use windows::core::HSTRING;
+    use windows::Security::Credentials::UI::{UserConsentVerifier, UserConsentVerifierAvailability};
+    use windows::Win32::Foundation::HWND;
+    use windows::Win32::System::Com::{CoInitializeEx, COINIT_MULTITHREADED};
+    use windows::Win32::System::WinRT::IUserConsentVerifierInterop;
+
+    /// Sets up COM for the calling thread once (the Windows Runtime wants an apartment).
+    fn init_com() {
+        thread_local! {
+            static DONE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+        }
+        DONE.with(|done| {
+            if !done.get() {
+                // Already initialised another way is fine; the result is not needed.
+                let _ = unsafe { CoInitializeEx(None, COINIT_MULTITHREADED) };
+                done.set(true);
+            }
+        });
+    }
+
+    fn backend(op: &'static str, error: &windows::core::Error) -> Error {
+        Error::Backend { op, code: i64::from(error.code().0) }
+    }
+
+    pub fn availability() -> VerifyAvailability {
+        init_com();
+        match UserConsentVerifier::CheckAvailabilityAsync().and_then(|op| op.join()) {
+            Ok(state) => availability_from_code(state.0),
+            Err(_) => VerifyAvailability::Unsupported,
+        }
+    }
+
+    pub fn verify(parent: Option<isize>, reason: &str) -> Result<VerifyOutcome> {
+        init_com();
+        // The verifier answers `Available` or one of the other states; do not prompt when it cannot.
+        let state = UserConsentVerifier::CheckAvailabilityAsync()
+            .and_then(|op| op.join())
+            .map_err(|e| backend("CheckAvailabilityAsync", &e))?;
+        if state != UserConsentVerifierAvailability::Available {
+            return Err(Error::Unavailable(format!(
+                "Windows Hello is not available ({:?})",
+                availability_from_code(state.0)
+            )));
+        }
+        let text = HSTRING::from(reason);
+        if let Some(key) = parent {
+            let hwnd = HWND(key as *mut c_void);
+            let started = windows::core::factory::<UserConsentVerifier, IUserConsentVerifierInterop>()
+                .and_then(|interop| unsafe {
+                    interop.RequestVerificationForWindowAsync::<
+                        windows_future::IAsyncOperation<
+                            windows::Security::Credentials::UI::UserConsentVerificationResult,
+                        >,
+                    >(hwnd, &text)
+                });
+            if let Ok(result) = started.and_then(|op| op.join()) {
+                return outcome_from_code(result.0);
+            }
+            // The parented prompt could not start: fall back to the plain call.
+        }
+        let result = UserConsentVerifier::RequestVerificationAsync(&text)
+            .and_then(|op| op.join())
+            .map_err(|e| backend("RequestVerificationAsync", &e))?;
+        outcome_from_code(result.0)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn availability_codes() {
+        assert!(availability_from_code(0).is_available());
+        assert_eq!(availability_from_code(1), VerifyAvailability::NoDevice);
+        assert_eq!(availability_from_code(2), VerifyAvailability::NotConfigured);
+        assert_eq!(availability_from_code(3), VerifyAvailability::DisabledByPolicy);
+        assert_eq!(availability_from_code(4), VerifyAvailability::Busy);
+        assert_eq!(availability_from_code(99), VerifyAvailability::Unsupported);
+        assert!(!availability_from_code(2).is_available());
+    }
+
+    #[test]
+    fn result_codes_never_turn_a_refusal_into_a_pass() {
+        assert_eq!(outcome_from_code(0).unwrap(), VerifyOutcome::Verified);
+        assert_eq!(outcome_from_code(6).unwrap(), VerifyOutcome::Cancelled);
+        assert_eq!(outcome_from_code(5).unwrap(), VerifyOutcome::NotVerified);
+        assert_eq!(outcome_from_code(4).unwrap(), VerifyOutcome::NotVerified);
+        for code in [1, 2, 3, 7, -1] {
+            assert!(matches!(outcome_from_code(code), Err(Error::Unavailable(_))), "{code}");
+        }
+    }
+
+    #[cfg(not(all(windows, feature = "windows-hello")))]
+    #[test]
+    fn unsupported_builds_fail_closed() {
+        assert_eq!(verification_availability(), VerifyAvailability::Unsupported);
+        assert!(matches!(verify_user("x"), Err(Error::Unavailable(_))));
+        assert!(matches!(verify_user_for_window(0, "x"), Err(Error::Unavailable(_))));
+    }
+}

+        // Stored as hex text of `magic | flag | key`.
+        let text = item.expose_str().unwrap();
+        assert!(text.bytes().all(|b| b.is_ascii_hexdigit()));
+        assert_eq!(from_hex(text).unwrap().len(), HEADER_LEN + KEY_LEN);

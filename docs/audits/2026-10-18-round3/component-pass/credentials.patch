+    const FAST: u32 = 1_000;
+
+    #[test]
+    fn kdf_is_deterministic_and_depends_on_pin_and_salt() {
+        let a = kdf("1234", b"salt-salt-salt-1", FAST);
+        assert_eq!(*a, *kdf("1234", b"salt-salt-salt-1", FAST));
+        assert_ne!(*a, *kdf("1235", b"salt-salt-salt-1", FAST));
+        assert_ne!(*a, *kdf("1234", b"salt-salt-salt-2", FAST));
+    }
+
+    #[test]
+    fn wrap_round_trips_and_rejects_wrong_pin_or_aad() {
+        let key = [9u8; KEY_LEN];
+        let wrapped = wrap_with(&key, "4321", b"purpose", FAST).unwrap();
+        assert_eq!(wrapped.len(), PIN_SALT_LEN + 12 + KEY_LEN + 16);
+        assert_eq!(*unwrap_with(&wrapped, "4321", b"purpose", FAST).unwrap(), key);
+        assert!(unwrap_with(&wrapped, "0000", b"purpose", FAST).is_err());
+        assert!(unwrap_with(&wrapped, "4321", b"other", FAST).is_err());
+        assert!(unwrap_with(&wrapped[..10], "4321", b"purpose", FAST).is_err());
+    }

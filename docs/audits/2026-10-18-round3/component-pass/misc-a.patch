+/// What a passing package check measured.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PackageCheck {
+    /// Zip entries, directories included.
+    pub entries: usize,
+    /// Declared decompressed bytes of every entry.
+    pub declared_bytes: u64,
+}
+
+/// Public zip-entry limits check for any zip, with no OOXML knowledge: input size, entry count,
+/// unsafe or duplicate entry names, zip-level encryption, per-entry and total declared
+/// decompressed size, and the compression ratio, all against `limits` and all before a single
+/// entry is decompressed. For callers that unpack a zip themselves (remote packages, bundles).
+pub fn check_zip_limits(bytes: &[u8], limits: &Limits) -> Result<PackageCheck> {
+    let (entries, declared) = package::preflight(bytes, limits, false)?;
+    Ok(PackageCheck {
+        entries: entries.len(),
+        declared_bytes: u64::try_from(declared).unwrap_or(u64::MAX),
+    })
+}
+
+/// Full OOXML package preflight, the same one `read` and `write` run first: everything in
+/// [`check_zip_limits`], plus real bounded decompression of the XML parts, DOCTYPE and entity
+/// refusal, and refusal of embedded OLE objects, ActiveX controls and VBA projects.
+pub fn check_package(bytes: &[u8], limits: &Limits) -> Result<PackageCheck> {
+    let pkg = package::Package::open(bytes, limits)?;
+    Ok(package_check(&pkg))
+}
+
+fn package_check(pkg: &package::Package<'_>) -> PackageCheck {
+    PackageCheck {
+        entries: pkg.entries.len(),
+        declared_bytes: u64::try_from(pkg.declared_total).unwrap_or(u64::MAX),
+    }
+}
+
+/// [`check_package`] plus a refusal of external links: any relationship marked
+/// `TargetMode="External"` (hyperlinks, linked images, external workbooks, attached templates)
+/// and any workbook `externalLinks/` part fails with [`DocsError::ExternalLink`]. For hosts that
+/// must not open a document that points off the machine. `read` and `write` do not call this;
+/// they never follow external links and list them as omitted.
+pub fn refuse_external_links(bytes: &[u8], limits: &Limits) -> Result<PackageCheck> {
+    let pkg = package::Package::open(bytes, limits)?;
+    if let Some((part, target)) = pkg.first_external_link()? {
+        return Err(DocsError::ExternalLink { part, target });
+    }
+    Ok(package_check(&pkg))
+}

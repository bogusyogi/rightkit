+/// One answer from the peer, whatever carried it: an HTTP-style status and body. The statuses
+/// are the LocalSend v2 ones (200 or 204 accepted, 403 declined, 401 PIN, 409 busy, 413 too
+/// large, 429 rate limited, 422 damaged).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct TransportReply {
+    pub status: u16,
+    pub body: Vec<u8>,
+}
+
+/// The carrier of one send, so the same send policy (the `prepare-upload` request, per-file
+/// accept, partial accept, progress, cancel and the status-to-error mapping) runs over a
+/// non-TCP carrier such as a device mesh. [`deliver_with`] is the policy; the transport only
+/// moves bytes and reports a status.
+///
+/// Implementations authenticate the peer themselves. [`TcpTransport`] pins a TLS identity;
+/// another carrier must establish who the peer is before it returns any reply.
+pub trait Transport {
+    /// The peer's name in errors (an alias).
+    fn peer_label(&self) -> &str;
+
+    /// Deliver the `prepare-upload` JSON `body` and wait for the answer. This may take as long
+    /// as the other person needs to say yes. A transport that can be broken from another thread
+    /// does so by its own means; [`deliver_with`] checks its `cancel` flag when this returns.
+    fn prepare_upload(&self, body: &[u8]) -> Result<TransportReply, Error>;
+
+    /// Upload one file of an accepted session. `write_body` must be called once and writes
+    /// exactly `size` bytes; it returns an error if the send was cancelled or the source failed.
+    /// `file_name` is for the error a failed upload becomes ([`Error::FileStopped`]).
+    fn upload(
+        &self,
+        session: &str,
+        file: &str,
+        token: &str,
+        file_name: &str,
+        size: u64,
+        write_body: &mut dyn FnMut(&mut dyn Write) -> io::Result<()>,
+    ) -> Result<TransportReply, Error>;
+
+    /// Tell the peer the session is over. Best effort.
+    fn cancel(&self, session: &str);
+}
+
+/// The LocalSend carrier: one fresh TLS connection per request, pinned to
+/// [`Peer::fingerprint`]. `register` is told each connection's socket so another thread can
+/// break a wait by shutting it down.
+pub struct TcpTransport<'a> {
+    peer: &'a Peer,
+    register: &'a dyn Fn(Option<TcpStream>),
+}
+
+impl<'a> TcpTransport<'a> {
+    pub fn new(peer: &'a Peer, register: &'a dyn Fn(Option<TcpStream>)) -> Self {
+        Self { peer, register }
+    }
+}
+
+impl Transport for TcpTransport<'_> {
+    fn peer_label(&self) -> &str {
+        &self.peer.alias
+    }
+
+    fn prepare_upload(&self, body: &[u8]) -> Result<TransportReply, Error> {
+        let prepare = format!("{}/prepare-upload", proto::API);
+        let reply = exchange(
+            self.peer,
+            &prepare,
+            Some(body),
+            Duration::from_secs(190),
+            self.register,
+            &mut || {},
+        )?;
+        Ok(TransportReply {
+            status: reply.status,
+            body: reply.body,
+        })
+    }
+
+    fn upload(
+        &self,
+        session: &str,
+        file: &str,
+        token: &str,
+        file_name: &str,
+        size: u64,
+        write_body: &mut dyn FnMut(&mut dyn Write) -> io::Result<()>,
+    ) -> Result<TransportReply, Error> {
+        let peer = self.peer;
+        let target = query(session, file, token);
+        let mut wire = net::connect(
+            peer.ip,
+            peer.port,
+            peer.https,
+            &peer.fingerprint,
+            Duration::from_secs(120),
+        )
+        .map_err(|e| {
+            peer_io(&peer.alias, &e, |peer, detail| Error::PeerUnreachable {
+                peer,
+                detail,
+            })
+        })?;
+        (self.register)(wire.tcp().try_clone().ok());
+        let host = format!("{}:{}", peer.ip, peer.port);
+        let result = net::call(
+            &mut wire,
+            "POST",
+            &host,
+            &target,
+            Some("application/octet-stream"),
+            size,
+            &mut |w: &mut Wire| write_body(w),
+        );
+        wire.finish();
+        (self.register)(None);
+        let reply = result.map_err(|e| {
+            peer_io(&peer.alias, &e, |_, detail| Error::FileStopped {
+                file: file_name.to_string(),
+                detail,
+            })
+        })?;
+        Ok(TransportReply {
+            status: reply.status,
+            body: reply.body,
+        })
+    }
+
+    fn cancel(&self, session: &str) {
+        let peer = self.peer;
+        let target = format!(
+            "{}/cancel?sessionId={}",
+            proto::API,
+            proto::url_encode(session)
+        );
+        let _ = net::request_json(
+            peer.ip,
+            peer.port,
+            peer.https,
+            &peer.fingerprint,
+            "POST",
+            &target,
+            None,
+            Duration::from_secs(5),
+        );
+    }
+}

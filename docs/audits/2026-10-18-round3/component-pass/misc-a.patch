@@ -0,0 +1,900 @@
+//! The host side of lifecycle hooks (feature `host`): run user-configured command hooks for an
+//! event and combine their answers, with Claude Code semantics.
+//!
+//! The rest of this crate is the *hook* side (a process the host launches). This module is the
+//! *host*: it owns the process launch seam ([`ProcessLaunch`]), the hook configuration
+//! ([`HookSpec`], [`parse_hook_specs_json`]), the output grammar ([`parse_hook_output`]) and the
+//! chain ([`HookChain::run`]). It holds no product policy: a destructive-command guard, a
+//! registry or a management UI stay with the product.
+//!
+//! Chain rules:
+//!
+//! - Hooks run serially in declared order. A tool matcher is a regex that must match the whole
+//!   tool name (`Bash`, `Edit|Write`, `Notebook.*`); an empty matcher or `*` matches every tool,
+//!   and a matcher is not consulted for events that carry no tool name.
+//! - Every hook gets the event's JSON on stdin. A hook's `updatedInput` replaces `tool_input` in
+//!   what the *next* hook sees and is reported in [`ChainReport::updated_input`].
+//! - Verdicts combine by strength, first reason wins within a strength: deny, then block, then
+//!   ask, then allow, then no opinion. The chain stops after the first deny or block, so later
+//!   hooks do not run once the answer cannot change.
+//! - A hook that times out, cannot start, or exits with a code other than 0 or 2 **fails closed**
+//!   for a pre-effect event ([`fails_closed`]: `PreToolUse`, which becomes a deny) and **fails
+//!   open** everywhere else (recorded in its [`HookResult`], no effect on the verdict).
+//! - Exit code 2 is a blocking error whose reason is stderr: a deny on `PreToolUse`, a block on
+//!   `UserPromptSubmit`, `Stop`, `SubagentStop`, `PostToolUse` and `PostToolUseFailure`, and a
+//!   recorded non-blocking error on every other event.
+//!
+//! Known limit of [`ShellLauncher`]: a timeout kills the shell it started, not the processes that
+//! shell started in turn.
+
+use crate::event::{EventKind, HookEvent};
+use regex::Regex;
+use serde_json::Value;
+use std::io::{self, Read, Write};
+use std::process::{Command, Stdio};
+use std::sync::mpsc;
+use std::thread;
+use std::time::{Duration, Instant};
+
+/// Per-hook timeout when the configuration gives none (Claude Code's 60 s).
+pub const DEFAULT_HOOK_TIMEOUT: Duration = Duration::from_secs(60);
+/// Most bytes of stdout and of stderr kept from one hook; the rest is read and dropped.
+pub const OUTPUT_CAP: usize = 1 << 20;
+
+/// One configured command hook.
+#[derive(Clone, Debug, PartialEq)]
+pub struct HookSpec {
+    /// The shell command line to run.
+    pub command: String,
+    /// Tool-name regex (whole-name match). `None`, empty and `*` match every tool.
+    pub matcher: Option<String>,
+    /// Kill the hook after this long.
+    pub timeout: Duration,
+}
+
+impl HookSpec {
+    pub fn new(command: impl Into<String>) -> Self {
+        Self {
+            command: command.into(),
+            matcher: None,
+            timeout: DEFAULT_HOOK_TIMEOUT,
+        }
+    }
+
+    pub fn with_matcher(mut self, matcher: impl Into<String>) -> Self {
+        self.matcher = Some(matcher.into());
+        self
+    }
+
+    pub fn with_timeout(mut self, timeout: Duration) -> Self {
+        self.timeout = timeout;
+        self
+    }
+
+    /// Whether this hook applies to `tool_name`. An event without a tool name is always
+    /// matched. `Err` names an invalid matcher regex.
+    pub fn matches(&self, tool_name: Option<&str>) -> Result<bool, String> {
+        let Some(regex) = compile_matcher(self.matcher.as_deref())? else {
+            return Ok(true);
+        };
+        Ok(match tool_name {
+            Some(name) => regex.is_match(name),
+            None => true,
+        })
+    }
+}
+
+/// `None` for "match everything".
+fn compile_matcher(matcher: Option<&str>) -> Result<Option<Regex>, String> {
+    let pattern = matcher.map(str::trim).unwrap_or_default();
+    if pattern.is_empty() || pattern == "*" {
+        return Ok(None);
+    }
+    Regex::new(&format!("^(?:{pattern})$"))
+        .map(Some)
+        .map_err(|e| format!("invalid hook matcher {pattern:?}: {e}"))
+}
+
+/// The hooks configured for `event`, read from Claude Code's settings shape:
+/// `{"hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command",
+/// "command": "...", "timeout": 5}]}]}}`. The `hooks` map alone (without the wrapper) is also
+/// accepted. `timeout` is in seconds. Hooks whose `type` is not `command` are skipped; a
+/// command hook without a command, or a matcher that is not a valid regex, is an error.
+pub fn parse_hook_specs_json(json: &str, event: &EventKind) -> Result<Vec<HookSpec>, String> {
+    let root: Value = serde_json::from_str(json).map_err(|e| format!("hooks JSON: {e}"))?;
+    let hooks = root.get("hooks").unwrap_or(&root);
+    let Some(groups) = hooks.get(event.as_str()) else {
+        return Ok(Vec::new());
+    };
+    let groups = groups
+        .as_array()
+        .ok_or_else(|| format!("hooks for {event} must be an array"))?;
+    let mut specs = Vec::new();
+    for group in groups {
+        let matcher = group
+            .get("matcher")
+            .and_then(Value::as_str)
+            .map(str::to_owned);
+        compile_matcher(matcher.as_deref())?;
+        let Some(list) = group.get("hooks").and_then(Value::as_array) else {
+            continue;
+        };
+        for hook in list {
+            let kind = hook.get("type").and_then(Value::as_str).unwrap_or("command");
+            if kind != "command" {
+                continue;
+            }
+            let command = hook
+                .get("command")
+                .and_then(Value::as_str)
+                .map(str::trim)
+                .filter(|c| !c.is_empty())
+                .ok_or_else(|| format!("a command hook for {event} has no command"))?;
+            let timeout = hook
+                .get("timeout")
+                .and_then(Value::as_f64)
+                .filter(|s| s.is_finite() && *s > 0.0)
+                .map(Duration::from_secs_f64)
+                .unwrap_or(DEFAULT_HOOK_TIMEOUT);
+            specs.push(HookSpec {
+                command: command.to_owned(),
+                matcher: matcher.clone(),
+                timeout,
+            });
+        }
+    }
+    Ok(specs)
+}
+
+/// Events whose hooks fail closed: a hook that cannot answer must not let the effect happen.
+/// Only `PreToolUse` is pre-effect.
+pub fn fails_closed(event: &EventKind) -> bool {
+    matches!(event, EventKind::PreToolUse)
+}
+
+/// A `PreToolUse` permission answer.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Permission {
+    Allow,
+    Ask,
+    Deny,
+}
+
+/// What one hook said, normalized.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ParsedHook {
+    /// `PreToolUse` permission (`permissionDecision`, legacy `decision` approve/block, or exit 2).
+    pub permission: Option<Permission>,
+    /// The reason that goes with `permission`.
+    pub permission_reason: Option<String>,
+    /// `decision: "block"` (or exit 2) on an event other than `PreToolUse`, with its reason.
+    pub block: Option<String>,
+    /// `hookSpecificOutput.updatedInput`: a rewritten tool input (`PreToolUse` only).
+    pub updated_input: Option<Value>,
+    /// Context for the model (`additionalContext`, or plain stdout on `SessionStart` and
+    /// `UserPromptSubmit`).
+    pub additional_context: Option<String>,
+    /// `systemMessage`, shown to the person.
+    pub system_message: Option<String>,
+    /// `continue: false`, with its `stopReason`.
+    pub stop: Option<String>,
+    /// A non-blocking failure: a bad exit code, a timeout, a launch failure.
+    pub error: Option<String>,
+}
+
+fn non_blank(text: &str) -> Option<String> {
+    let text = text.trim();
+    (!text.is_empty()).then(|| text.to_owned())
+}
+
+fn str_field(object: &serde_json::Map<String, Value>, name: &str) -> Option<String> {
+    object
+        .get(name)
+        .and_then(Value::as_str)
+        .and_then(non_blank)
+}
+
+/// Read one hook's result: its stdout, stderr and exit code, for `event`.
+pub fn parse_hook_output(
+    stdout: &str,
+    stderr: &str,
+    exit_code: i32,
+    event: &EventKind,
+) -> ParsedHook {
+    let mut out = ParsedHook::default();
+    let pre = matches!(event, EventKind::PreToolUse);
+    if exit_code == 2 {
+        let reason = non_blank(stderr)
+            .or_else(|| non_blank(stdout))
+            .unwrap_or_else(|| "blocked by a hook (exit code 2)".to_owned());
+        match event {
+            EventKind::PreToolUse => {
+                out.permission = Some(Permission::Deny);
+                out.permission_reason = Some(reason);
+            }
+            EventKind::UserPromptSubmit
+            | EventKind::Stop
+            | EventKind::SubagentStop
+            | EventKind::PostToolUse
+            | EventKind::PostToolUseFailure => out.block = Some(reason),
+            _ => out.error = Some(format!("exit code 2: {reason}")),
+        }
+        return out;
+    }
+    if exit_code != 0 {
+        let detail = stderr.lines().next().unwrap_or_default().trim();
+        out.error = Some(if detail.is_empty() {
+            format!("hook exited with code {exit_code}")
+        } else {
+            format!("hook exited with code {exit_code}: {detail}")
+        });
+        return out;
+    }
+    let text = stdout.trim();
+    if text.is_empty() {
+        return out;
+    }
+    let parsed = if text.starts_with('{') {
+        serde_json::from_str::<Value>(text).ok()
+    } else {
+        None
+    };
+    let Some(Value::Object(object)) = parsed else {
+        if matches!(event, EventKind::SessionStart | EventKind::UserPromptSubmit) {
+            out.additional_context = Some(text.to_owned());
+        }
+        return out;
+    };
+    if object.get("continue").and_then(Value::as_bool) == Some(false) {
+        out.stop =
+            Some(str_field(&object, "stopReason").unwrap_or_else(|| "stopped by a hook".into()));
+    }
+    out.system_message = str_field(&object, "systemMessage");
+    let legacy_reason = str_field(&object, "reason");
+    match object.get("decision").and_then(Value::as_str) {
+        Some("block") if pre => {
+            out.permission = Some(Permission::Deny);
+            out.permission_reason = Some(
+                legacy_reason
+                    .clone()
+                    .unwrap_or_else(|| "blocked by a hook".into()),
+            );
+        }
+        Some("block") => {
+            out.block =
+                Some(legacy_reason.unwrap_or_else(|| "blocked by a hook".into()));
+        }
+        Some("approve") if pre => out.permission = Some(Permission::Allow),
+        _ => {}
+    }
+    if let Some(Value::Object(specific)) = object.get("hookSpecificOutput") {
+        if pre {
+            let decision = match specific.get("permissionDecision").and_then(Value::as_str) {
+                Some("allow") => Some(Permission::Allow),
+                Some("ask") => Some(Permission::Ask),
+                Some("deny") => Some(Permission::Deny),
+                _ => None,
+            };
+            if let Some(decision) = decision {
+                out.permission = Some(decision);
+                out.permission_reason = str_field(specific, "permissionDecisionReason")
+                    .or(out.permission_reason.take());
+            }
+            if let Some(input @ Value::Object(_)) = specific.get("updatedInput") {
+                out.updated_input = Some(input.clone());
+            }
+        }
+        if let Some(context) = str_field(specific, "additionalContext") {
+            out.additional_context = Some(context);
+        }
+    }
+    out
+}
+
+/// What launching one hook process produced.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum LaunchOutcome {
+    /// The process ended. `code` is `None` when it was ended by a signal.
+    Exited {
+        code: Option<i32>,
+        stdout: String,
+        stderr: String,
+    },
+    /// It ran past its timeout and was killed.
+    TimedOut,
+    /// It could not be started.
+    SpawnFailed(String),
+}
+
+/// One process to run.
+#[derive(Clone, Debug)]
+#[non_exhaustive]
+pub struct LaunchRequest<'a> {
+    /// The shell command line.
+    pub command: &'a str,
+    /// Written to the process's stdin, which is then closed.
+    pub stdin: &'a [u8],
+    /// The working directory (the event's `cwd`), when known.
+    pub cwd: Option<&'a str>,
+    pub timeout: Duration,
+}
+
+/// The process seam: tests and the daemon inject their own spawning.
+pub trait ProcessLaunch: Send + Sync {
+    fn launch(&self, request: &LaunchRequest<'_>) -> LaunchOutcome;
+}
+
+/// Runs the command line through the platform shell (`sh -c`, `cmd /C`) with piped stdio, no
+/// console window on Windows, and capped output ([`OUTPUT_CAP`]).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct ShellLauncher;
+
+fn shell_command(command: &str) -> Command {
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        let mut cmd = Command::new("cmd");
+        // `cmd /C` strips one pair of outer quotes, so quote the whole line to keep a leading
+        // quoted program path intact. `raw_arg` stops std from re-escaping the quotes.
+        cmd.arg("/C").raw_arg(format!("\"{command}\""));
+        cmd.creation_flags(0x0800_0000);
+        cmd
+    }
+    #[cfg(not(windows))]
+    {
+        let mut cmd = Command::new("sh");
+        cmd.arg("-c").arg(command);
+        cmd
+    }
+}
+
+fn read_capped(stream: Option<impl Read>) -> String {
+    let Some(mut stream) = stream else {
+        return String::new();
+    };
+    let mut kept = Vec::new();
+    let _ = (&mut stream).take(OUTPUT_CAP as u64).read_to_end(&mut kept);
+    // Keep draining so a chatty hook is not blocked on a full pipe.
+    let _ = io::copy(&mut stream, &mut io::sink());
+    String::from_utf8_lossy(&kept).into_owned()
+}
+
+impl ProcessLaunch for ShellLauncher {
+    fn launch(&self, request: &LaunchRequest<'_>) -> LaunchOutcome {
+        let mut command = shell_command(request.command);
+        command
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped());
+        if let Some(cwd) = request.cwd {
+            command.current_dir(cwd);
+        }
+        let mut child = match command.spawn() {
+            Ok(child) => child,
+            Err(e) => return LaunchOutcome::SpawnFailed(e.to_string()),
+        };
+        let stdin = child.stdin.take();
+        let payload = request.stdin.to_vec();
+        // Detached: it ends when the process reads its input or exits.
+        thread::spawn(move || {
+            if let Some(mut stdin) = stdin {
+                let _ = stdin.write_all(&payload);
+            }
+        });
+        let (out_tx, out_rx) = mpsc::channel();
+        let stdout = child.stdout.take();
+        thread::spawn(move || {
+            let _ = out_tx.send(read_capped(stdout));
+        });
+        let (err_tx, err_rx) = mpsc::channel();
+        let stderr = child.stderr.take();
+        thread::spawn(move || {
+            let _ = err_tx.send(read_capped(stderr));
+        });
+        let deadline = Instant::now() + request.timeout;
+        let status = loop {
+            match child.try_wait() {
+                Ok(Some(status)) => break status,
+                Ok(None) if Instant::now() >= deadline => {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                    return LaunchOutcome::TimedOut;
+                }
+                Ok(None) => thread::sleep(Duration::from_millis(5)),
+                Err(e) => {
+                    let _ = child.kill();
+                    return LaunchOutcome::SpawnFailed(format!("waiting for the hook failed: {e}"));
+                }
+            }
+        };
+        // A grandchild can keep the pipes open after the hook exits; do not wait for it.
+        let grace = Duration::from_millis(250);
+        LaunchOutcome::Exited {
+            code: status.code(),
+            stdout: out_rx.recv_timeout(grace).unwrap_or_default(),
+            stderr: err_rx.recv_timeout(grace).unwrap_or_default(),
+        }
+    }
+}
+
+/// What the chain decided about the effect.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Verdict {
+    /// No hook had an opinion.
+    Pass,
+    /// A hook allowed it (and none objected).
+    Allow,
+    /// Ask the person.
+    Ask(String),
+    /// Refuse a tool call.
+    Deny(String),
+    /// Block the event (`Stop`, `UserPromptSubmit`, `PostToolUse`, ...), feeding the reason back.
+    Block(String),
+}
+
+impl Verdict {
+    fn rank(&self) -> u8 {
+        match self {
+            Verdict::Pass => 0,
+            Verdict::Allow => 1,
+            Verdict::Ask(_) => 2,
+            Verdict::Block(_) => 3,
+            Verdict::Deny(_) => 4,
+        }
+    }
+
+    fn is_final(&self) -> bool {
+        matches!(self, Verdict::Deny(_) | Verdict::Block(_))
+    }
+}
+
+/// What one hook did in a chain.
+#[derive(Clone, Debug, PartialEq)]
+pub struct HookResult {
+    pub command: String,
+    /// `None` when it timed out, could not start, or was ended by a signal.
+    pub exit_code: Option<i32>,
+    pub timed_out: bool,
+    pub parsed: ParsedHook,
+    pub elapsed: Duration,
+}
+
+/// The combined answer of a chain.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChainReport {
+    pub verdict: Verdict,
+    /// The last rewritten tool input, unless the chain denied.
+    pub updated_input: Option<Value>,
+    /// Every hook's context, joined with a blank line.
+    pub additional_context: Option<String>,
+    /// Every hook's `systemMessage`, joined with a blank line.
+    pub system_message: Option<String>,
+    /// The first `continue: false` stop reason.
+    pub stop: Option<String>,
+    /// One entry per hook that ran, in order. Hooks whose matcher did not apply are absent.
+    pub results: Vec<HookResult>,
+}
+
+impl Default for ChainReport {
+    fn default() -> Self {
+        Self {
+            verdict: Verdict::Pass,
+            updated_input: None,
+            additional_context: None,
+            system_message: None,
+            stop: None,
+            results: Vec::new(),
+        }
+    }
+}
+
+/// Runs configured hooks for one event.
+pub struct HookChain;
+
+impl HookChain {
+    /// Run `specs` for `event` through `launcher` and combine the answers (see the module
+    /// documentation for the rules).
+    pub fn run(
+        event: &HookEvent,
+        specs: &[HookSpec],
+        launcher: &dyn ProcessLaunch,
+    ) -> ChainReport {
+        let closed = fails_closed(&event.kind);
+        let mut report = ChainReport::default();
+        let mut input = event.tool_input.clone();
+        let mut contexts: Vec<String> = Vec::new();
+        let mut messages: Vec<String> = Vec::new();
+        for spec in specs {
+            match spec.matches(event.tool_name.as_deref()) {
+                Ok(false) => continue,
+                Ok(true) => {}
+                Err(error) => {
+                    report.results.push(HookResult {
+                        command: spec.command.clone(),
+                        exit_code: None,
+                        timed_out: false,
+                        parsed: ParsedHook {
+                            error: Some(error.clone()),
+                            ..ParsedHook::default()
+                        },
+                        elapsed: Duration::ZERO,
+                    });
+                    if closed {
+                        raise(&mut report.verdict, Verdict::Deny(error));
+                        break;
+                    }
+                    continue;
+                }
+            }
+            let payload = hook_stdin(event, input.as_ref());
+            let started = Instant::now();
+            let outcome = launcher.launch(&LaunchRequest {
+                command: &spec.command,
+                stdin: &payload,
+                cwd: event.cwd.as_deref(),
+                timeout: spec.timeout,
+            });
+            let (parsed, exit_code, timed_out) = match outcome {
+                LaunchOutcome::Exited { code, stdout, stderr } => match code {
+                    Some(code) => (
+                        parse_hook_output(&stdout, &stderr, code, &event.kind),
+                        Some(code),
+                        false,
+                    ),
+                    None => (
+                        failure("the hook was ended by a signal".into()),
+                        None,
+                        false,
+                    ),
+                },
+                LaunchOutcome::TimedOut => (
+                    failure(format!("the hook timed out after {:?}", spec.timeout)),
+                    None,
+                    true,
+                ),
+                LaunchOutcome::SpawnFailed(error) => {
+                    (failure(format!("the hook could not start: {error}")), None, false)
+                }
+            };
+            let elapsed = started.elapsed();
+            if let Some(stop) = &parsed.stop {
+                report.stop.get_or_insert_with(|| stop.clone());
+            }
+            if let Some(update) = &parsed.updated_input {
+                input = Some(update.clone());
+                report.updated_input = Some(update.clone());
+            }
+            if let Some(context) = &parsed.additional_context {
+                contexts.push(context.clone());
+            }
+            if let Some(message) = &parsed.system_message {
+                messages.push(message.clone());
+            }
+            let candidate = match (&parsed.permission, &parsed.block, &parsed.error) {
+                (Some(Permission::Deny), _, _) => Verdict::Deny(
+                    parsed
+                        .permission_reason
+                        .clone()
+                        .unwrap_or_else(|| "denied by a hook".into()),
+                ),
+                (_, Some(reason), _) => Verdict::Block(reason.clone()),
+                (Some(Permission::Ask), _, _) => Verdict::Ask(
+                    parsed
+                        .permission_reason
+                        .clone()
+                        .unwrap_or_else(|| "a hook asks for confirmation".into()),
+                ),
+                (Some(Permission::Allow), _, _) => Verdict::Allow,
+                (None, None, Some(error)) if closed => {
+                    Verdict::Deny(format!("a pre-effect hook failed: {error}"))
+                }
+                _ => Verdict::Pass,
+            };
+            report.results.push(HookResult {
+                command: spec.command.clone(),
+                exit_code,
+                timed_out,
+                parsed,
+                elapsed,
+            });
+            raise(&mut report.verdict, candidate);
+            if report.verdict.is_final() {
+                break;
+            }
+        }
+        if matches!(report.verdict, Verdict::Deny(_)) {
+            report.updated_input = None;
+        }
+        report.additional_context = join(contexts);
+        report.system_message = join(messages);
+        report
+    }
+}
+
+fn failure(error: String) -> ParsedHook {
+    ParsedHook {
+        error: Some(error),
+        ..ParsedHook::default()
+    }
+}
+
+fn raise(current: &mut Verdict, candidate: Verdict) {
+    if candidate.rank() > current.rank() {
+        *current = candidate;
+    }
+}
+
+fn join(parts: Vec<String>) -> Option<String> {
+    (!parts.is_empty()).then(|| parts.join("\n\n"))
+}
+
+/// The JSON a hook reads on stdin: the original payload, with `tool_input` replaced by the
+/// current (possibly rewritten) input.
+fn hook_stdin(event: &HookEvent, input: Option<&Value>) -> Vec<u8> {
+    let mut payload = event.raw.clone();
+    if let (Some(input), Some(object)) = (input, payload.as_object_mut()) {
+        object.insert("tool_input".into(), input.clone());
+    }
+    serde_json::to_vec(&payload).unwrap_or_default()
+}

+    fn event(kind: &str, tool: Option<&str>) -> HookEvent {
+        let mut payload = json!({"hook_event_name": kind, "session_id": "s", "cwd": "."});
+        if let Some(tool) = tool {
+            payload["tool_name"] = json!(tool);
+            payload["tool_input"] = json!({"command": "ls"});
+        }
+        HookEvent::from_value(Wire::Claude, payload).unwrap()
+    }
+
+    fn exited(code: i32, stdout: &str, stderr: &str) -> LaunchOutcome {
+        LaunchOutcome::Exited {
+            code: Some(code),
+            stdout: stdout.into(),
+            stderr: stderr.into(),
+        }
+    }

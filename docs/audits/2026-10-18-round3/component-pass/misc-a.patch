+/// The target of the first relationship in a `.rels` part marked `TargetMode="External"`
+/// (hyperlinks, linked images, external workbooks, attached templates, remote frames).
+fn external_relationship(name: &str, data: &[u8]) -> Option<String> {
+    use quick_xml::events::Event;
+    if !name.to_ascii_lowercase().ends_with(".rels") {
+        return None;
+    }
+    let mut reader = quick_xml::Reader::from_reader(data);
+    loop {
+        match reader.read_event() {
+            Ok(Event::Start(e)) | Ok(Event::Empty(e)) => {
+                let external = crate::xmlutil::attr(&e, "TargetMode")
+                    .is_some_and(|m| m.trim().eq_ignore_ascii_case("external"));
+                if external {
+                    return Some(crate::xmlutil::attr(&e, "Target").unwrap_or_default());
+                }
+            }
+            Ok(Event::Eof) | Err(_) => return None,
+            _ => {}
+        }
+    }

@@ -0,0 +1,358 @@
+//! A bounded worker call over a [`Toolbox`]: a time limit, a cap on calls in flight, and a
+//! count of workers that outlived their limit.
+//!
+//! A tool is arbitrary code (an app command, a browser step, a desktop action) and Rust cannot
+//! stop a thread. [`BoundedToolbox`] runs each call on a worker thread and waits at most the
+//! timeout. On timeout it cancels the call's [`CancelToken`] and returns a retryable
+//! [`ERR_TIMEOUT`] at once; a tool that polls the token stops, and one that does not keeps its
+//! worker. A worker is counted as in flight until it really returns, so a stuck tool cannot be
+//! hidden by the timeout: new calls beyond `max_in_flight` get a retryable [`ERR_BUSY`], and
+//! [`BoundedToolbox::stuck_workers`] reports the leak so a host that prefers to restart (a
+//! gateway process, for example) can exit when it is non-zero.
+
+use crate::spec::*;
+use crate::toolbox::Toolbox;
+use serde_json::Value;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+use std::sync::atomic::{AtomicU8, AtomicUsize, Ordering};
+use std::sync::{mpsc, Arc};
+use std::time::{Duration, Instant};
+
+/// The call ran past its time limit and was cancelled.
+pub const ERR_TIMEOUT: &str = "tool_timeout";
+/// Too many calls (or stuck workers) are in flight; try again later.
+pub const ERR_BUSY: &str = "tool_busy";
+/// The tool panicked; nothing else about the call is known.
+pub const ERR_PANICKED: &str = "tool_panicked";
+
+/// Default cap on calls in flight, stuck workers included.
+pub const DEFAULT_MAX_IN_FLIGHT: usize = 4;
+
+/// How often a wait looks at the external cancel signal.
+const POLL: Duration = Duration::from_millis(25);
+
+#[derive(Default)]
+struct Counts {
+    in_flight: AtomicUsize,
+    stuck: AtomicUsize,
+}
+
+const RUNNING: u8 = 0;
+const ABANDONED: u8 = 1;
+const FINISHED: u8 = 2;
+
+/// Decrements in-flight on drop (also when the tool panicked).
+struct Slot(Arc<Counts>, Arc<AtomicU8>);
+
+impl Drop for Slot {
+    fn drop(&mut self) {
+        self.0.in_flight.fetch_sub(1, Ordering::SeqCst);
+        // A worker that was already given up on is no longer stuck once it returns.
+        if self.1.swap(FINISHED, Ordering::SeqCst) == ABANDONED {
+            self.0.stuck.fetch_sub(1, Ordering::SeqCst);
+        }
+    }
+}
+
+/// Runs [`Toolbox`] calls on bounded worker threads.
+pub struct BoundedToolbox {
+    toolbox: Arc<Toolbox>,
+    timeout: Duration,
+    max_in_flight: usize,
+    counts: Arc<Counts>,
+}
+
+impl BoundedToolbox {
+    /// Calls that take longer than `timeout` fail with [`ERR_TIMEOUT`].
+    pub fn new(toolbox: Arc<Toolbox>, timeout: Duration) -> Self {
+        Self {
+            toolbox,
+            timeout,
+            max_in_flight: DEFAULT_MAX_IN_FLIGHT,
+            counts: Arc::new(Counts::default()),
+        }
+    }
+
+    /// Cap on calls in flight, stuck workers included (minimum 1).
+    pub fn with_max_in_flight(mut self, max: usize) -> Self {
+        self.max_in_flight = max.max(1);
+        self
+    }
+
+    pub fn toolbox(&self) -> &Arc<Toolbox> {
+        &self.toolbox
+    }
+
+    pub fn timeout(&self) -> Duration {
+        self.timeout
+    }
+
+    /// Calls currently running on a worker, stuck ones included.
+    pub fn in_flight(&self) -> usize {
+        self.counts.in_flight.load(Ordering::SeqCst)
+    }
+
+    /// Workers whose call timed out or was cancelled but has not returned yet. Non-zero means a
+    /// tool is ignoring its [`CancelToken`].
+    pub fn stuck_workers(&self) -> usize {
+        self.counts.stuck.load(Ordering::SeqCst)
+    }
+
+    /// [`Toolbox::call`] on a worker thread, within the time limit.
+    pub fn call(&self, caller: &Caller, name: &str, args: Value) -> Result<Value, ToolError> {
+        self.call_polled(caller, name, args, &|| false)
+    }
+
+    /// Like [`BoundedToolbox::call`], and also gives up with [`ERR_CANCELLED`] as soon as
+    /// `cancelled` returns true (the caller's own cancel signal, polled every 25 ms while
+    /// waiting). The call's [`CancelToken`] is cancelled in that case too.
+    pub fn call_polled(
+        &self,
+        caller: &Caller,
+        name: &str,
+        args: Value,
+        cancelled: &dyn Fn() -> bool,
+    ) -> Result<Value, ToolError> {
+        if cancelled() {
+            return Err(ToolError::new(ERR_CANCELLED, "cancelled before start"));
+        }
+        let reserved = self
+            .counts
+            .in_flight
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |n| {
+                (n < self.max_in_flight).then_some(n + 1)
+            });
+        if reserved.is_err() {
+            return Err(ToolError::retryable(
+                ERR_BUSY,
+                format!(
+                    "{} calls are already in flight ({} stuck)",
+                    self.max_in_flight,
+                    self.stuck_workers()
+                ),
+            ));
+        }
+        let abandoned = Arc::new(AtomicU8::new(RUNNING));
+        let slot = Slot(self.counts.clone(), abandoned.clone());
+        let cancel = CancelToken::new();
+        let (tx, rx) = mpsc::channel();
+        let worker = {
+            let toolbox = self.toolbox.clone();
+            let caller = caller.clone();
+            let name = name.to_owned();
+            let cancel = cancel.clone();
+            std::thread::Builder::new()
+                .name(format!("tool-{name}"))
+                .spawn(move || {
+                    let _slot = slot;
+                    let result = catch_unwind(AssertUnwindSafe(|| {
+                        toolbox.call_cancellable(&caller, &name, args, &cancel)
+                    }))
+                    .unwrap_or_else(|_| {
+                        Err(ToolError::new(ERR_PANICKED, format!("tool `{name}` panicked")))
+                    });
+                    let _ = tx.send(result);
+                })
+        };
+        if let Err(e) = worker {
+            // The closure (and with it the slot) was dropped by the failed spawn.
+            return Err(ToolError::retryable(
+                ERR_BUSY,
+                format!("a worker thread could not start: {e}"),
+            ));
+        }
+        let deadline = Instant::now() + self.timeout;
+        loop {
+            let left = deadline.saturating_duration_since(Instant::now());
+            match rx.recv_timeout(left.min(POLL)) {
+                Ok(result) => return result,
+                Err(mpsc::RecvTimeoutError::Disconnected) => {
+                    return Err(ToolError::new(ERR_PANICKED, "the worker ended without a result"));
+                }
+                Err(mpsc::RecvTimeoutError::Timeout) => {}
+            }
+            if cancelled() {
+                if let Ok(result) = rx.try_recv() {
+                    return result;
+                }
+                return Err(self.give_up(&cancel, &abandoned, ERR_CANCELLED, "cancelled".into()));
+            }
+            if Instant::now() >= deadline {
+                if let Ok(result) = rx.try_recv() {
+                    return result;
+                }
+                return Err(self.give_up(
+                    &cancel,
+                    &abandoned,
+                    ERR_TIMEOUT,
+                    format!("`{name}` did not finish within {:?}", self.timeout),
+                ));
+            }
+        }
+    }
+
+    /// Cancel the call and stop waiting. The worker keeps its slot until it returns.
+    fn give_up(
+        &self,
+        cancel: &CancelToken,
+        abandoned: &Arc<AtomicU8>,
+        code: &str,
+        message: String,
+    ) -> ToolError {
+        cancel.cancel();
+        // Only a worker still running is stuck; one that just finished has freed its slot.
+        if abandoned
+            .compare_exchange(RUNNING, ABANDONED, Ordering::SeqCst, Ordering::SeqCst)
+            .is_ok()
+        {
+            self.counts.stuck.fetch_add(1, Ordering::SeqCst);
+        }
+        ToolError::retryable(code, message)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    use std::sync::atomic::AtomicBool;
+
+    /// `fast.echo` returns its args, `slow.spin` ignores cancel until released, `slow.polite`
+    /// stops when cancelled, `bad.panic` panics.
+    struct Probe {
+        spec: ToolSpec,
+        release: Arc<AtomicBool>,
+    }
+
+    impl Probe {
+        fn new(name: &str, release: &Arc<AtomicBool>) -> Arc<dyn Tool> {
+            Arc::new(Probe {
+                spec: ToolSpec::new(
+                    name,
+                    "probe",
+                    Effect::Observe,
+                    json!({"type": "object"}),
+                ),
+                release: release.clone(),
+            })
+        }
+    }
+
+    impl Tool for Probe {
+        fn spec(&self) -> &ToolSpec {
+            &self.spec
+        }
+
+        fn call(&self, ctx: &CallCtx, args: Value) -> Result<Value, ToolError> {
+            match self.spec.name.as_str() {
+                "fast.echo" => Ok(args),
+                "bad.panic" => panic!("boom"),
+                "slow.polite" => {
+                    while !ctx.cancel.is_cancelled() {
+                        std::thread::sleep(Duration::from_millis(5));
+                    }
+                    Err(ToolError::new(ERR_CANCELLED, "stopped"))
+                }
+                _ => {
+                    while !self.release.load(Ordering::SeqCst) {
+                        std::thread::sleep(Duration::from_millis(5));
+                    }
+                    Ok(json!({"done": true}))
+                }
+            }
+        }
+    }
+
+    fn bounded(timeout_ms: u64) -> (BoundedToolbox, Arc<AtomicBool>) {
+        let release = Arc::new(AtomicBool::new(false));
+        let mut tb = Toolbox::new();
+        for name in ["fast.echo", "slow.spin", "slow.polite", "bad.panic"] {
+            tb.register(Probe::new(name, &release)).unwrap();
+        }
+        tb.allow("t", ["*"]);
+        (
+            BoundedToolbox::new(Arc::new(tb), Duration::from_millis(timeout_ms)),
+            release,
+        )
+    }
+
+    fn wait_until(mut condition: impl FnMut() -> bool) {
+        let end = Instant::now() + Duration::from_secs(10);
+        while !condition() {
+            assert!(Instant::now() < end, "condition not reached");
+            std::thread::sleep(Duration::from_millis(5));
+        }
+    }
+
+    #[test]
+    fn a_fast_call_returns_its_result_and_frees_its_slot() {
+        let (b, _) = bounded(2_000);
+        let out = b.call(&Caller::new("t"), "fast.echo", json!({"a": 1})).unwrap();
+        assert_eq!(out, json!({"a": 1}));
+        wait_until(|| b.in_flight() == 0);
+        assert_eq!(b.stuck_workers(), 0);
+    }
+
+    #[test]
+    fn a_call_past_its_limit_times_out_and_is_counted_stuck_until_it_returns() {
+        let (b, release) = bounded(60);
+        let error = b.call(&Caller::new("t"), "slow.spin", json!({})).unwrap_err();
+        assert_eq!(error.code, ERR_TIMEOUT);
+        assert!(error.retryable);
+        assert_eq!(b.stuck_workers(), 1);
+        assert_eq!(b.in_flight(), 1);
+        release.store(true, Ordering::SeqCst);
+        wait_until(|| b.stuck_workers() == 0 && b.in_flight() == 0);
+    }
+
+    #[test]
+    fn a_polite_tool_stops_on_timeout() {
+        let (b, _) = bounded(60);
+        let error = b.call(&Caller::new("t"), "slow.polite", json!({})).unwrap_err();
+        assert_eq!(error.code, ERR_TIMEOUT);
+        wait_until(|| b.in_flight() == 0 && b.stuck_workers() == 0);
+    }
+
+    #[test]
+    fn stuck_workers_exhaust_the_cap_and_new_calls_get_busy() {
+        let (b, release) = bounded(40);
+        let b = b.with_max_in_flight(1);
+        let first = b.call(&Caller::new("t"), "slow.spin", json!({})).unwrap_err();
+        assert_eq!(first.code, ERR_TIMEOUT);
+        let second = b.call(&Caller::new("t"), "fast.echo", json!({})).unwrap_err();
+        assert_eq!(second.code, ERR_BUSY);
+        release.store(true, Ordering::SeqCst);
+        wait_until(|| b.in_flight() == 0);
+        assert!(b.call(&Caller::new("t"), "fast.echo", json!({})).is_ok());
+    }
+
+    #[test]
+    fn a_panicking_tool_is_a_typed_error_and_frees_its_slot() {
+        let (b, _) = bounded(2_000);
+        let error = b.call(&Caller::new("t"), "bad.panic", json!({})).unwrap_err();
+        assert_eq!(error.code, ERR_PANICKED);
+        wait_until(|| b.in_flight() == 0);
+    }
+
+    #[test]
+    fn an_external_cancel_signal_ends_the_wait() {
+        let (b, _) = bounded(5_000);
+        let flag = AtomicBool::new(false);
+        let started = Instant::now();
+        let error = std::thread::scope(|scope| {
+            scope.spawn(|| {
+                std::thread::sleep(Duration::from_millis(60));
+                flag.store(true, Ordering::SeqCst);
+            });
+            b.call_polled(&Caller::new("t"), "slow.polite", json!({}), &|| {
+                flag.load(Ordering::SeqCst)
+            })
+            .unwrap_err()
+        });
+        assert_eq!(error.code, ERR_CANCELLED);
+        assert!(started.elapsed() < Duration::from_secs(4));
+        wait_until(|| b.in_flight() == 0);
+        let cancelled_first = b.call_polled(&Caller::new("t"), "fast.echo", json!({}), &|| true);
+        assert_eq!(cancelled_first.unwrap_err().code, ERR_CANCELLED);
+    }
+}

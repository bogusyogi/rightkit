+#[cfg(test)]
+mod deadline_tests {
+    use super::*;
+    use std::io::Cursor;
+    use std::sync::mpsc::{channel, Receiver};
+
+    /// A reader fed from a channel: it blocks until a chunk arrives, EOF when the sender drops.
+    struct Fed(Receiver<Vec<u8>>);
+
+    impl Read for Fed {
+        fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+            match self.0.recv() {
+                Ok(chunk) => {
+                    buf[..chunk.len()].copy_from_slice(&chunk);
+                    Ok(chunk.len())
+                }
+                Err(_) => Ok(0),
+            }
+        }

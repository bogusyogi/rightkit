new file mode 100644
index 0000000..251409d
--- /dev/null
+++ b/crates/rightkit-agent-tools/src/mcp.rs
@@ -0,0 +1,211 @@
+//! A [`Toolbox`] served as a `rightkit-mcp` [`ToolProvider`] (feature `mcp`).
+//!
+//! The adapter is one caller's view of the toolbox: `tools/list` shows exactly what
+//! [`Toolbox::list_for`] shows that caller, and every `tools/call` goes through the toolbox's
+//! one gate (hard exposure rules, allowlist, argument schema, admission hook, journal), so MCP
+//! adds no way around it. Optionally calls run on bounded workers ([`BoundedToolbox`]) with a
+//! time limit and an in-flight cap, and a client's `notifications/cancelled` ends the wait.
+//!
+//! Mapping:
+//!
+//! - [`ToolSpec`] to `ToolDescriptor`: name, description and `input_schema` as is;
+//!   `readOnlyHint` is true for [`Effect::Observe`] and false for every other effect.
+//! - A successful call to `ToolResult::json` (an object is `structuredContent`; any other JSON
+//!   value is wrapped as `{"result": value}`, because `structuredContent` must be an object).
+//! - [`ERR_UNKNOWN_TOOL`] to `McpError::ToolNotFound` (JSON-RPC invalid params); every other
+//!   [`ToolError`] to a tool-level failure (`isError: true`) whose text and structured content
+//!   are the error's `{code, message, retryable}`.
+
+use crate::bounded::BoundedToolbox;
+use crate::spec::*;
+use crate::toolbox::Toolbox;
+use rightkit_mcp::{CallHandle, McpError, ToolDescriptor, ToolProvider, ToolResult};
+use serde_json::{json, Value};
+use std::sync::Arc;
+use std::time::Duration;
+
+/// One caller's MCP tool surface over a [`Toolbox`].
+pub struct ToolboxProvider {
+    toolbox: Arc<Toolbox>,
+    caller: Caller,
+    bounded: Option<BoundedToolbox>,
+}
+
+impl ToolboxProvider {
+    /// Serve `toolbox` to `caller` (the allowlist key). Calls run on the request thread.
+    pub fn new(toolbox: Arc<Toolbox>, caller: Caller) -> Self {
+        Self {
+            toolbox,
+            caller,
+            bounded: None,
+        }
+    }
+
+    /// Run each call on a bounded worker: fail with [`crate::ERR_TIMEOUT`] after `timeout`,
+    /// at most `max_in_flight` workers at once (stuck ones included).
+    pub fn bounded(mut self, timeout: Duration, max_in_flight: usize) -> Self {
+        self.bounded = Some(
+            BoundedToolbox::new(self.toolbox.clone(), timeout).with_max_in_flight(max_in_flight),
+        );
+        self
+    }
+
+    /// The bounded runner, when [`ToolboxProvider::bounded`] was used (for
+    /// [`BoundedToolbox::stuck_workers`]).
+    pub fn bounded_toolbox(&self) -> Option<&BoundedToolbox> {
+        self.bounded.as_ref()
+    }
+
+    fn run(&self, name: &str, args: Value, cancelled: &dyn Fn() -> bool) -> Result<ToolResult, McpError> {
+        let outcome = match &self.bounded {
+            Some(bounded) => bounded.call_polled(&self.caller, name, args, cancelled),
+            None if cancelled() => Err(ToolError::new(ERR_CANCELLED, "cancelled before start")),
+            None => self.toolbox.call(&self.caller, name, args),
+        };
+        match outcome {
+            Ok(value) => Ok(success(value)),
+            Err(error) if error.code == ERR_UNKNOWN_TOOL => {
+                Err(McpError::ToolNotFound(name.to_owned()))
+            }
+            Err(error) => Ok(failure(&error)),
+        }
+    }
+}
+
+/// The MCP descriptor for one tool spec.
+pub fn descriptor(spec: &ToolSpec) -> ToolDescriptor {
+    ToolDescriptor::new(&spec.name, &spec.description, spec.input_schema.clone())
+        .read_only(spec.effect == Effect::Observe)
+}
+
+fn success(value: Value) -> ToolResult {
+    match value {
+        Value::Object(_) => ToolResult::json(value),
+        other => ToolResult::json(json!({ "result": other })),
+    }
+}
+
+fn failure(error: &ToolError) -> ToolResult {
+    let mut result = ToolResult::error(error.to_value().to_string());
+    result.structured = Some(error.to_value());
+    result
+}
+
+impl ToolProvider for ToolboxProvider {
+    fn list(&self) -> Vec<ToolDescriptor> {
+        self.toolbox
+            .list_for(&self.caller.app)
+            .iter()
+            .map(descriptor)
+            .collect()
+    }
+
+    fn call(&self, name: &str, args: Value) -> Result<ToolResult, McpError> {
+        self.run(name, args, &|| false)
+    }
+
+    fn call_with_handle(
+        &self,
+        name: &str,
+        args: Value,
+        call: &CallHandle,
+    ) -> Result<ToolResult, McpError> {
+        self.run(name, args, &|| call.is_cancelled())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    struct Echo(ToolSpec);
+
+    impl Tool for Echo {
+        fn spec(&self) -> &ToolSpec {
+            &self.0
+        }
+
+        fn call(&self, _ctx: &CallCtx, args: Value) -> Result<Value, ToolError> {
+            match args.get("mode").and_then(Value::as_str) {
+                Some("fail") => Err(ToolError::retryable("nope", "it failed")),
+                Some("list") => Ok(json!([1, 2])),
+                _ => Ok(args),
+            }
+        }
+    }
+
+    fn provider(bounded: bool) -> ToolboxProvider {
+        let mut tb = Toolbox::new();
+        tb.register(Arc::new(Echo(ToolSpec::new(
+            "t.observe",
+            "reads",
+            Effect::Observe,
+            json!({"type": "object", "properties": {"mode": {"type": "string"}}}),
+        ))))
+        .unwrap();
+        tb.register(Arc::new(Echo(ToolSpec::new(
+            "t.act",
+            "acts",
+            Effect::Act,
+            json!({"type": "object"}),
+        ))))
+        .unwrap();
+        tb.register(Arc::new(Echo(ToolSpec::new(
+            "other.hidden",
+            "not allowed",
+            Effect::Observe,
+            json!({"type": "object"}),
+        ))))
+        .unwrap();
+        tb.allow("mcp", ["t.*"]);
+        let provider = ToolboxProvider::new(Arc::new(tb), Caller::new("mcp"));
+        if bounded {
+            provider.bounded(Duration::from_secs(5), 2)
+        } else {
+            provider
+        }
+    }
+
+    #[test]
+    fn list_shows_only_what_the_caller_may_call_with_read_only_hints() {
+        let listed = provider(false).list();
+        let names: Vec<&str> = listed.iter().map(|d| d.name.as_str()).collect();
+        assert_eq!(names, vec!["t.act", "t.observe"]);
+        let hint = |n: &str| listed.iter().find(|d| d.name == n).unwrap().annotations.read_only;
+        assert_eq!(hint("t.observe"), Some(true));
+        assert_eq!(hint("t.act"), Some(false));
+    }
+
+    #[test]
+    fn calls_map_results_and_errors_with_and_without_the_bounded_runner() {
+        for bounded in [false, true] {
+            let p = provider(bounded);
+            let ok = p.call("t.observe", json!({"x": 1})).unwrap();
+            assert!(!ok.is_error);
+            assert_eq!(ok.structured, Some(json!({"x": 1})));
+            let wrapped = p.call("t.observe", json!({"mode": "list"})).unwrap();
+            assert_eq!(wrapped.structured, Some(json!({"result": [1, 2]})));
+            let failed = p.call("t.observe", json!({"mode": "fail"})).unwrap();
+            assert!(failed.is_error);
+            assert_eq!(failed.structured.unwrap()["code"], "nope");
+            // Not on this caller's allowlist: a tool-level failure, with the gate's code.
+            let denied = p.call("other.hidden", json!({})).unwrap();
+            assert!(denied.is_error);
+            assert_eq!(denied.structured.unwrap()["code"], ERR_NOT_ALLOWED);
+            // Bad arguments are caught by the toolbox's schema check.
+            let invalid = p.call("t.observe", json!({"mode": 3})).unwrap();
+            assert_eq!(invalid.structured.unwrap()["code"], ERR_INVALID_ARGS);
+            assert!(matches!(
+                p.call("no.such", json!({})),
+                Err(McpError::ToolNotFound(name)) if name == "no.such"
+            ));
+        }
+    }
+
+    #[test]
+    fn bounded_provider_exposes_the_runner() {
+        assert!(provider(false).bounded_toolbox().is_none());
+        let p = provider(true);
+        assert_eq!(p.bounded_toolbox().unwrap().stuck_workers(), 0);
+    }
+}

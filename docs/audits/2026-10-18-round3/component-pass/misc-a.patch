+    impl ProcessLaunch for Script {
+        fn launch(&self, request: &LaunchRequest<'_>) -> LaunchOutcome {
+            self.seen.lock().unwrap().push((
+                request.command.to_owned(),
+                serde_json::from_slice(request.stdin).unwrap(),
+            ));
+            self.outcomes
+                .lock()
+                .unwrap()
+                .pop()
+                .unwrap_or(LaunchOutcome::SpawnFailed("script exhausted".into()))
+        }
+    }

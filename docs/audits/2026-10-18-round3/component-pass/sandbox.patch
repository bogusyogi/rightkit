+/// Directories whose metadata a `scope_metadata` profile allows: every ancestor (and each
+/// symlink spelling) of every read, write and exec root and of the system locations, excluding
+/// `/`, which has its own rule. Sorted and deduplicated.
+fn metadata_walk(policy: &SandboxPolicy) -> Vec<PathBuf> {
+    let mut roots: Vec<PathBuf> = Vec::new();
+    for p in policy
+        .read_paths
+        .iter()
+        .chain(&policy.write_paths)
+        .chain(&policy.exec_paths)
+    {
+        roots.push(p.clone());
+        roots.push(resolve_for_profile(p));
+    }
+    for dir in SYSTEM_READ.iter().chain(SYSTEM_EXEC) {
+        if policy.minimal_system_reads && OPTIONAL_SYSTEM_READ.contains(dir) {
+            continue;
+        }
+        roots.push(PathBuf::from(dir));
+        roots.push(resolve_for_profile(Path::new(dir)));
+    }
+    let mut out: std::collections::BTreeSet<PathBuf> = std::collections::BTreeSet::new();
+    for root in roots {
+        let mut cursor: Option<&Path> = root.parent();
+        while let Some(dir) = cursor {
+            if dir.parent().is_some() {
+                out.insert(dir.to_path_buf());
+            }
+            cursor = dir.parent();
+        }
+        // The spelled path itself too: lstat of a symlink root (`/tmp`, `/etc`) is metadata.
+        if root.parent().is_some() {
+            out.insert(root);
+        }
+    }
+    out.into_iter().collect()

+/// Linux: which system locations the Landlock ruleset always grants read and execute on.
+///
+/// The default grants `/usr /bin /sbin /lib /lib64 /etc /proc /dev /sys`, which lets any
+/// interpreter start but also lets the child read `/proc/<pid>/environ` of every same-user
+/// process and everything under `/etc` and `/sys`. A caller that names its own roots can narrow
+/// that. Linux only: macOS and Windows ignore it (their system reads are fixed; see
+/// [`SandboxPolicy::minimal_system_reads()`] for the macOS counterpart).
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub enum SystemRoots {
+    /// The implicit roots listed above.
+    #[default]
+    Default,
+    /// Only these absolute roots, each read and execute. The program, its interpreter and its
+    /// shared libraries must be reachable through them or through `read_paths`/`exec_paths`.
+    Minimal(Vec<PathBuf>),
+    /// No implicit root at all. Everything the child needs comes from the policy's own paths.
+    None,
+}
+
+/// The roots [`SystemRoots::Default`] grants on Linux.
+#[cfg_attr(not(target_os = "linux"), allow(dead_code))]
+pub(crate) const DEFAULT_LINUX_SYSTEM_ROOTS: &[&str] = &[
+    "/usr", "/bin", "/sbin", "/lib", "/lib64", "/etc", "/proc", "/dev", "/sys",
+];
+
+impl SystemRoots {
+    /// The roots to grant read and execute on.
+    #[cfg_attr(not(target_os = "linux"), allow(dead_code))]
+    pub(crate) fn roots(&self) -> Vec<PathBuf> {
+        match self {
+            Self::Default => DEFAULT_LINUX_SYSTEM_ROOTS
+                .iter()
+                .map(PathBuf::from)
+                .collect(),
+            Self::Minimal(roots) => roots.clone(),
+            Self::None => Vec::new(),
+        }
+    }
+}

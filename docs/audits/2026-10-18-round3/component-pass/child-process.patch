@@ -0,0 +1,168 @@
+//! Asks a macOS application to quit the way the Dock's "Quit" does: a `kAEQuitApplication`
+//! Apple event addressed to the process by pid. The application runs its own quit path (save
+//! prompts, termination handlers), which `SIGTERM` skips for most GUI applications.
+//!
+//! The event is sent with `kAENoReply | kAENeverInteract`: delivery is reported, whether the
+//! application then quits is not (it may ask the user, or refuse). macOS can require the
+//! caller to hold the Automation permission for the target (`errAEEventNotPermitted`, mapped to
+//! `PermissionDenied`).
+
+use std::{ffi::c_void, io, ptr};
+
+/// `AEDesc` / `AppleEvent`: a four-character type code and an opaque data handle.
+#[repr(C)]
+struct AeDesc {
+    descriptor_type: u32,
+    data_handle: *mut c_void,
+}
+
+/// `typeNull`.
+const TYPE_NULL: u32 = u32::from_be_bytes(*b"null");
+/// `typeKernelProcessID`: the target is a Unix pid (`pid_t`).
+const TYPE_KERNEL_PROCESS_ID: u32 = u32::from_be_bytes(*b"kpid");
+/// `kCoreEventClass`.
+const CORE_EVENT_CLASS: u32 = u32::from_be_bytes(*b"aevt");
+/// `kAEQuitApplication`.
+const QUIT_APPLICATION: u32 = u32::from_be_bytes(*b"quit");
+/// `kAutoGenerateReturnID`.
+const AUTO_GENERATE_RETURN_ID: i16 = -1;
+/// `kAnyTransactionID`.
+const ANY_TRANSACTION_ID: i32 = 0;
+/// `kAENoReply | kAENeverInteract`.
+const SEND_MODE: i32 = 0x01 | 0x10;
+/// `kAEDefaultTimeout`.
+const DEFAULT_TIMEOUT: isize = -1;
+
+/// `procNotFound`: no process with that pid.
+const PROC_NOT_FOUND: i32 = -600;
+/// `errAEEventNotPermitted`: the user denied Automation access (or has not been asked yet).
+const EVENT_NOT_PERMITTED: i32 = -1743;
+
+#[link(name = "CoreServices", kind = "framework")]
+extern "C" {
+    fn AECreateDesc(
+        type_code: u32,
+        data_ptr: *const c_void,
+        data_size: isize,
+        result: *mut AeDesc,
+    ) -> i32;
+    fn AECreateAppleEvent(
+        event_class: u32,
+        event_id: u32,
+        target: *const AeDesc,
+        return_id: i16,
+        transaction_id: i32,
+        result: *mut AeDesc,
+    ) -> i32;
+    fn AESendMessage(
+        event: *const AeDesc,
+        reply: *mut AeDesc,
+        send_mode: i32,
+        timeout_in_ticks: isize,
+    ) -> i32;
+    fn AEDisposeDesc(desc: *mut AeDesc) -> i32;
+}
+
+/// An `AEDesc` released on drop.
+struct Owned(AeDesc);
+
+impl Owned {
+    fn null() -> Self {
+        Self(AeDesc {
+            descriptor_type: TYPE_NULL,
+            data_handle: ptr::null_mut(),
+        })
+    }
+}
+
+impl Drop for Owned {
+    fn drop(&mut self) {
+        // SAFETY: the descriptor was initialised by this module (null or created by the AE
+        // functions); disposing a null descriptor is a no-op.
+        unsafe { AEDisposeDesc(&mut self.0) };
+    }
+}
+
+/// `OSErr` results can arrive sign-extended or not depending on the declaration the SDK uses;
+/// every code this module handles fits in 16 bits, so normalise through `i16`.
+fn status(code: i32) -> i32 {
+    i32::from(code as i16)
+}
+
+fn failure(what: &str, code: i32) -> io::Error {
+    let kind = match code {
+        PROC_NOT_FOUND => io::ErrorKind::NotFound,
+        EVENT_NOT_PERMITTED => io::ErrorKind::PermissionDenied,
+        _ => io::ErrorKind::Other,
+    };
+    io::Error::new(kind, format!("{what} failed with OSStatus {code}"))
+}
+
+/// Sends `kAEQuitApplication` to the process `pid`. `NotFound` when no such process exists,
+/// `PermissionDenied` when Automation access is refused.
+pub(super) fn send_quit(pid: i32) -> io::Result<()> {
+    let mut target = Owned::null();
+    // SAFETY: `pid` outlives the call, which copies the 4 bytes; `target.0` is a valid out
+    // pointer.
+    let code = status(unsafe {
+        AECreateDesc(
+            TYPE_KERNEL_PROCESS_ID,
+            (&pid as *const i32).cast(),
+            std::mem::size_of::<i32>() as isize,
+            &mut target.0,
+        )
+    });
+    if code != 0 {
+        return Err(failure("AECreateDesc", code));
+    }
+    let mut event = Owned::null();
+    // SAFETY: `target` holds the descriptor created above; `event.0` is a valid out pointer.
+    let code = status(unsafe {
+        AECreateAppleEvent(
+            CORE_EVENT_CLASS,
+            QUIT_APPLICATION,
+            &target.0,
+            AUTO_GENERATE_RETURN_ID,
+            ANY_TRANSACTION_ID,
+            &mut event.0,
+        )
+    });
+    if code != 0 {
+        return Err(failure("AECreateAppleEvent", code));
+    }
+    let mut reply = Owned::null();
+    // SAFETY: `event` is a complete Apple event, `reply` a valid null descriptor to fill.
+    let code = status(unsafe {
+        AESendMessage(&event.0, &mut reply.0, SEND_MODE, DEFAULT_TIMEOUT)
+    });
+    if code != 0 {
+        return Err(failure("AESendMessage", code));
+    }
+    Ok(())
+}
+
+#[cfg(test)]

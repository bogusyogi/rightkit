+/// caller's own when it must not block. The first sample is taken at once. An error on the
+/// first sample (`NotFound`, `PermissionDenied`) is returned; a later `NotFound` ends the soak
+/// normally as [`SoakEnd::ProcessExited`]. A zero interval is `InvalidInput`.
+pub fn soak_sample<W: Write>(

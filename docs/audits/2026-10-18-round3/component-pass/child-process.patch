index 0000000..0d47a8d
--- /dev/null
+++ b/crates/rightkit-child-process/src/tree_usage.rs
@@ -0,0 +1,197 @@
+//! Resident memory of a process and everything it started: the figure a benchmark or a budget
+//! needs when the work happens in helpers and children (a PDF renderer, a sidecar, a browser's
+//! process family), which [`process_usage`](crate::process_usage) (one process) does not cover.
+//!
+//! It walks the parent links of [`process_table`](crate::process_table) from the root and sums
+//! the working sets. Nothing is kept between calls and no thread is started.
+//!
+//! Limits: the table is a racy snapshot (a process can exit, or a pid be reused, while it is
+//! read); a descendant whose working set cannot be read is counted in
+//! [`unreadable_count`](ProcessTreeUsage::unreadable_count) and adds nothing; a process whose
+//! parent exited is re-parented away and is no longer part of the tree; memory shared between
+//! processes is counted once per process, as the OS reports it.
+
+use crate::process_table::{process_table, ProcessEntry};
+use std::collections::{HashMap, HashSet};
+use std::io;
+
+/// Resident memory of a process tree. See the module documentation for what it means.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[non_exhaustive]
+pub struct ProcessTreeUsage {
+    /// The process the walk started from.
+    pub root_pid: u32,
+    /// Working set of the root alone, in bytes (0 when it could not be read).
+    pub root_rss_bytes: u64,
+    /// Working set of the root and every descendant, in bytes.
+    pub tree_rss_bytes: u64,
+    /// Processes in the tree, the root included.
+    pub process_count: usize,
+    /// Processes in the tree whose working set could not be read (they add 0 to the sums).
+    pub unreadable_count: usize,
+}
+
+/// Resident memory of the current process and all its descendants, from one process-table
+/// snapshot. Errors as [`process_table`] does (`Unsupported` on other hosts).
+pub fn process_tree_usage() -> io::Result<ProcessTreeUsage> {
+    process_tree_usage_of(std::process::id())
+}
+
+/// Like [`process_tree_usage`] for the tree rooted at `pid`. `ErrorKind::NotFound` when no such
+/// process is in the snapshot.
+pub fn process_tree_usage_of(pid: u32) -> io::Result<ProcessTreeUsage> {
+    let rows = process_table()?;
+    sum_process_tree(&rows, pid).ok_or_else(|| io::Error::from(io::ErrorKind::NotFound))
+}
+
+/// The sum for the tree rooted at `root` over `rows`, for callers that already hold a table.
+/// `None` when `root` is not in `rows`. Safe against a table that loops (a recycled parent pid)
+/// or lists a pid twice (the first row wins).
+pub fn sum_process_tree(rows: &[ProcessEntry], root: u32) -> Option<ProcessTreeUsage> {
+    let mut by_pid: HashMap<u32, &ProcessEntry> = HashMap::with_capacity(rows.len());
+    for row in rows {
+        by_pid.entry(row.pid).or_insert(row);
+    }
+    let root_row = by_pid.get(&root)?;
+    let mut children: HashMap<u32, Vec<u32>> = HashMap::new();
+    for (&pid, row) in &by_pid {
+        if pid != row.parent_pid {
+            children.entry(row.parent_pid).or_default().push(pid);
+        }
+    }
+    let mut seen: HashSet<u32> = HashSet::from([root]);
+    let mut queue = vec![root];
+    let mut usage = ProcessTreeUsage {
+        root_pid: root,
+        root_rss_bytes: root_row.working_set_bytes.unwrap_or(0),
+        tree_rss_bytes: 0,
+        process_count: 0,
+        unreadable_count: 0,
+    };
+    while let Some(pid) = queue.pop() {
+        let row = by_pid[&pid];
+        usage.process_count += 1;
+        match row.working_set_bytes {
+            Some(bytes) => usage.tree_rss_bytes = usage.tree_rss_bytes.saturating_add(bytes),
+            None => usage.unreadable_count += 1,
+        }
+        for &child in children.get(&pid).into_iter().flatten() {
+            if seen.insert(child) {
+                queue.push(child);
+            }
+        }
+    }
+    Some(usage)
+}
+

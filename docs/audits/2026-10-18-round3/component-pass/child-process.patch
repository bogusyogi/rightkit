+    use super::*;
+
+    #[test]
+    fn four_character_codes_are_big_endian_ascii() {
+        assert_eq!(CORE_EVENT_CLASS, 0x6165_7674);
+        assert_eq!(QUIT_APPLICATION, 0x7175_6974);
+        assert_eq!(TYPE_KERNEL_PROCESS_ID, 0x6B70_6964);
+    }
+
+    #[test]
+    fn known_status_codes_map_to_error_kinds() {
+        assert_eq!(
+            failure("x", PROC_NOT_FOUND).kind(),
+            io::ErrorKind::NotFound
+        );
+        assert_eq!(
+            failure("x", EVENT_NOT_PERMITTED).kind(),
+            io::ErrorKind::PermissionDenied
+        );
+        assert_eq!(failure("x", -1).kind(), io::ErrorKind::Other);
+        assert_eq!(status(0xFFFF_F9F1u32 as i32), -1551);
+    }
+}

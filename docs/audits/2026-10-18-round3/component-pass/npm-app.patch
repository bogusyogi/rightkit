@@ -0,0 +1,40 @@
+/** Native owner callbacks a renderer reports boot progress to (for example Tauri `invoke('boot_stage')` / `invoke('boot_ok')`). */
+export interface BootReportBridge {
+  stage(name: string): Promise<void> | void;
+  ok(): Promise<void> | void;
+}
+
+export interface BootReporter {
+  /** Report a named boot stage (for example `ui-mounted`). Failures are swallowed so reporting never breaks the UI. */
+  stage(name: string): Promise<void>;
+  /** Report that the new version is healthy. Sends once; later calls are no-ops. Returns false when the bridge failed. */
+  ok(): Promise<boolean>;
+}
+
+/**
+ * Small renderer-side reporter over an invoke-based native boot owner. It carries no backup or restore step
+ * (decision D1): the native side only detects a failed boot after an update; the host then tells the user which
+ * release to install again.
+ */
+export function createBootReporter(bridge: BootReportBridge): BootReporter {
+  let sent = false;
+  return {
+    async stage(name) {
+      try {
+        await bridge.stage(name);
+      } catch {
+        // Reporting is best effort.
+      }
+    },
+    async ok() {
+      if (sent) return true;
+      try {
+        await bridge.ok();
+        sent = true;
+        return true;
+      } catch {
+        return false;
+      }
+    },
+  };
+}

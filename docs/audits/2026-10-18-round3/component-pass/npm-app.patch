+import type {
+  CheckForUpdate,
+  RuntimeUpdate,
+  UpdateDownloadEvent,
+  UpdateHeaders,
+} from './index.js';
+
+/** Native command that asks the manifest endpoints (native `rightkit_app_update_*` commands). */
+export const RIGHTKIT_APP_UPDATE_CHECK_COMMAND = 'rightkit_app_update_check';
+/** Native command that downloads, verifies the minisign signature, and installs. */
+export const RIGHTKIT_APP_UPDATE_INSTALL_COMMAND = 'rightkit_app_update_install';
+
+export type RuntimeInvoke = <T>(command: string, args?: Record<string, unknown>) => Promise<T>;
+
+/** The shape of a Tauri `Channel` instance that this package uses. */
+export interface RuntimeChannel<T> {
+  onmessage: (message: T) => void;
+}
+
+/** Tauri's `Channel` class from `@tauri-apps/api/core`. */
+export type RuntimeChannelConstructor = new <T>() => RuntimeChannel<T>;
+
+export interface RuntimeUpdateHost {
+  /** The app's real `invoke` (`@tauri-apps/api/core`). */
+  invoke: RuntimeInvoke;
+  /** The app's real `Channel` class (`@tauri-apps/api/core`). */
+  Channel: RuntimeChannelConstructor;
+  /** Override the native command names; both default to the `rightkit-app-update` ones. */
+  commands?: { check: string; install: string };
+}
+
+interface NativeUpdateMetadata {
+  id: number;
+  currentVersion: string;
+  version: string;
+  date?: string | null;
+  body?: string | null;
+  rawJson: Record<string, unknown>;
+}
+
+function cleanHeaders(headers: UpdateHeaders | undefined): UpdateHeaders | undefined {
+  if (headers === undefined) return undefined;
+  const clean: UpdateHeaders = {};
+  for (const [name, value] of Object.entries(headers)) {
+    if (typeof value !== 'string') throw new TypeError(`update header ${name} must be a string`);
+    clean[name] = value;
+  }
+  return clean;
+}
+
+/** Tauri rejects with the native error string; surface it as an Error. */
+function asError(error: unknown): Error {
+  return error instanceof Error ? error : new Error(String(error));
+}
+
+/**
+ * A `CheckForUpdate` backed by a native updater owner that exposes these commands (the `rightkit-app-update` crate, not yet shipped, #448): it replaces
+ * `check` from `@tauri-apps/plugin-updater` without the plugin. The manifest check carries
+ * `options.headers`; the returned update's `downloadAndInstall` streams the native download
+ * events, and its `options.headers` are the only headers the artifact download gets.
+ */
+export function createRuntimeCheck(host: RuntimeUpdateHost): CheckForUpdate {
+  const checkCommand = host.commands?.check ?? RIGHTKIT_APP_UPDATE_CHECK_COMMAND;
+  const installCommand = host.commands?.install ?? RIGHTKIT_APP_UPDATE_INSTALL_COMMAND;
+  return async (options) => {
+    let metadata: NativeUpdateMetadata | null;
+    try {
+      metadata = await host.invoke<NativeUpdateMetadata | null>(checkCommand, {
+        headers: cleanHeaders(options?.headers),
+      });
+    } catch (error) {
+      throw asError(error);
+    }
+    if (!metadata) return null;
+    const update: RuntimeUpdate = {
+      version: metadata.version,
+      currentVersion: metadata.currentVersion,
+      date: metadata.date ?? undefined,
+      body: metadata.body ?? undefined,
+      rawJson: metadata.rawJson,
+      async downloadAndInstall(onEvent, installOptions) {
+        const channel = new host.Channel<UpdateDownloadEvent>();
+        channel.onmessage = (event) => {
+          try {
+            onEvent?.(event);
+          } catch {
+            // A throwing progress listener must not abort the install.
+          }
+        };
+        try {
+          await host.invoke<void>(installCommand, {
+            id: metadata.id,
+            headers: cleanHeaders(installOptions?.headers),
+            onEvent: channel,
+          });
+        } catch (error) {
+          throw asError(error);
+        }
+      },
+    };
+    return update;
+  };
+}
+
+type GlobalTauri = {
+  __TAURI__?: { core?: { invoke?: RuntimeInvoke; Channel?: RuntimeChannelConstructor } };
+};
+
+/**
+ * `check` for apps that enable the global Tauri object (`app.withGlobalTauri`). It resolves
+ * `window.__TAURI__.core` on each call. Apps that import `@tauri-apps/api` use
+ * `createRuntimeCheck({ invoke, Channel })` instead.
+ */
+export const check: CheckForUpdate = (options) => {
+  const core = (globalThis as GlobalTauri).__TAURI__?.core;
+  if (!core?.invoke || !core.Channel) {
+    return Promise.reject(
+      new Error(
+        '@rightkit/app-update check() needs window.__TAURI__ (app.withGlobalTauri) or createRuntimeCheck({ invoke, Channel })',
+      ),
+    );
+  }
+  return createRuntimeCheck({ invoke: core.invoke, Channel: core.Channel })(options);
+};

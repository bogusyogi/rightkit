+import { describe, expect, it, vi } from 'vitest';
+import { createBootReporter } from './index.js';
+
+describe('createBootReporter', () => {
+  it('forwards stages and swallows bridge failures', async () => {
+    const stage = vi.fn(() => { throw new Error('gone'); });
+    const reporter = createBootReporter({ stage, ok: vi.fn() });
+    await expect(reporter.stage('ui')).resolves.toBeUndefined();
+    expect(stage).toHaveBeenCalledWith('ui');
+  });
+
+  it('sends ok once, and retries after a failure', async () => {
+    const ok = vi.fn().mockRejectedValueOnce(new Error('x')).mockResolvedValue(undefined);
+    const reporter = createBootReporter({ stage: vi.fn(), ok });
+    expect(await reporter.ok()).toBe(false);
+    expect(await reporter.ok()).toBe(true);
+    expect(await reporter.ok()).toBe(true);
+    expect(ok).toHaveBeenCalledTimes(2);
+  });
+});

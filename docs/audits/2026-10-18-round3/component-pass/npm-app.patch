+import { afterEach, describe, expect, it, vi } from 'vitest';
+import {
+  check,
+  createAutoUpdateClient,
+  createRuntimeCheck,
+  RIGHTKIT_APP_UPDATE_CHECK_COMMAND,
+  RIGHTKIT_APP_UPDATE_INSTALL_COMMAND,
+  type RuntimeChannel,
+  type UpdateDownloadEvent,
+} from './index.js';
+
+class FakeChannel<T> implements RuntimeChannel<T> {
+  onmessage: (message: T) => void = () => {};
+}
+
+const metadata = {
+  id: 7,
+  currentVersion: '1.0.0',
+  version: '1.1.0',
+  date: '2026-10-17T00:00:00Z',
+  body: 'notes',
+  rawJson: { version: '1.1.0', tier: 'patch' },
+};
+
+function host(handler: (command: string, args?: Record<string, unknown>) => unknown) {
+  const calls: Array<{ command: string; args?: Record<string, unknown> }> = [];
+  const invoke = async <T>(command: string, args?: Record<string, unknown>): Promise<T> => {
+    calls.push({ command, args });
+    return (await handler(command, args)) as T;
+  };
+  return { host: { invoke, Channel: FakeChannel }, calls };
+}
+
+describe('createRuntimeCheck', () => {
+  it('names the native commands', () => {
+    expect(RIGHTKIT_APP_UPDATE_CHECK_COMMAND).toBe('rightkit_app_update_check');
+    expect(RIGHTKIT_APP_UPDATE_INSTALL_COMMAND).toBe('rightkit_app_update_install');
+  });
+
+  it('sends the manifest headers and maps the native metadata', async () => {
+    const { host: h, calls } = host(() => metadata);
+    const update = await createRuntimeCheck(h)({ headers: { Authorization: 'Bearer t', 'X-App': 'a' } });
+    expect(calls).toEqual([
+      {
+        command: 'rightkit_app_update_check',
+        args: { headers: { Authorization: 'Bearer t', 'X-App': 'a' } },
+      },
+    ]);
+    expect(update).toMatchObject({
+      version: '1.1.0',
+      currentVersion: '1.0.0',
+      date: '2026-10-17T00:00:00Z',
+      body: 'notes',
+      rawJson: { tier: 'patch' },
+    });
+  });
+
+  it('returns null when there is no update and sends no headers key value when none are given', async () => {
+    const { host: h, calls } = host(() => null);
+    expect(await createRuntimeCheck(h)()).toBeNull();
+    expect(calls[0].args).toEqual({ headers: undefined });
+  });
+
+  it('refuses non-string header values before invoking', async () => {
+    const { host: h, calls } = host(() => null);
+    await expect(
+      createRuntimeCheck(h)({ headers: { A: 1 as unknown as string } }),
+    ).rejects.toThrow(TypeError);
+    expect(calls).toHaveLength(0);
+  });
+
+  it('turns a native string rejection into an Error', async () => {
+    const { host: h } = host(() => {
+      throw 'update request failed: HTTP 401';
+    });
+    await expect(createRuntimeCheck(h)()).rejects.toThrow('update request failed: HTTP 401');
+  });
+
+  it('installs through the channel with exactly the install headers', async () => {
+    const events: UpdateDownloadEvent[] = [];
+    const { host: h, calls } = host((command, args) => {
+      if (command === 'rightkit_app_update_check') return metadata;
+      const channel = args?.onEvent as FakeChannel<UpdateDownloadEvent>;
+      channel.onmessage({ event: 'Started', data: { contentLength: 10 } });
+      channel.onmessage({ event: 'Progress', data: { chunkLength: 10 } });
+      channel.onmessage({ event: 'Finished' });
+      return undefined;
+    });
+    const update = await createRuntimeCheck(h)({ headers: { A: 'check' } });
+    await update!.downloadAndInstall((e) => events.push(e), { headers: { B: 'install' } });
+
+    const install = calls[1];
+    expect(install.command).toBe('rightkit_app_update_install');
+    expect(install.args).toMatchObject({ id: 7, headers: { B: 'install' } });
+    expect(install.args?.onEvent).toBeInstanceOf(FakeChannel);
+    expect(events.map((e) => e.event)).toEqual(['Started', 'Progress', 'Finished']);
+  });
+
+  it('sends no install headers when none are given and survives a throwing listener', async () => {
+    const { host: h, calls } = host((command, args) => {
+      if (command === 'rightkit_app_update_check') return metadata;
+      (args?.onEvent as FakeChannel<UpdateDownloadEvent>).onmessage({ event: 'Finished' });
+      return undefined;
+    });
+    const update = await createRuntimeCheck(h)();
+    await update!.downloadAndInstall(() => {
+      throw new Error('listener bug');
+    });
+    expect(calls[1].args?.headers).toBeUndefined();
+  });
+
+  it('rejects downloadAndInstall with the native error and honours command overrides', async () => {
+    const { host: base } = host((command) => {
+      if (command === 'custom_check') return metadata;
+      throw 'update signature does not verify';
+    });
+    const update = await createRuntimeCheck({
+      ...base,
+      commands: { check: 'custom_check', install: 'custom_install' },
+    })();
+    await expect(update!.downloadAndInstall()).rejects.toThrow('update signature does not verify');
+  });
+
+  it('drives the auto-update client from the native manifest tier', async () => {
+    const { host: h } = host(() => metadata);
+    const onStatus = vi.fn();
+    const client = createAutoUpdateClient({
+      check: createRuntimeCheck(h),
+      strictInstallHeaders: true,
+      onStatus,
+    });
+    expect(await client.checkOnce()).toMatchObject({
+      kind: 'available',
+      version: '1.1.0',
+      tier: 'patch',
+      eligible: true,
+    });
+  });
+});
+
+describe('check (global Tauri object)', () => {
+  afterEach(() => {
+    delete (globalThis as { __TAURI__?: unknown }).__TAURI__;
+  });
+
+  it('rejects with guidance when the global Tauri object is absent', async () => {
+    await expect(check()).rejects.toThrow('createRuntimeCheck');
+  });
+
+  it('uses window.__TAURI__.core when present', async () => {
+    const { host: h, calls } = host(() => metadata);
+    (globalThis as { __TAURI__?: unknown }).__TAURI__ = { core: h };
+    const update = await check({ headers: { A: 'b' } });
+    expect(update?.version).toBe('1.1.0');
+    expect(calls[0].args).toEqual({ headers: { A: 'b' } });
+  });
+});

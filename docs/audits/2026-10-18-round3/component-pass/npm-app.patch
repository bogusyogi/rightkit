+      // Rebuilt from known fields so a record written by 0.3.x (with its path fields) is migrated, not kept.
+      await config.storage.write({ fromVersion: record.fromVersion, toVersion: record.toVersion, bootAttempts });
+      return { kind: 'probation', toVersion: record.toVersion, bootAttempts };
+    },
+    async acknowledgeHealthy() {
+      await config.storage.clear();
+    },
+  };
+}

+/** Updater target helpers (`<os>-<arch>`), matching the keys of a Tauri static `latest.json` `platforms` map. */
+export type UpdaterOs = 'darwin' | 'macos' | 'windows' | 'linux';
+
+const ARCH_ALIASES: Record<string, string> = {
+  arm64: 'aarch64',
+  aarch64: 'aarch64',
+  x64: 'x86_64',
+  amd64: 'x86_64',
+  x86_64: 'x86_64',
+  universal: 'universal',
+};
+
+/**
+ * Updater target for an OS and architecture. `macos` maps to `darwin`; `arm64` to `aarch64`; `x64` and `amd64`
+ * to `x86_64`. `updaterTarget('macos', 'arm64')` is `darwin-aarch64`.
+ */
+export function updaterTarget(os: UpdaterOs, arch: string): string {
+  const name = os === 'macos' ? 'darwin' : os;
+  const lower = arch.trim().toLowerCase();
+  if (lower === '') throw new Error('updater target: arch must be non-empty');
+  return `${name}-${ARCH_ALIASES[lower] ?? lower}`;
+}
+
+/**
+ * Manifest `platforms` keys to try, best first. `darwin-aarch64` and `darwin-x86_64` fall back to
+ * `darwin-universal`, then `darwin`; `darwin-universal` falls back to `darwin`. Other targets are exact.
+ */
+export function manifestPlatformKeys(target: string): string[] {
+  const keys = [target];
+  if (target.startsWith('darwin-')) {
+    if (target !== 'darwin-universal') keys.push('darwin-universal');
+    keys.push('darwin');
+  }
+  return keys;
+}

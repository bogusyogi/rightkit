+import { describe, expect, it } from 'vitest';
+import { buildActivationHeaders } from './index.js';
+
+const ok = { appName: 'MailRight', activationToken: 'tok', appValue: 'mailright', deviceValue: 'dev-1' };
+
+describe('buildActivationHeaders', () => {
+  it('builds the bearer and the two app headers', () => {
+    expect(buildActivationHeaders(ok)).toEqual({
+      Authorization: 'Bearer tok',
+      'X-MailRight-App': 'mailright',
+      'X-MailRight-Device': 'dev-1',
+    });
+  });
+
+  it('rejects empty, multi-line and non-ASCII values and bad names', () => {
+    expect(() => buildActivationHeaders({ ...ok, activationToken: '' })).toThrow(TypeError);
+    expect(() => buildActivationHeaders({ ...ok, activationToken: 'a\r\nX: y' })).toThrow(TypeError);
+    expect(() => buildActivationHeaders({ ...ok, deviceValue: 'é' })).toThrow(TypeError);
+    expect(() => buildActivationHeaders({ ...ok, appName: 'Mail Right' })).toThrow(TypeError);
+  });
+});
diff --git a/packages/app-update/src/activation-headers.ts b/packages/app-update/src/activation-headers.ts

+/**
+ * The tier with the retired `plus` name folded into `pro` (`plus` was retired; its holders have Pro access).
+ * Any other value is returned unchanged, and `null` stays `null`. `tier()` keeps returning the raw server value.
+ */
+export function normalizeTier(value: string | null | undefined): string | null {
+  if (value === undefined || value === null) return null;
+  return value === 'plus' ? 'pro' : value;
+}
+
+/** The licence's tier through `normalizeTier`: `plus` reads as `pro`. */
+export function normalizedTier(lic: StoredLicense | null): string | null {
+  return normalizeTier(tier(lic));
+}

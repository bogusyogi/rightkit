index 0000000..eedd973
--- /dev/null
+++ b/packages/app-update/src/activation-headers.ts
@@ -0,0 +1,40 @@
+import type { UpdateHeaders } from './index.js';
+
+export interface ActivationHeadersInput {
+  /** Product name used in the custom header names: `X-<appName>-App` and `X-<appName>-Device` (for example `MailRight`). */
+  appName: string;
+  /** The activation token, sent as `Authorization: Bearer <token>`. */
+  activationToken: string;
+  /** Value of `X-<appName>-App` (the app identifier the update server expects). */
+  appValue: string;
+  /** Value of `X-<appName>-Device` (the device identifier). */
+  deviceValue: string;
+}
+
+const NAME_PART = /^[A-Za-z0-9][A-Za-z0-9-]*$/;
+// Visible ASCII plus space and tab; rejects CR, LF and other control characters (header injection).
+const SAFE_VALUE = /^[\t\x20-\x7e]+$/;
+
+function requireValue(label: string, value: string): string {
+  if (typeof value !== 'string' || value.trim() === '' || !SAFE_VALUE.test(value)) {
+    throw new TypeError(`activation headers: ${label} must be a non-empty single-line ASCII string`);
+  }
+  return value.trim();
+}
+
+/**
+ * Build the activation-authenticated manifest request headers apps pass as `getHeaders` of
+ * `createAutoUpdateClient`: `Authorization: Bearer <activation>`, `X-<appName>-App` and `X-<appName>-Device`.
+ * Throws on an empty or multi-line value so a bad credential never reaches the network. Use it for the
+ * manifest check only; keep artifact downloads on `getInstallHeaders` / `strictInstallHeaders`.
+ */
+export function buildActivationHeaders(input: ActivationHeadersInput): UpdateHeaders {
+  if (typeof input.appName !== 'string' || !NAME_PART.test(input.appName)) {
+    throw new TypeError('activation headers: appName must be letters, digits and hyphens');
+  }
+  return {
+    Authorization: `Bearer ${requireValue('activationToken', input.activationToken)}`,
+    [`X-${input.appName}-App`]: requireValue('appValue', input.appValue),
+    [`X-${input.appName}-Device`]: requireValue('deviceValue', input.deviceValue),
+  };
+}

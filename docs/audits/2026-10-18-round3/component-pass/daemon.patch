+#[test]
+fn a_restart_with_a_mode_makes_the_launch_closure_see_the_new_value() {
+    let (events, _seen) = recorder();
+    let mode = SupervisorMode::new(0);
+    let seen_modes = Arc::new(Mutex::new(Vec::<u64>::new()));
+    let (reader, sink) = (mode.clone(), seen_modes.clone());
+    let handle = supervise(
+        config(RestartMode::OnDemand, 5),
+        move || {
+            sink.lock().unwrap().push(reader.get());
+            Err(std::io::Error::other("no such engine"))
+        },
+        |_| true,
+        Some(events),
+    )
+    .unwrap();
+    wait_for("the demand wait", || {
+        handle.status().state == SupervisorState::AwaitingDemand
+    });
+    handle.mode().set(1);
+    assert_eq!(handle.mode().get(), 1);
+    handle.restart_with_mode(2);
+    wait_for("a launch in the new mode", || {
+        seen_modes.lock().unwrap().contains(&2)
+    });
+    // Nothing was running, so there is no child to hand back.
+    assert!(handle.stop_returning_child().is_none());
+}

+// ---- public routes (issue #377) -------------------------------------------------
+
+#[test]
+fn a_public_route_runs_its_handler_without_a_device_and_the_v1_table_stays_closed() {
+    use rightkit_daemon::remote::Response;
+    let h = Harness::new();
+    h.daemon
+        .add_public_route("GET", "/l/go", 64, |_req: &Request| {
+            Response::redirect(302, "https://example.com/landing")
+        })
+        .unwrap();
+    h.daemon
+        .add_public_route("POST", "/hook", 8, |req: &Request| {
+            Response::json(200, json!({ "len": req.body.len() }))
+        })
+        .unwrap();
+    assert!(h
+        .daemon
+        .add_public_route("GET", "/v1/anything", 1, |_| Response::json(200, Value::Null))
+        .is_err());
+    assert!(h
+        .daemon
+        .add_public_route("GET", "/l/go", 1, |_| Response::json(200, Value::Null))
+        .is_err());
+
+    let get = Request {
+        method: "GET".into(),
+        path_and_query: "/l/go?x=1".into(),
+        ..Request::default()
+    };
+    let resp = h.call(get);
+    assert_eq!(resp.status, 302);
+    assert!(resp
+        .headers
+        .contains(&("location".to_string(), "https://example.com/landing".to_string())));
+
+    let ok = Request {
+        method: "POST".into(),
+        path_and_query: "/hook".into(),
+        body: b"12345".to_vec(),
+        ..Request::default()
+    };
+    assert_eq!(h.call(ok).body["len"], 5);
+    let big = Request {
+        method: "POST".into(),
+        path_and_query: "/hook".into(),
+        body: vec![0; 9],
+        ..Request::default()
+    };
+    assert_eq!(h.call(big).status, 413);
+}

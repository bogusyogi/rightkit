@@ -0,0 +1,1030 @@
+//! Install, start, stop, query and remove a user-level background program with the OS's own
+//! manager (issues #405 and the CodeRight addition to it): `systemd --user` on Linux, a launchd
+//! LaunchAgent on macOS, a Task Scheduler task on Windows.
+//!
+//! One description ([`ServiceSpec`]) and one trait ([`ServiceManager`]) cover the three. Each
+//! manager renders its definition (unit file, property list, task XML) with a pure function that
+//! tests can read, and runs the OS tool (`systemctl`, `launchctl`, `schtasks`) through a
+//! [`CommandRunner`] the caller can replace, so a test needs no OS manager.
+//!
+//! Choices that are easy to get wrong, and what was chosen:
+//!
+//! * Everything that reaches a definition file or a command line is validated first: the name is
+//!   `[A-Za-z0-9._-]` (1 to 64 characters, no leading dot), the program path is absolute, and no
+//!   argument, environment entry or description holds a control character. A value that cannot
+//!   be written safely is refused, never escaped into something else.
+//! * Quoting is per format: systemd words are double-quoted with `\`, `"`, `%` and `$` escaped; XML
+//!   text is entity-escaped; a Windows command line follows the `CommandLineToArgvW` rules.
+//! * A Task Scheduler task has no environment, so a spec with environment entries is refused on
+//!   Windows rather than started without them.
+//! * Definition files are written owner-only. The Windows task XML is written (UTF-16, the form
+//!   `schtasks` always accepts) to a directory the caller names, which should be private to the
+//!   app, then registered; the XML is removed again on uninstall.
+//! * `status` reports `Unknown` when the tool answered something this code does not recognise
+//!   (the Task Scheduler status words are localised): it never guesses `Running`.
+//! * Not covered: Windows services (SCM) and Authenticode verification (issue #405, open).
+
+use std::io;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+/// Longest service name.
+pub const MAX_NAME_LEN: usize = 64;
+
+/// What to run, and whether to run it again after it fails.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ServiceSpec {
+    /// The service name: the unit name, the launchd label, the task name.
+    pub name: String,
+    /// Absolute path of the program.
+    pub exec: PathBuf,
+    pub args: Vec<String>,
+    /// Environment of the program. Refused on Windows (a task has none).
+    pub env: Vec<(String, String)>,
+    pub restart: RestartPolicy,
+    /// A one-line description, shown by the OS tools.
+    pub description: Option<String>,
+}
+
+/// Whether the OS manager starts the program again after it ends.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum RestartPolicy {
+    /// Never.
+    Never,
+    /// After an unsuccessful exit (non-zero status or a signal).
+    #[default]
+    OnFailure,
+    /// Whenever it ends.
+    Always,
+}
+
+impl ServiceSpec {
+    /// A spec that starts `exec` with no arguments, restarting on failure.
+    pub fn new(name: impl Into<String>, exec: impl Into<PathBuf>) -> Self {
+        Self {
+            name: name.into(),
+            exec: exec.into(),
+            args: Vec::new(),
+            env: Vec::new(),
+            restart: RestartPolicy::OnFailure,
+            description: None,
+        }
+    }
+
+    #[must_use]
+    pub fn args(mut self, args: impl IntoIterator<Item = impl Into<String>>) -> Self {
+        self.args = args.into_iter().map(Into::into).collect();
+        self
+    }
+
+    #[must_use]
+    pub fn env(mut self, key: impl Into<String>, value: impl Into<String>) -> Self {
+        self.env.push((key.into(), value.into()));
+        self
+    }
+
+    #[must_use]
+    pub fn restart(mut self, restart: RestartPolicy) -> Self {
+        self.restart = restart;
+        self
+    }
+
+    #[must_use]
+    pub fn description(mut self, text: impl Into<String>) -> Self {
+        self.description = Some(text.into());
+        self
+    }
+
+    /// Check every field that reaches a definition file or a command line.
+    pub fn validate(&self) -> Result<(), InstallError> {
+        let bad = |what: &str| Err(InstallError::Invalid(what.to_string()));
+        let name_ok = !self.name.is_empty()
+            && self.name.len() <= MAX_NAME_LEN
+            && !self.name.starts_with('.')
+            && self
+                .name
+                .chars()
+                .all(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '_' | '-'));
+        if !name_ok {
+            return bad("the name must be 1 to 64 characters of [A-Za-z0-9._-] and not start with a dot");
+        }
+        if !self.exec.is_absolute() {
+            return bad("the program path must be absolute");
+        }
+        let exec = self.exec.to_string_lossy();
+        if has_control(&exec) {
+            return bad("the program path holds a control character");
+        }
+        if self.args.iter().any(|a| has_control(a)) {
+            return bad("an argument holds a control character");
+        }
+        for (key, value) in &self.env {
+            let mut chars = key.chars();
+            let key_ok = chars
+                .next()
+                .is_some_and(|c| c.is_ascii_alphabetic() || c == '_')
+                && chars.all(|c| c.is_ascii_alphanumeric() || c == '_');
+            if !key_ok {
+                return bad("an environment name must match [A-Za-z_][A-Za-z0-9_]*");
+            }
+            if has_control(value) {
+                return bad("an environment value holds a control character");
+            }
+        }
+        if self.description.as_deref().is_some_and(has_control) {
+            return bad("the description holds a control character");
+        }
+        Ok(())
+    }
+}
+
+fn has_control(s: &str) -> bool {
+    s.chars().any(char::is_control)
+}
+
+/// What an OS manager says about a service.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum InstallStatus {
+    /// No definition is registered under the name.
+    NotInstalled,
+    /// Registered, not running.
+    Stopped,
+    Running,
+    /// Registered, but the tool's answer was not one this code recognises.
+    Unknown,
+}
+
+/// Why an install operation failed.
+#[derive(Debug)]
+pub enum InstallError {
+    /// The spec holds a value that cannot be written safely.
+    Invalid(String),
+    /// This manager cannot express the spec (for example environment entries in a task).
+    Unsupported(String),
+    /// The OS tool ran and refused.
+    Command {
+        program: String,
+        code: Option<i32>,
+        stderr: String,
+    },
+    Io(io::Error),
+}
+
+impl std::fmt::Display for InstallError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            InstallError::Invalid(s) => write!(f, "invalid service spec: {s}"),
+            InstallError::Unsupported(s) => write!(f, "not supported by this manager: {s}"),
+            InstallError::Command {
+                program,
+                code,
+                stderr,
+            } => match code {
+                Some(c) => write!(f, "{program} failed with status {c}: {}", stderr.trim()),
+                None => write!(f, "{program} failed: {}", stderr.trim()),
+            },
+            InstallError::Io(e) => write!(f, "{e}"),
+        }
+    }
+}
+
+impl std::error::Error for InstallError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            InstallError::Io(e) => Some(e),
+            _ => None,
+        }
+    }
+}
+
+impl From<io::Error> for InstallError {
+    fn from(e: io::Error) -> Self {
+        InstallError::Io(e)
+    }
+}
+
+fn fs_error(e: rightkit_fs::FsError) -> InstallError {
+    InstallError::Io(io::Error::other(e.to_string()))
+}
+
+/// The result of one OS tool run.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct CommandOutput {
+    pub success: bool,
+    pub code: Option<i32>,
+    pub stdout: String,
+    pub stderr: String,
+}
+
+/// Runs the OS tool. The real one is [`SystemRunner`]; tests supply their own.
+pub trait CommandRunner: Send + Sync {
+    /// Run `program` with `args` and wait. `Err` only when the program could not be started.
+    fn run(&self, program: &str, args: &[String]) -> io::Result<CommandOutput>;
+}
+
+/// Runs the program for real, with no shell and no inherited stdin.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct SystemRunner;
+
+impl CommandRunner for SystemRunner {
+    fn run(&self, program: &str, args: &[String]) -> io::Result<CommandOutput> {
+        let mut command = Command::new(program);
+        command
+            .args(args)
+            .stdin(std::process::Stdio::null())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::piped());
+        #[cfg(windows)]
+        {
+            use std::os::windows::process::CommandExt;
+            command.creation_flags(0x0800_0000); // CREATE_NO_WINDOW
+        }
+        let out = command.output()?;
+        Ok(CommandOutput {
+            success: out.status.success(),
+            code: out.status.code(),
+            stdout: String::from_utf8_lossy(&out.stdout).into_owned(),
+            stderr: String::from_utf8_lossy(&out.stderr).into_owned(),
+        })
+    }
+}
+
+/// Install, start, stop, query and remove one background program.
+pub trait ServiceManager {
+    /// Write the definition and register it. Starts at the next login (and, for launchd, now).
+    /// Installing again replaces the definition.
+    fn install(&self, spec: &ServiceSpec) -> Result<(), InstallError>;
+    fn start(&self, name: &str) -> Result<(), InstallError>;
+    fn stop(&self, name: &str) -> Result<(), InstallError>;
+    fn status(&self, name: &str) -> Result<InstallStatus, InstallError>;
+    /// Stop (best effort), unregister and delete the definition. A name that is not installed
+    /// is not an error.
+    fn uninstall(&self, name: &str) -> Result<(), InstallError>;
+}
+
+fn check_name(name: &str) -> Result<(), InstallError> {
+    ServiceSpec::new(name, if cfg!(windows) { "C:\\x" } else { "/x" }).validate()
+}
+
+fn run_ok(
+    runner: &dyn CommandRunner,
+    program: &str,
+    args: &[&str],
+) -> Result<CommandOutput, InstallError> {
+    let owned: Vec<String> = args.iter().map(|s| (*s).to_string()).collect();
+    let out = runner.run(program, &owned)?;
+    if out.success {
+        Ok(out)
+    } else {
+        Err(InstallError::Command {
+            program: program.to_string(),
+            code: out.code,
+            stderr: out.stderr,
+        })
+    }
+}
+
+// ---- systemd --user ------------------------------------------------------------------------
+
+/// Quote one word of a systemd command line or `Environment=` assignment.
+fn systemd_quote(word: &str) -> String {
+    let mut out = String::with_capacity(word.len() + 2);
+    out.push('"');
+    for c in word.chars() {
+        match c {
+            '\\' => out.push_str("\\\\"),
+            '"' => out.push_str("\\\""),
+            // A specifier and an environment expansion: written literally.
+            '%' => out.push_str("%%"),
+            '$' => out.push_str("$$"),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+/// The `systemd` user unit text for `spec`.
+pub fn render_systemd_unit(spec: &ServiceSpec) -> Result<String, InstallError> {
+    spec.validate()?;
+    let mut unit = String::from("[Unit]\n");
+    let description = spec.description.as_deref().unwrap_or(&spec.name);
+    unit.push_str(&format!("Description={}\n\n", description.replace('%', "%%")));
+    unit.push_str("[Service]\nType=simple\n");
+    let mut words = vec![systemd_quote(&spec.exec.to_string_lossy())];
+    words.extend(spec.args.iter().map(|a| systemd_quote(a)));
+    unit.push_str(&format!("ExecStart={}\n", words.join(" ")));
+    let restart = match spec.restart {
+        RestartPolicy::Never => "no",
+        RestartPolicy::OnFailure => "on-failure",
+        RestartPolicy::Always => "always",
+    };
+    unit.push_str(&format!("Restart={restart}\n"));
+    if spec.restart != RestartPolicy::Never {
+        unit.push_str("RestartSec=5\n");
+    }
+    for (key, value) in &spec.env {
+        // The whole assignment is one quoted word: `Environment="KEY=value"`.
+        let assignment = format!("{key}={value}");
+        let quoted = systemd_quote(&assignment);
+        unit.push_str(&format!("Environment={quoted}\n"));
+    }
+    unit.push_str("\n[Install]\nWantedBy=default.target\n");
+    Ok(unit)
+}
+
+/// `systemd --user` (Linux). Units live in `unit_dir` (normally `~/.config/systemd/user`).
+pub struct SystemdUser<R: CommandRunner = SystemRunner> {
+    runner: R,
+    unit_dir: PathBuf,
+}
+
+impl<R: CommandRunner> SystemdUser<R> {
+    pub fn new(runner: R, unit_dir: impl Into<PathBuf>) -> Self {
+        Self {
+            runner,
+            unit_dir: unit_dir.into(),
+        }
+    }
+
+    fn unit_path(&self, name: &str) -> PathBuf {
+        self.unit_dir.join(format!("{name}.service"))
+    }
+
+    fn ctl(&self, args: &[&str]) -> Result<CommandOutput, InstallError> {
+        let mut all = vec!["--user"];
+        all.extend_from_slice(args);
+        run_ok(&self.runner, "systemctl", &all)
+    }
+}
+
+impl<R: CommandRunner> ServiceManager for SystemdUser<R> {
+    fn install(&self, spec: &ServiceSpec) -> Result<(), InstallError> {
+        let text = render_systemd_unit(spec)?;
+        std::fs::create_dir_all(&self.unit_dir)?;
+        rightkit_fs::write_private_text(&self.unit_path(&spec.name), &text).map_err(fs_error)?;
+        let unit = format!("{}.service", spec.name);
+        self.ctl(&["daemon-reload"])?;
+        self.ctl(&["enable", &unit])?;
+        Ok(())
+    }
+
+    fn start(&self, name: &str) -> Result<(), InstallError> {
+        check_name(name)?;
+        self.ctl(&["start", &format!("{name}.service")]).map(|_| ())
+    }
+
+    fn stop(&self, name: &str) -> Result<(), InstallError> {
+        check_name(name)?;
+        self.ctl(&["stop", &format!("{name}.service")]).map(|_| ())
+    }
+
+    fn status(&self, name: &str) -> Result<InstallStatus, InstallError> {
+        check_name(name)?;
+        if !self.unit_path(name).exists() {
+            return Ok(InstallStatus::NotInstalled);
+        }
+        // `is-active` exits non-zero for every state but `active`, so the words decide.
+        let out = self.runner.run(
+            "systemctl",
+            &[
+                "--user".to_string(),
+                "is-active".to_string(),
+                format!("{name}.service"),
+            ],
+        )?;
+        Ok(match out.stdout.trim() {
+            "active" | "activating" | "reloading" => InstallStatus::Running,
+            "inactive" | "failed" | "deactivating" => InstallStatus::Stopped,
+            _ => InstallStatus::Unknown,
+        })
+    }
+
+    fn uninstall(&self, name: &str) -> Result<(), InstallError> {
+        check_name(name)?;
+        let unit = format!("{name}.service");
+        let path = self.unit_path(name);
+        if !path.exists() {
+            return Ok(());
+        }
+        let _ = self.ctl(&["stop", &unit]);
+        let _ = self.ctl(&["disable", &unit]);
+        std::fs::remove_file(&path)?;
+        self.ctl(&["daemon-reload"])?;
+        Ok(())
+    }
+}
+
+// ---- launchd ---------------------------------------------------------------------------------
+
+/// Escape text for an XML element.
+fn xml_escape(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    for c in text.chars() {
+        match c {
+            '&' => out.push_str("&amp;"),
+            '<' => out.push_str("&lt;"),
+            '>' => out.push_str("&gt;"),
+            '"' => out.push_str("&quot;"),
+            '\'' => out.push_str("&apos;"),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+/// The LaunchAgent property list for `spec` (the label is the spec's name).
+pub fn render_launch_agent_plist(spec: &ServiceSpec) -> Result<String, InstallError> {
+    spec.validate()?;
+    let mut p = String::new();
+    p.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
+    p.push_str("<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n");
+    p.push_str("<plist version=\"1.0\">\n<dict>\n");
+    p.push_str(&format!(
+        "  <key>Label</key>\n  <string>{}</string>\n",
+        xml_escape(&spec.name)
+    ));
+    p.push_str("  <key>ProgramArguments</key>\n  <array>\n");
+    p.push_str(&format!(
+        "    <string>{}</string>\n",
+        xml_escape(&spec.exec.to_string_lossy())
+    ));
+    for arg in &spec.args {
+        p.push_str(&format!("    <string>{}</string>\n", xml_escape(arg)));
+    }
+    p.push_str("  </array>\n");
+    if !spec.env.is_empty() {
+        p.push_str("  <key>EnvironmentVariables</key>\n  <dict>\n");
+        for (key, value) in &spec.env {
+            p.push_str(&format!(
+                "    <key>{}</key>\n    <string>{}</string>\n",
+                xml_escape(key),
+                xml_escape(value)
+            ));
+        }
+        p.push_str("  </dict>\n");
+    }
+    p.push_str("  <key>RunAtLoad</key>\n  <true/>\n");
+    match spec.restart {
+        RestartPolicy::Never => {}
+        RestartPolicy::OnFailure => p.push_str(
+            "  <key>KeepAlive</key>\n  <dict>\n    <key>SuccessfulExit</key>\n    <false/>\n  </dict>\n",
+        ),
+        RestartPolicy::Always => p.push_str("  <key>KeepAlive</key>\n  <true/>\n"),
+    }
+    p.push_str("</dict>\n</plist>\n");
+    Ok(p)
+}
+
+/// A launchd LaunchAgent (macOS). Property lists live in `agents_dir` (normally
+/// `~/Library/LaunchAgents`); `uid` is the user's id, for the `gui/<uid>` domain.
+pub struct LaunchAgent<R: CommandRunner = SystemRunner> {
+    runner: R,
+    agents_dir: PathBuf,
+    uid: u32,
+}
+
+impl<R: CommandRunner> LaunchAgent<R> {
+    pub fn new(runner: R, agents_dir: impl Into<PathBuf>, uid: u32) -> Self {
+        Self {
+            runner,
+            agents_dir: agents_dir.into(),
+            uid,
+        }
+    }
+
+    fn plist_path(&self, label: &str) -> PathBuf {
+        self.agents_dir.join(format!("{label}.plist"))
+    }
+
+    fn domain(&self) -> String {
+        format!("gui/{}", self.uid)
+    }
+
+    fn target(&self, label: &str) -> String {
+        format!("gui/{}/{label}", self.uid)
+    }
+}
+
+impl<R: CommandRunner> ServiceManager for LaunchAgent<R> {
+    fn install(&self, spec: &ServiceSpec) -> Result<(), InstallError> {
+        let text = render_launch_agent_plist(spec)?;
+        std::fs::create_dir_all(&self.agents_dir)?;
+        let path = self.plist_path(&spec.name);
+        // Replace a loaded definition: unload the old one first (it may not be loaded).
+        let _ = run_ok(
+            &self.runner,
+            "launchctl",
+            &["bootout", &self.target(&spec.name)],
+        );
+        rightkit_fs::write_private_text(&path, &text).map_err(fs_error)?;
+        run_ok(
+            &self.runner,
+            "launchctl",
+            &["bootstrap", &self.domain(), &path.to_string_lossy()],
+        )?;
+        Ok(())
+    }
+
+    fn start(&self, name: &str) -> Result<(), InstallError> {
+        check_name(name)?;
+        let path = self.plist_path(name);
+        // Already loaded is fine: the kickstart below is what starts it.
+        let _ = run_ok(
+            &self.runner,
+            "launchctl",
+            &["bootstrap", &self.domain(), &path.to_string_lossy()],
+        );
+        run_ok(
+            &self.runner,
+            "launchctl",
+            &["kickstart", &self.target(name)],
+        )
+        .map(|_| ())
+    }
+
+    fn stop(&self, name: &str) -> Result<(), InstallError> {
+        check_name(name)?;
+        // `bootout` unloads the job, which ends it and stops KeepAlive from restarting it.
+        run_ok(&self.runner, "launchctl", &["bootout", &self.target(name)]).map(|_| ())
+    }
+
+    fn status(&self, name: &str) -> Result<InstallStatus, InstallError> {
+        check_name(name)?;
+        let out = self.runner.run(
+            "launchctl",
+            &["print".to_string(), self.target(name)],
+        )?;
+        if out.success {
+            let running = out.stdout.lines().any(|l| l.trim() == "state = running");
+            return Ok(if running {
+                InstallStatus::Running
+            } else {
+                InstallStatus::Stopped
+            });
+        }
+        Ok(if self.plist_path(name).exists() {
+            InstallStatus::Stopped
+        } else {
+            InstallStatus::NotInstalled
+        })
+    }
+
+    fn uninstall(&self, name: &str) -> Result<(), InstallError> {
+        check_name(name)?;
+        let _ = run_ok(&self.runner, "launchctl", &["bootout", &self.target(name)]);
+        match std::fs::remove_file(self.plist_path(name)) {
+            Ok(()) => Ok(()),
+            Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(()),
+            Err(e) => Err(e.into()),
+        }
+    }
+}
+
+// ---- Windows Task Scheduler ---------------------------------------------------------------------
+
+/// Quote one argument of a Windows command line (the `CommandLineToArgvW` rules).
+pub fn windows_quote_arg(arg: &str) -> String {
+    if !arg.is_empty() && !arg.chars().any(|c| matches!(c, ' ' | '\t' | '"')) {
+        return arg.to_string();
+    }
+    let mut out = String::from("\"");
+    let mut backslashes = 0usize;
+    for c in arg.chars() {
+        match c {
+            '\\' => backslashes += 1,
+            '"' => {
+                // Backslashes before a quote are doubled, and the quote is escaped.
+                out.push_str(&"\\".repeat(backslashes * 2 + 1));
+                out.push('"');
+                backslashes = 0;
+            }
+            c => {
+                out.push_str(&"\\".repeat(backslashes));
+                backslashes = 0;
+                out.push(c);
+            }
+        }
+    }
+    // Backslashes before the closing quote are doubled.
+    out.push_str(&"\\".repeat(backslashes * 2));
+    out.push('"');
+    out
+}
+
+/// The Task Scheduler XML for `spec`: a logon trigger for the creating user, least privilege, one
+/// instance, no time limit, and a restart on failure when the policy asks for one. Environment
+/// entries are refused ([`InstallError::Unsupported`]).
+pub fn render_task_xml(spec: &ServiceSpec) -> Result<String, InstallError> {
+    spec.validate()?;
+    if !spec.env.is_empty() {
+        return Err(InstallError::Unsupported(
+            "a scheduled task has no environment; set it inside the program".into(),
+        ));
+    }
+    let arguments = spec
+        .args
+        .iter()
+        .map(|a| windows_quote_arg(a))
+        .collect::<Vec<_>>()
+        .join(" ");
+    let mut x = String::new();
+    x.push_str("<?xml version=\"1.0\" encoding=\"UTF-16\"?>\n");
+    x.push_str("<Task version=\"1.2\" xmlns=\"http://schemas.microsoft.com/windows/2004/02/mit/task\">\n");
+    x.push_str("  <RegistrationInfo>\n");
+    x.push_str(&format!(
+        "    <Description>{}</Description>\n",
+        xml_escape(spec.description.as_deref().unwrap_or(&spec.name))
+    ));
+    x.push_str("  </RegistrationInfo>\n");
+    x.push_str("  <Triggers>\n    <LogonTrigger>\n      <Enabled>true</Enabled>\n    </LogonTrigger>\n  </Triggers>\n");
+    x.push_str("  <Principals>\n    <Principal id=\"Author\">\n      <LogonType>InteractiveToken</LogonType>\n      <RunLevel>LeastPrivilege</RunLevel>\n    </Principal>\n  </Principals>\n");
+    x.push_str("  <Settings>\n");
+    x.push_str("    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>\n");
+    x.push_str("    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>\n");
+    x.push_str("    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>\n");
+    x.push_str("    <StartWhenAvailable>true</StartWhenAvailable>\n");
+    x.push_str("    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>\n");
+    x.push_str("    <Enabled>true</Enabled>\n");
+    if spec.restart != RestartPolicy::Never {
+        x.push_str("    <RestartOnFailure>\n      <Interval>PT1M</Interval>\n      <Count>999</Count>\n    </RestartOnFailure>\n");
+    }
+    x.push_str("  </Settings>\n");
+    x.push_str("  <Actions Context=\"Author\">\n    <Exec>\n");
+    x.push_str(&format!(
+        "      <Command>{}</Command>\n",
+        xml_escape(&spec.exec.to_string_lossy())
+    ));
+    if !arguments.is_empty() {
+        x.push_str(&format!("      <Arguments>{}</Arguments>\n", xml_escape(&arguments)));
+    }
+    x.push_str("    </Exec>\n  </Actions>\n</Task>\n");
+    Ok(x)
+}
+
+/// The task XML as UTF-16 little endian with a byte-order mark, the encoding `schtasks /XML`
+/// accepts on every Windows version.
+pub fn task_xml_utf16(xml: &str) -> Vec<u8> {
+    let mut bytes = vec![0xFF, 0xFE];
+    for unit in xml.encode_utf16() {
+        bytes.extend_from_slice(&unit.to_le_bytes());
+    }
+    bytes
+}
+
+/// A Task Scheduler task (Windows) that starts at logon. `work_dir` is a directory private to the
+/// app, where the task XML is written before it is registered.
+pub struct ScheduledTask<R: CommandRunner = SystemRunner> {
+    runner: R,
+    work_dir: PathBuf,
+}
+
+impl<R: CommandRunner> ScheduledTask<R> {
+    pub fn new(runner: R, work_dir: impl Into<PathBuf>) -> Self {
+        Self {
+            runner,
+            work_dir: work_dir.into(),
+        }
+    }
+
+    fn xml_path(&self, name: &str) -> PathBuf {
+        self.work_dir.join(format!("{name}.task.xml"))
+    }
+}
+
+impl<R: CommandRunner> ServiceManager for ScheduledTask<R> {
+    fn install(&self, spec: &ServiceSpec) -> Result<(), InstallError> {
+        let xml = render_task_xml(spec)?;
+        rightkit_fs::ensure_private_dir(&self.work_dir).map_err(fs_error)?;
+        let path = self.xml_path(&spec.name);
+        rightkit_fs::write_private_file(&path, &task_xml_utf16(&xml)).map_err(fs_error)?;
+        run_ok(
+            &self.runner,
+            "schtasks",
+            &["/Create", "/TN", &spec.name, "/XML", &path.to_string_lossy(), "/F"],
+        )?;
+        Ok(())
+    }
+
+    fn start(&self, name: &str) -> Result<(), InstallError> {
+        check_name(name)?;
+        run_ok(&self.runner, "schtasks", &["/Run", "/TN", name]).map(|_| ())
+    }
+
+    fn stop(&self, name: &str) -> Result<(), InstallError> {
+        check_name(name)?;
+        run_ok(&self.runner, "schtasks", &["/End", "/TN", name]).map(|_| ())
+    }
+
+    fn status(&self, name: &str) -> Result<InstallStatus, InstallError> {
+        check_name(name)?;
+        let out = self.runner.run(
+            "schtasks",
+            &[
+                "/Query".to_string(),
+                "/TN".to_string(),
+                name.to_string(),
+                "/FO".to_string(),
+                "CSV".to_string(),
+                "/NH".to_string(),
+            ],
+        )?;
+        if !out.success {
+            return Ok(InstallStatus::NotInstalled);
+        }
+        // `"\name","next run","Status"`: the last CSV field is the (localised) status word.
+        let line = out.stdout.lines().find(|l| !l.trim().is_empty()).unwrap_or("");
+        let status = line
+            .trim()
+            .trim_end_matches('"')
+            .rsplit("\",\"")
+            .next()
+            .unwrap_or("");
+        Ok(match status {
+            "Running" => InstallStatus::Running,
+            "Ready" | "Disabled" => InstallStatus::Stopped,
+            _ => InstallStatus::Unknown,
+        })
+    }
+
+    fn uninstall(&self, name: &str) -> Result<(), InstallError> {
+        check_name(name)?;
+        let _ = run_ok(&self.runner, "schtasks", &["/End", "/TN", name]);
+        let query = self.status(name)?;
+        if query != InstallStatus::NotInstalled {
+            run_ok(&self.runner, "schtasks", &["/Delete", "/TN", name, "/F"])?;
+        }
+        match std::fs::remove_file(self.xml_path(name)) {
+            Ok(()) => Ok(()),
+            Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(()),
+            Err(e) => Err(e.into()),
+        }
+    }
+}
+
+/// The manager of this platform, using the real OS tools: `systemd --user` on Linux, a LaunchAgent
+/// on macOS, a scheduled task on Windows. `work_dir` is a directory private to the app (used for
+/// the Windows task XML; ignored elsewhere). `None` on other platforms, or where the home
+/// directory cannot be read from the account database.
+pub fn platform_manager(work_dir: &Path) -> Option<Box<dyn ServiceManager>> {
+    #[cfg(target_os = "linux")]
+    {
+        let _ = work_dir;
+        let home = crate::suite::passwd_home_dir().ok()?;
+        Some(Box::new(SystemdUser::new(
+            SystemRunner,
+            home.join(".config").join("systemd").join("user"),
+        )))
+    }
+    #[cfg(target_os = "macos")]
+    {
+        let _ = work_dir;
+        let home = crate::suite::passwd_home_dir().ok()?;
+        Some(Box::new(LaunchAgent::new(
+            SystemRunner,
+            home.join("Library").join("LaunchAgents"),
+            crate::transport::current_uid(),
+        )))
+    }
+    #[cfg(windows)]
+    {
+        Some(Box::new(ScheduledTask::new(SystemRunner, work_dir)))
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "macos", windows)))]
+    {
+        let _ = work_dir;
+        None
+    }
+}

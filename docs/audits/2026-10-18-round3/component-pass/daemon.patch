+            loop {
+                {
+                    let mut seen = self.seen.lock().unwrap_or_else(|e| e.into_inner());
+                    let now = read_counter(&self.wake);
+                    if now != *seen {
+                        *seen = now;
+                        return Ok(true);
+                    }
+                }
+                let left = end.saturating_duration_since(Instant::now());
+                if left.is_zero() {
+                    return Ok(false);
+                }
+                std::thread::sleep(left.min(POLL));
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn suite() -> (tempfile::TempDir, Suite) {
+        let dir = tempfile::tempdir().unwrap();
+        let suite = Suite::at(dir.path()).unwrap();
+        (dir, suite)
+    }
+
+    #[test]
+    fn names_are_validated_and_the_key_separates_suites_services_and_names() {
+        let (_d1, s1) = suite();
+        let (_d2, s2) = suite();
+        assert!(Wake::new(&s1, "Bad Service", "x").is_err());
+        assert!(Wake::new(&s1, "svc", "").is_err());
+        assert!(Wake::new(&s1, "svc", "UPPER").is_err());
+        assert!(Wake::new(&s1, "svc", &"n".repeat(MAX_NAME_LEN + 1)).is_err());
+        let a = Wake::new(&s1, "svc", "ping").unwrap();
+        assert_eq!(a.key(), Wake::new(&s1, "svc", "ping").unwrap().key());
+        assert_ne!(a.key(), Wake::new(&s2, "svc", "ping").unwrap().key());
+        assert_ne!(a.key(), Wake::new(&s1, "other", "ping").unwrap().key());
+        assert_ne!(a.key(), Wake::new(&s1, "svc", "pong").unwrap().key());
+    }
+
+    #[test]
+    fn a_post_wakes_a_listener_and_a_quiet_wait_times_out() {
+        let (_dir, suite) = suite();
+        let wake = Wake::new(&suite, "svc", "ping").unwrap();
+        let listener = wake.listen().unwrap();
+        assert!(!listener.wait(Duration::from_millis(80)).unwrap());
+        wake.post().unwrap();
+        assert!(listener.wait(Duration::from_secs(5)).unwrap());
+        // The post was consumed.
+        assert!(!listener.wait(Duration::from_millis(80)).unwrap());
+    }
+
+    #[test]
+    fn a_post_from_another_thread_wakes_a_waiting_listener() {
+        let (_dir, suite) = suite();
+        let wake = Wake::new(&suite, "svc", "cross").unwrap();
+        let listener = wake.listen().unwrap();
+        let poster = wake.clone();
+        let t = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(100));
+            poster.post().unwrap();
+        });
+        assert!(listener.wait(Duration::from_secs(5)).unwrap());
+        t.join().unwrap();
+    }
+
+    #[test]
+    fn a_post_with_no_listener_is_not_an_error() {
+        let (_dir, suite) = suite();
+        Wake::new(&suite, "svc", "nobody").unwrap().post().unwrap();
+    }
+}

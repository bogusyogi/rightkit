+
+    fn path(w: &Wake) -> std::path::PathBuf {
+        w.dir.join(format!("{}.wake", w.key))
+    }
+
+    fn read_counter(w: &Wake) -> String {
+        std::fs::read_to_string(path(w)).unwrap_or_default()

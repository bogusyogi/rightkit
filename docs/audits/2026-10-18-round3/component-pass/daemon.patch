+
+    impl Listener {
+        pub fn wait(&self, timeout: Duration) -> io::Result<bool> {
+            let millis = c_int::try_from(timeout.as_millis()).unwrap_or(c_int::MAX);
+            let mut fds = PollFd {
+                fd: self.fd,
+                events: POLLIN,
+                revents: 0,
+            };
+            // SAFETY: one valid `pollfd`.
+            let ready = unsafe { poll(&mut fds, 1, millis) };
+            if ready < 0 {
+                let err = io::Error::last_os_error();
+                return if err.kind() == io::ErrorKind::Interrupted {
+                    Ok(false)
+                } else {
+                    Err(err)
+                };
+            }
+            if ready == 0 {
+                return Ok(false);
+            }
+            // Each notification writes its 4-byte token. Drain what is queued so a burst wakes once.
+            let mut buf = [0u8; 256];
+            // SAFETY: `buf` is valid for 256 bytes; the descriptor is ours until drop.
+            let n = unsafe { read(self.fd, buf.as_mut_ptr(), buf.len()) };
+            Ok(n > 0)
+        }
+    }
+
+    impl Drop for Listener {
+        fn drop(&mut self) {
+            // SAFETY: cancelling our registration and closing the descriptor it gave us.
+            unsafe {

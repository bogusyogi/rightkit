+        let nanos = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or(0);
+        let value = format!("{nanos}:{}", std::process::id());
+        rightkit_fs::write_private_text(&path(w), &value).map_err(io::Error::other)
+    }

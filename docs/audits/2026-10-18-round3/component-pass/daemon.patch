+    pub fn post(w: &Wake) -> io::Result<()> {
+        let name = name(w)?;
+        // SAFETY: `name` is a NUL-terminated C string that outlives the call.
+        match unsafe { notify_post(name.as_ptr()) } {
+            NOTIFY_STATUS_OK => Ok(()),
+            status => Err(io::Error::other(format!("notify_post returned {status}"))),
+        }
+    }
+
+    pub struct Listener {
+        fd: c_int,
+        token: c_int,
+    }
+
+    pub fn listen(w: &Wake) -> io::Result<Listener> {
+        let name = name(w)?;
+        let (mut fd, mut token) = (-1, 0);
+        // SAFETY: `name` is a C string; `fd` and `token` are valid out-pointers.
+        let status = unsafe { notify_register_file_descriptor(name.as_ptr(), &mut fd, 0, &mut token) };
+        if status != NOTIFY_STATUS_OK || fd < 0 {
+            return Err(io::Error::other(format!(
+                "notify_register_file_descriptor returned {status}"
+            )));
+        }
+        Ok(Listener { fd, token })

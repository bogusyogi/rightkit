@@ -0,0 +1,470 @@
+//! A cross-process wake signal (issue #404): one process posts, another waits, and the waiter
+//! learns only that it should look again. No data travels with it.
+//!
+//! | Platform | Mechanism |
+//! | --- | --- |
+//! | macOS | Darwin notifications (`notify_post`, `notify_register_file_descriptor`), a per-user, per-suite name |
+//! | Windows | a named auto-reset event in the session namespace (`Local\...`), created with the owner-only DACL |
+//! | Linux and others | a counter file in the suite's private `wake` directory, polled every 50 ms |
+//!
+//! What a wake is, and is not:
+//!
+//! * It is a **hint**. Darwin notifications are not access controlled, so any process may post one
+//!   for the name; a receiver must re-read the state it cares about (a record, a queue, a file)
+//!   instead of acting on the wake itself, and must keep its own periodic re-check for a missed
+//!   one. A post made while nobody listens is lost on macOS and Windows.
+//! * Posts **coalesce**: several posts before the waiter runs wake it once.
+//! * On Windows one name has one event, shared by every listener of that name in the session: a
+//!   post wakes only one waiter. Use one listener per name.
+//! * The name is derived from the suite root, the service and the name together with the user
+//!   (uid or SID), so two suites, or two users, never share a signal. The derivation is a plain
+//!   hash for separation, not a secret.
+//!
+//! Wake-ups across a network, subscriptions that carry data, and the Swift observer are not here.
+
+use crate::suite::{valid_service_name, Suite, SuiteError};
+use std::io;
+use std::time::Duration;
+
+/// Longest signal name.
+pub const MAX_NAME_LEN: usize = 64;
+
+/// Why a signal could not be opened.
+#[derive(Debug)]
+pub enum WakeError {
+    /// The service or signal name is not `[a-z0-9-]` (service) or `[a-z0-9._-]` (signal).
+    BadName(String),
+    Suite(SuiteError),
+    Io(io::Error),
+}
+
+impl std::fmt::Display for WakeError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            WakeError::BadName(s) => write!(f, "bad wake name: {s}"),
+            WakeError::Suite(e) => write!(f, "{e}"),
+            WakeError::Io(e) => write!(f, "{e}"),
+        }
+    }
+}
+
+impl std::error::Error for WakeError {}
+
+impl From<io::Error> for WakeError {
+    fn from(e: io::Error) -> Self {
+        WakeError::Io(e)
+    }
+}
+
+impl From<SuiteError> for WakeError {
+    fn from(e: SuiteError) -> Self {
+        WakeError::Suite(e)
+    }
+}
+
+/// A named wake signal. Cheap to create; [`post`](Self::post) from any process,
+/// [`listen`](Self::listen) in the one that waits.
+#[derive(Debug, Clone)]
+pub struct Wake {
+    /// Platform-visible identifier, derived once.
+    key: String,
+    /// Directory of the counter file (the fallback mechanism; unused on macOS and Windows).
+    #[cfg_attr(any(windows, target_os = "macos"), allow(dead_code))]
+    dir: std::path::PathBuf,
+}
+
+/// FNV-1a, 64 bit: separates names, is not a security boundary.
+fn fnv1a(parts: &[&str]) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for part in parts {
+        for b in part.bytes().chain(std::iter::once(0u8)) {
+            h ^= u64::from(b);
+            h = h.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+    }
+    h
+}
+
+fn user_tag() -> String {
+    #[cfg(windows)]
+    {
+        crate::peer::current_user_sid_string().unwrap_or_default()
+    }
+    #[cfg(unix)]
+    {
+        crate::transport::current_uid().to_string()
+    }
+    #[cfg(not(any(unix, windows)))]
+    {
+        String::new()
+    }
+}
+
+impl Wake {
+    /// The signal `name` of `service` in `suite`. Creates the private `wake` directory for the
+    /// fallback mechanism only where that mechanism is used.
+    pub fn new(suite: &Suite, service: &str, name: &str) -> Result<Wake, WakeError> {
+        if !valid_service_name(service) {
+            return Err(WakeError::BadName(format!("service {service:?}")));
+        }
+        let name_ok = !name.is_empty()
+            && name.len() <= MAX_NAME_LEN
+            && name
+                .chars()
+                .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || matches!(c, '.' | '_' | '-'));
+        if !name_ok {
+            return Err(WakeError::BadName(format!("signal {name:?}")));
+        }
+        let root = suite.root().to_string_lossy().into_owned();
+        let tag = fnv1a(&[&root, service, name, &user_tag()]);
+        let key = format!("rk-wake-{tag:016x}");
+        #[cfg(not(any(target_os = "macos", windows)))]
+        let dir = suite.private_service_subdir(service, "wake")?;
+        #[cfg(any(target_os = "macos", windows))]
+        let dir = suite.service_dir(service).join("wake");
+        Ok(Wake { key, dir })
+    }
+
+    /// The identifier the OS mechanism uses (for logs and tests).
+    pub fn key(&self) -> &str {
+        &self.key
+    }
+
+    /// Signal the waiter. `Ok(())` also when nobody listens (macOS and Windows lose the post; the
+    /// fallback keeps it until the next listener starts, which ignores it).
+    pub fn post(&self) -> io::Result<()> {
+        imp::post(self)
+    }
+
+    /// Start waiting. Posts made before this call do not wake the listener.
+    pub fn listen(&self) -> io::Result<WakeListener> {
+        imp::listen(self).map(WakeListener)
+    }
+}
+
+/// The waiting side of a [`Wake`]. Dropping it releases the OS resource.
+pub struct WakeListener(imp::Listener);
+
+impl WakeListener {
+    /// Wait up to `timeout` for a post. True when woken, false on timeout. Several posts since the
+    /// last wait count as one.
+    pub fn wait(&self, timeout: Duration) -> io::Result<bool> {
+        self.0.wait(timeout)
+    }
+}
+
+#[cfg(windows)]
+mod imp {
+    use super::Wake;
+    use std::ffi::c_void;
+    use std::io;
+    use std::time::Duration;
+
+    #[link(name = "kernel32")]
+    extern "system" {
+        fn CreateEventW(
+            attributes: *const c_void,
+            manual_reset: i32,
+            initial_state: i32,
+            name: *const u16,
+        ) -> *mut c_void;
+        fn OpenEventW(access: u32, inherit: i32, name: *const u16) -> *mut c_void;
+        fn SetEvent(handle: *mut c_void) -> i32;
+        fn WaitForSingleObject(handle: *mut c_void, millis: u32) -> u32;
+        fn CloseHandle(handle: *mut c_void) -> i32;
+    }
+
+    const EVENT_MODIFY_STATE: u32 = 0x0002;
+    const WAIT_OBJECT_0: u32 = 0;
+    const WAIT_TIMEOUT: u32 = 258;
+
+    fn wide_name(w: &Wake) -> Vec<u16> {
+        format!("Local\\{}", w.key)
+            .encode_utf16()
+            .chain(std::iter::once(0))
+            .collect()
+    }
+
+    pub fn post(w: &Wake) -> io::Result<()> {
+        let name = wide_name(w);
+        // SAFETY: `name` is a NUL-terminated UTF-16 string that outlives the call.
+        let handle = unsafe { OpenEventW(EVENT_MODIFY_STATE, 0, name.as_ptr()) };
+        if handle.is_null() {
+            let err = io::Error::last_os_error();
+            // ERROR_FILE_NOT_FOUND: nobody listens.
+            return if err.raw_os_error() == Some(2) {
+                Ok(())
+            } else {
+                Err(err)
+            };
+        }
+        // SAFETY: `handle` is a valid event handle opened above.
+        let ok = unsafe { SetEvent(handle) };
+        let result = if ok == 0 {
+            Err(io::Error::last_os_error())
+        } else {
+            Ok(())
+        };
+        // SAFETY: closing the handle this function opened.
+        unsafe { CloseHandle(handle) };
+        result
+    }
+
+    pub struct Listener(*mut c_void);
+
+    // SAFETY: an event handle may be waited on from any thread.
+    unsafe impl Send for Listener {}
+    unsafe impl Sync for Listener {}
+
+    pub fn listen(w: &Wake) -> io::Result<Listener> {
+        let attrs = crate::peer::owner_only_security_attributes()?;
+        let name = wide_name(w);
+        // SAFETY: the attributes guard and the name outlive the call; an auto-reset event that
+        // starts unsignalled.
+        let handle = unsafe { CreateEventW(attrs.as_ptr(), 0, 0, name.as_ptr()) };
+        if handle.is_null() {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Listener(handle))
+    }
+
+    impl Listener {
+        pub fn wait(&self, timeout: Duration) -> io::Result<bool> {
+            let millis = u32::try_from(timeout.as_millis()).unwrap_or(u32::MAX - 1);
+            // SAFETY: `self.0` is a valid event handle until drop.
+            match unsafe { WaitForSingleObject(self.0, millis) } {
+                WAIT_OBJECT_0 => Ok(true),
+                WAIT_TIMEOUT => Ok(false),
+                _ => Err(io::Error::last_os_error()),
+            }
+        }
+    }
+
+    impl Drop for Listener {
+        fn drop(&mut self) {
+            // SAFETY: closing the handle this value owns.
+            unsafe { CloseHandle(self.0) };
+        }
+    }
+}

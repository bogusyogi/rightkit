+    calls: BTreeMap<u64, (String, String, String)>,
+    pub(crate) usage: Usage,
+    /// Set by the caller once an event reached the consumer.
+    pub(crate) delivered: bool,
+    /// The `[DONE]` sentinel was seen; set by the caller.
+    pub(crate) done: bool,

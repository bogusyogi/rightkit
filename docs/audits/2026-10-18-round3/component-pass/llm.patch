+        assert!(matches!(
+            store.install(&signed(&catalogue(4)), &v),
+            Err(CapabilityError::Stale {
+                installed: 5,
+                offered: 4
+            })
+        ));
+        assert_eq!(store.load(&v).unwrap().catalogue.version, 5);
+        let _ = fs::remove_dir_all(&dir);
+    }
+
+    #[test]

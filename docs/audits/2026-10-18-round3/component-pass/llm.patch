+    /// the size is one of `sizes`, the output format one of `output_formats`, a URL result is
+    /// offered in `formats`, and the count is in range.
+    pub fn check(&self, req: &ImageRequest) -> Result<(), LlmError> {
+        check_request(req)?;
+        if req.model != self.model {
+            return Err(LlmError::InvalidRequest(format!(
+                "route {} serves model {}, not {}",
+                self.id, self.model, req.model
+            )));
+        }
+        if let Some(size) = &req.size {
+            let size: ImageSize = size.parse()?;
+            if !self.sizes.contains(&size) {
+                return Err(LlmError::InvalidRequest(format!(
+                    "route {} does not accept size {size}",
+                    self.id
+                )));
+            }
+        }
+        if let Some(format) = req.output_format {
+            if !self.output_formats.contains(&format) {
+                return Err(LlmError::InvalidRequest(format!(
+                    "route {} does not accept output format {}",
+                    self.id,
+                    format.as_str()
+                )));
+            }
+        }
+        let wanted = if req.want_url { "url" } else { "b64_json" };
+        if !self.formats.is_empty() && !self.formats.iter().any(|f| f == wanted) {
+            return Err(LlmError::InvalidRequest(format!(
+                "route {} does not return {wanted}",
+                self.id
+            )));
+        }
+        Ok(())
+    }

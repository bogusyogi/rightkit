+    /// The provider that owns exactly this endpoint, or `None`. The match is on the whole
+    /// normalized URL (scheme and host lower-cased, trailing `/` removed, no query or fragment
+    /// accepted): a custom URL, or one that only starts with a catalogued endpoint, resolves to
+    /// nothing, so a text-provider key is never sent there by mistake.
+    pub fn provider_for_base_url(&self, base_url: &str) -> Option<&str> {
+        let wanted = normalize_base_url(base_url)?;
+        self.routes
+            .iter()
+            .filter_map(|r| Some((r.provider.as_deref()?, normalize_base_url(r.base_url.as_deref()?)?)))
+            .find(|(_, url)| *url == wanted)
+            .map(|(provider, _)| provider)
+    }
+}
+
+/// `scheme://host[:port]/path` with scheme and host lower-cased and trailing `/` removed.
+/// `None` for a URL with a query, a fragment, userinfo, or no `http(s)` scheme.
+fn normalize_base_url(raw: &str) -> Option<String> {
+    let raw = raw.trim();
+    if raw.contains(['?', '#', '@']) {
+        return None;
+    }
+    let (scheme, rest) = raw.split_once("://")?;
+    let scheme = scheme.to_ascii_lowercase();
+    if scheme != "http" && scheme != "https" {
+        return None;
+    }
+    let (host, path) = match rest.find('/') {
+        Some(i) => (&rest[..i], &rest[i..]),
+        None => (rest, ""),
+    };
+    if host.is_empty() {
+        return None;
+    }
+    Some(format!(
+        "{scheme}://{}{}",
+        host.to_ascii_lowercase(),
+        path.trim_end_matches('/')
+    ))
+}

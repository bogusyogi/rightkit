diff --git a/crates/rightkit-llm/tests/stream_policy.rs b/crates/rightkit-llm/tests/stream_policy.rs
new file mode 100644
index 0000000..64f6901
--- /dev/null
+++ b/crates/rightkit-llm/tests/stream_policy.rs
@@ -0,0 +1,328 @@
+//! Stream policy (Orthic-Labs/rightkit#657), per-attempt observation (#658) and the
+//! Responses provider (#665) against the loopback mock server.
+
+use std::ops::ControlFlow;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use rightkit_http::testing::{MockResponse, MockServer};
+use rightkit_http::{Client, ClientConfig, RetryPolicy};
+use rightkit_llm::anthropic::AnthropicProvider;
+use rightkit_llm::attempts::{AttemptEvent, AttemptLadder, ObservedProvider, SubmissionReceipt};
+use rightkit_llm::credentials::StaticCredentials;
+use rightkit_llm::openai::OpenAiCompatProvider;
+use rightkit_llm::responses::{OpenAiResponsesProvider, ResponsesVariant};
+use rightkit_llm::{
+    ChatRequest, IncompleteCause, LlmError, Provider, StopReason, StreamEvent, StreamPolicy,
+};
+use serde_json::json;
+
+fn client() -> Client {
+    Client::new(ClientConfig {
+        retry: RetryPolicy::none(),
+        ..rightkit_http::testing::loopback_config()
+    })
+}
+
+fn creds(id: &str) -> Arc<StaticCredentials> {
+    Arc::new(StaticCredentials::default().with(id, "test-secret"))
+}
+
+fn data(v: serde_json::Value) -> String {
+    format!("data: {v}\n\n")
+}
+
+fn chunk(text: &str, finish: Option<&str>) -> String {
+    data(json!({"id": "c", "model": "m",
+        "choices": [{"delta": {"content": text}, "finish_reason": finish}]}))
+}
+
+fn chunks(parts: Vec<(u64, String)>) -> MockResponse {
+    MockResponse::new(200)
+        .header("Content-Type", "text/event-stream")
+        .chunks(
+            parts
+                .into_iter()
+                .map(|(ms, s)| (Duration::from_millis(ms), s.into_bytes()))
+                .collect(),
+        )
+}
+
+fn drain(p: &dyn Provider, req: &ChatRequest) -> (String, Result<rightkit_llm::ChatResponse, LlmError>) {
+    let mut text = String::new();
+    let r = p.stream(req, &mut |e| {
+        if let StreamEvent::Text(t) = e {
+            text.push_str(&t);
+        }
+        ControlFlow::Continue(())
+    });
+    (text, r)
+}
+
+#[test]
+fn a_cut_stream_is_an_error_with_the_partial_when_a_finish_is_required() {
+    let server = MockServer::start(|_, _| chunks(vec![(0, chunk("par", None)), (0, chunk("tial", None))]));
+    let provider =
+        OpenAiCompatProvider::new("openai", &server.base_url(), client(), creds("openai"))
+            .with_stream_policy(StreamPolicy::new().require_finish());
+    let (text, result) = drain(&provider, &ChatRequest::simple("m", "", "u"));
+    assert_eq!(text, "partial");
+    match result {
+        Err(LlmError::IncompleteOutput { cause, partial }) => {
+            assert_eq!(cause, IncompleteCause::MissingFinish);
+            assert_eq!(partial.text, "partial");
+        }
+        other => panic!("expected IncompleteOutput, got {other:?}"),
+    }
+}
+
+#[test]
+fn without_a_policy_a_cut_stream_keeps_its_old_error() {
+    let server = MockServer::start(|_, _| chunks(vec![(0, chunk("par", None))]));
+    let provider =
+        OpenAiCompatProvider::new("openai", &server.base_url(), client(), creds("openai"));
+    let (_, result) = drain(&provider, &ChatRequest::simple("m", "", "u"));
+    assert!(matches!(result, Err(LlmError::MidStream(_))), "got {result:?}");
+}
+
+#[test]
+fn an_event_cut_off_mid_frame_is_unterminated_under_require_finish() {
+    // The last frame has no blank line, so the SSE decoder is inside an event at EOF.
+    let server = MockServer::start(|_, _| {
+        chunks(vec![
+            (0, chunk("hi", None)),
+            (0, "data: {\"id\":\"c\"".to_string()),
+        ])
+    });
+    let provider =
+        OpenAiCompatProvider::new("openai", &server.base_url(), client(), creds("openai"))
+            .with_stream_policy(StreamPolicy::new().require_finish());
+    let (_, result) = drain(&provider, &ChatRequest::simple("m", "", "u"));
+    assert!(
+        matches!(
+            result,
+            Err(LlmError::IncompleteOutput {
+                cause: IncompleteCause::UnterminatedFrame,
+                ..
+            })
+        ),
+        "got {result:?}"
+    );
+}
+
+#[test]
+fn keep_alive_frames_do_not_count_as_semantic_progress() {
+    // After the first text, only keep-alive frames arrive; the second one comes after the limit.
+    let server = MockServer::start(|_, _| {
+        chunks(vec![
+            (0, chunk("a", None)),
+            (30, data(json!({"id": "c", "choices": []}))),
+            (120, data(json!({"id": "c", "choices": []}))),
+            (0, chunk("b", Some("stop"))),
+        ])
+    });
+    let provider =
+        OpenAiCompatProvider::new("openai", &server.base_url(), client(), creds("openai"))
+            .with_stream_policy(
+                StreamPolicy::new().with_semantic_progress(Duration::from_millis(80)),
+            );
+    let (text, result) = drain(&provider, &ChatRequest::simple("m", "", "u"));
+    assert_eq!(text, "a");
+    match result {
+        Err(LlmError::IncompleteOutput { cause, partial }) => {
+            assert!(matches!(cause, IncompleteCause::NoSemanticProgress { .. }));
+            assert_eq!(partial.text, "a");
+        }
+        other => panic!("expected IncompleteOutput, got {other:?}"),
+    }
+}
+
+#[test]
+fn anthropic_ping_frames_do_not_reset_the_semantic_clock() {
+    let ping = "event: ping\ndata: {\"type\":\"ping\"}\n\n".to_string();
+    let start = "event: message_start\ndata: {\"type\":\"message_start\",\"message\":{\"id\":\"m\",\"model\":\"x\",\"usage\":{\"input_tokens\":4}}}\n\n".to_string();
+    let server = MockServer::start(move |_, _| {
+        chunks(vec![(0, start.clone()), (120, ping.clone()), (0, ping.clone())])
+    });
+    let provider = AnthropicProvider::new(&server.base_url(), client(), creds("anthropic"))
+        .with_stream_policy(StreamPolicy::new().with_semantic_progress(Duration::from_millis(60)));
+    let (_, result) = drain(&provider, &ChatRequest::simple("x", "", "u"));
+    match result {
+        Err(LlmError::IncompleteOutput { cause, partial }) => {
+            assert!(matches!(cause, IncompleteCause::NoSemanticProgress { .. }));
+            // The usage frame arrived, so the partial output reports it.
+            assert!(partial.usage_known);
+            assert_eq!(partial.usage.input_tokens, 4);
+        }
+        other => panic!("expected IncompleteOutput, got {other:?}"),
+    }
+}
+
+#[test]
+fn a_complete_stream_passes_the_strictest_policy() {
+    let server = MockServer::start(|_, _| {
+        chunks(vec![
+            (0, chunk("ok", Some("stop"))),
+            (0, "data: [DONE]\n\n".to_string()),
+        ])
+    });
+    let provider =
+        OpenAiCompatProvider::new("openai", &server.base_url(), client(), creds("openai"))
+            .with_stream_policy(
+                StreamPolicy::new()
+                    .require_finish()
+                    .with_idle(Duration::from_secs(5))
+                    .with_semantic_progress(Duration::from_secs(5)),
+            );
+    let (text, result) = drain(&provider, &ChatRequest::simple("m", "", "u"));
+    assert_eq!(text, "ok");
+    assert_eq!(result.unwrap().text(), "ok");
+}
+
+#[test]
+fn retry_after_is_kept_on_the_status_error() {
+    let server = MockServer::start(|_, _| MockResponse::text(429, "slow down").header("Retry-After", "7"));
+    let plain = OpenAiCompatProvider::new("openai", &server.base_url(), client(), creds("openai"));
+    let err = plain
+        .complete(&ChatRequest::simple("m", "", "u"))
+        .unwrap_err();
+    assert_eq!(err.retry_after(), Some(Duration::from_secs(7)));
+    assert!(err.is_failover_trigger());
+}
+
+#[test]
+fn the_ladder_honours_retry_after_and_reports_receipts() {
+    let server = MockServer::start(|_, n| {
+        if n == 0 {
+            MockResponse::text(429, "slow down").header("Retry-After", "7")
+        } else {
+            MockResponse::json(
+                200,
+                &json!({"id": "c", "model": "m",
+                    "choices": [{"message": {"content": "fine"}, "finish_reason": "stop"}]}),
+            )
+        }
+    });
+    let waits = Arc::new(Mutex::new(Vec::new()));
+    let events = Arc::new(Mutex::new(Vec::new()));
+    let (w, e) = (waits.clone(), events.clone());
+    let observed = ObservedProvider::new(
+        OpenAiCompatProvider::new("openai", &server.base_url(), client(), creds("openai")),
+        AttemptLadder::default(),
+    )
+    .with_sleeper(move |d| w.lock().unwrap().push(d))
+    .on_attempt(move |ev| e.lock().unwrap().push(ev.clone()));
+    let r = observed
+        .complete(&ChatRequest::simple("m", "", "u"))
+        .unwrap();
+    assert_eq!(r.text(), "fine");
+    assert_eq!(*waits.lock().unwrap(), [Duration::from_secs(7)]);
+    let receipts: Vec<SubmissionReceipt> = events
+        .lock()
+        .unwrap()
+        .iter()
+        .filter_map(|ev| match ev {
+            AttemptEvent::Attempt(a) => Some(a.receipt),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(
+        receipts,
+        [SubmissionReceipt::Rejected, SubmissionReceipt::Submitted]
+    );
+    assert_eq!(server.request_count(), 2);
+}
+
+#[test]
+fn responses_provider_completes_and_streams() {
+    let server = MockServer::start(|req, _| {
+        let body = req.body_json();
+        assert_eq!(req.path(), "/responses");
+        assert_eq!(body["input"][0]["role"], "user");
+        if body["stream"] == json!(true) {
+            let ev = |kind: &str, v: serde_json::Value| {
+                let mut v = v;
+                v["type"] = json!(kind);
+                format!("event: {kind}\ndata: {v}\n\n")
+            };
+            chunks(vec![
+                (0, ev("response.created", json!({"response": {"id": "r1", "model": "m"}}))),
+                (
+                    0,
+                    ev(
+                        "response.output_item.added",
+                        json!({"output_index": 0, "item": {"type": "message"}}),
+                    ),
+                ),
+                (
+                    0,
+                    ev(
+                        "response.output_text.delta",
+                        json!({"output_index": 0, "delta": "Hi"}),
+                    ),
+                ),
+                (
+                    0,
+                    ev(
+                        "response.completed",
+                        json!({"response": {"id": "r1", "model": "m", "status": "completed",
+                            "usage": {"input_tokens": 3, "output_tokens": 1}}}),
+                    ),
+                ),
+            ])
+        } else {
+            MockResponse::json(
+                200,
+                &json!({"id": "r1", "model": "m", "status": "completed",
+                    "output": [{"type": "message",
+                        "content": [{"type": "output_text", "text": "Hi"}]}],
+                    "usage": {"input_tokens": 3, "output_tokens": 1}}),
+            )
+        }
+    });
+    let provider = OpenAiResponsesProvider::new(
+        "openai",
+        &server.base_url(),
+        ResponsesVariant::OpenAi,
+        client(),
+        creds("openai"),
+    )
+    .with_stream_policy(StreamPolicy::new().require_finish());
+    let req = ChatRequest::simple("m", "sys", "hello");
+    let r = provider.complete(&req).unwrap();
+    assert_eq!(r.text(), "Hi");
+    assert_eq!(r.stop_reason, StopReason::EndTurn);
+    assert_eq!(r.usage.input_tokens, 3);
+
+    let (text, result) = drain(&provider, &req);
+    assert_eq!(text, "Hi");
+    assert_eq!(result.unwrap().usage.output_tokens, 1);
+}
+
+#[test]
+fn codex_variant_posts_to_its_path_and_always_streams() {
+    let server = MockServer::start(|req, _| {
+        assert_eq!(req.path(), "/codex/responses");
+        let body = req.body_json();
+        assert_eq!(body["stream"], true);
+        assert_eq!(body["store"], false);
+        let done = json!({"type": "response.completed",
+            "response": {"id": "r2", "model": "m", "status": "completed",
+                "output": [{"type": "message",
+                    "content": [{"type": "output_text", "text": "from final object"}]}]}});
+        let frame = format!("event: response.completed\ndata: {done}\n\n");
+        MockResponse::sse(&[frame.as_str()])
+    });
+    let provider = OpenAiResponsesProvider::new(
+        "chatgpt",
+        &server.base_url(),
+        ResponsesVariant::ChatGptCodex,
+        client(),
+        creds("chatgpt"),
+    );
+    // `complete` aggregates the stream; text that never streamed is read from the final object.
+    let r = provider
+        .complete(&ChatRequest::simple("m", "", "hello"))
+        .unwrap();
+    assert_eq!(r.text(), "from final object");
+}

+        let e2 = events.clone();
+        let c = chain(
+            Scripted::new("a", vec![Err(status(503, "busy"))], &calls),
+            Scripted::new("b", vec![Ok(ok("from b"))], &calls),
+        )
+        .on_failover(move |e| e2.lock().unwrap().push(e.clone()));
+        let r = c.complete(&ChatRequest::simple("x", "", "hi")).await.unwrap();
+        assert_eq!(r.text(), "from b");

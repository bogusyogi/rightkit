+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::types::{ContentBlock, StopReason};
+    use std::sync::atomic::AtomicUsize;
+
+    /// Answers each call with the next scripted text and counts the calls.
+    struct Scripted {
+        texts: Mutex<Vec<String>>,
+        calls: AtomicUsize,
+        usage: Usage,
+    }
+
+    impl Scripted {
+        fn new(texts: &[&str]) -> Self {
+            Self {
+                texts: Mutex::new(texts.iter().rev().map(|t| (*t).to_owned()).collect()),
+                calls: AtomicUsize::new(0),
+                usage: Usage {
+                    input_tokens: 10,
+                    output_tokens: 5,
+                    ..Usage::default()
+                },
+            }
+        }
+        fn calls(&self) -> usize {
+            self.calls.load(Ordering::SeqCst)
+        }
+    }
+
+    impl Provider for Scripted {
+        fn id(&self) -> &str {
+            "scripted"
+        }
+        fn complete(&self, req: &ChatRequest) -> Result<ChatResponse, LlmError> {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            let text = self.texts.lock().unwrap().pop().expect("scripted answer");
+            Ok(ChatResponse {
+                id: "r".into(),
+                model: req.model.clone(),
+                content: vec![ContentBlock::text(text)],
+                stop_reason: StopReason::EndTurn,
+                usage: self.usage,
+                usage_known: true,
+                metering: Metering::PerToken,
+            })
+        }
+        fn stream(
+            &self,
+            _: &ChatRequest,
+            _: &mut dyn FnMut(crate::types::StreamEvent) -> std::ops::ControlFlow<()>,
+        ) -> Result<ChatResponse, LlmError> {
+            unreachable!("the executor does not stream")
+        }
+    }
+
+    fn ask(id: &str, prompt: &'static str) -> Box<dyn Step> {
+        Box::new(ModelStep::new(id, move |_| {
+            Ok(ChatRequest::simple("m", "", prompt))
+        }))
+    }
+
+    fn two_step_plan() -> SkillPlan {
+        SkillPlan::new(
+            "plan",
+            vec![
+                ask("outline", "outline"),
+                Box::new(ModelStep::new("draft", |cx| {
+                    let outline = cx.outputs()["outline"]["text"].as_str().unwrap().to_owned();
+                    Ok(ChatRequest::simple("m", "", &format!("draft from {outline}")))
+                })),
+            ],
+        )
+    }
+
+    #[test]
+    fn runs_to_completion_passing_outputs_forward() {
+        let p = Scripted::new(&["O", "D"]);
+        let store = MemoryCheckpointStore::new();
+        let r = SkillRunner::new(&p, &store)
+            .start(&two_step_plan(), "run1", "base1")
+            .unwrap();
+        assert!(r.is_complete());
+        assert_eq!(r.outputs["draft"]["text"], "D");
+        assert_eq!(r.spent.calls, 2);
+        assert_eq!(r.spent.input_tokens, 20);
+        // Starting the same run again is refused; resuming a completed run just reports it.
+        let runner = SkillRunner::new(&p, &store);
+        assert!(matches!(
+            runner.start(&two_step_plan(), "run1", "base1"),
+            Err(SkillError::RunExists(_))
+        ));
+        assert!(runner
+            .resume(&two_step_plan(), "run1", "base1")
+            .unwrap()
+            .is_complete());
+        assert_eq!(p.calls(), 2);
+    }
+
+    #[test]
+    fn a_stale_base_is_refused_before_any_step_runs() {
+        let p = Scripted::new(&["O", "D"]);
+        let store = MemoryCheckpointStore::new();
+        let cancel = Arc::new(AtomicBool::new(true));
+        let runner = SkillRunner::new(&p, &store).with_cancel(cancel);
+        let r = runner.start(&two_step_plan(), "run1", "base1").unwrap();
+        assert_eq!(r.status, RunStatus::Interrupted);
+        assert!(matches!(
+            runner.resume(&two_step_plan(), "run1", "base2"),
+            Err(SkillError::StaleBase { .. })
+        ));
+        assert_eq!(p.calls(), 0);
+    }
+
+    #[test]
+    fn interrupt_then_resume_matches_an_uninterrupted_run() {
+        let p = Scripted::new(&["O", "D"]);
+        let store = MemoryCheckpointStore::new();
+        let cancel = Arc::new(AtomicBool::new(false));
+        // Stop after the first step by flipping the flag from inside it.
+        let flag = cancel.clone();
+        let plan = SkillPlan::new(
+            "plan",
+            vec![
+                Box::new(FnStep::new("outline", move |cx| {
+                    let r = cx.call(&ChatRequest::simple("m", "", "outline"))?;
+                    flag.store(true, Ordering::SeqCst);
+                    Ok(StepResult::Done(json!({"text": r.text()})))
+                })) as Box<dyn Step>,
+                Box::new(ModelStep::new("draft", |cx| {
+                    let o = cx.outputs()["outline"]["text"].as_str().unwrap().to_owned();
+                    Ok(ChatRequest::simple("m", "", &format!("draft from {o}")))
+                })),
+            ],
+        );
+        let runner = SkillRunner::new(&p, &store).with_cancel(cancel.clone());
+        let first = runner.start(&plan, "r", "b").unwrap();
+        assert_eq!(first.status, RunStatus::Interrupted);
+        assert_eq!(first.outputs["outline"]["text"], "O");
+        assert!(!first.outputs.contains_key("draft"));
+        cancel.store(false, Ordering::SeqCst);
+        let done = runner.resume(&plan, "r", "b").unwrap();
+        assert!(done.is_complete());
+        assert_eq!(done.outputs["draft"]["text"], "D");
+        assert_eq!(p.calls(), 2);
+    }
+
+    #[test]
+    fn a_crash_after_dispatch_is_unresolved_for_paid_steps_and_never_replayed_silently() {
+        let p = Scripted::new(&["O", "D"]);
+        let store = MemoryCheckpointStore::new();
+        // Simulate the crash: a saved state whose first step is Dispatched.
+        let plan = two_step_plan();
+        let mut state = RunState {
+            version: STATE_VERSION,
+            run_id: "r".into(),
+            plan_id: "plan".into(),
+            base: "b".into(),
+            status: RunStatus::Running,
+            steps: ["outline", "draft"]
+                .iter()
+                .map(|id| StepRecord {
+                    id: (*id).into(),
+                    phase: StepPhase::Pending,
+                    attempts: 0,
+                    progress: None,
+                    defects: vec![],
+                    output: None,
+                })
+                .collect(),
+            spent: Spent::default(),
+        };
+        state.steps[0].phase = StepPhase::Dispatched;
+        state.steps[0].attempts = 1;
+        store.save(&state).unwrap();
+        let runner = SkillRunner::new(&p, &store);
+        let r = runner.resume(&plan, "r", "b").unwrap();
+        assert_eq!(r.status, RunStatus::Unresolved("outline".into()));
+        assert_eq!(p.calls(), 0);
+        // The host saw that the first call never happened: replay it.
+        let r = runner
+            .resolve(&plan, "r", "b", Resolution::Replay)
+            .unwrap();
+        assert!(r.is_complete());
+        assert_eq!(p.calls(), 2);
+    }

+//! Per-request authorization and subscription sign-in (Orthic-Labs/rightkit#583).
+//!
+//! A [`crate::credentials::CredentialSource`] answers "what is the key for this provider": one
+//! secret, sent as the provider's API-key header. A subscription route (a signed-in account, not
+//! a key) needs more: a short-lived token that is refreshed, an `Authorization: Bearer` header,
+//! and vendor headers that go with it. [`RequestAuth`] is that seam. Attach one with
+//! `with_request_auth` on [`crate::openai::OpenAiCompatProvider`],
+//! [`crate::anthropic::AnthropicProvider`], [`crate::responses::OpenAiResponsesProvider`] or the
+//! async providers; it replaces the provider's `CredentialSource` for that provider, and it is
+//! asked again on every call so a refreshed token takes effect at once.
+//!
+//! - [`CredentialAuth`] builds the headers from any `CredentialSource` (bearer plus fixed vendor
+//!   headers). It needs no feature.
+//! - `SubscriptionAuth` (feature `oauth`) is a [`CredentialAuth`] over a
+//!   `rightkit_oauth::credentials::Resolver`: it reads the stored sign-in, refreshes it under the
+//!   resolver's cross-process lock, runs an `Eligibility` check, and starts a device-code
+//!   sign-in (`SubscriptionAuth::sign_in_device`). Loopback PKCE sign-in is the resolver's own
+//!   client (`resolver().client().begin_loopback(..)`), and the result is stored with
+//!   `SubscriptionAuth::save`. `CredentialStore` is `rightkit_oauth::TokenStore`: the host
+//!   chooses where the tokens live (`SecretTokenStore` for the OS credential store, or its own).
+//!
+//! Token values never appear in `Debug` or `Display` output.
+
+use std::fmt;
+use std::sync::Arc;
+
+use rightkit_http::{Request, Secret};
+
+use crate::credentials::CredentialSource;
+use crate::error::LlmError;
+
+/// What a call is about to do, passed to [`RequestAuth::headers`] and [`Eligibility::check`].
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ResolveRequest {
+    /// Provider id of the route (the id its `CredentialSource` would be asked for).
+    pub provider: String,
+    /// The model the call names, when the caller knows it.
+    pub model: Option<String>,
+}
+
+impl ResolveRequest {
+    pub fn new(provider: impl Into<String>) -> Self {
+        Self {
+            provider: provider.into(),
+            model: None,
+        }
+    }
+
+    pub fn with_model(mut self, model: impl Into<String>) -> Self {
+        self.model = Some(model.into());
+        self
+    }
+}
+
+/// One header to put on a request.
+#[derive(Clone)]
+pub enum RequestHeader {
+    /// `Authorization: Bearer <token>`. The token is redacted from logs and error text.
+    Bearer(Secret),
+    /// A header whose value is a secret (for example `x-api-key`), redacted like the bearer.
+    Secret { name: String, value: Secret },
+    /// An ordinary header (vendor version or beta flags).
+    Plain { name: String, value: String },
+}
+
+impl fmt::Debug for RequestHeader {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            RequestHeader::Bearer(_) => f.write_str("Bearer([redacted])"),
+            RequestHeader::Secret { name, .. } => write!(f, "Secret({name}: [redacted])"),
+            RequestHeader::Plain { name, value } => write!(f, "Plain({name}: {value})"),
+        }
+    }
+}
+
+impl RequestHeader {
+    /// Put this header on `req`; returns the request and the secret text it added, if any, so
+    /// error text from the provider can have it removed.
+    pub(crate) fn apply(&self, req: Request) -> (Request, Option<String>) {
+        match self {
+            RequestHeader::Bearer(s) => (req.bearer(s.expose()), Some(s.expose().to_owned())),
+            RequestHeader::Secret { name, value } => (
+                req.secret_header(name.as_str(), value.expose()),
+                Some(value.expose().to_owned()),
+            ),
+            RequestHeader::Plain { name, value } => {
+                (req.header(name.as_str(), value.as_str()), None)
+            }
+        }
+    }
+}
+
+/// Apply every header; the secret text of the first secret header is returned for redaction.
+pub(crate) fn apply_all(headers: &[RequestHeader], mut req: Request) -> (Request, Option<String>) {
+    let mut secret = None;
+    for h in headers {
+        let (next, s) = h.apply(req);
+        req = next;
+        if secret.is_none() {
+            secret = s;
+        }
+    }
+    (req, secret)
+}
+
+/// Supplies the authorization headers for one call. Called on every call.
+pub trait RequestAuth: Send + Sync {
+    /// The headers to send. `Err(LlmError::MissingCredential(..))` when the user must sign in.
+    fn headers(&self, req: &ResolveRequest) -> Result<Vec<RequestHeader>, LlmError>;
+}
+
+/// [`RequestAuth`] over a [`CredentialSource`]: `Authorization: Bearer <credential>` plus fixed
+/// vendor headers.
+pub struct CredentialAuth {
+    credentials: Arc<dyn CredentialSource>,
+    vendor_headers: Vec<(String, String)>,
+}
+
+impl CredentialAuth {
+    pub fn new(credentials: Arc<dyn CredentialSource>) -> Self {
+        Self {
+            credentials,
+            vendor_headers: Vec::new(),
+        }
+    }
+
+    /// Add a vendor header sent with every call (for example `anthropic-beta`).
+    pub fn with_header(mut self, name: impl Into<String>, value: impl Into<String>) -> Self {
+        self.vendor_headers.push((name.into(), value.into()));
+        self
+    }
+}
+
+impl fmt::Debug for CredentialAuth {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("CredentialAuth")
+            .field(
+                "vendor_headers",
+                &self
+                    .vendor_headers
+                    .iter()
+                    .map(|(n, _)| n.as_str())
+                    .collect::<Vec<_>>(),
+            )
+            .finish_non_exhaustive()
+    }
+}
+
+impl RequestAuth for CredentialAuth {
+    fn headers(&self, req: &ResolveRequest) -> Result<Vec<RequestHeader>, LlmError> {
+        let secret = self
+            .credentials
+            .credential(&req.provider)?
+            .ok_or_else(|| LlmError::MissingCredential(req.provider.clone()))?;
+        let mut out = vec![RequestHeader::Bearer(secret)];
+        out.extend(
+            self.vendor_headers
+                .iter()
+                .map(|(name, value)| RequestHeader::Plain {
+                    name: name.clone(),
+                    value: value.clone(),
+                }),
+        );
+        Ok(out)
+    }
+}
+
+#[cfg(feature = "oauth")]
+pub use subscription::*;
+
+#[cfg(feature = "oauth")]
+mod subscription {
+    use super::*;
+    use rightkit_oauth::credentials::{Resolution, Resolver};
+    use rightkit_oauth::{DeviceAuthorization, DeviceWait, OAuthError, TokenSet};
+
+    /// The place tokens are stored: `rightkit_oauth::TokenStore`.
+    pub use rightkit_oauth::TokenStore as CredentialStore;
+
+    /// Decides whether a signed-in account may use a route (for example a plan or seat check).
+    /// Runs on every resolve, after the token is found and before it is used.
+    pub trait Eligibility: Send + Sync {
+        /// `Ok(())` to allow; `Err(reason)` to refuse. The reason is shown to the user and must
+        /// not contain the token.
+        fn check(&self, req: &ResolveRequest, token: &Secret) -> Result<(), String>;
+    }
+
+    /// Why a subscription token could not be produced.
+    #[derive(Debug)]
+    #[non_exhaustive]
+    pub enum AuthError {
+        /// No usable stored sign-in; the app should offer sign-in (`device` says whether the
+        /// provider supports device-code sign-in).
+        NeedsSignIn { device: bool },
+        /// The account is signed in but may not use this route.
+        NotEligible(String),
+        /// Sign-in, refresh or storage failed.
+        OAuth(OAuthError),
+    }
+
+    impl fmt::Display for AuthError {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            match self {
+                AuthError::NeedsSignIn { .. } => f.write_str("sign-in required"),
+                AuthError::NotEligible(r) => write!(f, "account is not eligible: {r}"),
+                AuthError::OAuth(e) => write!(f, "{e}"),
+            }
+        }
+    }
+
+    impl std::error::Error for AuthError {}
+
+    impl From<OAuthError> for AuthError {
+        fn from(e: OAuthError) -> Self {
+            AuthError::OAuth(e)
+        }
+    }
+
+    /// A subscription sign-in for one provider, usable as a [`CredentialSource`] and as a
+    /// [`RequestAuth`].
+    pub struct SubscriptionAuth {
+        provider: String,
+        resolver: Resolver,
+        vendor_headers: Vec<(String, String)>,
+        eligibility: Option<Arc<dyn Eligibility>>,
+    }
+
+    impl fmt::Debug for SubscriptionAuth {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.debug_struct("SubscriptionAuth")
+                .field("provider", &self.provider)
+                .field("resolver", &self.resolver)
+                .finish_non_exhaustive()
+        }
+    }
+
+    impl SubscriptionAuth {
+        /// `provider` is the id of the route this sign-in serves.
+        pub fn new(provider: impl Into<String>, resolver: Resolver) -> Self {
+            Self {
+                provider: provider.into(),
+                resolver,
+                vendor_headers: Vec::new(),
+                eligibility: None,
+            }
+        }
+
+        /// Add a vendor header sent with every call (for example a Copilot editor version).
+        pub fn with_header(mut self, name: impl Into<String>, value: impl Into<String>) -> Self {
+            self.vendor_headers.push((name.into(), value.into()));
+            self
+        }
+
+        pub fn with_eligibility(mut self, check: Arc<dyn Eligibility>) -> Self {
+            self.eligibility = Some(check);
+            self
+        }
+
+        /// The underlying resolver, for loopback sign-in (`resolver().client()`) and sign-out.
+        pub fn resolver(&self) -> &Resolver {
+            &self.resolver
+        }
+
+        /// A usable access token: the stored one, refreshed when it is near expiry. Never
+        /// interactive. [`AuthError::NeedsSignIn`] when the app must offer sign-in.
+        pub fn resolve(&self, req: &ResolveRequest) -> Result<Secret, AuthError> {
+            match self.resolver.resolve()? {
+                Resolution::Token { token, .. } => {
+                    if let Some(check) = &self.eligibility {
+                        check
+                            .check(req, &token)
+                            .map_err(AuthError::NotEligible)?;
+                    }
+                    Ok(token)
+                }
+                Resolution::NeedsSignIn { device } => Err(AuthError::NeedsSignIn { device }),
+            }
+        }
+
+        /// Device-code sign-in (interactive: only when the app asks). `show` receives the code
+        /// and page to present to the user; the result is stored for this account.
+        pub fn sign_in_device(
+            &self,
+            show: impl FnOnce(&DeviceAuthorization),
+            wait: &DeviceWait,
+        ) -> Result<Secret, AuthError> {
+            Ok(self.resolver.sign_in_device(show, wait)?)
+        }
+
+        /// Store tokens obtained by another flow (for example loopback PKCE).
+        pub fn save(&self, tokens: &TokenSet) -> Result<(), AuthError> {
+            Ok(self.resolver.save(tokens)?)
+        }
+
+        pub fn sign_out(&self) -> Result<(), AuthError> {
+            Ok(self.resolver.sign_out()?)
+        }
+
+        fn to_llm(&self, e: AuthError) -> LlmError {
+            match e {
+                AuthError::NeedsSignIn { .. } => LlmError::MissingCredential(self.provider.clone()),
+                AuthError::NotEligible(reason) => LlmError::Auth {
+                    status: 403,
+                    message: reason,
+                },
+                AuthError::OAuth(e) => LlmError::Malformed(e.to_string()),
+            }
+        }
+    }
+
+    impl CredentialSource for SubscriptionAuth {
+        fn credential(&self, provider: &str) -> Result<Option<Secret>, LlmError> {
+            match self.resolve(&ResolveRequest::new(provider)) {
+                Ok(token) => Ok(Some(token)),
+                Err(AuthError::NeedsSignIn { .. }) => Ok(None),
+                Err(e) => Err(self.to_llm(e)),
+            }
+        }
+    }
+
+    impl RequestAuth for SubscriptionAuth {
+        fn headers(&self, req: &ResolveRequest) -> Result<Vec<RequestHeader>, LlmError> {
+            let token = self.resolve(req).map_err(|e| self.to_llm(e))?;
+            let mut out = vec![RequestHeader::Bearer(token)];
+            out.extend(
+                self.vendor_headers
+                    .iter()
+                    .map(|(name, value)| RequestHeader::Plain {
+                        name: name.clone(),
+                        value: value.clone(),
+                    }),
+            );
+            Ok(out)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::credentials::StaticCredentials;
+
+    #[test]
+    fn credential_auth_builds_bearer_and_vendor_headers() {
+        let auth = CredentialAuth::new(Arc::new(StaticCredentials::default().with("p", "tok-123")))
+            .with_header("x-vendor", "v1");
+        let headers = auth.headers(&ResolveRequest::new("p")).unwrap();
+        assert_eq!(headers.len(), 2);
+        assert!(matches!(&headers[0], RequestHeader::Bearer(s) if s.expose() == "tok-123"));
+        assert!(matches!(
+            &headers[1],
+            RequestHeader::Plain { name, value } if name == "x-vendor" && value == "v1"
+        ));
+        // The token is not in the Debug output.
+        assert!(!format!("{headers:?}").contains("tok-123"));
+        assert!(matches!(
+            auth.headers(&ResolveRequest::new("other")),
+            Err(LlmError::MissingCredential(p)) if p == "other"
+        ));
+    }
+
+    #[test]
+    fn apply_all_returns_the_secret_for_redaction() {
+        let headers = vec![
+            RequestHeader::Plain {
+                name: "x-a".into(),
+                value: "1".into(),
+            },
+            RequestHeader::Bearer(Secret::new("tok-9")),
+        ];
+        let (_req, secret) = apply_all(&headers, Request::get("http://localhost/x"));
+        assert_eq!(secret.as_deref(), Some("tok-9"));
+    }
+}

+        let mut st = OpenAiStream::default();
+        let req = ChatRequest::simple("m", "", "u");
+        let (ev, progressed) = st
+            .on_data(&chunk(json!({"reasoning_content": "hm"}), None), None)
+            .unwrap();
+        assert!(ev.is_empty() && progressed);
+        let (ev, _) = st
+            .on_data(&chunk(json!({"content": "hi"}), None), None)
+            .unwrap();
+        assert_eq!(ev, vec![StreamEvent::Text("hi".into())]);
+        let call = json!({"tool_calls": [{"index": 0, "id": "t1",
+            "function": {"name": "f", "arguments": "{\"a\":"}}]});
+        st.on_data(&chunk(call, None), None).unwrap();
+        // Not finished yet: the partial output holds everything received.
+        let partial = st.partial();

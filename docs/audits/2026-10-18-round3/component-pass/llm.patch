+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tool_request() -> ChatRequest {
+        let mut r = ChatRequest::new(
+            "gpt-x",
+            vec![
+                Message::user("hi"),
+                Message {
+                    role: Role::Assistant,
+                    content: vec![
+                        ContentBlock::text("calling"),
+                        ContentBlock::ToolUse {
+                            id: "c1".into(),
+                            name: "f".into(),
+                            input: json!({"a": 1}),
+                        },
+                    ],
+                },
+                Message::tool_result("c1", "result", false),
+            ],
+        );
+        r.system = Some("be brief".into());
+        r.tools = vec![ToolSpec::new("f", "does f", json!({"type": "object"})).strict(true)];
+        r
+    }
+
+    #[test]
+    fn body_maps_messages_tools_and_limits() {
+        let b = build_body(&tool_request(), ResponsesVariant::OpenAi, false);
+        assert_eq!(b["instructions"], "be brief");
+        assert_eq!(b["max_output_tokens"], 1024);
+        assert!(b.get("stream").is_none());
+        let input = b["input"].as_array().unwrap();
+        assert_eq!(input[0]["role"], "user");
+        assert_eq!(input[0]["content"][0]["type"], "input_text");
+        assert_eq!(input[1]["role"], "assistant");
+        assert_eq!(input[1]["content"][0]["type"], "output_text");
+        assert_eq!(input[2]["type"], "function_call");
+        assert_eq!(input[2]["call_id"], "c1");
+        assert_eq!(input[2]["arguments"], "{\"a\":1}");
+        assert_eq!(input[3]["type"], "function_call_output");
+        assert_eq!(input[3]["output"], "result");
+        assert_eq!(b["tools"][0]["name"], "f");
+        assert_eq!(b["tools"][0]["strict"], true);
+    }
+
+    #[test]
+    fn codex_variant_streams_stores_nothing_and_omits_limits() {
+        let mut req = ChatRequest::simple("m", "", "u");
+        req.temperature = Some(0.5);
+        let b = build_body(&req, ResponsesVariant::ChatGptCodex, false);
+        assert_eq!(b["stream"], true);
+        assert_eq!(b["store"], false);
+        assert_eq!(b["instructions"], "");
+        assert!(b.get("max_output_tokens").is_none());
+        assert!(b.get("temperature").is_none());
+        assert_eq!(ResponsesVariant::ChatGptCodex.path(), "/codex/responses");
+    }
+
+    #[test]
+    fn schema_and_forced_tool_map_to_text_format_and_tool_choice() {
+        let mut req = ChatRequest::simple("m", "", "u")
+            .with_response_schema(SchemaConstraint::new("out", json!({"type": "object"})));
+        let b = build_body(&req, ResponsesVariant::OpenAi, true);
+        assert_eq!(b["text"]["format"]["type"], "json_schema");
+        assert_eq!(b["stream"], true);
+        req = ChatRequest::simple("m", "", "u");
+        req.tools = vec![ToolSpec::new("f", "d", json!({}))];
+        req.force_tool = Some("f".into());
+        let b = build_body(&req, ResponsesVariant::OpenAi, false);
+        assert_eq!(b["tool_choice"]["name"], "f");
+    }
+
+    #[test]
+    fn parses_text_tool_call_usage_and_stop_reasons() {
+        let v = json!({"id": "r1", "model": "m", "status": "completed",
+            "output": [
+                {"type": "reasoning", "summary": []},
+                {"type": "message", "content": [{"type": "output_text", "text": "hello"}]},
+                {"type": "function_call", "call_id": "c1", "name": "f", "arguments": "{\"x\":2}"}
+            ],
+            "usage": {"input_tokens": 10, "output_tokens": 5,
+                "input_tokens_details": {"cached_tokens": 4}}});
+        let r = parse_response(&v).unwrap();
+        assert_eq!(r.text(), "hello");
+        assert_eq!(r.stop_reason, StopReason::ToolUse);
+        assert_eq!(r.tool_input("f").unwrap()["x"], 2);
+        assert_eq!(r.usage.input_tokens, 6);
+        assert_eq!(r.usage.cache_read_tokens, 4);
+        assert!(r.usage_known);
+
+        let cut = json!({"id": "r", "model": "m", "status": "incomplete",
+            "incomplete_details": {"reason": "max_output_tokens"},
+            "output": [{"type": "message", "content": [{"type": "output_text", "text": "par"}]}]});
+        assert_eq!(parse_response(&cut).unwrap().stop_reason, StopReason::MaxTokens);
+
+        let refused = json!({"id": "r", "model": "m", "status": "completed",
+            "output": [{"type": "message", "content": [{"type": "refusal", "refusal": "no"}]}]});
+        assert!(matches!(
+            parse_response(&refused),
+            Err(LlmError::Refused { message }) if message == "no"
+        ));
+        assert!(parse_response(&json!({"id": "r"})).is_err());
+    }
+
+    fn feed(st: &mut ResponsesStream, kind: &str, data: Value) -> Vec<StreamEvent> {
+        let mut data = data;
+        data["type"] = json!(kind);
+        let (events, _) = st.on_event(kind, &data.to_string(), None).unwrap();
+        if !events.is_empty() {
+            st.delivered = true;
+        }
+        events
+    }
+
+    #[test]
+    fn stream_state_assembles_text_and_tool_calls_in_output_order() {
+        let mut st = ResponsesStream::default();
+        let req = ChatRequest::simple("m", "", "u");
+        feed(
+            &mut st,
+            "response.created",
+            json!({"response": {"id": "r9", "model": "m"}}),
+        );
+        feed(
+            &mut st,
+            "response.output_item.added",
+            json!({"output_index": 0, "item": {"type": "message"}}),
+        );
+        let t = feed(
+            &mut st,
+            "response.output_text.delta",
+            json!({"output_index": 0, "delta": "Hel"}),
+        );
+        assert_eq!(t, vec![StreamEvent::Text("Hel".into())]);
+        feed(
+            &mut st,
+            "response.output_text.delta",
+            json!({"output_index": 0, "delta": "lo"}),
+        );
+        let started = feed(
+            &mut st,
+            "response.output_item.added",
+            json!({"output_index": 1, "item": {"type": "function_call", "call_id": "c1", "name": "f"}}),
+        );
+        assert_eq!(
+            started,
+            vec![StreamEvent::ToolUseStart {
+                id: "c1".into(),
+                name: "f".into()
+            }]
+        );
+        feed(
+            &mut st,
+            "response.function_call_arguments.delta",
+            json!({"output_index": 1, "delta": "{\"a\":"}),
+        );
+        // Mid-stream the partial output holds what arrived.
+        let partial = st.partial();
+        assert_eq!(partial.text, "Hello");
+        assert_eq!(partial.tool_calls[0].arguments, "{\"a\":");
+        assert!(matches!(
+            st.finish(&req, true),
+            Err(LlmError::IncompleteOutput {
+                cause: IncompleteCause::MissingFinish,
+                ..
+            })
+        ));
+        feed(
+            &mut st,
+            "response.output_item.done",
+            json!({"output_index": 1, "item": {"type": "function_call", "call_id": "c1",
+                "name": "f", "arguments": "{\"a\":1}"}}),
+        );
+        feed(
+            &mut st,
+            "response.completed",
+            json!({"response": {"id": "r9", "model": "m", "status": "completed",
+                "usage": {"input_tokens": 7, "output_tokens": 3}}}),
+        );
+        let r = st.finish(&req, true).unwrap();
+        assert_eq!(r.id, "r9");
+        assert_eq!(r.text(), "Hello");
+        assert_eq!(r.tool_input("f").unwrap()["a"], 1);
+        assert_eq!(r.stop_reason, StopReason::ToolUse);
+        assert_eq!(r.usage.output_tokens, 3);
+    }
+
+    #[test]
+    fn failed_and_error_events_are_provider_errors_before_output() {
+        let mut st = ResponsesStream::default();
+        let err = st
+            .on_event(
+                "response.failed",
+                &json!({"type": "response.failed",
+                    "response": {"error": {"code": "server_error", "message": "boom"}}})
+                .to_string(),
+                None,
+            )
+            .unwrap_err();
+        assert!(matches!(err, LlmError::Provider { kind, .. } if kind == "server_error"));
+        st.delivered = true;
+        let err = st
+            .on_event(
+                "error",
+                &json!({"type": "error", "code": "rate_limit", "message": "slow"}).to_string(),
+                None,
+            )
+            .unwrap_err();
+        assert!(matches!(err, LlmError::MidStream(m) if m.contains("slow")));
+    }

diff --git a/crates/rightkit-llm/tests/classify.rs b/crates/rightkit-llm/tests/classify.rs
new file mode 100644
index 0000000..7c7caa4
--- /dev/null
+++ b/crates/rightkit-llm/tests/classify.rs
@@ -0,0 +1,80 @@
+//! The failover classifier hook (Orthic-Labs/rightkit#661) on the blocking chain.
+
+use std::sync::Arc;
+
+use rightkit_http::testing::{MockResponse, MockServer};
+use rightkit_http::{Client, ClientConfig, RetryPolicy};
+use rightkit_llm::credentials::StaticCredentials;
+use rightkit_llm::failover::{FailoverChain, FailoverPolicy, Route};
+use rightkit_llm::openai::OpenAiCompatProvider;
+use rightkit_llm::{ChatRequest, LlmError, Provider};
+use serde_json::json;
+
+fn client() -> Client {
+    Client::new(ClientConfig {
+        retry: RetryPolicy::none(),
+        ..rightkit_http::testing::loopback_config()
+    })
+}
+
+fn provider(server: &MockServer) -> Arc<dyn Provider> {
+    Arc::new(OpenAiCompatProvider::new(
+        "openai",
+        &server.base_url(),
+        client(),
+        Arc::new(StaticCredentials::default().with("openai", "k")),
+    ))
+}
+
+fn good() -> MockServer {
+    MockServer::start(|_, _| {
+        MockResponse::json(
+            200,
+            &json!({"id": "c", "model": "m",
+                "choices": [{"message": {"content": "from b"}, "finish_reason": "stop"}]}),
+        )
+    })
+}
+
+fn chain(a: &MockServer, b: &MockServer) -> FailoverChain {
+    FailoverChain::new(
+        vec![
+            Route::new("a", provider(a), "ma"),
+            Route::new("b", provider(b), "mb"),
+        ],
+        FailoverPolicy::default(),
+    )
+}
+
+#[test]
+fn a_classifier_can_fail_over_on_an_error_the_policy_would_surface() {
+    let a = MockServer::start(|_, _| MockResponse::text(400, "region blocked by policy"));
+    let b = good();
+    let req = ChatRequest::simple("x", "", "hi");
+
+    // A 400 whose text is not an overload is a validation error: the default policy returns it.
+    let err = chain(&a, &b).complete(&req).unwrap_err();
+    assert!(matches!(err, LlmError::Status { status: 400, .. }));
+    assert_eq!(b.request_count(), 0);
+
+    // The classifier recognises the text and moves on.
+    let with_hook = chain(&a, &b).classify(|e| match e {
+        LlmError::Status { message, .. } if message.contains("region") => Some(true),
+        _ => None,
+    });
+    assert_eq!(with_hook.complete(&req).unwrap().text(), "from b");
+    assert_eq!(b.request_count(), 1);
+}
+
+#[test]
+fn a_classifier_can_pin_an_error_to_not_failing_over() {
+    let a = MockServer::start(|_, _| MockResponse::text(503, "authority check failed"));
+    let b = good();
+    let c = chain(&a, &b).classify(|e| match e {
+        LlmError::Status { message, .. } if message.contains("authority") => Some(false),
+        _ => None,
+    });
+    let err = c.complete(&ChatRequest::simple("x", "", "hi")).unwrap_err();
+    assert!(matches!(err, LlmError::Status { status: 503, .. }));
+    assert_eq!(b.request_count(), 0);
+}

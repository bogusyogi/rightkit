+    /// Map a transport error from the SSE reader, honouring the stream policy.
+    pub(crate) fn transport_failure(&self, e: HttpError, policy: StreamPolicy) -> LlmError {
+        if policy.require_finish && stream::is_unterminated_frame(&e) {
+            return self.incomplete(IncompleteCause::UnterminatedFrame);
+        }
+        if let (Some(limit), true) = (policy.idle, stream::is_idle_timeout(&e)) {
+            return self.incomplete(IncompleteCause::Idle { limit });
+        }
+        if self.delivered {

+/// How the host settles an [`RunStatus::Unresolved`] step.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Resolution {
+    /// Run the step again. The host knows the first dispatch had no effect.
+    Replay,
+    /// The step did complete; this is the output the host observed.
+    Complete(Value),
+    /// The step did not complete and the run is over.
+    Fail(String),
+}
+
+/// Where a run ended up after a call.
+#[derive(Debug, Clone, PartialEq)]
+pub struct RunReport {
+    pub run_id: String,
+    pub status: RunStatus,
+    /// Outputs of the completed steps, by step id.
+    pub outputs: BTreeMap<String, Value>,
+    pub spent: Spent,
+}
+
+impl RunReport {
+    /// The state this report was taken from, for logging: `Completed` only when every step is.
+    pub fn is_complete(&self) -> bool {
+        self.status == RunStatus::Completed
+    }
+}
+
+/// Runs a [`SkillPlan`] against a provider, checkpointing at every boundary.
+pub struct SkillRunner<'a> {
+    provider: &'a dyn Provider,
+    store: &'a dyn CheckpointStore,
+    budget: Budget,
+    prices: Option<PriceTable>,
+    cancel: Option<Arc<AtomicBool>>,
+}
+
+impl<'a> SkillRunner<'a> {
+    pub fn new(provider: &'a dyn Provider, store: &'a dyn CheckpointStore) -> Self {
+        Self {
+            provider,
+            store,
+            budget: Budget::default(),
+            prices: None,
+            cancel: None,
+        }
+    }
+
+    pub fn with_budget(mut self, budget: Budget) -> Self {
+        self.budget = budget;
+        self
+    }
+
+    /// Price table for the USD cap and [`Budget::require_price`].
+    pub fn with_prices(mut self, prices: PriceTable) -> Self {
+        self.prices = Some(prices);
+        self
+    }
+
+    /// A flag the host sets to stop the run at the next boundary ([`RunStatus::Interrupted`]).
+    pub fn with_cancel(mut self, cancel: Arc<AtomicBool>) -> Self {
+        self.cancel = Some(cancel);
+        self
+    }
+
+    /// Start a new run from `base` and drive it until it completes or stops.
+    pub fn start(
+        &self,
+        plan: &SkillPlan,
+        run_id: &str,
+        base: &str,
+    ) -> Result<RunReport, SkillError> {
+        plan.check_ids()?;
+        if self.store.load(run_id)?.is_some() {
+            return Err(SkillError::RunExists(run_id.to_owned()));
+        }
+        let state = RunState {
+            version: STATE_VERSION,
+            run_id: run_id.to_owned(),
+            plan_id: plan.id.clone(),
+            base: base.to_owned(),
+            status: RunStatus::Running,
+            steps: plan
+                .steps
+                .iter()
+                .map(|s| StepRecord {
+                    id: s.id().to_owned(),
+                    phase: StepPhase::Pending,
+                    attempts: 0,
+                    progress: None,
+                    defects: Vec::new(),
+                    output: None,
+                })
+                .collect(),
+            spent: Spent::default(),
+        };
+        self.store.save(&state)?;
+        self.drive(plan, state)
+    }
+
+    fn load_checked(
+        &self,
+        plan: &SkillPlan,
+        run_id: &str,
+        base: &str,
+    ) -> Result<RunState, SkillError> {
+        plan.check_ids()?;
+        let state = self
+            .store
+            .load(run_id)?
+            .ok_or_else(|| SkillError::RunMissing(run_id.to_owned()))?;
+        if state.version != STATE_VERSION {
+            return Err(SkillError::PlanMismatch(format!(
+                "saved state has version {}, expected {STATE_VERSION}",
+                state.version
+            )));
+        }
+        if state.base != base {
+            return Err(SkillError::StaleBase {
+                recorded: state.base,
+                offered: base.to_owned(),
+            });
+        }
+        let saved: Vec<&str> = state.steps.iter().map(|s| s.id.as_str()).collect();
+        let wanted: Vec<&str> = plan.steps.iter().map(|s| s.id()).collect();
+        if state.plan_id != plan.id || saved != wanted {
+            return Err(SkillError::PlanMismatch(format!(
+                "saved run is plan '{}' with steps {saved:?}",
+                state.plan_id
+            )));
+        }
+        Ok(state)
+    }
+
+    /// Continue a stopped run. Fails with [`SkillError::StaleBase`] when `base` differs from
+    /// the one the run started from. A completed run returns its report; a failed run and an
+    /// unresolved run return their status (use [`SkillRunner::resolve`] for the latter).
+    pub fn resume(
+        &self,
+        plan: &SkillPlan,
+        run_id: &str,
+        base: &str,
+    ) -> Result<RunReport, SkillError> {
+        let mut state = self.load_checked(plan, run_id, base)?;
+        match state.status {
+            RunStatus::Completed | RunStatus::Failed { .. } | RunStatus::Unresolved(_) => {
+                return Ok(report(&state));
+            }
+            _ => {}
+        }
+        state.status = RunStatus::Running;
+        self.drive(plan, state)
+    }
+
+    /// Settle an [`RunStatus::Unresolved`] step and continue the run.
+    pub fn resolve(
+        &self,
+        plan: &SkillPlan,
+        run_id: &str,
+        base: &str,
+        resolution: Resolution,
+    ) -> Result<RunReport, SkillError> {
+        let mut state = self.load_checked(plan, run_id, base)?;
+        let RunStatus::Unresolved(step_id) = state.status.clone() else {
+            return Err(SkillError::BadStatus(format!(
+                "run '{run_id}' has no unresolved step"
+            )));
+        };
+        let rec = state
+            .steps
+            .iter_mut()
+            .find(|s| s.id == step_id)
+            .ok_or_else(|| SkillError::PlanMismatch(format!("no step '{step_id}'")))?;
+        match resolution {
+            Resolution::Replay => {
+                rec.phase = StepPhase::Pending;
+                state.status = RunStatus::Running;
+            }
+            Resolution::Complete(output) => {
+                rec.phase = StepPhase::Completed;
+                rec.output = Some(output);
+                rec.progress = None;
+                state.status = RunStatus::Running;
+            }
+            Resolution::Fail(reason) => {
+                rec.phase = StepPhase::Failed(reason.clone());
+                state.status = RunStatus::Failed {
+                    step: step_id,
+                    reason,
+                };
+                self.store.save(&state)?;
+                return Ok(report(&state));
+            }
+        }
+        self.store.save(&state)?;
+        self.drive(plan, state)
+    }
+
+    fn cancelled(&self) -> bool {
+        self.cancel
+            .as_ref()
+            .is_some_and(|c| c.load(Ordering::SeqCst))
+    }
+
+    fn drive(&self, plan: &SkillPlan, mut state: RunState) -> Result<RunReport, SkillError> {
+        let ledger = Ledger {
+            budget: &self.budget,
+            prices: self.prices.as_ref(),
+            spent: Mutex::new(state.spent.clone()),
+        };
+        for (idx, step) in plan.steps.iter().enumerate() {
+            match state.steps[idx].phase.clone() {
+                StepPhase::Completed => continue,
+                StepPhase::Failed(reason) => {
+                    state.status = RunStatus::Failed {
+                        step: step.id().to_owned(),
+                        reason,
+                    };
+                    self.store.save(&state)?;
+                    return Ok(report(&state));
+                }
+                StepPhase::Dispatched if step.effect() != Effect::Pure => {
+                    state.status = RunStatus::Unresolved(step.id().to_owned());
+                    self.store.save(&state)?;
+                    return Ok(report(&state));
+                }
+                StepPhase::Dispatched | StepPhase::Pending => {}
+            }
+            loop {
+                if self.cancelled() {
+                    state.status = RunStatus::Interrupted;
+                    state.spent = ledger.snapshot();
+                    self.store.save(&state)?;
+                    return Ok(report(&state));
+                }
+                // The dispatch record is durable before the step runs.
+                {
+                    let rec = &mut state.steps[idx];
+                    rec.phase = StepPhase::Dispatched;
+                    rec.attempts += 1;
+                }
+                state.spent = ledger.snapshot();
+                self.store.save(&state)?;
+
+                let outputs: BTreeMap<String, Value> = state
+                    .steps
+                    .iter()
+                    .filter_map(|r| Some((r.id.clone(), r.output.clone()?)))
+                    .collect();
+                let rec_snapshot = state.steps[idx].clone();
+                let cx = StepContext {
+                    run_id: &state.run_id,
+                    outputs: &outputs,
+                    progress: rec_snapshot.progress.as_ref(),
+                    defects: &rec_snapshot.defects,
+                    attempt: rec_snapshot.attempts,
+                    provider: self.provider,
+                    ledger: &ledger,
+                };
+                let result = step.run(&cx);
+                state.spent = ledger.snapshot();
+                let rec = &mut state.steps[idx];
+                match result {
+                    Ok(StepResult::Done(v)) => {
+                        rec.phase = StepPhase::Completed;
+                        rec.output = Some(v);
+                        rec.progress = None;
+                        rec.defects.clear();
+                        self.store.save(&state)?;
+                        break;
+                    }
+                    Ok(StepResult::Continue(p)) => {
+                        rec.phase = StepPhase::Pending;
+                        rec.progress = Some(p);
+                        rec.defects.clear();
+                        rec.attempts = 0;
+                        self.store.save(&state)?;
+                    }
+                    Ok(StepResult::Retry(defects)) => {
+                        if rec.attempts >= step.max_attempts() {
+                            let reason = format!(
+                                "repair ceiling of {} attempts reached: {}",
+                                step.max_attempts(),
+                                defects.join("; ")
+                            );
+                            rec.phase = StepPhase::Failed(reason.clone());
+                            rec.defects = defects;
+                            state.status = RunStatus::Failed {
+                                step: step.id().to_owned(),
+                                reason,
+                            };
+                            self.store.save(&state)?;
+                            return Ok(report(&state));
+                        }
+                        rec.phase = StepPhase::Pending;
+                        rec.defects = defects;
+                        self.store.save(&state)?;
+                    }
+                    Err(e @ (SkillError::BudgetStop(_) | SkillError::Unpriced { .. })) => {
+                        // Nothing was sent for the refused call: the step is pending again.
+                        rec.phase = StepPhase::Pending;
+                        rec.attempts = rec.attempts.saturating_sub(1);
+                        state.status = RunStatus::BudgetStopped(e.to_string());
+                        self.store.save(&state)?;
+                        return Ok(report(&state));
+                    }
+                    Err(e) => {
+                        let reason = e.to_string();
+                        rec.phase = StepPhase::Failed(reason.clone());
+                        state.status = RunStatus::Failed {
+                            step: step.id().to_owned(),
+                            reason,
+                        };
+                        self.store.save(&state)?;
+                        return Ok(report(&state));
+                    }
+                }
+            }
+        }
+        state.status = RunStatus::Completed;
+        self.store.save(&state)?;
+        Ok(report(&state))
+    }
+}
+
+fn report(state: &RunState) -> RunReport {
+    RunReport {
+        run_id: state.run_id.clone(),
+        status: state.status.clone(),
+        outputs: state
+            .steps
+            .iter()
+            .filter_map(|r| Some((r.id.clone(), r.output.clone()?)))
+            .collect(),
+        spent: state.spent.clone(),
+    }
+}

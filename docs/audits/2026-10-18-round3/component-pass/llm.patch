index 0000000..376def5
--- /dev/null
+++ b/crates/rightkit-llm/src/responses.rs
@@ -0,0 +1,1061 @@
+//! OpenAI Responses API provider (Orthic-Labs/rightkit#665): `POST {base}/responses` and the
+//! ChatGPT-OAuth variant `POST {base}/codex/responses`.
+//!
+//! The Responses API takes a list of input items instead of chat messages. This module maps a
+//! [`ChatRequest`] onto it:
+//!
+//! | `Message` content | input item |
+//! | --- | --- |
+//! | user text, image | `{"role":"user","content":[{"type":"input_text"},{"type":"input_image"}]}` |
+//! | assistant text | `{"role":"assistant","content":[{"type":"output_text"}]}` |
+//! | `ToolUse` | `{"type":"function_call","call_id","name","arguments"}` |
+//! | `ToolResult` | `{"type":"function_call_output","call_id","output"}` |
+//!
+//! `ChatRequest::system` becomes `instructions`, `max_tokens` becomes `max_output_tokens`, tools
+//! become flat `{"type":"function","name",...}` entries, `force_tool` becomes `tool_choice`, and a
+//! response schema becomes `text.format` (`json_schema`). The answer maps back to
+//! [`ChatResponse`]: `message` items to text, `function_call` items to [`ContentBlock::ToolUse`],
+//! `reasoning` items are not surfaced (their text is kept in the streamed
+//! [`crate::stream::PartialOutput::reasoning`]), `status: incomplete` with
+//! `max_output_tokens` to [`StopReason::MaxTokens`], and a refusal to [`LlmError::Refused`].
+//!
+//! # Variants
+//!
+//! [`ResponsesVariant::OpenAi`] is the public API (`/responses`, non-streaming or streaming).
+//! [`ResponsesVariant::ChatGptCodex`] is the ChatGPT-OAuth backend (`/codex/responses`): it
+//! always streams, so `complete` runs a stream and aggregates it; it sends `store: false` and
+//! an `instructions` string (empty when the request has no system prompt), and leaves out
+//! `max_output_tokens` and `temperature`.
+//!
+//! UNVERIFIED: the Codex variant's required and refused fields and its account headers
+//! (`chatgpt-account-id`, `OpenAI-Beta`, `originator`) follow CodeRight's client as the issue
+//! describes it. They were not checked against the live endpoint here. Account headers are the
+//! host's to add, from its sign-in, with [`OpenAiResponsesProvider::with_request_auth`] or
+//! [`OpenAiResponsesProvider::with_header`].
+//!
+//! The streamed `response.*` events are decoded by a state machine ([`ResponsesStream`]) that the
+//! async provider shares.
+
+use std::collections::BTreeMap;
+use std::ops::ControlFlow;
+use std::sync::Arc;
+use std::time::Instant;
+
+use rightkit_http::{Client, EofPolicy, HttpError, Request};
+use serde_json::{json, Map, Value};
+
+use crate::auth::{RequestAuth, ResolveRequest};
+use crate::credentials::CredentialSource;
+use crate::error::LlmError;
+use crate::provider::Provider;
+use crate::stream::{
+    self, IncompleteCause, PartialOutput, PartialToolCall, ProgressClock, StreamPolicy,
+};
+use crate::types::*;
+
+/// Which Responses endpoint a provider talks to.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum ResponsesVariant {
+    /// `{base}/responses`: the public API.
+    #[default]
+    OpenAi,
+    /// `{base}/codex/responses`: the ChatGPT-OAuth backend. Always streams.
+    ChatGptCodex,
+}
+
+impl ResponsesVariant {
+    pub(crate) fn path(self) -> &'static str {
+        match self {
+            ResponsesVariant::OpenAi => "/responses",
+            ResponsesVariant::ChatGptCodex => "/codex/responses",
+        }
+    }
+}
+
+/// Build the request body. `stream` is forced on for [`ResponsesVariant::ChatGptCodex`].
+pub fn build_body(req: &ChatRequest, variant: ResponsesVariant, stream: bool) -> Value {
+    let codex = variant == ResponsesVariant::ChatGptCodex;
+    let mut body = Map::new();
+    body.insert("model".into(), json!(req.model));
+    match &req.system {
+        Some(s) => {
+            body.insert("instructions".into(), json!(s));
+        }
+        None if codex => {
+            body.insert("instructions".into(), json!(""));
+        }
+        None => {}
+    }
+    let mut input: Vec<Value> = Vec::new();
+    for m in &req.messages {
+        push_items(&mut input, m, req.keep_empty_messages);
+    }
+    body.insert("input".into(), Value::Array(input));
+    if !codex {
+        if !req.omit_max_tokens {
+            body.insert("max_output_tokens".into(), json!(req.max_tokens));
+        }
+        if let Some(t) = req.temperature {
+            body.insert("temperature".into(), f32_json(t));
+        }
+    } else {
+        body.insert("store".into(), json!(false));
+    }
+    if !req.tools.is_empty() {
+        let tools: Vec<Value> = req
+            .tools
+            .iter()
+            .map(|t| {
+                let mut tool = json!({"type": "function", "name": t.name,
+                    "description": t.description, "parameters": t.input_schema});
+                if t.strict {
+                    tool["strict"] = json!(true);
+                }
+                tool
+            })
+            .collect();
+        body.insert("tools".into(), Value::Array(tools));
+        if let Some(name) = &req.force_tool {
+            body.insert(
+                "tool_choice".into(),
+                json!({"type": "function", "name": name}),
+            );
+        }
+    }
+    if let Some(s) = req.response_schema() {
+        body.insert(
+            "text".into(),
+            json!({"format": {"type": "json_schema", "name": s.name,
+                "schema": s.schema, "strict": s.strict}}),
+        );
+    }
+    if stream || codex {
+        body.insert("stream".into(), json!(true));
+    }
+    Value::Object(body)
+}
+
+fn push_items(out: &mut Vec<Value>, m: &Message, keep_empty: bool) {
+    match m.role {
+        Role::User => {
+            let mut parts: Vec<Value> = Vec::new();
+            let mut results: Vec<Value> = Vec::new();
+            for b in &m.content {
+                match b {
+                    ContentBlock::Text { text } if !text.is_empty() => {
+                        parts.push(json!({"type": "input_text", "text": text}));
+                    }
+                    ContentBlock::Image { source } => {
+                        parts.push(
+                            json!({"type": "input_image", "image_url": source.openai_url()}),
+                        );
+                    }
+                    ContentBlock::ToolResult {
+                        tool_use_id,
+                        content,
+                        ..
+                    } => results.push(json!({"type": "function_call_output",
+                        "call_id": tool_use_id, "output": content})),
+                    _ => {}
+                }
+            }
+            // Tool outputs answer the preceding function calls, so they come first.
+            out.extend(results.iter().cloned());
+            if !parts.is_empty() {
+                out.push(json!({"role": "user", "content": parts}));
+            } else if keep_empty && results.is_empty() {
+                out.push(json!({"role": "user", "content": [{"type": "input_text", "text": ""}]}));
+            }
+        }
+        Role::Assistant => {
+            let mut text = String::new();
+            let mut calls: Vec<Value> = Vec::new();
+            for b in &m.content {
+                match b {
+                    ContentBlock::Text { text: t } => text.push_str(t),
+                    ContentBlock::ToolUse { id, name, input } => calls.push(json!({
+                        "type": "function_call", "call_id": id, "name": name,
+                        "arguments": input.to_string()})),
+                    _ => {}
+                }
+            }
+            if !text.is_empty() {
+                out.push(json!({"role": "assistant",
+                    "content": [{"type": "output_text", "text": text}]}));
+            }
+            out.extend(calls);
+        }
+    }
+}
+
+fn parse_usage(u: &Value) -> Usage {
+    let n = |v: &Value| v.as_u64().unwrap_or(0);
+    let input = n(&u["input_tokens"]);
+    let cached = n(&u["input_tokens_details"]["cached_tokens"]);
+    Usage {
+        input_tokens: input.saturating_sub(cached),
+        output_tokens: n(&u["output_tokens"]),
+        cache_read_tokens: cached,
+        cache_write_tokens: 0,
+    }
+}
+
+fn tool_input(args: &str) -> Result<Value, LlmError> {
+    if args.trim().is_empty() {
+        return Ok(json!({}));
+    }
+    serde_json::from_str(args).map_err(|e| LlmError::Malformed(format!("tool arguments JSON: {e}")))
+}
+
+/// Parse a complete response object (the non-streaming body, or `response` of
+/// `response.completed`).
+pub fn parse_response(v: &Value) -> Result<ChatResponse, LlmError> {
+    if let Some(err) = v.get("error").filter(|e| !e.is_null()) {
+        return Err(LlmError::Provider {
+            kind: err["code"].as_str().unwrap_or("error").into(),
+            message: err["message"].as_str().unwrap_or("response failed").into(),
+        });
+    }
+    let output = v
+        .get("output")
+        .and_then(Value::as_array)
+        .ok_or_else(|| LlmError::Malformed("missing output array".into()))?;
+    let mut content = Vec::new();
+    let mut refusal: Option<String> = None;
+    for item in output {
+        match item["type"].as_str() {
+            Some("message") => {
+                for part in item["content"].as_array().into_iter().flatten() {
+                    match part["type"].as_str() {
+                        Some("output_text") => {
+                            if let Some(t) = part["text"].as_str().filter(|t| !t.is_empty()) {
+                                content.push(ContentBlock::text(t));
+                            }
+                        }
+                        Some("refusal") => {
+                            refusal = Some(part["refusal"].as_str().unwrap_or_default().into());
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            Some("function_call") => content.push(ContentBlock::ToolUse {
+                id: item["call_id"].as_str().unwrap_or_default().into(),
+                name: item["name"].as_str().unwrap_or_default().into(),
+                input: tool_input(item["arguments"].as_str().unwrap_or(""))?,
+            }),
+            _ => {}
+        }
+    }
+    if content.is_empty() {
+        if let Some(message) = refusal {
+            return Err(LlmError::Refused { message });
+        }
+    }
+    let has_tool = content
+        .iter()
+        .any(|b| matches!(b, ContentBlock::ToolUse { .. }));
+    let incomplete = v["status"].as_str() == Some("incomplete");
+    let reason = v["incomplete_details"]["reason"].as_str();
+    let stop_reason = if has_tool {
+        StopReason::ToolUse
+    } else if incomplete && reason == Some("max_output_tokens") {
+        StopReason::MaxTokens
+    } else if incomplete && reason == Some("content_filter") {
+        return Err(LlmError::Refused {
+            message: "incomplete: content_filter".into(),
+        });
+    } else if incomplete {
+        StopReason::Other(reason.unwrap_or("incomplete").to_owned())
+    } else {
+        StopReason::EndTurn
+    };
+    Ok(ChatResponse {
+        id: v["id"].as_str().unwrap_or_default().into(),
+        model: v["model"].as_str().unwrap_or_default().into(),
+        content,
+        stop_reason,
+        usage: v.get("usage").map(parse_usage).unwrap_or_default(),
+        usage_known: v.get("usage").is_some_and(|u| !u.is_null()),
+        metering: Metering::PerToken,
+    })
+}
+
+#[derive(Debug)]
+enum Slot {
+    Text(String),
+    Call {
+        call_id: String,
+        name: String,
+        args: String,
+    },
+    Other,
+}
+
+/// The state of one streamed Responses answer: feed it each SSE event with
+/// [`ResponsesStream::on_event`], then call [`ResponsesStream::finish`]. Shared by the blocking
+/// and the async provider.
+#[derive(Default)]
+pub(crate) struct ResponsesStream {
+    id: String,
+    model: String,
+    slots: BTreeMap<u64, Slot>,
+    reasoning: String,
+    pub(crate) usage: Usage,
+    usage_seen: bool,
+    status: Option<String>,
+    incomplete_reason: Option<String>,
+    /// `response.completed` or `response.incomplete` arrived.
+    pub(crate) done: bool,
+    /// The final `response` object, when one arrived.
+    final_response: Option<Value>,
+    pub(crate) delivered: bool,
+}
+
+impl ResponsesStream {
+    fn fail(&self, m: String) -> LlmError {
+        if self.delivered {
+            LlmError::MidStream(m)
+        } else {
+            LlmError::Http(HttpError::Stream(m))
+        }
+    }
+
+    pub(crate) fn partial(&self) -> PartialOutput {
+        let mut out = PartialOutput {
+            reasoning: self.reasoning.clone(),
+            usage: self.usage,
+            usage_known: self.usage_seen,
+            ..PartialOutput::default()
+        };
+        for slot in self.slots.values() {
+            match slot {
+                Slot::Text(t) => out.text.push_str(t),
+                Slot::Call {
+                    call_id,
+                    name,
+                    args,
+                } => out.tool_calls.push(PartialToolCall {
+                    id: call_id.clone(),
+                    name: name.clone(),
+                    arguments: args.clone(),
+                }),
+                Slot::Other => {}
+            }
+        }
+        out
+    }
+
+    pub(crate) fn incomplete(&self, cause: IncompleteCause) -> LlmError {
+        LlmError::IncompleteOutput {
+            cause,
+            partial: Box::new(self.partial()),
+        }
+    }
+
+    pub(crate) fn transport_failure(&self, e: HttpError, policy: StreamPolicy) -> LlmError {
+        if policy.require_finish && stream::is_unterminated_frame(&e) {
+            return self.incomplete(IncompleteCause::UnterminatedFrame);
+        }
+        if let (Some(limit), true) = (policy.idle, stream::is_idle_timeout(&e)) {
+            return self.incomplete(IncompleteCause::Idle { limit });
+        }
+        if self.delivered {
+            LlmError::MidStream(e.to_string())
+        } else {
+            LlmError::Http(e)
+        }
+    }
+
+    /// Apply one SSE event. `name` is the SSE event name (used when the data has no `type`).
+    /// Returns the events to deliver and whether it made semantic progress.
+    pub(crate) fn on_event(
+        &mut self,
+        name: &str,
+        data: &str,
+        key: Option<&str>,
+    ) -> Result<(Vec<StreamEvent>, bool), LlmError> {
+        let d: Value = serde_json::from_str(data)
+            .map_err(|e| self.fail(format!("bad SSE JSON: {e}")))?;
+        let kind = d["type"].as_str().unwrap_or(name).to_owned();
+        let index = d["output_index"].as_u64().unwrap_or(0);
+        let mut out = Vec::new();
+        let mut progressed = false;
+        match kind.as_str() {
+            "response.created" | "response.in_progress" => {
+                let r = &d["response"];
+                if let Some(s) = r["id"].as_str() {
+                    self.id = s.into();
+                }
+                if let Some(s) = r["model"].as_str() {
+                    self.model = s.into();
+                }
+            }
+            "response.output_item.added" => {
+                let item = &d["item"];
+                match item["type"].as_str() {
+                    Some("function_call") => {
+                        let call_id = item["call_id"].as_str().unwrap_or_default().to_owned();
+                        let name = item["name"].as_str().unwrap_or_default().to_owned();
+                        out.push(StreamEvent::ToolUseStart {
+                            id: call_id.clone(),
+                            name: name.clone(),
+                        });
+                        let args = item["arguments"].as_str().unwrap_or_default().to_owned();
+                        self.slots.insert(
+                            index,
+                            Slot::Call {
+                                call_id,
+                                name,
+                                args,
+                            },
+                        );
+                    }
+                    Some("message") => {
+                        self.slots.entry(index).or_insert_with(|| Slot::Text(String::new()));
+                    }
+                    _ => {
+                        self.slots.entry(index).or_insert(Slot::Other);
+                    }
+                }
+            }
+            "response.output_text.delta" => {
+                let delta = d["delta"].as_str().unwrap_or_default();
+                if !delta.is_empty() {
+                    match self
+                        .slots
+                        .entry(index)
+                        .or_insert_with(|| Slot::Text(String::new()))
+                    {
+                        Slot::Text(t) => t.push_str(delta),
+                        other => {
+                            *other = Slot::Text(delta.to_owned());
+                        }
+                    }
+                    out.push(StreamEvent::Text(delta.to_owned()));
+                }
+            }
+            "response.function_call_arguments.delta" => {
+                let delta = d["delta"].as_str().unwrap_or_default();
+                if let Some(Slot::Call { call_id, args, .. }) = self.slots.get_mut(&index) {
+                    if !delta.is_empty() {
+                        args.push_str(delta);
+                        out.push(StreamEvent::ToolInputDelta {
+                            id: call_id.clone(),
+                            partial_json: delta.to_owned(),
+                        });
+                    }
+                }
+            }
+            "response.output_item.done" => {
+                let item = &d["item"];
+                if item["type"].as_str() == Some("function_call") {
+                    let final_args = item["arguments"].as_str().unwrap_or_default();
+                    if let Some(Slot::Call {
+                        call_id,
+                        name,
+                        args,
+                    }) = self.slots.get_mut(&index)
+                    {
+                        if !final_args.is_empty() {
+                            *args = final_args.to_owned();
+                        }
+                        if call_id.is_empty() {
+                            *call_id = item["call_id"].as_str().unwrap_or_default().to_owned();
+                        }
+                        if name.is_empty() {
+                            *name = item["name"].as_str().unwrap_or_default().to_owned();
+                        }
+                    }
+                }
+            }
+            "response.reasoning_summary_text.delta" | "response.reasoning_text.delta" => {
+                let delta = d["delta"].as_str().unwrap_or_default();
+                if !delta.is_empty() {
+                    self.reasoning.push_str(delta);
+                    progressed = true;
+                }
+            }
+            "response.completed" | "response.incomplete" => {
+                let r = &d["response"];
+                if let Some(s) = r["id"].as_str() {
+                    self.id = s.into();
+                }
+                if let Some(s) = r["model"].as_str() {
+                    self.model = s.into();
+                }
+                if let Some(u) = r.get("usage").filter(|u| !u.is_null()) {
+                    self.usage = parse_usage(u);
+                    self.usage_seen = true;
+                }
+                self.status = Some(if kind == "response.incomplete" {
+                    "incomplete".to_owned()
+                } else {
+                    "completed".to_owned()
+                });
+                self.incomplete_reason = r["incomplete_details"]["reason"]
+                    .as_str()
+                    .map(str::to_owned);
+                self.final_response = Some(r.clone());
+                self.done = true;
+            }
+            "response.failed" | "error" => {
+                let err = if kind == "error" {
+                    &d
+                } else {
+                    &d["response"]["error"]
+                };
+                let message = crate::error::redact_secret(
+                    err["message"].as_str().unwrap_or("response failed"),
+                    key,
+                );
+                let code = crate::error::redact_secret(
+                    err["code"].as_str().or(err["type"].as_str()).unwrap_or("error"),
+                    key,
+                );
+                return Err(if self.delivered {
+                    LlmError::MidStream(format!("{code}: {message}"))
+                } else {
+                    LlmError::Provider {
+                        kind: code,
+                        message,
+                    }
+                });
+            }
+            _ => {}
+        }
+        progressed |= !out.is_empty();
+        Ok((out, progressed))
+    }
+
+    /// Build the final response. Without `response.completed` or `response.incomplete` the
+    /// stream is [`LlmError::IncompleteOutput`] when `require_finish` is set, else a plain
+    /// stream error.
+    pub(crate) fn finish(
+        &mut self,
+        req: &ChatRequest,
+        require_finish: bool,
+    ) -> Result<ChatResponse, LlmError> {
+        if !self.done {
+            if require_finish {
+                return Err(self.incomplete(IncompleteCause::MissingFinish));
+            }
+            return Err(self.fail("stream ended before response.completed".into()));
+        }
+        let mut content = Vec::new();
+        for (_, slot) in std::mem::take(&mut self.slots) {
+            match slot {
+                Slot::Text(t) if !t.is_empty() => content.push(ContentBlock::text(t)),
+                Slot::Call {
+                    call_id,
+                    name,
+                    args,
+                } => content.push(ContentBlock::ToolUse {
+                    id: call_id,
+                    name,
+                    input: tool_input(&args)?,
+                }),
+                _ => {}
+            }
+        }
+        if content.is_empty() {
+            // Items that never streamed (a non-delta answer): read them from the final object.
+            if let Some(r) = &self.final_response {
+                if let Ok(parsed) = parse_response(r) {
+                    content = parsed.content;
+                }
+            }
+        }
+        let has_tool = content
+            .iter()
+            .any(|b| matches!(b, ContentBlock::ToolUse { .. }));
+        let incomplete = self.status.as_deref() == Some("incomplete");
+        let stop_reason = if has_tool {
+            StopReason::ToolUse
+        } else if incomplete && self.incomplete_reason.as_deref() == Some("max_output_tokens") {
+            StopReason::MaxTokens
+        } else if incomplete {
+            StopReason::Other(
+                self.incomplete_reason
+                    .clone()
+                    .unwrap_or_else(|| "incomplete".into()),
+            )
+        } else {
+            StopReason::EndTurn
+        };
+        check_output(
+            ChatResponse {
+                id: std::mem::take(&mut self.id),
+                model: std::mem::take(&mut self.model),
+                content,
+                stop_reason,
+                usage: self.usage,
+                usage_known: self.usage_seen,
+                metering: Metering::PerToken,
+            },
+            req,
+        )
+    }
+}
+
+/// OpenAI Responses API client (blocking). See the module docs.
+pub struct OpenAiResponsesProvider {
+    id: String,
+    base_url: String,
+    variant: ResponsesVariant,
+    client: Client,
+    credentials: Arc<dyn CredentialSource>,
+    requires_credential: bool,
+    extra_headers: Vec<(String, String)>,
+    observer: Option<CallObserver>,
+    stream_policy: Option<StreamPolicy>,
+    request_auth: Option<Arc<dyn RequestAuth>>,
+}
+
+impl OpenAiResponsesProvider {
+    pub fn new(
+        id: &str,
+        base_url: &str,
+        variant: ResponsesVariant,
+        client: Client,
+        credentials: Arc<dyn CredentialSource>,
+    ) -> Self {
+        Self {
+            id: id.into(),
+            base_url: base_url.trim_end_matches('/').to_string(),
+            variant,
+            client,
+            credentials,
+            requires_credential: true,
+            extra_headers: Vec::new(),
+            observer: None,
+            stream_policy: None,
+            request_auth: None,
+        }
+    }
+
+    pub fn without_credential(mut self) -> Self {
+        self.requires_credential = false;
+        self
+    }
+
+    pub fn with_header(mut self, name: &str, value: &str) -> Self {
+        self.extra_headers.push((name.into(), value.into()));
+        self
+    }
+
+    /// Report every call that reaches the network. See [`CallRecord`].
+    pub fn with_observer(mut self, f: impl Fn(&CallRecord<'_>) + Send + Sync + 'static) -> Self {
+        self.observer = Some(Arc::new(f));
+        self
+    }
+
+    /// Apply `policy` to every stream. See [`StreamPolicy`].
+    pub fn with_stream_policy(mut self, policy: StreamPolicy) -> Self {
+        self.stream_policy = Some(policy);
+        self
+    }
+
+    /// Authorize every call with `auth` instead of the `CredentialSource` (the ChatGPT sign-in
+    /// token and account headers). See [`crate::auth`].
+    pub fn with_request_auth(mut self, auth: Arc<dyn RequestAuth>) -> Self {
+        self.request_auth = Some(auth);
+        self
+    }
+
+    fn request(
+        &self,
+        req: &ChatRequest,
+        stream: bool,
+    ) -> Result<(Request, Option<String>, Value), LlmError> {
+        req.check_images()?;
+        req.check_schema()?;
+        let stream = stream || self.variant == ResponsesVariant::ChatGptCodex;
+        let mut body = build_body(req, self.variant, stream);
+        req.extra_body.merge_into(&mut body)?;
+        let http = req.retry.apply(
+            Request::post(format!("{}{}", self.base_url, self.variant.path()))
+                .retry_unsafe_statuses(true)
+                .header(
+                    "Accept",
+                    if stream {
+                        "text/event-stream"
+                    } else {
+                        "application/json"
+                    },
+                ),
+        );
+        let (mut http, secret) = self.authorize(http, &req.model)?;
+        if let Some(limit) = req.timeout {
+            http = http.timeout(limit).deadline(limit);
+        }
+        Ok((http.json(&body)?, secret, body))
+    }
+
+    fn authorize(
+        &self,
+        mut http: Request,
+        model: &str,
+    ) -> Result<(Request, Option<String>), LlmError> {
+        if let Some(auth) = &self.request_auth {
+            let mut resolve = ResolveRequest::new(self.id.clone());
+            resolve.model = Some(model.to_owned());
+            let headers = auth.headers(&resolve)?;
+            let (applied, secret) = crate::auth::apply_all(&headers, http);
+            http = applied;
+            for (k, v) in &self.extra_headers {
+                http = http.header(k.as_str(), v.as_str());
+            }
+            return Ok((http, secret));
+        }
+        let mut secret = None;
+        match self.credentials.credential(&self.id)? {
+            Some(c) => {
+                secret = Some(c.expose().to_string());
+                http = http.bearer(c.expose());
+            }
+            None if self.requires_credential => {
+                return Err(LlmError::MissingCredential(self.id.clone()))
+            }
+            None => {}
+        }
+        for (k, v) in &self.extra_headers {
+            http = http.header(k.as_str(), v.as_str());
+        }
+        Ok((http, secret))
+    }
+
+    fn observe(&self, stream: bool, body: &Value, result: &Result<ChatResponse, LlmError>) {
+        if let Some(observer) = &self.observer {
+            observer(&CallRecord {
+                provider: &self.id,
+                stream,
+                request_body: body,
+                result: result.as_ref(),
+                raw: None,
+            });
+        }
+    }
+
+    fn stream_call(
+        &self,
+        req: &ChatRequest,
+        http: &Request,
+        key: Option<&str>,
+        st: &mut ResponsesStream,
+        on_event: &mut dyn FnMut(StreamEvent) -> ControlFlow<()>,
+    ) -> Result<ChatResponse, LlmError> {
+        let mut clock = ProgressClock::new(self.stream_policy);
+        let response = self
+            .client
+            .stream(http)
+            .map_err(|e| LlmError::from_http(e, key))?;
+        let mut sse = response.sse();
+        if clock.require_finish() {
+            sse = sse.eof_policy(EofPolicy::Fail);
+        }
+        for item in sse {
+            let ev = match item {
+                Ok(ev) => ev,
+                Err(e) => return Err(st.transport_failure(e, clock.policy())),
+            };
+            let now = Instant::now();
+            if let Some(cause) = clock.violation(now) {
+                return Err(st.incomplete(cause));
+            }
+            clock.frame(now);
+            if ev.data.trim() == "[DONE]" {
+                break;
+            }
+            let (events, progressed) = st.on_event(&ev.event, &ev.data, key)?;
+            if progressed {
+                clock.progress(now);
+            }
+            for e in events {
+                st.delivered = true;
+                if on_event(e).is_break() {
+                    return Err(LlmError::Cancelled);
+                }
+            }
+            if st.done {
+                break;
+            }
+        }
+        st.finish(req, clock.require_finish())
+    }
+}
+
+impl std::fmt::Debug for OpenAiResponsesProvider {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("OpenAiResponsesProvider")
+            .field("id", &self.id)
+            .field("base_url", &crate::generation::redact_url(&self.base_url))
+            .field("variant", &self.variant)
+            .finish_non_exhaustive()
+    }
+}
+
+impl Provider for OpenAiResponsesProvider {
+    fn id(&self) -> &str {
+        &self.id
+    }
+
+    fn complete(&self, req: &ChatRequest) -> Result<ChatResponse, LlmError> {
+        if self.variant == ResponsesVariant::ChatGptCodex {
+            // The backend only streams; aggregate it.
+            return self.stream(req, &mut |_| ControlFlow::Continue(()));
+        }
+        let (http, secret, body) = self.request(req, false)?;
+        let result = self
+            .client
+            .send(&http)
+            .map_err(|e| LlmError::from_http(e, secret.as_deref()))
+            .and_then(|resp| {
+                let v: Value = resp
+                    .json()
+                    .map_err(|e| LlmError::Malformed(e.to_string()))?;
+                parse_response(&v)
+            })
+            .and_then(|r| check_output(r, req));
+        self.observe(false, &body, &result);
+        result
+    }
+
+    fn stream(
+        &self,
+        req: &ChatRequest,
+        on_event: &mut dyn FnMut(StreamEvent) -> ControlFlow<()>,
+    ) -> Result<ChatResponse, LlmError> {
+        let (http, secret, body) = self.request(req, true)?;
+        let mut st = ResponsesStream::default();
+        let result = self
+            .stream_call(req, &http, secret.as_deref(), &mut st, on_event)
+            .map_err(|e| {
+                if req.report_failed_usage && st.usage != Usage::default() {
+                    billed(
+                        e,
+                        &AttemptBilling::new(Spend::Reported(st.usage), Metering::PerToken),
+                    )
+                } else {
+                    e
+                }
+            });
+        self.observe(true, &body, &result);
+        result
+    }
+}

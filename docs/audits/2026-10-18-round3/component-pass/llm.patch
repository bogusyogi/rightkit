+#[cfg(feature = "async")]
+pub use async_ladder::AsyncObservedProvider;
+
+#[cfg(feature = "async")]
+mod async_ladder {
+    use std::future::Future;
+    use std::sync::Arc;
+    use std::time::{Duration, Instant};
+
+    use super::{
+        receipt_for, AttemptEvent, AttemptLadder, AttemptObserver, AttemptRecord, Counters,
+        Decision, RetryBudget, SubmissionReceipt,
+    };
+    use crate::async_provider::{AsyncProvider, BoxFuture, EventStream};
+    use crate::error::LlmError;
+    use crate::types::{ChatRequest, ChatResponse};
+
+    /// [`super::ObservedProvider`] for an `AsyncProvider` (feature `async`): the same receipts,
+    /// the same two budgets, waits on the tokio timer. `complete` is retried as a whole. A
+    /// `stream` is retried while it is being opened (a connection or status failure before any
+    /// token); once the stream is open it is returned and its errors are the caller's.
+    pub struct AsyncObservedProvider<P: AsyncProvider> {
+        inner: P,
+        ladder: AttemptLadder,
+        observer: Option<AttemptObserver>,
+    }
+
+    impl<P: AsyncProvider> AsyncObservedProvider<P> {
+        pub fn new(inner: P, ladder: AttemptLadder) -> Self {
+            Self {
+                inner,
+                ladder,
+                observer: None,
+            }
+        }
+
+        /// Report attempts and retry notices to `f`.
+        pub fn on_attempt(mut self, f: impl Fn(&AttemptEvent) + Send + Sync + 'static) -> Self {
+            self.observer = Some(Arc::new(f));
+            self
+        }
+
+        /// The wrapped provider.
+        pub fn inner(&self) -> &P {
+            &self.inner
+        }
+
+        fn emit(&self, event: AttemptEvent) {
+            if let Some(o) = &self.observer {
+                o(&event);
+            }
+        }
+
+        async fn run<T, F, Fut>(&self, req: &ChatRequest, mut call: F) -> Result<T, LlmError>
+        where
+            F: FnMut(ChatRequest) -> Fut,
+            Fut: Future<Output = Result<T, LlmError>>,
+        {
+            let started = Instant::now();
+            let single = req.clone().without_retries();
+            let mut used = Counters {
+                connect: 0,
+                status: 0,
+            };
+            let mut attempt = 0u32;
+            loop {
+                attempt += 1;
+                match call(single.clone()).await {
+                    Ok(v) => {
+                        self.emit(AttemptEvent::Attempt(AttemptRecord {
+                            provider: self.inner.id().to_owned(),
+                            attempt,
+                            receipt: SubmissionReceipt::Submitted,
+                            status: None,
+                            error: None,
+                        }));
+                        return Ok(v);
+                    }
+                    Err(e) => {
+                        self.emit(AttemptEvent::Attempt(AttemptRecord {
+                            provider: self.inner.id().to_owned(),
+                            attempt,
+                            receipt: receipt_for(&e),
+                            status: e.status(),
+                            error: Some(e.to_string()),
+                        }));
+                        let Decision::Retry { budget, delay } = self.ladder.decide(&e, &used)
+                        else {
+                            return Err(e);
+                        };
+                        if let Some(total) = req.timeout {
+                            if started.elapsed().saturating_add(delay) >= total {
+                                return Err(e);
+                            }
+                        }
+                        match budget {
+                            RetryBudget::Connect => used.connect += 1,
+                            RetryBudget::Status => used.status += 1,
+                        }
+                        self.emit(AttemptEvent::RetryScheduled {
+                            provider: self.inner.id().to_owned(),
+                            retry: attempt,
+                            budget,
+                            delay,
+                            reason: e.to_string(),
+                        });
+                        tokio::time::sleep(delay).await;
+                    }
+                }
+            }
+        }
+    }
+
+    impl<P: AsyncProvider> AsyncProvider for AsyncObservedProvider<P> {
+        fn id(&self) -> &str {
+            self.inner.id()
+        }
+
+        fn complete<'a>(
+            &'a self,
+            req: &'a ChatRequest,
+        ) -> BoxFuture<'a, Result<ChatResponse, LlmError>> {
+            Box::pin(self.run(req, move |r| async move { self.inner.complete(&r).await }))
+        }
+
+        fn stream<'a>(
+            &'a self,
+            req: &'a ChatRequest,
+        ) -> BoxFuture<'a, Result<EventStream, LlmError>> {
+            Box::pin(self.run(req, move |r| async move { self.inner.stream(&r).await }))
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        use crate::types::{ContentBlock, Metering, StopReason, Usage};
+        use std::collections::VecDeque;
+        use std::sync::Mutex;
+
+        struct Scripted(Mutex<VecDeque<Result<ChatResponse, LlmError>>>);
+
+        impl AsyncProvider for Scripted {
+            fn id(&self) -> &str {
+                "scripted"
+            }
+            fn complete<'a>(
+                &'a self,
+                req: &'a ChatRequest,
+            ) -> BoxFuture<'a, Result<ChatResponse, LlmError>> {
+                Box::pin(async move {
+                    assert_eq!(req.retry, crate::types::CallRetry::Disabled);
+                    self.0.lock().unwrap().pop_front().expect("scripted")
+                })
+            }
+            fn stream<'a>(
+                &'a self,
+                _: &'a ChatRequest,
+            ) -> BoxFuture<'a, Result<EventStream, LlmError>> {
+                Box::pin(async move { Err(LlmError::Cancelled) })
+            }
+        }
+
+        fn ok() -> ChatResponse {
+            ChatResponse {
+                id: "r".into(),
+                model: "m".into(),
+                content: vec![ContentBlock::text("hi")],
+                stop_reason: StopReason::EndTurn,
+                usage: Usage::default(),
+                usage_known: false,
+                metering: Metering::PerToken,
+            }
+        }
+
+        fn status(s: u16) -> LlmError {
+            LlmError::Status {
+                status: s,
+                message: "x".into(),
+                retry_after: None,
+            }
+        }
+
+        #[tokio::test]
+        async fn retries_a_status_failure_and_reports_each_attempt() {
+            let script = Scripted(Mutex::new(VecDeque::from(vec![
+                Err(status(503)),
+                Ok(ok()),
+            ])));
+            let ladder = AttemptLadder {
+                status_initial_backoff: Duration::ZERO,
+                ..AttemptLadder::default()
+            };
+            let events = Arc::new(Mutex::new(Vec::new()));
+            let e2 = events.clone();
+            let p = AsyncObservedProvider::new(script, ladder)
+                .on_attempt(move |e| e2.lock().unwrap().push(e.clone()));
+            let r = p.complete(&ChatRequest::simple("m", "", "u")).await.unwrap();
+            assert_eq!(r.text(), "hi");
+            let events = events.lock().unwrap();
+            assert_eq!(events.len(), 3);
+            assert!(matches!(
+                &events[0],
+                AttemptEvent::Attempt(AttemptRecord {
+                    receipt: SubmissionReceipt::Rejected,
+                    status: Some(503),
+                    ..
+                })
+            ));
+            assert!(matches!(
+                &events[1],
+                AttemptEvent::RetryScheduled {
+                    budget: RetryBudget::Status,
+                    ..
+                }
+            ));
+            assert!(matches!(
+                &events[2],
+                AttemptEvent::Attempt(AttemptRecord {
+                    receipt: SubmissionReceipt::Submitted,
+                    ..
+                })
+            ));
+        }
+
+        #[tokio::test]
+        async fn an_error_the_ladder_does_not_retry_is_returned() {
+            let script = Scripted(Mutex::new(VecDeque::from(vec![Err(status(401))])));
+            let p = AsyncObservedProvider::new(script, AttemptLadder::default());
+            let err = p
+                .complete(&ChatRequest::simple("m", "", "u"))
+                .await
+                .unwrap_err();
+            assert!(matches!(err, LlmError::Status { status: 401, .. }));
+        }
+    }
+}

+        r.process_delta(0, Some("a"), Some("read"), "{").unwrap();
+        r.process_delta(0, Some("other"), Some("other"), "}").unwrap();
+        let ready = r.drain_ready();
+        assert_eq!(ready.len(), 1);
+        assert_eq!(ready[0].id, "a");
+        assert_eq!(ready[0].name, "read");
+        assert_eq!(ready[0].arguments, "{}");
+    }
 }
diff --git a/crates/rightkit-llm/src/replay.rs b/crates/rightkit-llm/src/replay.rs
new file mode 100644
index 0000000..57641c1
--- /dev/null
+++ b/crates/rightkit-llm/src/replay.rs
@@ -0,0 +1,736 @@
+//! Provider record and replay corpus (Orthic-Labs/rightkit#585).
+//!
+//! [`RecordingProvider`] wraps a real [`Provider`] and appends every call to a JSON Lines
+//! corpus; [`ReplayProvider`] answers the same calls from the corpus, so a test of a provider
+//! client or an engine needs no network and no key.
+//!
+//! - **Opt-in capture.** A [`Recorder`] records only when it is enabled.
+//!   [`Recorder::from_env`] enables it when the named environment variable is `1`; nothing is
+//!   written otherwise.
+//! - **Redaction.** Everything written passes through a [`Redactor`]: exact secret values the
+//!   host registers are replaced by `[redacted]` wherever they appear, and the values of
+//!   credential-looking JSON keys (`authorization`, `api_key`, `token`, ...) are replaced. The
+//!   crate never has the credential itself in a [`ChatRequest`], so request redaction guards
+//!   prompts that echo one.
+//! - **Schema version.** Each line carries `schema` ([`SCHEMA_VERSION`]); a line with another
+//!   schema is [`ReplayError::UnsupportedSchema`], never silently skipped.
+//! - **Freshness limit.** Each line carries `recorded_at` (Unix seconds). A replay refuses a line
+//!   older than the corpus' limit ([`DEFAULT_MAX_AGE_DAYS`] = 90) with [`ReplayError::Stale`],
+//!   so a provider that changed its wire format is not tested against a year-old recording.
+//!
+//! # Where this sits
+//!
+//! The issue asks for a transport-seam hook in `rightkit-http`. That crate has no pluggable
+//! transport, so this module works one level up, at the [`Provider`] seam: a replayed call skips
+//! the whole HTTP layer, including the request builder. A test of request building should
+//! compare the observer's [`crate::CallRecord::request_body`] instead.
+//!
+//! # Matching
+//!
+//! A call is found by a key: the 64-bit FNV-1a hash (hex) of the request's model, system
+//! prompt, messages, tools, forced tool, response schema, `max_tokens`, `temperature` and stop
+//! sequences, as canonical JSON (object keys sorted). Timeouts, retry settings and extra headers
+//! do not change the key. FNV-1a is a lookup key, not a security measure.
+
+use std::fmt;
+use std::fs::OpenOptions;
+use std::io::Write as _;
+use std::ops::ControlFlow;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use serde_json::{json, Value};
+
+use crate::error::LlmError;
+use crate::provider::Provider;
+use crate::types::*;
+
+/// Schema of a corpus line.
+pub const SCHEMA_VERSION: u32 = 1;
+
+/// Oldest entry a replay accepts, in days.
+pub const DEFAULT_MAX_AGE_DAYS: u64 = 90;
+
+const REDACTED: &str = "[redacted]";
+
+/// Replaces secret values in anything written to a corpus.
+#[derive(Debug, Clone)]
+pub struct Redactor {
+    secrets: Vec<String>,
+    keys: Vec<String>,
+}
+
+impl Default for Redactor {
+    fn default() -> Self {
+        Self {
+            secrets: Vec::new(),
+            keys: [
+                "authorization",
+                "proxy-authorization",
+                "api_key",
+                "api-key",
+                "x-api-key",
+                "token",
+                "access_token",
+                "refresh_token",
+                "id_token",
+                "password",
+                "secret",
+                "client_secret",
+            ]
+            .into_iter()
+            .map(str::to_owned)
+            .collect(),
+        }
+    }
+}
+
+impl Redactor {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Replace this exact value wherever it appears. Values shorter than 4 bytes are ignored so
+    /// a short word cannot blank the corpus.
+    pub fn with_secret(mut self, value: impl Into<String>) -> Self {
+        let v = value.into();
+        if v.len() >= 4 {
+            self.secrets.push(v);
+        }
+        self
+    }
+
+    /// Replace the value of this JSON key (case-insensitive), at any depth.
+    pub fn with_key(mut self, key: impl Into<String>) -> Self {
+        self.keys.push(key.into().to_lowercase());
+        self
+    }
+
+    /// `text` with every registered secret replaced.
+    pub fn redact_text(&self, text: &str) -> String {
+        let mut out = text.to_owned();
+        for s in &self.secrets {
+            out = out.replace(s.as_str(), REDACTED);
+        }
+        out
+    }
+
+    /// `value` with credential keys blanked and registered secrets replaced in every string.
+    pub fn redact_value(&self, value: &Value) -> Value {
+        match value {
+            Value::String(s) => Value::String(self.redact_text(s)),
+            Value::Array(a) => Value::Array(a.iter().map(|v| self.redact_value(v)).collect()),
+            Value::Object(o) => Value::Object(
+                o.iter()
+                    .map(|(k, v)| {
+                        if self.keys.contains(&k.to_lowercase()) && !v.is_null() {
+                            (k.clone(), Value::String(REDACTED.into()))
+                        } else {
+                            (k.clone(), self.redact_value(v))
+                        }
+                    })
+                    .collect(),
+            ),
+            other => other.clone(),
+        }
+    }
+}
+
+/// Why a corpus could not be read or a call could not be replayed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum ReplayError {
+    /// The file could not be read or written.
+    Io(String),
+    /// A line is not a corpus entry.
+    Parse { line: usize, message: String },
+    /// A line has a schema this crate does not read.
+    UnsupportedSchema { line: usize, schema: u32 },
+    /// The matching entry is older than the freshness limit.
+    Stale { key: String, age_days: u64 },
+    /// No entry matches the call.
+    Missing { key: String },
+}
+
+impl fmt::Display for ReplayError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            ReplayError::Io(m) => write!(f, "replay corpus file error: {m}"),
+            ReplayError::Parse { line, message } => {
+                write!(f, "replay corpus line {line} unreadable: {message}")
+            }
+            ReplayError::UnsupportedSchema { line, schema } => {
+                write!(f, "replay corpus line {line} has unsupported schema {schema}")
+            }
+            ReplayError::Stale { key, age_days } => write!(
+                f,
+                "recorded answer {key} is {age_days} days old, past the freshness limit; re-record it"
+            ),
+            ReplayError::Missing { key } => write!(f, "no recorded answer for request {key}"),
+        }
+    }
+}
+
+impl std::error::Error for ReplayError {}
+
+impl From<ReplayError> for LlmError {
+    fn from(e: ReplayError) -> Self {
+        LlmError::InvalidRequest(e.to_string())
+    }
+}
+
+fn now_secs() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+/// The JSON a call is keyed on.
+fn request_value(req: &ChatRequest) -> Value {
+    json!({
+        "model": req.model,
+        "system": req.system,
+        "messages": serde_json::to_value(&req.messages).unwrap_or(Value::Null),
+        "tools": serde_json::to_value(&req.tools).unwrap_or(Value::Null),
+        "force_tool": req.force_tool,
+        "response_schema": req.response_schema().map(|s| json!({
+            "name": s.name, "schema": s.schema, "strict": s.strict})),
+        "max_tokens": req.max_tokens,
+        "temperature": req.temperature.map(f32_json),
+        "stop_sequences": req.stop_sequences,
+    })
+}
+
+/// The lookup key of a request. See the module docs.
+pub fn request_key(req: &ChatRequest) -> String {
+    // `serde_json::Value` maps are ordered by key, so this text is canonical.
+    let text = request_value(req).to_string();
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    for b in text.bytes() {
+        hash ^= u64::from(b);
+        hash = hash.wrapping_mul(0x0100_0000_01b3);
+    }
+    format!("{hash:016x}")
+}
+
+fn response_to_value(r: &ChatResponse) -> Value {
+    json!({
+        "id": r.id,
+        "model": r.model,
+        "content": serde_json::to_value(&r.content).unwrap_or(Value::Null),
+        "stop_reason": match &r.stop_reason {
+            StopReason::EndTurn => json!("end_turn"),
+            StopReason::MaxTokens => json!("max_tokens"),
+            StopReason::ToolUse => json!("tool_use"),
+            StopReason::StopSequence => json!("stop_sequence"),
+            StopReason::Other(o) => json!({"other": o}),
+        },
+        "usage": serde_json::to_value(r.usage).unwrap_or(Value::Null),
+        "usage_known": r.usage_known,
+        "subscription": r.metering == Metering::Subscription,
+    })
+}
+
+fn response_from_value(v: &Value) -> Option<ChatResponse> {
+    let stop_reason = match &v["stop_reason"] {
+        Value::String(s) => match s.as_str() {
+            "end_turn" => StopReason::EndTurn,
+            "max_tokens" => StopReason::MaxTokens,
+            "tool_use" => StopReason::ToolUse,
+            "stop_sequence" => StopReason::StopSequence,
+            other => StopReason::Other(other.to_owned()),
+        },
+        o => StopReason::Other(o["other"].as_str()?.to_owned()),
+    };
+    Some(ChatResponse {
+        id: v["id"].as_str()?.to_owned(),
+        model: v["model"].as_str()?.to_owned(),
+        content: serde_json::from_value(v["content"].clone()).ok()?,
+        stop_reason,
+        usage: serde_json::from_value(v["usage"].clone()).ok()?,
+        usage_known: v["usage_known"].as_bool()?,
+        metering: if v["subscription"].as_bool().unwrap_or(false) {
+            Metering::Subscription
+        } else {
+            Metering::PerToken
+        },
+    })
+}
+
+fn error_to_value(e: &LlmError) -> Value {
+    match e.root() {
+        LlmError::Status {
+            status, message, ..
+        } => json!({"kind": "status", "status": status, "message": message}),
+        other => json!({"kind": "other", "message": other.to_string()}),
+    }
+}
+
+fn error_from_value(v: &Value) -> LlmError {
+    let message = v["message"].as_str().unwrap_or("recorded error").to_owned();
+    match (v["kind"].as_str(), v["status"].as_u64()) {
+        (Some("status"), Some(status)) => LlmError::Status {
+            status: status as u16,
+            message,
+            retry_after: None,
+        },
+        _ => LlmError::Provider {
+            kind: "recorded".into(),
+            message,
+        },
+    }
+}
+
+/// Appends calls to a corpus file, when enabled.
+#[derive(Debug)]
+pub struct Recorder {
+    path: PathBuf,
+    enabled: bool,
+    redactor: Redactor,
+    clock: fn() -> u64,
+    write_lock: Mutex<()>,
+}
+
+impl Recorder {
+    /// A recorder that always records to `path`.
+    pub fn new(path: impl Into<PathBuf>) -> Self {
+        Self {
+            path: path.into(),
+            enabled: true,
+            redactor: Redactor::default(),
+            clock: now_secs,
+            write_lock: Mutex::new(()),
+        }
+    }
+
+    /// Opt-in capture: records only when the environment variable `var` is exactly `1`.
+    pub fn from_env(path: impl Into<PathBuf>, var: &str) -> Self {
+        let mut r = Self::new(path);
+        r.enabled = std::env::var(var).is_ok_and(|v| v == "1");
+        r
+    }
+
+    /// A recorder that never writes.
+    pub fn disabled() -> Self {
+        let mut r = Self::new(PathBuf::new());
+        r.enabled = false;
+        r
+    }
+
+    pub fn is_enabled(&self) -> bool {
+        self.enabled
+    }
+
+    pub fn with_redactor(mut self, redactor: Redactor) -> Self {
+        self.redactor = redactor;
+        self
+    }
+
+    /// Replace the clock (Unix seconds), for tests.
+    pub fn with_clock(mut self, clock: fn() -> u64) -> Self {
+        self.clock = clock;
+        self
+    }
+
+    /// Append one call. Does nothing when disabled.
+    pub fn record(
+        &self,
+        provider: &str,
+        req: &ChatRequest,
+        result: &Result<ChatResponse, LlmError>,
+    ) -> Result<(), ReplayError> {
+        if !self.enabled {
+            return Ok(());
+        }
+        let outcome = match result {
+            Ok(r) => json!({"ok": response_to_value(r)}),
+            Err(e) => json!({"err": error_to_value(e)}),
+        };
+        let line = json!({
+            "schema": SCHEMA_VERSION,
+            "recorded_at": (self.clock)(),
+            "provider": provider,
+            "key": request_key(req),
+            "request": request_value(req),
+            "outcome": outcome,
+        });
+        let text = self.redactor.redact_value(&line).to_string();
+        let _guard = self.write_lock.lock().unwrap_or_else(|p| p.into_inner());
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(&self.path)
+            .map_err(|e| ReplayError::Io(e.to_string()))?;
+        writeln!(file, "{text}").map_err(|e| ReplayError::Io(e.to_string()))
+    }
+}
+
+/// A [`Provider`] that forwards to `inner` and records each call.
+pub struct RecordingProvider<P: Provider> {
+    inner: P,
+    recorder: Recorder,
+}
+
+impl<P: Provider> RecordingProvider<P> {
+    pub fn new(inner: P, recorder: Recorder) -> Self {
+        Self { inner, recorder }
+    }
+
+    pub fn inner(&self) -> &P {
+        &self.inner
+    }
+
+    fn record(&self, req: &ChatRequest, result: &Result<ChatResponse, LlmError>) {
+        // A corpus write failure must not change the call's outcome.
+        let _ = self.recorder.record(self.inner.id(), req, result);
+    }
+}
+
+impl<P: Provider> Provider for RecordingProvider<P> {
+    fn id(&self) -> &str {
+        self.inner.id()
+    }
+
+    fn complete(&self, req: &ChatRequest) -> Result<ChatResponse, LlmError> {
+        let result = self.inner.complete(req);
+        self.record(req, &result);
+        result
+    }
+
+    fn stream(
+        &self,
+        req: &ChatRequest,
+        on_event: &mut dyn FnMut(StreamEvent) -> ControlFlow<()>,
+    ) -> Result<ChatResponse, LlmError> {
+        let result = self.inner.stream(req, on_event);
+        self.record(req, &result);
+        result
+    }
+}
+
+#[derive(Debug, Clone)]
+struct Entry {
+    recorded_at: u64,
+    key: String,
+    outcome: Value,
+}
+
+/// A loaded corpus.
+#[derive(Debug, Clone, Default)]
+pub struct Corpus {
+    entries: Vec<Entry>,
+}
+
+impl Corpus {
+    /// Read a JSON Lines corpus. Blank lines are skipped; any other unreadable line fails the
+    /// load with its line number.
+    pub fn load(path: impl AsRef<Path>) -> Result<Self, ReplayError> {
+        let text =
+            std::fs::read_to_string(path).map_err(|e| ReplayError::Io(e.to_string()))?;
+        Self::from_jsonl(&text)
+    }
+
+    pub fn from_jsonl(text: &str) -> Result<Self, ReplayError> {
+        let mut entries = Vec::new();
+        for (i, line) in text.lines().enumerate() {
+            let n = i + 1;
+            if line.trim().is_empty() {
+                continue;
+            }
+            let v: Value = serde_json::from_str(line).map_err(|e| ReplayError::Parse {
+                line: n,
+                message: e.to_string(),
+            })?;
+            let schema = v["schema"].as_u64().unwrap_or(0) as u32;
+            if schema != SCHEMA_VERSION {
+                return Err(ReplayError::UnsupportedSchema { line: n, schema });
+            }
+            let parse = |what: &str| ReplayError::Parse {
+                line: n,
+                message: format!("missing {what}"),
+            };
+            entries.push(Entry {
+                recorded_at: v["recorded_at"].as_u64().ok_or_else(|| parse("recorded_at"))?,
+                key: v["key"].as_str().ok_or_else(|| parse("key"))?.to_owned(),
+                outcome: v.get("outcome").cloned().ok_or_else(|| parse("outcome"))?,
+            });
+        }
+        Ok(Self { entries })
+    }
+
+    pub fn len(&self) -> usize {
+        self.entries.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.entries.is_empty()
+    }
+}
+
+/// A [`Provider`] that answers from a [`Corpus`].
+pub struct ReplayProvider {
+    id: String,
+    corpus: Corpus,
+    max_age_days: u64,
+    clock: Arc<dyn Fn() -> u64 + Send + Sync>,
+    /// Entries already used per key, so repeated identical calls replay in recorded order.
+    used: Mutex<std::collections::HashMap<String, usize>>,
+}
+
+impl ReplayProvider {
+    pub fn new(id: impl Into<String>, corpus: Corpus) -> Self {
+        Self {
+            id: id.into(),
+            corpus,
+            max_age_days: DEFAULT_MAX_AGE_DAYS,
+            clock: Arc::new(now_secs),
+            used: Mutex::new(Default::default()),
+        }
+    }
+
+    /// Change the freshness limit (default [`DEFAULT_MAX_AGE_DAYS`]).
+    pub fn with_max_age_days(mut self, days: u64) -> Self {
+        self.max_age_days = days;
+        self
+    }
+
+    /// Replace the clock (Unix seconds), for tests.
+    pub fn with_clock(mut self, clock: impl Fn() -> u64 + Send + Sync + 'static) -> Self {
+        self.clock = Arc::new(clock);
+        self
+    }
+
+    fn lookup(&self, req: &ChatRequest) -> Result<Result<ChatResponse, LlmError>, ReplayError> {
+        let key = request_key(req);
+        let matching: Vec<&Entry> = self.corpus.entries.iter().filter(|e| e.key == key).collect();
+        if matching.is_empty() {
+            return Err(ReplayError::Missing { key });
+        }
+        let mut used = self.used.lock().unwrap_or_else(|p| p.into_inner());
+        let n = used.entry(key.clone()).or_insert(0);
+        // Repeats replay in order; the last recording answers every further repeat.
+        let entry = matching[(*n).min(matching.len() - 1)];
+        *n += 1;
+        let age_days = (self.clock)().saturating_sub(entry.recorded_at) / 86_400;
+        if age_days > self.max_age_days {
+            return Err(ReplayError::Stale { key, age_days });
+        }
+        if let Some(ok) = entry.outcome.get("ok") {
+            return response_from_value(ok)
+                .map(Ok)
+                .ok_or_else(|| ReplayError::Parse {
+                    line: 0,
+                    message: format!("recorded response {key} is malformed"),
+                });
+        }
+        Ok(Err(error_from_value(&entry.outcome["err"])))
+    }
+}
+
+impl Provider for ReplayProvider {
+    fn id(&self) -> &str {
+        &self.id
+    }
+
+    fn complete(&self, req: &ChatRequest) -> Result<ChatResponse, LlmError> {
+        self.lookup(req)?
+    }
+
+    fn stream(
+        &self,
+        req: &ChatRequest,
+        on_event: &mut dyn FnMut(StreamEvent) -> ControlFlow<()>,
+    ) -> Result<ChatResponse, LlmError> {
+        let response = self.lookup(req)??;
+        for block in &response.content {
+            let events = match block {
+                ContentBlock::Text { text } => vec![StreamEvent::Text(text.clone())],
+                ContentBlock::ToolUse { id, name, input } => vec![
+                    StreamEvent::ToolUseStart {
+                        id: id.clone(),
+                        name: name.clone(),
+                    },
+                    StreamEvent::ToolInputDelta {
+                        id: id.clone(),
+                        partial_json: input.to_string(),
+                    },
+                ],
+                _ => Vec::new(),
+            };
+            for e in events {
+                if on_event(e).is_break() {
+                    return Err(LlmError::Cancelled);
+                }
+            }
+        }
+        Ok(response)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    struct Fixed(ChatResponse);
+
+    impl Provider for Fixed {
+        fn id(&self) -> &str {
+            "fixed"
+        }
+        fn complete(&self, _: &ChatRequest) -> Result<ChatResponse, LlmError> {
+            Ok(self.0.clone())
+        }
+        fn stream(
+            &self,
+            _: &ChatRequest,
+            _: &mut dyn FnMut(StreamEvent) -> ControlFlow<()>,
+        ) -> Result<ChatResponse, LlmError> {
+            Ok(self.0.clone())
+        }
+    }
+
+    fn response(text: &str) -> ChatResponse {
+        ChatResponse {
+            id: "r1".into(),
+            model: "m".into(),
+            content: vec![
+                ContentBlock::text(text),
+                ContentBlock::ToolUse {
+                    id: "t1".into(),
+                    name: "f".into(),
+                    input: json!({"a": 1}),
+                },
+            ],
+            stop_reason: StopReason::ToolUse,
+            usage: Usage {
+                input_tokens: 3,
+                output_tokens: 4,
+                cache_read_tokens: 0,
+                cache_write_tokens: 0,
+            },
+            usage_known: true,
+            metering: Metering::PerToken,
+        }
+    }
+
+    fn temp_file() -> PathBuf {
+        static N: AtomicUsize = AtomicUsize::new(0);
+        let p = std::env::temp_dir().join(format!(
+            "rightkit-llm-replay-{}-{}.jsonl",
+            std::process::id(),
+            N.fetch_add(1, Ordering::SeqCst)
+        ));
+        let _ = std::fs::remove_file(&p);
+        p
+    }
+
+    #[test]
+    fn redactor_blanks_keys_and_secrets() {
+        let r = Redactor::new().with_secret("sk-live-1234");
+        let v = json!({"Authorization": "Bearer x", "n": {"api_key": "k", "t": "use sk-live-1234 now"}});
+        let out = r.redact_value(&v);
+        assert_eq!(out["Authorization"], "[redacted]");
+        assert_eq!(out["n"]["api_key"], "[redacted]");
+        assert_eq!(out["n"]["t"], "use [redacted] now");
+        // A short value is not registered.
+        assert_eq!(Redactor::new().with_secret("ab").redact_text("ab cd"), "ab cd");
+    }
+
+    #[test]
+    fn record_then_replay_roundtrip_with_redaction() {
+        let path = temp_file();
+        let rec = Recorder::new(&path)
+            .with_redactor(Redactor::new().with_secret("sk-live-1234"))
+            .with_clock(|| 1_000_000);
+        let p = RecordingProvider::new(Fixed(response("answer sk-live-1234")), rec);
+        let req = ChatRequest::simple("m", "sys", "question");
+        p.complete(&req).unwrap();
+        let text = std::fs::read_to_string(&path).unwrap();
+        assert!(!text.contains("sk-live-1234"));
+        assert!(text.contains("\"schema\":1"));
+
+        let corpus = Corpus::load(&path).unwrap();
+        assert_eq!(corpus.len(), 1);
+        let replay = ReplayProvider::new("replay", corpus).with_clock(|| 1_000_000 + 86_400);
+        let got = replay.complete(&req).unwrap();
+        assert_eq!(got.text(), "answer [redacted]");
+        assert_eq!(got.stop_reason, StopReason::ToolUse);
+        assert_eq!(got.usage.output_tokens, 4);
+
+        // A stream replays the recorded content as events.
+        let mut events = Vec::new();
+        let streamed = replay
+            .stream(&req, &mut |e| {
+                events.push(e);
+                ControlFlow::Continue(())
+            })
+            .unwrap();
+        assert_eq!(streamed.id, "r1");
+        assert_eq!(events.len(), 3);
+
+        // A different request has no recording.
+        let other = ChatRequest::simple("m", "sys", "another question");
+        assert!(matches!(
+            replay.complete(&other),
+            Err(LlmError::InvalidRequest(m)) if m.contains("no recorded answer")
+        ));
+        let _ = std::fs::remove_file(&path);
+    }
+
+    #[test]
+    fn entries_past_the_freshness_limit_are_refused() {
+        let path = temp_file();
+        let rec = Recorder::new(&path).with_clock(|| 0);
+        let p = RecordingProvider::new(Fixed(response("x")), rec);
+        let req = ChatRequest::simple("m", "", "q");
+        p.complete(&req).unwrap();
+        let corpus = Corpus::load(&path).unwrap();
+        let fresh = ReplayProvider::new("r", corpus.clone()).with_clock(|| 90 * 86_400);
+        assert!(fresh.complete(&req).is_ok());
+        let stale = ReplayProvider::new("r", corpus).with_clock(|| 91 * 86_400);
+        assert!(matches!(
+            stale.complete(&req),
+            Err(LlmError::InvalidRequest(m)) if m.contains("freshness limit")
+        ));
+        let _ = std::fs::remove_file(&path);
+    }
+
+    #[test]
+    fn a_disabled_recorder_writes_nothing_and_unknown_schemas_fail_loudly() {
+        let path = temp_file();
+        let p = RecordingProvider::new(Fixed(response("x")), Recorder::disabled());
+        p.complete(&ChatRequest::simple("m", "", "q")).unwrap();
+        assert!(!path.exists());
+        assert!(!Recorder::from_env(&path, "RIGHTKIT_LLM_REPLAY_TEST_UNSET_VAR").is_enabled());
+        assert!(matches!(
+            Corpus::from_jsonl("{\"schema\":9}"),
+            Err(ReplayError::UnsupportedSchema { line: 1, schema: 9 })
+        ));
+        assert!(matches!(
+            Corpus::from_jsonl("not json"),
+            Err(ReplayError::Parse { line: 1, .. })
+        ));
+    }
+
+    #[test]
+    fn repeated_identical_calls_replay_in_recorded_order() {
+        let path = temp_file();
+        let rec = Recorder::new(&path).with_clock(|| 5);
+        let req = ChatRequest::simple("m", "", "q");
+        RecordingProvider::new(Fixed(response("first")), rec)
+            .complete(&req)
+            .unwrap();
+        let rec = Recorder::new(&path).with_clock(|| 5);
+        RecordingProvider::new(Fixed(response("second")), rec)
+            .complete(&req)
+            .unwrap();
+        let replay = ReplayProvider::new("r", Corpus::load(&path).unwrap()).with_clock(|| 5);
+        assert_eq!(replay.complete(&req).unwrap().text(), "first");
+        assert_eq!(replay.complete(&req).unwrap().text(), "second");
+        assert_eq!(replay.complete(&req).unwrap().text(), "second");
+        let _ = std::fs::remove_file(&path);
+    }
+}

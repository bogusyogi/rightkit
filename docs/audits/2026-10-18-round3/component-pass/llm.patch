+    #[test]
+    fn a_batch_step_checkpoints_every_item_and_resumes_mid_batch() {
+        let p = Scripted::new(&["a", "b", "c"]);
+        let store = MemoryCheckpointStore::new();
+        let plan = SkillPlan::new(
+            "plan",
+            vec![Box::new(BatchStep::new(
+                "label",
+                vec![json!("one"), json!("two"), json!("three")],
+                |cx, item| {
+                    let r = cx.call(&ChatRequest::simple("m", "", item.as_str().unwrap()))?;
+                    Ok(json!(r.text()))
+                },
+            )) as Box<dyn Step>],
+        );
+        // Allow two calls, then stop; the third item waits.
+        let r = SkillRunner::new(&p, &store)
+            .with_budget(Budget {
+                max_calls: Some(2),
+                ..Budget::default()
+            })
+            .start(&plan, "r", "b")
+            .unwrap();
+        assert!(matches!(r.status, RunStatus::BudgetStopped(_)));
+        let saved = store.load("r").unwrap().unwrap();
+        assert_eq!(saved.steps[0].progress.as_ref().unwrap()["done"], json!(["a", "b"]));
+        let r = SkillRunner::new(&p, &store).resume(&plan, "r", "b").unwrap();
+        assert!(r.is_complete());
+        assert_eq!(r.outputs["label"], json!(["a", "b", "c"]));
+        assert_eq!(p.calls(), 3);
+    }

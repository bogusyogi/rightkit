+    #[test]
+    fn a_gate_repairs_until_the_ceiling_then_fails_with_the_defects() {
+        let p = Scripted::new(&["bad", "still bad", "good"]);
+        let store = MemoryCheckpointStore::new();
+        let step = |attempts: u32| {
+            ModelStep::new("write", |cx| {
+                let note = cx.defects().join(",");
+                Ok(ChatRequest::simple("m", "", &format!("write {note}")))
+            })
+            .gate(|out| {
+                if out["text"] == "good" {
+                    vec![]
+                } else {
+                    vec!["contains a planted defect".into()]
+                }
+            })
+            .with_max_attempts(attempts)
+        };
+        let plan = SkillPlan::new("plan", vec![Box::new(step(2)) as Box<dyn Step>]);
+        let r = SkillRunner::new(&p, &store).start(&plan, "r1", "b").unwrap();
+        match &r.status {
+            RunStatus::Failed { step, reason } => {
+                assert_eq!(step, "write");
+                assert!(reason.contains("repair ceiling") && reason.contains("planted defect"));
+            }
+            other => panic!("expected Failed, got {other:?}"),
+        }
+        assert_eq!(p.calls(), 2);
+        // With a ceiling of 3 the third answer passes.
+        let p = Scripted::new(&["bad", "still bad", "good"]);
+        let plan = SkillPlan::new("plan", vec![Box::new(step(3)) as Box<dyn Step>]);
+        let r = SkillRunner::new(&p, &store).start(&plan, "r2", "b").unwrap();
+        assert!(r.is_complete());
+        assert_eq!(r.outputs["write"]["text"], "good");
+    }

+// Images
+
+/// Async client for the images route of one OpenAI-compatible endpoint. Same request and
+/// response shapes as [`generation::ImageGenerationClient`].
+pub struct AsyncImageGenerationClient {
+    id: String,
+    base_url: String,
+    client: AsyncClient,
+    credentials: Arc<dyn CredentialSource>,
+    max_response_bytes: usize,
+}
+
+impl AsyncImageGenerationClient {
+    pub fn new(
+        id: impl Into<String>,
+        base_url: impl Into<String>,
+        client: AsyncClient,
+        credentials: Arc<dyn CredentialSource>,
+    ) -> Self {
+        Self {
+            id: id.into(),
+            base_url: base_url.into(),
+            client,
+            credentials,
+            max_response_bytes: generation::DEFAULT_MAX_RESPONSE_BYTES,
+        }
+    }
+
+    pub fn with_max_response_bytes(mut self, limit: usize) -> Self {
+        self.max_response_bytes = limit;
+        self
+    }
+
+    /// Generate `req.count` images and return every one, in the provider's order.
+    pub async fn generate(&self, req: &ImageRequest) -> Result<Vec<GeneratedImage>, LlmError> {
+        generation::check_request(req)?;
+        let credential = self
+            .credentials
+            .credential(&self.id)?
+            .ok_or_else(|| LlmError::MissingCredential(self.id.clone()))?;
+        let secret = credential.expose().to_string();
+        let http = Request::post(format!(
+            "{}/images/generations",
+            self.base_url.trim_end_matches('/')
+        ))
+        .header("Accept", "application/json")
+        .bearer(secret.as_str())
+        .max_response_bytes(self.max_response_bytes)
+        .json(&generation::build_body(req))?;
+        let resp = self
+            .client
+            .send(&http)
+            .await
+            .map_err(|e| LlmError::from_http(e, Some(secret.as_str())))?;
+        let v: Value = resp
+            .json()
+            .map_err(|e| LlmError::Malformed(e.to_string()))?;
+        generation::parse_images(&v)
+    }
+}
+
+impl std::fmt::Debug for AsyncImageGenerationClient {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("AsyncImageGenerationClient")
+            .field("id", &self.id)
+            .field("base_url", &generation::redact_url(&self.base_url))
+            .finish_non_exhaustive()
+    }
+}

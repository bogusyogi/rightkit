+        let r = SkillRunner::new(&p, &store)
+            .start(&two_step_plan(), "run-1", "b")
+            .unwrap();
+        assert!(r.is_complete());
+        let loaded = store.load("run-1").unwrap().unwrap();
+        assert_eq!(loaded.status, RunStatus::Completed);
+        assert!(store.load("missing").unwrap().is_none());
+        assert!(matches!(store.load("../x"), Err(SkillError::Store(_))));
+        assert!(matches!(store.load(""), Err(SkillError::Store(_))));
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}
diff --git a/crates/rightkit-llm/src/stream.rs b/crates/rightkit-llm/src/stream.rs
new file mode 100644
index 0000000..e4569c7
--- /dev/null
+++ b/crates/rightkit-llm/src/stream.rs
@@ -0,0 +1,279 @@
+//! Stream semantics a caller can enforce (Orthic-Labs/rightkit#657).
+//!
+//! [`StreamPolicy`] adds three checks to a provider's stream. Set it with `with_stream_policy`
+//! on [`crate::openai::OpenAiCompatProvider`], [`crate::anthropic::AnthropicProvider`],
+//! [`crate::responses::OpenAiResponsesProvider`] and the async providers. A stream that breaks a
+//! check fails with [`crate::LlmError::IncompleteOutput`], which carries a [`PartialOutput`]:
+//! the text, reasoning, tool calls and usage received so far, so the caller can continue the
+//! turn instead of losing it.
+//!
+//! - **require_finish**: end of stream without the provider's finish marker (`[DONE]` or a
+//!   finish reason; `message_stop`; `response.completed`), or inside an unterminated frame, is an
+//!   error and never a short answer ([`IncompleteCause::MissingFinish`],
+//!   [`IncompleteCause::UnterminatedFrame`]).
+//! - **semantic_progress**: fail when no text or tool-call delta has arrived for this long,
+//!   even though keep-alive frames keep arriving ([`IncompleteCause::NoSemanticProgress`]).
+//! - **idle**: fail when no frame at all has arrived for this long
+//!   ([`IncompleteCause::Idle`]).
+//!
+//! # Timing in the blocking providers
+//!
+//! A blocking provider can look at the clock only when a frame arrives (or the read fails). The
+//! `semantic_progress` and `idle` checks therefore run on the next frame after the limit has
+//! passed. A connection that goes completely silent never produces that frame: bound it with the
+//! HTTP client's `ClientConfig::idle_timeout`, whose timeout error is reported as
+//! [`IncompleteCause::Idle`] with the partial output. The async providers enforce both limits
+//! with a timer and need no client setting.
+
+use std::fmt;
+use std::time::{Duration, Instant};
+
+use crate::types::Usage;
+
+/// Checks applied to one stream. The default turns every check off, which is the behaviour of a
+/// provider with no policy.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub struct StreamPolicy {
+    /// Longest gap between two frames of any kind. `None` = unlimited.
+    pub idle: Option<Duration>,
+    /// Longest gap between two text or tool-call deltas. `None` = unlimited.
+    pub semantic_progress: Option<Duration>,
+    /// Treat a stream that ends without a finish marker as an error.
+    pub require_finish: bool,
+}
+
+impl StreamPolicy {
+    /// No check at all.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn with_idle(mut self, limit: Duration) -> Self {
+        self.idle = Some(limit);
+        self
+    }
+
+    pub fn with_semantic_progress(mut self, limit: Duration) -> Self {
+        self.semantic_progress = Some(limit);
+        self
+    }
+
+    pub fn require_finish(mut self) -> Self {
+        self.require_finish = true;
+        self
+    }
+}
+
+/// Why a stream is incomplete. See [`StreamPolicy`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum IncompleteCause {
+    /// No frame arrived within `limit` ([`StreamPolicy::idle`]).
+    Idle { limit: Duration },
+    /// Frames arrived but none carried text or a tool-call delta within `limit`
+    /// ([`StreamPolicy::semantic_progress`]).
+    NoSemanticProgress { limit: Duration },
+    /// The stream ended without the provider's finish marker ([`StreamPolicy::require_finish`]).
+    MissingFinish,
+    /// The stream ended inside a frame ([`StreamPolicy::require_finish`]).
+    UnterminatedFrame,
+}
+
+impl fmt::Display for IncompleteCause {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            IncompleteCause::Idle { limit } => write!(f, "no frame for {limit:?}"),
+            IncompleteCause::NoSemanticProgress { limit } => {
+                write!(f, "no text or tool-call delta for {limit:?}")
+            }
+            IncompleteCause::MissingFinish => f.write_str("stream ended without a finish marker"),
+            IncompleteCause::UnterminatedFrame => f.write_str("stream ended inside a frame"),
+        }
+    }
+}
+
+/// One tool call received so far. `arguments` is the text streamed, which may not be complete
+/// JSON.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct PartialToolCall {
+    pub id: String,
+    pub name: String,
+    pub arguments: String,
+}
+
+/// What a stream delivered before it stopped.
+#[derive(Debug, Clone, PartialEq, Default)]
+pub struct PartialOutput {
+    /// Answer text received.
+    pub text: String,
+    /// Reasoning text received (OpenAI-compatible `reasoning_content`, Anthropic thinking).
+    pub reasoning: String,
+    /// Tool calls started, in the provider's order.
+    pub tool_calls: Vec<PartialToolCall>,
+    /// Usage the provider reported before the stream stopped. Meaningful only when
+    /// `usage_known`.
+    pub usage: Usage,
+    pub usage_known: bool,
+}
+
+impl PartialOutput {
+    /// True when nothing the model produced was received.
+    pub fn is_empty(&self) -> bool {
+        self.text.is_empty() && self.reasoning.is_empty() && self.tool_calls.is_empty()
+    }
+}
+
+/// Tracks the two clocks of a [`StreamPolicy`] for one stream.
+#[derive(Debug)]
+pub(crate) struct ProgressClock {
+    policy: StreamPolicy,
+    last_frame: Instant,
+    last_progress: Instant,
+}
+
+impl ProgressClock {
+    pub(crate) fn new(policy: Option<StreamPolicy>) -> Self {
+        let now = Instant::now();
+        Self {
+            policy: policy.unwrap_or_default(),
+            last_frame: now,
+            last_progress: now,
+        }
+    }
+
+    /// The check that a frame arriving at `now` would fail, if any.
+    pub(crate) fn violation(&self, now: Instant) -> Option<IncompleteCause> {
+        if let Some(limit) = self.policy.idle {
+            if now.saturating_duration_since(self.last_frame) > limit {
+                return Some(IncompleteCause::Idle { limit });
+            }
+        }
+        if let Some(limit) = self.policy.semantic_progress {
+            if now.saturating_duration_since(self.last_progress) > limit {
+                return Some(IncompleteCause::NoSemanticProgress { limit });
+            }
+        }
+        None
+    }
+
+    /// The longest the next frame may take before a limit is broken, and which limit that is.
+    /// `None` when no limit is set. Used by the async providers to arm a timer.
+    pub(crate) fn remaining(&self, now: Instant) -> Option<(Duration, IncompleteCause)> {
+        let idle = self.policy.idle.map(|limit| {
+            (
+                limit.saturating_sub(now.saturating_duration_since(self.last_frame)),
+                IncompleteCause::Idle { limit },
+            )
+        });
+        let semantic = self.policy.semantic_progress.map(|limit| {
+            (
+                limit.saturating_sub(now.saturating_duration_since(self.last_progress)),
+                IncompleteCause::NoSemanticProgress { limit },
+            )
+        });
+        match (idle, semantic) {
+            (Some(a), Some(b)) => Some(if a.0 <= b.0 { a } else { b }),
+            (a, b) => a.or(b),
+        }
+    }
+
+    /// A frame arrived and passed [`ProgressClock::violation`].
+    pub(crate) fn frame(&mut self, now: Instant) {
+        self.last_frame = now;
+    }
+
+    /// The frame carried a text or tool-call delta.
+    pub(crate) fn progress(&mut self, now: Instant) {
+        self.last_progress = now;
+    }
+
+    pub(crate) fn require_finish(&self) -> bool {
+        self.policy.require_finish
+    }
+
+    pub(crate) fn policy(&self) -> StreamPolicy {
+        self.policy
+    }
+}
+
+/// True when an HTTP stream error means the connection ended inside an SSE frame
+/// (`EofPolicy::Fail` of `rightkit-http`).
+pub(crate) fn is_unterminated_frame(e: &rightkit_http::HttpError) -> bool {
+    matches!(e, rightkit_http::HttpError::Stream(m) if m.contains("ended inside an event"))
+}
+
+/// True when an HTTP error is the client's idle-read timeout.
+pub(crate) fn is_idle_timeout(e: &rightkit_http::HttpError) -> bool {
+    matches!(
+        e,
+        rightkit_http::HttpError::Timeout {
+            phase: rightkit_http::Phase::Body,
+            ..
+        }
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn clock_reports_the_check_that_failed() {
+        let policy = StreamPolicy::new()
+            .with_idle(Duration::from_secs(10))
+            .with_semantic_progress(Duration::from_secs(120));
+        let mut clock = ProgressClock::new(Some(policy));
+        let t0 = Instant::now();
+        assert_eq!(clock.violation(t0), None);
+        // Keep-alive frames every 5 s keep the idle clock fresh but never the progress clock.
+        let mut t = t0;
+        for _ in 0..24 {
+            t += Duration::from_secs(5);
+            assert_eq!(clock.violation(t), None);
+            clock.frame(t);
+        }
+        t += Duration::from_secs(5);
+        assert_eq!(
+            clock.violation(t),
+            Some(IncompleteCause::NoSemanticProgress {
+                limit: Duration::from_secs(120)
+            })
+        );
+        // A long silence is an idle failure first.
+        assert_eq!(
+            clock.violation(t + Duration::from_secs(30)),
+            Some(IncompleteCause::Idle {
+                limit: Duration::from_secs(10)
+            })
+        );
+    }
+
+    #[test]
+    fn progress_resets_the_semantic_clock() {
+        let policy = StreamPolicy::new().with_semantic_progress(Duration::from_secs(60));
+        let mut clock = ProgressClock::new(Some(policy));
+        let t = Instant::now() + Duration::from_secs(50);
+        assert_eq!(clock.violation(t), None);
+        clock.frame(t);
+        clock.progress(t);
+        assert_eq!(clock.violation(t + Duration::from_secs(50)), None);
+    }
+
+    #[test]
+    fn no_policy_never_fails() {
+        let clock = ProgressClock::new(None);
+        assert_eq!(
+            clock.violation(Instant::now() + Duration::from_secs(86_400)),
+            None
+        );
+        assert!(!clock.require_finish());
+    }
+
+    #[test]
+    fn partial_output_emptiness() {
+        let mut p = PartialOutput::default();
+        assert!(p.is_empty());
+        p.tool_calls.push(PartialToolCall::default());
+        assert!(!p.is_empty());
+    }
+}
diff --git a/crates/rightkit-llm/src/tokens.rs b/crates/rightkit-llm/src/tokens.rs
new file mode 100644
index 0000000..0625ff9
--- /dev/null
+++ b/crates/rightkit-llm/src/tokens.rs
@@ -0,0 +1,281 @@
+//! Token counting for prompts and requests (Orthic-Labs/rightkit#417).
+//!
+//! Apps need a token count before a call, to decide whether a conversation fits a model's
+//! window ([`fits`]), when to compact it, and what a call may cost. This module has two parts:
+//!
+//! - [`TokenCounter`], the interface. A host that needs exact counts for a model family
+//!   implements it over its tokenizer (for example an `o200k` BPE for OpenAI models) and every
+//!   function here takes it as `&dyn TokenCounter`.
+//! - [`EstimateCounter`], a counter that needs no vocabulary. It is an estimate, and every result
+//!   built from it says so ([`Counted::exact`] is `false`). The rule is: one token per four ASCII
+//!   bytes (rounded up per text), plus one token per non-ASCII character. That tracks English
+//!   prose and code within roughly 15 percent and is deliberately a little high for CJK text; use
+//!   it to size budgets with headroom, not to bill.
+//!
+//! [`count_request`] counts a whole [`ChatRequest`]: system prompt, every text, tool-use and
+//! tool-result block, the tool definitions, images (a fixed per-image estimate, because the real
+//! count depends on pixels the provider reads), and a framing overhead per message
+//! ([`Overhead`]).
+//!
+//! Exact BPE counting is not in this crate: it needs a tokenizer vocabulary (a data file of
+//! about two megabytes per family) or a tokenizer dependency, and which one to carry is a
+//! supply-chain decision for the suite. [`TokenCounter`] is the seam for it.
+
+use crate::types::{ChatRequest, ContentBlock};
+
+/// Tokens assumed for one image block. The provider counts image tokens from pixels; this is a
+/// planning figure.
+pub const IMAGE_TOKEN_ESTIMATE: u64 = 1_600;
+
+/// Counts the tokens of a text for a model.
+pub trait TokenCounter: Send + Sync {
+    /// Tokens `text` takes for `model`. `model` may be empty when the caller does not know it.
+    fn count_text(&self, model: &str, text: &str) -> u64;
+
+    /// True when [`TokenCounter::count_text`] is the tokenizer's real count, false for an
+    /// estimate. Results built from the counter carry this in [`Counted::exact`].
+    fn is_exact(&self) -> bool {
+        false
+    }
+}
+
+/// The dependency-free estimate. See the module docs for the rule.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct EstimateCounter;
+
+impl TokenCounter for EstimateCounter {
+    fn count_text(&self, _model: &str, text: &str) -> u64 {
+        estimate_text(text)
+    }
+}
+
+/// The estimate used by [`EstimateCounter`]: `ceil(ascii_bytes / 4) + non_ascii_chars`.
+pub fn estimate_text(text: &str) -> u64 {
+    let mut ascii: u64 = 0;
+    let mut other: u64 = 0;
+    for c in text.chars() {
+        if c.is_ascii() {
+            ascii += 1;
+        } else {
+            other += 1;
+        }
+    }
+    ascii.div_ceil(4) + other
+}
+
+/// Framing tokens the provider adds around messages. The defaults follow the common chat
+/// framing: a few tokens per message and a few to prime the reply.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Overhead {
+    pub per_message: u64,
+    pub per_request: u64,
+}
+
+impl Default for Overhead {
+    fn default() -> Self {
+        Self {
+            per_message: 4,
+            per_request: 3,
+        }
+    }
+}
+
+/// A token count and whether it is exact.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Counted {
+    pub tokens: u64,
+    /// True only when the counter was exact. Images always make a total an estimate, so a
+    /// request with images is never `exact`.
+    pub exact: bool,
+}
+
+/// Where the tokens of a request go.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RequestTokens {
+    pub system: u64,
+    pub messages: u64,
+    pub tools: u64,
+    pub images: u64,
+    pub overhead: u64,
+    pub total: Counted,
+}
+
+/// Count the input tokens of `req` with `counter`, using the default [`Overhead`].
+pub fn count_request(counter: &dyn TokenCounter, req: &ChatRequest) -> RequestTokens {
+    count_request_with(counter, req, Overhead::default())
+}
+
+/// [`count_request`] with explicit framing overhead.
+pub fn count_request_with(
+    counter: &dyn TokenCounter,
+    req: &ChatRequest,
+    overhead: Overhead,
+) -> RequestTokens {
+    let model = req.model.as_str();
+    let text = |t: &str| counter.count_text(model, t);
+    let system = req.system.as_deref().map(text).unwrap_or(0);
+    let mut messages = 0;
+    let mut images = 0;
+    for m in &req.messages {
+        for b in &m.content {
+            match b {
+                ContentBlock::Text { text: t } => messages += text(t),
+                ContentBlock::ToolUse { name, input, .. } => {
+                    messages += text(name) + text(&input.to_string());
+                }
+                ContentBlock::ToolResult { content, .. } => messages += text(content),
+                ContentBlock::Image { .. } => images += IMAGE_TOKEN_ESTIMATE,
+            }
+        }
+    }
+    let mut tools = 0;
+    for t in &req.tools {
+        tools += text(&t.name) + text(&t.description) + text(&t.input_schema.to_string());
+    }
+    if let Some(s) = req.response_schema() {
+        tools += text(&s.name) + text(&s.schema.to_string());
+    }
+    let framing = overhead.per_request + overhead.per_message * req.messages.len() as u64;
+    let tokens = system + messages + tools + images + framing;
+    RequestTokens {
+        system,
+        messages,
+        tools,
+        images,
+        overhead: framing,
+        total: Counted {
+            tokens,
+            exact: counter.is_exact() && images == 0,
+        },
+    }
+}
+
+/// True when the request's input plus `reserve_output` tokens fits in `context_window`.
+/// `reserve_output` is what the caller wants to leave for the answer (often
+/// `req.max_tokens`).
+pub fn fits(
+    counter: &dyn TokenCounter,
+    req: &ChatRequest,
+    context_window: u64,
+    reserve_output: u64,
+) -> bool {
+    count_request(counter, req)
+        .total
+        .tokens
+        .saturating_add(reserve_output)
+        <= context_window
+}
+
+/// The longest prefix of `text` (cut on a character boundary) that `counter` counts at no more
+/// than `budget` tokens. Counts the text a bounded number of times (binary search).
+pub fn trim_to_budget<'a>(
+    counter: &dyn TokenCounter,
+    model: &str,
+    text: &'a str,
+    budget: u64,
+) -> &'a str {
+    if counter.count_text(model, text) <= budget {
+        return text;
+    }
+    let boundaries: Vec<usize> = text
+        .char_indices()
+        .map(|(i, _)| i)
+        .chain(std::iter::once(text.len()))
+        .collect();
+    // Find the largest index into `boundaries` whose prefix fits.
+    let (mut lo, mut hi) = (0usize, boundaries.len() - 1);
+    while lo < hi {
+        let mid = (lo + hi).div_ceil(2);
+        if counter.count_text(model, &text[..boundaries[mid]]) <= budget {
+            lo = mid;
+        } else {
+            hi = mid - 1;
+        }
+    }
+    &text[..boundaries[lo]]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::types::{Message, ToolSpec};
+    use serde_json::json;
+
+    #[test]
+    fn estimate_rule_is_ascii_quarters_plus_non_ascii_chars() {
+        assert_eq!(estimate_text(""), 0);
+        assert_eq!(estimate_text("abcd"), 1);
+        assert_eq!(estimate_text("abcde"), 2);
+        assert_eq!(estimate_text("日本語"), 3);
+        assert_eq!(estimate_text("abcd日"), 2);
+    }
+
+    #[test]
+    fn request_count_adds_every_part_and_is_never_exact_for_the_estimate() {
+        let mut req = ChatRequest::new(
+            "m",
+            vec![
+                Message::user("abcdefgh"),
+                Message::tool_result("t1", "abcd", false),
+            ],
+        );
+        req.system = Some("abcd".into());
+        req.tools = vec![ToolSpec::new("ab", "abcd", json!({}))];
+        let c = count_request(&EstimateCounter, &req);
+        assert_eq!(c.system, 1);
+        assert_eq!(c.messages, 2 + 1);
+        // name "ab" = 1, description "abcd" = 1, schema "{}" = 1.
+        assert_eq!(c.tools, 3);
+        assert_eq!(c.images, 0);
+        assert_eq!(c.overhead, 3 + 4 * 2);
+        assert_eq!(c.total.tokens, 1 + 3 + 3 + 11);
+        assert!(!c.total.exact);
+    }
+
+    #[test]
+    fn images_count_a_fixed_estimate_and_exact_counters_stay_inexact_with_them() {
+        struct Words;
+        impl TokenCounter for Words {
+            fn count_text(&self, _: &str, text: &str) -> u64 {
+                text.split_whitespace().count() as u64
+            }
+            fn is_exact(&self) -> bool {
+                true
+            }
+        }
+        let plain = ChatRequest::simple("m", "", "one two three");
+        let c = count_request_with(&Words, &plain, Overhead::default());
+        assert_eq!(c.messages, 3);
+        assert!(c.total.exact);
+        let with_image = ChatRequest::new(
+            "m",
+            vec![Message::user_blocks(vec![
+                ContentBlock::text("one"),
+                ContentBlock::image_url("https://example.test/a.png"),
+            ])],
+        );
+        let c = count_request(&Words, &with_image);
+        assert_eq!(c.images, IMAGE_TOKEN_ESTIMATE);
+        assert!(!c.total.exact);
+    }
+
+    #[test]
+    fn fits_respects_the_window_and_the_output_reserve() {
+        let req = ChatRequest::simple("m", "", "abcdefgh");
+        let used = count_request(&EstimateCounter, &req).total.tokens;
+        assert!(fits(&EstimateCounter, &req, used + 100, 100));
+        assert!(!fits(&EstimateCounter, &req, used + 99, 100));
+    }
+
+    #[test]
+    fn trim_cuts_on_a_character_boundary_within_budget() {
+        let text = "abcdefghij日本語";
+        let cut = trim_to_budget(&EstimateCounter, "", text, 2);
+        assert_eq!(cut, "abcdefgh");
+        assert!(EstimateCounter.count_text("", cut) <= 2);
+        assert_eq!(trim_to_budget(&EstimateCounter, "", text, 1_000), text);
+        let cut = trim_to_budget(&EstimateCounter, "", "日本語", 2);
+        assert_eq!(cut, "日本");
+        assert_eq!(trim_to_budget(&EstimateCounter, "", "日本語", 0), "");
+    }
+}

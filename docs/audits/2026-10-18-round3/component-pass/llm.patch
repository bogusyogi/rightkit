+    }
+
+    #[tokio::test]
+    async fn auth_errors_do_not_fail_over_but_the_classifier_can_override() {
+        let calls: Calls = Arc::default();
+        let c = chain(
+            Scripted::new("a", vec![Err(status(401, "bad key"))], &calls),

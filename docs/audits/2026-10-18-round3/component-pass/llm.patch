+        }
+    }
+
+    fn catalogue(version: u64) -> CapabilityCatalogue {
+        let mut m = model("claude-x", Tier::Capable);
+        m.aliases = vec!["claude-x-latest".into()];
+        CapabilityCatalogue::new(
+            version,
+            "2026-10-18",
+            vec![AliasRule {
+                prefix: Some("anthropic/".into()),
+                strip_date_suffix: true,
+            }],
+            vec![m, model("small", Tier::Cheap)],
+        )
+        .unwrap()
+    }
+
+    /// Accepts a snapshot whose signature is `sig:` plus its digest, and whose digest is the
+    /// payload length.
+    struct TestVerifier;
+
+    impl SnapshotVerifier for TestVerifier {
+        fn verify(&self, payload: &[u8], digest: &str, signature: &str) -> Result<(), String> {
+            if digest != payload.len().to_string() {
+                return Err("digest mismatch".into());
+            }
+            if signature != format!("sig:{digest}") {
+                return Err("bad signature".into());
+            }
+            Ok(())
+        }
+    }
+
+    fn signed(c: &CapabilityCatalogue) -> SignedSnapshot {
+        let payload = c.to_json();
+        let digest = payload.len().to_string();
+        SignedSnapshot {
+            signature: format!("sig:{digest}"),
+            digest,
+            payload,
+        }
+    }
+
+    fn temp_dir() -> PathBuf {
+        static N: AtomicU32 = AtomicU32::new(0);
+        let dir = std::env::temp_dir().join(format!(
+            "rightkit-llm-capability-{}-{}",
+            std::process::id(),
+            N.fetch_add(1, Ordering::SeqCst)
+        ));
+        let _ = fs::remove_dir_all(&dir);
+        dir
+    }
+
+    #[test]
+    fn lookup_is_exact_after_alias_rules_and_never_prefix() {
+        let c = catalogue(1);
+        assert_eq!(c.lookup("claude-x").unwrap().id, "claude-x");
+        assert_eq!(c.lookup("Anthropic/Claude-X-20260101").unwrap().id, "claude-x");
+        assert_eq!(c.lookup("claude-x-latest").unwrap().id, "claude-x");
+        assert!(matches!(
+            c.lookup("claude-x-mini"),
+            Err(CapabilityError::Unknown(_))
+        ));
+        assert_eq!(c.by_tier(Tier::Cheap).count(), 1);
+    }
+
+    #[test]
+    fn compaction_trigger_follows_the_window() {
+        let c = catalogue(1);
+        let m = c.lookup("claude-x").unwrap();
+        assert_eq!(m.compaction_trigger_tokens(), Some(160_000));
+        assert!(m.supports_effort("HIGH"));
+        assert!(!m.supports_effort("max"));
+    }
+
+    #[test]
+    fn validation_rejects_bad_rows() {
+        let mut m = model("a", Tier::Cheap);
+        m.reasoning_depth = 4;
+        assert!(CapabilityCatalogue::new(1, "2026-10-18", vec![], vec![m]).is_err());
+        let mut m = model("a", Tier::Cheap);
+        m.compaction.as_mut().unwrap().trigger_percent = 0;
+        assert!(CapabilityCatalogue::new(1, "2026-10-18", vec![], vec![m]).is_err());
+        let dup = vec![model("a", Tier::Cheap), model("A", Tier::Capable)];
+        assert!(matches!(
+            CapabilityCatalogue::new(1, "2026-10-18", vec![], dup),
+            Err(CapabilityError::DuplicateName(_))
+        ));
+        let mut json: serde_json::Value = serde_json::from_str(&catalogue(1).to_json()).unwrap();
+        json["schema"] = serde_json::json!(9);
+        assert!(matches!(
+            CapabilityCatalogue::from_json(&json.to_string()),
+            Err(CapabilityError::UnsupportedSchema(9))
+        ));
+    }
+
+    #[test]
+    fn install_load_roundtrip_and_rollback_to_last_known_good() {
+        let dir = temp_dir();
+        let store = CapabilityStore::new(&dir);
+        let v = TestVerifier;
+        store.install(&signed(&catalogue(1)), &v).unwrap();
+        store.install(&signed(&catalogue(2)), &v).unwrap();
+        let loaded = store.load(&v).unwrap();
+        assert_eq!(loaded.catalogue.version, 2);
+        assert!(loaded.degraded.is_none());
+
+        // Corrupt the newest snapshot: the load falls back to version 1 and says so.
+        fs::write(dir.join(SNAPSHOT_FILE), "{\"payload\":\"x\",\"digest\":\"1\",\"signature\":\"bad\"}")
+            .unwrap();
+        let loaded = store.load(&v).unwrap();
+        assert_eq!(loaded.catalogue.version, 1);
+        assert!(loaded.degraded.is_some());
+        let _ = fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn a_bad_or_stale_snapshot_changes_nothing() {
+        let dir = temp_dir();
+        let store = CapabilityStore::new(&dir);
+        let v = TestVerifier;
+        store.install(&signed(&catalogue(5)), &v).unwrap();
+        let mut forged = signed(&catalogue(6));
+        forged.signature = "sig:forged".into();
+        assert!(matches!(
+            store.install(&forged, &v),
+            Err(CapabilityError::Rejected(_))

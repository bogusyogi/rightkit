@@ -0,0 +1,447 @@
+//! Async route failover (Orthic-Labs/rightkit#661). Feature `async`.
+//!
+//! [`AsyncFailoverChain`] is [`crate::failover::FailoverChain`] over [`AsyncProvider`]s, with
+//! the same rules:
+//!
+//! 1. A call moves to the next route only on an error the policy accepts ([`FailoverOn`], by
+//!    default [`crate::LlmError::is_failover_trigger`]) and only before the first token. Auth
+//!    and validation errors surface at once.
+//! 2. The caller's [`Classifier`] sees each error before the policy: an overload text in a 4xx
+//!    body or a capacity-gate refusal can fail over, an authority error can be pinned to not
+//!    failing over. `None` leaves the decision to the policy.
+//! 3. A stream that has not produced its first event within
+//!    [`FailoverPolicy::first_token_timeout`] fails over. The first event is read by the chain
+//!    and handed back at the head of the returned stream; from then on errors are not failed
+//!    over.
+//! 4. A route that fails over [`FailoverPolicy::breaker_threshold`] times inside
+//!    `breaker_window` is skipped for `breaker_cool_down` (a skipped route emits a
+//!    [`FailoverEvent`] with `breaker_skipped: true`).
+//! 5. When every route fails, one [`LlmError::AllRoutesFailed`] names each route and reason.
+//!
+//! [`FailoverEvent`] (`from`, `to`, `reason`, `breaker_skipped`) is what an engine turns into its
+//! route-updated event; set the observer with [`AsyncFailoverChain::on_failover`].
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use futures_util::{Stream, StreamExt};
+
+use crate::async_provider::{AsyncProvider, BoxFuture, EventStream};
+use crate::error::{Attempt, LlmError};
+use crate::failover::{
+    decide, Book, Classifier, FailoverEvent, FailoverOn, FailoverPolicy, Observer,
+};
+use crate::types::*;
+
+/// One route of an [`AsyncFailoverChain`].
+#[derive(Clone)]
+pub struct AsyncRoute {
+    pub name: String,
+    pub provider: Arc<dyn AsyncProvider>,
+    /// Model slug to use on this route (providers name models differently).
+    pub model: String,
+}
+
+impl AsyncRoute {
+    pub fn new(name: &str, provider: Arc<dyn AsyncProvider>, model: &str) -> Self {
+        Self {
+            name: name.into(),
+            provider,
+            model: model.into(),
+        }
+    }
+}
+
+/// Failover over async providers. See the module docs.
+pub struct AsyncFailoverChain {
+    routes: Vec<AsyncRoute>,
+    book: Book,
+    observer: Option<Observer>,
+    on: FailoverOn,
+    classifier: Option<Classifier>,
+}
+
+impl AsyncFailoverChain {
+    pub fn new(routes: Vec<AsyncRoute>, policy: FailoverPolicy) -> Self {
+        let book = Book::new(routes.iter().map(|r| r.name.clone()).collect(), policy);
+        Self {
+            routes,
+            book,
+            observer: None,
+            on: FailoverOn::default(),
+            classifier: None,
+        }
+    }
+
+    pub fn on_failover(mut self, f: impl Fn(&FailoverEvent) + Send + Sync + 'static) -> Self {
+        self.observer = Some(Box::new(f));
+        self
+    }
+
+    /// Choose which errors fail over. The default is [`FailoverOn::Retryable`].
+    pub fn fail_over_on(mut self, on: FailoverOn) -> Self {
+        self.on = on;
+        self
+    }
+
+    /// Install a [`Classifier`] that sees each error before the policy.
+    pub fn classify(
+        mut self,
+        f: impl Fn(&LlmError) -> Option<bool> + Send + Sync + 'static,
+    ) -> Self {
+        self.classifier = Some(Arc::new(f));
+        self
+    }
+
+    fn notify(&self, from: &str, to: Option<&str>, reason: &str, breaker_skipped: bool) {
+        if let Some(o) = &self.observer {
+            o(&FailoverEvent {
+                from: from.into(),
+                to: to.map(String::from),
+                reason: reason.into(),
+                breaker_skipped,
+            });
+        }
+    }
+
+    /// The routes to try, in order, after emitting the events for skipped cooling routes.
+    fn plan(&self) -> Vec<usize> {
+        let (order, skipped) = self.book.order();
+        let first = order.first().map(|&n| self.routes[n].name.clone());
+        for &s in &skipped {
+            self.notify(
+                &self.routes[s].name,
+                first.as_deref(),
+                "circuit open: route skipped without an attempt",
+                true,
+            );
+        }
+        order
+    }
+
+    /// Record a failed attempt on `order[pos]`.
+    fn failed(&self, order: &[usize], pos: usize, e: &LlmError, attempts: &mut Vec<Attempt>) {
+        let route = &self.routes[order[pos]];
+        let reason = e.to_string();
+        self.book.record_away(&route.name);
+        let next = order.get(pos + 1).map(|&n| self.routes[n].name.as_str());
+        self.notify(&route.name, next, &reason, false);
+        attempts.push(Attempt {
+            route: route.name.clone(),
+            reason,
+            billing: e.billing(),
+        });
+    }
+
+    fn request_for(&self, route: &AsyncRoute, req: &ChatRequest) -> ChatRequest {
+        let mut r = req.clone();
+        r.model = route.model.clone();
+        r
+    }
+
+    async fn run_complete(&self, req: &ChatRequest) -> Result<ChatResponse, LlmError> {
+        let order = self.plan();
+        let mut attempts: Vec<Attempt> = Vec::new();
+        for (pos, &i) in order.iter().enumerate() {
+            let route = &self.routes[i];
+            let r = self.request_for(route, req);
+            match route.provider.complete(&r).await {
+                Ok(v) => {
+                    self.book.record_success(&route.name);
+                    return Ok(v);
+                }
+                Err(e) if decide(&self.classifier, &self.on, &e) => {
+                    self.failed(&order, pos, &e, &mut attempts);
+                }
+                Err(e) => return Err(e),
+            }
+        }
+        Err(LlmError::AllRoutesFailed(attempts))
+    }
+
+    async fn run_stream(&self, req: &ChatRequest) -> Result<EventStream, LlmError> {
+        let order = self.plan();
+        let timeout: Duration = self.book.policy.first_token_timeout;
+        let mut attempts: Vec<Attempt> = Vec::new();
+        for (pos, &i) in order.iter().enumerate() {
+            let route = &self.routes[i];
+            let r = self.request_for(route, req);
+            let mut stream = match route.provider.stream(&r).await {
+                Ok(s) => s,
+                Err(e) if decide(&self.classifier, &self.on, &e) => {
+                    self.failed(&order, pos, &e, &mut attempts);
+                    continue;
+                }
+                Err(e) => return Err(e),
+            };
+            // Wait for the first event within the first-token deadline.
+            match tokio::time::timeout(timeout, stream.next()).await {
+                Err(_) => {
+                    let e = LlmError::Http(rightkit_http::HttpError::Timeout {
+                        message: "first token deadline".into(),
+                        phase: rightkit_http::Phase::Body,
+                    });
+                    drop(stream);
+                    if decide(&self.classifier, &self.on, &e) {
+                        self.failed(&order, pos, &e, &mut attempts);
+                        continue;
+                    }
+                    return Err(e);
+                }
+                Ok(Some(Err(e))) => {
+                    drop(stream);
+                    if decide(&self.classifier, &self.on, &e) {
+                        self.failed(&order, pos, &e, &mut attempts);
+                        continue;
+                    }
+                    return Err(e);
+                }
+                Ok(Some(Ok(first))) => {
+                    // From here on the caller has output: no more failover. A later error on
+                    // this stream is the caller's to see; it does not move the breaker.
+                    self.book.record_success(&route.name);
+                    let shared = stream.shared();
+                    let chained: std::pin::Pin<
+                        Box<dyn Stream<Item = Result<StreamEvent, LlmError>> + Send>,
+                    > = Box::pin(futures_util::stream::iter(vec![Ok(first)]).chain(stream));
+                    return Ok(EventStream::from_parts(chained, shared));
+                }
+                Ok(None) => {
+                    // The stream ended without an event (an empty answer): it is the answer.
+                    self.book.record_success(&route.name);
+                    return Ok(stream);
+                }
+            }
+        }
+        Err(LlmError::AllRoutesFailed(attempts))
+    }
+}
+
+impl AsyncProvider for AsyncFailoverChain {
+    fn id(&self) -> &str {
+        "failover"
+    }
+
+    fn complete<'a>(&'a self, req: &'a ChatRequest) -> BoxFuture<'a, Result<ChatResponse, LlmError>> {
+        Box::pin(self.run_complete(req))
+    }
+
+    fn stream<'a>(&'a self, req: &'a ChatRequest) -> BoxFuture<'a, Result<EventStream, LlmError>> {
+        Box::pin(self.run_stream(req))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::VecDeque;
+    use std::sync::Mutex;
+
+    type Calls = Arc<Mutex<Vec<String>>>;
+
+    /// A provider that answers from a script of results.
+    struct Scripted {
+        name: &'static str,
+        results: Mutex<VecDeque<Result<ChatResponse, LlmError>>>,
+        calls: Calls,
+    }
+
+    impl Scripted {
+        fn new(
+            name: &'static str,
+            results: Vec<Result<ChatResponse, LlmError>>,
+            calls: &Calls,
+        ) -> Arc<Self> {
+            Arc::new(Self {
+                name,
+                results: Mutex::new(results.into()),
+                calls: calls.clone(),
+            })
+        }
+    }
+
+    impl AsyncProvider for Scripted {
+        fn id(&self) -> &str {
+            self.name
+        }
+
+        fn complete<'a>(
+            &'a self,
+            req: &'a ChatRequest,
+        ) -> BoxFuture<'a, Result<ChatResponse, LlmError>> {
+            Box::pin(async move {
+                self.calls
+                    .lock()
+                    .unwrap()
+                    .push(format!("{}:{}", self.name, req.model));
+                self.results.lock().unwrap().pop_front().expect("scripted")
+            })
+        }
+
+        fn stream<'a>(&'a self, req: &'a ChatRequest) -> BoxFuture<'a, Result<EventStream, LlmError>> {
+            Box::pin(async move {
+                let r = self.complete(req).await?;
+                let shared = Arc::new(Mutex::new(Some(r.clone())));
+                let events: Vec<Result<StreamEvent, LlmError>> =
+                    vec![Ok(StreamEvent::Text(r.text()))];
+                Ok(EventStream::from_parts(
+                    Box::pin(futures_util::stream::iter(events)),
+                    shared,
+                ))
+            })
+        }
+    }
+
+    fn ok(text: &str) -> ChatResponse {
+        ChatResponse {
+            id: "r".into(),
+            model: "m".into(),
+            content: vec![ContentBlock::text(text)],
+            stop_reason: StopReason::EndTurn,
+            usage: Usage::default(),
+            usage_known: false,
+            metering: Metering::PerToken,
+        }
+    }
+
+    fn status(s: u16, message: &str) -> LlmError {
+        LlmError::Status {
+            status: s,
+            message: message.into(),
+            retry_after: None,
+        }
+    }
+
+    fn chain(a: Arc<Scripted>, b: Arc<Scripted>) -> AsyncFailoverChain {
+        AsyncFailoverChain::new(
+            vec![
+                AsyncRoute::new("a", a, "model-a"),
+                AsyncRoute::new("b", b, "model-b"),
+            ],
+            FailoverPolicy::default(),
+        )
+    }
+
+    #[tokio::test]

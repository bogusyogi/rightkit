+    #[test]
+    fn the_budget_stops_the_run_before_the_call_and_a_bigger_budget_resumes_it() {
+        let p = Scripted::new(&["O", "D"]);
+        let store = MemoryCheckpointStore::new();
+        let tight = SkillRunner::new(&p, &store).with_budget(Budget {

+    #[test]
+    fn a_commit_step_runs_exactly_once_across_resumes() {
+        let commits = Arc::new(AtomicUsize::new(0));
+        let c = commits.clone();
+        let plan = SkillPlan::new(
+            "plan",
+            vec![Box::new(
+                FnStep::new("publish", move |_| {
+                    c.fetch_add(1, Ordering::SeqCst);
+                    Ok(StepResult::Done(json!({"published": true})))
+                })
+                .with_effect(Effect::Commit),
+            ) as Box<dyn Step>],
+        );
+        let p = Scripted::new(&[]);
+        let store = MemoryCheckpointStore::new();
+        let runner = SkillRunner::new(&p, &store);
+        runner.start(&plan, "r", "b").unwrap();
+        runner.resume(&plan, "r", "b").unwrap();
+        runner.resume(&plan, "r", "b").unwrap();
+        assert_eq!(commits.load(Ordering::SeqCst), 1);
+    }

+// ---------------------------------------------------------------------------------------------
+// OpenAI-compatible chat completions
+
+/// Async OpenAI-compatible chat client (`POST {base}/chat/completions`).
+pub struct AsyncOpenAiCompatProvider {
+    id: String,
+    base_url: String,
+    client: AsyncClient,
+    credentials: Arc<dyn CredentialSource>,
+    requires_credential: bool,
+    extra_headers: Vec<(String, String)>,
+    max_tokens_field: MaxTokensField,
+    observer: Option<CallObserver>,
+    stream_policy: Option<StreamPolicy>,
+    request_auth: Option<Arc<dyn RequestAuth>>,
+    pre_send: Option<Arc<dyn PreSend>>,
+}
+
+impl AsyncOpenAiCompatProvider {
+    pub fn new(
+        id: &str,
+        base_url: &str,
+        client: AsyncClient,
+        credentials: Arc<dyn CredentialSource>,
+    ) -> Self {
+        Self {
+            id: id.into(),
+            base_url: base_url.trim_end_matches('/').to_string(),
+            client,
+            credentials,
+            requires_credential: true,
+            extra_headers: Vec::new(),
+            max_tokens_field: MaxTokensField::MaxTokens,
+            observer: None,
+            stream_policy: None,
+            request_auth: None,
+            pre_send: None,
+        }
+    }
+
+    pub fn without_credential(mut self) -> Self {
+        self.requires_credential = false;
+        self
+    }
+
+    pub fn with_header(mut self, name: &str, value: &str) -> Self {
+        self.extra_headers.push((name.into(), value.into()));
+        self
+    }
+
+    pub fn with_max_tokens_field(mut self, f: MaxTokensField) -> Self {
+        self.max_tokens_field = f;
+        self
+    }
+
+    /// Report every call that reaches the network. A stream is reported when it ends.
+    pub fn with_observer(mut self, f: impl Fn(&CallRecord<'_>) + Send + Sync + 'static) -> Self {
+        self.observer = Some(Arc::new(f));
+        self
+    }
+
+    /// Apply `policy` to every stream. See [`StreamPolicy`].
+    pub fn with_stream_policy(mut self, policy: StreamPolicy) -> Self {
+        self.stream_policy = Some(policy);
+        self
+    }
+
+    /// Authorize with `auth` instead of the `CredentialSource`. See [`crate::auth`].
+    pub fn with_request_auth(mut self, auth: Arc<dyn RequestAuth>) -> Self {
+        self.request_auth = Some(auth);
+        self
+    }
+
+    /// Run `hook` on the exact bytes before every send. See [`PreSend`].
+    pub fn with_pre_send(mut self, hook: Arc<dyn PreSend>) -> Self {
+        self.pre_send = Some(hook);
+        self
+    }
+
+    fn prepare_body(
+        &self,
+        body: Value,
+        model: &str,
+        stream: bool,
+        timeout: Option<Duration>,
+        retry: Option<&CallRetry>,
+    ) -> Result<Prepared, LlmError> {
+        let url = format!("{}/chat/completions", self.base_url);
+        let mut http = Request::post(url.clone())
+            .retry_unsafe_statuses(true)
+            .header("Accept", accept(stream));
+        if let Some(r) = retry {
+            http = r.apply(http);
+        }
+        let (http, secret) = authorize_bearer(
+            &self.id,
+            &self.credentials,
+            self.requires_credential,
+            &self.request_auth,
+            &self.extra_headers,
+            http,
+            Some(model),
+        )?;
+        finish_prepare(
+            &self.id,
+            &url,
+            stream,
+            http,
+            secret,
+            body,
+            timeout,
+            &self.pre_send,
+        )
+    }
+
+    fn prepare(&self, req: &ChatRequest, stream: bool) -> Result<Prepared, LlmError> {
+        req.check_images()?;
+        req.check_schema()?;
+        let mut body = openai::build_body(req, stream, self.max_tokens_field);
+        req.extra_body.merge_into(&mut body)?;
+        self.prepare_body(body, &req.model, stream, req.timeout, Some(&req.retry))
+    }
+
+    fn observe(&self, body: &Value) -> Option<Observe> {
+        self.observer.as_ref().map(|o| Observe {
+            observer: o.clone(),
+            provider: self.id.clone(),
+            body: body.clone(),
+        })
+    }
+
+    async fn complete_prepared(
+        &self,
+        p: Prepared,
+        req: &ChatRequest,
+    ) -> Result<ChatResponse, LlmError> {
+        let observe = self.observe(&p.body);
+        complete_call(
+            &self.client,
+            &p.http,
+            p.secret.as_deref(),
+            openai::parse_response,
+            req,
+            observe,
+        )
+        .await
+    }
+
+    async fn stream_prepared(
+        &self,
+        p: Prepared,
+        req: ChatRequest,
+    ) -> Result<EventStream, LlmError> {
+        let observe = self.observe(&p.body);
+        start_stream(
+            &self.client,
+            &p.http,
+            p.secret,
+            Machine::OpenAi(OpenAiStream::default()),
+            self.stream_policy,
+            req,
+            observe,
+        )
+        .await
+    }
+
+    /// Send `wire` (a chat-completions request body, OpenAI-shaped messages passed through
+    /// verbatim) and return the response.
+    pub async fn complete_wire(&self, wire: Value) -> Result<ChatResponse, LlmError> {
+        let req = stub_request(&wire);
+        let p = self.prepare_body(wire.clone(), &req.model, false, None, None)?;
+        self.complete_prepared(p, &req).await
+    }
+
+    /// Stream `wire`. `stream` and `stream_options.include_usage` are set; everything else is
+    /// sent as given.
+    pub async fn stream_wire(&self, mut wire: Value) -> Result<EventStream, LlmError> {
+        if let Some(obj) = wire.as_object_mut() {
+            obj.insert("stream".into(), json!(true));
+            obj.entry("stream_options")
+                .or_insert_with(|| json!({"include_usage": true}));
+        }
+        let req = stub_request(&wire);
+        let p = self.prepare_body(wire, &req.model, true, None, None)?;
+        self.stream_prepared(p, req).await
+    }
+}
+
+impl AsyncProvider for AsyncOpenAiCompatProvider {
+    fn id(&self) -> &str {
+        &self.id
+    }
+
+    fn complete<'a>(&'a self, req: &'a ChatRequest) -> BoxFuture<'a, Result<ChatResponse, LlmError>> {
+        Box::pin(async move {
+            let p = self.prepare(req, false)?;
+            self.complete_prepared(p, req).await
+        })
+    }
+
+    fn stream<'a>(&'a self, req: &'a ChatRequest) -> BoxFuture<'a, Result<EventStream, LlmError>> {
+        Box::pin(async move {
+            let p = self.prepare(req, true)?;
+            self.stream_prepared(p, req.clone()).await
+        })
+    }
+}

+// Anthropic Messages
+
+/// Async Anthropic Messages client (`POST {base}/v1/messages`).
+pub struct AsyncAnthropicProvider {
+    id: String,
+    base_url: String,
+    client: AsyncClient,
+    credentials: Arc<dyn CredentialSource>,
+    extra_headers: Vec<(String, String)>,
+    observer: Option<CallObserver>,
+    stream_policy: Option<StreamPolicy>,
+    request_auth: Option<Arc<dyn RequestAuth>>,
+    pre_send: Option<Arc<dyn PreSend>>,
+    cache_plan: Option<CacheControlPlan>,
+}
+
+impl AsyncAnthropicProvider {
+    pub fn new(base_url: &str, client: AsyncClient, credentials: Arc<dyn CredentialSource>) -> Self {
+        Self {
+            id: "anthropic".into(),
+            base_url: base_url.trim_end_matches('/').to_string(),
+            client,
+            credentials,
+            extra_headers: Vec::new(),
+            observer: None,
+            stream_policy: None,
+            request_auth: None,
+            pre_send: None,
+            cache_plan: None,
+        }
+    }
+
+    pub fn with_id(mut self, id: &str) -> Self {
+        self.id = id.to_string();
+        self
+    }
+
+    /// e.g. `anthropic-beta`.
+    pub fn with_header(mut self, name: &str, value: &str) -> Self {
+        self.extra_headers.push((name.into(), value.into()));
+        self
+    }
+
+    pub fn with_observer(mut self, f: impl Fn(&CallRecord<'_>) + Send + Sync + 'static) -> Self {
+        self.observer = Some(Arc::new(f));
+        self
+    }
+
+    pub fn with_stream_policy(mut self, policy: StreamPolicy) -> Self {
+        self.stream_policy = Some(policy);
+        self
+    }
+
+    /// Authorize with `auth` instead of the `x-api-key` credential. See [`crate::auth`].
+    pub fn with_request_auth(mut self, auth: Arc<dyn RequestAuth>) -> Self {
+        self.request_auth = Some(auth);
+        self
+    }
+
+    pub fn with_pre_send(mut self, hook: Arc<dyn PreSend>) -> Self {
+        self.pre_send = Some(hook);
+        self
+    }
+
+    /// Place cache breakpoints where the caller says. See [`CacheControlPlan`].
+    pub fn with_cache_plan(mut self, plan: CacheControlPlan) -> Self {
+        self.cache_plan = Some(plan);
+        self
+    }
+
+    fn prepare_body(
+        &self,
+        body: Value,
+        model: &str,
+        stream: bool,
+        timeout: Option<Duration>,
+        retry: Option<&CallRetry>,
+    ) -> Result<Prepared, LlmError> {
+        let url = format!("{}/v1/messages", self.base_url);
+        let mut http = Request::post(url.clone())
+            .retry_unsafe_statuses(true)
+            .header("anthropic-version", anthropic::ANTHROPIC_VERSION)
+            .header("Accept", accept(stream));
+        if let Some(r) = retry {
+            http = r.apply(http);
+        }
+        let (mut http, secret) = match &self.request_auth {
+            Some(auth) => {
+                let mut resolve = ResolveRequest::new(self.id.clone());
+                resolve.model = Some(model.to_owned());
+                let headers = auth.headers(&resolve)?;
+                crate::auth::apply_all(&headers, http)
+            }
+            None => {
+                let credential = self
+                    .credentials
+                    .credential(&self.id)?
+                    .ok_or_else(|| LlmError::MissingCredential(self.id.clone()))?;
+                (
+                    http.secret_header("x-api-key", credential.expose()),
+                    Some(credential.expose().to_string()),
+                )
+            }
+        };
+        for (k, v) in &self.extra_headers {
+            http = http.header(k.as_str(), v.as_str());
+        }
+        finish_prepare(
+            &self.id,
+            &url,
+            stream,
+            http,
+            secret,
+            body,
+            timeout,
+            &self.pre_send,
+        )
+    }
+
+    fn prepare(&self, req: &ChatRequest, stream: bool) -> Result<Prepared, LlmError> {
+        anthropic::check_empty_messages(req)?;
+        req.check_images()?;
+        req.check_schema()?;
+        let mut body = match &self.cache_plan {
+            Some(plan) => anthropic::build_body_with_plan(req, stream, plan)?,
+            None => anthropic::build_body(req, stream),
+        };
+        req.extra_body.merge_into(&mut body)?;
+        self.prepare_body(body, &req.model, stream, req.timeout, Some(&req.retry))
+    }
+
+    fn observe(&self, body: &Value) -> Option<Observe> {
+        self.observer.as_ref().map(|o| Observe {
+            observer: o.clone(),
+            provider: self.id.clone(),
+            body: body.clone(),
+        })
+    }
+
+    async fn complete_prepared(
+        &self,
+        p: Prepared,
+        req: &ChatRequest,
+    ) -> Result<ChatResponse, LlmError> {
+        let observe = self.observe(&p.body);
+        complete_call(
+            &self.client,
+            &p.http,
+            p.secret.as_deref(),
+            anthropic::parse_response,
+            req,
+            observe,
+        )
+        .await
+    }
+
+    async fn stream_prepared(
+        &self,
+        p: Prepared,
+        req: ChatRequest,
+    ) -> Result<EventStream, LlmError> {
+        let observe = self.observe(&p.body);
+        start_stream(
+            &self.client,
+            &p.http,
+            p.secret,
+            Machine::Anthropic {
+                asm: Assembler::default(),
+                stopped: false,
+                delivered: false,
+            },
+            self.stream_policy,
+            req,
+            observe,
+        )
+        .await
+    }
+
+    /// Send `wire` (a Messages request body, passed through verbatim) and return the response.
+    pub async fn complete_wire(&self, wire: Value) -> Result<ChatResponse, LlmError> {
+        let req = stub_request(&wire);
+        let p = self.prepare_body(wire, &req.model, false, None, None)?;
+        self.complete_prepared(p, &req).await
+    }
+
+    /// Stream `wire`; `stream: true` is set, everything else is sent as given.
+    pub async fn stream_wire(&self, mut wire: Value) -> Result<EventStream, LlmError> {
+        if let Some(obj) = wire.as_object_mut() {
+            obj.insert("stream".into(), json!(true));
+        }
+        let req = stub_request(&wire);
+        let p = self.prepare_body(wire, &req.model, true, None, None)?;
+        self.stream_prepared(p, req).await
+    }
+}
+
+impl AsyncProvider for AsyncAnthropicProvider {
+    fn id(&self) -> &str {
+        &self.id
+    }
+
+    fn complete<'a>(&'a self, req: &'a ChatRequest) -> BoxFuture<'a, Result<ChatResponse, LlmError>> {
+        Box::pin(async move {
+            let p = self.prepare(req, false)?;
+            self.complete_prepared(p, req).await
+        })
+    }
+
+    fn stream<'a>(&'a self, req: &'a ChatRequest) -> BoxFuture<'a, Result<EventStream, LlmError>> {
+        Box::pin(async move {
+            let p = self.prepare(req, true)?;
+            self.stream_prepared(p, req.clone()).await
+        })
+    }
+}

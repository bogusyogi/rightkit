+//! A resumable skill executor for multi-step model runs (Orthic-Labs/rightkit#296).
+//!
+//! A skill run is an ordered list of [`Step`]s. [`SkillRunner`] runs them one at a time and
+//! writes a checkpoint to a [`CheckpointStore`] at every boundary, so a run can stop at any point
+//! (a crash, a budget stop, a cancel) and resume from the last checkpoint:
+//!
+//! - **Restart at every boundary.** The state ([`RunState`]) is saved before a step is
+//!   dispatched, after it completes, and after every [`StepResult::Continue`] (a multi-item step
+//!   makes progress one item per call). A resumed run produces the same outputs as one that
+//!   never stopped.
+//! - **Crash after dispatch.** The `Dispatched` record is durable before the step runs. If the
+//!   process dies afterwards, the step's outcome is unknown, and a step that can spend money or
+//!   change the world ([`Effect::Paid`], [`Effect::Commit`]) is not run again on its own: the run
+//!   stops as [`RunStatus::Unresolved`] and the host resolves it with [`SkillRunner::resolve`]
+//!   (replay it, supply the output it observed, or fail the run). A [`Effect::Pure`] step is
+//!   simply run again.
+//! - **Commit once.** A [`Effect::Commit`] step is never replayed automatically, so its effect
+//!   happens at most once per run.
+//! - **Stale base refused.** A run records the `base` it started from (a revision, a digest, a
+//!   document version). [`SkillRunner::resume`] with a different base fails with
+//!   [`SkillError::StaleBase`] before any step runs.
+//! - **Budget stop before the call.** Every model call goes through [`StepContext::call`], which
+//!   checks the run's [`Budget`] (calls, input tokens, output tokens, USD) against the
+//!   request's worst case before sending. A call that would exceed it is not sent; the run
+//!   stops as [`RunStatus::BudgetStopped`] and can resume under a larger budget. With a price
+//!   table, a model with no price row blocks the call ([`SkillError::Unpriced`]) when a USD cap
+//!   or [`Budget::require_price`] is set; an unknown price is never read as free.
+//! - **Repair ceiling.** A step that returns [`StepResult::Retry`] with the defects it found
+//!   (a gate that rejected the output) is run again, up to [`Step::max_attempts`]; then the run
+//!   fails with the defects.
+//! - **Interrupt.** Setting the runner's cancel flag stops the run at the next boundary as
+//!   [`RunStatus::Interrupted`]; it resumes like any other stop.
+//!
+//! The executor knows nothing about what the steps mean: gates, memory rules and trust rules of a
+//! product live in its steps (a gate is a [`ModelStep::gate`], a refusal is a step returning an
+//! error). It adds no thread and no timer; it runs on the caller's thread.
+//!
+//! A step that makes several paid calls in one `run` loses the earlier calls if a later one is
+//! stopped by the budget: have such a step make one call per `run` and return
+//! [`StepResult::Continue`], or use [`BatchStep`].
+
+use std::collections::{BTreeMap, HashMap};
+use std::fmt;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+
+use crate::error::LlmError;
+use crate::pricing::PriceTable;
+use crate::provider::Provider;
+use crate::tokens::{count_request, EstimateCounter};
+use crate::types::{ChatRequest, ChatResponse, Metering, Spend, Usage};
+
+/// Schema of a saved [`RunState`].
+pub const STATE_VERSION: u32 = 1;
+
+/// What a step may do to the outside world, which decides whether it can be replayed after a
+/// crash between dispatch and completion.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Effect {
+    /// Deterministic and free: run it again.
+    Pure,
+    /// May spend (a model call): an unknown outcome is not replayed automatically.
+    Paid,
+    /// Changes the outside world (publish, write): at most once; an unknown outcome is not
+    /// replayed automatically.
+    Commit,
+}
+
+/// Caps on a run. `None` = unlimited. All are checked against the whole run, across resumes.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct Budget {
+    pub max_calls: Option<u32>,
+    pub max_input_tokens: Option<u64>,
+    pub max_output_tokens: Option<u64>,
+    pub max_usd: Option<f64>,
+    /// Refuse a model call whose model has no price row, even without a USD cap.
+    pub require_price: bool,
+}
+
+/// What a run has used so far.
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct Spent {
+    /// Model calls dispatched (including ones that failed after dispatch).
+    pub calls: u32,
+    pub input_tokens: u64,
+    pub output_tokens: u64,
+    pub usd: f64,
+    /// Calls dispatched whose usage was never reported; their cost is unknown, not zero.
+    pub unknown_calls: u32,
+}
+
+/// Why the executor refused to call or to continue.
+#[derive(Debug)]
+#[non_exhaustive]
+pub enum SkillError {
+    /// The budget would be exceeded by the call; nothing was sent.
+    BudgetStop(String),
+    /// The model has no price row and the budget needs one.
+    Unpriced { model: String },
+    /// The run was started from a different base than the one offered now.
+    StaleBase { recorded: String, offered: String },
+    /// A saved run does not match the plan (different step list).
+    PlanMismatch(String),
+    /// `start` was called for a run that already exists, or `resume` for one that does not.
+    RunExists(String),
+    RunMissing(String),
+    /// The run cannot be resolved or resumed in its current status.
+    BadStatus(String),
+    /// A model call failed.
+    Provider(LlmError),
+    /// The checkpoint store failed.
+    Store(String),
+    /// A step failed for its own reason.
+    Step(String),
+}
+
+impl fmt::Display for SkillError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            SkillError::BudgetStop(m) => write!(f, "budget stop: {m}"),
+            SkillError::Unpriced { model } => write!(f, "no price for model '{model}'"),
+            SkillError::StaleBase { recorded, offered } => write!(
+                f,
+                "run was started from base '{recorded}', not '{offered}'; refusing to resume"
+            ),
+            SkillError::PlanMismatch(m) => write!(f, "saved run does not match the plan: {m}"),
+            SkillError::RunExists(id) => write!(f, "run '{id}' already exists; resume it"),
+            SkillError::RunMissing(id) => write!(f, "run '{id}' does not exist"),
+            SkillError::BadStatus(m) => write!(f, "{m}"),
+            SkillError::Provider(e) => write!(f, "model call failed: {e}"),
+            SkillError::Store(m) => write!(f, "checkpoint store error: {m}"),
+            SkillError::Step(m) => write!(f, "{m}"),
+        }
+    }
+}
+
+impl std::error::Error for SkillError {}
+
+impl From<LlmError> for SkillError {
+    fn from(e: LlmError) -> Self {
+        SkillError::Provider(e)
+    }
+}
+
+/// Where a step stands.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub enum StepPhase {
+    Pending,
+    /// The step was started and its outcome is not recorded.
+    Dispatched,
+    Completed,
+    Failed(String),
+}
+
+/// The record of one step in a [`RunState`].
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct StepRecord {
+    pub id: String,
+    pub phase: StepPhase,
+    /// Dispatches since the step last made progress.
+    pub attempts: u32,
+    /// Progress a [`StepResult::Continue`] saved.
+    #[serde(default)]
+    pub progress: Option<Value>,
+    /// Defects the last [`StepResult::Retry`] reported.
+    #[serde(default)]
+    pub defects: Vec<String>,
+    #[serde(default)]
+    pub output: Option<Value>,
+}
+
+/// Where a run stands.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub enum RunStatus {
+    Running,
+    Interrupted,
+    BudgetStopped(String),
+    /// A paid or committing step was dispatched and its outcome is unknown.
+    Unresolved(String),
+    Failed {
+        step: String,
+        reason: String,
+    },
+    Completed,
+}

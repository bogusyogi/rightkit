+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::credentials::StaticCredentials;
+    use rightkit_http::testing::{loopback_config, MockResponse, MockServer};
+
+    fn client() -> AsyncClient {
+        AsyncClient::new(loopback_config()).unwrap()
+    }
+
+    fn creds() -> Arc<dyn CredentialSource> {
+        Arc::new(StaticCredentials::default().with("openai", "k-123"))
+    }
+
+    fn sse(frames: Vec<String>) -> MockResponse {
+        let refs: Vec<&str> = frames.iter().map(String::as_str).collect();
+        MockResponse::sse(&refs)
+    }
+
+    fn data(v: &str) -> String {
+        format!("data: {v}\n\n")
+    }
+
+    fn named(kind: &str, v: Value) -> String {
+        format!("event: {kind}\ndata: {v}\n\n")
+    }
+
+    fn chunk(delta: Value, finish: Option<&str>) -> String {
+        data(
+            &json!({"id": "c1", "model": "m",
+                "choices": [{"delta": delta, "finish_reason": finish}]})
+            .to_string(),
+        )
+    }
+
+    #[tokio::test]
+    async fn completes_and_streams_chat_completions() {
+        let server = MockServer::start(|req, _| {
+            if req.body_json()["stream"] == json!(true) {
+                sse(vec![
+                    chunk(json!({"content": "Hel"}), None),
+                    chunk(json!({"content": "lo"}), Some("stop")),
+                    data("[DONE]"),
+                ])
+            } else {
+                MockResponse::json(
+                    200,
+                    &json!({"id": "c", "model": "m",
+                        "choices": [{"message": {"content": "Hello"}, "finish_reason": "stop"}],
+                        "usage": {"prompt_tokens": 3, "completion_tokens": 2}}),
+                )
+            }
+        });
+        let p = AsyncOpenAiCompatProvider::new("openai", &server.base_url(), client(), creds());
+        let req = ChatRequest::simple("m", "", "hi");
+        let r = p.complete(&req).await.unwrap();
+        assert_eq!(r.text(), "Hello");
+        assert_eq!(r.usage.output_tokens, 2);
+
+        let mut s = p.stream(&req).await.unwrap();
+        let mut text = String::new();
+        while let Some(ev) = s.next().await {
+            if let StreamEvent::Text(t) = ev.unwrap() {
+                text.push_str(&t);
+            }
+        }
+        assert_eq!(text, "Hello");
+        assert_eq!(s.response().unwrap().text(), "Hello");
+    }
+
+    #[tokio::test]
+    async fn wire_history_is_sent_verbatim_and_pre_send_sees_the_bytes() {
+        let server = MockServer::start(|_, _| {
+            MockResponse::json(
+                200,
+                &json!({"id": "c", "model": "m",
+                    "choices": [{"message": {"content": "ok"}, "finish_reason": "stop"}]}),
+            )
+        });
+        let seen = Arc::new(Mutex::new(Vec::<u8>::new()));
+        let seen2 = seen.clone();
+        let p = AsyncOpenAiCompatProvider::new("openai", &server.base_url(), client(), creds())
+            .with_pre_send(Arc::new(move |prepared: &PreparedRequest<'_>| {
+                *seen2.lock().unwrap() = prepared.body.to_vec();
+                Ok(())
+            }));
+        let wire = json!({"model": "m", "messages": [
+            {"role": "assistant", "content": null, "reasoning_content": "thought",
+             "tool_calls": [{"id": "t1", "type": "function",
+                "function": {"name": "f", "arguments": "{}"}}]},
+            {"role": "tool", "tool_call_id": "t1", "content": "boom"}]});
+        p.complete_wire(wire.clone()).await.unwrap();
+        let sent: Value = serde_json::from_slice(&seen.lock().unwrap()).unwrap();
+        assert_eq!(sent, wire);
+        assert_eq!(server.requests()[0].body_json(), wire);
+    }
+
+    #[tokio::test]
+    async fn pre_send_refusal_sends_nothing() {

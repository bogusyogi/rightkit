index 0000000..c73956b
--- /dev/null
+++ b/crates/rightkit-llm/src/attempts.rs
@@ -0,0 +1,890 @@
+//! Per-physical-attempt observation and a two-budget retry ladder (Orthic-Labs/rightkit#658).
+//!
+//! [`ObservedProvider`] wraps any [`Provider`]. It makes each physical attempt with the inner
+//! provider's own retries switched off ([`ChatRequest::without_retries`]), so it sees every
+//! attempt, and it reports each one to an observer as an [`AttemptEvent`]:
+//!
+//! - [`AttemptEvent::Attempt`] carries a [`SubmissionReceipt`]: [`Submitted`], [`Rejected`] or
+//!   [`SubmissionUnknown`]. The receipt answers one question: may the same request be sent
+//!   again without risking a second billed generation? A request whose send outcome is unknown
+//!   is not replayed unless the ladder says so ([`AttemptLadder::retry_unknown`]).
+//! - [`AttemptEvent::RetryScheduled`] is the "retrying in N s (reason)" notice, before the wait.
+//!
+//! Two budgets are kept apart ([`RetryBudget`]): connection failures (nothing reached the
+//! server) climb [`AttemptLadder::connect`], a list of waits; HTTP status failures get
+//! [`AttemptLadder::status_retries`] retries with exponential backoff that honours the
+//! provider's `Retry-After` ([`LlmError::retry_after`]), capped by
+//! [`AttemptLadder::max_retry_after`]. Using up one budget does not touch the other.
+//!
+//! A stream is retried only while no event has reached the caller; after the first event the
+//! error is returned as it is.
+//!
+//! [`Submitted`]: SubmissionReceipt::Submitted
+//! [`Rejected`]: SubmissionReceipt::Rejected
+//! [`SubmissionUnknown`]: SubmissionReceipt::SubmissionUnknown
+//!
+//! # What the receipt means
+//!
+//! | outcome of the attempt | receipt |
+//! | --- | --- |
+//! | a successful answer | `Submitted` |
+//! | a rejected request before sending (invalid request, missing credential, address policy) | `Rejected` |
+//! | a connection failure (name lookup, connect, TLS) | `Rejected` (nothing reached the server) |
+//! | an HTTP error status, except 408 and 504 | `Rejected` (the provider answered with a refusal) |
+//! | a timeout or transport failure after the request was sent, HTTP 408 or 504 | `SubmissionUnknown` |
+//! | an error after output began (`MidStream`, `IncompleteOutput` with output) | `Submitted` |
+//! | any other error | `SubmissionUnknown` |
+
+use std::ops::ControlFlow;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use rightkit_http::HttpError;
+
+use crate::error::LlmError;
+use crate::provider::Provider;
+use crate::types::{ChatRequest, ChatResponse, StreamEvent};
+
+/// Whether the provider has the request, for the purpose of deciding on a replay.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SubmissionReceipt {
+    /// The provider accepted the request (it answered, or it started to stream output).
+    Submitted,
+    /// The request was refused or never reached the provider; sending it again is safe.
+    Rejected,
+    /// The request may have reached the provider; an unconditional replay could be billed twice.
+    SubmissionUnknown,
+}
+
+/// Which retry budget a wait belongs to.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RetryBudget {
+    /// Connection failures: nothing reached the server.
+    Connect,
+    /// HTTP status failures (and, when allowed, unknown outcomes).
+    Status,
+}
+
+/// One physical attempt.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AttemptRecord {
+    /// Provider id of the wrapped provider.
+    pub provider: String,
+    /// 1 for the first attempt, 2 for the first retry, and so on (across both budgets).
+    pub attempt: u32,
+    pub receipt: SubmissionReceipt,
+    /// HTTP status of the answer, when there was one.
+    pub status: Option<u16>,
+    /// The error text of a failed attempt (`LlmError` display, which never holds the
+    /// credential); `None` for a success.
+    pub error: Option<String>,
+}
+
+/// What the observer is told.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AttemptEvent {
+    /// An attempt ended.
+    Attempt(AttemptRecord),
+    /// A retry was decided; the wait starts now. Display it as "retrying in N s (reason)".
+    RetryScheduled {
+        provider: String,
+        /// Retry number about to run (1 = first retry).
+        retry: u32,
+        budget: RetryBudget,
+        delay: Duration,
+        reason: String,
+    },
+}
+
+/// Receiver of [`AttemptEvent`]s. Called on the calling thread; keep it quick.
+pub type AttemptObserver = Arc<dyn Fn(&AttemptEvent) + Send + Sync>;
+
+/// The receipt for a failed attempt. See the module table.
+pub fn receipt_for(error: &LlmError) -> SubmissionReceipt {
+    match error.root() {
+        LlmError::InvalidRequest(_)
+        | LlmError::MissingCredential(_)
+        | LlmError::Auth { .. }
+        | LlmError::Status {
+            status: 400..=407 | 409..=499 | 500..=503 | 505..=599,
+            ..
+        } => SubmissionReceipt::Rejected,
+        LlmError::Status { .. } => SubmissionReceipt::SubmissionUnknown,
+        LlmError::Http(e) => match e {
+            HttpError::Transport {
+                connect_phase: true,
+                ..
+            }
+            | HttpError::InvalidRequest(_)
+            | HttpError::AddressDenied { .. }
+            | HttpError::HttpsRequired { .. }
+            | HttpError::SystemProxyUnsupported { .. } => SubmissionReceipt::Rejected,
+            HttpError::Status { status, .. } if *status != 408 && *status != 504 => {
+                SubmissionReceipt::Rejected
+            }
+            _ => SubmissionReceipt::SubmissionUnknown,
+        },
+        LlmError::MidStream(_) | LlmError::Refused { .. } | LlmError::Truncated { .. } => {
+            SubmissionReceipt::Submitted
+        }
+        LlmError::IncompleteOutput { partial, .. } if !partial.is_empty() => {
+            SubmissionReceipt::Submitted
+        }
+        _ => SubmissionReceipt::SubmissionUnknown,
+    }
+}
+
+/// True when the error is a connection failure: the request cannot have reached the server.
+pub fn is_connect_failure(error: &LlmError) -> bool {
+    matches!(
+        error.root(),
+        LlmError::Http(HttpError::Transport {
+            connect_phase: true,
+            ..
+        })
+    )
+}
+
+/// The two retry budgets. See the module docs.
+#[derive(Debug, Clone, PartialEq)]
+pub struct AttemptLadder {
+    /// Waits before each connection retry, in order; its length is the connection budget.
+    pub connect: Vec<Duration>,
+    /// Retries after an HTTP status failure.
+    pub status_retries: u32,
+    /// Wait before the first status retry; doubles each time.
+    pub status_initial_backoff: Duration,
+    /// Longest backoff between status retries.
+    pub status_max_backoff: Duration,
+    /// Statuses that may be retried.
+    pub retry_statuses: Vec<u16>,
+    /// Use the provider's `Retry-After` when it is longer than the backoff.
+    pub honor_retry_after: bool,
+    /// Longest `Retry-After` honoured. A longer request ends the retries and the error is
+    /// returned, so the caller can schedule the next try itself.
+    pub max_retry_after: Duration,
+    /// Also retry an attempt whose receipt is [`SubmissionReceipt::SubmissionUnknown`], from the
+    /// status budget. Default `false`: an unknown outcome is returned, not replayed.
+    pub retry_unknown: bool,
+}
+
+impl Default for AttemptLadder {
+    fn default() -> Self {
+        Self {
+            connect: vec![
+                Duration::from_secs(1),
+                Duration::from_secs(2),
+                Duration::from_secs(5),
+            ],
+            status_retries: 3,
+            status_initial_backoff: Duration::from_secs(1),
+            status_max_backoff: Duration::from_secs(30),
+            retry_statuses: vec![425, 429, 500, 502, 503, 504, 529],
+            honor_retry_after: true,
+            max_retry_after: Duration::from_secs(60),
+            retry_unknown: false,
+        }
+    }
+}
+
+impl AttemptLadder {
+    /// No retries at all: every failure is returned after one observed attempt.
+    pub fn none() -> Self {
+        Self {
+            connect: Vec::new(),
+            status_retries: 0,
+            ..Self::default()
+        }
+    }
+
+    fn status_backoff(&self, retry: u32) -> Duration {
+        let exp = retry.saturating_sub(1).min(16);
+        let factor = 1u32 << exp;
+        self.status_initial_backoff
+            .saturating_mul(factor)
+            .min(self.status_max_backoff)
+    }
+}
+
+/// The decision for one failed attempt.
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Decision {
+    Retry {
+        budget: RetryBudget,
+        delay: Duration,
+    },
+    Stop,
+}
+
+struct Counters {
+    connect: usize,
+    status: u32,
+}
+
+impl AttemptLadder {
+    fn decide(&self, error: &LlmError, used: &Counters) -> Decision {
+        if is_connect_failure(error) {
+            return match self.connect.get(used.connect) {
+                Some(delay) => Decision::Retry {
+                    budget: RetryBudget::Connect,
+                    delay: *delay,
+                },
+                None => Decision::Stop,
+            };
+        }
+        if used.status >= self.status_retries {
+            return Decision::Stop;
+        }
+        let receipt = receipt_for(error);
+        let retryable = match receipt {
+            SubmissionReceipt::Rejected => error
+                .status()
+                .is_some_and(|s| self.retry_statuses.contains(&s)),
+            SubmissionReceipt::SubmissionUnknown => {
+                self.retry_unknown
+                    && error
+                        .status()
+                        .is_none_or(|s| self.retry_statuses.contains(&s))
+            }
+            SubmissionReceipt::Submitted => false,
+        };
+        if !retryable {
+            return Decision::Stop;
+        }
+        let retry = used.status + 1;
+        let backoff = self.status_backoff(retry);
+        let delay = match (self.honor_retry_after, error.retry_after()) {
+            (true, Some(ra)) if ra > self.max_retry_after => return Decision::Stop,
+            (true, Some(ra)) => backoff.max(ra),
+            _ => backoff,
+        };
+        Decision::Retry {
+            budget: RetryBudget::Status,
+            delay,
+        }
+    }
+}
+
+type Sleeper = Arc<dyn Fn(Duration) + Send + Sync>;
+
+/// A provider that reports every physical attempt of the wrapped provider and retries under an
+/// [`AttemptLadder`]. See the module docs.
+pub struct ObservedProvider<P: Provider> {
+    inner: P,
+    ladder: AttemptLadder,
+    observer: Option<AttemptObserver>,
+    sleeper: Sleeper,
+}
+
+impl<P: Provider> ObservedProvider<P> {
+    pub fn new(inner: P, ladder: AttemptLadder) -> Self {
+        Self {
+            inner,
+            ladder,
+            observer: None,
+            sleeper: Arc::new(std::thread::sleep),
+        }
+    }
+
+    /// Report attempts and retry notices to `f`.
+    pub fn on_attempt(mut self, f: impl Fn(&AttemptEvent) + Send + Sync + 'static) -> Self {
+        self.observer = Some(Arc::new(f));
+        self
+    }
+
+    /// Replace the wait (default `std::thread::sleep`), for tests and for hosts that wait on
+    /// their own cancellable timer.
+    pub fn with_sleeper(mut self, f: impl Fn(Duration) + Send + Sync + 'static) -> Self {
+        self.sleeper = Arc::new(f);
+        self
+    }
+
+    /// The wrapped provider.
+    pub fn inner(&self) -> &P {
+        &self.inner
+    }
+
+    fn emit(&self, event: AttemptEvent) {
+        if let Some(o) = &self.observer {
+            o(&event);
+        }
+    }
+
+    fn run<T>(
+        &self,
+        req: &ChatRequest,
+        mut call: impl FnMut(&ChatRequest, &mut bool) -> Result<T, LlmError>,
+    ) -> Result<T, LlmError> {
+        let started = Instant::now();
+        let single = req.clone().without_retries();
+        let mut used = Counters {
+            connect: 0,
+            status: 0,
+        };
+        let mut attempt = 0u32;
+        loop {
+            attempt += 1;
+            let mut delivered = false;
+            match call(&single, &mut delivered) {
+                Ok(v) => {
+                    self.emit(AttemptEvent::Attempt(AttemptRecord {
+                        provider: self.inner.id().to_owned(),
+                        attempt,
+                        receipt: SubmissionReceipt::Submitted,
+                        status: None,
+                        error: None,
+                    }));
+                    return Ok(v);
+                }
+                Err(e) => {
+                    let receipt = if delivered {
+                        SubmissionReceipt::Submitted
+                    } else {
+                        receipt_for(&e)
+                    };
+                    self.emit(AttemptEvent::Attempt(AttemptRecord {
+                        provider: self.inner.id().to_owned(),
+                        attempt,
+                        receipt,
+                        status: e.status(),
+                        error: Some(e.to_string()),
+                    }));
+                    if delivered {
+                        return Err(e);
+                    }
+                    let Decision::Retry { budget, delay } = self.ladder.decide(&e, &used) else {
+                        return Err(e);
+                    };
+                    if let Some(total) = req.timeout {
+                        if started.elapsed().saturating_add(delay) >= total {
+                            return Err(e);
+                        }
+                    }
+                    match budget {
+                        RetryBudget::Connect => used.connect += 1,
+                        RetryBudget::Status => used.status += 1,
+                    }
+                    self.emit(AttemptEvent::RetryScheduled {
+                        provider: self.inner.id().to_owned(),
+                        retry: attempt,
+                        budget,
+                        delay,
+                        reason: e.to_string(),
+                    });
+                    (self.sleeper)(delay);
+                }
+            }
+        }
+    }
+}
+
+impl<P: Provider> Provider for ObservedProvider<P> {
+    fn id(&self) -> &str {
+        self.inner.id()
+    }
+
+    fn complete(&self, req: &ChatRequest) -> Result<ChatResponse, LlmError> {
+        self.run(req, |r, _| self.inner.complete(r))
+    }
+
+    fn stream(
+        &self,
+        req: &ChatRequest,
+        on_event: &mut dyn FnMut(StreamEvent) -> ControlFlow<()>,
+    ) -> Result<ChatResponse, LlmError> {
+        self.run(req, |r, delivered| {
+            self.inner.stream(r, &mut |ev| {
+                *delivered = true;
+                on_event(ev)
+            })
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::sync::Mutex;
+
+    struct Script {
+        results: Mutex<Vec<Result<ChatResponse, LlmError>>>,
+        calls: AtomicUsize,
+        /// Emit one event before failing, to model output that already reached the caller.
+        emit_before_fail: bool,
+    }
+
+    impl Script {
+        fn new(mut results: Vec<Result<ChatResponse, LlmError>>) -> Self {
+            results.reverse();
+            Self {
+                results: Mutex::new(results),
+                calls: AtomicUsize::new(0),
+                emit_before_fail: false,
+            }
+        }
+    }
+
+    impl Provider for Script {
+        fn id(&self) -> &str {
+            "script"
+        }
+        fn complete(&self, req: &ChatRequest) -> Result<ChatResponse, LlmError> {
+            assert_eq!(req.retry, crate::types::CallRetry::Disabled);
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            self.results.lock().unwrap().pop().expect("scripted result")
+        }
+        fn stream(
+            &self,
+            req: &ChatRequest,
+            on_event: &mut dyn FnMut(StreamEvent) -> ControlFlow<()>,
+        ) -> Result<ChatResponse, LlmError> {
+            if self.emit_before_fail {
+                let _ = on_event(StreamEvent::Text("partial".into()));
+            }
+            self.complete(req)
+        }
+    }
+
+    fn ok() -> ChatResponse {
+        ChatResponse {
+            id: "r".into(),
+            model: "m".into(),
+            content: vec![crate::types::ContentBlock::text("hi")],
+            stop_reason: crate::types::StopReason::EndTurn,
+            usage: Default::default(),
+            usage_known: false,
+            metering: crate::types::Metering::PerToken,
+        }
+    }
+
+    fn status(s: u16, retry_after: Option<Duration>) -> LlmError {
+        LlmError::Status {
+            status: s,
+            message: "x".into(),
+            retry_after,
+        }
+    }
+
+    fn connect_failure() -> LlmError {
+        LlmError::Http(HttpError::Transport {
+            message: "refused".into(),
+            connect_phase: true,
+            phase: rightkit_http::Phase::Connect,
+        })
+    }
+
+    fn timeout_after_send() -> LlmError {
+        LlmError::Http(HttpError::Timeout {
+            message: "response".into(),
+            phase: rightkit_http::Phase::Headers,
+        })
+    }
+
+    fn observed(
+        script: Script,
+        ladder: AttemptLadder,
+    ) -> (
+        ObservedProvider<Script>,
+        Arc<Mutex<Vec<AttemptEvent>>>,
+        Arc<Mutex<Vec<Duration>>>,
+    ) {
+        let events = Arc::new(Mutex::new(Vec::new()));
+        let waits = Arc::new(Mutex::new(Vec::new()));
+        let (e2, w2) = (events.clone(), waits.clone());
+        let p = ObservedProvider::new(script, ladder)
+            .on_attempt(move |ev| e2.lock().unwrap().push(ev.clone()))
+            .with_sleeper(move |d| w2.lock().unwrap().push(d));
+        (p, events, waits)
+    }
+
+    #[test]
+    fn receipts_follow_the_table() {
+        assert_eq!(receipt_for(&connect_failure()), SubmissionReceipt::Rejected);
+        assert_eq!(receipt_for(&status(429, None)), SubmissionReceipt::Rejected);
+        assert_eq!(receipt_for(&status(503, None)), SubmissionReceipt::Rejected);
+        assert_eq!(
+            receipt_for(&status(504, None)),
+            SubmissionReceipt::SubmissionUnknown
+        );
+        assert_eq!(
+            receipt_for(&status(408, None)),
+            SubmissionReceipt::SubmissionUnknown
+        );
+        assert_eq!(
+            receipt_for(&timeout_after_send()),
+            SubmissionReceipt::SubmissionUnknown
+        );
+        assert_eq!(
+            receipt_for(&LlmError::InvalidRequest("x".into())),
+            SubmissionReceipt::Rejected
+        );
+        assert_eq!(
+            receipt_for(&LlmError::MidStream("x".into())),
+            SubmissionReceipt::Submitted
+        );
+    }
+
+    #[test]
+    fn connect_and_status_budgets_are_separate() {
+        let script = Script::new(vec![
+            Err(connect_failure()),
+            Err(status(503, Some(Duration::from_secs(7)))),
+            Err(connect_failure()),
+            Ok(ok()),
+        ]);
+        let (p, events, waits) = observed(script, AttemptLadder::default());
+        assert!(p.complete(&ChatRequest::simple("m", "", "u")).is_ok());
+        // First connect wait 1 s; status wait is the larger of the 1 s backoff and the 7 s
+        // Retry-After; the second connect failure takes the second rung of the connect ladder.
+        assert_eq!(
+            *waits.lock().unwrap(),
+            [
+                Duration::from_secs(1),
+                Duration::from_secs(7),
+                Duration::from_secs(2)
+            ]
+        );
+        let events = events.lock().unwrap();
+        let receipts: Vec<SubmissionReceipt> = events
+            .iter()
+            .filter_map(|e| match e {
+                AttemptEvent::Attempt(a) => Some(a.receipt),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(
+            receipts,
+            [
+                SubmissionReceipt::Rejected,
+                SubmissionReceipt::Rejected,
+                SubmissionReceipt::Rejected,
+                SubmissionReceipt::Submitted
+            ]
+        );
+        let notices = events
+            .iter()
+            .filter(|e| matches!(e, AttemptEvent::RetryScheduled { .. }))
+            .count();
+        assert_eq!(notices, 3);
+    }
+
+    #[test]
+    fn an_unknown_outcome_is_not_replayed_by_default() {
+        let script = Script::new(vec![Err(timeout_after_send()), Ok(ok())]);
+        let (p, events, _) = observed(script, AttemptLadder::default());
+        let err = p.complete(&ChatRequest::simple("m", "", "u")).unwrap_err();
+        assert!(matches!(err, LlmError::Http(HttpError::Timeout { .. })));
+        assert_eq!(p.inner().calls.load(Ordering::SeqCst), 1);
+        assert_eq!(events.lock().unwrap().len(), 1);
+
+        let script = Script::new(vec![Err(timeout_after_send()), Ok(ok())]);
+        let ladder = AttemptLadder {
+            retry_unknown: true,
+            ..AttemptLadder::default()
+        };
+        let (p, _, _) = observed(script, ladder);
+        assert!(p.complete(&ChatRequest::simple("m", "", "u")).is_ok());
+    }
+
+    #[test]
+    fn budgets_run_out_and_a_long_retry_after_ends_the_ladder() {
+        let script = Script::new(vec![
+            Err(status(500, None)),
+            Err(status(500, None)),
+            Err(status(500, None)),
+            Err(status(500, None)),
+        ]);
+        let (p, _, waits) = observed(script, AttemptLadder::default());
+        assert!(p.complete(&ChatRequest::simple("m", "", "u")).is_err());
+        assert_eq!(p.inner().calls.load(Ordering::SeqCst), 4);
+        assert_eq!(
+            *waits.lock().unwrap(),
+            [
+                Duration::from_secs(1),
+                Duration::from_secs(2),
+                Duration::from_secs(4)
+            ]
+        );
+
+        let script = Script::new(vec![Err(status(
+            429,
+            Some(Duration::from_secs(3600)),
+        ))]);
+        let (p, _, waits) = observed(script, AttemptLadder::default());
+        assert!(p.complete(&ChatRequest::simple("m", "", "u")).is_err());
+        assert!(waits.lock().unwrap().is_empty());
+    }
+
+    #[test]
+    fn a_stream_is_not_retried_after_output_reached_the_caller() {
+        let mut script = Script::new(vec![Err(status(503, None)), Ok(ok())]);
+        script.emit_before_fail = true;
+        let (p, events, _) = observed(script, AttemptLadder::default());
+        let mut seen = 0;
+        let err = p
+            .stream(&ChatRequest::simple("m", "", "u"), &mut |_| {
+                seen += 1;
+                ControlFlow::Continue(())
+            })
+            .unwrap_err();
+        assert!(matches!(err, LlmError::Status { status: 503, .. }));
+        assert_eq!(seen, 1);
+        assert_eq!(p.inner().calls.load(Ordering::SeqCst), 1);
+        let events = events.lock().unwrap();
+        assert!(matches!(
+            &events[0],
+            AttemptEvent::Attempt(AttemptRecord {
+                receipt: SubmissionReceipt::Submitted,
+                ..
+            })
+        ));
+    }
+
+    #[test]
+    fn none_ladder_makes_one_observed_attempt() {
+        let script = Script::new(vec![Err(connect_failure()), Ok(ok())]);
+        let (p, events, waits) = observed(script, AttemptLadder::none());
+        assert!(p.complete(&ChatRequest::simple("m", "", "u")).is_err());
+        assert!(waits.lock().unwrap().is_empty());
+        assert_eq!(events.lock().unwrap().len(), 1);
+    }
+}

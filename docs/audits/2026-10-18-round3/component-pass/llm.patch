+/// A boxed future, as returned by the object-safe [`AsyncProvider`] methods.
+pub type BoxFuture<'a, T> = Pin<Box<dyn Future<Output = T> + Send + 'a>>;
+
+/// The exact request about to be sent, given to a [`PreSend`] hook.
+#[derive(Debug)]
+pub struct PreparedRequest<'a> {
+    /// Provider id.
+    pub provider: &'a str,
+    /// Full request URL (no credential in it).
+    pub url: &'a str,
+    /// The request body, byte for byte as it goes on the wire.
+    pub body: &'a [u8],
+    pub stream: bool,
+}
+
+/// A check between request preparation and send. See the module docs.
+pub trait PreSend: Send + Sync {
+    /// `Ok(())` to send. An `Err` is returned to the caller and nothing is sent; use
+    /// [`LlmError::InvalidRequest`] for a capacity or authority refusal.
+    fn check(&self, prepared: &PreparedRequest<'_>) -> Result<(), LlmError>;
+}
+
+impl<F> PreSend for F
+where
+    F: Fn(&PreparedRequest<'_>) -> Result<(), LlmError> + Send + Sync,
+{
+    fn check(&self, prepared: &PreparedRequest<'_>) -> Result<(), LlmError> {
+        self(prepared)
+    }
+}
+
+/// A chat-completion backend for async callers.
+pub trait AsyncProvider: Send + Sync {
+    fn id(&self) -> &str;
+    fn complete<'a>(&'a self, req: &'a ChatRequest) -> BoxFuture<'a, Result<ChatResponse, LlmError>>;
+    fn stream<'a>(&'a self, req: &'a ChatRequest) -> BoxFuture<'a, Result<EventStream, LlmError>>;
+}
+
+pub(crate) type Shared = Arc<Mutex<Option<ChatResponse>>>;
+
+/// A stream of [`StreamEvent`]s with the assembled response available at the end. Dropping it
+/// cancels the request.
+pub struct EventStream {
+    inner: Pin<Box<dyn Stream<Item = Result<StreamEvent, LlmError>> + Send>>,
+    response: Shared,
+}
+
+impl EventStream {
+    pub(crate) fn from_parts(
+        inner: Pin<Box<dyn Stream<Item = Result<StreamEvent, LlmError>> + Send>>,
+        response: Shared,
+    ) -> Self {
+        Self { inner, response }
+    }
+
+    /// The slot the response is stored in, so a wrapper stream can keep answering
+    /// [`EventStream::response`].
+    pub(crate) fn shared(&self) -> Shared {
+        self.response.clone()
+    }
+
+    /// The assembled response, once the stream has ended without an error. `None` before that.
+    pub fn response(&self) -> Option<ChatResponse> {
+        self.response
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .clone()
+    }
+
+    /// Drain the remaining events and return the response, or the first error.
+    pub async fn finish(mut self) -> Result<ChatResponse, LlmError> {
+        while let Some(item) = self.next().await {
+            item?;
+        }
+        self.response().ok_or_else(|| {
+            LlmError::Malformed("stream ended without a response".into())
+        })
+    }
+}
+
+impl Stream for EventStream {
+    type Item = Result<StreamEvent, LlmError>;
+
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        self.inner.as_mut().poll_next(cx)
+    }
+}
+
+/// What one SSE frame did.
+enum Frame {
+    Events {
+        events: Vec<StreamEvent>,
+        progressed: bool,
+    },
+    /// The provider's end marker (`[DONE]`, `message_stop`, `response.completed`).
+    Ended,
+}
+
+/// The wire decoder for one stream.
+pub(crate) enum Machine {
+    OpenAi(OpenAiStream),
+    Anthropic {
+        asm: Assembler,
+        stopped: bool,
+        delivered: bool,
+    },
+    Responses(ResponsesStream),
+}
+
+impl Machine {
+    fn mark_delivered(&mut self) {
+        match self {
+            Machine::OpenAi(s) => s.delivered = true,
+            Machine::Anthropic { delivered, .. } => *delivered = true,
+            Machine::Responses(s) => s.delivered = true,
+        }
+    }
+
+    fn usage(&self) -> Usage {
+        match self {
+            Machine::OpenAi(s) => s.usage,
+            Machine::Anthropic { asm, .. } => asm.usage,
+            Machine::Responses(s) => s.usage,
+        }
+    }
+
+    fn incomplete(&self, cause: IncompleteCause) -> LlmError {
+        match self {
+            Machine::OpenAi(s) => s.incomplete(cause),
+            Machine::Anthropic { asm, .. } => asm.incomplete(cause),
+            Machine::Responses(s) => s.incomplete(cause),
+        }
+    }
+
+    fn transport_failure(&self, e: HttpError, policy: StreamPolicy) -> LlmError {
+        match self {
+            Machine::OpenAi(s) => s.transport_failure(e, policy),
+            Machine::Anthropic {
+                asm, delivered, ..
+            } => asm.transport_failure(e, policy, *delivered),
+            Machine::Responses(s) => s.transport_failure(e, policy),
+        }
+    }
+
+    fn on_frame(&mut self, ev: &SseEvent, key: Option<&str>) -> Result<Frame, LlmError> {
+        match self {
+            Machine::OpenAi(s) => {
+                if ev.data.trim() == "[DONE]" {
+                    s.done = true;
+                    return Ok(Frame::Ended);
+                }
+                let (events, progressed) = s.on_data(&ev.data, key)?;
+                Ok(Frame::Events { events, progressed })
+            }
+            Machine::Anthropic {
+                asm,
+                stopped,
+                delivered,
+            } => {
+                if ev.event == "ping" {
+                    return Ok(Frame::Events {
+                        events: Vec::new(),
+                        progressed: false,
+                    });
+                }
+                let data: Value = serde_json::from_str(&ev.data)
+                    .map_err(|e| anthropic::late_msg(format!("bad SSE JSON: {e}"), *delivered))?;
+                let kind = data
+                    .get("type")
+                    .and_then(Value::as_str)
+                    .unwrap_or(&ev.event)
+                    .to_string();
+                match kind.as_str() {
+                    "error" => {
+                        let e = &data["error"];
+                        let k = crate::error::redact_secret(
+                            e["type"].as_str().unwrap_or("error"),
+                            key,
+                        );
+                        let m = crate::error::redact_secret(
+                            e["message"].as_str().unwrap_or_default(),
+                            key,
+                        );
+                        Err(if *delivered {
+                            LlmError::MidStream(format!("{k}: {m}"))
+                        } else {
+                            LlmError::Provider {
+                                kind: k,
+                                message: m,
+                            }
+                        })
+                    }
+                    "message_stop" => {
+                        *stopped = true;
+                        Ok(Frame::Ended)
+                    }
+                    _ => {
+                        let events = asm.apply(&kind, &data);
+                        let progressed = asm.take_progress() || !events.is_empty();
+                        Ok(Frame::Events { events, progressed })
+                    }
+                }
+            }
+            Machine::Responses(s) => {
+                if ev.data.trim() == "[DONE]" {
+                    return Ok(Frame::Ended);
+                }
+                // The end (`response.completed`) is seen by `Machine::ended` after the events
+                // of this frame are delivered.
+                let (events, progressed) = s.on_event(&ev.event, &ev.data, key)?;
+                Ok(Frame::Events { events, progressed })
+            }
+        }
+    }
+
+    /// True once the provider's end marker was seen.
+    fn ended(&self) -> bool {
+        match self {
+            Machine::OpenAi(s) => s.done,
+            Machine::Anthropic { stopped, .. } => *stopped,
+            Machine::Responses(s) => s.done,
+        }
+    }
+
+    fn finish(
+        &mut self,
+        req: &ChatRequest,
+        require_finish: bool,
+    ) -> Result<ChatResponse, LlmError> {
+        match self {
+            Machine::OpenAi(s) => s.finish(req, require_finish),
+            Machine::Anthropic {
+                asm,
+                stopped,
+                delivered,
+            } => {
+                if !*stopped {
+                    if require_finish {
+                        return Err(asm.incomplete(IncompleteCause::MissingFinish));
+                    }
+                    return Err(anthropic::late_msg(
+                        "stream ended before message_stop".into(),
+                        *delivered,
+                    ));
+                }
+                asm.finish().and_then(|r| check_output(r, req))
+            }
+            Machine::Responses(s) => s.finish(req, require_finish),
+        }
+    }
+}
+
+/// What the observer needs at the end of a stream.
+struct Observe {
+    observer: CallObserver,
+    provider: String,
+    body: Value,
+}
+
+impl Observe {
+    fn call(&self, stream: bool, result: &Result<ChatResponse, LlmError>) {
+        (self.observer)(&CallRecord {
+            provider: &self.provider,
+            stream,
+            request_body: &self.body,
+            result: result.as_ref(),
+            raw: None,
+        });
+    }
+}
+
+struct StreamState {
+    sse: SseStream,
+    machine: Machine,
+    clock: ProgressClock,
+    policy: StreamPolicy,
+    queue: VecDeque<StreamEvent>,
+    req: ChatRequest,
+    key: Option<String>,
+    shared: Shared,
+    finished: bool,
+    observe: Option<Observe>,
+}
+
+impl StreamState {
+    /// Apply `report_failed_usage` to an error.
+    fn bill(&self, e: LlmError) -> LlmError {
+        let usage = self.machine.usage();
+        if self.req.report_failed_usage && usage != Usage::default() {
+            billed(
+                e,
+                &AttemptBilling::new(Spend::Reported(usage), Metering::PerToken),
+            )
+        } else {
+            e
+        }
+    }
+
+    fn fail(&mut self, e: LlmError) -> LlmError {
+        self.finished = true;
+        let e = self.bill(e);
+        if let Some(o) = &self.observe {
+            o.call(true, &Err(clone_for_observer(&e)));
+        }
+        e
+    }
+
+    /// End of stream: assemble the response. `Ok(())` stores it for [`EventStream::response`].
+    fn complete(&mut self) -> Result<(), LlmError> {
+        self.finished = true;
+        let require = self.clock.require_finish();
+        match self.machine.finish(&self.req, require) {
+            Ok(resp) => {
+                if let Some(o) = &self.observe {
+                    o.call(true, &Ok(resp.clone()));
+                }
+                *self.shared.lock().unwrap_or_else(|p| p.into_inner()) = Some(resp);
+                Ok(())
+            }
+            Err(e) => Err(self.fail(e)),
+        }
+    }
+}
+
+/// The observer gets a copy of the error text; `LlmError` is not `Clone`.
+fn clone_for_observer(e: &LlmError) -> LlmError {
+    LlmError::Malformed(e.to_string())
+}
+
+async fn next_item(mut s: StreamState) -> Option<(Result<StreamEvent, LlmError>, StreamState)> {
+    loop {
+        if let Some(ev) = s.queue.pop_front() {
+            s.machine.mark_delivered();
+            return Some((Ok(ev), s));
+        }
+        if s.finished {
+            return None;
+        }
+        if s.machine.ended() {
+            return match s.complete() {
+                Ok(()) => None,
+                Err(e) => Some((Err(e), s)),
+            };
+        }
+        let next = match s.clock.remaining(Instant::now()) {
+            Some((limit, cause)) => match tokio::time::timeout(limit, s.sse.next()).await {
+                Ok(item) => item,
+                Err(_) => {
+                    let e = s.machine.incomplete(cause);
+                    let e = s.fail(e);
+                    return Some((Err(e), s));
+                }
+            },
+            None => s.sse.next().await,
+        };
+        match next {
+            None => {
+                return match s.complete() {
+                    Ok(()) => None,
+                    Err(e) => Some((Err(e), s)),
+                };
+            }
+            Some(Err(e)) => {
+                let e = s.machine.transport_failure(e, s.policy);
+                let e = s.fail(e);
+                return Some((Err(e), s));
+            }
+            Some(Ok(ev)) => {
+                let now = Instant::now();
+                if let Some(cause) = s.clock.violation(now) {
+                    let e = s.machine.incomplete(cause);
+                    let e = s.fail(e);
+                    return Some((Err(e), s));
+                }
+                s.clock.frame(now);
+                match s.machine.on_frame(&ev, s.key.as_deref()) {
+                    Err(e) => {
+                        let e = s.fail(e);
+                        return Some((Err(e), s));
+                    }
+                    Ok(Frame::Ended) => {}
+                    Ok(Frame::Events { events, progressed }) => {
+                        if progressed {
+                            s.clock.progress(now);
+                        }
+                        s.queue.extend(events);
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Send `http` as a stream and decode it with `machine`.
+async fn start_stream(
+    client: &AsyncClient,
+    http: &Request,
+    secret: Option<String>,
+    machine: Machine,
+    policy: Option<StreamPolicy>,
+    req: ChatRequest,
+    observe: Option<Observe>,
+) -> Result<EventStream, LlmError> {
+    let response = client
+        .stream(http)
+        .await
+        .map_err(|e| LlmError::from_http(e, secret.as_deref()))?;
+    let clock = ProgressClock::new(policy);
+    let mut sse = response.sse();
+    if clock.require_finish() {
+        sse = sse.eof_policy(EofPolicy::Fail);
+    }
+    let shared: Shared = Arc::new(Mutex::new(None));
+    let state = StreamState {
+        sse,
+        machine,
+        policy: clock.policy(),
+        clock,
+        queue: VecDeque::new(),
+        req,
+        key: secret,
+        shared: shared.clone(),
+        finished: false,
+        observe,
+    };
+    Ok(EventStream::from_parts(
+        Box::pin(futures_util::stream::unfold(state, next_item)),
+        shared,
+    ))
+}
+
+/// Buffered call: send, parse with `parse`, apply the output check.
+async fn complete_call(
+    client: &AsyncClient,
+    http: &Request,
+    secret: Option<&str>,
+    parse: fn(&Value) -> Result<ChatResponse, LlmError>,
+    req: &ChatRequest,
+    observe: Option<Observe>,
+) -> Result<ChatResponse, LlmError> {
+    let result = async {
+        let resp = client
+            .send(http)
+            .await
+            .map_err(|e| LlmError::from_http(e, secret))?;
+        let v: Value = resp
+            .json()
+            .map_err(|e| LlmError::Malformed(e.to_string()))?;
+        let parsed = parse(&v)?;
+        check_output(parsed, req)
+    }
+    .await;
+    if let Some(o) = &observe {
+        o.call(false, &result);
+    }
+    result
+}
+
+/// A request ready to send.
+struct Prepared {
+    http: Request,
+    secret: Option<String>,
+    body: Value,
+}
+
+#[allow(clippy::too_many_arguments)]
+fn finish_prepare(
+    provider: &str,
+    url: &str,
+    stream: bool,
+    mut http: Request,
+    secret: Option<String>,
+    body: Value,
+    timeout: Option<Duration>,
+    pre_send: &Option<Arc<dyn PreSend>>,
+) -> Result<Prepared, LlmError> {
+    if let Some(limit) = timeout {
+        http = http.timeout(limit).deadline(limit);
+    }
+    let bytes = serde_json::to_vec(&body).map_err(|e| LlmError::InvalidRequest(e.to_string()))?;
+    if let Some(hook) = pre_send {
+        hook.check(&PreparedRequest {
+            provider,
+            url,
+            body: &bytes,
+            stream,
+        })?;
+    }
+    let http = http.header("Content-Type", "application/json").body(bytes);
+    Ok(Prepared { http, secret, body })
+}
+
+fn stub_request(body: &Value) -> ChatRequest {
+    ChatRequest::new(body["model"].as_str().unwrap_or_default(), Vec::new())
+}
+
+fn accept(stream: bool) -> &'static str {
+    if stream {
+        "text/event-stream"
+    } else {
+        "application/json"
+    }
+}
+
+/// Apply a key credential or request auth the way the blocking providers do.
+fn authorize_bearer(
+    id: &str,
+    credentials: &Arc<dyn CredentialSource>,
+    requires_credential: bool,
+    request_auth: &Option<Arc<dyn RequestAuth>>,
+    extra_headers: &[(String, String)],
+    mut http: Request,
+    model: Option<&str>,
+) -> Result<(Request, Option<String>), LlmError> {
+    if let Some(auth) = request_auth {
+        let mut resolve = ResolveRequest::new(id);
+        resolve.model = model.map(str::to_owned);
+        let headers = auth.headers(&resolve)?;
+        let (applied, secret) = crate::auth::apply_all(&headers, http);
+        http = applied;
+        for (k, v) in extra_headers {
+            http = http.header(k.as_str(), v.as_str());
+        }
+        return Ok((http, secret));
+    }
+    let mut secret = None;
+    match credentials.credential(id)? {
+        Some(c) => {
+            secret = Some(c.expose().to_string());
+            http = http.bearer(c.expose());
+        }
+        None if requires_credential => return Err(LlmError::MissingCredential(id.to_owned())),
+        None => {}
+    }
+    for (k, v) in extra_headers {
+        http = http.header(k.as_str(), v.as_str());
+    }
+    Ok((http, secret))
+}

+/// Where a caller wants an Anthropic `cache_control` breakpoint
+/// (Orthic-Labs/rightkit#656). See [`CacheControlPlan`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum CacheAnchor {
+    /// The last tool definition.
+    LastTool,
+    /// The first system block (a request has one system block, so this is the same block as
+    /// [`CacheAnchor::LastSystem`]).
+    FirstSystem,
+    /// The last system block.
+    LastSystem,
+    /// The last content block of the last message (the trailing turn).
+    TrailingMessage,
+}
+
+/// A caller-chosen list of cache breakpoints, applied to an Anthropic request body instead of
+/// the automatic planner ([`crate::CacheMode::Auto`]). Several anchors may name the same block;
+/// it is marked once. At most [`MAX_BREAKPOINTS`] distinct blocks may be marked.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct CacheControlPlan {
+    pub anchors: Vec<CacheAnchor>,
+}
+
+impl CacheControlPlan {
+    pub fn new(anchors: Vec<CacheAnchor>) -> Self {
+        Self { anchors }
+    }
+
+    /// Tools, system and trailing turn: the three anchors CodeRight places.
+    pub fn standard() -> Self {
+        Self::new(vec![
+            CacheAnchor::LastTool,
+            CacheAnchor::LastSystem,
+            CacheAnchor::TrailingMessage,
+        ])
+    }
+
+    /// Mark the anchored blocks of `body` (an Anthropic Messages request body). An anchor whose
+    /// section is absent (no tools, no system prompt, no messages) is skipped. A plain-string
+    /// `system` becomes a one-block array so it can carry the marker.
+    pub fn apply(&self, body: &mut serde_json::Value) -> Result<(), crate::error::LlmError> {
+        let mut distinct = self.anchors.clone();
+        distinct.sort_by_key(|a| match a {
+            CacheAnchor::LastTool => 0,
+            CacheAnchor::FirstSystem | CacheAnchor::LastSystem => 1,
+            CacheAnchor::TrailingMessage => 2,
+        });
+        distinct.dedup_by_key(|a| match a {
+            CacheAnchor::LastTool => 0,
+            CacheAnchor::FirstSystem | CacheAnchor::LastSystem => 1,
+            CacheAnchor::TrailingMessage => 2,
+        });
+        if distinct.len() > MAX_BREAKPOINTS {
+            return Err(crate::error::LlmError::InvalidRequest(format!(
+                "a cache plan may mark at most {MAX_BREAKPOINTS} blocks"
+            )));
+        }
+        let marker = serde_json::json!({"type": "ephemeral"});
+        for anchor in distinct {
+            match anchor {
+                CacheAnchor::LastTool => {
+                    if let Some(tool) = body
+                        .get_mut("tools")
+                        .and_then(serde_json::Value::as_array_mut)
+                        .and_then(|t| t.last_mut())
+                    {
+                        tool["cache_control"] = marker.clone();
+                    }
+                }
+                CacheAnchor::FirstSystem | CacheAnchor::LastSystem => {
+                    let Some(system) = body.get_mut("system") else {
+                        continue;
+                    };
+                    if let Some(text) = system.as_str().map(str::to_owned) {
+                        *system = serde_json::json!([{"type": "text", "text": text}]);
+                    }
+                    let index = match anchor {
+                        CacheAnchor::FirstSystem => Some(0),
+                        _ => system.as_array().and_then(|a| a.len().checked_sub(1)),
+                    };
+                    if let Some(block) = index.and_then(|i| system.get_mut(i)) {
+                        block["cache_control"] = marker.clone();
+                    }
+                }
+                CacheAnchor::TrailingMessage => {
+                    if let Some(block) = body
+                        .get_mut("messages")
+                        .and_then(serde_json::Value::as_array_mut)
+                        .and_then(|m| m.last_mut())
+                        .and_then(|m| m.get_mut("content"))
+                        .and_then(serde_json::Value::as_array_mut)
+                        .and_then(|c| c.last_mut())
+                    {
+                        block["cache_control"] = marker.clone();
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod plan_tests {
+    use super::*;
+    use serde_json::json;
+
+    fn body() -> serde_json::Value {
+        json!({
+            "model": "m",
+            "tools": [{"name": "a"}, {"name": "b"}],
+            "system": "be brief",
+            "messages": [
+                {"role": "user", "content": [{"type": "text", "text": "one"}]},
+                {"role": "user", "content": [{"type": "text", "text": "x"}, {"type": "text", "text": "two"}]}
+            ]
+        })
+    }
+
+    #[test]
+    fn standard_plan_marks_last_tool_system_and_trailing_block() {
+        let mut b = body();
+        CacheControlPlan::standard().apply(&mut b).unwrap();
+        assert!(b["tools"][0].get("cache_control").is_none());
+        assert_eq!(b["tools"][1]["cache_control"]["type"], "ephemeral");
+        assert_eq!(b["system"][0]["text"], "be brief");
+        assert_eq!(b["system"][0]["cache_control"]["type"], "ephemeral");
+        assert!(b["messages"][0]["content"][0].get("cache_control").is_none());
+        assert!(b["messages"][1]["content"][0].get("cache_control").is_none());
+        assert_eq!(
+            b["messages"][1]["content"][1]["cache_control"]["type"],
+            "ephemeral"
+        );
+    }
+
+    #[test]
+    fn first_and_last_system_are_one_block_and_absent_sections_are_skipped() {
+        let mut b = json!({"model": "m", "system": "s", "messages": []});
+        CacheControlPlan::new(vec![
+            CacheAnchor::FirstSystem,
+            CacheAnchor::LastSystem,
+            CacheAnchor::LastTool,
+            CacheAnchor::TrailingMessage,
+        ])
+        .apply(&mut b)
+        .unwrap();
+        assert_eq!(b["system"][0]["cache_control"]["type"], "ephemeral");
+        assert!(b.get("tools").is_none());
+    }
+}

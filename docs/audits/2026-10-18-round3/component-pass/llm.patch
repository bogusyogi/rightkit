+/// Everything a resume needs.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct RunState {
+    pub version: u32,
+    pub run_id: String,
+    pub plan_id: String,
+    /// The base the run started from. See the module docs.
+    pub base: String,
+    pub status: RunStatus,
+    pub steps: Vec<StepRecord>,
+    pub spent: Spent,
+}
+
+/// Saves and loads [`RunState`]. `save` must be durable when it returns: the executor relies on
+/// it for the dispatch record.
+pub trait CheckpointStore: Send + Sync {
+    fn load(&self, run_id: &str) -> Result<Option<RunState>, SkillError>;
+    fn save(&self, state: &RunState) -> Result<(), SkillError>;
+}
+
+/// Checkpoints in memory (tests, short-lived runs). Not durable across a process exit.
+#[derive(Default)]
+pub struct MemoryCheckpointStore {
+    states: Mutex<HashMap<String, String>>,
+}
+
+impl MemoryCheckpointStore {
+    pub fn new() -> Self {
+        Self::default()
+    }
+}
+
+impl CheckpointStore for MemoryCheckpointStore {
+    fn load(&self, run_id: &str) -> Result<Option<RunState>, SkillError> {
+        let g = self.states.lock().unwrap_or_else(|p| p.into_inner());
+        g.get(run_id)
+            .map(|s| serde_json::from_str(s).map_err(|e| SkillError::Store(e.to_string())))
+            .transpose()
+    }
+
+    fn save(&self, state: &RunState) -> Result<(), SkillError> {
+        let text = serde_json::to_string(state).map_err(|e| SkillError::Store(e.to_string()))?;
+        self.states
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .insert(state.run_id.clone(), text);
+        Ok(())
+    }
+}
+
+/// Checkpoints as `<dir>/<run_id>.json`, written through a temporary file that is synced and
+/// renamed. A run id is 1 to 128 characters from `a-z`, `A-Z`, `0-9`, `-`, `_` and `.`, and
+/// not `.` or `..`.
+#[derive(Debug, Clone)]
+pub struct FileCheckpointStore {
+    dir: PathBuf,
+}
+
+impl FileCheckpointStore {
+    pub fn new(dir: impl Into<PathBuf>) -> Self {
+        Self { dir: dir.into() }
+    }
+
+    fn path(&self, run_id: &str) -> Result<PathBuf, SkillError> {
+        let ok = !run_id.is_empty()
+            && run_id.len() <= 128
+            && run_id != "."
+            && run_id != ".."
+            && run_id
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.'));
+        if !ok {
+            return Err(SkillError::Store(format!(
+                "run id '{run_id}' is not 1 to 128 of a-z A-Z 0-9 - _ ."
+            )));
+        }
+        Ok(self.dir.join(format!("{run_id}.json")))
+    }
+}
+
+impl CheckpointStore for FileCheckpointStore {
+    fn load(&self, run_id: &str) -> Result<Option<RunState>, SkillError> {
+        let path = self.path(run_id)?;
+        match std::fs::read_to_string(&path) {
+            Ok(text) => serde_json::from_str(&text)
+                .map(Some)
+                .map_err(|e| SkillError::Store(format!("{}: {e}", path.display()))),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(None),
+            Err(e) => Err(SkillError::Store(e.to_string())),
+        }
+    }
+
+    fn save(&self, state: &RunState) -> Result<(), SkillError> {
+        use std::io::Write as _;
+        let path = self.path(&state.run_id)?;
+        let store = |e: std::io::Error| SkillError::Store(e.to_string());
+        std::fs::create_dir_all(&self.dir).map_err(store)?;
+        let text = serde_json::to_vec(state).map_err(|e| SkillError::Store(e.to_string()))?;
+        let tmp = path.with_extension("json.tmp");
+        {
+            let mut f = std::fs::File::create(&tmp).map_err(store)?;
+            f.write_all(&text).map_err(store)?;
+            f.sync_all().map_err(store)?;
+        }
+        if std::fs::rename(&tmp, &path).is_err() {
+            // Windows may refuse to rename over an existing file.
+            let _ = std::fs::remove_file(&path);
+            std::fs::rename(&tmp, &path).map_err(store)?;
+        }
+        Ok(())
+    }
+}
+
+/// Enforces the [`Budget`] and tallies [`Spent`] for one run.
+struct Ledger<'a> {
+    budget: &'a Budget,
+    prices: Option<&'a PriceTable>,
+    spent: Mutex<Spent>,
+}
+
+impl Ledger<'_> {
+    fn snapshot(&self) -> Spent {
+        self.spent.lock().unwrap_or_else(|p| p.into_inner()).clone()
+    }
+
+    /// Check `req` against the budget before it is sent.
+    fn admit(&self, req: &ChatRequest) -> Result<(), SkillError> {
+        let spent = self.snapshot();
+        let b = self.budget;
+        if let Some(max) = b.max_calls {
+            if spent.calls >= max {
+                return Err(SkillError::BudgetStop(format!("{max} model calls used")));
+            }
+        }
+        let input = count_request(&EstimateCounter, req).total.tokens;
+        let output = u64::from(req.max_tokens);
+        if let Some(max) = b.max_input_tokens {
+            if spent.input_tokens.saturating_add(input) > max {
+                return Err(SkillError::BudgetStop(format!(
+                    "the call needs about {input} input tokens; the {max} cap leaves {}",
+                    max.saturating_sub(spent.input_tokens)
+                )));
+            }
+        }
+        if let Some(max) = b.max_output_tokens {
+            if spent.output_tokens.saturating_add(output) > max {
+                return Err(SkillError::BudgetStop(format!(
+                    "the call may produce {output} output tokens; the {max} cap leaves {}",
+                    max.saturating_sub(spent.output_tokens)
+                )));
+            }
+        }
+        if b.max_usd.is_some() || b.require_price {
+            let worst = Usage {
+                input_tokens: input,
+                output_tokens: output,
+                ..Usage::default()
+            };
+            let priced = self.prices.and_then(|t| t.cost(&req.model, &worst));
+            let Some(cost) = priced else {
+                return Err(SkillError::Unpriced {
+                    model: req.model.clone(),
+                });
+            };
+            if let Some(max) = b.max_usd {
+                if spent.usd + cost > max {
+                    return Err(SkillError::BudgetStop(format!(
+                        "the call may cost ${cost:.4}; the ${max:.2} cap leaves ${:.4}",
+                        (max - spent.usd).max(0.0)
+                    )));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn record_response(&self, r: &ChatResponse) {
+        let mut s = self.spent.lock().unwrap_or_else(|p| p.into_inner());
+        s.calls += 1;
+        if r.usage_known {
+            s.input_tokens += r.usage.input_tokens
+                + r.usage.cache_read_tokens
+                + r.usage.cache_write_tokens;
+            s.output_tokens += r.usage.output_tokens;
+            if r.metering == Metering::PerToken {
+                if let Some(cost) = self.prices.and_then(|t| t.cost_of(r)) {
+                    s.usd += cost;
+                } else if self.budget.max_usd.is_some() {
+                    s.unknown_calls += 1;
+                }
+            }
+        } else {
+            s.unknown_calls += 1;
+        }
+    }
+
+    fn record_failure(&self, e: &LlmError) {
+        let billing = e.billing();
+        if !billing.may_have_spend() {
+            return;
+        }
+        let mut s = self.spent.lock().unwrap_or_else(|p| p.into_inner());
+        s.calls += 1;
+        match billing.spend {
+            Spend::Reported(u) => {
+                s.input_tokens += u.input_tokens + u.cache_read_tokens + u.cache_write_tokens;
+                s.output_tokens += u.output_tokens;
+            }
+            _ => s.unknown_calls += 1,
+        }
+    }
+}
+
+/// What a step sees while it runs.
+pub struct StepContext<'a> {
+    run_id: &'a str,
+    outputs: &'a BTreeMap<String, Value>,
+    progress: Option<&'a Value>,
+    defects: &'a [String],
+    attempt: u32,
+    provider: &'a dyn Provider,
+    ledger: &'a Ledger<'a>,
+}
+
+impl StepContext<'_> {
+    pub fn run_id(&self) -> &str {
+        self.run_id
+    }
+
+    /// Outputs of the steps that completed before this one, by step id.
+    pub fn outputs(&self) -> &BTreeMap<String, Value> {
+        self.outputs
+    }
+
+    /// The progress this step saved with its last [`StepResult::Continue`].
+    pub fn progress(&self) -> Option<&Value> {
+        self.progress
+    }
+
+    /// The defects the previous attempt reported with [`StepResult::Retry`] (empty on the
+    /// first attempt), for a step that repairs its own output.
+    pub fn defects(&self) -> &[String] {
+        self.defects
+    }
+
+    /// 1 for the first dispatch since the step last made progress.
+    pub fn attempt(&self) -> u32 {
+        self.attempt
+    }
+
+    /// Make a model call under the run's budget. The budget is checked before the call is
+    /// sent; usage is tallied after it.
+    pub fn call(&self, req: &ChatRequest) -> Result<ChatResponse, SkillError> {
+        self.ledger.admit(req)?;
+        match self.provider.complete(req) {
+            Ok(r) => {
+                self.ledger.record_response(&r);
+                Ok(r)
+            }
+            Err(e) => {
+                self.ledger.record_failure(&e);
+                Err(SkillError::Provider(e))
+            }
+        }
+    }
+}
+
+/// The result of running a step once.
+#[derive(Debug, Clone, PartialEq)]
+pub enum StepResult {
+    /// The step is finished; this is its output.
+    Done(Value),
+    /// The step made progress and is not finished. The value is saved and shown to the next
+    /// call as [`StepContext::progress`]. This is a checkpoint boundary.
+    Continue(Value),
+    /// The output was rejected; these are the defects. Run the step again, up to
+    /// [`Step::max_attempts`].
+    Retry(Vec<String>),
+}
+
+/// One step of a skill.
+pub trait Step: Send + Sync {
+    fn id(&self) -> &str;
+
+    /// What running this step can do. Default [`Effect::Paid`], the cautious choice.
+    fn effect(&self) -> Effect {
+        Effect::Paid
+    }
+
+    /// Dispatches allowed without progress, including the first. Default 1: no repair.
+    fn max_attempts(&self) -> u32 {
+        1
+    }
+
+    fn run(&self, cx: &StepContext<'_>) -> Result<StepResult, SkillError>;
+}
+
+type StepFn = Box<dyn Fn(&StepContext<'_>) -> Result<StepResult, SkillError> + Send + Sync>;
+
+/// A step from a closure.
+pub struct FnStep {
+    id: String,
+    effect: Effect,
+    max_attempts: u32,
+    run: StepFn,
+}
+
+impl FnStep {
+    pub fn new(
+        id: impl Into<String>,
+        run: impl Fn(&StepContext<'_>) -> Result<StepResult, SkillError> + Send + Sync + 'static,
+    ) -> Self {
+        Self {
+            id: id.into(),
+            effect: Effect::Paid,
+            max_attempts: 1,
+            run: Box::new(run),
+        }
+    }
+
+    pub fn with_effect(mut self, effect: Effect) -> Self {
+        self.effect = effect;
+        self
+    }
+
+    pub fn with_max_attempts(mut self, attempts: u32) -> Self {
+        self.max_attempts = attempts.max(1);
+        self
+    }
+}
+
+impl Step for FnStep {
+    fn id(&self) -> &str {
+        &self.id
+    }
+    fn effect(&self) -> Effect {
+        self.effect
+    }
+    fn max_attempts(&self) -> u32 {
+        self.max_attempts
+    }
+    fn run(&self, cx: &StepContext<'_>) -> Result<StepResult, SkillError> {
+        (self.run)(cx)
+    }
+}
+
+type BuildFn = Box<dyn Fn(&StepContext<'_>) -> Result<ChatRequest, SkillError> + Send + Sync>;
+type GateFn = Box<dyn Fn(&Value) -> Vec<String> + Send + Sync>;
+
+/// A step that makes one model call. The output is `{"text": <answer text>}`, plus `"json"` when
+/// [`ModelStep::json_output`] is set. A [`ModelStep::gate`] inspects the output and returns
+/// defects; any defect makes the step retry (the build closure sees them as
+/// [`StepContext::defects`]) until [`ModelStep::with_max_attempts`] is reached.
+pub struct ModelStep {
+    id: String,
+    build: BuildFn,
+    gate: Option<GateFn>,
+    json: bool,
+    max_attempts: u32,
+}
+
+impl ModelStep {
+    pub fn new(
+        id: impl Into<String>,
+        build: impl Fn(&StepContext<'_>) -> Result<ChatRequest, SkillError> + Send + Sync + 'static,
+    ) -> Self {
+        Self {
+            id: id.into(),
+            build: Box::new(build),
+            gate: None,
+            json: false,
+            max_attempts: 1,
+        }
+    }
+
+    /// Parse the answer text as JSON into the output's `json` field; unparsable text is a
+    /// defect.
+    pub fn json_output(mut self) -> Self {
+        self.json = true;
+        self
+    }
+
+    /// Check the output; every returned string is a defect.
+    pub fn gate(mut self, gate: impl Fn(&Value) -> Vec<String> + Send + Sync + 'static) -> Self {
+        self.gate = Some(Box::new(gate));
+        self
+    }
+
+    pub fn with_max_attempts(mut self, attempts: u32) -> Self {
+        self.max_attempts = attempts.max(1);
+        self
+    }
+}
+
+impl Step for ModelStep {
+    fn id(&self) -> &str {
+        &self.id
+    }
+    fn max_attempts(&self) -> u32 {
+        self.max_attempts
+    }
+    fn run(&self, cx: &StepContext<'_>) -> Result<StepResult, SkillError> {
+        let req = (self.build)(cx)?;
+        let resp = cx.call(&req)?;
+        let text = resp.text();
+        let mut out = json!({"text": text});
+        if self.json {
+            match serde_json::from_str::<Value>(text.trim()) {
+                Ok(v) => out["json"] = v,
+                Err(e) => return Ok(StepResult::Retry(vec![format!("answer is not JSON: {e}")])),
+            }
+        }
+        if let Some(gate) = &self.gate {
+            let defects = gate(&out);
+            if !defects.is_empty() {
+                return Ok(StepResult::Retry(defects));
+            }
+        }
+        Ok(StepResult::Done(out))
+    }
+}
+
+type ItemFn = Box<dyn Fn(&StepContext<'_>, &Value) -> Result<Value, SkillError> + Send + Sync>;
+
+/// A step over a list of items, processed one per call so every item is a checkpoint boundary
+/// (a labelling or acquisition run over many documents). The output is the array of per-item
+/// results in item order.
+pub struct BatchStep {
+    id: String,
+    items: Vec<Value>,
+    per_item: ItemFn,
+    effect: Effect,
+}
+
+impl BatchStep {
+    pub fn new(
+        id: impl Into<String>,
+        items: Vec<Value>,
+        per_item: impl Fn(&StepContext<'_>, &Value) -> Result<Value, SkillError> + Send + Sync + 'static,
+    ) -> Self {
+        Self {
+            id: id.into(),
+            items,
+            per_item: Box::new(per_item),
+            effect: Effect::Paid,
+        }
+    }
+
+    pub fn with_effect(mut self, effect: Effect) -> Self {
+        self.effect = effect;
+        self
+    }
+}
+
+impl Step for BatchStep {
+    fn id(&self) -> &str {
+        &self.id
+    }
+    fn effect(&self) -> Effect {
+        self.effect
+    }
+    fn run(&self, cx: &StepContext<'_>) -> Result<StepResult, SkillError> {
+        let mut done: Vec<Value> = cx
+            .progress()
+            .and_then(|p| p.get("done"))
+            .and_then(Value::as_array)
+            .cloned()
+            .unwrap_or_default();
+        let Some(item) = self.items.get(done.len()) else {
+            return Ok(StepResult::Done(Value::Array(done)));
+        };
+        done.push((self.per_item)(cx, item)?);
+        if done.len() >= self.items.len() {
+            Ok(StepResult::Done(Value::Array(done)))
+        } else {
+            Ok(StepResult::Continue(json!({"done": done})))
+        }
+    }
+}
+
+/// An ordered list of steps.
+pub struct SkillPlan {
+    pub id: String,
+    pub steps: Vec<Box<dyn Step>>,
+}
+
+impl SkillPlan {
+    pub fn new(id: impl Into<String>, steps: Vec<Box<dyn Step>>) -> Self {
+        Self {
+            id: id.into(),
+            steps,
+        }
+    }
+
+    fn check_ids(&self) -> Result<(), SkillError> {
+        let mut seen = std::collections::BTreeSet::new();
+        for s in &self.steps {
+            if s.id().is_empty() || !seen.insert(s.id()) {
+                return Err(SkillError::PlanMismatch(format!(
+                    "step id '{}' is empty or repeated",
+                    s.id()
+                )));
+            }
+        }
+        Ok(())
+    }
+}

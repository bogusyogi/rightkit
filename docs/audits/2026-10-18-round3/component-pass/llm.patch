new file mode 100644
index 0000000..1873e25
--- /dev/null
+++ b/crates/rightkit-llm/src/capability.rs
@@ -0,0 +1,637 @@
+//! Model capability catalogue (Orthic-Labs/rightkit#662).
+//!
+//! [`crate::catalogue::PriceCatalogue`] says what a model costs. This catalogue says what a model
+//! can do and how a host should drive it:
+//!
+//! - [`Tier`] (`Cheap` or `Capable`) for routing;
+//! - reasoning depth `0..=3` and the reasoning efforts the model accepts;
+//! - the tool-schema class the model needs (for example `strict` or `relaxed`; the host names the
+//!   classes it understands);
+//! - vision support;
+//! - the context window and a [`Compaction`] rule (trigger percent, reserve tokens, longest
+//!   summary the host may ask for);
+//! - [`AliasRule`]s that map a provider-native name (`anthropic/claude-x`, `claude-x-20260101`)
+//!   onto a catalogue id.
+//!
+//! Lookups never guess ([`CapabilityCatalogue::lookup`]): the name is normalized by the alias
+//! rules and then matched exactly against an id or a listed alias. There is no prefix match.
+//!
+//! # Signed refresh with rollback
+//!
+//! A host can refresh the catalogue from a signed snapshot without trusting the transport. The
+//! snapshot is a [`SignedSnapshot`] envelope (`payload`, `digest`, `signature`). This crate holds
+//! no hashing or signature code: a [`SnapshotVerifier`] the host supplies checks the payload bytes
+//! against the digest and the signature, so the host chooses the algorithm and the key.
+//! [`CapabilityStore`] keeps two files in a directory, `snapshot.json` (the newest verified
+//! snapshot) and `last-known-good.json`:
+//!
+//! - [`CapabilityStore::install`] verifies a new snapshot, refuses a version older than the
+//!   installed one, and only then replaces the files. A snapshot that fails leaves both files
+//!   untouched.
+//! - [`CapabilityStore::load`] verifies `snapshot.json` again. When that fails it falls back to
+//!   `last-known-good.json` and reports [`Loaded::degraded`] with the reason, so the host can
+//!   warn. When neither verifies it returns [`CapabilityError::NoUsableSnapshot`].
+
+use std::fmt;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+/// The only schema this crate reads.
+pub const CAPABILITY_SCHEMA: u32 = 1;
+
+/// Routing tier of a model.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Tier {
+    Cheap,
+    Capable,
+}
+
+/// When and how a host compacts a conversation for this model.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Compaction {
+    /// Compact when the conversation fills this percent (1..=100) of the context window.
+    pub trigger_percent: u8,
+    /// Tokens kept free for the next answer when compacting.
+    pub reserve_tokens: u32,
+    /// Longest summary, in output tokens, the host may ask for.
+    pub max_summary_output_tokens: u32,
+}
+
+/// A rule that turns a provider-native model name into a catalogue key.
+///
+/// Applied in order to the lower-cased name: strip `prefix` when the name starts with it, then
+/// strip a trailing `-YYYYMMDD` date when `strip_date_suffix` is set.
+#[derive(Debug, Clone, PartialEq, Eq, Default, Serialize, Deserialize)]
+pub struct AliasRule {
+    /// Provider prefix to remove, such as `anthropic/` or `models/`.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub prefix: Option<String>,
+    /// Remove a trailing `-YYYYMMDD` snapshot date.
+    #[serde(default)]
+    pub strip_date_suffix: bool,
+}
+
+impl AliasRule {
+    fn apply(&self, name: &str) -> String {
+        let mut out = name.to_owned();
+        if let Some(p) = &self.prefix {
+            let p = p.to_lowercase();
+            if let Some(rest) = out.strip_prefix(p.as_str()) {
+                out = rest.to_owned();
+            }
+        }
+        if self.strip_date_suffix {
+            out = strip_date_suffix(&out).to_owned();
+        }
+        out
+    }
+}
+
+fn strip_date_suffix(name: &str) -> &str {
+    if let Some((head, tail)) = name.rsplit_once('-') {
+        if tail.len() == 8 && tail.bytes().all(|b| b.is_ascii_digit()) {
+            return head;
+        }
+    }
+    name
+}
+
+/// What one model can do.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ModelCapability {
+    /// Catalogue id; matched after normalization.
+    pub id: String,
+    /// Other names that resolve to this model.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub aliases: Vec<String>,
+    pub tier: Tier,
+    /// Reasoning depth: 0 (none) to 3 (deepest).
+    pub reasoning_depth: u8,
+    /// Reasoning efforts the model accepts (for example `low`, `medium`, `high`).
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub supported_efforts: Vec<String>,
+    /// Name of the tool-schema dialect the model needs; the host defines the names.
+    pub tool_schema_class: String,
+    #[serde(default)]
+    pub vision: bool,
+    /// Context window in tokens.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub context_window: Option<u64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub compaction: Option<Compaction>,
+}
+
+impl ModelCapability {
+    /// True when `effort` is one of [`ModelCapability::supported_efforts`] (case-insensitive).
+    pub fn supports_effort(&self, effort: &str) -> bool {
+        self.supported_efforts
+            .iter()
+            .any(|e| e.eq_ignore_ascii_case(effort))
+    }
+
+    /// The input tokens at which [`Compaction`] triggers for this model, when both the window and
+    /// the rule are known. Rounds down; never above the window.
+    pub fn compaction_trigger_tokens(&self) -> Option<u64> {
+        let window = self.context_window?;
+        let rule = self.compaction?;
+        Some(window.saturating_mul(u64::from(rule.trigger_percent)) / 100)
+    }
+}
+
+/// Why a catalogue could not be read, queried or refreshed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum CapabilityError {
+    /// The JSON could not be read.
+    Parse(String),
+    /// The catalogue's `schema` is not [`CAPABILITY_SCHEMA`].
+    UnsupportedSchema(u32),
+    /// A model row is malformed.
+    InvalidModel { id: String, reason: String },
+    /// Two rows (or a row and an alias) resolve from the same name.
+    DuplicateName(String),
+    /// No model matches the name.
+    Unknown(String),
+    /// The verifier rejected a snapshot; the text is the verifier's reason.
+    Rejected(String),
+    /// A snapshot is older than the installed one.
+    Stale { installed: u64, offered: u64 },
+    /// Neither the newest snapshot nor the last-known-good one verifies.
+    NoUsableSnapshot(String),
+    /// A snapshot file could not be read or written.
+    Io(String),
+}
+
+impl fmt::Display for CapabilityError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            CapabilityError::Parse(m) => write!(f, "capability catalogue unreadable: {m}"),
+            CapabilityError::UnsupportedSchema(s) => {
+                write!(f, "capability catalogue schema {s} is not supported")
+            }
+            CapabilityError::InvalidModel { id, reason } => {
+                write!(f, "invalid capability row '{id}': {reason}")
+            }
+            CapabilityError::DuplicateName(n) => {
+                write!(f, "capability name '{n}' is used by more than one row")
+            }
+            CapabilityError::Unknown(n) => write!(f, "no capability row for '{n}'"),
+            CapabilityError::Rejected(m) => write!(f, "capability snapshot rejected: {m}"),
+            CapabilityError::Stale { installed, offered } => write!(
+                f,
+                "capability snapshot version {offered} is older than the installed {installed}"
+            ),
+            CapabilityError::NoUsableSnapshot(m) => {
+                write!(f, "no usable capability snapshot: {m}")
+            }
+            CapabilityError::Io(m) => write!(f, "capability snapshot file error: {m}"),
+        }
+    }
+}
+
+impl std::error::Error for CapabilityError {}
+
+/// A versioned set of [`ModelCapability`] rows.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct CapabilityCatalogue {
+    pub schema: u32,
+    /// Monotonic snapshot number. A refresh with a lower number is refused.
+    pub version: u64,
+    /// Day this version was published, `YYYY-MM-DD` (informational).
+    pub published: String,
+    /// Rules applied, in order, to a name before it is matched.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub alias_rules: Vec<AliasRule>,
+    models: Vec<ModelCapability>,
+}
+
+impl CapabilityCatalogue {
+    /// Build a catalogue and validate it (see [`CapabilityCatalogue::from_json`] for the rules).
+    pub fn new(
+        version: u64,
+        published: impl Into<String>,
+        alias_rules: Vec<AliasRule>,
+        models: Vec<ModelCapability>,
+    ) -> Result<Self, CapabilityError> {
+        let c = Self {
+            schema: CAPABILITY_SCHEMA,
+            version,
+            published: published.into(),
+            alias_rules,
+            models,
+        };
+        c.validate()?;
+        Ok(c)
+    }
+
+    /// Read and validate a catalogue. Every id must be non-empty, reasoning depth at most 3, a
+    /// compaction rule must have a trigger percent in `1..=100`, and no normalized id or alias may
+    /// appear on two rows.
+    pub fn from_json(json: &str) -> Result<Self, CapabilityError> {
+        let c: CapabilityCatalogue =
+            serde_json::from_str(json).map_err(|e| CapabilityError::Parse(e.to_string()))?;
+        c.validate()?;
+        Ok(c)
+    }
+
+    /// Serialize to the JSON [`CapabilityCatalogue::from_json`] reads.
+    pub fn to_json(&self) -> String {
+        serde_json::to_string_pretty(self).expect("capability catalogue serializes")
+    }
+
+    pub fn models(&self) -> &[ModelCapability] {
+        &self.models
+    }
+
+    fn validate(&self) -> Result<(), CapabilityError> {
+        if self.schema != CAPABILITY_SCHEMA {
+            return Err(CapabilityError::UnsupportedSchema(self.schema));
+        }
+        let mut seen = std::collections::BTreeSet::new();
+        for m in &self.models {
+            let bad = |reason: &str| CapabilityError::InvalidModel {
+                id: m.id.clone(),
+                reason: reason.to_owned(),
+            };
+            if m.id.trim().is_empty() {
+                return Err(bad("id is empty"));
+            }
+            if m.reasoning_depth > 3 {
+                return Err(bad("reasoning_depth is above 3"));
+            }
+            if m.tool_schema_class.trim().is_empty() {
+                return Err(bad("tool_schema_class is empty"));
+            }
+            if m.context_window == Some(0) {
+                return Err(bad("context_window is zero"));
+            }
+            if let Some(c) = m.compaction {
+                if c.trigger_percent == 0 || c.trigger_percent > 100 {
+                    return Err(bad("compaction trigger_percent is outside 1..=100"));
+                }
+            }
+            if m.reasoning_depth == 0 && !m.supported_efforts.is_empty() {
+                return Err(bad("reasoning_depth 0 cannot list supported_efforts"));
+            }
+            for name in std::iter::once(&m.id).chain(m.aliases.iter()) {
+                let key = name.trim().to_lowercase();
+                if key.is_empty() {
+                    return Err(bad("an alias is empty"));
+                }
+                if !seen.insert(key.clone()) {
+                    return Err(CapabilityError::DuplicateName(key));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// Normalize a provider-native name with the alias rules: trim, lower-case, then apply each
+    /// rule in order.
+    pub fn normalize(&self, name: &str) -> String {
+        let mut out = name.trim().to_lowercase();
+        for rule in &self.alias_rules {
+            out = rule.apply(&out);
+        }
+        out
+    }
+
+    /// The row for `name`: an exact match on a row id or alias, tried first on the lower-cased
+    /// name as given and then after the alias rules. There is no prefix match.
+    pub fn lookup(&self, name: &str) -> Result<&ModelCapability, CapabilityError> {
+        let raw = name.trim().to_lowercase();
+        let normalized = self.normalize(name);
+        let find = |key: &str| {
+            self.models.iter().find(|m| {
+                m.id.trim().eq_ignore_ascii_case(key)
+                    || m.aliases.iter().any(|a| a.trim().eq_ignore_ascii_case(key))
+            })
+        };
+        find(&raw)
+            .or_else(|| find(&normalized))
+            .ok_or_else(|| CapabilityError::Unknown(name.to_owned()))
+    }
+
+    /// Rows of one tier, in catalogue order.
+    pub fn by_tier(&self, tier: Tier) -> impl Iterator<Item = &ModelCapability> {
+        self.models.iter().filter(move |m| m.tier == tier)
+    }
+}
+
+/// Checks a snapshot's payload against its digest and signature. Supplied by the host, which
+/// chooses the digest algorithm and holds the verification key.
+pub trait SnapshotVerifier: Send + Sync {
+    /// `Ok(())` when `payload` (the exact bytes of [`SignedSnapshot::payload`]) matches `digest`
+    /// and `signature` is valid for it. `Err` carries a reason for the host's log; it must not
+    /// contain key material.
+    fn verify(&self, payload: &[u8], digest: &str, signature: &str) -> Result<(), String>;
+}
+
+/// The signed envelope of one catalogue snapshot.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SignedSnapshot {
+    /// The catalogue JSON ([`CapabilityCatalogue::to_json`]), byte for byte as signed.
+    pub payload: String,
+    /// Digest of `payload`, in the host's chosen encoding.
+    pub digest: String,
+    /// Signature over the payload (or its digest), in the host's chosen encoding.
+    pub signature: String,
+}
+
+impl SignedSnapshot {
+    /// Verify the envelope and parse the catalogue it carries.
+    pub fn open(
+        &self,
+        verifier: &dyn SnapshotVerifier,
+    ) -> Result<CapabilityCatalogue, CapabilityError> {
+        verifier
+            .verify(self.payload.as_bytes(), &self.digest, &self.signature)
+            .map_err(CapabilityError::Rejected)?;
+        CapabilityCatalogue::from_json(&self.payload)
+    }
+
+    /// Read an envelope from JSON.
+    pub fn from_json(json: &str) -> Result<Self, CapabilityError> {
+        serde_json::from_str(json).map_err(|e| CapabilityError::Parse(e.to_string()))
+    }
+
+    /// Serialize to the JSON [`SignedSnapshot::from_json`] reads.
+    pub fn to_json(&self) -> String {
+        serde_json::to_string_pretty(self).expect("snapshot serializes")
+    }
+}
+
+/// A catalogue loaded from a [`CapabilityStore`].
+#[derive(Debug, Clone, PartialEq)]
+pub struct Loaded {
+    pub catalogue: CapabilityCatalogue,
+    /// `Some(reason)` when the newest snapshot failed and the last-known-good one was used.
+    pub degraded: Option<String>,
+}
+
+const SNAPSHOT_FILE: &str = "snapshot.json";
+const LAST_GOOD_FILE: &str = "last-known-good.json";
+
+/// A directory holding the newest verified snapshot and the last-known-good one.
+#[derive(Debug, Clone)]
+pub struct CapabilityStore {
+    dir: PathBuf,
+}
+
+impl CapabilityStore {
+    pub fn new(dir: impl Into<PathBuf>) -> Self {
+        Self { dir: dir.into() }
+    }
+
+    fn path(&self, name: &str) -> PathBuf {
+        self.dir.join(name)
+    }
+
+    fn read_open(
+        &self,
+        name: &str,
+        verifier: &dyn SnapshotVerifier,
+    ) -> Result<CapabilityCatalogue, CapabilityError> {
+        let text = fs::read_to_string(self.path(name))
+            .map_err(|e| CapabilityError::Io(format!("{name}: {e}")))?;
+        SignedSnapshot::from_json(&text)?.open(verifier)
+    }
+
+    /// Load the newest verified catalogue. A snapshot that fails verification falls back to the
+    /// last-known-good one and the result says so ([`Loaded::degraded`]).
+    pub fn load(&self, verifier: &dyn SnapshotVerifier) -> Result<Loaded, CapabilityError> {
+        match self.read_open(SNAPSHOT_FILE, verifier) {
+            Ok(catalogue) => Ok(Loaded {
+                catalogue,
+                degraded: None,
+            }),
+            Err(newest) => match self.read_open(LAST_GOOD_FILE, verifier) {
+                Ok(catalogue) => Ok(Loaded {
+                    catalogue,
+                    degraded: Some(newest.to_string()),
+                }),
+                Err(good) => Err(CapabilityError::NoUsableSnapshot(format!(
+                    "newest: {newest}; last known good: {good}"
+                ))),
+            },
+        }
+    }
+
+    /// Verify `snapshot` and make it the newest snapshot. The previous newest snapshot becomes
+    /// the last-known-good one when it still verifies. A snapshot whose version is lower than the
+    /// installed one is [`CapabilityError::Stale`]. On any failure nothing on disk changes.
+    pub fn install(
+        &self,
+        snapshot: &SignedSnapshot,
+        verifier: &dyn SnapshotVerifier,
+    ) -> Result<CapabilityCatalogue, CapabilityError> {
+        let incoming = snapshot.open(verifier)?;
+        let installed = self.read_open(SNAPSHOT_FILE, verifier).ok();
+        if let Some(cur) = &installed {
+            if incoming.version < cur.version {
+                return Err(CapabilityError::Stale {
+                    installed: cur.version,
+                    offered: incoming.version,
+                });
+            }
+        }
+        fs::create_dir_all(&self.dir).map_err(|e| CapabilityError::Io(e.to_string()))?;
+        if installed.is_some() {
+            let prev = fs::read(self.path(SNAPSHOT_FILE))
+                .map_err(|e| CapabilityError::Io(e.to_string()))?;
+            write_replace(&self.path(LAST_GOOD_FILE), &prev)?;
+        }
+        write_replace(&self.path(SNAPSHOT_FILE), snapshot.to_json().as_bytes())?;
+        Ok(incoming)
+    }
+}
+
+/// Write `bytes` to `path` through a temporary sibling and a rename.
+fn write_replace(path: &Path, bytes: &[u8]) -> Result<(), CapabilityError> {
+    let tmp = path.with_extension("tmp");
+    fs::write(&tmp, bytes).map_err(|e| CapabilityError::Io(e.to_string()))?;
+    if let Err(e) = fs::rename(&tmp, path) {
+        // Windows refuses to rename over an existing file on some filesystems.
+        if path.exists() {
+            fs::remove_file(path).map_err(|e| CapabilityError::Io(e.to_string()))?;
+            fs::rename(&tmp, path).map_err(|e| CapabilityError::Io(e.to_string()))?;
+        } else {
+            return Err(CapabilityError::Io(e.to_string()));
+        }
+    }
+    Ok(())
+}

@@ -0,0 +1,423 @@
+//! Tokio versions of the bounded JSON-lines reader and writer (feature `tokio`).
+//!
+//! These mirror [`crate::read_json_line_or_oversized_opts`] and
+//! [`crate::write_json_line_flush`] over `AsyncBufRead` and `AsyncWrite` with the same
+//! limit, resynchronisation, blank-line, oversized-frame and error semantics, for a child
+//! whose stdout is a tokio stream. Nothing here spawns a task or starts a timer: the
+//! caller's `.await` drives every read and write. The deadline in [`crate::ReadLimits`] is
+//! checked between chunks, as in the blocking reader; wrap the call in
+//! `tokio::time::timeout` to bound a single blocked read.
+
+use std::io;
+use std::pin::Pin;
+use std::time::Instant;
+
+use serde::{de::DeserializeOwned, Serialize};
+use tokio::io::{AsyncBufRead, AsyncBufReadExt, AsyncWrite, AsyncWriteExt};
+
+use super::{
+    encode_json_line, is_blank_line, FrameError, Incoming, LimitCounts, Line, Oversized,
+    ReadOptions, ReceivedLine, Terminator, OVERSIZE_HEAD_BYTES,
+};
+
+/// Async [`crate::read_json_line`]: one frame; an oversized frame is
+/// [`FrameError::TooLarge`] once it is consumed through its newline.
+pub async fn read_json_line_async<R, T>(
+    reader: &mut R,
+    buffer: &mut Vec<u8>,
+    limit: usize,
+) -> Result<Option<T>, FrameError>
+where
+    R: AsyncBufRead + Unpin,
+    T: DeserializeOwned,
+{
+    read_json_line_opts_async(reader, buffer, limit, ReadOptions::default()).await
+}
+
+/// Async [`crate::read_json_line_opts`] with [`ReadOptions`].
+pub async fn read_json_line_opts_async<R, T>(
+    reader: &mut R,
+    buffer: &mut Vec<u8>,
+    limit: usize,
+    opts: ReadOptions,
+) -> Result<Option<T>, FrameError>
+where
+    R: AsyncBufRead + Unpin,
+    T: DeserializeOwned,
+{
+    match read_json_line_or_oversized_opts_async(reader, buffer, limit, opts).await? {
+        None => Ok(None),
+        Some(Incoming::Frame(value)) => Ok(Some(value)),
+        Some(Incoming::Oversized(_)) => Err(FrameError::TooLarge { limit }),
+    }
+}
+
+/// Async [`crate::read_json_line_or_oversized_opts`]. `buffer` on return follows the
+/// blocking function: empty for a frame, an oversized line, EOF and I/O errors; the raw
+/// line for [`FrameError::Json`] and [`FrameError::InvalidUtf8`].
+pub async fn read_json_line_or_oversized_opts_async<R, T>(
+    reader: &mut R,
+    buffer: &mut Vec<u8>,
+    limit: usize,
+    opts: ReadOptions,
+) -> Result<Option<Incoming<T>>, FrameError>
+where
+    R: AsyncBufRead + Unpin,
+    T: DeserializeOwned,
+{
+    read_json_line_or_oversized_observed_async(reader, buffer, limit, opts, &mut |_| {}).await
+}
+
+/// Async [`crate::read_json_line_or_oversized_observed`].
+pub async fn read_json_line_or_oversized_observed_async<R, T>(
+    reader: &mut R,
+    buffer: &mut Vec<u8>,
+    limit: usize,
+    opts: ReadOptions,
+    observe: &mut (dyn FnMut(ReceivedLine) + Send),
+) -> Result<Option<Incoming<T>>, FrameError>
+where
+    R: AsyncBufRead + Unpin,
+    T: DeserializeOwned,
+{
+    match next_line_async(reader, buffer, limit, opts, observe).await? {
+        None => Ok(None),
+        Some(Line::Oversized(over)) => Ok(Some(Incoming::Oversized(over))),
+        Some(Line::Frame) => {
+            if std::str::from_utf8(buffer.as_slice()).is_err() {
+                return Err(FrameError::InvalidUtf8 { len: buffer.len() });
+            }
+            match serde_json::from_slice::<T>(buffer.as_slice()) {
+                Ok(value) => {
+                    buffer.clear();
+                    Ok(Some(Incoming::Frame(value)))
+                }
+                Err(err) => Err(FrameError::Json(err)),
+            }
+        }
+    }
+}
+
+/// Async [`crate::read_line_bytes`]: one line's bytes, nothing parsed.
+pub async fn read_line_bytes_async<R>(
+    reader: &mut R,
+    buffer: &mut Vec<u8>,
+    limit: usize,
+    opts: ReadOptions,
+) -> Result<Option<Vec<u8>>, FrameError>
+where
+    R: AsyncBufRead + Unpin,
+{
+    match next_line_async(reader, buffer, limit, opts, &mut |_| {}).await? {
+        None => Ok(None),
+        Some(Line::Oversized(_)) => Err(FrameError::TooLarge { limit }),
+        Some(Line::Frame) => Ok(Some(std::mem::take(buffer))),
+    }
+}
+
+async fn next_line_async<R>(
+    reader: &mut R,
+    buffer: &mut Vec<u8>,
+    limit: usize,
+    opts: ReadOptions,
+    observe: &mut (dyn FnMut(ReceivedLine) + Send),
+) -> Result<Option<Line>, FrameError>
+where
+    R: AsyncBufRead + Unpin,
+{
+    match next_line_inner_async(reader, buffer, limit, opts, observe).await {
+        Ok(line) => Ok(line),
+        Err(err) => {
+            buffer.clear();
+            Err(err)
+        }
+    }
+}
+
+async fn next_line_inner_async<R>(
+    reader: &mut R,
+    buffer: &mut Vec<u8>,
+    limit: usize,
+    opts: ReadOptions,
+    observe: &mut (dyn FnMut(ReceivedLine) + Send),
+) -> Result<Option<Line>, FrameError>
+where
+    R: AsyncBufRead + Unpin,
+{
+    let limits = opts.limits;
+    let cap = limit.saturating_add(1);
+    'line: loop {
+        buffer.clear();
+        let mut overflow: Option<Oversized> = None;
+        let mut discarded = 0usize;
+        let mut raw = 0usize;
+        let mut terminator = Terminator::None;
+        let mut last_content: Option<u8> = None;
+        loop {
+            if limits.deadline.is_some_and(|d| Instant::now() >= d) {
+                return Err(FrameError::Io(io::Error::new(
+                    io::ErrorKind::TimedOut,
+                    "json frame deadline exceeded",
+                )));
+            }
+            let chunk = match reader.fill_buf().await {
+                Ok(c) => c,
+                Err(err) if err.kind() == io::ErrorKind::Interrupted => continue,
+                Err(err) => return Err(FrameError::Io(err)),
+            };
+            if chunk.is_empty() {
+                if let Some(over) = overflow {
+                    observe(ReceivedLine {
+                        raw_len: raw,
+                        terminator,
+                    });
+                    return Ok(Some(Line::Oversized(over)));
+                }
+                if buffer.is_empty() {
+                    return Ok(None);
+                }
+                break;
+            }
+            let newline = chunk.iter().position(|b| *b == b'\n');
+            let take = newline.map_or(chunk.len(), |i| i + 1);
+            raw = raw.saturating_add(take);
+            let content = &chunk[..newline.unwrap_or(take)];
+            if let Some(byte) = content.last() {
+                last_content = Some(*byte);
+            }
+            if newline.is_some() {
+                terminator = if last_content == Some(b'\r') {
+                    Terminator::CrLf
+                } else {
+                    Terminator::Lf
+                };
+            }
+            if let Some(over) = overflow.as_mut() {
+                discarded = discarded.saturating_add(take);
+                over.bytes = over.bytes.saturating_add(content.len());
+            } else if buffer.len() + content.len() > cap {
+                let seen = buffer.len() + content.len();
+                let mut head = std::mem::take(buffer);
+                head.truncate(OVERSIZE_HEAD_BYTES);
+                let room = OVERSIZE_HEAD_BYTES - head.len();
+                head.extend_from_slice(&content[..room.min(content.len())]);
+                overflow = Some(Oversized {
+                    limit,
+                    head,
+                    bytes: seen,
+                });
+                discarded = take;
+            } else {
+                buffer.extend_from_slice(content);
+            }
+            Pin::new(&mut *reader).consume(take);
+            if newline.is_some() {
+                break;
+            }
+            if overflow.is_some() && discarded > limits.max_discard {
+                return Err(FrameError::Io(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    format!(
+                        "json frame exceeded {limit}-byte limit and no newline within {} bytes",
+                        limits.max_discard
+                    ),
+                )));
+            }
+        }
+        observe(ReceivedLine {
+            raw_len: raw,
+            terminator,
+        });
+        if let Some(over) = overflow {
+            buffer.clear();
+            return Ok(Some(Line::Oversized(over)));
+        }
+        let mut end = buffer.len();
+        if end > 0 && buffer[end - 1] == b'\r' {
+            end -= 1;
+        }
+        if end == 0 {
+            if opts.skip_empty_lines {
+                continue 'line;
+            }
+            buffer.clear();
+            return Err(FrameError::EmptyLine);
+        }
+        if opts.skip_whitespace_only_lines && is_blank_line(&buffer[..end], opts.whitespace) {
+            continue 'line;
+        }
+        let counted = match opts.limit_counts {
+            LimitCounts::Payload => end,
+            LimitCounts::RawLineBytes => raw,
+        };
+        if counted > limit {
+            let head = buffer[..end.min(OVERSIZE_HEAD_BYTES)].to_vec();
+            buffer.clear();
+            return Ok(Some(Line::Oversized(Oversized {
+                limit,
+                head,
+                bytes: counted,
+            })));
+        }
+        buffer.truncate(end);
+        return Ok(Some(Line::Frame));
+    }
+}
+
+/// Async [`crate::write_json_line`]: encode (nothing is written if over `limit`), then
+/// write the line. Does not flush.
+pub async fn write_json_line_async<W, T>(
+    writer: &mut W,
+    value: &T,
+    limit: usize,
+) -> Result<(), FrameError>
+where
+    W: AsyncWrite + Unpin,
+    T: Serialize,
+{
+    let encoded = encode_json_line(value, limit)?;
+    writer.write_all(&encoded).await?;
+    Ok(())
+}
+
+/// Async [`crate::write_json_line_flush`]: [`write_json_line_async`] then a flush.
+pub async fn write_json_line_flush_async<W, T>(
+    writer: &mut W,
+    value: &T,
+    limit: usize,
+) -> Result<(), FrameError>
+where
+    W: AsyncWrite + Unpin,
+    T: Serialize,
+{
+    write_json_line_async(writer, value, limit).await?;
+    writer.flush().await?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::Value;
+
+    #[tokio::test]
+    async fn reads_frames_skips_blank_and_ends_with_none() {
+        let mut reader: &[u8] = b"\n\r\n{\"a\":1}\r\n{\"b\":2}";
+        let mut buf = Vec::new();
+        let a: Option<Value> = read_json_line_async(&mut reader, &mut buf, 64)
+            .await
+            .unwrap();
+        assert_eq!(a.unwrap()["a"], 1);
+        let b: Option<Value> = read_json_line_async(&mut reader, &mut buf, 64)
+            .await
+            .unwrap();
+        assert_eq!(b.unwrap()["b"], 2);
+        let c: Option<Value> = read_json_line_async(&mut reader, &mut buf, 64)
+            .await
+            .unwrap();
+        assert!(c.is_none());
+    }
+
+    #[tokio::test]
+    async fn oversized_frame_is_discarded_and_stream_resyncs() {
+        let mut reader: &[u8] = b"{\"id\":9,\"pad\":\"xxxxxxxxxxxxxxxxxxxx\"}\n{\"ok\":true}\n";
+        let mut buf = Vec::new();
+        let first = read_json_line_async::<_, Value>(&mut reader, &mut buf, 16).await;
+        assert!(matches!(first, Err(FrameError::TooLarge { limit: 16 })));
+        assert!(buf.is_empty());
+        let second: Option<Value> = read_json_line_async(&mut reader, &mut buf, 64)
+            .await
+            .unwrap();
+        assert_eq!(second.unwrap()["ok"], true);
+    }
+
+    #[tokio::test]
+    async fn oversized_is_a_value_with_id() {
+        let mut reader: &[u8] = b"{\"id\":9,\"pad\":\"xxxxxxxxxxxxxxxxxxxx\"}\n";
+        let mut buf = Vec::new();
+        let got = read_json_line_or_oversized_opts_async::<_, Value>(
+            &mut reader,
+            &mut buf,
+            16,
+            ReadOptions::default(),
+        )
+        .await
+        .unwrap();
+        match got {
+            Some(Incoming::Oversized(o)) => assert_eq!(o.id(), Some(9)),
+            other => panic!("expected oversized, got {other:?}"),
+        }
+    }
+
+    #[tokio::test]
+    async fn malformed_json_keeps_raw_line_and_resyncs() {
+        let mut reader: &[u8] = b"{nope\n{}\n";
+        let mut buf = Vec::new();
+        let r = read_json_line_async::<_, Value>(&mut reader, &mut buf, 64).await;
+        assert!(matches!(r, Err(FrameError::Json(_))));
+        assert_eq!(buf, b"{nope");
+        let next: Option<Value> = read_json_line_async(&mut reader, &mut buf, 64)
+            .await
+            .unwrap();
+        assert!(next.is_some());
+    }
+
+    #[tokio::test]
+    async fn no_newline_is_cut_off_after_max_discard() {
+        let data = vec![b'x'; 1024];
+        let mut reader: &[u8] = &data;
+        let mut buf = Vec::new();
+        let opts = ReadOptions {
+            limits: crate::ReadLimits {
+                max_discard: 8,
+                deadline: None,
+            },
+            ..ReadOptions::default()
+        };
+        let r = read_json_line_opts_async::<_, Value>(&mut reader, &mut buf, 4, opts).await;
+        assert!(matches!(r, Err(FrameError::Io(ref e)) if e.kind() == io::ErrorKind::InvalidData));
+    }
+
+    #[tokio::test]
+    async fn observer_sees_every_line() {
+        let mut reader: &[u8] = b"\n{\"a\":1}\n";
+        let mut buf = Vec::new();
+        let mut seen = Vec::new();
+        let got = read_json_line_or_oversized_observed_async::<_, Value>(
+            &mut reader,
+            &mut buf,
+            64,
+            ReadOptions::default(),
+            &mut |l| seen.push((l.raw_len, l.terminator)),
+        )
+        .await
+        .unwrap();
+        assert!(matches!(got, Some(Incoming::Frame(_))));
+        assert_eq!(seen, vec![(1, Terminator::Lf), (8, Terminator::Lf)]);
+    }
+
+    #[tokio::test]
+    async fn write_flush_writes_one_line_and_refuses_oversize() {
+        let mut out: Vec<u8> = Vec::new();
+        write_json_line_flush_async(&mut out, &serde_json::json!({"a": 1}), 64)
+            .await
+            .unwrap();
+        assert_eq!(out, b"{\"a\":1}\n");
+        let mut out2: Vec<u8> = Vec::new();
+        let r =
+            write_json_line_flush_async(&mut out2, &serde_json::json!({"a": "long value"}), 4)
+                .await;
+        assert!(matches!(r, Err(FrameError::TooLarge { limit: 4 })));
+        assert!(out2.is_empty());
+    }
+
+    #[tokio::test]
+    async fn read_line_bytes_returns_raw_bytes() {
+        let mut reader: &[u8] = b"not json\r\n";
+        let mut buf = Vec::new();
+        let got = read_line_bytes_async(&mut reader, &mut buf, 64, ReadOptions::default())
+            .await
+            .unwrap();
+        assert_eq!(got.unwrap(), b"not json");
+    }
+}

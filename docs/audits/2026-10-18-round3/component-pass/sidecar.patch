+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn details_absent_is_not_serialized() {
+        let e = WireError::new("x", "y");
+        let text = serde_json::to_string(&e).unwrap();
+        assert!(!text.contains("details"), "{text}");
+        assert_eq!(e.details(), None);
+    }
+
+    #[test]
+    fn details_round_trip() {
+        let e = WireError::new("needs_auth", "sign in").with_details(json!({"platform": "x"}));
+        let text = serde_json::to_string(&e).unwrap();
+        let back: WireError = serde_json::from_str(&text).unwrap();
+        assert_eq!(back, e);
+        assert_eq!(back.detail("platform"), Some(&json!("x")));
+        assert_eq!(back.detail("missing"), None);
+    }
+
+    #[test]
+    fn older_peer_without_details_parses() {
+        let e: WireError = serde_json::from_str(r#"{"code":"c","message":"m"}"#).unwrap();
+        assert_eq!(e, WireError::new("c", "m"));
+        let e: WireError = serde_json::from_str(r#"{"code":"c","details":null}"#).unwrap();
+        assert_eq!(e.details, None);
+    }
+
+    #[test]
+    fn details_survive_a_response_frame() {
+        let frame = Frame::err(
+            3,
+            WireError::retryable("busy", "later").with_details(json!([1, 2])),
+        );
+        let text = serde_json::to_string(&frame).unwrap();
+        let back: Frame = serde_json::from_str(&text).unwrap();
+        assert_eq!(back, frame);
+    }
+}

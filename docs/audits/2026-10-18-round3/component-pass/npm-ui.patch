@@ -0,0 +1,58 @@
+// Range transport for pdf.js: the host serves byte ranges (a Tauri read command, a ranged HTTP client) and pdf.js asks only for
+// what it needs, so a large file is never read whole. No file access here: the app supplies `read`.
+import { PDFDataRangeTransport } from "pdfjs-dist";
+import type { PdfDocumentInit, PdfDocumentOptions } from "./loader.js";
+
+/** A PDF the host serves by byte range. Pass it as `PdfViewer`'s `source`. */
+export interface PdfRangeSource {
+  kind: "range";
+  /** Total size in bytes. */
+  length: number;
+  /** Bytes `[begin, end)` of the file. Called on pdf.js's demand; rejections end the load. */
+  read(begin: number, end: number): Promise<Uint8Array>;
+  /** The first bytes of the file, when the host already has them (saves the first round trip). */
+  initialData?: Uint8Array;
+  /** Change it to load a different document with the same `read` function. */
+  revision?: string | number;
+}
+
+/** What `createPdfRangeTransport` returns: the transport for pdf.js `getDocument({ range })` and a way to stop serving. */
+export interface PdfRangeTransportHandle {
+  transport: PDFDataRangeTransport;
+  /** After this, requests are dropped and results ignored. The viewer calls it when the document is closed. */
+  dispose(): void;
+}
+
+/**
+ * Build a pdf.js `PDFDataRangeTransport` over `source.read`. Failures of `read` call `onError` once (the viewer maps it to its
+ * `onError`); pdf.js then times out or fails on its own, as with any stalled range request.
+ */
+export function createPdfRangeTransport(source: Pick<PdfRangeSource, "length" | "read" | "initialData">, onError?: (error: Error) => void): PdfRangeTransportHandle {
+  if (!Number.isFinite(source.length) || source.length < 0) throw new RangeError("PDF range source length must be a non-negative number");
+  let disposed = false;
+  const transport = new PDFDataRangeTransport(source.length, source.initialData ?? new Uint8Array(0));
+  transport.requestDataRange = (begin: number, end: number) => {
+    const from = Math.max(0, Math.floor(begin));
+    const to = Math.min(source.length, Math.floor(end));
+    if (to <= from) return;
+    void source.read(from, to).then(
+      (chunk) => {
+        if (!disposed) transport.onDataRange(from, chunk);
+      },
+      (cause) => {
+        if (!disposed) onError?.(cause instanceof Error ? cause : new Error(String(cause)));
+      },
+    );
+  };
+  return { transport, dispose: () => { disposed = true; } };
+}
+
+/** The `getDocument` init for a range transport, merged over `documentOptions` like `pdfDocumentInit` (the source wins). */
+export function pdfRangeDocumentInit(
+  handle: Pick<PdfRangeTransportHandle, "transport">,
+  length: number,
+  documentOptions?: PdfDocumentOptions,
+): PdfDocumentInit {
+  const { url: _url, data: _data, range: _range, length: _length, ...options } = (documentOptions ?? {}) as PdfDocumentOptions & { url?: unknown; data?: unknown; range?: unknown; length?: unknown };
+  return { ...options, range: handle.transport, length } as PdfDocumentInit;
+}

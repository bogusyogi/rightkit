+import { useState, type ReactNode } from "react";
+import { useMediaAdapters, type MediaAdapters } from "./adapters.js";
+import { mediaClock } from "./MediaPlayer.js";
+
+export interface MediaThumbnailProps {
+  /** Media source: absolute path, URL or app route, resolved through the `resolveSrc` adapter. */
+  src: string;
+  kind: "video" | "audio";
+  /** Accessible name. Omitted: the tile is decorative and hidden from assistive technology (the host labels its own button). */
+  label?: string;
+  /** Image shown for the tile. Video: the element's poster (shown until, and instead of, the decoded frame when the frame cannot
+   *  load). Audio: artwork in place of the note glyph. Resolved through `resolveSrc`. */
+  poster?: string;
+  /** Second of the video to show as the thumbnail. Default 0.1. Ignored when `src` already carries a `#` fragment. */
+  frameTime?: number;
+  /** Show the duration (`m:ss`) in a corner once the metadata is known. Default false. */
+  showDuration?: boolean;
+  /** Called with the duration in seconds when the metadata loads (video only). */
+  onDuration?: (seconds: number) => void;
+  /** Called once if the frame fails to load; the tile then shows the placeholder. */
+  onError?: () => void;
+  /** Glyph for the placeholder (audio, or a video whose frame failed). Default a note for audio and a film mark for video. */
+  placeholder?: ReactNode;
+  className?: string;
+  adapters?: MediaAdapters;
+}
+
+/**
+ * A non-interactive thumbnail for a video or audio file (0.4.0), for a gallery tile: a muted, paused metadata `<video>` showing one
+ * frame, or an artwork/placeholder face for audio. It has no controls, takes no focus, ignores pointer events (the tile around it owns
+ * the click) and never plays. For playback use `MediaPlayer`.
+ *
+ * Hooks: root `data-kind`, `data-state="loading" | "ready" | "error"`. Classes `rk-media-thumb`, `rk-media-thumb-video`,
+ * `rk-media-thumb-face`, `rk-media-thumb-duration`.
+ */
+export function MediaThumbnail(props: MediaThumbnailProps) {
+  const { src, kind, label, poster, frameTime = 0.1, showDuration = false, onDuration, onError, placeholder, className } = props;
+  const adapters = useMediaAdapters(props.adapters);
+  const resolve = (value: string) => adapters.resolveSrc?.(value) ?? value;
+  const [state, setState] = useState<"loading" | "ready" | "error">(kind === "audio" && !poster ? "ready" : "loading");
+  const [duration, setDuration] = useState<number | null>(null);
+  const resolved = resolve(src);
+  const seek = Number.isFinite(frameTime) && frameTime > 0 && !resolved.includes("#") ? `#t=${frameTime}` : "";
+  const decorative = label === undefined;
+  const failed = state === "error";
+  const glyph = placeholder ?? (kind === "audio" ? "♪" : "▶");
+  return (
+    <div
+      className={["rk-media-thumb", className].filter(Boolean).join(" ")}
+      data-kind={kind}
+      data-state={state}
+      role={decorative ? undefined : "img"}
+      aria-label={decorative ? undefined : label}
+      aria-hidden={decorative ? true : undefined}
+    >
+      {kind === "video" && !failed ? (
+        <video
+          className="rk-media-thumb-video"
+          src={`${resolved}${seek}`}
+          poster={poster ? resolve(poster) : undefined}
+          muted
+          playsInline
+          preload="metadata"
+          tabIndex={-1}
+          disablePictureInPicture
+          disableRemotePlayback
+          aria-hidden="true"
+          onLoadedMetadata={(event) => {
+            const seconds = event.currentTarget.duration;
+            if (Number.isFinite(seconds)) {
+              setDuration(seconds);
+              onDuration?.(seconds);
+            }
+          }}
+          onLoadedData={() => setState("ready")}
+          onError={() => {
+            setState("error");
+            onError?.();
+          }}
+        />
+      ) : (
+        <div className="rk-media-thumb-face" aria-hidden="true">
+          {kind === "audio" && poster && !failed ? (
+            <img className="rk-media-thumb-art" src={resolve(poster)} alt="" draggable={false} onLoad={() => setState("ready")} onError={() => { setState("error"); onError?.(); }} />
+          ) : (
+            <span className="rk-media-thumb-glyph">{glyph}</span>
+          )}
+        </div>
+      )}
+      {showDuration && duration !== null ? <span className="rk-media-thumb-duration">{mediaClock(duration)}</span> : null}
+    </div>
+  );
+}

@@ -0,0 +1,145 @@
+import { describe, expect, it, vi } from "vitest";
+import { createPdfRangeTransport, pdfRangeDocumentInit, renderPdfLinkLayer, createPdfLinkService } from "../src/index.js";
+import { attachPasswordHandler, PdfPasswordCancelledError } from "../src/index.js";
+
+const flush = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+function fakeTask() {
+  const task = { onPassword: undefined as unknown, destroyed: 0, destroy() { this.destroyed += 1; } };
+  const ask = (update: (value: string) => void, code: number) => (task.onPassword as (u: typeof update, c: number) => void)(update, code);
+  return { task, ask };
+}
+
+describe("password flow options (0.3.0)", () => {
+  it("answers the first request with initialPassword and skips the handler", async () => {
+    const { task, ask } = fakeTask();
+    const handler = vi.fn(() => "later");
+    attachPasswordHandler(task, () => handler, undefined, { initialPassword: "bench" });
+    const updates: string[] = [];
+    ask((value) => updates.push(value), 1);
+    await flush();
+    expect(updates).toEqual(["bench"]);
+    expect(handler).not.toHaveBeenCalled();
+  });
+
+  it("falls back to the handler when the initial password is wrong", async () => {
+    const { task, ask } = fakeTask();
+    attachPasswordHandler(task, () => (reason) => (reason === "incorrect" ? "second" : null), undefined, { initialPassword: "bench" });
+    const updates: string[] = [];
+    ask((value) => updates.push(value), 1);
+    ask((value) => updates.push(value), 2);
+    await flush();
+    expect(updates).toEqual(["bench", "second"]);
+  });
+
+  it("works with no handler, and gives up when the initial password is refused", () => {
+    const { task, ask } = fakeTask();
+    const onCancel = vi.fn();
+    const flow = attachPasswordHandler(task, () => undefined, undefined, { initialPassword: "bench", onCancel });
+    ask(() => {}, 1);
+    expect(onCancel).not.toHaveBeenCalled();
+    ask(() => {}, 2);
+    expect(onCancel).toHaveBeenCalledTimes(1);
+    expect(flow.failure).toBeInstanceOf(PdfPasswordCancelledError);
+    expect(task.destroyed).toBe(1);
+  });
+
+  it("calls onCancel once when the handler declines", async () => {
+    const { task, ask } = fakeTask();
+    const onCancel = vi.fn();
+    attachPasswordHandler(task, () => () => null, undefined, { onCancel });
+    ask(() => {}, 1);
+    await flush();
+    expect(onCancel).toHaveBeenCalledTimes(1);
+    expect(onCancel.mock.calls[0]?.[0]).toBeInstanceOf(PdfPasswordCancelledError);
+  });
+});
+
+describe("range transport (0.3.0)", () => {
+  it("serves a requested range through read and clamps it to the length", async () => {
+    const read = vi.fn(async (begin: number, end: number) => new Uint8Array(end - begin).fill(7));
+    const handle = createPdfRangeTransport({ length: 100, read });
+    const got: Array<[number, number]> = [];
+    handle.transport.onDataRange = (begin: number, chunk: Uint8Array) => { got.push([begin, chunk.length]); };
+    handle.transport.requestDataRange(10, 40);
+    handle.transport.requestDataRange(90, 500);
+    handle.transport.requestDataRange(50, 50);
+    await flush();
+    expect(read.mock.calls).toEqual([[10, 40], [90, 100]]);
+    expect(got).toEqual([[10, 30], [90, 10]]);
+  });
+
+  it("drops results after dispose and reports read failures once per failure", async () => {
+    const errors: Error[] = [];
+    const handle = createPdfRangeTransport({ length: 10, read: async () => { throw new Error("disk gone"); } }, (e) => errors.push(e));
+    handle.transport.requestDataRange(0, 5);
+    await flush();
+    expect(errors.map((e) => e.message)).toEqual(["disk gone"]);
+    handle.dispose();
+    handle.transport.requestDataRange(0, 5);
+    await flush();
+    expect(errors).toHaveLength(1);
+  });
+
+  it("rejects a bad length and builds an init where the range wins over options", () => {
+    expect(() => createPdfRangeTransport({ length: -1, read: async () => new Uint8Array() })).toThrow(RangeError);
+    const handle = createPdfRangeTransport({ length: 5, read: async () => new Uint8Array() });
+    const init = pdfRangeDocumentInit(handle, 5, { wasmUrl: "/pdfjs/", url: "https://x" } as never) as unknown as Record<string, unknown>;
+    expect(init.range).toBe(handle.transport);
+    expect(init.length).toBe(5);
+    expect(init.wasmUrl).toBe("/pdfjs/");
+    expect(init.url).toBeUndefined();
+  });
+});
+
+describe("link layer (0.3.0)", () => {
+  function fakeContainer() {
+    const made: Array<{ tag: string; className: string; style: Record<string, string>; children: unknown[]; href: string; title: string; listeners: Record<string, (e: Event) => void>; append: (c: unknown) => void; addEventListener: (t: string, h: (e: Event) => void) => void }> = [];
+    const doc = {
+      createElement: (tag: string) => {
+        const el = { tag, className: "", style: {} as Record<string, string>, children: [] as unknown[], href: "", title: "", rel: "", listeners: {} as Record<string, (e: Event) => void>, append(c: unknown) { this.children.push(c); }, addEventListener(t: string, h: (e: Event) => void) { this.listeners[t] = h; } };
+        made.push(el);
+        return el;
+      },
+    };
+    const container = { ownerDocument: doc, appended: [] as unknown[], append(c: unknown) { this.appended.push(c); } };
+    return { container: container as unknown as HTMLElement, made, appended: container.appended };
+  }
+  const viewport = { convertToViewportRectangle: (r: number[]) => [r[0]!, 100 - r[3]!, r[2]!, 100 - r[1]!] };
+
+  it("draws one box per Link annotation and routes URL, destination and action clicks", async () => {
+    const opened: string[] = [];
+    const dests: unknown[] = [];
+    const pages: number[] = [];
+    const service = createPdfLinkService({ goToDest: (d) => dests.push(d), goToPage: (n) => pages.push(n), currentPage: () => 2, pagesCount: () => 9, openExternal: (u) => opened.push(u) });
+    const page = { getAnnotations: async () => [
+      { subtype: "Link", rect: [10, 10, 30, 20], url: "https://example.com" },
+      { subtype: "Link", rect: [10, 30, 30, 40], dest: [{ num: 1 }] },
+      { subtype: "Link", rect: [10, 50, 30, 60], action: "NextPage" },
+      { subtype: "Widget", rect: [0, 0, 1, 1], url: "https://nope" },
+      { subtype: "Link", rect: [0, 0, 1, 1] },
+    ] };
+    const { container, made, appended } = fakeContainer();
+    const drawn = await renderPdfLinkLayer(page, container, viewport, service);
+    expect(drawn).toBe(3);
+    expect(appended).toHaveLength(1);
+    const links = made.filter((m) => m.tag === "a");
+    expect(links[0]!.style).toMatchObject({ left: "10px", top: "80px", width: "20px", height: "10px" });
+    expect(links[0]!.href).toBe("#");
+    links[0]!.listeners.click!({ preventDefault() {} } as Event);
+    links[1]!.listeners.click!({ preventDefault() {} } as Event);
+    links[2]!.listeners.click!({ preventDefault() {} } as Event);
+    expect(opened).toEqual(["https://example.com"]);
+    expect(dests).toEqual([[{ num: 1 }]]);
+    expect(pages).toEqual([3]);
+  });
+
+  it("never opens an unsafe URL", async () => {
+    const opened: string[] = [];
+    const service = createPdfLinkService({ goToDest() {}, goToPage() {}, currentPage: () => 1, pagesCount: () => 1, openExternal: (u) => opened.push(u) });
+    const { container, made } = fakeContainer();
+    await renderPdfLinkLayer({ getAnnotations: async () => [{ subtype: "Link", rect: [0, 0, 5, 5], url: "javascript:alert(1)" }] }, container, viewport, service);
+    made.find((m) => m.tag === "a")!.listeners.click!({ preventDefault() {} } as Event);
+    expect(opened).toEqual([]);
+  });
+});

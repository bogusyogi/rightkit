+import { describe, expect, it } from "vitest";
+import * as root from "./index.js";
+import * as headless from "./headless.js";
+
+describe("root entry toast bus (#759)", () => {
+  it("exports the same bus objects as ./headless", () => {
+    expect(root.createToastBus).toBe(headless.createToastBus);
+    expect(root.defaultToastBus).toBe(headless.defaultToastBus);
+    expect(root.toast).toBe(headless.toast);
+    expect(root.DEFAULT_TOAST_TTL).toBe(headless.DEFAULT_TOAST_TTL);
+  });
+
+  it("pushes and dismisses through the root exports", () => {
+    const bus = root.createToastBus();
+    const events: string[] = [];
+    bus.subscribe((e) => events.push(e.type));
+    const id = bus.push("hello");
+    bus.dismiss(id);
+    expect(events).toEqual(["push", "dismiss"]);
+  });
+});

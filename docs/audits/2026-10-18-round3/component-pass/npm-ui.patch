@@ -0,0 +1,89 @@
+/* Small interaction helpers with no React and no native imports: safe for the headless entry. */
+import type { Platform } from "./format.js";
+
+/** The slice of a `KeyboardEvent` the chord recorder reads. */
+export interface ChordEventLike {
+  key: string;
+  ctrlKey?: boolean;
+  altKey?: boolean;
+  shiftKey?: boolean;
+  metaKey?: boolean;
+}
+
+export interface ChordFromEventOptions {
+  /**
+   * `"explicit"` (default): Ctrl is `ctrl`, Cmd/Win is `win`, so the stored chord names the physical key
+   * (`formatChord` shows `win` as ⌘ on macOS and Win on Windows).
+   * `"mod"`: the platform's shortcut key is `mod` (Cmd on macOS, Ctrl elsewhere), and the other of the two stays explicit
+   * (`ctrl` on macOS, `win` elsewhere). Needs `platform`; without it `"mod"` behaves as `"explicit"`.
+   */
+  modifiers?: "explicit" | "mod";
+  platform?: Platform;
+}
+
+const MODIFIER_KEYS = new Set(["control", "shift", "alt", "altgraph", "meta", "os", "fn", "capslock"]);
+
+/** True for a key that is only a modifier (Control, Shift, Alt, Meta, ...). A recorder keeps waiting on these. */
+export function isModifierKey(key: string): boolean {
+  return MODIFIER_KEYS.has(key.toLowerCase());
+}
+
+const KEY_TOKENS: Readonly<Record<string, string>> = { " ": "space", Spacebar: "space", Enter: "enter", Escape: "esc", Esc: "esc" };
+
+/**
+ * The canonical chord for a keydown (`"ctrl+shift+p"`), the string `formatChord` displays and a shortcut recorder stores. Modifiers come
+ * first in the order ctrl, alt, shift, then the Cmd/Win key, followed by the key token: a single character lower-cased, `space`, `enter`,
+ * `esc`, or the lower-cased `KeyboardEvent.key` (`arrowup`, `f5`). Returns `null` for a modifier-only press.
+ *
+ * Use it in a recorder's `keydown`: `const chord = chordFromEvent(event); if (chord) save(chord);` and call `preventDefault()` yourself.
+ */
+export function chordFromEvent(event: ChordEventLike, options: ChordFromEventOptions = {}): string | null {
+  if (!event.key || isModifierKey(event.key)) return null;
+  const mod = options.modifiers === "mod" && options.platform !== undefined && options.platform !== "unknown";
+  const macLike = options.platform === "macos" || options.platform === "ios";
+  const parts: string[] = [];
+  if (event.ctrlKey) parts.push(mod && !macLike ? "mod" : "ctrl");
+  if (event.altKey) parts.push("alt");
+  if (event.shiftKey) parts.push("shift");
+  if (event.metaKey) parts.push(mod && macLike ? "mod" : "win");
+  const token = KEY_TOKENS[event.key] ?? event.key.toLowerCase();
+  parts.push(token);
+  return parts.join("+");
+}
+
+/** The slice of a `Document` the hover guard uses. */
+export interface HoverGuardTarget {
+  documentElement: { setAttribute(name: string, value: string): void; removeAttribute(name: string): void };
+  addEventListener(type: string, handler: () => void, options?: boolean | AddEventListenerOptions): void;
+  removeEventListener(type: string, handler: () => void, options?: boolean | EventListenerOptions): void;
+  defaultView?: { addEventListener(type: string, handler: () => void): void; removeEventListener(type: string, handler: () => void): void } | null;
+}
+
+export interface HoverGuardOptions {
+  /** Attribute set on the root while hover may be stale. Default `data-hover-guard`. */
+  attribute?: string;
+}
+
+/**
+ * Guard against a stale `:hover` (WebView2 keeps the last hovered element hovered after the pointer left the window, after a window
+ * drag, or after the window lost focus). While the guard is armed the root carries `data-hover-guard="true"`; it arms when the window
+ * loses focus or the pointer leaves the document, and clears on the next pointer or mouse move. Scope your hover rules with
+ * `:root:not([data-hover-guard]) .item:hover`. Returns the uninstall. No document (SSR): a no-op.
+ */
+export function installHoverGuard(doc: HoverGuardTarget | undefined = (globalThis as { document?: HoverGuardTarget }).document, options: HoverGuardOptions = {}): () => void {
+  if (!doc) return () => {};
+  const attribute = options.attribute ?? "data-hover-guard";
+  const arm = () => doc.documentElement.setAttribute(attribute, "true");
+  const disarm = () => doc.documentElement.removeAttribute(attribute);
+  doc.defaultView?.addEventListener("blur", arm);
+  doc.addEventListener("mouseleave", arm);
+  doc.addEventListener("pointermove", disarm, true);
+  doc.addEventListener("mousemove", disarm, true);
+  return () => {
+    doc.defaultView?.removeEventListener("blur", arm);
+    doc.removeEventListener("mouseleave", arm);
+    doc.removeEventListener("pointermove", disarm, true);
+    doc.removeEventListener("mousemove", disarm, true);
+    disarm();
+  };
+}

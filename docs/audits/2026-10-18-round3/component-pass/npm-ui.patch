+  const onActive = (id: string) => {
+    if (props.activeSection === undefined) setInnerActive(id);
+    props.onActiveSectionChange?.(id);
+    if (hashKey && typeof window !== "undefined") {
+      const next = formatSettingsHash(id, hashKey, window.location.hash);

+import { describe, expect, it, vi } from "vitest";
+import { renderToStaticMarkup } from "react-dom/server";
+import { PathPicker, SelectBox } from "./pickers.js";
+import * as core from "./core.js";
+
+describe("SelectBox", () => {
+  it("renders options, disabled options and the accessible name", () => {
+    const html = renderToStaticMarkup(
+      <SelectBox label="Quality" value="b" options={[{ value: "a", label: "A" }, { value: "b", label: "B" }, { value: "c", label: "C", disabled: true }]} onChange={() => {}} />,
+    );
+    expect(html).toContain('aria-label="Quality"');
+    expect(html).toContain('class="rk-select"');
+    expect(html).toMatch(/<option value="b" selected(="")?>B<\/option>/);
+    expect(html).toMatch(/<option value="c" disabled(="")?>C<\/option>/);
+  });
+
+  it("keeps an unknown saved value selectable", () => {
+    const html = renderToStaticMarkup(<SelectBox label="Q" value="custom" options={[{ value: "a", label: "A" }]} onChange={() => {}} />);
+    expect(html).toContain(">custom</option>");
+  });
+});
+
+describe("PathPicker", () => {
+  it("shows the value, or the placeholder when empty, with labelled buttons", () => {
+    const withValue = renderToStaticMarkup(<PathPicker id="p" label="folder" value="/a/b" pick={() => null} onChange={() => {}} onClear={() => {}} />);
+    expect(withValue).toContain("/a/b");
+    expect(withValue).toContain('aria-label="Change folder"');
+    expect(withValue).toContain('aria-label="Clear folder"');
+    const empty = renderToStaticMarkup(<PathPicker label="folder" value="" placeholder="Not set" pick={() => null} onChange={() => {}} onClear={() => {}} />);
+    expect(empty).toContain("Not set");
+    expect(empty).toContain('data-empty="true"');
+    expect(empty).not.toContain("Clear folder");
+  });
+
+  it("calls the injected picker: path reported, nothing on cancel, errors to onError", async () => {
+    const onChange = vi.fn();
+    const onError = vi.fn();
+    const picks = [Promise.resolve("/x"), Promise.resolve(null), Promise.reject(new Error("boom"))];
+    const pick = vi.fn(() => picks.shift()!);
+    const el = PathPicker({ label: "f", value: "", pick, onChange, onError }) as unknown as {
+      props: { children: Array<{ props?: { onClick?: () => void } } | null> };
+    };
+    const button = el.props.children.filter(Boolean).at(-1)!;
+    button.props!.onClick!();
+    await new Promise((r) => setTimeout(r, 0));
+    button.props!.onClick!();
+    button.props!.onClick!();
+    await new Promise((r) => setTimeout(r, 0));
+    expect(pick).toHaveBeenCalledTimes(3);
+    expect(onChange).toHaveBeenCalledTimes(1);
+    expect(onChange).toHaveBeenCalledWith("/x");
+    expect(onError).toHaveBeenCalledTimes(1);
+  });
+
+  it("is exported from /core", () => {
+    expect(typeof core.SelectBox).toBe("function");
+    expect(typeof core.PathPicker).toBe("function");
+  });
+});
diff --git a/packages/settings-ui/src/pickers.tsx b/packages/settings-ui/src/pickers.tsx
new file mode 100644
index 0000000..ab049c1
--- /dev/null
+++ b/packages/settings-ui/src/pickers.tsx
@@ -0,0 +1,82 @@
+import { cx } from "./primitives.js";
+
+export interface SelectOption<T extends string = string> {
+  value: T;
+  label: string;
+  /** Shown but not selectable (for example a Pro-only choice). */
+  disabled?: boolean;
+}
+
+export interface SelectBoxProps<T extends string = string> {
+  id?: string;
+  /** Accessible name. */
+  label: string;
+  value: T;
+  options: ReadonlyArray<SelectOption<T>>;
+  onChange: (next: T) => void;
+  className?: string;
+  disabled?: boolean;
+}
+
+/** Native select. A value missing from `options` is kept selectable so it is not silently rewritten. */
+export function SelectBox<T extends string = string>({ id, label, value, options, onChange, className, disabled }: SelectBoxProps<T>) {
+  const known = options.some((option) => option.value === value);
+  return (
+    <select id={id} className={cx("rk-select", className)} aria-label={label} value={value} disabled={disabled} onChange={(event) => onChange(event.target.value as T)}>
+      {known ? null : <option value={value}>{value}</option>}
+      {options.map((option) => (
+        <option key={option.value} value={option.value} disabled={option.disabled}>
+          {option.label}
+        </option>
+      ))}
+    </select>
+  );
+}
+
+export interface PathPickerProps {
+  id?: string;
+  /** Accessible name of the path, used in the button labels. */
+  label: string;
+  value: string;
+  placeholder?: string;
+  buttonLabel?: string;
+  clearLabel?: string;
+  /**
+   * Opens the app's own dialog and resolves to the chosen path, or null when cancelled. Injected so this package never
+   * imports a dialog plugin.
+   */
+  pick: () => Promise<string | null | undefined> | string | null | undefined;
+  onChange: (next: string) => void;
+  /** Shows a Clear button while a value is set. */
+  onClear?: () => void;
+  onError?: (error: unknown) => void;
+  className?: string;
+  disabled?: boolean;
+}
+
+/** Read-only path with a Change button that calls the injected picker, and an optional Clear button. */
+export function PathPicker({ id, label, value, placeholder, buttonLabel = "Change", clearLabel = "Clear", pick, onChange, onClear, onError, className, disabled }: PathPickerProps) {
+  const choose = async () => {
+    try {
+      const next = await pick();
+      if (typeof next === "string" && next !== "") onChange(next);
+    } catch (error) {
+      onError?.(error);
+    }
+  };
+  return (
+    <div className={cx("rk-path", className)}>
+      <span id={id} className="rk-path__value" title={value || placeholder} data-empty={value ? undefined : "true"}>
+        {value || placeholder}
+      </span>
+      {value && onClear ? (
+        <button className="rk-path__btn" type="button" disabled={disabled} onClick={onClear} aria-label={`${clearLabel} ${label}`}>
+          {clearLabel}
+        </button>
+      ) : null}
+      <button className="rk-path__btn" type="button" disabled={disabled} onClick={() => void choose()} aria-label={`${buttonLabel} ${label}`}>
+        {buttonLabel}
+      </button>
+    </div>
+  );
+}

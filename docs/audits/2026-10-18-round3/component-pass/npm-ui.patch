  * `LegalGate` documents. Each renders inline as Markdown under its title, so an app passes
- * no URL and carries no copy of the text. Pass `urls` (keyed by title) to also link a public page.
+ * no URL and carries no copy of the text.
+ *
+ * `urls` links a public page to each document. Either a record keyed by title (as before), or the manifest's
+ * documents (`legal-manifest.json` `documents[]`, or any `{ title, url }` list): a policy matches the entry with the same
+ * `role` when both have one, else the same `title`; the entry's `publicUrl` (or `url`) becomes the gate document's `url`.
+ * A policy with no match gets no `url`.
  */
 export function policyGateDocuments(
   documents: readonly DefaultPolicyDocumentLike[],
-  urls: Readonly<Record<string, string>> = {},
+  urls: Readonly<Record<string, string>> | readonly ManifestDocumentLike[] = {},
 ): LegalGateDocument[] {
-  return documents.map((doc) => ({
-    title: doc.title,
-    ...(urls[doc.title] ? { url: urls[doc.title] } : {}),
-    content: doc.content,
-    contentFormat: "markdown" as const,
-  }));
+  const lookup = (doc: DefaultPolicyDocumentLike): string | undefined => {
+    if (!Array.isArray(urls)) return (urls as Readonly<Record<string, string>>)[doc.title] || undefined;
+    const links = urls as readonly ManifestDocumentLike[];
+    const hit =
+      (doc.role !== undefined ? links.find((l) => l.role === doc.role && linkUrl(l)) : undefined) ??
+      links.find((l) => l.title === doc.title && linkUrl(l));
+    return hit ? linkUrl(hit) : undefined;
+  };
+  return documents.map((doc) => {
+    const url = lookup(doc);
+    return {
+      title: doc.title,
+      ...(url ? { url } : {}),
+      content: doc.content,
+      contentFormat: "markdown" as const,
+    };
+  });
 }

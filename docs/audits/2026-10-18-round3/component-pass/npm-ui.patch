+        className={cx("rk-modal", className)}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby={titleId}
+        aria-busy={pending ? "true" : undefined}
+        tabIndex={-1}
+        onKeyDown={onKeyDown}
+      >
+        <header className="rk-modal__header">
+          <div className="rk-modal__titles">
+            <h2 id={titleId} className="rk-modal__title">{title}</h2>
+            {subtitle ? <p className="rk-modal__subtitle">{subtitle}</p> : null}
+          </div>
+          <button type="button" className="rk-btn rk-btn--sm rk-btn--ghost rk-modal__close" aria-label={L.close ?? "Close settings"} disabled={pending} onClick={() => void requestClose()}>
+            {"✕"}
+          </button>
+        </header>
+        {bannerNode ? <div className="rk-modal__banner" role="status" data-dirty={dirty ? "true" : undefined}>{bannerNode}</div> : null}
+        <div className="rk-modal__body">
+          <SettingsPanel {...panel} title={title} navHeading={panel.navHeading ?? false} findShortcut={panel.findShortcut ?? true} activeSection={active} onActiveSectionChange={onActive} />
+        </div>
+        <footer className="rk-modal__footer">
+          <div className="rk-modal__footer-extra">{footer}</div>
+          <div className="rk-modal__footer-actions">
+            {onReload ? <button type="button" className="rk-btn rk-btn--sm rk-btn--ghost" disabled={pending} onClick={run(onReload)}>{L.reload ?? "Reload"}</button> : null}
+            {onDiscard ? <button type="button" className="rk-btn rk-btn--sm rk-btn--secondary" disabled={pending || !dirty} onClick={run(onDiscard)}>{L.discard ?? "Discard"}</button> : null}
+            {onSave ? <button type="button" className="rk-btn rk-btn--sm rk-btn--primary" disabled={pending || !dirty} onClick={run(onSave)}>{L.save ?? "Save"}</button> : null}
+          </div>
+        </footer>
+        {asking ? (
+          <div className="rk-modal__confirm" role="alertdialog" aria-modal="true" aria-labelledby={`${titleId}-c`} aria-describedby={`${titleId}-d`}>
+            <div className="rk-modal__confirm-box">
+              <h3 id={`${titleId}-c`}>{L.confirmTitle ?? "Discard unsaved changes?"}</h3>
+              <p id={`${titleId}-d`}>{L.confirmBody ?? "Your changes have not been saved and will be lost."}</p>
+              <div className="rk-modal__footer-actions">
+                <button type="button" className="rk-btn rk-btn--sm rk-btn--ghost" autoFocus onClick={() => setAsking(false)}>{L.confirmKeep ?? "Keep editing"}</button>
+                <button type="button" className="rk-btn rk-btn--sm rk-btn--danger" onClick={() => { setAsking(false); void Promise.resolve(onDiscard?.()).finally(onClose); }}>{L.confirmDiscard ?? "Discard"}</button>
+              </div>
+            </div>
+          </div>
+        ) : null}
+      </div>
+    </div>
+  );
+}

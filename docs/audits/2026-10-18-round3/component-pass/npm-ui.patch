+/**
+ * Channel-scaling shade (0.4.0), not a blend: every channel is multiplied by `(100 + percent) / 100`, rounded and clamped
+ * to 0..255. `shade("#808080", 50)` is `#C0C0C0`, `shade("#808080", -50)` is `#404040`. Lightening leaves black black and keeps
+ * a channel already at 255, unlike `mix`, which moves every channel toward its target. Alpha is dropped.
+ */
+export function shade(hex: string, percent: number): string {
+  const { r, g, b } = parseHex(hex);
+  const k = (100 + percent) / 100;
+  return toHex({ r: r * k, g: g * k, b: b * k });
+}

new file mode 100644
index 0000000..4ced45a
--- /dev/null
+++ b/packages/media-ui/src/MaskPainter.tsx
@@ -0,0 +1,218 @@
+import { useCallback, useEffect, useImperativeHandle, useRef, useState, type PointerEvent as ReactPointerEvent, type Ref } from "react";
+import { useMediaAdapters, type MediaAdapters } from "./adapters.js";
+import { maskBrushDiameter, maskCanvasPoint, maskHasPaint, maskPixelsForExport, type MaskExportFormat, type MaskPoint } from "./maskMath.js";
+
+export type MaskTool = "paint" | "erase";
+
+export interface MaskExportOptions {
+  /** `white-on-black` (default) or `alpha`. See `MaskExportFormat`. */
+  format?: MaskExportFormat;
+  /** Alpha above this (0..255) counts as painted. Default 127. */
+  threshold?: number;
+}
+
+/** Imperative handle, passed as `handleRef`. */
+export interface MaskPainterHandle {
+  /** PNG of the mask at the image's natural size. */
+  exportPng(options?: MaskExportOptions): Promise<Blob>;
+  /** Remove all paint (undoable). */
+  clear(): void;
+  /** Undo the last stroke or clear. No-op when `maxUndo` is 0 or nothing is left. */
+  undo(): void;
+  canUndo(): boolean;
+  hasMask(): boolean;
+  /** The mask canvas, for hosts that read pixels themselves. */
+  canvas(): HTMLCanvasElement | null;
+}
+
+export interface MaskPainterProps {
+  /** Image to paint over: path, URL or app route, resolved through the `resolveSrc` adapter. */
+  src: string;
+  /** Accessible name of the painting surface. Default "Mask painting area". */
+  label?: string;
+  /** Brush diameter in image pixels. Default 32. */
+  brushSize?: number;
+  /** Controlled tool. */
+  tool?: MaskTool;
+  /** Initial tool when uncontrolled. Default "paint". */
+  defaultTool?: MaskTool;
+  /** Colour of the painted overlay (a CSS colour, read when a stroke is drawn). Default "#ff2d6f". The export is always black and white. */
+  maskColor?: string;
+  /** Opacity of the overlay on screen, 0..1. Default 0.5. */
+  maskOpacity?: number;
+  /** Strokes kept for undo. Default 10; each keeps a copy of the mask, so lower it for very large images. 0 turns undo off. */
+  maxUndo?: number;
+  /** Called after each stroke or clear with whether anything is painted. */
+  onChange?: (hasMask: boolean) => void;
+  /** Called once the image has loaded, with its natural size. */
+  onReady?: (size: { width: number; height: number }) => void;
+  onError?: (error: Error) => void;
+  handleRef?: Ref<MaskPainterHandle>;
+  className?: string;
+  adapters?: MediaAdapters;
+}
+
+/**
+ * Paint a mask over an image (0.4.0): a round brush and eraser on a canvas the size of the image, and an export of the mask as PNG
+ * (white = painted, the usual inpainting mask, or alpha-only). Pointer input only (mouse, pen, touch); the host adds its own tool
+ * buttons and drives the tool, size and undo through props and `handleRef`. The package renders no toolbar.
+ *
+ * Hooks: root `data-tool`, `data-has-mask`, `data-ready`. Classes `rk-mask`, `rk-mask-image`, `rk-mask-canvas`.
+ */
+export function MaskPainter(props: MaskPainterProps) {
+  const { src, label = "Mask painting area", brushSize = 32, defaultTool = "paint", maskColor = "#ff2d6f", maskOpacity = 0.5, maxUndo = 10, onChange, onReady, onError, handleRef, className } = props;
+  const adapters = useMediaAdapters(props.adapters);
+  const tool = props.tool ?? defaultTool;
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const undoStack = useRef<ImageData[]>([]);
+  const stroke = useRef<{ last: MaskPoint; id: number } | null>(null);
+  const [ready, setReady] = useState(false);
+  const [has, setHas] = useState(false);
+
+  const ctx = () => canvasRef.current?.getContext("2d", { willReadFrequently: true }) ?? null;
+  const pixels = (): ImageData | null => {
+    const canvas = canvasRef.current;
+    const c = ctx();
+    return canvas && c && canvas.width > 0 && canvas.height > 0 ? c.getImageData(0, 0, canvas.width, canvas.height) : null;
+  };
+  const report = useCallback(() => {
+    const data = pixels();
+    const next = data ? maskHasPaint(data.data) : false;
+    setHas(next);
+    onChange?.(next);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [onChange]);
+  const snapshot = () => {
+    if (maxUndo <= 0) return;
+    const data = pixels();
+    if (!data) return;
+    undoStack.current.push(data);
+    if (undoStack.current.length > maxUndo) undoStack.current.shift();
+  };
+
+  useEffect(() => {
+    // A new image starts with an empty mask.
+    undoStack.current = [];
+    stroke.current = null;
+    setReady(false);
+    setHas(false);
+  }, [src]);
+
+  useImperativeHandle(handleRef, () => ({
+    async exportPng(options: MaskExportOptions = {}) {
+      const canvas = canvasRef.current;
+      const data = pixels();
+      if (!canvas || !data) throw new Error("The image has not loaded yet");
+      const out = document.createElement("canvas");
+      out.width = canvas.width;
+      out.height = canvas.height;
+      const c = out.getContext("2d");
+      if (!c) throw new Error("Canvas is unavailable");
+      c.putImageData(new ImageData(maskPixelsForExport(data.data, options.format, options.threshold), data.width, data.height), 0, 0);
+      return new Promise<Blob>((resolve, reject) => out.toBlob((blob) => (blob ? resolve(blob) : reject(new Error("Could not encode the mask"))), "image/png"));
+    },
+    clear() {
+      const canvas = canvasRef.current;
+      const c = ctx();
+      if (!canvas || !c) return;
+      snapshot();
+      c.clearRect(0, 0, canvas.width, canvas.height);
+      report();
+    },
+    undo() {
+      const previous = undoStack.current.pop();
+      const c = ctx();
+      if (!previous || !c) return;
+      c.putImageData(previous, 0, 0);
+      report();
+    },
+    canUndo: () => undoStack.current.length > 0,
+    hasMask: () => {
+      const data = pixels();
+      return data ? maskHasPaint(data.data) : false;
+    },
+    canvas: () => canvasRef.current,
+  }));
+
+  const dab = (from: MaskPoint, to: MaskPoint) => {
+    const canvas = canvasRef.current;
+    const c = ctx();
+    if (!canvas || !c) return;
+    c.save();
+    c.globalCompositeOperation = tool === "erase" ? "destination-out" : "source-over";
+    c.strokeStyle = maskColor;
+    c.fillStyle = maskColor;
+    c.lineCap = "round";
+    c.lineJoin = "round";
+    c.lineWidth = maskBrushDiameter(brushSize, canvas);
+    c.beginPath();
+    c.moveTo(from.x, from.y);
+    c.lineTo(to.x, to.y);
+    c.stroke();
+    c.restore();
+  };
+  const pointOf = (event: ReactPointerEvent<HTMLCanvasElement>): MaskPoint => {
+    const canvas = event.currentTarget;
+    return maskCanvasPoint(event.clientX, event.clientY, canvas.getBoundingClientRect(), canvas);
+  };
+  const onDown = (event: ReactPointerEvent<HTMLCanvasElement>) => {
+    if (!ready || (event.pointerType === "mouse" && event.button !== 0)) return;
+    event.preventDefault();
+    event.currentTarget.setPointerCapture?.(event.pointerId);
+    const point = pointOf(event);
+    snapshot();
+    stroke.current = { last: point, id: event.pointerId };
+    dab(point, point);
+  };
+  const onMove = (event: ReactPointerEvent<HTMLCanvasElement>) => {
+    const current = stroke.current;
+    if (!current || current.id !== event.pointerId) return;
+    const point = pointOf(event);
+    dab(current.last, point);
+    current.last = point;
+  };
+  const onUp = (event: ReactPointerEvent<HTMLCanvasElement>) => {
+    const current = stroke.current;
+    if (!current || current.id !== event.pointerId) return;
+    stroke.current = null;
+    event.currentTarget.releasePointerCapture?.(event.pointerId);
+    report();
+  };
+
+  return (
+    <div
+      className={["rk-mask", className].filter(Boolean).join(" ")}
+      data-tool={tool}
+      data-has-mask={has ? "true" : "false"}
+      data-ready={ready ? "true" : "false"}
+    >
+      <img
+        className="rk-mask-image"
+        src={adapters.resolveSrc?.(src) ?? src}
+        alt=""
+        draggable={false}
+        onLoad={(event) => {
+          const image = event.currentTarget;
+          const canvas = canvasRef.current;
+          if (!canvas) return;
+          canvas.width = image.naturalWidth;
+          canvas.height = image.naturalHeight;
+          setReady(true);
+          onReady?.({ width: image.naturalWidth, height: image.naturalHeight });
+        }}
+        onError={() => onError?.(new Error("The image could not be loaded"))}
+      />
+      <canvas
+        ref={canvasRef}
+        className="rk-mask-canvas"
+        role="img"
+        aria-label={label}
+        style={{ opacity: maskOpacity }}
+        onPointerDown={onDown}
+        onPointerMove={onMove}
+        onPointerUp={onUp}
+        onPointerCancel={onUp}
+      />
+    </div>
+  );
+}

diff --git a/packages/media-ui/src/maskMath.ts b/packages/media-ui/src/maskMath.ts
new file mode 100644
index 0000000..1daab81
--- /dev/null
+++ b/packages/media-ui/src/maskMath.ts
@@ -0,0 +1,54 @@
+// Pure helpers for the mask painter: coordinates and pixel conversion. No DOM, so they are unit-testable.
+
+export interface MaskPoint {
+  x: number;
+  y: number;
+}
+
+/** Layout box of the painted element, as `getBoundingClientRect()` reports it. */
+export interface MaskRect {
+  left: number;
+  top: number;
+  width: number;
+  height: number;
+}
+
+/** A pointer position (client pixels) in canvas pixels. A zero-size rect maps to the origin. */
+export function maskCanvasPoint(clientX: number, clientY: number, rect: MaskRect, canvas: { width: number; height: number }): MaskPoint {
+  if (!(rect.width > 0) || !(rect.height > 0)) return { x: 0, y: 0 };
+  return { x: ((clientX - rect.left) / rect.width) * canvas.width, y: ((clientY - rect.top) / rect.height) * canvas.height };
+}
+
+/** Brush diameter in canvas pixels: `brushSize` is in image pixels already, so this only bounds it to at least 1 and at most the canvas. */
+export function maskBrushDiameter(brushSize: number, canvas: { width: number; height: number }): number {
+  const size = Number.isFinite(brushSize) ? brushSize : 1;
+  return Math.max(1, Math.min(size, Math.max(canvas.width, canvas.height)));
+}
+
+/** `white-on-black`: painted pixels are opaque white, the rest opaque black (the usual inpainting mask). `alpha`: painted pixels are
+ *  opaque white, the rest fully transparent. */
+export type MaskExportFormat = "white-on-black" | "alpha";
+
+/**
+ * Convert the painter's RGBA buffer (painted = alpha above `threshold`, 0..255) to an export buffer. Returns a new buffer of the same
+ * length. A partly painted edge (anti-aliasing) counts as painted when its alpha is above `threshold` (default 127), so the export is
+ * strictly two-valued.
+ */
+export function maskPixelsForExport(rgba: Uint8ClampedArray, format: MaskExportFormat = "white-on-black", threshold = 127): Uint8ClampedArray {
+  const out = new Uint8ClampedArray(rgba.length);
+  for (let i = 0; i + 3 < rgba.length; i += 4) {
+    const painted = rgba[i + 3]! > threshold;
+    const value = painted ? 255 : 0;
+    out[i] = value;
+    out[i + 1] = value;
+    out[i + 2] = value;
+    out[i + 3] = format === "white-on-black" ? 255 : painted ? 255 : 0;
+  }
+  return out;
+}
+
+/** True when any pixel is painted (alpha above `threshold`). */
+export function maskHasPaint(rgba: Uint8ClampedArray, threshold = 0): boolean {
+  for (let i = 3; i < rgba.length; i += 4) if (rgba[i]! > threshold) return true;
+  return false;
+}

+describe("unstyled module", () => {
+  it("imports only react and adds no rk- class", () => {
+    const text = readFileSync(join(process.cwd(), "src", "unstyled.tsx"), "utf8");
+    const specs = [...text.matchAll(/from\s+["']([^"']+)["']/g)].map((m) => m[1]);
+    expect(specs).toEqual(["react"]);
+    expect(text).not.toMatch(/["'`]rk-/);
+  });
+});
+
+describe("SettingsFrame", () => {
+  it("renders grouped nav buttons, the first section and the header, with no classes by default", async () => {
+    const { container } = render(<SettingsFrame sections={sections} title="Settings" />);
+    const nav = screen.getByRole("navigation", { name: "Settings" });
+    expect(within(nav).getAllByRole("button").map((b) => b.textContent)).toEqual(["Diagnostics", "About", "Theme"]);
+    expect(screen.getByRole("heading", { level: 2, name: "Diagnostics" })).toBeInTheDocument();
+    expect(screen.getByText("Logs")).toBeInTheDocument();
+    expect(screen.getByText("diag body")).toBeInTheDocument();
+    expect(container.querySelector("[class]")).toBeNull();
+    const active = screen.getByRole("button", { name: "Diagnostics" });
+    expect(active).toHaveAttribute("aria-current", "page");
+    expect(active).toHaveAttribute("data-active", "true");
+    expect(active).toHaveAttribute("data-settings-section", "diagnostics");
+  });
+
+  it("switches sections, skips the header when hideHeader, and reports changes", async () => {
+    const user = userEvent.setup();
+    const onActiveChange = vi.fn();
+    render(<SettingsFrame sections={sections} onActiveChange={onActiveChange} />);
+    await user.click(screen.getByRole("button", { name: "About" }));
+    expect(onActiveChange).toHaveBeenCalledWith("about");
+    expect(screen.getByText("about body")).toBeInTheDocument();
+    expect(screen.queryByRole("heading", { level: 2 })).toBeNull();
+    await user.click(screen.getByRole("button", { name: /Theme/ }));
+    expect(screen.getByRole("heading", { level: 2, name: "Theme" })).toBeInTheDocument();
+  });
+
+  it("is controlled by activeId", async () => {
+    const user = userEvent.setup();
+    render(<SettingsFrame sections={sections} activeId="theme" />);
+    await user.click(screen.getByRole("button", { name: "About" }));
+    expect(screen.getByText("theme body")).toBeInTheDocument();
+  });
+
+  it("applies classNames and slots, and shows a close button only with onClose", async () => {
+    const user = userEvent.setup();
+    const onClose = vi.fn();
+    const { container, rerender } = render(
+      <SettingsFrame
+        sections={sections}
+        classNames={{ root: "r", navItem: "ni", navItemActive: "on", navItemInactive: "off", navGroupLabel: "gl", body: "b", close: "x" }}
+        slots={{ navItem: (s, { active }) => <b>{s.label}{active ? "*" : ""}</b>, navGroupLabel: (l) => <u>{l}</u> }}
+        onClose={onClose}
+      />,
+    );
+    expect(container.firstElementChild).toHaveClass("r");
+    expect(screen.getByRole("button", { name: "Diagnostics*" })).toHaveClass("ni", "on");
+    expect(screen.getByRole("button", { name: "About" })).toHaveClass("ni", "off");
+    expect(container.querySelector("u")?.textContent).toBe("Support");
+    await user.click(screen.getByRole("button", { name: "Close settings" }));
+    expect(onClose).toHaveBeenCalledTimes(1);
+    rerender(<SettingsFrame sections={sections} />);
+    expect(screen.queryByRole("button", { name: "Close settings" })).toBeNull();
+  });
+
+  it("slots.content and slots.header replace the body", () => {
+    render(<SettingsFrame sections={sections} slots={{ header: (s) => <h1>custom {s.id}</h1>, content: () => <p>replaced</p> }} />);
+    expect(screen.getByRole("heading", { level: 1, name: "custom diagnostics" })).toBeInTheDocument();
+    expect(screen.getByText("replaced")).toBeInTheDocument();
+    expect(screen.queryByText("diag body")).toBeNull();
+  });
+});
+
+describe("UpdatesView", () => {
+  it("shows version, status, last checked and an enabled Check button", async () => {
+    const user = userEvent.setup();
+    const onCheck = vi.fn();
+    render(<UpdatesView status={{ kind: "up_to_date" }} currentVersion="1.2.3" lastCheckedAt={1000} labels={{ lastChecked: (at) => `checked @${at}` }} onCheck={onCheck} />);
+    expect(screen.getByText("Version 1.2.3")).toBeInTheDocument();
+    expect(screen.getByRole("status")).toHaveTextContent("You are up to date.");
+    expect(screen.getByText("checked @1000")).toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "Check for updates" }));
+    expect(onCheck).toHaveBeenCalledTimes(1);
+  });
+
+  it("offers Install for an eligible update and hides it with the upgrade hint when not covered", async () => {
+    const user = userEvent.setup();
+    const onInstall = vi.fn();
+    const { rerender } = render(<UpdatesView status={{ kind: "available", version: "2.0.0", eligible: true }} onCheck={() => {}} onInstall={onInstall} />);
+    expect(screen.getByRole("status")).toHaveTextContent("Version 2.0.0 is available.");
+    await user.click(screen.getByRole("button", { name: "Install update" }));
+    expect(onInstall).toHaveBeenCalledTimes(1);
+    rerender(<UpdatesView status={{ kind: "available", version: "2.0.0", eligible: false }} onCheck={() => {}} onInstall={onInstall} upgradeHint="Pro only" />);
+    expect(screen.queryByRole("button", { name: "Install update" })).toBeNull();
+    expect(screen.getByText("Pro only")).toBeInTheDocument();
+  });
+
+  it("disables buttons while busy, shows the pending label, and offers Restart when ready", async () => {
+    const user = userEvent.setup();
+    const onRestart = vi.fn();
+    const { rerender } = render(<UpdatesView status={{ kind: "checking" }} pending="check" onCheck={() => {}} />);
+    expect(screen.getByRole("button", { name: "Checking…" })).toBeDisabled();
+    rerender(<UpdatesView status={{ kind: "ready", version: "2.0.0" }} onCheck={() => {}} onRestart={onRestart} />);
+    await user.click(screen.getByRole("button", { name: "Restart now" }));
+    expect(onRestart).toHaveBeenCalledTimes(1);
+  });
+
+  it("status text covers each kind, and the root carries data-update-status", () => {
+    expect(updateStatusText({ kind: "idle" })).toBe("Not checked yet.");
+    expect(updateStatusText({ kind: "downloading", version: "2", pct: 41.6 })).toBe("Downloading 2… 42%");
+    expect(updateStatusText({ kind: "deferred", version: "2", reason: "app_busy" })).toBe("Version 2 will install later: app busy.");
+    expect(updateStatusText({ kind: "error", message: "offline" })).toBe("offline");
+    const { container } = render(<UpdatesView status={{ kind: "idle" }} onCheck={() => {}} />);
+    expect(container.firstElementChild).toHaveAttribute("data-update-status", "idle");
+    expect(container.querySelector("[class]")).toBeNull();
+  });
+});
+
+describe("LegalLinksView", () => {
+  it("renders a labelled nav of plain anchors", () => {
+    render(<LegalLinksView heading="Right Suite Desktop License v1.0" documents={[{ title: "EULA", url: "https://e.app/eula/" }, { title: "Privacy", url: "https://e.app/privacy/" }]} classNames={{ link: "lnk" }} />);
+    const nav = screen.getByRole("navigation", { name: "Legal documents" });
+    const links = within(nav).getAllByRole("link");
+    expect(links.map((a) => [a.textContent, a.getAttribute("href")])).toEqual([["EULA", "https://e.app/eula/"], ["Privacy", "https://e.app/privacy/"]]);
+    expect(links[0]).toHaveClass("lnk");
+    expect(screen.getByText("Right Suite Desktop License v1.0")).toBeInTheDocument();
+  });
+  it("renderLink replaces the anchor", () => {
+    render(<LegalLinksView documents={[{ title: "EULA", url: "u" }]} renderLink={(d) => <button>{d.title}</button>} />);
+    expect(screen.getByRole("button", { name: "EULA" })).toBeInTheDocument();
+  });
+});
+
+describe("AboutView", () => {
+  it("renders the card, children and footer in order", () => {
+    const { container } = render(
+      <AboutView appName="ViewRight" tagline="Local-first" badge="Local" version="1.0.0" build="42" links={[{ label: "site", url: "https://viewright.cc" }]} footer={<footer>legal</footer>}>
+        <section>updates</section>
+      </AboutView>,

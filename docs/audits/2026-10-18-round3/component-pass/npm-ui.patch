@@ -0,0 +1,82 @@
+import { describe, expect, it } from "vitest";
+import { renderToStaticMarkup } from "react-dom/server";
+import { MaskPainter, MediaAdaptersProvider, MediaThumbnail, maskBrushDiameter, maskCanvasPoint, maskHasPaint, maskPixelsForExport } from "./index.js";
+
+describe("MediaThumbnail", () => {
+  it("renders a muted, controlless, paused metadata video showing one frame", () => {
+    const html = renderToStaticMarkup(<MediaThumbnail src="/clips/a.mp4" kind="video" label="Clip A" />);
+    expect(html).toContain('class="rk-media-thumb"');
+    expect(html).toContain('data-kind="video"');
+    expect(html).toContain('role="img"');
+    expect(html).toContain('aria-label="Clip A"');
+    expect(html).toContain('src="/clips/a.mp4#t=0.1"');
+    expect(html).toMatch(/<video[^>]*preload="metadata"/);
+    expect(html).toContain("muted");
+    expect(html).not.toContain("controls");
+    expect(html).not.toContain("autoplay");
+    expect(html).toContain('tabindex="-1"');
+  });
+
+  it("is decorative without a label, honours frameTime and a source fragment", () => {
+    const decorative = renderToStaticMarkup(<MediaThumbnail src="/a.mp4" kind="video" frameTime={2} />);
+    expect(decorative).toContain('aria-hidden="true"');
+    expect(decorative).not.toContain('role="img"');
+    expect(decorative).toContain("#t=2");
+    expect(renderToStaticMarkup(<MediaThumbnail src="/a.mp4#t=9" kind="video" />)).toContain('src="/a.mp4#t=9"');
+    expect(renderToStaticMarkup(<MediaThumbnail src="/a.mp4" kind="video" frameTime={0} />)).toContain('src="/a.mp4"');
+  });
+
+  it("shows a placeholder face for audio, or its artwork, and resolves sources through the adapter", () => {
+    const audio = renderToStaticMarkup(<MediaThumbnail src="/a.mp3" kind="audio" label="Song" />);
+    expect(audio).toContain("rk-media-thumb-face");
+    expect(audio).toContain('data-state="ready"');
+    expect(audio).not.toContain("<video");
+    expect(audio).not.toContain("<audio");
+    const art = renderToStaticMarkup(
+      <MediaAdaptersProvider adapters={{ resolveSrc: (s) => `asset://${s}` }}>
+        <MediaThumbnail src="/a.mp3" kind="audio" poster="/cover.jpg" />
+      </MediaAdaptersProvider>,
+    );
+    expect(art).toContain('src="asset:///cover.jpg"');
+  });
+});
+
+describe("mask math", () => {
+  it("maps client pixels to canvas pixels", () => {
+    expect(maskCanvasPoint(150, 120, { left: 100, top: 100, width: 200, height: 100 }, { width: 400, height: 200 })).toEqual({ x: 100, y: 40 });
+    expect(maskCanvasPoint(5, 5, { left: 0, top: 0, width: 0, height: 0 }, { width: 10, height: 10 })).toEqual({ x: 0, y: 0 });
+  });
+
+  it("bounds the brush diameter", () => {
+    expect(maskBrushDiameter(0, { width: 100, height: 50 })).toBe(1);
+    expect(maskBrushDiameter(32, { width: 100, height: 50 })).toBe(32);
+    expect(maskBrushDiameter(500, { width: 100, height: 50 })).toBe(100);
+    expect(maskBrushDiameter(Number.NaN, { width: 100, height: 50 })).toBe(1);
+  });
+
+  it("exports strictly two-valued white-on-black or alpha-only pixels", () => {
+    // pixel 0: painted, pixel 1: anti-aliased edge below the threshold, pixel 2: empty
+    const rgba = new Uint8ClampedArray([255, 45, 111, 255, 255, 45, 111, 100, 0, 0, 0, 0]);
+    expect(Array.from(maskPixelsForExport(rgba))).toEqual([255, 255, 255, 255, 0, 0, 0, 255, 0, 0, 0, 255]);
+    expect(Array.from(maskPixelsForExport(rgba, "alpha"))).toEqual([255, 255, 255, 255, 0, 0, 0, 0, 0, 0, 0, 0]);
+    expect(Array.from(maskPixelsForExport(rgba, "white-on-black", 50)).slice(4, 8)).toEqual([255, 255, 255, 255]);
+  });
+
+  it("detects paint", () => {
+    expect(maskHasPaint(new Uint8ClampedArray([0, 0, 0, 0, 9, 9, 9, 0]))).toBe(false);
+    expect(maskHasPaint(new Uint8ClampedArray([0, 0, 0, 0, 9, 9, 9, 1]))).toBe(true);
+  });
+});
+
+describe("MaskPainter markup", () => {

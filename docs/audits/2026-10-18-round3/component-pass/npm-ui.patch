diff --git a/packages/settings-ui/src/modal.tsx b/packages/settings-ui/src/modal.tsx
new file mode 100644
index 0000000..3142dbb
--- /dev/null
+++ b/packages/settings-ui/src/modal.tsx
@@ -0,0 +1,230 @@
+import { useCallback, useEffect, useId, useRef, useState, type KeyboardEvent as ReactKeyboardEvent, type ReactNode } from "react";
+import { cx } from "./primitives.js";
+import { SettingsPanel, type SettingsPanelProps } from "./SettingsPanel.js";
+
+/** Reads `#<key>=<value>` from a location hash. Returns null when the hash does not carry that key. */
+export function parseSettingsHash(hash: string, key = "settings"): string | null {
+  const body = hash.startsWith("#") ? hash.slice(1) : hash;
+  for (const part of body.split("&")) {
+    const eq = part.indexOf("=");
+    if (eq > 0 && part.slice(0, eq) === key) {
+      try {
+        return decodeURIComponent(part.slice(eq + 1)) || null;
+      } catch {
+        return null;
+      }
+    }
+  }
+  return null;
+}
+
+/** The hash for `#<key>=<value>`, keeping other `&` parts of `current`. A null value removes the key. */
+export function formatSettingsHash(value: string | null, key = "settings", current = ""): string {
+  const body = current.startsWith("#") ? current.slice(1) : current;
+  const kept = body.split("&").filter((p) => {
+    const eq = p.indexOf("=");
+    return p !== "" && !(eq > 0 && p.slice(0, eq) === key);
+  });
+  if (value) kept.push(`${key}=${encodeURIComponent(value)}`);
+  return kept.length ? `#${kept.join("&")}` : "";
+}
+
+const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), summary, [tabindex]:not([tabindex="-1"])';
+
+function focusables(root: HTMLElement): HTMLElement[] {
+  return [...root.querySelectorAll<HTMLElement>(FOCUSABLE)].filter((el) => !el.hidden && el.getAttribute("aria-hidden") !== "true" && el.closest("[hidden]") === null);
+}
+
+export interface SettingsModalLabels {
+  /** Dismiss (header close button) accessible name. Default "Close settings". */
+  close?: string;
+  /** Default "You have unsaved changes." */
+  dirty?: string;
+  reload?: string;
+  discard?: string;
+  save?: string;
+  /** Texts of the built-in discard confirmation. */
+  confirmTitle?: string;
+  confirmBody?: string;
+  confirmKeep?: string;
+  confirmDiscard?: string;
+}
+
+export interface SettingsModalProps {
+  open: boolean;
+  /** Called when the modal should close: Escape, backdrop, the close button, and after a confirmed discard. */
+  onClose: () => void;
+  /** Panel props (sections, backend, search options). `activeSection`, `onActiveSectionChange` and `title` are set by the modal. */
+  panel: Omit<SettingsPanelProps, "activeSection" | "onActiveSectionChange" | "activeId" | "onActiveChange" | "title">;
+  /** Dialog title (also the panel's nav heading). Default "Settings". */
+  title?: ReactNode;
+  subtitle?: ReactNode;
+  /** Controlled active section id. */
+  activeSection?: string;
+  onActiveSectionChange?: (id: string) => void;
+  /** The draft differs from what is saved. Shows the banner, enables Save and Discard, and arms the close guard. */
+  dirty?: boolean;
+  /** A save or reload is running: close, Save, Discard and Reload are disabled and Escape does nothing. */
+  pending?: boolean;
+  onSave?: () => void | Promise<void>;
+  /** Throw the draft away. The modal does not close itself. */
+  onDiscard?: () => void | Promise<void>;
+  /** Reload the saved settings. The Reload button renders only when set. */
+  onReload?: () => void | Promise<void>;
+  /** Replaces the dirty banner. `false` shows none. Default: a status line while `dirty`. */
+  banner?: ReactNode | false;
+  /** Extra content on the left of the footer buttons. */
+  footer?: ReactNode;
+  /**
+   * Close guard when `dirty`. `true` (default) asks with the built-in "Discard unsaved changes?" dialog; `false` closes without asking;
+   * a function replaces the dialog and resolves whether to close (it should also call `onDiscard` itself if that is wanted). Confirming the built-in
+   * dialog calls `onDiscard` (when set), then `onClose`.
+   */
+  confirmDiscard?: boolean | (() => boolean | Promise<boolean>);
+  /**
+   * Keeps the active section in `location.hash` as `#<deepLinkHash>=<id>` and opens on it when present (for example `"settings"`).
+   * Other hash parts are kept. `false`/unset: no hash handling.
+   */
+  deepLinkHash?: string | false;
+  labels?: SettingsModalLabels;
+  className?: string;
+}
+
+/**
+ * Settings as a modal with a draft model (0.7.0): `role="dialog"` with `aria-modal`, a backdrop, a focus trap that restores focus on close,
+ * Escape and backdrop close, a dirty banner, a footer with Reload / Discard / Save, a close guard that asks "Discard unsaved changes?" while
+ * `dirty`, a `pending` lock, and an optional `#settings=<id>` deep link. The content is a `SettingsPanel` (nav, search, sections).
+ * Imports only `react`; the overlay is `position: fixed` inside the tree it is rendered in. Cmd/Ctrl-F focuses the panel search.
+ */
+export function SettingsModal(props: SettingsModalProps) {
+  const { open, onClose, panel, title = "Settings", subtitle, dirty = false, pending = false, onSave, onDiscard, onReload, banner, footer, confirmDiscard = true, deepLinkHash = false, labels = {}, className } = props;
+  const titleId = useId();
+  const dialog = useRef<HTMLDivElement>(null);
+  const [asking, setAsking] = useState(false);
+  const [innerActive, setInnerActive] = useState<string | undefined>(undefined);
+  const hashKey = deepLinkHash === false ? null : deepLinkHash;
+
+  // Active section: controlled, else the deep link, else the panel's first.

+
+/**
+ * Structural match for one entry of a legal manifest (`legal-manifest.json` `documents[]`): the public page of a document.
+ * `publicUrl` is the manifest's name; `url` is accepted so a plain `{ title, url }` link list works too.
+ */
+export interface ManifestDocumentLike {
+  readonly title: string;
+  readonly role?: string;
+  readonly publicUrl?: string;
+  readonly url?: string;
+}
+
+export interface ManifestGateLinkOptions {
+  /** Display titles by manifest `role`, for suite titles too long for the gate list (`{ license: "License" }`). */
+  readonly shortTitles?: Readonly<Record<string, string>>;
+  /** Roles left out of the gate (a build-provenance appendix such as `third_party_notices`). */
+  readonly excludeRoles?: readonly string[];
+}
+
+const linkUrl = (doc: ManifestDocumentLike): string | undefined => doc.publicUrl ?? doc.url;
+
+/**
+ * The manifest's documents as link-only `LegalGate` documents (`title` + `url`), in manifest order. Titles and URLs come
+ * from the manifest, so a changed `publicUrl` or title reaches the gate with no second copy. Entries without a URL are skipped.
+ */
+export function manifestGateLinks(
+  documents: readonly ManifestDocumentLike[],
+  options: ManifestGateLinkOptions = {},
+): LegalGateDocument[] {
+  const excluded = new Set(options.excludeRoles ?? []);
+  const out: LegalGateDocument[] = [];
+  for (const doc of documents) {
+    if (doc.role !== undefined && excluded.has(doc.role)) continue;
+    const url = linkUrl(doc);
+    if (!url) continue;
+    out.push({ title: (doc.role !== undefined ? options.shortTitles?.[doc.role] : undefined) ?? doc.title, url });
+  }
+  return out;
 }
 

diff --git a/packages/pdf-ui/src/linkLayer.ts b/packages/pdf-ui/src/linkLayer.ts
new file mode 100644
index 0000000..80a160d
--- /dev/null
+++ b/packages/pdf-ui/src/linkLayer.ts
@@ -0,0 +1,67 @@
+// A small link overlay: one transparent <a> per Link annotation. It uses the same link service as the exported
+// `createPdfLinkService`, so only http(s) and mailto URLs ever reach the host, and no document URL is put in `href`.
+// This is not pdf.js's AnnotationLayer: form widgets, popups and other annotation kinds are not drawn.
+import type { PdfLinkService } from "./linkService.js";
+
+/** The slice of a pdf.js page this needs. `PDFPageProxy` satisfies it. */
+export interface LinkLayerPage {
+  getAnnotations(params?: { intent?: string }): Promise<unknown[]>;
+}
+
+/** The slice of a pdf.js viewport this needs. `PageViewport` satisfies it. */
+export interface LinkLayerViewport {
+  convertToViewportRectangle(rect: number[]): number[];
+}
+
+interface LinkAnnotation {
+  subtype?: string;
+  rect?: number[];
+  url?: string;
+  unsafeUrl?: string;
+  dest?: string | unknown[] | null;
+  action?: string;
+}
+
+/**
+ * Fill `container` with link boxes for the page's Link annotations and return how many were drawn. A link with a URL opens it through
+ * the link service (unsafe schemes are dropped); one with a destination or a named page action goes through the service's
+ * navigation. Annotations without a usable rectangle or target are skipped.
+ */
+export async function renderPdfLinkLayer(
+  page: LinkLayerPage,
+  container: HTMLElement,
+  viewport: LinkLayerViewport,
+  linkService: PdfLinkService,
+): Promise<number> {
+  const annotations = (await page.getAnnotations({ intent: "display" })) as LinkAnnotation[];
+  const layer = container.ownerDocument.createElement("div");
+  layer.className = "rk-pdf-links";
+  let drawn = 0;
+  for (const annotation of annotations) {
+    if (annotation.subtype !== "Link" || !Array.isArray(annotation.rect) || annotation.rect.length < 4) continue;
+    const url = annotation.url ?? annotation.unsafeUrl;
+    const hasTarget = typeof url === "string" || annotation.dest != null || typeof annotation.action === "string";
+    if (!hasTarget) continue;
+    const [x1, y1, x2, y2] = viewport.convertToViewportRectangle(annotation.rect) as [number, number, number, number];
+    const link = container.ownerDocument.createElement("a");
+    link.className = "rk-pdf-link";
+    link.style.left = `${Math.min(x1, x2)}px`;
+    link.style.top = `${Math.min(y1, y2)}px`;
+    link.style.width = `${Math.abs(x2 - x1)}px`;
+    link.style.height = `${Math.abs(y2 - y1)}px`;
+    if (typeof url === "string") {
+      linkService.addLinkAttributes(link, url);
+    } else {
+      link.href = "#";
+      link.addEventListener("click", (event) => {
+        event.preventDefault();
+        if (annotation.dest != null) linkService.goToDestination(annotation.dest);
+        else if (annotation.action) linkService.executeNamedAction(annotation.action);
+      });
+    }
+    layer.append(link);
+    drawn += 1;
+  }
+  container.append(layer);
+  return drawn;
+}

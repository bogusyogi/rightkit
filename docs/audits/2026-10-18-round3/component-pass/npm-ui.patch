+/**
+ * Unstyled / slot variants of the settings frame and of the updates, about, legal and diagnostics sections, for an
+ * app that keeps its own markup, classes and wording (ViewRight). Imports only `react`: no stylesheet, no rk-prefixed class,
+ * no `@rightkit/react-shell`, `license`, `logs` or `app-update`.
+ *
+ * Every component is controlled by props and renders plain elements. Nothing here owns persistence, clients or timers: the app
+ * passes state and handlers (for example from `useUpdates` or its own store). Each part takes a `classNames` entry (applied
+ * as `className`, nothing is added) and the larger parts take `slots` (render functions that replace one part). Stable
+ * `data-*` hooks and ARIA attributes are documented per component.
+ */
+import { Fragment, useState, type ReactNode } from "react";
+
+const cx = (...parts: Array<string | false | null | undefined>) => parts.filter(Boolean).join(" ") || undefined;
+
+/* ---- Frame ----------------------------------------------------------------------------------- */
+
+export interface FrameSection {
+  id: string;
+  label: string;
+  /** Nav group heading. Sections sharing a group sit together, groups in order of first appearance. */
+  group?: string;
+  /** Nav icon, rendered before the label unless `slots.navItem` is set. */
+  icon?: ReactNode;
+  /** Header title; default `label`. */
+  heading?: ReactNode;
+  /** Header subtitle (a short line under the title). */
+  subtitle?: ReactNode;
+  /** Omit this section's header (for a section that draws its own, such as About). */
+  hideHeader?: boolean;
+  render(): ReactNode;
+}
+
+export type FrameClassNames = Partial<Record<"root" | "nav" | "navTitle" | "navGroup" | "navGroupLabel" | "navItem" | "navItemActive" | "navItemInactive" | "navFooter" | "body" | "header" | "heading" | "subtitle" | "close", string>>;
+
+export interface FrameSlots {
+  /** Replace the content of a nav button (icon, label, badge). The button stays: `data-settings-section`, `aria-current`. */
+  navItem?: (section: FrameSection, state: { active: boolean }) => ReactNode;
+  /** Replace a group heading. */
+  navGroupLabel?: (label: string) => ReactNode;
+  /** Replace the header of the active section. Not called for a section with `hideHeader`. */
+  header?: (section: FrameSection) => ReactNode;
+  /** Replace the whole close button. Receives the close handler. */
+  close?: (onClose: () => void) => ReactNode;
+  /** Replace the body content of the active section (default: `section.render()` under the header). */
+  content?: (section: FrameSection) => ReactNode;
+}
+
+export interface SettingsFrameProps {
+  sections: readonly FrameSection[];
+  /** Controlled active id. */
+  activeId?: string;
+  defaultActiveId?: string;
+  onActiveChange?: (id: string) => void;
+  /** Nav heading; omitted when unset. */
+  title?: ReactNode;
+  /** Accessible name of the nav. Default: `title` when a string, else "Settings". */
+  navLabel?: string;
+  navFooter?: ReactNode;
+  /** Shows a close button in the body. */
+  onClose?: () => void;
+  closeLabel?: string;
+  /** Close button content when `slots.close` is unset. Default "✕". */
+  closeContent?: ReactNode;
+  classNames?: FrameClassNames;
+  slots?: FrameSlots;
+}
+
+/**
+ * Settings frame with no styling: a nav of grouped section buttons beside the active section's body.
+ * Hooks: root `data-settings-frame`; nav buttons `data-settings-section="<id>"`, `aria-current="page"` and `data-active="true"`
+ * on the active one; body `data-settings-body`.
+ */
+export function SettingsFrame(props: SettingsFrameProps) {
+  const { sections, classNames: c = {}, slots = {} } = props;
+  const [inner, setInner] = useState(props.defaultActiveId ?? sections[0]?.id ?? "");
+  const currentId = props.activeId ?? inner;
+  const active = sections.find((s) => s.id === currentId) ?? sections[0];
+  const select = (id: string) => {
+    if (props.activeId === undefined) setInner(id);
+    props.onActiveChange?.(id);
+  };
+  const groups: Array<{ label: string | undefined; items: FrameSection[] }> = [];
+  for (const section of sections) {
+    let group = groups.find((g) => g.label === section.group);
+    if (!group) groups.push((group = { label: section.group, items: [] }));
+    group.items.push(section);
+  }
+  const navLabel = props.navLabel ?? (typeof props.title === "string" ? props.title : "Settings");
+  const close = props.onClose;
+  return (
+    <div className={c.root} data-settings-frame="">
+      <nav className={c.nav} aria-label={navLabel}>
+        {props.title ? <h2 className={c.navTitle}>{props.title}</h2> : null}
+        {groups.map((group, i) => (
+          <div key={group.label ?? `_${i}`} className={c.navGroup}>
+            {group.label ? <div className={c.navGroupLabel}>{slots.navGroupLabel ? slots.navGroupLabel(group.label) : group.label}</div> : null}
+            {group.items.map((section) => {
+              const isActive = section.id === active?.id;
+              return (
+                <button
+                  key={section.id}
+                  type="button"
+                  className={cx(c.navItem, isActive ? c.navItemActive : c.navItemInactive)}
+                  data-settings-section={section.id}
+                  data-active={isActive ? "true" : undefined}
+                  aria-current={isActive ? "page" : undefined}
+                  onClick={() => select(section.id)}
+                >
+                  {slots.navItem ? slots.navItem(section, { active: isActive }) : (
+                    <>
+                      {section.icon}
+                      {section.label}
+                    </>
+                  )}
+                </button>
+              );
+            })}
+          </div>
+        ))}
+        {props.navFooter ? <div className={c.navFooter}>{props.navFooter}</div> : null}
+      </nav>
+      <div className={c.body} data-settings-body="">
+        {close ? (
+          slots.close ? slots.close(close) : (
+            <button type="button" className={c.close} onClick={close} aria-label={props.closeLabel ?? "Close settings"} title={props.closeLabel ?? "Close settings"}>
+              {props.closeContent ?? "✕"}
+            </button>
+          )
+        ) : null}
+        {active ? (
+          <Fragment key={active.id}>
+            {active.hideHeader ? null : slots.header ? slots.header(active) : (
+              <div className={c.header}>
+                <h2 className={c.heading}>{active.heading ?? active.label}</h2>
+                {active.subtitle ? <p className={c.subtitle}>{active.subtitle}</p> : null}
+              </div>
+            )}
+            {slots.content ? slots.content(active) : active.render()}
+          </Fragment>
+        ) : null}
+      </div>
+    </div>
+  );
+}
+
+/* ---- Updates --------------------------------------------------------------------------------- */
+
+/** Structural update status (a subset of `@rightkit/app-update` `AutoUpdateStatus`; that type is assignable). */
+export interface UpdateStatusLike {
+  kind: string;
+  version?: string;
+  tier?: string | null;
+  /** False on an `available` status the licence does not cover; Install is then hidden. Default true. */
+  eligible?: boolean;
+  pct?: number;
+  reason?: string;
+  message?: string;
+}
+
+export interface UpdatesViewLabels {
+  version: (currentVersion: string) => string;
+  checkNow: string;
+  checking: string;
+  installUpdate: string;
+  installing: string;
+  restartNow: string;
+  /** Replace the status sentence; receives the default. */
+  status: (status: UpdateStatusLike, fallback: string) => string;
+  /** The "last checked" line; receives epoch ms. Default the locale date and time. */
+  lastChecked: (at: number) => string;
+}
+
+export type UpdatesViewClassNames = Partial<Record<"root" | "version" | "status" | "lastChecked" | "actions" | "check" | "install" | "restart" | "hint", string>>;
+
+export interface UpdatesViewSlots {
+  /** Replace the status sentence element. Receives the status and its text. */
+  status?: (status: UpdateStatusLike, text: string) => ReactNode;
+  /** Replace the button row. */
+  actions?: (state: { status: UpdateStatusLike; busy: boolean; check: () => void; install?: () => void; restart?: () => void }) => ReactNode;
+}
+
+export interface UpdatesViewProps {
+  status: UpdateStatusLike;
+  currentVersion?: string;
+  /** True while a check or install runs; disables the buttons. Default: `status.kind` is `checking` or `downloading`. */
+  busy?: boolean;
+  /** Which action is running, to show "Checking…" / "Installing…" on its button. */
+  pending?: "check" | "install" | null;
+  /** Epoch ms or Date of the last good check; omitted line when null or unset. */
+  lastCheckedAt?: number | Date | null;
+  onCheck: () => void;
+  onInstall?: () => void;
+  onRestart?: () => void;
+  /** Shown beside the status when an available update is not covered by the licence. */
+  upgradeHint?: ReactNode;
+  labels?: Partial<UpdatesViewLabels>;
+  classNames?: UpdatesViewClassNames;
+  slots?: UpdatesViewSlots;
+  children?: ReactNode;
+}
+
+const defaultUpdatesViewLabels: UpdatesViewLabels = {
+  version: (v) => `Version ${v}`,
+  checkNow: "Check for updates",
+  checking: "Checking…",
+  installUpdate: "Install update",
+  installing: "Installing…",
+  restartNow: "Restart now",
+  status: (_s, fallback) => fallback,
+  lastChecked: (at) => `Last checked ${new Date(at).toLocaleString()}`,
+};
+
+/** Default status sentence for a status. Exported so an app can reuse or wrap it. */
+export function updateStatusText(s: UpdateStatusLike): string {
+  switch (s.kind) {
+    case "idle": return "Not checked yet.";
+    case "checking": return "Checking for updates…";
+    case "up_to_date": return "You are up to date.";
+    case "available": return `Version ${s.version ?? ""} is available${s.tier ? ` (${s.tier})` : ""}.`;
+    case "deferred": return `Version ${s.version ?? ""} will install later${s.reason ? `: ${s.reason.replace(/_/g, " ")}` : ""}.`;
+    case "downloading": return `Downloading ${s.version ?? ""}… ${Math.round(s.pct ?? 0)}%`;
+    case "ready": return `Version ${s.version ?? ""} is ready to install.`;
+    case "error": return s.message ?? "The update check failed.";
+    default: return s.message ?? s.kind.replace(/_/g, " ");
+  }
+}
+
+/**
+ * Updates block with no styling: version line, status sentence (`role="status"`), optional last-checked line, and the
+ * Install / Restart / Check buttons. Root hook `data-update-status="<kind>"`.
+ */
+export function UpdatesView(props: UpdatesViewProps) {
+  const L = { ...defaultUpdatesViewLabels, ...props.labels };
+  const c = props.classNames ?? {};
+  const slots = props.slots ?? {};
+  const { status } = props;
+  const busy = props.busy ?? (status.kind === "checking" || status.kind === "downloading");
+  const text = L.status(status, updateStatusText(status));
+  const at = props.lastCheckedAt === null || props.lastCheckedAt === undefined ? null : typeof props.lastCheckedAt === "number" ? props.lastCheckedAt : props.lastCheckedAt.getTime();
+  const covered = status.eligible !== false;
+  const install = status.kind === "available" && covered ? props.onInstall : undefined;
+  const restart = status.kind === "ready" ? props.onRestart : undefined;
+  return (
+    <div className={c.root} data-update-status={status.kind}>
+      {props.currentVersion ? <p className={c.version}>{L.version(props.currentVersion)}</p> : null}
+      {slots.status ? slots.status(status, text) : <p className={c.status} role="status">{text}</p>}
+      {at !== null ? <p className={c.lastChecked}>{L.lastChecked(at)}</p> : null}
+      {status.kind === "available" && !covered && props.upgradeHint ? <p className={c.hint}>{props.upgradeHint}</p> : null}
+      {slots.actions ? slots.actions({ status, busy, check: props.onCheck, install, restart }) : (
+        <div className={c.actions}>
+          {install ? <button type="button" className={c.install} disabled={busy} onClick={install}>{props.pending === "install" ? L.installing : L.installUpdate}</button> : null}
+          {restart ? <button type="button" className={c.restart} onClick={restart}>{L.restartNow}</button> : null}
+          <button type="button" className={c.check} disabled={busy} onClick={props.onCheck}>{props.pending === "check" ? L.checking : L.checkNow}</button>
+        </div>
+      )}
+      {props.children}
+    </div>
+  );
+}
+
+/* ---- Legal links ----------------------------------------------------------------------------- */
+
+export interface LegalLinksViewProps {
+  documents: ReadonlyArray<{ title: string; url: string }>;
+  /** Line above the links (for example "Right Suite Desktop License v1.0"). */
+  heading?: ReactNode;
+  /** Accessible name of the link list. Default "Legal documents". */
+  navLabel?: string;
+  /** Render one link. Default a plain `<a href>` with the class from `classNames.link`. */
+  renderLink?: (doc: { title: string; url: string }, index: number) => ReactNode;
+  classNames?: Partial<Record<"root" | "heading" | "nav" | "link", string>>;
+}
+
+/** Permanent legal links (what `manifestGateLinks` from `@rightkit/legal-ui` returns fits). Root hook `data-legal-links`. */
+export function LegalLinksView(props: LegalLinksViewProps) {
+  const c = props.classNames ?? {};
+  return (
+    <div className={c.root} data-legal-links="">
+      {props.heading ? <p className={c.heading}>{props.heading}</p> : null}
+      <nav className={c.nav} aria-label={props.navLabel ?? "Legal documents"}>
+        {props.documents.map((doc, i) => (
+          <Fragment key={`${doc.url}|${i}`}>{props.renderLink ? props.renderLink(doc, i) : <a className={c.link} href={doc.url}>{doc.title}</a>}</Fragment>
+        ))}
+      </nav>
+    </div>
+  );
+}
+
+/* ---- About ----------------------------------------------------------------------------------- */
+
+export interface AboutViewProps {
+  appName: ReactNode;
+  tagline?: ReactNode;
+  /** Small chip beside the name (for example "Local-first"). */
+  badge?: ReactNode;
+  version?: string;
+  build?: string;
+  /** Contact links under the card (site, mail). Plain anchors. */
+  links?: ReadonlyArray<{ label: string; url: string }>;
+  /** Rendered between the card and the footer (an `UpdatesView`, a licence block). */
+  children?: ReactNode;
+  /** Rendered last (a `LegalLinksView`). */
+  footer?: ReactNode;
+  classNames?: Partial<Record<"root" | "card" | "top" | "name" | "badge" | "tagline" | "info" | "links" | "link", string>>;
+  slots?: {
+    /** Replace the card (name, badge, tagline, info, links). */
+    card?: (props: AboutViewProps) => ReactNode;
+  };
+}
+
+/** About block with no styling. Root hooks `data-about-section`; the contact row `data-about-contact`. */
+export function AboutView(props: AboutViewProps) {
+  const c = props.classNames ?? {};
+  const info = [props.version ? `Version ${props.version}` : null, props.build ? `build ${props.build}` : null].filter(Boolean).join(" · ");
+  return (
+    <div className={c.root} data-about-section="">
+      {props.slots?.card ? props.slots.card(props) : (
+        <div className={c.card}>
+          <div className={c.top}>
+            <div className={c.name}>{props.appName}</div>
+            {props.badge ? <span className={c.badge}>{props.badge}</span> : null}
+          </div>
+          {props.tagline ? <p className={c.tagline}>{props.tagline}</p> : null}
+          {info ? <p className={c.info}>{info}</p> : null}
+          {props.links?.length ? (
+            <div className={c.links} data-about-contact="">
+              {props.links.map((l) => <a key={l.url} className={c.link} href={l.url}>{l.label}</a>)}
+            </div>
+          ) : null}
+        </div>
+      )}
+      {props.children}
+      {props.footer}
+    </div>
+  );
+}
+
+/* ---- Diagnostics ----------------------------------------------------------------------------- */
+
+export interface DiagnosticEntryLike {
+  /** Time text already formatted by the app (for example `"12:03:41"`). */
+  time?: string;
+  kind: string;
+  message: string;
+  detail?: string;
+}
+
+export interface DiagnosticsViewLabels {
+  description: ReactNode;
+  disabled: ReactNode;
+  empty: ReactNode;
+  email: string;
+  copy: string;
+  copied: string;
+  copyFailed: string;
+  refresh: string;
+  clear: string;
+}
+
+export interface DiagnosticsViewProps {
+  entries: readonly DiagnosticEntryLike[];
+  /** False shows `labels.disabled` and no controls (logging is switched off). Default true. */
+  enabled?: boolean;
+  /** Result of the last copy, for the Copy button text. */
+  copyState?: "" | "copied" | "failed";
+  onCopy: () => void;
+  /** Hides "Email" when unset. */
+  onEmail?: () => void;
+  /** Hides "Refresh" when unset. */
+  onRefresh?: () => void;
+  onClear: () => void;
+  /** Newest first (default true, as the log reads in ViewRight). */
+  newestFirst?: boolean;
+  labels?: Partial<DiagnosticsViewLabels>;
+  classNames?: Partial<Record<"root" | "description" | "actions" | "email" | "copy" | "refresh" | "clear" | "log" | "entry" | "time" | "kind" | "empty", string>>;
+  slots?: {
+    /** Replace one log line. */
+    entry?: (entry: DiagnosticEntryLike, index: number) => ReactNode;
+    /** Replace the button row. */
+    actions?: (handlers: { copy: () => void; email?: () => void; refresh?: () => void; clear: () => void; copyState: "" | "copied" | "failed" }) => ReactNode;
+  };
+}
+
+const defaultDiagnosticsLabels: DiagnosticsViewLabels = {
+  description: "A local log of loads, timings and errors. It stays on this device and is never sent on its own.",
+  disabled: "Diagnostics logging is off.",
+  empty: "No diagnostics recorded yet.",
+  email: "Email to support",
+  copy: "Copy log",
+  copied: "Copied",
+  copyFailed: "Copy failed",
+  refresh: "Refresh",
+  clear: "Clear log",
+};
+
+/** Diagnostics block with no styling. Root hook `data-diagnostics`; the log has `aria-label` "Diagnostics log". */
+export function DiagnosticsView(props: DiagnosticsViewProps) {
+  const L = { ...defaultDiagnosticsLabels, ...props.labels };
+  const c = props.classNames ?? {};
+  if (props.enabled === false) {
+    return <div className={c.root} data-diagnostics=""><p className={c.description}>{L.disabled}</p></div>;
+  }
+  const copyState = props.copyState ?? "";
+  const lines = props.newestFirst === false ? [...props.entries] : [...props.entries].reverse();
+  return (
+    <div className={c.root} data-diagnostics="">
+      <p className={c.description}>{L.description}</p>
+      {props.slots?.actions ? props.slots.actions({ copy: props.onCopy, email: props.onEmail, refresh: props.onRefresh, clear: props.onClear, copyState }) : (
+        <div className={c.actions}>
+          {props.onEmail ? <button type="button" className={c.email} onClick={props.onEmail}>{L.email}</button> : null}
+          <button type="button" className={c.copy} onClick={props.onCopy}>{copyState === "copied" ? L.copied : copyState === "failed" ? L.copyFailed : L.copy}</button>
+          {props.onRefresh ? <button type="button" className={c.refresh} onClick={props.onRefresh}>{L.refresh}</button> : null}
+          <button type="button" className={c.clear} onClick={props.onClear}>{L.clear}</button>
+        </div>
+      )}
+      <div className={c.log} role="log" aria-label="Diagnostics log" tabIndex={0}>
+        {lines.length === 0 ? <p className={c.empty}>{L.empty}</p> : lines.map((e, i) => (
+          <Fragment key={`${e.time ?? ""}|${i}`}>
+            {props.slots?.entry ? props.slots.entry(e, i) : (
+              <p className={c.entry}>
+                {e.time ? <><span className={c.time}>{e.time}</span>{" "}</> : null}
+                <span className={c.kind}>{e.kind}</span> {e.message}{e.detail ? ` — ${e.detail}` : ""}
+              </p>
+            )}
+          </Fragment>
+        ))}
+      </div>
+    </div>
+  );
+}

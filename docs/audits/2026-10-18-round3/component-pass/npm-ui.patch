+  { id: "diagnostics", label: "Diagnostics", group: "Support", subtitle: "Logs", render: () => <p>diag body</p> },
+  { id: "about", label: "About", group: "Support", hideHeader: true, render: () => <p>about body</p> },
+  { id: "theme", label: "Theme", group: "Preferences", icon: <i data-testid="icon" />, render: () => <p>theme body</p> },
+];

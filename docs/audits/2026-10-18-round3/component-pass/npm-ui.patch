+import { describe, expect, it } from "vitest";
+import { chordFromEvent, installHoverGuard, isModifierKey, type HoverGuardTarget } from "./interaction.js";
+import { clearPersisted, readPersisted, writePersisted, type PersistedStorage } from "./persisted.js";
+
+describe("chordFromEvent", () => {
+  it("orders modifiers and lower-cases the key", () => {
+    expect(chordFromEvent({ key: "P", ctrlKey: true, shiftKey: true })).toBe("ctrl+shift+p");
+    expect(chordFromEvent({ key: "k", altKey: true, metaKey: true })).toBe("alt+win+k");
+    expect(chordFromEvent({ key: "F5" })).toBe("f5");
+    expect(chordFromEvent({ key: "ArrowUp", shiftKey: true })).toBe("shift+arrowup");
+  });
+
+  it("names the special keys the way formatChord reads them", () => {
+    expect(chordFromEvent({ key: " " })).toBe("space");
+    expect(chordFromEvent({ key: "Enter", ctrlKey: true })).toBe("ctrl+enter");
+    expect(chordFromEvent({ key: "Escape" })).toBe("esc");
+  });
+
+  it("waits on a modifier-only press", () => {
+    for (const key of ["Control", "Shift", "Alt", "Meta", "AltGraph"]) {
+      expect(isModifierKey(key)).toBe(true);
+      expect(chordFromEvent({ key, ctrlKey: true })).toBeNull();
+    }
+    expect(isModifierKey("a")).toBe(false);
+    expect(chordFromEvent({ key: "" })).toBeNull();
+  });
+
+  it("writes the platform shortcut key as mod in mod mode", () => {
+    expect(chordFromEvent({ key: "p", metaKey: true }, { modifiers: "mod", platform: "macos" })).toBe("mod+p");
+    expect(chordFromEvent({ key: "p", ctrlKey: true }, { modifiers: "mod", platform: "macos" })).toBe("ctrl+p");
+    expect(chordFromEvent({ key: "p", ctrlKey: true }, { modifiers: "mod", platform: "windows" })).toBe("mod+p");
+    expect(chordFromEvent({ key: "p", metaKey: true }, { modifiers: "mod", platform: "windows" })).toBe("win+p");
+    expect(chordFromEvent({ key: "p", ctrlKey: true }, { modifiers: "mod" })).toBe("ctrl+p");
+  });
+});
+
+describe("installHoverGuard", () => {
+  function fakeDoc() {
+    const root = new Map<string, string>();
+    const listeners = new Map<string, Array<() => void>>();
+    const windowListeners = new Map<string, Array<() => void>>();
+    const add = (map: Map<string, Array<() => void>>) => (type: string, handler: () => void) => map.set(type, [...(map.get(type) ?? []), handler]);
+    const remove = (map: Map<string, Array<() => void>>) => (type: string, handler: () => void) => map.set(type, (map.get(type) ?? []).filter((h) => h !== handler));
+    const doc: HoverGuardTarget = {
+      documentElement: { setAttribute: (n, v) => void root.set(n, v), removeAttribute: (n) => void root.delete(n) },
+      addEventListener: add(listeners),
+      removeEventListener: remove(listeners),
+      defaultView: { addEventListener: add(windowListeners), removeEventListener: remove(windowListeners) },
+    };
+    const fire = (map: Map<string, Array<() => void>>, type: string) => (map.get(type) ?? []).forEach((h) => h());
+    return { doc, root, fireDoc: (type: string) => fire(listeners, type), fireWindow: (type: string) => fire(windowListeners, type), listeners, windowListeners };
+  }
+
+  it("arms on blur or pointer leave and clears on the next move", () => {
+    const { doc, root, fireDoc, fireWindow } = fakeDoc();
+    installHoverGuard(doc);
+    fireWindow("blur");
+    expect(root.get("data-hover-guard")).toBe("true");
+    fireDoc("pointermove");
+    expect(root.has("data-hover-guard")).toBe(false);
+    fireDoc("mouseleave");
+    expect(root.get("data-hover-guard")).toBe("true");
+    fireDoc("mousemove");
+    expect(root.has("data-hover-guard")).toBe(false);
+  });
+
+  it("uninstalls cleanly, honours the attribute option, and is a no-op without a document", () => {
+    const { doc, root, fireWindow, listeners, windowListeners } = fakeDoc();
+    const uninstall = installHoverGuard(doc, { attribute: "data-nohover" });
+    fireWindow("blur");
+    expect(root.get("data-nohover")).toBe("true");
+    uninstall();
+    expect(root.size).toBe(0);
+    expect([...listeners.values()].flat()).toHaveLength(0);
+    expect([...windowListeners.values()].flat()).toHaveLength(0);
+    expect(() => installHoverGuard(undefined)()).not.toThrow();
+  });
+});
+
+function memory(seed: Record<string, string> = {}): PersistedStorage & { data: Map<string, string> } {
+  const data = new Map(Object.entries(seed));
+  return { data, getItem: (k) => data.get(k) ?? null, setItem: (k, v) => void data.set(k, v), removeItem: (k) => void data.delete(k) };
+}
+
+describe("persisted values", () => {
+  it("round-trips JSON and falls back on missing, corrupt or invalid data", () => {
+    const storage = memory({ bad: "{oops", n: "5" });
+    expect(readPersisted("missing", 1, { storage })).toBe(1);
+    expect(readPersisted("bad", "dflt", { storage })).toBe("dflt");
+    expect(writePersisted("k", { a: 1 }, { storage })).toBe(true);
+    expect(readPersisted("k", null, { storage })).toEqual({ a: 1 });
+    const isSmall = (v: unknown): v is number => typeof v === "number" && v < 3;
+    expect(readPersisted("n", 0, { storage, validate: isSmall })).toBe(0);
+    clearPersisted("k", { storage });
+    expect(storage.data.has("k")).toBe(false);
+  });
+
+  it("never throws when the storage does", () => {
+    const hostile: PersistedStorage = {
+      getItem: () => { throw new Error("denied"); },
+      setItem: () => { throw new Error("quota"); },
+      removeItem: () => { throw new Error("denied"); },
+    };
+    expect(readPersisted("k", 7, { storage: hostile })).toBe(7);
+    expect(writePersisted("k", 1, { storage: hostile })).toBe(false);
+    expect(() => clearPersisted("k", { storage: hostile })).not.toThrow();
+  });
+
+  it("supports custom serialising", () => {
+    const storage = memory();
+    writePersisted("d", new Date(0), { storage, serialize: (d) => String(d.getTime()) });
+    expect(readPersisted("d", new Date(1), { storage, deserialize: (t) => new Date(Number(t)) }).getTime()).toBe(0);
+  });
+});

 export interface DefaultPolicyDocumentLike {
   readonly title: string;
   readonly content: string;
+  /** Manifest role (for example `"privacy_notice"`), when the renderer knows it. Matches a `ManifestDocumentLike.role` link. */
+  readonly role?: string;

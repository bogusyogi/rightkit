index 0000000..dbf96bd
--- /dev/null
+++ b/packages/platform-ui/src/persisted.ts
@@ -0,0 +1,117 @@
+/* Persisted state: a storage-backed value that never throws. No native imports. `usePersistedState` is the React binding. */
+import { useCallback, useEffect, useRef, useState } from "react";
+
+/** The slice of `Storage` this uses. `localStorage` and `sessionStorage` satisfy it. */
+export interface PersistedStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+  removeItem(key: string): void;
+}
+
+export interface PersistedOptions<T> {
+  /** Default: `globalThis.localStorage` when it exists and is usable, else an in-memory store (SSR, private modes, tests). */
+  storage?: PersistedStorage;
+  /** Default `JSON.stringify`. */
+  serialize?: (value: T) => string;
+  /** Default `JSON.parse`. A throw counts as "nothing stored". */
+  deserialize?: (text: string) => T;
+  /** A stored value is used only when this returns true (a shape or range check). Default: accept. */
+  validate?: (value: unknown) => value is T;
+}
+
+function defaultStorage(): PersistedStorage | undefined {
+  try {
+    const store = (globalThis as { localStorage?: PersistedStorage }).localStorage;
+    if (!store) return undefined;
+    const probe = "__rk_persisted_probe__";
+    store.setItem(probe, "1");
+    store.removeItem(probe);
+    return store;
+  } catch {
+    return undefined;
+  }
+}
+
+const memory = new Map<string, string>();
+const memoryStorage: PersistedStorage = {
+  getItem: (key) => memory.get(key) ?? null,
+  setItem: (key, value) => void memory.set(key, value),
+  removeItem: (key) => void memory.delete(key),
+};
+
+/**
+ * Read a stored value: `fallback` when nothing is stored, the text does not parse, `validate` refuses it, or the storage throws.
+ */
+export function readPersisted<T>(key: string, fallback: T, options: PersistedOptions<T> = {}): T {
+  const storage = options.storage ?? defaultStorage() ?? memoryStorage;
+  try {
+    const text = storage.getItem(key);
+    if (text === null) return fallback;
+    const value: unknown = options.deserialize ? options.deserialize(text) : JSON.parse(text);
+    if (options.validate && !options.validate(value)) return fallback;
+    return value as T;
+  } catch {
+    return fallback;
+  }
+}
+
+/** Write a value. Returns false when the storage refused (quota, private mode); never throws. */
+export function writePersisted<T>(key: string, value: T, options: PersistedOptions<T> = {}): boolean {
+  const storage = options.storage ?? defaultStorage() ?? memoryStorage;
+  try {
+    storage.setItem(key, options.serialize ? options.serialize(value) : JSON.stringify(value));
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Remove a stored value. Never throws. */
+export function clearPersisted(key: string, options: Pick<PersistedOptions<unknown>, "storage"> = {}): void {
+  try {
+    (options.storage ?? defaultStorage() ?? memoryStorage).removeItem(key);
+  } catch {
+    /* nothing to clear */
+  }
+}
+
+/**
+ * `useState` backed by storage (0.3.1). The first render reads the stored value (or `initial`); every `set` writes through. A storage that
+ * throws is ignored, so the state still works for the session. `set` takes a value or an updater. Other tabs' writes (the `storage`
+ * event) update the state when the default `localStorage` is in use.
+ */
+export function usePersistedState<T>(key: string, initial: T, options: PersistedOptions<T> = {}): [T, (next: T | ((previous: T) => T)) => void, () => void] {
+  const optionsRef = useRef(options);
+  optionsRef.current = options;
+  const initialRef = useRef(initial);
+  const [value, setValue] = useState<T>(() => readPersisted(key, initial, options));
+  const latest = useRef(value);
+  latest.current = value;
+  const firstKey = useRef(key);
+  useEffect(() => {
+    // The first render already read this key; re-read only when the key changes.
+    if (firstKey.current === key) return;
+    firstKey.current = key;
+    setValue(readPersisted(key, initialRef.current, optionsRef.current));
+  }, [key]);
+  useEffect(() => {
+    if (typeof window === "undefined" || optionsRef.current.storage) return;
+    const onStorage = (event: StorageEvent) => {
+      if (event.key === key || event.key === null) setValue(readPersisted(key, initialRef.current, optionsRef.current));
+    };
+    window.addEventListener("storage", onStorage);
+    return () => window.removeEventListener("storage", onStorage);
+  }, [key]);
+  const set = useCallback((next: T | ((previous: T) => T)) => {
+    const resolved = typeof next === "function" ? (next as (previous: T) => T)(latest.current) : next;
+    latest.current = resolved;
+    setValue(resolved);
+    writePersisted(key, resolved, optionsRef.current);
+  }, [key]);
+  const reset = useCallback(() => {
+    clearPersisted(key, optionsRef.current);
+    latest.current = initialRef.current;
+    setValue(initialRef.current);
+  }, [key]);
+  return [value, set, reset];
+}

+//! QA-only observations of PCM delivered by output callback.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Arc;
+
+use super::session::Callback;
+use super::state::Shared;
+use super::{OutputControl, OutputFormat};
+use crate::AudioError;
+
+/// Cumulative callback PCM counters since session creation. Peaks include gain ramps.
+/// `samples` counts interleaved device samples, including silence while paused or starved.
+/// Present only with feature `test-mode`; field names match CutRight's status probe.
+#[derive(Debug, Clone, Copy, Default, PartialEq)]
+pub struct TestAudioOutput {
+    pub samples: u64,
+    pub pre_gain_peak_abs: f64,
+    pub peak_abs: f64,
+}
+
+#[derive(Default)]
+pub(crate) struct Probe {
+    samples: AtomicU64,
+    pre: AtomicU64,
+    post: AtomicU64,
+}
+
+impl Probe {
+    // Only callback writes peaks: bounded loads/stores suffice, no CAS retry loop.
+    fn peak(peak: &AtomicU64, block: &[f32]) {
+        let old = f64::from_bits(peak.load(Ordering::Relaxed));
+        let value = block.iter().fold(old, |v, s| v.max(f64::from(*s).abs()));
+        peak.store(value.to_bits(), Ordering::Relaxed);
+    }
+
+    pub(super) fn record_pre(&self, block: &[f32]) {
+        Self::peak(&self.pre, block);
+    }
+
+    pub(super) fn record_post(&self, block: &[f32]) {
+        Self::peak(&self.post, block);
+    }
+
+    pub(super) fn complete(&self, samples: usize) {
+        self.samples.fetch_add(samples as u64, Ordering::Release);
+    }
+
+    fn snapshot(&self) -> TestAudioOutput {
+        TestAudioOutput {
+            samples: self.samples.load(Ordering::Acquire),
+            pre_gain_peak_abs: f64::from_bits(self.pre.load(Ordering::Relaxed)),
+            peak_abs: f64::from_bits(self.post.load(Ordering::Relaxed)),
+        }
+    }
+}
+
+impl OutputControl {
+    /// Observe actual callback PCM before gain & after gain/clipping. Snapshot may include
+    /// newer peaks than `samples` when read concurrently. No probe code exists without
+    /// feature `test-mode`.
+    pub fn test_audio_output(&self) -> TestAudioOutput {
+        self.shared.probe.snapshot()
+    }
+}
+
+/// Device-less QA sink using exactly production callback renderer & controls.
+/// Owns sole consumer; `push_samples` owns sole producer. Never opens cpal host/device.
+/// Available only with feature `test-mode`.
+pub struct FakeOutputSink {
+    control: OutputControl,
+    callback: Callback,
+}
+
+impl FakeOutputSink {
+    pub fn new(
+        sample_rate: u32,
+        channels: u16,
+        capacity_frames: usize,
+    ) -> Result<Self, AudioError> {
+        Self::with_gain(
+            sample_rate,
+            channels,
+            capacity_frames,
+            super::OutputGain::default(),
+        )
+    }
+
+    /// Initialize gain before creating callback, matching `OutputSession::start`.
+    pub fn with_gain(
+        sample_rate: u32,
+        channels: u16,
+        capacity_frames: usize,
+        gain: super::OutputGain,
+    ) -> Result<Self, AudioError> {
+        if sample_rate == 0
+            || channels == 0
+            || capacity_frames == 0
+            || capacity_frames.checked_mul(channels as usize).is_none()
+        {
+            return Err(AudioError::Invalid(
+                "fake sink requires nonzero, bounded format".into(),
+            ));
+        }
+        let shared = Arc::new(Shared::with_gain(
+            sample_rate,
+            channels,
+            capacity_frames,
+            gain,
+        ));
+        Ok(Self {
+            callback: Callback::new(Arc::clone(&shared)),
+            control: OutputControl { shared },
+        })
+    }
+
+    pub fn control(&self) -> OutputControl {
+        self.control.clone()
+    }
+
+    pub fn format(&self) -> OutputFormat {
+        self.control.format()
+    }
+
+    pub fn push_samples(&mut self, samples: &[f32]) -> usize {
+        self.control.shared.push(samples)
+    }
+
+    /// Fill caller-owned device buffer, allocating nothing. Partial trailing frames silence.
+    pub fn render(&mut self, samples: &mut [f32]) {
+        self.callback.render_buffer(samples);
+    }
+}

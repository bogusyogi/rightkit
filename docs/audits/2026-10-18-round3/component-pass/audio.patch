@@ -0,0 +1,60 @@
+//! Shared preview gain, independent of stream lifetime.
+
+use crate::AudioError;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::sync::Arc;
+
+/// Cloneable gain control shared across session reopens. Callback reads one atomic per
+/// buffer. Keep app preference here; exports never need this handle.
+#[derive(Debug, Clone)]
+pub struct OutputGain {
+    pub(super) bits: Arc<AtomicU32>,
+}
+
+impl Default for OutputGain {
+    fn default() -> Self {
+        Self {
+            bits: Arc::new(AtomicU32::new(1.0_f32.to_bits())),
+        }
+    }
+}
+
+impl OutputGain {
+    /// Linear gain in 0..=4 (unity = 1). NaN, infinity & out-of-range values are rejected.
+    pub fn new(value: f32) -> Result<Self, AudioError> {
+        let gain = Self::default();
+        gain.set(value)?;
+        Ok(gain)
+    }
+
+    pub fn set(&self, value: f32) -> Result<(), AudioError> {
+        if !value.is_finite() || !(0.0..=4.0).contains(&value) {
+            return Err(AudioError::Invalid(format!(
+                "gain must be within 0..=4, got {value}"
+            )));
+        }
+        self.bits.store(value.to_bits(), Ordering::Relaxed);
+        Ok(())
+    }
+
+    pub fn get(&self) -> f32 {
+        f32::from_bits(self.bits.load(Ordering::Relaxed))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn clones_share_gain_and_invalid_changes_preserve_it() {
+        let gain = OutputGain::new(0.25).unwrap();
+        let other = gain.clone();
+        other.set(0.5).unwrap();
+        assert_eq!(gain.get(), 0.5);
+        for invalid in [f32::NAN, f32::INFINITY, -0.1, 4.1] {
+            assert!(gain.set(invalid).is_err());
+        }
+        assert_eq!(other.get(), 0.5);
+    }
+}

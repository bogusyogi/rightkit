+use super::ring::SampleRing;
+use std::sync::Arc;
+
+#[test]
+fn concurrent_producer_consumer_preserves_stereo_across_wraps() {
+    let ring = Arc::new(SampleRing::new(14));
+    let producer = Arc::clone(&ring);
+    let writer = std::thread::spawn(move || {
+        for i in 0..20_000 {
+            let frame = [i as f32, -(i as f32)];
+            while producer.push(&frame, 2) == 0 {
+                std::thread::yield_now();
+            }
+        }
+    });
+    let mut out = [0.0; 6];
+    let mut expected = 0;
+    while expected < 20_000 {
+        let n = ring.pop_into(&mut out);
+        assert_eq!(n % 2, 0);
+        for frame in out[..n].chunks_exact(2) {
+            assert_eq!(frame, [expected as f32, -(expected as f32)]);
+            expected += 1;
+        }
+        if n == 0 {
+            std::thread::yield_now();
+        }
+    }
+    writer.join().unwrap();
+    assert_eq!(ring.len(), 0);
+}
+
+#[test]
+fn flush_boundary_retains_new_samples_when_storage_wraps() {
+    let ring = SampleRing::new(8);
+    assert_eq!(ring.push(&[1.0; 6], 2), 6);
+    assert_eq!(ring.pop_into(&mut [0.0; 4]), 4);
+    let boundary = ring.tail();
+    assert_eq!(ring.push(&[2.0; 6], 2), 6);
+    ring.discard_to(boundary);
+    let mut out = [0.0; 8];
+    assert_eq!(ring.pop_into(&mut out), 6);
+    assert_eq!(&out[..6], &[2.0; 6]);
+}

@@ -0,0 +1,175 @@
+//! PCM alignment using the highest-energy camera reference at 16 kHz.
+//!
+//! Ports CutRight's `audio_sync::align_pcm` search policy on top of [`crate::align_mic`].
+//! Decode both signals to finite mono samples at [`SAMPLE_RATE`] before calling; this module
+//! never decodes or spawns processes. Timeline conversion belongs to callers.
+
+use crate::{align_mic, AlignParams, AudioError};
+
+/// Required rate for [`align_pcm`], in Hz.
+pub const SAMPLE_RATE: u32 = 16_000;
+const MAX_DECODE_SECONDS: u32 = 180;
+const MIN_OVERLAP_SECONDS: u32 = 1;
+const COARSE_STEP: usize = 160; // 10 ms at the fixed decoder rate.
+const SEARCH_WINDOW_SECONDS: usize = 2;
+const MIN_CONFIDENCE: f64 = 0.30;
+
+/// Alignment relative to camera source start.
+#[derive(Debug, Clone, PartialEq)]
+pub struct PcmAlignment {
+    /// Microphone source sample minus camera source sample for matching content.
+    pub lag_samples: i64,
+    /// Analysis rate, always [`SAMPLE_RATE`].
+    pub sample_rate: u32,
+    /// Full-rate normalized correlation, accepted at 0.30 or above.
+    pub confidence: f64,
+    /// Selected reference window length, rounded down to 160-sample blocks. This matches
+    /// CutRight's reported window size, rather than actual overlap.
+    pub overlap_samples: usize,
+}
+
+/// Align finite mono 16 kHz signals using the highest-energy camera window.
+///
+/// Requires at least one second per signal. Selects at most two seconds in 10 ms blocks
+/// (earliest window wins energy ties), widens the reference-relative search by its start, then
+/// subtracts that start from [`crate::align_mic`]'s lag. The offset limit is capped at 180
+/// seconds; the confidence floor is 0.30. A lag beyond the limit after refinement, or an input
+/// under one second, returns [`AudioError::Invalid`] with a `no mic alignment` message; other
+/// unavailable-signal errors keep `align_mic`'s message. Inputs are not truncated to 180
+/// seconds.
+///
+/// Positive lag means matching microphone content occurs later. For other rates or custom
+/// search policies, use [`crate::align_mic`] directly.
+pub fn align_pcm(
+    camera: &[f32],
+    microphone: &[f32],
+    max_offset_ms: u64,
+) -> Result<PcmAlignment, AudioError> {
+    let min_len = SAMPLE_RATE as usize * MIN_OVERLAP_SECONDS as usize;
+    if camera.len() < min_len || microphone.len() < min_len {
+        return Err(AudioError::Invalid(
+            "no mic alignment: each source needs at least one second of audio".into(),
+        ));
+    }
+    let window = (SEARCH_WINDOW_SECONDS * SAMPLE_RATE as usize)
+        .min(camera.len())
+        .min(microphone.len())
+        / COARSE_STEP
+        * COARSE_STEP;
+    if window < 2 * COARSE_STEP {
+        return Err(AudioError::Invalid(
+            "no mic alignment: signals are too short for alignment window".into(),
+        ));
+    }
+    let start = highest_energy_window(camera, window);
+    let max_lag_ms = max_offset_ms.min(MAX_DECODE_SECONDS as u64 * 1000) as f64;
+    let samples_to_ms = |n: usize| n as f64 * 1000.0 / SAMPLE_RATE as f64;
+    // align_mic measures lags from the start of the reference it is given. That reference
+    // begins `start` samples into the camera, so its lag range widens by the same amount.
+    let params = AlignParams {
+        max_lag_ms: max_lag_ms + samples_to_ms(start),
+        window_ms: samples_to_ms(window),
+        min_ncc: MIN_CONFIDENCE,
+    };
+    let found = align_mic(
+        &camera[start..start + window],
+        microphone,
+        SAMPLE_RATE,
+        &params,
+    )?;
+    // The mic is at `lag_samples` relative to the reference, so relative to the camera start
+    // the true lag is `lag_samples - start`.
+    let lag = found.lag_samples - start as i64;
+    if lag.unsigned_abs() as f64 > max_lag_ms * SAMPLE_RATE as f64 / 1000.0 {
+        return Err(AudioError::Invalid(
+            "no mic alignment: no reliable cross-correlation peak within the offset limit".into(),
+        ));
+    }
+    Ok(PcmAlignment {
+        lag_samples: lag,
+        sample_rate: SAMPLE_RATE,
+        confidence: found.confidence,
+        overlap_samples: window,
+    })
+}
+
+/// Start (in samples, a multiple of `COARSE_STEP`) of the `window`-sample span with the most
+/// energy, scanned in 10 ms blocks.
+fn highest_energy_window(signal: &[f32], window: usize) -> usize {
+    let blocks = signal.len() / COARSE_STEP;
+    let width = window / COARSE_STEP;
+    let energy: Vec<f64> = signal[..blocks * COARSE_STEP]
+        .chunks_exact(COARSE_STEP)
+        .map(|block| block.iter().map(|x| (*x as f64) * (*x as f64)).sum::<f64>())
+        .collect();
+    let mut sum = energy[..width].iter().sum::<f64>();
+    let mut best = (sum, 0usize);
+    for i in width..energy.len() {
+        sum += energy[i] - energy[i - width];
+        if sum > best.0 {
+            best = (sum, i + 1 - width);
+        }
+    }
+    best.1 * COARSE_STEP
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn noise(n: usize, seed: &mut u32) -> Vec<f32> {
+        (0..n)
+            .map(|_| {
+                *seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+                ((*seed >> 8) as f32 / (1u32 << 24) as f32) * 2.0 - 1.0
+            })
+            .collect()
+    }
+
+    #[test]
+    fn energy_window_uses_earliest_tie_and_ignores_partial_block() {
+        assert_eq!(highest_energy_window(&[1.0; 640], 320), 0);
+        let mut signal = vec![0.0; 640];
+        signal[320..480].fill(2.0);
+        signal.extend_from_slice(&[1000.0; 159]);
+        assert_eq!(highest_energy_window(&signal, 320), 160);
+    }
+
+    #[test]
+    fn short_and_silent_inputs_report_no_mic_alignment() {
+        let silence = vec![0.0; SAMPLE_RATE as usize];
+        for (camera, mic) in [
+            (&silence[..15999], &silence[..]),
+            (&silence[..], &silence[..15999]),
+        ] {
+            let msg = align_pcm(camera, mic, 0).unwrap_err().to_string();
+            assert!(msg.contains("no mic alignment"), "{msg}");
+            assert!(msg.contains("at least one second"), "{msg}");
+        }
+        let msg = align_pcm(&silence, &silence, 0).unwrap_err().to_string();
+        assert!(msg.contains("silent"), "{msg}");
+    }
+
+    #[test]
+    fn recovers_a_known_lag_relative_to_camera_start() {
+        let mut seed = 7;
+        let camera = noise(48_000, &mut seed);
+        let lag = 800usize; // 50 ms
+        let mut mic = vec![0.0f32; lag];
+        mic.extend_from_slice(&camera);
+        let found = align_pcm(&camera, &mic, 2_000).unwrap();
+        assert_eq!(found.lag_samples, lag as i64);
+        assert_eq!(found.sample_rate, SAMPLE_RATE);
+        assert!(found.confidence > 0.9);
+        assert_eq!(found.overlap_samples, 32_000);
+    }
+
+    #[test]
+    fn lag_beyond_the_offset_limit_is_rejected() {
+        let mut seed = 11;
+        let camera = noise(48_000, &mut seed);
+        let mut mic = vec![0.0f32; 8_000]; // 500 ms
+        mic.extend_from_slice(&camera);
+        assert!(align_pcm(&camera, &mic, 100).is_err());
+    }
+}

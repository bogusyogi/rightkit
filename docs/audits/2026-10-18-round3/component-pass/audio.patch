+//! Thread-owned cpal output & bounded source feeder. No application ring or cpal thread needed.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc, Mutex, MutexGuard};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+use super::{OutputControl, OutputGain, OutputSession, DEFAULT_RING_DURATION};
+use crate::AudioError;
+
+const DECODE_FRAMES: usize = 96_000;
+const OUTPUT_FRAMES: usize = 2048;
+
+/// Random-access decoded PCM source. Decode runs on dedicated output-owner thread; metadata is read before spawning.
+/// No source method runs inside callback. Implementations may allocate or block during decode.
+/// One frame contains `channels()` interleaved f32 samples at `sample_rate()`.
+pub trait PlaybackSource: Send + 'static {
+    fn sample_rate(&self) -> u32;
+    fn channels(&self) -> u16;
+    fn total_frames(&self) -> i64;
+    /// Return exactly `frames * channels()` samples starting at `at` (source frames).
+    /// Output never requests frames beyond `total_frames()`. Errors stop consumption &
+    /// become available through [`OutputPlayback::take_last_error`].
+    fn decode_range(&mut self, at: i64, frames: usize) -> Result<Vec<f32>, AudioError>;
+}
+
+/// Options for [`OutputSession::start`]. Output format follows actual device defaults;
+/// feeder converts source rate & channel count to that format before pushing.
+#[derive(Debug, Clone)]
+pub struct PlaybackOptions {
+    pub device: Option<String>,
+    pub ring_duration: Duration,
+    /// Shared preview gain, 0..=4. Use `OutputGain::new(0.0)` for silent QA playback.
+    pub gain: OutputGain,
+    /// False starts paused at frame zero, ready for seeking & pre-roll.
+    pub playing: bool,
+}
+
+impl Default for PlaybackOptions {
+    fn default() -> Self {
+        Self {
+            device: None,
+            ring_duration: DEFAULT_RING_DURATION,
+            gain: OutputGain::default(),
+            playing: false,
+        }
+    }
+}
+
+struct Transport {
+    generation: u64,
+    base: f64,
+    speed: f64,
+    playing: bool,
+    error: Option<AudioError>,
+}
+
+fn lock(state: &Mutex<Transport>) -> MutexGuard<'_, Transport> {
+    state.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// Send-safe app output handle. cpal device, stream & decoder stay on owner thread;
+/// callback uses existing lock-free ring & atomic controls. Handle mutex is used only by
+/// caller & feeder, never by callback. Drop joins owner after current decode completes.
+///
+/// Source cursor stalls on underrun & while paused. Speed changes rebase cursor & flush
+/// queued audio. Gain changes reach callback without re-decoding. Seeking cancels admission
+/// of in-flight decode results via generation, then drops pre-seek queue on next callback.
+pub struct OutputPlayback {
+    control: OutputControl,
+    state: Arc<Mutex<Transport>>,
+    quit: Arc<AtomicBool>,
+    join: Option<JoinHandle<()>>,
+    source_rate: u32,
+    total: i64,
+}
+
+impl OutputSession {
+    /// Open output & run `source` on dedicated owner/feeder thread. Reports device/open
+    /// errors before returning. Use returned [`OutputPlayback`] across app threads, including
+    /// on platforms where cpal streams cannot be sent. Starts paused unless requested.
+    pub fn start<S: PlaybackSource>(
+        source: S,
+        options: PlaybackOptions,
+    ) -> Result<OutputPlayback, AudioError> {
+        let source_rate = source.sample_rate();
+        let source_channels = source.channels();
+        let total = source.total_frames();
+        if source_rate == 0 || source_channels == 0 || total < 0 {
+            return Err(AudioError::Invalid(
+                "source rate/channels must be nonzero & length nonnegative".into(),
+            ));
+        }
+        let state = Arc::new(Mutex::new(Transport {
+            generation: 0,
+            base: 0.0,
+            speed: 1.0,
+            playing: options.playing,
+            error: None,
+        }));
+        let quit = Arc::new(AtomicBool::new(false));
+        let worker_state = Arc::clone(&state);
+        let worker_quit = Arc::clone(&quit);
+        let (tx, rx) = mpsc::sync_channel(1);
+        let join = thread::Builder::new()
+            .name("rightkit-audio-output".into())
+            .spawn(move || {
+                let opened = Self::open_with_gain(
+                    options.device.as_deref(),
+                    options.ring_duration,
+                    options.gain,
+                    true,
+                );
+                let mut session = match opened {
+                    Ok(s) => s,
+                    Err(e) => {
+                        let _ = tx.send(Err(e));
+                        return;
+                    }
+                };
+                session.pause();
+                if tx.send(Ok(session.control())).is_err() {
+                    return;
+                }
+                if let Err(e) = feed(source, &mut session, &worker_state, &worker_quit) {
+                    session.pause();
+                    lock(&worker_state).error = Some(e);
+                    // Keep stream alive, silent, until owner drops handle.
+                    while !worker_quit.load(Ordering::Acquire) {
+                        thread::sleep(Duration::from_millis(10));
+                    }
+                }
+            })
+            .map_err(|e| AudioError::Playback(format!("output thread: {e}")))?;
+        match rx.recv() {
+            Ok(Ok(control)) => Ok(OutputPlayback {
+                control,
+                state,
+                quit,
+                join: Some(join),
+                source_rate,
+                total,
+            }),
+            result => {
+                quit.store(true, Ordering::Release);
+                let _ = join.join();
+                Err(match result {
+                    Ok(Err(e)) => e,
+                    _ => AudioError::Playback("output owner exited during open".into()),
+                })
+            }
+        }
+    }
+}
+
+impl OutputPlayback {
+    /// Linear preview gain, validated & applied inside callback.
+    pub fn set_gain(&self, gain: f32) -> Result<(), AudioError> {
+        self.control.set_volume(gain)
+    }
+
+    /// Device controls (gain, mute, probes, stats). Use this handle's transport methods for
+    /// pause/resume/flush, so source position stays consistent with feeder state.
+    pub fn output(&self) -> &OutputControl {
+        &self.control
+    }
+
+    fn cursor(&self, state: &Transport) -> f64 {
+        (state.base
+            + self.control.played_frames() as f64 * self.source_rate as f64
+                / self.control.sample_rate() as f64
+                * state.speed)
+            .min(self.total as f64)
+    }
+
+    /// Absolute source frame cursor at source sample rate (latency-adjusted).
+    pub fn cursor_samples(&self) -> i64 {
+        self.cursor(&lock(&self.state)).floor() as i64
+    }
+
+    pub fn set_playing(&self, playing: bool) {
+        let mut state = lock(&self.state);
+        state.playing = playing;
+        if !playing {
+            self.control.pause();
+        }
+        // Feeder resumes only after PCM is queued, avoiding an initial underrun.
+    }
+
+    /// Pause consumption, retaining queued data & cursor. Drop releases device & thread.
+    pub fn stop(&self) {
+        self.set_playing(false);
+    }
+    pub fn resume(&self) {
+        self.set_playing(true);
+    }
+
+    fn rebase(&self, state: &mut Transport, position: f64) {
+        self.control.pause();
+        self.control.flush();
+        state.base = position.clamp(0.0, self.total as f64);
+        state.generation = state.generation.wrapping_add(1);
+    }
+
+    pub fn seek_samples(&self, samples: i64) {
+        let mut state = lock(&self.state);
+        self.rebase(&mut state, samples as f64);
+    }
+
+    /// Discard queue & re-decode from current source cursor.
+    pub fn flush(&self) {
+        let mut state = lock(&self.state);
+        let position = self.cursor(&state);
+        self.rebase(&mut state, position);
+    }
+
+    /// Positive varispeed in 1/16..=16; pitch changes with speed, matching CutRight preview.
+    pub fn set_speed(&self, speed: f32) -> Result<(), AudioError> {
+        if !speed.is_finite() || !((1.0 / 16.0)..=16.0).contains(&speed) {
+            return Err(AudioError::Invalid("speed must be within 1/16..=16".into()));
+        }
+        let mut state = lock(&self.state);
+        let position = self.cursor(&state);
+        self.rebase(&mut state, position);
+        state.speed = f64::from(speed);
+        Ok(())
+    }
+
+    /// Take feeder error, if any. A failed source leaves output silent until handle drops.
+    pub fn take_last_error(&self) -> Option<AudioError> {
+        lock(&self.state).error.take()
+    }
+}
+
+impl Drop for OutputPlayback {
+    fn drop(&mut self) {
+        {
+            let mut state = lock(&self.state);
+            state.playing = false;
+            self.control.pause();
+            self.quit.store(true, Ordering::Release);
+        }
+        if let Some(join) = self.join.take() {
+            let _ = join.join();
+        }
+    }
+}
+
+struct SourceWindow {
+    samples: Vec<f32>,
+    at: i64,
+    channels: usize,
+    total: i64,
+}
+
+impl SourceWindow {
+    fn sample(&self, frame: i64, channel: usize) -> f32 {
+        if frame < self.at || frame >= self.total {
+            return 0.0;
+        }
+        self.samples
+            .get((frame - self.at) as usize * self.channels + channel.min(self.channels - 1))
+            .copied()
+            .unwrap_or(0.0)
+    }
+
+    fn ensure<S: PlaybackSource>(
+        &mut self,
+        source: &mut S,
+        first: i64,
+        last: i64,
+    ) -> Result<(), AudioError> {
+        let end = self.at + (self.samples.len() / self.channels) as i64;
+        if first >= self.at && last.min(self.total - 1) < end {
+            return Ok(());
+        }
+        let frames = ((self.total - first).max(0) as usize).min(DECODE_FRAMES);
+        let samples = source.decode_range(first, frames)?;
+        if samples.len() != frames * self.channels {
+            return Err(AudioError::Playback(
+                "source returned incomplete PCM range".into(),
+            ));
+        }
+        self.samples = samples;
+        self.at = first;
+        Ok(())
+    }
+
+    fn render(&self, out: &mut [f32], channels: usize, position: f64, step: f64) {
+        for (i, frame) in out.chunks_mut(channels).enumerate() {
+            let p = position + i as f64 * step;
+            let at = p.floor() as i64;
+            let t = (p - at as f64) as f32;
+            for (ch, sample) in frame.iter_mut().enumerate() {
+                let a = self.sample(at, ch);
+                let b = self.sample(at + 1, ch);
+                let value = a + (b - a) * t;
+                *sample = if value.is_finite() { value } else { 0.0 };
+            }
+        }
+    }
+}
+
+fn feed<S: PlaybackSource>(
+    mut source: S,
+    session: &mut OutputSession,
+    state: &Mutex<Transport>,
+    quit: &AtomicBool,
+) -> Result<(), AudioError> {
+    let format = session.format();
+    let channels = format.channels as usize;
+    let mut window = SourceWindow {
+        samples: Vec::new(),
+        at: 0,
+        channels: source.channels() as usize,
+        total: source.total_frames(),
+    };
+    let rate_ratio = source.sample_rate() as f64 / format.sample_rate as f64;
+    let mut scratch = vec![0.0; OUTPUT_FRAMES * channels];
+    let mut generation = u64::MAX;
+    let mut position = 0.0;
+    while !quit.load(Ordering::Acquire) {
+        let snapshot = lock(state);
+        if snapshot.generation != generation {
+            generation = snapshot.generation;
+            position = snapshot.base;
+            window.samples.clear();
+        }
+        let playing = snapshot.playing;
+        if playing && session.stats().queued_samples > 0 {
+            session.resume();
+        }
+        let step = snapshot.speed * rate_ratio;
+        drop(snapshot);
+        if !playing || position >= window.total as f64 {
+            thread::sleep(Duration::from_millis(5));
+            continue;
+        }
+        if session.stats().needs_recovery {
+            session.recover()?;
+        }
+        let source_bound = (((DECODE_FRAMES - 2) as f64 / step).floor() as usize).max(1);
+        let frames = (session.free_samples() / channels)
+            .min(OUTPUT_FRAMES)
+            .min(source_bound)
+            .min(((window.total as f64 - position) / step).ceil() as usize);
+        if frames == 0 {
+            thread::sleep(Duration::from_millis(5));
+            continue;
+        }
+        let first = position.floor() as i64;
+        let last = (position + (frames - 1) as f64 * step).floor() as i64 + 1;
+        let decoded = window.ensure(&mut source, first, last);
+        if decoded.is_ok() {
+            window.render(&mut scratch[..frames * channels], channels, position, step);
+        }
+        let current = lock(state);
+        if current.generation != generation || !current.playing || quit.load(Ordering::Acquire) {
+            continue;
+        }
+        decoded?;
+        let accepted = session.push_samples(&scratch[..frames * channels]);
+        position += (accepted / channels) as f64 * step;
+        if accepted > 0 {
+            session.resume();
+        }
+        if let Some(e) = session.take_last_error() {
+            return Err(e);
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn conversion_interpolates_rate_speed_and_maps_channels() {
+        let window = SourceWindow {
+            samples: vec![0.0, 0.5, 1.0, -0.5, 0.0, 0.25],
+            at: 0,
+            channels: 2,
+            total: 3,
+        };
+        let mut out = [0.0; 12];
+        window.render(&mut out, 3, 0.0, 0.5);
+        assert_eq!(
+            out,
+            [0.0, 0.5, 0.5, 0.5, 0.0, 0.0, 1.0, -0.5, -0.5, 0.5, -0.125, -0.125]
+        );
+        let mut fast = [0.0; 2];
+        window.render(&mut fast, 1, 0.0, 2.0);
+        assert_eq!(fast, [0.0, 0.0]);
+    }
+
+    struct Source {
+        calls: usize,
+        short: bool,
+    }
+    impl PlaybackSource for Source {
+        fn sample_rate(&self) -> u32 {
+            48_000
+        }
+        fn channels(&self) -> u16 {
+            1
+        }
+        fn total_frames(&self) -> i64 {
+            200_000
+        }
+        fn decode_range(&mut self, at: i64, frames: usize) -> Result<Vec<f32>, AudioError> {
+            self.calls += 1;
+            let count = if self.short { frames - 1 } else { frames };
+            Ok((0..count).map(|i| (at + i as i64) as f32).collect())
+        }
+    }
+
+    #[test]
+    fn source_window_reuses_decode_then_reloads_on_seek_and_chunk_boundary() {
+        let mut source = Source {
+            calls: 0,
+            short: false,
+        };
+        let mut window = SourceWindow {
+            samples: Vec::new(),
+            at: 0,
+            channels: 1,
+            total: 200_000,
+        };
+        window.ensure(&mut source, 0, 2048).unwrap();
+        assert_eq!(window.samples.len(), DECODE_FRAMES);
+        window.ensure(&mut source, 2048, 4096).unwrap();
+        assert_eq!(source.calls, 1);
+        window.ensure(&mut source, 95_999, 96_001).unwrap();
+        assert_eq!(source.calls, 2);
+        assert_eq!(window.sample(96_000, 0), 96_000.0);
+        window.ensure(&mut source, 2, 4).unwrap();
+        assert_eq!(source.calls, 3);
+        assert_eq!(window.sample(2, 0), 2.0);
+    }
+
+    #[test]
+    fn incomplete_decode_is_an_error_and_eof_interpolates_to_silence() {
+        let mut source = Source {
+            calls: 0,
+            short: true,
+        };
+        let mut window = SourceWindow {
+            samples: Vec::new(),
+            at: 0,
+            channels: 1,
+            total: 200_000,
+        };
+        assert!(window.ensure(&mut source, 0, 10).is_err());
+        window.samples = vec![1.0];
+        window.at = 199_999;
+        let mut out = [9.0; 2];
+        window.render(&mut out, 1, 199_999.5, 0.5);
+        assert_eq!(out, [0.5, 0.0]);
+    }
+
+    #[test]
+    fn transport_seek_speed_stop_and_flush_are_device_less() {
+        use super::super::state::Shared;
+        let control = OutputControl {
+            shared: Arc::new(Shared::new(24_000, 2, 100)),
+        };
+        let playback = OutputPlayback {
+            control,
+            state: Arc::new(Mutex::new(Transport {
+                generation: 0,
+                base: 0.0,
+                speed: 1.0,
+                playing: true,
+                error: None,
+            })),
+            quit: Arc::new(AtomicBool::new(false)),
+            join: None,
+            source_rate: 48_000,
+            total: 1000,
+        };
+        playback.control.shared.push(&[0.5; 20]);
+        playback.control.shared.ring.pop_into(&mut [0.0; 20]);
+        assert_eq!(playback.cursor_samples(), 20);
+        assert!(playback.set_speed(f32::NAN).is_err());
+        assert_eq!(lock(&playback.state).generation, 0);
+        playback.set_speed(2.0).unwrap();
+        assert_eq!(playback.cursor_samples(), 20);
+        let mut seen = 0;
+        playback.control.shared.process_flush(&mut seen);
+        playback.control.shared.push(&[0.5; 20]);
+        playback.control.shared.ring.pop_into(&mut [0.0; 20]);
+        assert_eq!(playback.cursor_samples(), 60);
+        playback.stop();
+        assert!(playback.output().is_paused());
+        playback.flush();
+        assert_eq!(playback.cursor_samples(), 60);
+        playback.seek_samples(2000);
+        assert_eq!(playback.cursor_samples(), 1000);
+        playback.seek_samples(-1);
+        assert_eq!(playback.cursor_samples(), 0);
+        assert_eq!(lock(&playback.state).generation, 4);
+    }
+}

+//! Ignore-aware repository walk: a deterministic directory traversal that honours
+//! `.gitignore` files (nested, negations, anchoring, `**`, directory-only rules) plus
+//! `.git/info/exclude`. std only; works on every platform and does not use the index.
+//!
+//! ```no_run
+//! use rightkit_fsindex::{walk_repo, WalkControl, WalkOptions};
+//! let opts = WalkOptions::default();
+//! let outcome = walk_repo(std::path::Path::new("/work/repo"), &opts, |e| {
+//!     println!("{}", e.rel_path);
+//!     WalkControl::Continue
+//! })
+//! .unwrap();
+//! println!("{} files, {} ignored", outcome.entries, outcome.ignored);
+//! ```
+//!
+//! Not covered: the user's global excludes file (`core.excludesFile`; pass it through
+//! [`WalkOptions::extra_ignore_files`]), and following symlinks (they are reported as
+//! [`WalkKind::Symlink`] and never entered).
+
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Seg {
+    /// `**` as a whole path segment: zero or more directories.
+    DoubleStar,
+    Glob(Vec<u8>),
+}
+
+#[derive(Debug, Clone)]
+struct IgnoreRule {
+    segs: Vec<Seg>,
+    negate: bool,
+    dir_only: bool,
+    /// Matched against the path below the rule's base; otherwise against the file name only.
+    anchored: bool,
+}
+
+#[derive(Debug, Clone)]
+struct Frame {
+    /// Directory the rules apply below, relative to the walk root: `""` or `"a/b/"`.
+    base: String,
+    rules: Vec<IgnoreRule>,
+}
+
+/// A stack of gitignore rule sets. Later (deeper) sets override earlier ones, and inside one
+/// set the last matching rule wins, as in git.
+#[derive(Debug, Clone, Default)]
+pub struct GitIgnore {
+    frames: Vec<Frame>,
+    case_insensitive: bool,
+}
+
+impl GitIgnore {
+    /// An empty matcher. `case_insensitive` folds ASCII case (git's `core.ignorecase`).
+    pub fn new(case_insensitive: bool) -> GitIgnore {
+        GitIgnore {
+            frames: Vec::new(),
+            case_insensitive,
+        }
+    }
+
+    /// Push the rules of one ignore file. `base` is the directory holding it, relative to the
+    /// walk root with `/` separators (`""` for the root, `"sub/dir"` otherwise). Returns the
+    /// number of rules added.
+    pub fn push_rules(&mut self, base: &str, text: &str) -> usize {
+        let rules: Vec<IgnoreRule> = text.lines().filter_map(parse_rule).collect();
+        let n = rules.len();
+        let mut base = base.trim_matches('/').to_string();
+        if !base.is_empty() {
+            base.push('/');
+        }
+        self.frames.push(Frame { base, rules });
+        n
+    }
+
+    /// Remove the most recently pushed rule set.
+    pub fn pop_rules(&mut self) {
+        self.frames.pop();
+    }
+
+    /// True when `rel_path` (relative to the walk root, `/` separated, no leading slash) is
+    /// ignored. `is_dir` selects directory-only rules. Parents are not consulted: a walker
+    /// that never enters an ignored directory gets git's "cannot re-include below an excluded
+    /// directory" behaviour for free.
+    pub fn is_ignored(&self, rel_path: &str, is_dir: bool) -> bool {
+        for frame in self.frames.iter().rev() {
+            let Some(below) = rel_path.strip_prefix(frame.base.as_str()) else {
+                continue;
+            };
+            if below.is_empty() {
+                continue;
+            }
+            for rule in frame.rules.iter().rev() {
+                if rule.dir_only && !is_dir {
+                    continue;
+                }
+                if rule.matches(below, self.case_insensitive) {
+                    return !rule.negate;
+                }
+            }
+        }
+        false
+    }
+}
+
+fn parse_rule(line: &str) -> Option<IgnoreRule> {
+    let mut line = line.trim_end_matches('\r');
+    // Unescaped trailing spaces are not significant.
+    while line.ends_with(' ') && !line.ends_with("\\ ") {
+        line = &line[..line.len() - 1];
+    }
+    if line.is_empty() || line.starts_with('#') {
+        return None;
+    }
+    let (negate, mut pat) = match line.strip_prefix('!') {
+        Some(rest) => (true, rest),
+        None => (false, line),
+    };
+    // `\#` and `\!` escape a leading special character; the glob matcher unescapes it.
+    let dir_only = pat.ends_with('/');
+    if dir_only {
+        pat = pat.trim_end_matches('/');
+    }
+    if pat.is_empty() {
+        return None;
+    }
+    let anchored = pat.contains('/');
+    let pat = pat.trim_start_matches('/');
+    let segs: Vec<Seg> = pat
+        .split('/')
+        .filter(|s| !s.is_empty())
+        .map(|s| {
+            if s == "**" {
+                Seg::DoubleStar
+            } else {
+                Seg::Glob(s.as_bytes().to_vec())
+            }
+        })
+        .collect();
+    if segs.is_empty() {
+        return None;
+    }
+    Some(IgnoreRule {
+        segs,
+        negate,
+        dir_only,
+        anchored,
+    })
+}
+
+impl IgnoreRule {
+    fn matches(&self, below: &str, ci: bool) -> bool {
+        if self.anchored {
+            let parts: Vec<&str> = below.split('/').collect();
+            match_segs(&self.segs, &parts, ci)
+        } else {
+            let name = below.rsplit('/').next().unwrap_or(below);
+            match_segs(&self.segs, &[name], ci)
+        }
+    }
+}
+
+fn match_segs(p: &[Seg], s: &[&str], ci: bool) -> bool {
+    match p.split_first() {
+        None => s.is_empty(),
+        Some((Seg::DoubleStar, rest)) => {
+            if rest.is_empty() {
+                // A trailing `/**` matches everything inside, not the directory itself.
+                return !s.is_empty();
+            }
+            (0..=s.len()).any(|k| match_segs(rest, &s[k..], ci))
+        }
+        Some((Seg::Glob(g), rest)) => match s.split_first() {
+            Some((first, tail)) => glob(g, first.as_bytes(), ci) && match_segs(rest, tail, ci),
+            None => false,
+        },
+    }
+}
+
+fn eq(a: u8, b: u8, ci: bool) -> bool {
+    a == b || (ci && a.eq_ignore_ascii_case(&b))
+}
+
+/// Match a `[...]` class starting at `p[pi] == b'['` against `ch`: (matched, index after `]`),
+/// or `None` when the class is not closed (the `[` is then a literal).
+fn class(p: &[u8], pi: usize, ch: u8, ci: bool) -> Option<(bool, usize)> {
+    let mut i = pi + 1;
+    let negate = matches!(p.get(i), Some(b'!') | Some(b'^'));
+    if negate {
+        i += 1;
+    }
+    let mut matched = false;
+    let mut first = true;
+    loop {
+        let c = *p.get(i)?;
+        if c == b']' && !first {
+            return Some((matched != negate, i + 1));
+        }
+        first = false;
+        let lo = if c == b'\\' {
+            i += 1;
+            *p.get(i)?
+        } else {
+            c
+        };
+        if p.get(i + 1) == Some(&b'-') && p.get(i + 2).is_some_and(|&n| n != b']') {
+            let hi = p[i + 2];
+            let in_range = |x: u8| lo <= x && x <= hi;
+            if in_range(ch)
+                || (ci && (in_range(ch.to_ascii_lowercase()) || in_range(ch.to_ascii_uppercase())))
+            {
+                matched = true;
+            }
+            i += 3;
+        } else {
+            if eq(lo, ch, ci) {
+                matched = true;
+            }
+            i += 1;
+        }
+    }
+}
+
+/// Glob match of one path segment (no `/` in `t`): `*`, `?`, `[...]`, `\x`.
+fn glob(p: &[u8], t: &[u8], ci: bool) -> bool {
+    let (mut pi, mut ti) = (0usize, 0usize);
+    let mut star: Option<(usize, usize)> = None;
+    loop {
+        if pi < p.len() {
+            match p[pi] {
+                b'*' => {
+                    star = Some((pi + 1, ti));
+                    pi += 1;
+                    continue;
+                }
+                b'?' if ti < t.len() => {
+                    pi += 1;
+                    ti += 1;
+                    continue;
+                }
+                b'[' if ti < t.len() => match class(p, pi, t[ti], ci) {
+                    Some((true, next)) => {
+                        pi = next;
+                        ti += 1;
+                        continue;
+                    }
+                    Some((false, _)) => {}
+                    None => {
+                        if eq(b'[', t[ti], ci) {
+                            pi += 1;
+                            ti += 1;
+                            continue;
+                        }
+                    }
+                },
+                b'\\' if pi + 1 < p.len() && ti < t.len() => {
+                    if eq(p[pi + 1], t[ti], ci) {
+                        pi += 2;
+                        ti += 1;
+                        continue;
+                    }
+                }
+                c if ti < t.len() && c != b'?' && c != b'[' && c != b'\\' && eq(c, t[ti], ci) => {
+                    pi += 1;
+                    ti += 1;
+                    continue;
+                }
+                _ => {}
+            }
+        } else if ti == t.len() {
+            return true;
+        }
+        match star {
+            Some((sp, st)) if st < t.len() => {
+                star = Some((sp, st + 1));
+                pi = sp;
+                ti = st + 1;
+            }
+            _ => return false,
+        }
+    }
+}
+
+/// What the walk visitor wants next.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum WalkControl {
+    /// Keep going (descend into a directory).
+    Continue,
+    /// Do not enter this directory (ignored for a file).
+    SkipDir,
+    /// End the walk now.
+    Stop,
+}
+
+/// Kind of a walked entry.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum WalkKind {
+    File,
+    Dir,
+    /// A symbolic link; never followed.
+    Symlink,
+    /// A socket, device or other special file.
+    Other,
+}
+
+/// One entry reported by [`walk_repo`].
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct WalkEntry {
+    /// Absolute (or root-relative, as the caller passed it) path.
+    pub path: PathBuf,
+    /// Path relative to the walk root, `/` separated on every platform.
+    pub rel_path: String,
+    /// 1 for direct children of the root.
+    pub depth: usize,
+    pub kind: WalkKind,
+    /// Byte length for files, 0 otherwise.
+    pub size: u64,
+}
+
+/// What a walk did.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct WalkOutcome {
+    /// Entries reported to the visitor.
+    pub entries: usize,
+    /// Entries (files and whole directories) skipped by ignore rules.
+    pub ignored: usize,
+    /// Directories that could not be read.
+    pub errors: usize,
+    /// True when `max_entries` ended the walk or the visitor returned [`WalkControl::Stop`].
+    pub truncated: bool,
+}
+
+/// Options for [`walk_repo`]. Build with `WalkOptions::default()` and set fields.
+#[derive(Debug, Clone)]
+#[non_exhaustive]
+pub struct WalkOptions {
+    /// Ignore file names read in every directory, later names overriding earlier ones.
+    /// Default `[".gitignore"]`; add `".ignore"` for ripgrep-style files, or empty to disable.
+    pub ignore_file_names: Vec<String>,
+    /// Read `<root>/.git/info/exclude` (default true).
+    pub use_git_info_exclude: bool,
+    /// Extra ignore files (for example the global excludes file), lowest precedence,
+    /// applied as if they sat in the root.
+    pub extra_ignore_files: Vec<PathBuf>,
+    /// Skip names starting with `.` (default false). `.git` is always skipped.
+    pub skip_hidden: bool,
+    /// Deepest level reported and entered; `None` is unlimited.
+    pub max_depth: Option<usize>,
+    /// End the walk after this many reported entries; `None` is unlimited.
+    pub max_entries: Option<usize>,
+    /// Fold ASCII case when matching rules. Default true on Windows and macOS, false elsewhere.
+    pub case_insensitive: bool,
+}
+
+impl Default for WalkOptions {
+    fn default() -> Self {
+        WalkOptions {
+            ignore_file_names: vec![".gitignore".to_string()],
+            use_git_info_exclude: true,
+            extra_ignore_files: Vec::new(),
+            skip_hidden: false,
+            max_depth: None,
+            max_entries: None,
+            case_insensitive: cfg!(any(windows, target_os = "macos")),
+        }
+    }
+}
+
+struct Walker<'a, F> {
+    opts: &'a WalkOptions,
+    ignore: GitIgnore,
+    visit: F,
+    out: WalkOutcome,
+    stopped: bool,
+}
+
+fn read_text(path: &Path) -> Option<String> {
+    let meta = fs::metadata(path).ok()?;
+    if !meta.is_file() || meta.len() > 4 << 20 {
+        return None;
+    }
+    fs::read(path)
+        .ok()
+        .map(|b| String::from_utf8_lossy(&b).into_owned())
+}
+
+/// Walk `root` depth first in file-name order, reporting every entry that no ignore rule
+/// excludes. `.git` is never reported or entered. An unreadable subdirectory is counted in
+/// [`WalkOutcome::errors`] and skipped; an unreadable `root` is an error.
+pub fn walk_repo<F>(root: &Path, opts: &WalkOptions, visit: F) -> io::Result<WalkOutcome>
+where
+    F: FnMut(&WalkEntry) -> WalkControl,
+{
+    if !fs::metadata(root)?.is_dir() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "walk root is not a directory",
+        ));
+    }
+    let mut ignore = GitIgnore::new(opts.case_insensitive);
+    for f in &opts.extra_ignore_files {
+        if let Some(text) = read_text(f) {
+            ignore.push_rules("", &text);
+        }
+    }
+    if opts.use_git_info_exclude {
+        if let Some(text) = read_text(&root.join(".git").join("info").join("exclude")) {
+            ignore.push_rules("", &text);
+        }
+    }
+    let mut w = Walker {
+        opts,
+        ignore,
+        visit,
+        out: WalkOutcome::default(),
+        stopped: false,
+    };
+    w.dir(root, "", 1)?;
+    Ok(w.out)
+}
+
+impl<F: FnMut(&WalkEntry) -> WalkControl> Walker<'_, F> {
+    fn dir(&mut self, dir: &Path, rel: &str, depth: usize) -> io::Result<()> {
+        let mut children: Vec<(String, fs::DirEntry)> = fs::read_dir(dir)?
+            .filter_map(Result::ok)
+            .map(|e| (e.file_name().to_string_lossy().into_owned(), e))
+            .collect();
+        children.sort_by(|a, b| a.0.cmp(&b.0));
+
+        let mut pushed = 0usize;
+        for name in &self.opts.ignore_file_names {
+            if let Some(text) = read_text(&dir.join(name)) {
+                self.ignore.push_rules(rel, &text);
+                pushed += 1;
+            }
+        }
+
+        for (name, entry) in children {
+            if self.stopped {
+                break;
+            }
+            if name == ".git" || (self.opts.skip_hidden && name.starts_with('.')) {
+                continue;
+            }
+            let Ok(ft) = entry.file_type() else {
+                self.out.errors += 1;
+                continue;
+            };
+            let kind = if ft.is_symlink() {
+                WalkKind::Symlink
+            } else if ft.is_dir() {
+                WalkKind::Dir
+            } else if ft.is_file() {
+                WalkKind::File
+            } else {
+                WalkKind::Other
+            };
+            let rel_path = if rel.is_empty() {
+                name.clone()
+            } else {
+                format!("{rel}/{name}")
+            };
+            if self.ignore.is_ignored(&rel_path, kind == WalkKind::Dir) {
+                self.out.ignored += 1;
+                continue;
+            }
+            let size = if kind == WalkKind::File {
+                entry.metadata().map_or(0, |m| m.len())
+            } else {
+                0
+            };
+            let we = WalkEntry {
+                path: entry.path(),
+                rel_path,
+                depth,
+                kind,
+                size,
+            };
+            self.out.entries += 1;
+            let ctl = (self.visit)(&we);
+            if ctl == WalkControl::Stop {
+                self.out.truncated = true;
+                self.stopped = true;
+                break;
+            }
+            if self.opts.max_entries.is_some_and(|m| self.out.entries >= m) {
+                self.out.truncated = true;
+                self.stopped = true;
+                break;
+            }
+            if kind == WalkKind::Dir
+                && ctl == WalkControl::Continue
+                && self.opts.max_depth.is_none_or(|m| depth < m)
+                && self.dir(&we.path, &we.rel_path, depth + 1).is_err()
+            {
+                self.out.errors += 1;
+            }
+        }
+        for _ in 0..pushed {
+            self.ignore.pop_rules();
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn ign(text: &str) -> GitIgnore {
+        let mut g = GitIgnore::new(false);
+        g.push_rules("", text);
+        g
+    }
+
+    #[test]
+    fn basename_and_anchored_rules() {
+        let g = ign("*.log\n/build\ndocs/*.tmp\n");
+        assert!(g.is_ignored("a.log", false));
+        assert!(g.is_ignored("deep/er/a.log", false));
+        assert!(g.is_ignored("build", true));
+        assert!(!g.is_ignored("sub/build", true));
+        assert!(g.is_ignored("docs/x.tmp", false));
+        assert!(!g.is_ignored("docs/sub/x.tmp", false));
+        assert!(!g.is_ignored("a.txt", false));
+    }
+
+    #[test]
+    fn dir_only_negation_and_last_match_wins() {
+        let g = ign("target/\n*.rs\n!keep.rs\n# comment\n\n");
+        assert!(g.is_ignored("target", true));
+        assert!(!g.is_ignored("target", false));
+        assert!(g.is_ignored("src/a.rs", false));
+        assert!(!g.is_ignored("src/keep.rs", false));
+    }
+
+    #[test]
+    fn double_star_forms() {
+        let g = ign("**/cache\nlogs/**\na/**/z\n");
+        assert!(g.is_ignored("cache", true));
+        assert!(g.is_ignored("x/y/cache", true));
+        assert!(g.is_ignored("logs/a", false));
+        assert!(g.is_ignored("logs/a/b", false));
+        assert!(!g.is_ignored("logs", true));
+        assert!(g.is_ignored("a/z", false));
+        assert!(g.is_ignored("a/b/c/z", false));
+        assert!(!g.is_ignored("b/a/z", false));
+    }
+
+    #[test]
+    fn glob_classes_escapes_and_case() {
+        let g = ign("file[0-9].txt\n?.o\n\\#hash\n!\\!bang\nfoo\\ \n");
+        assert!(g.is_ignored("file7.txt", false));
+        assert!(!g.is_ignored("fileA.txt", false));
+        assert!(g.is_ignored("a.o", false));
+        assert!(!g.is_ignored("ab.o", false));
+        assert!(g.is_ignored("#hash", false));
+        assert!(g.is_ignored("foo ", false));
+        let mut ci = GitIgnore::new(true);
+        ci.push_rules("", "README\n");
+        assert!(ci.is_ignored("readme", false));
+        assert!(!ign("README\n").is_ignored("readme", false));
+    }
+
+    #[test]
+    fn nested_files_override_parents() {
+        let mut g = GitIgnore::new(false);
+        g.push_rules("", "*.dat\n");
+        g.push_rules("sub", "!keep.dat\n/only.txt\n");
+        assert!(g.is_ignored("a.dat", false));
+        assert!(g.is_ignored("sub/x.dat", false));
+        assert!(!g.is_ignored("sub/keep.dat", false));
+        assert!(g.is_ignored("sub/only.txt", false));
+        assert!(!g.is_ignored("other/only.txt", false));
+        g.pop_rules();
+        assert!(g.is_ignored("sub/keep.dat", false));
+    }
+
+    fn write(root: &Path, rel: &str, body: &str) {
+        let p = root.join(rel);
+        fs::create_dir_all(p.parent().unwrap()).unwrap();
+        fs::write(p, body).unwrap();
+    }
+
+    fn collect(root: &Path, opts: &WalkOptions) -> (Vec<String>, WalkOutcome) {
+        let mut seen = Vec::new();
+        let out = walk_repo(root, opts, |e| {
+            seen.push(e.rel_path.clone());
+            WalkControl::Continue
+        })
+        .unwrap();
+        (seen, out)
+    }
+
+    #[test]
+    fn walk_honours_gitignore_and_skips_dot_git() {
+        let d = tempfile::tempdir().unwrap();
+        let r = d.path();
+        write(r, ".gitignore", "target/\n*.log\n");
+        write(r, ".git/HEAD", "ref");
+        write(r, ".git/info/exclude", "secret.txt\n");
+        write(r, "secret.txt", "x");
+        write(r, "a.txt", "hello");
+        write(r, "debug.log", "x");
+        write(r, "target/out.bin", "x");
+        write(r, "src/main.rs", "fn main(){}");
+        write(r, "src/.gitignore", "gen/\n!debug.log\n");
+        write(r, "src/gen/g.rs", "x");
+        write(r, "src/debug.log", "x");
+        let (seen, out) = collect(r, &WalkOptions::default());
+        assert_eq!(
+            seen,
+            vec![
+                ".gitignore",
+                "a.txt",
+                "src",
+                "src/.gitignore",
+                "src/debug.log",
+                "src/main.rs"
+            ]
+        );
+        // debug.log, target, secret.txt, src/gen
+        assert_eq!(out.ignored, 4);
+        assert!(!out.truncated);
+        assert_eq!(out.errors, 0);
+    }
+
+    #[test]
+    fn walk_limits_hidden_and_visitor_control() {
+        let d = tempfile::tempdir().unwrap();
+        let r = d.path();
+        write(r, ".hidden", "x");
+        write(r, "a/b/c.txt", "x");
+        write(r, "a/d.txt", "x");
+        write(r, "z.txt", "xyz");
+
+        let o = WalkOptions {
+            skip_hidden: true,
+            max_depth: Some(2),
+            ..WalkOptions::default()
+        };
+        let (seen, _) = collect(r, &o);
+        assert_eq!(seen, vec!["a", "a/b", "a/d.txt", "z.txt"]);
+
+        let o = WalkOptions {
+            max_entries: Some(2),
+            ..WalkOptions::default()
+        };
+        let (seen, out) = collect(r, &o);
+        assert_eq!(seen.len(), 2);
+        assert!(out.truncated);
+
+        let mut skipped = Vec::new();
+        let out = walk_repo(r, &WalkOptions::default(), |e| {
+            skipped.push(e.rel_path.clone());
+            if e.rel_path == "a" {
+                WalkControl::SkipDir
+            } else {
+                WalkControl::Continue
+            }
+        })
+        .unwrap();
+        assert_eq!(skipped, vec![".hidden", "a", "z.txt"]);
+        assert!(!out.truncated);
+
+        let mut sizes = Vec::new();
+        walk_repo(r, &WalkOptions::default(), |e| {
+            if e.rel_path == "z.txt" {
+                sizes.push(e.size);
+            }
+            WalkControl::Continue
+        })
+        .unwrap();
+        assert_eq!(sizes, vec![3]);
+    }
+
+    #[test]
+    fn walk_rejects_a_file_root() {
+        let d = tempfile::tempdir().unwrap();
+        write(d.path(), "f", "x");
+        let err = walk_repo(&d.path().join("f"), &WalkOptions::default(), |_| {
+            WalkControl::Continue
+        })
+        .unwrap_err();
+        assert_eq!(err.kind(), io::ErrorKind::InvalidInput);
+    }
+}

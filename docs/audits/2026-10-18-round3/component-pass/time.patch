+//! IANA named time zones with DST, read from a system tz database (TZif files). std only.
+//!
+//! The database is the operating system's own: `/usr/share/zoneinfo` (and the usual
+//! alternatives) on Unix and macOS. Windows ships no TZif files, so there
+//! [`TimeZone::load`] reports [`TzError::NotFound`] unless a directory is supplied through
+//! [`TimeZone::load_from_dir`] or the bytes through [`TimeZone::from_tzif`] (a host can bundle
+//! a tzdata directory). No third-party crate is involved, so no supply-chain decision is
+//! needed.
+
+use std::fmt;
+use std::path::Path;
+
+use crate::{civil_from_days, days_from_civil, days_in_month, is_leap_year, weekday, DateTime};
+
+/// Largest TZif file read, in bytes. Real zones are a few KiB.
+const MAX_TZIF_BYTES: u64 = 1 << 20;
+
+/// Directories searched by [`TimeZone::load`], in order.
+#[cfg(unix)]
+const SYSTEM_DIRS: &[&str] = &[
+    "/usr/share/zoneinfo",
+    "/usr/share/lib/zoneinfo",
+    "/usr/lib/zoneinfo",
+    "/etc/zoneinfo",
+];
+#[cfg(not(unix))]
+const SYSTEM_DIRS: &[&str] = &[];
+
+/// Why a zone could not be resolved.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum TzError {
+    /// The zone name is empty, absolute, or contains a path-escaping component.
+    InvalidName,
+    /// No tz database has this zone (or this host has no tz database directory).
+    NotFound,
+    /// The file is not valid TZif data.
+    Malformed(&'static str),
+    /// Reading the file failed.
+    Io(String),
+}
+
+impl fmt::Display for TzError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            TzError::InvalidName => f.write_str("invalid time zone name"),
+            TzError::NotFound => f.write_str("time zone not found in the tz database"),
+            TzError::Malformed(why) => write!(f, "malformed TZif data: {why}"),
+            TzError::Io(e) => write!(f, "reading time zone data failed: {e}"),
+        }
+    }
+}
+
+impl std::error::Error for TzError {}
+
+/// The UTC offset in force at an instant.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ZoneOffset {
+    /// Seconds east of UTC. May be a non-whole-minute value for historic local mean time.
+    pub utc_offset_secs: i32,
+    /// True while daylight saving time is in force.
+    pub is_dst: bool,
+    /// The zone abbreviation, e.g. `PST`, `CEST`.
+    pub abbreviation: String,
+}
+
+/// How a civil (wall clock) time maps onto the timeline in a zone.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum LocalResolution {
+    /// Exactly one instant has this wall clock reading.
+    Single(i64),
+    /// The wall clock reading happens twice (clocks went back): the earlier and later instant.
+    Ambiguous { earlier: i64, later: i64 },
+    /// The wall clock reading never happens (clocks jumped forward). The instants are what
+    /// the reading means under the offset before and after the jump.
+    Gap {
+        with_pre_offset: i64,
+        with_post_offset: i64,
+    },
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Rule {
+    /// `Mm.w.d`: month, week 1-5 (5 = last), weekday 0 = Sunday.
+    Month { m: u32, w: u32, d: u32 },
+    /// `Jn`: day 1-365, February 29 never counted.
+    Julian1(u32),
+    /// `n`: day 0-365, February 29 counted in leap years.
+    Zero(u32),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct PosixDst {
+    offset: ZoneOffset,
+    start: Rule,
+    start_time: i32,
+    end: Rule,
+    end_time: i32,
+}
+
+/// The POSIX TZ string that follows the last transition in a TZif v2+ file.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct PosixTz {
+    std: ZoneOffset,
+    dst: Option<PosixDst>,
+}
+
+/// A named IANA time zone: UTC offset and DST rules over time.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TimeZone {
+    name: String,
+    transitions: Vec<i64>,
+    transition_types: Vec<u8>,
+    types: Vec<ZoneOffset>,
+    footer: Option<PosixTz>,
+}
+
+impl TimeZone {
+    /// The UTC zone, without touching the file system.
+    pub fn utc() -> TimeZone {
+        TimeZone {
+            name: "UTC".to_string(),
+            transitions: Vec::new(),
+            transition_types: Vec::new(),
+            types: vec![ZoneOffset {
+                utc_offset_secs: 0,
+                is_dst: false,
+                abbreviation: "UTC".to_string(),
+            }],
+            footer: None,
+        }
+    }
+
+    /// Resolve `name` (e.g. `America/New_York`) from the operating system's tz database.
+    pub fn load(name: &str) -> Result<TimeZone, TzError> {
+        validate_name(name)?;
+        if name == "UTC" || name == "Etc/UTC" {
+            let mut z = TimeZone::utc();
+            z.name = name.to_string();
+            return Ok(z);
+        }
+        for dir in SYSTEM_DIRS {
+            match TimeZone::load_from_dir(Path::new(dir), name) {
+                Err(TzError::NotFound) => continue,
+                other => return other,
+            }
+        }
+        Err(TzError::NotFound)
+    }
+
+    /// Resolve `name` from a tz database directory laid out like `/usr/share/zoneinfo`.
+    pub fn load_from_dir(dir: &Path, name: &str) -> Result<TimeZone, TzError> {
+        validate_name(name)?;
+        let path = dir.join(name);
+        let meta = match std::fs::metadata(&path) {
+            Ok(m) => m,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Err(TzError::NotFound),
+            Err(e) => return Err(TzError::Io(e.to_string())),
+        };
+        if !meta.is_file() {
+            return Err(TzError::NotFound);
+        }
+        if meta.len() > MAX_TZIF_BYTES {
+            return Err(TzError::Malformed("file too large"));
+        }
+        let bytes = std::fs::read(&path).map_err(|e| TzError::Io(e.to_string()))?;
+        TimeZone::from_tzif(name, &bytes)
+    }
+
+    /// Build a zone from the bytes of a TZif file (RFC 8536, versions 1 to 4).
+    pub fn from_tzif(name: &str, bytes: &[u8]) -> Result<TimeZone, TzError> {
+        parse_tzif(name, bytes)
+    }
+
+    /// The name this zone was loaded under.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// The offset, DST flag and abbreviation in force at `unix_secs`.
+    pub fn offset_at(&self, unix_secs: i64) -> ZoneOffset {
+        let past_last = match self.transitions.last() {
+            Some(&last) => unix_secs >= last,
+            None => true,
+        };
+        if past_last {
+            if let Some(f) = &self.footer {
+                return f.offset_at(unix_secs);
+            }
+        }
+        let idx = self.transitions.partition_point(|&t| t <= unix_secs);
+        let ty = if idx == 0 {
+            // Before the first transition: the first non-DST type, else type 0 (RFC 8536).
+            self.types
+                .iter()
+                .find(|t| !t.is_dst)
+                .unwrap_or(&self.types[0])
+        } else {
+            &self.types[self.transition_types[idx - 1] as usize]
+        };
+        ty.clone()
+    }
+
+    /// The civil time of `unix_secs` in this zone. `offset_secs` carries the real offset; it
+    /// can be a value [`crate::valid_offset_secs`] rejects (old local mean time), in which case
+    /// [`DateTime::format_rfc3339`] writes the same instant as UTC.
+    pub fn to_datetime(&self, unix_secs: i64) -> DateTime {
+        let off = self.offset_at(unix_secs).utc_offset_secs;
+        let local = unix_secs + off as i64;
+        let (year, month, day) = civil_from_days(local.div_euclid(86_400));
+        let sod = local.rem_euclid(86_400) as u32;
+        DateTime {
+            year,
+            month,
+            day,
+            hour: sod / 3600,
+            minute: sod % 3600 / 60,
+            second: sod % 60,
+            nanos: 0,
+            offset_secs: off,
+        }
+    }
+
+    /// Map the wall clock fields of `local` (year, month, day, hour, minute, second; its
+    /// `offset_secs` and `nanos` are ignored) to instants in this zone. `None` when a field
+    /// is out of range.
+    pub fn resolve_local(&self, local: &DateTime) -> Option<LocalResolution> {
+        if !(1..=12).contains(&local.month)
+            || local.day == 0
+            || local.day > days_in_month(local.year, local.month)
+            || local.hour > 23
+            || local.minute > 59
+            || local.second > 60
+        {
+            return None;
+        }
+        let l = days_from_civil(local.year, local.month, local.day) * 86_400
+            + local.hour as i64 * 3600
+            + local.minute as i64 * 60
+            + local.second as i64;
+        // Offsets in force a little before and after cover any single transition.
+        let probe = 2 * 86_400;
+        let before = self.offset_at(l - probe).utc_offset_secs;
+        let after = self.offset_at(l + probe).utc_offset_secs;
+        let mut valid: Vec<i64> = Vec::new();
+        for o in [before, after] {
+            let t = l - o as i64;
+            if self.offset_at(t).utc_offset_secs == o && !valid.contains(&t) {
+                valid.push(t);
+            }
+        }
+        valid.sort_unstable();
+        Some(match valid.as_slice() {
+            [one] => LocalResolution::Single(*one),
+            [a, b] => LocalResolution::Ambiguous {
+                earlier: *a,
+                later: *b,
+            },
+            _ => LocalResolution::Gap {
+                with_pre_offset: l - before as i64,
+                with_post_offset: l - after as i64,
+            },
+        })
+    }
+}
+
+fn validate_name(name: &str) -> Result<(), TzError> {
+    if name.is_empty() || name.len() > 64 || name.starts_with('/') || name.ends_with('/') {
+        return Err(TzError::InvalidName);
+    }
+    for part in name.split('/') {
+        if part.is_empty() || part == "." || part == ".." {
+            return Err(TzError::InvalidName);
+        }
+        if !part
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'+' | b'-' | b'.'))
+        {
+            return Err(TzError::InvalidName);
+        }
+    }
+    Ok(())
+}
+
+// ---------------------------------------------------------------------------------------------
+// TZif parsing
+// ---------------------------------------------------------------------------------------------
+
+struct Header {
+    version: u8,
+    isutcnt: usize,
+    isstdcnt: usize,
+    leapcnt: usize,
+    timecnt: usize,
+    typecnt: usize,
+    charcnt: usize,
+}
+
+impl Header {
+    fn parse(b: &[u8]) -> Result<Header, TzError> {
+        if b.len() < 44 || &b[0..4] != b"TZif" {
+            return Err(TzError::Malformed("missing TZif magic"));
+        }
+        let n = |i: usize| u32::from_be_bytes([b[i], b[i + 1], b[i + 2], b[i + 3]]) as usize;
+        Ok(Header {
+            version: b[4],
+            isutcnt: n(20),
+            isstdcnt: n(24),
+            leapcnt: n(28),
+            timecnt: n(32),
+            typecnt: n(36),
+            charcnt: n(40),
+        })
+    }
+
+    fn data_len(&self, time_size: usize) -> Option<usize> {
+        self.timecnt
+            .checked_mul(time_size + 1)?
+            .checked_add(self.typecnt.checked_mul(6)?)?
+            .checked_add(self.charcnt)?
+            .checked_add(self.leapcnt.checked_mul(time_size + 4)?)?
+            .checked_add(self.isstdcnt)?
+            .checked_add(self.isutcnt)
+    }
+}
+
+fn parse_tzif(name: &str, bytes: &[u8]) -> Result<TimeZone, TzError> {
+    let h1 = Header::parse(bytes)?;
+    let mut body = &bytes[44..];
+    let mut hdr = h1;
+    let mut time_size = 4usize;
+    if hdr.version >= b'2' {
+        let skip = hdr
+            .data_len(4)
+            .ok_or(TzError::Malformed("v1 block size overflow"))?;
+        if body.len() < skip {
+            return Err(TzError::Malformed("truncated v1 block"));
+        }
+        let rest = &body[skip..];
+        hdr = Header::parse(rest)?;
+        body = &rest[44..];
+        time_size = 8;
+    }
+    let need = hdr
+        .data_len(time_size)
+        .ok_or(TzError::Malformed("block size overflow"))?;
+    if body.len() < need {
+        return Err(TzError::Malformed("truncated data block"));
+    }
+    if hdr.typecnt == 0 || hdr.charcnt == 0 {
+        return Err(TzError::Malformed("no local time types"));
+    }
+    let mut pos = 0usize;
+    let mut transitions = Vec::with_capacity(hdr.timecnt);
+    for _ in 0..hdr.timecnt {
+        let t = if time_size == 8 {
+            i64::from_be_bytes(body[pos..pos + 8].try_into().unwrap())
+        } else {
+            i32::from_be_bytes(body[pos..pos + 4].try_into().unwrap()) as i64
+        };
+        transitions.push(t);
+        pos += time_size;
+    }
+    if transitions.windows(2).any(|w| w[0] > w[1]) {
+        return Err(TzError::Malformed("transitions not ascending"));
+    }
+    let transition_types = body[pos..pos + hdr.timecnt].to_vec();
+    pos += hdr.timecnt;
+    if transition_types.iter().any(|&i| i as usize >= hdr.typecnt) {
+        return Err(TzError::Malformed("transition type out of range"));
+    }
+    let raw_types = &body[pos..pos + hdr.typecnt * 6];
+    pos += hdr.typecnt * 6;
+    let chars = &body[pos..pos + hdr.charcnt];
+    pos += hdr.charcnt;
+    pos += hdr.leapcnt * (time_size + 4) + hdr.isstdcnt + hdr.isutcnt;
+
+    let mut types = Vec::with_capacity(hdr.typecnt);
+    for i in 0..hdr.typecnt {
+        let r = &raw_types[i * 6..i * 6 + 6];
+        let off = i32::from_be_bytes([r[0], r[1], r[2], r[3]]);
+        let abbr_idx = r[5] as usize;
+        if abbr_idx >= chars.len() {
+            return Err(TzError::Malformed("abbreviation index out of range"));
+        }
+        let end = chars[abbr_idx..]
+            .iter()
+            .position(|&c| c == 0)
+            .map_or(chars.len(), |p| abbr_idx + p);
+        types.push(ZoneOffset {
+            utc_offset_secs: off,
+            is_dst: r[4] != 0,
+            abbreviation: String::from_utf8_lossy(&chars[abbr_idx..end]).into_owned(),
+        });
+    }
+
+    let mut footer = None;
+    if time_size == 8 {
+        let tail = &body[pos..];
+        if tail.first() == Some(&b'\n') {
+            if let Some(end) = tail[1..].iter().position(|&c| c == b'\n') {
+                let s = std::str::from_utf8(&tail[1..1 + end])
+                    .map_err(|_| TzError::Malformed("footer is not UTF-8"))?;
+                if !s.is_empty() {
+                    footer = Some(parse_posix_tz(s).ok_or(TzError::Malformed("bad footer"))?);
+                }
+            }
+        }
+    }
+
+    Ok(TimeZone {
+        name: name.to_string(),
+        transitions,
+        transition_types,
+        types,
+        footer,
+    })
+}
+
+// ---------------------------------------------------------------------------------------------
+// POSIX TZ strings (the TZif footer)
+// ---------------------------------------------------------------------------------------------
+
+struct Cur<'a> {
+    b: &'a [u8],
+    i: usize,
+}
+
+impl<'a> Cur<'a> {
+    fn peek(&self) -> Option<u8> {
+        self.b.get(self.i).copied()
+    }
+
+    fn eat(&mut self, c: u8) -> bool {
+        if self.peek() == Some(c) {
+            self.i += 1;
+            true
+        } else {
+            false
+        }
+    }
+
+    fn name(&mut self) -> Option<String> {
+        let start;
+        if self.eat(b'<') {
+            start = self.i;
+            while self.peek()? != b'>' {
+                self.i += 1;
+            }
+            let s = std::str::from_utf8(&self.b[start..self.i]).ok()?.to_string();
+            self.i += 1;
+            (s.len() >= 3).then_some(s)
+        } else {
+            start = self.i;
+            while self.peek().is_some_and(|c| c.is_ascii_alphabetic()) {
+                self.i += 1;
+            }
+            (self.i - start >= 3)
+                .then(|| String::from_utf8_lossy(&self.b[start..self.i]).into_owned())
+        }
+    }
+
+    fn number(&mut self, max: u32) -> Option<u32> {
+        let start = self.i;
+        let mut v = 0u32;
+        while let Some(c) = self.peek().filter(u8::is_ascii_digit) {
+            v = v.checked_mul(10)?.checked_add((c - b'0') as u32)?;
+            if v > max {
+                return None;
+            }
+            self.i += 1;
+        }
+        (self.i > start).then_some(v)
+    }
+
+    /// `[+-]hh[:mm[:ss]]` in seconds.
+    fn clock(&mut self, max_hours: u32) -> Option<i32> {
+        let neg = if self.eat(b'-') {
+            true
+        } else {
+            self.eat(b'+');
+            false
+        };
+        let h = self.number(max_hours)? as i32;
+        let (mut m, mut s) = (0, 0);
+        if self.eat(b':') {
+            m = self.number(59)? as i32;
+            if self.eat(b':') {
+                s = self.number(59)? as i32;
+            }
+        }
+        let v = h * 3600 + m * 60 + s;
+        Some(if neg { -v } else { v })
+    }
+
+    fn rule(&mut self) -> Option<(Rule, i32)> {
+        let rule = if self.eat(b'M') {
+            let m = self.number(12)?;
+            if !self.eat(b'.') {
+                return None;
+            }
+            let w = self.number(5)?;
+            if !self.eat(b'.') {
+                return None;
+            }
+            let d = self.number(6)?;
+            if m == 0 || w == 0 {
+                return None;
+            }
+            Rule::Month { m, w, d }
+        } else if self.eat(b'J') {
+            let n = self.number(365)?;
+            if n == 0 {
+                return None;
+            }
+            Rule::Julian1(n)
+        } else {
+            Rule::Zero(self.number(365)?)
+        };
+        let time = if self.eat(b'/') {
+            self.clock(167)?
+        } else {
+            2 * 3600
+        };
+        Some((rule, time))
+    }
+}
+
+fn parse_posix_tz(s: &str) -> Option<PosixTz> {
+    let mut c = Cur {
+        b: s.as_bytes(),
+        i: 0,
+    };
+    let std_name = c.name()?;
+    // POSIX offsets are positive west of UTC.
+    let std_off = -c.clock(24)?;
+    let std = ZoneOffset {
+        utc_offset_secs: std_off,
+        is_dst: false,
+        abbreviation: std_name,
+    };
+    if c.peek().is_none() {
+        return Some(PosixTz { std, dst: None });
+    }
+    let dst_name = c.name()?;
+    let dst_off = match c.peek() {
+        Some(b',') | None => std_off + 3600,
+        _ => -c.clock(24)?,
+    };
+    if !c.eat(b',') {
+        return None;
+    }
+    let (start, start_time) = c.rule()?;
+    if !c.eat(b',') {
+        return None;
+    }
+    let (end, end_time) = c.rule()?;
+    if c.peek().is_some() {
+        return None;
+    }
+    Some(PosixTz {
+        std,
+        dst: Some(PosixDst {
+            offset: ZoneOffset {
+                utc_offset_secs: dst_off,
+                is_dst: true,
+                abbreviation: dst_name,
+            },
+            start,
+            start_time,
+            end,
+            end_time,
+        }),
+    })
+}
+
+/// Seconds since the epoch of local midnight-based `rule` + `time` in year `y`, as wall clock.
+fn rule_local_secs(y: i64, rule: &Rule, time: i32) -> i64 {
+    let day = match *rule {
+        Rule::Month { m, w, d } => {
+            let wd1 = weekday(y, m, 1) as i64;
+            let mut day = 1 + (d as i64 - wd1).rem_euclid(7) + (w as i64 - 1) * 7;
+            let dim = days_in_month(y, m) as i64;
+            while day > dim {
+                day -= 7;
+            }
+            days_from_civil(y, m, 1) + day - 1
+        }
+        Rule::Julian1(n) => {
+            let mut k = n as i64 - 1;
+            if is_leap_year(y) && n >= 60 {
+                k += 1;
+            }
+            days_from_civil(y, 1, 1) + k
+        }
+        Rule::Zero(n) => days_from_civil(y, 1, 1) + n as i64,
+    };
+    day * 86_400 + time as i64
+}
+
+impl PosixTz {
+    fn offset_at(&self, t: i64) -> ZoneOffset {
+        let Some(dst) = &self.dst else {
+            return self.std.clone();
+        };
+        let std_off = self.std.utc_offset_secs as i64;
+        let dst_off = dst.offset.utc_offset_secs as i64;
+        let year = civil_from_days((t + std_off).div_euclid(86_400)).0;
+        let start = rule_local_secs(year, &dst.start, dst.start_time) - std_off;
+        let end = rule_local_secs(year, &dst.end, dst.end_time) - dst_off;
+        let in_dst = if start < end {
+            t >= start && t < end
+        } else {
+            !(t >= end && t < start)
+        };
+        if in_dst {
+            dst.offset.clone()
+        } else {
+            self.std.clone()
+        }
+    }
+}

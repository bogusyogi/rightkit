+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn dt(y: i64, mo: u32, d: u32, h: u32, mi: u32, s: u32) -> DateTime {
+        DateTime {
+            year: y,
+            month: mo,
+            day: d,
+            hour: h,
+            minute: mi,
+            second: s,
+            nanos: 0,
+            offset_secs: 0,
+        }
+    }
+
+    /// A TZif v2 file with no transitions and the given footer: the zone is the footer alone.
+    fn footer_only(footer: &str) -> Vec<u8> {
+        let mut v = Vec::new();
+        let header = |v: &mut Vec<u8>| {
+            v.extend_from_slice(b"TZif2");
+            v.extend_from_slice(&[0u8; 15]);
+            for n in [0u32, 0, 0, 0, 1, 4] {
+                v.extend_from_slice(&n.to_be_bytes());
+            }
+        };
+        let block = |v: &mut Vec<u8>| {
+            v.extend_from_slice(&0i32.to_be_bytes());
+            v.extend_from_slice(&[0, 0]);
+            v.extend_from_slice(b"UTC\0");
+        };
+        header(&mut v);
+        block(&mut v);
+        header(&mut v);
+        block(&mut v);
+        v.push(b'\n');
+        v.extend_from_slice(footer.as_bytes());
+        v.push(b'\n');
+        v
+    }
+
+    fn ny() -> TimeZone {
+        TimeZone::from_tzif("America/New_York", &footer_only("EST5EDT,M3.2.0,M11.1.0")).unwrap()
+    }
+
+    #[test]
+    fn us_eastern_dst_from_footer() {
+        let z = ny();
+        // 2026-01-15T12:00:00Z is winter.
+        let w = z.offset_at(1_768_478_400);
+        assert_eq!(
+            (w.utc_offset_secs, w.is_dst, w.abbreviation.as_str()),
+            (-18_000, false, "EST")
+        );
+        // 2026-07-15T12:00:00Z is summer.
+        let s = z.offset_at(1_784_116_800);
+        assert_eq!(
+            (s.utc_offset_secs, s.is_dst, s.abbreviation.as_str()),
+            (-14_400, true, "EDT")
+        );
+        // DST began 2026-03-08T07:00:00Z and ended 2026-11-01T06:00:00Z.
+        assert!(!z.offset_at(1_772_953_199).is_dst);
+        assert!(z.offset_at(1_772_953_200).is_dst);
+        assert!(z.offset_at(1_793_512_799).is_dst);
+        assert!(!z.offset_at(1_793_512_800).is_dst);
+    }
+
+    #[test]
+    fn southern_hemisphere_footer() {
+        let z = TimeZone::from_tzif(
+            "Australia/Sydney",
+            &footer_only("AEST-10AEDT,M10.1.0,M4.1.0/3"),
+        )
+        .unwrap();
+        // January is summer (DST) in Sydney, July is not.
+        assert!(z.offset_at(1_768_478_400).is_dst);
+        assert_eq!(z.offset_at(1_768_478_400).utc_offset_secs, 39_600);
+        assert!(!z.offset_at(1_784_116_800).is_dst);
+        assert_eq!(z.offset_at(1_784_116_800).utc_offset_secs, 36_000);
+    }
+
+    #[test]
+    fn local_resolution_gap_and_overlap() {
+        let z = ny();
+        // 2026-03-08 02:30 does not exist.
+        match z.resolve_local(&dt(2026, 3, 8, 2, 30, 0)).unwrap() {
+            LocalResolution::Gap {
+                with_pre_offset,
+                with_post_offset,
+            } => assert_eq!(with_pre_offset - with_post_offset, 3600),
+            other => panic!("{other:?}"),
+        }
+        // 2026-11-01 01:30 happens twice.
+        match z.resolve_local(&dt(2026, 11, 1, 1, 30, 0)).unwrap() {
+            LocalResolution::Ambiguous { earlier, later } => assert_eq!(later - earlier, 3600),
+            other => panic!("{other:?}"),
+        }
+        // An ordinary time maps to one instant that converts back.
+        let LocalResolution::Single(t) = z.resolve_local(&dt(2026, 6, 1, 9, 0, 0)).unwrap() else {
+            panic!("expected Single");
+        };
+        let back = z.to_datetime(t);
+        assert_eq!((back.hour, back.offset_secs), (9, -14_400));
+        assert!(z.resolve_local(&dt(2026, 2, 30, 0, 0, 0)).is_none());
+    }
+
+    #[test]
+    fn transition_table_before_footer() {
+        // One transition at t=1000 from type 0 (STD, +1h) to type 1 (DST, +2h), no footer.
+        let mut v = Vec::new();
+        v.extend_from_slice(b"TZif1");
+        v.extend_from_slice(&[0u8; 15]);
+        for n in [0u32, 0, 0, 1, 2, 8] {
+            v.extend_from_slice(&n.to_be_bytes());
+        }
+        v.extend_from_slice(&1000i32.to_be_bytes());
+        v.push(1);
+        v.extend_from_slice(&3600i32.to_be_bytes());
+        v.extend_from_slice(&[0, 0]);
+        v.extend_from_slice(&7200i32.to_be_bytes());
+        v.extend_from_slice(&[1, 4]);
+        v.extend_from_slice(b"STD\0DST\0");
+        let z = TimeZone::from_tzif("Test/Zone", &v).unwrap();
+        assert_eq!(z.offset_at(999).abbreviation, "STD");
+        assert_eq!(z.offset_at(1000).abbreviation, "DST");
+        assert_eq!(z.offset_at(i64::MAX / 2).abbreviation, "DST");
+    }
+
+    #[test]
+    fn rejects_bad_data_and_names() {
+        assert!(matches!(
+            TimeZone::from_tzif("x", b"nope"),
+            Err(TzError::Malformed(_))
+        ));
+        let mut cut = footer_only("EST5EDT,M3.2.0,M11.1.0");
+        cut.truncate(60);
+        assert!(TimeZone::from_tzif("x", &cut).is_err());
+        for bad in ["", "/etc/passwd", "../x", "a/../b", "a//b", "a\\b", "C:x"] {
+            assert_eq!(TimeZone::load(bad), Err(TzError::InvalidName), "{bad}");
+        }
+        assert_eq!(
+            TimeZone::load_from_dir(Path::new("."), "No/Such_Zone_Anywhere"),
+            Err(TzError::NotFound)
+        );
+    }
+
+    #[test]
+    fn utc_and_posix_parsing() {
+        let z = TimeZone::load("UTC").unwrap();
+        assert_eq!(z.offset_at(123).utc_offset_secs, 0);
+        assert_eq!(z.to_datetime(0).format_rfc3339(), "1970-01-01T00:00:00Z");
+        let p = parse_posix_tz("<+0530>-5:30").unwrap();
+        assert_eq!(p.std.utc_offset_secs, 19_800);
+        assert!(p.dst.is_none());
+        let p = parse_posix_tz("CET-1CEST,M3.5.0,M10.5.0/3").unwrap();
+        let d = p.dst.unwrap();
+        assert_eq!((d.offset.utc_offset_secs, d.end_time), (7200, 3 * 3600));
+        assert!(parse_posix_tz("EST5EDT").is_none());
+        assert!(parse_posix_tz("EST5EDT,M13.1.0,M11.1.0").is_none());
+    }
+
+    #[test]
+    #[cfg(unix)]
+    fn system_database_when_present() {
+        if let Ok(z) = TimeZone::load("America/New_York") {
+            let s = z.offset_at(1_784_116_800);
+            assert_eq!((s.utc_offset_secs, s.is_dst), (-14_400, true));
+            let w = z.offset_at(1_768_478_400);
+            assert_eq!((w.utc_offset_secs, w.is_dst), (-18_000, false));
+        }
+    }
+}

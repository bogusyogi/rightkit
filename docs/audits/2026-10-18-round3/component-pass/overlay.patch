+    /// Exclude `hwnd` from screenshots, recordings and screen shares, or include it again
+    /// (`SetWindowDisplayAffinity` with `WDA_EXCLUDEFROMCAPTURE`, #413). Needs Windows 10
+    /// version 2004 or later; returns `false` when the call fails (older Windows, a window of
+    /// another process, a bad handle).
+    pub fn exclude_from_capture(hwnd: isize, exclude: bool) -> bool {
+        if hwnd == 0 {
+            return false;
+        }
+        // SAFETY: SetWindowDisplayAffinity takes the handle and a flag value by value; a bad
+        // handle makes it fail.
+        unsafe { SetWindowDisplayAffinity(hwnd as HWND, crate::capture::windows_affinity(exclude)) != 0 }
+    }
+
+    /// Which window covers `hwnd` (#525): `Some("not_topmost")` when it lost `WS_EX_TOPMOST`,
+    /// otherwise the class name of the nearest window above it that is visible, not of this
+    /// process or `own_pids`, not cloaked and overlaps it; `None` when nothing covers it. Reads
+    /// at most [`MAX_COVERING_WALK`](crate::MAX_COVERING_WALK) windows above.
+    pub fn covering_window(hwnd: isize, own_pids: &[u32]) -> Option<String> {
+        if hwnd == 0 {
+            return Some("not_topmost".to_string());
+        }
+        const DWMWA_CLOAKED: u32 = 14;
+        unsafe {
+            let target = hwnd as HWND;
+            let topmost = GetWindowLongPtrW(target, GWL_EXSTYLE) as u32 & WS_EX_TOPMOST != 0;
+            let mut rect = RECT {
+                left: 0,
+                top: 0,
+                right: 0,
+                bottom: 0,
+            };
+            if GetWindowRect(target, &mut rect) == 0 {
+                return crate::covering_window(topmost, WorkArea {
+                    left: 0.0,
+                    top: 0.0,
+                    right: 0.0,
+                    bottom: 0.0,
+                }, &[]);
+            }
+            let overlay = area(rect);
+            let current_pid = std::process::id();
+            let mut above = Vec::new();
+            let mut walker = GetWindow(target, GW_HWNDPREV);
+            while !walker.is_null() && above.len() < crate::MAX_COVERING_WALK {
+                let mut pid = 0u32;
+                GetWindowThreadProcessId(walker, &mut pid);
+                let mut cloaked = 0u32;
+                let hr = DwmGetWindowAttribute(
+                    walker,
+                    DWMWA_CLOAKED,
+                    &mut cloaked as *mut u32 as *mut core::ffi::c_void,
+                    std::mem::size_of::<u32>() as u32,
+                );
+                let mut name = [0u16; 256];
+                let len = GetClassNameW(walker, name.as_mut_ptr(), name.len() as i32);
+                let mut wrect = RECT {
+                    left: 0,
+                    top: 0,
+                    right: 0,
+                    bottom: 0,
+                };
+                let have_rect = GetWindowRect(walker, &mut wrect) != 0;
+                above.push(crate::CoveringCandidate {
+                    class_name: String::from_utf16_lossy(&name[..len.max(0) as usize]),
+                    visible: IsWindowVisible(walker) != 0 && have_rect,
+                    own_process: crate::is_own_pid(pid, current_pid, own_pids),
+                    cloaked: hr >= 0 && cloaked != 0,
+                    rect: area(wrect),
+                });
+                walker = GetWindow(walker, GW_HWNDPREV);
+            }
+            crate::covering_window(topmost, overlay, &above)
+        }
+    }

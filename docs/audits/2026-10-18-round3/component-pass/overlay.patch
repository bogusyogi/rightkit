+/// Capture-exclusion values (#413): whether screenshots, recordings and screen shares can see a
+/// window. Plain numbers so the mapping is the same, and tested, on every OS.
+pub mod capture {
+    /// Windows `SetWindowDisplayAffinity`: no exclusion.
+    pub const WDA_NONE: u32 = 0x0000_0000;
+    /// Windows `WDA_EXCLUDEFROMCAPTURE` (Windows 10 2004 and later): the window is left out of
+    /// captures and shows as nothing in them.
+    pub const WDA_EXCLUDEFROMCAPTURE: u32 = 0x0000_0011;
+    /// macOS `NSWindow.SharingType.none` (`NSWindowSharingNone`): other processes cannot read
+    /// the window contents.
+    pub const NS_WINDOW_SHARING_NONE: u32 = 0;
+    /// macOS `NSWindow.SharingType.readOnly` (`NSWindowSharingReadOnly`), the default.
+    pub const NS_WINDOW_SHARING_READ_ONLY: u32 = 1;
+
+    /// The Windows display affinity for a window that is, or is not, excluded from capture.
+    pub fn windows_affinity(exclude: bool) -> u32 {
+        if exclude {
+            WDA_EXCLUDEFROMCAPTURE
+        } else {
+            WDA_NONE
+        }
+    }
+
+    /// The macOS `NSWindow.sharingType` raw value for a window that is, or is not, excluded.
+    pub fn macos_sharing_type(exclude: bool) -> u32 {
+        if exclude {
+            NS_WINDOW_SHARING_NONE
+        } else {
+            NS_WINDOW_SHARING_READ_ONLY
+        }
+    }
+}

+
+/// [`to_timing_json`] with sub-millisecond times. `precise` is parallel to the
+/// normalised words the cues index (see [`Cue::precise_span`]); a cue whose
+/// indices fall outside it keeps its millisecond span. Words are written with
+/// their exact seconds.
+pub fn to_timing_json_precise(cues: &[Cue], precise: &[crate::words::PreciseWord]) -> String {
+    let seg: Vec<serde_json::Value> = cues
+        .iter()
+        .map(|c| {
+            let (s, e) = c
+                .precise_span(precise)
+                .unwrap_or((c.start_secs(), c.end_secs()));
+            serde_json::json!({ "text": c.lines.join(" "), "start": s, "end": e })
+        })
+        .collect();
+    let w: Vec<serde_json::Value> = precise
+        .iter()
+        .map(|w| serde_json::json!({ "text": w.text, "start": w.start_s, "end": w.end_s }))
+        .collect();
+    serde_json::to_string(&serde_json::json!({ "segments": seg, "words": w }))
+        .expect("json serialises")
+}
+
+#[cfg(test)]
+mod precise_tests {
+    use super::*;
+    use crate::words::PreciseWord;
+
+    #[test]
+    fn precise_json_keeps_sub_ms_and_falls_back() {
+        let cue = Cue {
+            start_ms: 1000,
+            end_ms: 1251,
+            lines: vec!["hi".into()],
+            first_word: 0,
+            last_word: 0,
+        };
+        let p = [PreciseWord::new("hi", 1.0004, 1.2506)];
+        let out = to_timing_json_precise(&[cue.clone()], &p);
+        let v: serde_json::Value = serde_json::from_str(&out).unwrap();
+        assert_eq!(v["segments"][0]["start"], 1.0004);
+        assert_eq!(v["segments"][0]["end"], 1.2506);
+        let out = to_timing_json_precise(&[cue], &[]);
+        let v: serde_json::Value = serde_json::from_str(&out).unwrap();
+        assert_eq!(v["segments"][0]["start"], 1.0);
+        assert_eq!(v["segments"][0]["end"], 1.251);
+    }
+}

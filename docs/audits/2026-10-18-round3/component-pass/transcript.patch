+/// A word whose times keep sub-millisecond precision (seconds, `f64`).
+///
+/// [`TimedWord`] is integer milliseconds, so a conversion from engine seconds
+/// loses anything finer than 1 ms. Use this type when the exact engine times
+/// must survive to a precise timing export ([`crate::to_timing_json_precise`])
+/// or to [`crate::Cue::precise_span`]. Cue segmentation itself stays on
+/// [`TimedWord`]; convert with [`PreciseWord::to_timed_word`].
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct PreciseWord {
+    pub text: String,
+    pub start_s: f64,
+    pub end_s: f64,
+}
+
+impl PreciseWord {
+    /// Negative or non-finite times clamp to 0.
+    pub fn new(text: impl Into<String>, start_s: f64, end_s: f64) -> Self {
+        Self {
+            text: text.into(),
+            start_s: clamp_secs(start_s),
+            end_s: clamp_secs(end_s),
+        }
+    }
+
+    /// Exact lift of a millisecond word.
+    pub fn from_timed(word: &TimedWord) -> Self {
+        Self {
+            text: word.text.clone(),
+            start_s: word.start_secs(),
+            end_s: word.end_secs(),
+        }
+    }
+
+    /// Round to the nearest millisecond (the same rule as [`words_from_seconds`]).
+    pub fn to_timed_word(&self) -> TimedWord {
+        TimedWord::new(
+            self.text.clone(),
+            secs_f64_to_ms(self.start_s),
+            secs_f64_to_ms(self.end_s),
+        )
+    }
+}
+
+fn clamp_secs(s: f64) -> f64 {
+    if s.is_finite() && s > 0.0 {
+        s
+    } else {
+        0.0
+    }
+}
+
+fn secs_f64_to_ms(s: f64) -> u64 {
+    (clamp_secs(s) * 1000.0).round() as u64
+}
+
+/// Like [`words_from_seconds`] but keeps the exact `f64` seconds. Negative or
+/// non-finite times clamp to 0.
+pub fn precise_words_from_seconds<'a>(
+    items: impl IntoIterator<Item = (&'a str, f64, f64)>,
+) -> Vec<PreciseWord> {
+    items
+        .into_iter()
+        .map(|(t, s, e)| PreciseWord::new(t, s, e))
+        .collect()
+}
+
+/// Millisecond words lifted losslessly to [`PreciseWord`].
+pub fn precise_words_from_timed(words: &[TimedWord]) -> Vec<PreciseWord> {
+    words.iter().map(PreciseWord::from_timed).collect()
+}

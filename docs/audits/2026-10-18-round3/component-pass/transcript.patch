+/// Like [`parse_timing_json`] but keeps the exact seconds (no rounding to ms).
+pub fn parse_timing_json_precise(s: &str) -> Result<Vec<PreciseWord>, ParseError> {
+    let v: serde_json::Value =
+        serde_json::from_str(s).map_err(|e| ParseError::Json(e.to_string()))?;
+    let arr = v
+        .get("words")
+        .and_then(|w| w.as_array())
+        .ok_or_else(|| ParseError::Json("missing words array".into()))?;
+    let mut out = Vec::with_capacity(arr.len());
+    for w in arr {
+        let (Some(t), Some(s), Some(e)) = (
+            w.get("text").and_then(|t| t.as_str()),
+            w.get("start").and_then(|x| x.as_f64()),
+            w.get("end").and_then(|x| x.as_f64()),
+        ) else {
+            return Err(ParseError::Json("word needs text/start/end".into()));
+        };
+        out.push(PreciseWord::new(t, s, e));
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+mod precise_tests {
+    use super::*;
+
+    #[test]
+    fn precise_timing_json_keeps_sub_ms() {
+        let json = r#"{"words":[{"text":"a","start":0.0004,"end":1.2506}]}"#;
+        let w = parse_timing_json_precise(json).unwrap();
+        assert_eq!((w[0].start_s, w[0].end_s), (0.0004, 1.2506));
+        assert_eq!(parse_timing_json(json).unwrap()[0].end_ms, 1251);
+        assert!(parse_timing_json_precise("{}").is_err());
+    }
+}

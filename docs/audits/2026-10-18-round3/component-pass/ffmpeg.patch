+/// The filter chain behind [`FfmpegCommand::h264_compatible_input`]: `filters` (when not blank),
+/// then a pad to even width and height (`ceil(iw/2)*2` by `ceil(ih/2)*2`, black bars of at most
+/// one pixel).
+pub fn h264_compatible_filter(filters: Option<&str>) -> String {
+    const PAD: &str = "pad=ceil(iw/2)*2:ceil(ih/2)*2";
+    match filters.map(str::trim).filter(|f| !f.is_empty()) {
+        Some(f) => format!("{f},{PAD}"),
+        None => PAD.to_owned(),
+    }
+}
+
+/// Parse an FFmpeg time duration as the command line reads it, without a sign:
+/// `[HH:]MM:SS[.m...]` (for example `01:02:03.5`, `90:00`), or seconds with an optional fraction and
+/// an optional unit (`90`, `1.5`, `90s`, `1500ms`, `250000us`). Returns `None` for anything else:
+/// an empty string, whitespace anywhere, a leading `-` or `+`, an exponent, minutes or seconds of
+/// 60 or more in the clock form (except leading minutes in `MM:SS`), or a value that overflows.
+/// Precision is one microsecond; finer digits are dropped. Use it to validate a caller-supplied
+/// time before it is passed unchanged as `-ss` or `-t`.
+pub fn parse_time_duration(text: &str) -> Option<Duration> {
+    fn digits(s: &str) -> Option<u64> {
+        if s.is_empty() || !s.bytes().all(|b| b.is_ascii_digit()) {
+            return None;
+        }
+        s.parse().ok()
+    }
+    /// `(whole, millionths)` of an unsigned decimal such as `12` or `12.345`.
+    fn decimal(s: &str) -> Option<(u64, u64)> {
+        let (whole, frac) = match s.split_once('.') {
+            Some((w, f)) => (w, Some(f)),
+            None => (s, None),
+        };
+        let whole = digits(whole)?;
+        let micros = match frac {
+            None => 0,
+            Some(f) => {
+                if f.is_empty() || !f.bytes().all(|b| b.is_ascii_digit()) {
+                    return None;
+                }
+                let mut padded: String = f.chars().take(6).collect();
+                while padded.len() < 6 {
+                    padded.push('0');
+                }
+                padded.parse().ok()?
+            }
+        };
+        Some((whole, micros))
+    }
+    if text.is_empty() || text.bytes().any(|b| b.is_ascii_whitespace()) {
+        return None;
+    }
+    if text.contains(':') {
+        let parts: Vec<&str> = text.split(':').collect();
+        let (hours, minutes, seconds) = match parts.as_slice() {
+            [m, s] => (0, digits(m)?, *s),
+            [h, m, s] => {
+                let minutes = digits(m)?;
+                if minutes >= 60 {
+                    return None;
+                }
+                (digits(h)?, minutes, *s)
+            }
+            _ => return None,
+        };
+        let (whole, micros) = decimal(seconds)?;
+        if whole >= 60 {
+            return None;
+        }
+        let total_secs = hours
+            .checked_mul(3600)?
+            .checked_add(minutes.checked_mul(60)?)?
+            .checked_add(whole)?;
+        return Some(Duration::new(total_secs, (micros * 1000) as u32));
+    }
+    let (number, unit_micros): (&str, u64) = if let Some(n) = text.strip_suffix("ms") {
+        (n, 1_000)
+    } else if let Some(n) = text.strip_suffix("us") {
+        (n, 1)
+    } else if let Some(n) = text.strip_suffix('s') {
+        (n, 1_000_000)
+    } else {
+        (text, 1_000_000)
+    };
+    let (whole, micros) = decimal(number)?;
+    // `micros` is millionths of the unit; convert to microseconds of the result.
+    let total = whole
+        .checked_mul(unit_micros)?
+        .checked_add(micros * unit_micros / 1_000_000)?;
+    Some(Duration::from_micros(total))
+}

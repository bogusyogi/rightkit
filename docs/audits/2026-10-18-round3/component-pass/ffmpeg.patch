+    #[test]
+    fn h264_compatible_input_pads_to_even_dimensions_and_sets_yuv420p() {
+        let mut cmd = FfmpegCommand::new();
+        cmd.h264_compatible_input();
+        assert_eq!(
+            texts(&cmd),
+            [
+                "-vf",
+                "pad=ceil(iw/2)*2:ceil(ih/2)*2",
+                "-pix_fmt",
+                "yuv420p"
+            ]
+        );
+        let mut chained = FfmpegCommand::new();
+        chained.h264_compatible_input_with(Some(" scale=641:361 "));
+        assert_eq!(
+            texts(&chained)[1],
+            "scale=641:361,pad=ceil(iw/2)*2:ceil(ih/2)*2"
+        );
+        assert_eq!(
+            h264_compatible_filter(Some("  ")),
+            "pad=ceil(iw/2)*2:ceil(ih/2)*2"
+        );
+    }
+
+    #[test]
+    fn parse_time_duration_reads_the_ffmpeg_grammar() {
+        let d = |text| parse_time_duration(text);
+        assert_eq!(d("90"), Some(Duration::from_secs(90)));
+        assert_eq!(d("1.5"), Some(Duration::from_millis(1_500)));
+        assert_eq!(d("90s"), Some(Duration::from_secs(90)));
+        assert_eq!(d("1500ms"), Some(Duration::from_millis(1_500)));
+        assert_eq!(d("1.5ms"), Some(Duration::from_micros(1_500)));
+        assert_eq!(d("250000us"), Some(Duration::from_millis(250)));
+        assert_eq!(d("00:01:02.5"), Some(Duration::from_millis(62_500)));
+        assert_eq!(d("1:02:03"), Some(Duration::from_secs(3_723)));
+        assert_eq!(d("90:30"), Some(Duration::from_secs(5_430)));
+        assert_eq!(d("0.1234567"), Some(Duration::from_micros(123_456)));
+    }
+
+    #[test]
+    fn parse_time_duration_refuses_everything_else() {
+        for bad in [
+            "", " 1", "1 ", "-1", "+1", "1e3", "1.", ".5", "abc", "1:2:3:4", "1:60:00", "00:61",
+            "1:2:3x", "ms", "s", "1.5.2", "99999999999999999999",
+        ] {
+            assert_eq!(parse_time_duration(bad), None, "{bad:?}");
+        }
+    }
 }

index 0000000..31ccadf
--- /dev/null
+++ b/crates/rightkit-search/src/grep.rs
@@ -0,0 +1,912 @@
+//! Budgeted, resumable regex content search over a caller-supplied list of workspace files
+//! (feature `workspace-grep`; Orthic-Labs/rightkit#580).
+//!
+//! [`grep_page`] runs one page of a search: a regex over the lines of each file, in the three
+//! shapes of a code-search tool ([`GrepMode`]), within a [`GrepBudget`] (results, bytes per
+//! file and per page, files per page, deadline) and a [`CancelToken`]. The page ends with a
+//! [`GrepStatus`], and when more remains, a [`GrepCursor`] that resumes exactly there. The
+//! cursor is bound to the root and to the search (pattern, case, mode, context, glob) by a
+//! SHA-256 digest, so a cursor from another search or workspace is refused, not silently
+//! applied. Budgets are not part of the binding: a caller may change them between pages.
+//!
+//! **The file list is the caller's.** This module does not walk the directory tree and does not
+//! read `.gitignore`: the ignore-aware walk is a separate owner (Orthic-Labs/rightkit#417).
+//! Pass the workspace-relative, `/`-separated paths that walk produced. Paths are validated
+//! (no absolute path, no `..`), symbolic links are skipped, and files that are over the byte
+//! budget, contain a NUL byte in their first 8 KiB, or cannot be read are counted in
+//! [`GrepPage::files_skipped`] and not searched. Lines are split like [`str::lines`]; invalid
+//! UTF-8 is replaced, not refused.
+
+use regex::RegexBuilder;
+use sha2::{Digest, Sha256};
+use std::fmt;
+use std::fs;
+use std::io;
+use std::path::{Component, Path};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::time::Instant;
+
+/// A clonable cancellation flag. Clones share one flag; [`CancelToken::cancel`] on any clone
+/// stops a running [`grep_page`] at its next check (at least once per file and every 4096 lines).
+#[derive(Debug, Clone, Default)]
+pub struct CancelToken(Arc<AtomicBool>);
+
+impl CancelToken {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn cancel(&self) {
+        self.0.store(true, Ordering::Relaxed);
+    }
+
+    pub fn is_cancelled(&self) -> bool {
+        self.0.load(Ordering::Relaxed)
+    }
+}
+
+/// What a search returns for each file that matches.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum GrepMode {
+    /// Each matching line, with `context` lines around it.
+    Content,
+    /// The path of each file with at least one match.
+    FilesWithMatches,
+    /// The number of matching lines of each file with at least one match.
+    Count,
+}
+
+impl GrepMode {
+    fn tag(self) -> &'static str {
+        match self {
+            Self::Content => "content",
+            Self::FilesWithMatches => "files",
+            Self::Count => "count",
+        }
+    }
+}
+
+/// Per-page limits. Every field has a default from [`GrepBudget::default`].
+#[derive(Debug, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct GrepBudget {
+    /// Results per page (a match line, a file or a count each count one).
+    pub max_results: usize,
+    /// Files larger than this are skipped, not searched.
+    pub max_file_bytes: u64,
+    /// Bytes of result text per page (match lines and context, and paths); the page ends
+    /// before the result that would pass it, but always holds at least one result.
+    pub max_page_bytes: usize,
+    /// Files opened per page.
+    pub max_files: usize,
+    /// The page ends with [`GrepStatus::Deadline`] once this instant has passed.
+    pub deadline: Option<Instant>,
+}
+
+impl Default for GrepBudget {
+    fn default() -> Self {
+        Self {
+            max_results: 200,
+            max_file_bytes: 2 * 1024 * 1024,
+            max_page_bytes: 256 * 1024,
+            max_files: 5_000,
+            deadline: None,
+        }
+    }
+}
+
+/// How a page ended.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum GrepStatus {
+    /// Every file was searched; `next` is `None`.
+    Complete,
+    /// A budget (results, bytes or files) ended the page; `next` resumes.
+    Truncated,
+    /// The [`CancelToken`] was set; `next` resumes.
+    Cancelled,
+    /// The deadline passed; `next` resumes.
+    Deadline,
+}
+
+/// One search request. Build with [`GrepRequest::new`] and the `with_*` methods.
+#[derive(Debug, Clone)]
+#[non_exhaustive]
+pub struct GrepRequest {
+    pub pattern: String,
+    pub case_sensitive: bool,
+    pub mode: GrepMode,
+    /// Lines of context before and after each match ([`GrepMode::Content`] only).
+    pub context: usize,
+    /// Optional path filter: `*` (not `/`), `**` (anything), `?`. A glob without `/` matches the
+    /// file name; one with `/` matches the whole relative path.
+    pub glob: Option<String>,
+    pub budget: GrepBudget,
+    pub cursor: Option<GrepCursor>,
+}
+
+impl GrepRequest {
+    /// A case-sensitive [`GrepMode::Content`] search for `pattern` with no context.
+    pub fn new(pattern: &str) -> Self {
+        Self {
+            pattern: pattern.to_owned(),
+            case_sensitive: true,
+            mode: GrepMode::Content,
+            context: 0,
+            glob: None,
+            budget: GrepBudget::default(),
+            cursor: None,
+        }
+    }
+
+    pub fn with_case_sensitive(mut self, on: bool) -> Self {
+        self.case_sensitive = on;
+        self
+    }
+
+    pub fn with_mode(mut self, mode: GrepMode) -> Self {
+        self.mode = mode;
+        self
+    }
+
+    pub fn with_context(mut self, lines: usize) -> Self {
+        self.context = lines;
+        self
+    }
+
+    pub fn with_glob(mut self, glob: &str) -> Self {
+        self.glob = Some(glob.to_owned());
+        self
+    }
+
+    pub fn with_budget(mut self, budget: GrepBudget) -> Self {
+        self.budget = budget;
+        self
+    }
+
+    pub fn with_cursor(mut self, cursor: GrepCursor) -> Self {
+        self.cursor = Some(cursor);
+        self
+    }
+}
+
+/// One result of a page.
+#[derive(Debug, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum GrepResult {
+    Match {
+        path: String,
+        /// 1-based line number.
+        line: u64,
+        text: String,
+        before: Vec<String>,
+        after: Vec<String>,
+    },
+    File {
+        path: String,
+    },
+    Count {
+        path: String,
+        count: u64,
+    },
+}
+
+/// One page of results.
+#[derive(Debug, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct GrepPage {
+    pub results: Vec<GrepResult>,
+    pub status: GrepStatus,
+    /// Resume point; `None` exactly when `status` is [`GrepStatus::Complete`].
+    pub next: Option<GrepCursor>,
+    /// Files opened and searched on this page.
+    pub files_scanned: usize,
+    /// Files skipped on this page: over the byte budget, binary, a symbolic link or unreadable.
+    pub files_skipped: usize,
+}
+
+/// Failure to run a search.
+#[derive(Debug)]
+#[non_exhaustive]
+pub enum GrepError {
+    /// The pattern is not a valid regex (or is over the size limit).
+    Pattern(String),
+    /// The glob is empty, too long or has too many wildcards.
+    Glob(String),
+    /// The cursor text is not a cursor.
+    BadCursor,
+    /// The cursor belongs to a different root or search.
+    CursorMismatch,
+    /// A file path that is absolute or contains `..` or a non-normal component.
+    UnsafePath(String),
+}
+
+impl fmt::Display for GrepError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Pattern(e) => write!(f, "invalid pattern: {e}"),
+            Self::Glob(e) => write!(f, "invalid glob: {e}"),
+            Self::BadCursor => write!(f, "malformed grep cursor"),
+            Self::CursorMismatch => write!(f, "cursor belongs to a different root or search"),
+            Self::UnsafePath(p) => write!(f, "unsafe workspace path: {p:?}"),
+        }
+    }
+}
+
+impl std::error::Error for GrepError {}
+
+/// Resume point of a search, bound to its root and parameters by a SHA-256 digest.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct GrepCursor {
+    binding: [u8; 32],
+    /// Resume in this file...
+    path: String,
+    /// ...after this 1-based line (0 = from the start of the file).
+    line: u64,
+}
+
+impl GrepCursor {
+    /// Text form: `g1.<binding hex>.<line>.<path hex>`.
+    pub fn encode(&self) -> String {
+        format!(
+            "g1.{}.{}.{}",
+            hex(&self.binding),
+            self.line,
+            hex(self.path.as_bytes())
+        )
+    }
+
+    /// Inverse of [`GrepCursor::encode`]. Whether the cursor fits a search is checked by
+    /// [`grep_page`].
+    pub fn decode(text: &str) -> Result<Self, GrepError> {
+        let mut parts = text.splitn(4, '.');
+        if parts.next() != Some("g1") {
+            return Err(GrepError::BadCursor);
+        }
+        let binding_hex = parts.next().ok_or(GrepError::BadCursor)?;
+        let line = parts
+            .next()
+            .and_then(|l| l.parse::<u64>().ok())
+            .ok_or(GrepError::BadCursor)?;
+        let path_hex = parts.next().ok_or(GrepError::BadCursor)?;
+        let binding_bytes = unhex(binding_hex).ok_or(GrepError::BadCursor)?;
+        let binding: [u8; 32] = binding_bytes.try_into().map_err(|_| GrepError::BadCursor)?;
+        let path = String::from_utf8(unhex(path_hex).ok_or(GrepError::BadCursor)?)
+            .map_err(|_| GrepError::BadCursor)?;
+        Ok(Self {
+            binding,
+            path,
+            line,
+        })
+    }
+
+    /// The workspace-relative path the search resumes in.
+    pub fn path(&self) -> &str {
+        &self.path
+    }
+}
+
+fn hex(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for b in bytes {
+        out.push_str(&format!("{b:02x}"));
+    }
+    out
+}
+
+fn unhex(text: &str) -> Option<Vec<u8>> {
+    if text.len() % 2 != 0 || !text.is_ascii() {
+        return None;
+    }
+    (0..text.len() / 2)
+        .map(|i| u8::from_str_radix(&text[i * 2..i * 2 + 2], 16).ok())
+        .collect()
+}
+
+fn binding(root: &Path, req: &GrepRequest) -> [u8; 32] {
+    let mut hasher = Sha256::new();
+    let mut field = |bytes: &[u8]| {
+        hasher.update((bytes.len() as u64).to_le_bytes());
+        hasher.update(bytes);
+    };
+    field(b"rightkit-search/grep/1");
+    field(root.to_string_lossy().as_bytes());
+    field(req.pattern.as_bytes());
+    field(&[u8::from(req.case_sensitive)]);
+    field(req.mode.tag().as_bytes());
+    field(&(req.context as u64).to_le_bytes());
+    field(req.glob.as_deref().unwrap_or("").as_bytes());
+    hasher.finalize().into()
+}
+
+const MAX_GLOB_LEN: usize = 256;
+const MAX_GLOB_STARS: usize = 8;
+
+fn check_glob(glob: &str) -> Result<(), GrepError> {
+    if glob.is_empty() || glob.len() > MAX_GLOB_LEN {
+        return Err(GrepError::Glob("empty or longer than 256 bytes".to_owned()));
+    }
+    if glob.chars().filter(|c| *c == '*').count() > MAX_GLOB_STARS {
+        return Err(GrepError::Glob("more than 8 wildcards".to_owned()));
+    }
+    Ok(())
+}
+
+fn glob_match(pattern: &[char], text: &[char]) -> bool {
+    match pattern.first() {
+        None => text.is_empty(),
+        Some('*') => {
+            if pattern.get(1) == Some(&'*') {
+                let rest = &pattern[2..];
+                if rest.first() == Some(&'/') && glob_match(&rest[1..], text) {
+                    return true;
+                }
+                (0..=text.len()).any(|i| glob_match(rest, &text[i..]))
+            } else {
+                let rest = &pattern[1..];
+                let mut i = 0;
+                loop {
+                    if glob_match(rest, &text[i..]) {
+                        return true;
+                    }
+                    if i < text.len() && text[i] != '/' {
+                        i += 1;
+                    } else {
+                        return false;
+                    }
+                }
+            }
+        }
+        Some('?') => {
+            matches!(text.first(), Some(c) if *c != '/') && glob_match(&pattern[1..], &text[1..])
+        }
+        Some(c) => text.first() == Some(c) && glob_match(&pattern[1..], &text[1..]),
+    }
+}
+
+fn matches_glob(glob: &[char], has_slash: bool, path: &str) -> bool {
+    let target = if has_slash {
+        path
+    } else {
+        path.rsplit('/').next().unwrap_or(path)
+    };
+    let text: Vec<char> = target.chars().collect();
+    glob_match(glob, &text)
+}
+
+fn check_path(path: &str) -> Result<(), GrepError> {
+    let p = Path::new(path);
+    let ok = !path.is_empty()
+        && !path.contains('\\')
+        && p.components().all(|c| matches!(c, Component::Normal(_)));
+    if ok {
+        Ok(())
+    } else {
+        Err(GrepError::UnsafePath(path.to_owned()))
+    }
+}
+
+/// How often the line loop checks the cancel token and deadline.
+const CHECK_EVERY_LINES: usize = 4096;
+
+/// Runs one page of a search over `files` (workspace-relative, `/`-separated paths) under
+/// `root`. The list is sorted and de-duplicated here, so the order of the input does not
+/// matter, but the same set must be passed for every page of one search: a cursor resumes at
+/// the first listed path at or after the one it names.
+///
+/// # Errors
+///
+/// [`GrepError::Pattern`] / [`GrepError::Glob`] for a bad request, [`GrepError::BadCursor`] /
+/// [`GrepError::CursorMismatch`] for a cursor that is not this search's, and
+/// [`GrepError::UnsafePath`] for a path in `files` that escapes the root. Per-file read
+/// failures are not errors: the file is counted in `files_skipped`.
+pub fn grep_page(
+    root: &Path,
+    files: &[String],
+    request: &GrepRequest,
+    cancel: &CancelToken,
+) -> Result<GrepPage, GrepError> {
+    let regex = RegexBuilder::new(&request.pattern)
+        .case_insensitive(!request.case_sensitive)
+        .size_limit(10 * 1024 * 1024)
+        .build()
+        .map_err(|e| GrepError::Pattern(e.to_string()))?;
+    let glob: Option<(Vec<char>, bool)> = match &request.glob {
+        Some(g) => {
+            check_glob(g)?;
+            Some((g.chars().collect(), g.contains('/')))
+        }
+        None => None,
+    };
+    let bind = binding(root, request);
+    let (resume_path, resume_line) = match &request.cursor {
+        Some(c) if c.binding != bind => return Err(GrepError::CursorMismatch),
+        Some(c) => (Some(c.path.as_str()), c.line),
+        None => (None, 0),
+    };
+
+    let mut sorted: Vec<&str> = files.iter().map(String::as_str).collect();
+    for path in &sorted {
+        check_path(path)?;
+    }
+    sorted.sort_unstable();
+    sorted.dedup();
+    let start = resume_path.map_or(0, |p| sorted.partition_point(|f| *f < p));
+
+    let budget = &request.budget;
+    let max_results = budget.max_results.max(1);
+    let cursor_at = |path: &str, line: u64| GrepCursor {
+        binding: bind,
+        path: path.to_owned(),
+        line,
+    };
+    let mut page = GrepPage {
+        results: Vec::new(),
+        status: GrepStatus::Complete,
+        next: None,
+        files_scanned: 0,
+        files_skipped: 0,
+    };
+    let mut page_bytes = 0usize;
+    let mut opened = 0usize;
+
+    for path in &sorted[start..] {
+        // A cursor only resumes mid-file in the file it names.
+        let skip_to = if resume_path == Some(*path) {
+            resume_line
+        } else {
+            0
+        };
+        if let Some((g, slash)) = &glob {
+            if !matches_glob(g, *slash, path) {
+                continue;
+            }
+        }
+        if cancel.is_cancelled() {
+            return Ok(stop(page, GrepStatus::Cancelled, cursor_at(path, skip_to)));
+        }
+        if budget.deadline.is_some_and(|d| Instant::now() >= d) {
+            return Ok(stop(page, GrepStatus::Deadline, cursor_at(path, skip_to)));
+        }
+        if opened >= budget.max_files.max(1) {
+            return Ok(stop(page, GrepStatus::Truncated, cursor_at(path, skip_to)));
+        }
+        let full = root.join(path);
+        let text = match read_searchable(&full, budget.max_file_bytes) {
+            Some(text) => text,
+            None => {
+                page.files_skipped += 1;
+                continue;
+            }
+        };
+        opened += 1;
+        page.files_scanned += 1;
+
+        let lines: Vec<&str> = text.lines().collect();
+        let mut count = 0u64;
+        let mut last_emitted = skip_to;
+        for (i, line) in lines.iter().enumerate() {
+            if i % CHECK_EVERY_LINES == CHECK_EVERY_LINES - 1 {
+                if cancel.is_cancelled() {
+                    return Ok(stop(
+                        page,
+                        GrepStatus::Cancelled,
+                        cursor_at(path, last_emitted),
+                    ));
+                }
+                if budget.deadline.is_some_and(|d| Instant::now() >= d) {
+                    return Ok(stop(
+                        page,
+                        GrepStatus::Deadline,
+                        cursor_at(path, last_emitted),
+                    ));
+                }
+            }
+            let number = i as u64 + 1;
+            if number <= skip_to || !regex.is_match(line) {
+                continue;
+            }
+            count += 1;
+            if request.mode != GrepMode::Content {
+                continue;
+            }
+            let before: Vec<String> = lines[i.saturating_sub(request.context)..i]
+                .iter()
+                .map(|l| (*l).to_owned())
+                .collect();
+            let after_end = lines
+                .len()
+                .min(i.saturating_add(1).saturating_add(request.context));
+            let after: Vec<String> = lines[i + 1..after_end]
+                .iter()
+                .map(|l| (*l).to_owned())
+                .collect();
+            let size = path.len()
+                + line.len()
+                + before
+                    .iter()
+                    .chain(after.iter())
+                    .map(String::len)
+                    .sum::<usize>();
+            let full_page = page.results.len() >= max_results
+                || (!page.results.is_empty() && page_bytes + size > budget.max_page_bytes);
+            if full_page {
+                return Ok(stop(
+                    page,
+                    GrepStatus::Truncated,
+                    cursor_at(path, last_emitted),
+                ));
+            }
+            page_bytes += size;
+            last_emitted = number;
+            page.results.push(GrepResult::Match {
+                path: (*path).to_owned(),
+                line: number,
+                text: (*line).to_owned(),
+                before,
+                after,
+            });
+        }
+        if request.mode != GrepMode::Content && count > 0 {
+            let size = path.len();
+            let full_page = page.results.len() >= max_results
+                || (!page.results.is_empty() && page_bytes + size > budget.max_page_bytes);
+            if full_page {
+                return Ok(stop(page, GrepStatus::Truncated, cursor_at(path, 0)));
+            }
+            page_bytes += size;
+            page.results.push(match request.mode {
+                GrepMode::Count => GrepResult::Count {
+                    path: (*path).to_owned(),
+                    count,
+                },
+                _ => GrepResult::File {
+                    path: (*path).to_owned(),
+                },
+            });
+        }
+    }
+    Ok(page)
+}
+
+fn stop(mut page: GrepPage, status: GrepStatus, next: GrepCursor) -> GrepPage {
+    page.status = status;
+    page.next = Some(next);
+    page
+}
+
+/// The text of a regular, non-link, non-binary file within the byte budget, else `None`.
+fn read_searchable(path: &Path, max_bytes: u64) -> Option<String> {
+    let meta = fs::symlink_metadata(path).ok()?;
+    if !meta.is_file() || meta.len() > max_bytes {
+        return None;
+    }
+    let bytes = read_bounded(path, max_bytes).ok()?;
+    let head = &bytes[..bytes.len().min(8192)];
+    if head.contains(&0) {
+        return None;
+    }
+    Some(String::from_utf8_lossy(&bytes).into_owned())
+}
+
+/// Reads at most `max_bytes + 1` bytes, so a file that grew after the metadata check is still
+/// bounded; one that grew past the budget is refused.
+fn read_bounded(path: &Path, max_bytes: u64) -> io::Result<Vec<u8>> {
+    use io::Read;
+    let mut buf = Vec::new();
+    fs::File::open(path)?
+        .take(max_bytes.saturating_add(1))
+        .read_to_end(&mut buf)?;
+    if buf.len() as u64 > max_bytes {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "file over budget",
+        ));
+    }
+    Ok(buf)
+}
+

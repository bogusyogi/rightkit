+    pub fn upsert(&mut self, key: &str, vector: &[f32]) -> Result<(), VectorError> {
+        validate(vector, self.dimension)?;
+        let (codes, scale, norm) = quantise(vector);
+        match self.keys.binary_search_by(|probe| probe.as_str().cmp(key)) {

+/// `i8` codes, the scale (`absmax / 127`, 0 for an all-zero row) and the norm of the
+/// dequantised row, for one already validated vector.
+fn quantise(vector: &[f32]) -> (Vec<i8>, f32, f64) {
+    let absmax = vector
+        .iter()
+        .fold(0.0_f32, |max, value| max.max(value.abs()));
+    let scale = absmax / 127.0;
+    if scale > 0.0 {
+        let mut sum_squares = 0.0_f64;
+        let codes: Vec<i8> = vector
+            .iter()
+            .map(|value| {
+                let code = (value / scale).round().clamp(-127.0, 127.0) as i8;
+                sum_squares += f64::from(code) * f64::from(code);
+                code
+            })
+            .collect();
+        (codes, scale, f64::from(scale) * sum_squares.sqrt())
+    } else {
+        (vec![0; vector.len()], scale, 0.0)
+    }
+}

index 0000000..bff9606
--- /dev/null
+++ b/crates/rightkit-search/src/html.rs
@@ -0,0 +1,280 @@
+//! HTML to plain text for indexing and snippets (MailRight `fts_text.rs`): tags are dropped,
+//! `script`, `style`, `head` and comment contents are skipped, block elements and `<br>`
+//! become line breaks, character references are decoded and whitespace is collapsed.
+//!
+//! This is a text extractor, not a sanitiser and not a renderer: its output is plain text
+//! and must never be treated as safe HTML. Malformed markup never fails; an unterminated
+//! tag or comment ends the output at that point.
+
+/// Elements whose whole content is dropped.
+const SKIPPED: [&str; 4] = ["script", "style", "head", "template"];
+
+/// Elements that end a line when they open or close.
+const BLOCK: [&str; 27] = [
+    "p",
+    "div",
+    "br",
+    "hr",
+    "li",
+    "ul",
+    "ol",
+    "tr",
+    "table",
+    "h1",
+    "h2",
+    "h3",
+    "h4",
+    "h5",
+    "h6",
+    "blockquote",
+    "pre",
+    "section",
+    "article",
+    "header",
+    "footer",
+    "nav",
+    "aside",
+    "dl",
+    "dt",
+    "dd",
+    "address",
+];
+
+/// Converts `html` to plain text. Runs of spaces and tabs become one space, each line is
+/// trimmed, more than one blank line in a row becomes one, and the result is trimmed.
+pub fn html_to_text(html: &str) -> String {
+    let lower = html.to_ascii_lowercase();
+    let bytes = html.as_bytes();
+    let mut raw = String::with_capacity(html.len());
+    let mut i = 0usize;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'<' => {
+                let rest = &lower[i..];
+                if rest.starts_with("<!--") {
+                    match rest[4..].find("-->") {
+                        Some(end) => i += 4 + end + 3,
+                        None => break,
+                    }
+                    continue;
+                }
+                let next = bytes.get(i + 1).copied().unwrap_or(0);
+                if !(next.is_ascii_alphabetic() || next == b'/' || next == b'!' || next == b'?') {
+                    raw.push('<');
+                    i += 1;
+                    continue;
+                }
+                let Some(end) = tag_end(bytes, i + 1) else {
+                    break;
+                };
+                let tag = &lower[i + 1..end];
+                let closing = tag.starts_with('/');
+                let name: String = tag
+                    .trim_start_matches('/')
+                    .chars()
+                    .take_while(|c| c.is_ascii_alphanumeric())
+                    .collect();
+                i = end + 1;
+                if !closing && !tag.ends_with('/') && SKIPPED.contains(&name.as_str()) {
+                    let close = format!("</{name}");
+                    match lower[i..].find(&close) {
+                        Some(at) => {
+                            let from = i + at;
+                            i = match tag_end(bytes, from + 1) {
+                                Some(e) => e + 1,
+                                None => bytes.len(),
+                            };
+                        }
+                        None => break,
+                    }
+                } else if BLOCK.contains(&name.as_str()) {
+                    raw.push('\n');
+                } else if name == "td" || name == "th" {
+                    raw.push(' ');
+                }
+            }
+            b'&' => {
+                let (decoded, used) = decode_reference(&html[i..]);
+                raw.push_str(&decoded);
+                i += used;
+            }
+            _ => {
+                // Copy a run of ordinary text in one step (boundaries are ASCII, so valid UTF-8).
+                let start = i;
+                while i < bytes.len() && bytes[i] != b'<' && bytes[i] != b'&' {
+                    i += 1;
+                }
+                raw.push_str(&html[start..i]);
+            }
+        }
+    }
+    collapse(&raw)
+}
+
+/// Index of the `>` that closes the tag whose content starts at `from`, skipping quoted
+/// attribute values.
+fn tag_end(bytes: &[u8], from: usize) -> Option<usize> {
+    let mut quote: Option<u8> = None;
+    for (offset, &b) in bytes.get(from..)?.iter().enumerate() {
+        match quote {
+            Some(q) if b == q => quote = None,
+            Some(_) => {}
+            None if b == b'"' || b == b'\'' => quote = Some(b),
+            None if b == b'>' => return Some(from + offset),
+            None => {}
+        }
+    }
+    None
+}
+
+/// Decodes the character reference at the start of `s` (which begins with `&`). Returns the
+/// text and the bytes consumed; an unknown or malformed reference is kept literally (one byte
+/// consumed, the `&` itself).
+fn decode_reference(s: &str) -> (String, usize) {
+    let end = match s.char_indices().take(12).find(|(_, c)| *c == ';') {
+        Some((at, _)) => at,
+        None => return ("&".to_owned(), 1),
+    };
+    let name = &s[1..end];
+    let used = end + 1;
+    if let Some(num) = name.strip_prefix('#') {
+        let code = match num.strip_prefix('x').or_else(|| num.strip_prefix('X')) {
+            Some(hex) => u32::from_str_radix(hex, 16).ok(),
+            None => num.parse::<u32>().ok(),
+        };
+        let Some(code) = code else {
+            return ("&".to_owned(), 1);
+        };
+        return match char::from_u32(code) {
+            Some('\u{a0}') => (" ".to_owned(), used),
+            Some(c) if c != '\0' => (c.to_string(), used),
+            _ => ("\u{fffd}".to_owned(), used),
+        };
+    }
+    let text = match name {
+        "amp" => "&",
+        "lt" => "<",
+        "gt" => ">",
+        "quot" => "\"",
+        "apos" => "'",
+        "nbsp" => " ",
+        "copy" => "\u{a9}",
+        "reg" => "\u{ae}",
+        "trade" => "\u{2122}",
+        "hellip" => "\u{2026}",
+        "mdash" => "\u{2014}",
+        "ndash" => "\u{2013}",
+        "lsquo" => "\u{2018}",
+        "rsquo" => "\u{2019}",
+        "ldquo" => "\u{201c}",
+        "rdquo" => "\u{201d}",
+        "bull" => "\u{2022}",
+        "middot" => "\u{b7}",
+        "euro" => "\u{20ac}",
+        "pound" => "\u{a3}",
+        "yen" => "\u{a5}",
+        "cent" => "\u{a2}",
+        "deg" => "\u{b0}",
+        "times" => "\u{d7}",
+        _ => return ("&".to_owned(), 1),
+    };
+    (text.to_owned(), used)
+}
+
+fn collapse(raw: &str) -> String {
+    let mut out = String::with_capacity(raw.len());
+    let mut blank_run = 0usize;
+    for line in raw.split('\n') {
+        let mut cleaned = String::with_capacity(line.len());
+        let mut space = false;
+        for c in line.chars() {
+            if c.is_whitespace() || c == '\u{200b}' {
+                space = true;
+            } else {
+                if space && !cleaned.is_empty() {
+                    cleaned.push(' ');
+                }
+                space = false;
+                cleaned.push(c);
+            }
+        }
+        if cleaned.is_empty() {
+            blank_run += 1;
+            continue;
+        }
+        if !out.is_empty() {
+            out.push('\n');
+            if blank_run > 0 {
+                out.push('\n');
+            }
+        }
+        blank_run = 0;
+        out.push_str(&cleaned);
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::html_to_text;
+
+    #[test]
+    fn tags_drop_and_blocks_break_lines() {
+        assert_eq!(
+            html_to_text("<p>Hello <b>big</b> world</p><p>Second</p>"),
+            "Hello big world\n\nSecond"
+        );
+        assert_eq!(html_to_text("a<br>b<br/>c"), "a\nb\nc");
+        assert_eq!(html_to_text("<td>x</td><td>y</td>"), "x y");
+    }
+
+    #[test]
+    fn script_style_head_and_comments_are_skipped() {
+        let html = "<html><head><title>T</title><style>p{color:red}</style></head>\
+                    <body><!-- hidden -->Visible<script>var a = '<b>';</script> text</body></html>";
+        assert_eq!(html_to_text(html), "Visible text");
+        assert_eq!(html_to_text("<SCRIPT>x</SCRIPT>after"), "after");
+    }
+
+    #[test]
+    fn references_are_decoded() {
+        assert_eq!(
+            html_to_text("a&amp;b &lt;c&gt; &quot;d&quot; &#65;&#x42;"),
+            "a&b <c> \"d\" AB"
+        );
+        assert_eq!(html_to_text("x&nbsp;&nbsp;y"), "x y");
+        assert_eq!(
+            html_to_text("R&D & more &unknown; &#xZZ;"),
+            "R&D & more &unknown; &#xZZ;"
+        );
+        assert_eq!(html_to_text("&#0;"), "\u{fffd}");
+    }
+
+    #[test]
+    fn quoted_attributes_may_hold_a_greater_than() {
+        assert_eq!(html_to_text("<a title=\"1 > 0\">link</a>"), "link");
+    }
+
+    #[test]
+    fn stray_less_than_is_text_and_unterminated_markup_stops() {
+        assert_eq!(html_to_text("1 < 2 and 3 > 2"), "1 < 2 and 3 > 2");
+        assert_eq!(html_to_text("kept <div class=\"never closed"), "kept");
+        assert_eq!(html_to_text("kept <!-- never closed"), "kept");
+        assert_eq!(html_to_text("kept<script>never closed"), "kept");
+    }
+
+    #[test]
+    fn whitespace_collapses_and_blank_lines_reduce_to_one() {
+        assert_eq!(html_to_text("  a \t\t b  \n\n\n\n c  "), "a b\n\nc");
+        assert_eq!(html_to_text(""), "");
+        assert_eq!(html_to_text("<div></div>"), "");
+    }
+
+    #[test]
+    fn multibyte_text_survives() {
+        assert_eq!(
+            html_to_text("<p>caf\u{e9} \u{65e5}\u{672c}</p>&euro;"),
+            "caf\u{e9} \u{65e5}\u{672c}\n\u{20ac}"
+        );
+    }
+}

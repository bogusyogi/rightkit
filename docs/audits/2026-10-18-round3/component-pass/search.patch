@@ -0,0 +1,297 @@
+//! In-memory Okapi BM25 ranking over documents the caller holds, for result sets that
+//! SQLite's FTS5 `bm25()` cannot rank (several sources, non-FTS rows, re-ranking a short
+//! list). For FTS5 tables use [`crate::fts5`], which ranks inside SQLite.
+//!
+//! Text is folded with [`crate::fold::fold`] and split into runs of alphanumeric characters;
+//! the same [`tokenize`] is used for documents and queries. A query scores a document by the
+//! sum over its distinct terms of `idf * tf * (k1 + 1) / (tf + k1 * (1 - b + b * len / avglen))`,
+//! with `idf = ln(1 + (N - n + 0.5) / (n + 0.5))`, which is never negative.
+
+use crate::fold::fold;
+use std::collections::{HashMap, HashSet};
+use std::hash::Hash;
+
+/// Splits `text` into folded terms: maximal runs of alphanumeric characters, case-folded by
+/// [`fold`]. Punctuation and whitespace separate terms and are dropped.
+pub fn tokenize(text: &str) -> Vec<String> {
+    let folded = fold(text);
+    folded
+        .split(|c: char| !c.is_alphanumeric())
+        .filter(|t| !t.is_empty())
+        .map(str::to_owned)
+        .collect()
+}
+
+/// BM25 tuning constants.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Bm25Params {
+    /// Term-frequency saturation, 0 or more. Default 1.2.
+    pub k1: f64,
+    /// Length normalisation, 0 to 1. Default 0.75.
+    pub b: f64,
+}
+
+impl Default for Bm25Params {
+    fn default() -> Self {
+        Self { k1: 1.2, b: 0.75 }
+    }
+}
+
+impl Bm25Params {
+    /// A non-finite or negative `k1` becomes the default; `b` is clamped to 0..=1 and a
+    /// non-finite `b` becomes the default.
+    pub fn new(k1: f64, b: f64) -> Self {
+        let d = Self::default();
+        Self {
+            k1: if k1.is_finite() && k1 >= 0.0 {
+                k1
+            } else {
+                d.k1
+            },
+            b: if b.is_finite() {
+                b.clamp(0.0, 1.0)
+            } else {
+                d.b
+            },
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+struct Doc {
+    len: u32,
+    /// Distinct terms, to remove the document from the postings.
+    terms: Vec<String>,
+}
+
+/// An in-memory BM25 index keyed by `K`. Inserting an existing key replaces the document.
+#[derive(Debug, Clone)]
+pub struct Bm25Index<K: Eq + Hash + Clone + Ord> {
+    params: Bm25Params,
+    docs: HashMap<K, Doc>,
+    /// term -> (document key -> term frequency)
+    postings: HashMap<String, HashMap<K, u32>>,
+    total_len: u64,
+}
+
+impl<K: Eq + Hash + Clone + Ord> Default for Bm25Index<K> {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl<K: Eq + Hash + Clone + Ord> Bm25Index<K> {
+    pub fn new() -> Self {
+        Self::with_params(Bm25Params::default())
+    }
+
+    pub fn with_params(params: Bm25Params) -> Self {
+        Self {
+            params: Bm25Params::new(params.k1, params.b),
+            docs: HashMap::new(),
+            postings: HashMap::new(),
+            total_len: 0,
+        }
+    }
+
+    pub fn params(&self) -> Bm25Params {
+        self.params
+    }
+
+    /// Number of documents.
+    pub fn len(&self) -> usize {
+        self.docs.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.docs.is_empty()
+    }
+
+    pub fn contains(&self, key: &K) -> bool {
+        self.docs.contains_key(key)
+    }
+
+    /// Indexes `text` under `key`, replacing any earlier document with that key.
+    pub fn insert(&mut self, key: K, text: &str) {
+        self.insert_tokens(key, tokenize(text));
+    }
+
+    /// Indexes already-tokenised terms (for a caller with its own tokenizer; query terms
+    /// are still produced by [`tokenize`], so fold terms the same way).
+    pub fn insert_tokens(&mut self, key: K, tokens: Vec<String>) {
+        self.remove(&key);
+        let len = u32::try_from(tokens.len()).unwrap_or(u32::MAX);
+        let mut freq: HashMap<String, u32> = HashMap::new();
+        for token in tokens {
+            *freq.entry(token).or_insert(0) += 1;
+        }
+        let mut terms = Vec::with_capacity(freq.len());
+        for (term, tf) in freq {
+            self.postings
+                .entry(term.clone())
+                .or_default()
+                .insert(key.clone(), tf);
+            terms.push(term);
+        }
+        self.total_len += u64::from(len);
+        self.docs.insert(key, Doc { len, terms });
+    }
+
+    /// Removes a document; true when it was present.
+    pub fn remove(&mut self, key: &K) -> bool {
+        let Some(doc) = self.docs.remove(key) else {
+            return false;
+        };
+        self.total_len -= u64::from(doc.len);
+        for term in doc.terms {
+            if let Some(posting) = self.postings.get_mut(&term) {
+                posting.remove(key);
+                if posting.is_empty() {
+                    self.postings.remove(&term);
+                }
+            }
+        }
+        true
+    }
+
+    /// The score of `key` for `query`, or `None` when the document is absent. A document
+    /// that shares no term with the query scores 0.
+    pub fn score(&self, query: &str, key: &K) -> Option<f64> {
+        let doc = self.docs.get(key)?;
+        let avg = self.average_len();
+        let mut total = 0.0;
+        for term in distinct(tokenize(query)) {
+            if let Some(tf) = self.postings.get(&term).and_then(|p| p.get(key)) {
+                total += self.term_score(&term, *tf, doc.len, avg);
+            }
+        }
+        Some(total)
+    }
+
+    /// The `limit` best documents for `query`, best first, ties by key. Only documents that
+    /// share at least one term with the query are returned.
+    pub fn search(&self, query: &str, limit: usize) -> Vec<(K, f64)> {
+        if limit == 0 || self.docs.is_empty() {
+            return Vec::new();
+        }
+        let avg = self.average_len();
+        let mut scores: HashMap<&K, f64> = HashMap::new();
+        for term in distinct(tokenize(query)) {
+            let Some(posting) = self.postings.get(&term) else {
+                continue;
+            };
+            for (key, tf) in posting {
+                let len = self.docs.get(key).map_or(0, |d| d.len);
+                *scores.entry(key).or_insert(0.0) += self.term_score(&term, *tf, len, avg);
+            }
+        }
+        let mut ranked: Vec<(K, f64)> = scores.into_iter().map(|(k, s)| (k.clone(), s)).collect();
+        ranked.sort_by(|a, b| b.1.total_cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+        ranked.truncate(limit);
+        ranked
+    }
+
+    fn average_len(&self) -> f64 {
+        if self.docs.is_empty() {
+            0.0
+        } else {
+            self.total_len as f64 / self.docs.len() as f64
+        }
+    }
+
+    fn term_score(&self, term: &str, tf: u32, doc_len: u32, avg_len: f64) -> f64 {
+        let n = self.postings.get(term).map_or(0, HashMap::len) as f64;
+        let total = self.docs.len() as f64;
+        let idf = (1.0 + (total - n + 0.5) / (n + 0.5)).ln();
+        let tf = f64::from(tf);
+        let norm = if avg_len > 0.0 {
+            1.0 - self.params.b + self.params.b * f64::from(doc_len) / avg_len
+        } else {
+            1.0
+        };
+        idf * tf * (self.params.k1 + 1.0) / (tf + self.params.k1 * norm)
+    }
+}
+
+fn distinct(tokens: Vec<String>) -> Vec<String> {
+    let mut seen = HashSet::new();
+    tokens
+        .into_iter()
+        .filter(|t| seen.insert(t.clone()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tokenize_folds_and_splits_on_non_alphanumerics() {
+        assert_eq!(
+            tokenize("Hello, World! foo_bar-9"),
+            vec!["hello", "world", "foo", "bar", "9"]
+        );
+        assert!(tokenize("  ...  ").is_empty());
+        assert_eq!(tokenize("Stra\u{df}e"), vec!["strasse"]);
+    }
+
+    #[test]
+    fn rarer_terms_and_higher_frequency_rank_first() {
+        let mut index = Bm25Index::new();
+        index.insert(1u32, "rust rust rust language");
+        index.insert(2, "rust language guide");
+        index.insert(3, "garden guide");
+        let hits = index.search("rust", 10);
+        let keys: Vec<u32> = hits.iter().map(|h| h.0).collect();
+        assert_eq!(keys, vec![1, 2]);
+        assert!(hits[0].1 > hits[1].1 && hits[1].1 > 0.0);
+        // "rust" is in two documents of three, "garden" in one: the rarer term scores higher.
+        let garden = index.score("garden", &3).unwrap();
+        let guide = index.score("guide", &3).unwrap();
+        assert!(garden > guide);
+    }
+
+    #[test]
+    fn shorter_documents_win_at_equal_frequency() {
+        let mut index = Bm25Index::new();
+        index.insert("long", "needle a b c d e f g h i j k l m n o p");
+        index.insert("short", "needle a");
+        let hits = index.search("needle", 2);
+        assert_eq!(hits[0].0, "short");
+    }
+
+    #[test]
+    fn replace_and_remove_keep_the_statistics_consistent() {
+        let mut index = Bm25Index::new();
+        index.insert(1u32, "alpha beta");
+        index.insert(1, "gamma");
+        assert_eq!(index.len(), 1);
+        assert!(index.search("alpha", 5).is_empty());
+        assert_eq!(index.search("gamma", 5).len(), 1);
+        assert!(index.remove(&1));
+        assert!(!index.remove(&1));
+        assert!(index.is_empty());
+        assert!(index.search("gamma", 5).is_empty());
+        assert_eq!(index.score("gamma", &1), None);
+    }
+
+    #[test]
+    fn ties_order_by_key_and_limits_are_honoured() {
+        let mut index = Bm25Index::new();
+        index.insert(2u32, "same text");
+        index.insert(1, "same text");
+        index.insert(3, "same text");
+        let keys: Vec<u32> = index.search("same", 2).into_iter().map(|h| h.0).collect();
+        assert_eq!(keys, vec![1, 2]);
+        assert!(index.search("same", 0).is_empty());
+        assert!(index.search("", 5).is_empty());
+    }
+
+    #[test]
+    fn params_are_sanitised() {
+        let p = Bm25Params::new(f64::NAN, 7.0);
+        assert_eq!(p.k1, 1.2);
+        assert_eq!(p.b, 1.0);
+        assert_eq!(Bm25Params::new(-1.0, f64::INFINITY), Bm25Params::default());
+    }
+}

+        assert_eq!(page.status, GrepStatus::Deadline);
+        assert!(page.results.is_empty());
+        assert!(page.next.is_some());
+
+        let cancel = CancelToken::new();
+        cancel.clone().cancel();
+        let page = grep_page(dir.path(), &files(), &GrepRequest::new("TODO"), &cancel).unwrap();
+        assert_eq!(page.status, GrepStatus::Cancelled);
+        assert!(page.next.is_some());
+    }
+
+    #[test]
+    fn cursor_is_bound_to_root_and_search() {
+        let dir = workspace();
+        let other = workspace();
+        let cancel = CancelToken::new();
+        let budget = GrepBudget {
+            max_results: 1,
+            ..GrepBudget::default()
+        };
+        let req = GrepRequest::new("TODO").with_budget(budget.clone());
+        let cursor = grep_page(dir.path(), &files(), &req, &cancel)
+            .unwrap()
+            .next
+            .unwrap();
+        let other_pattern = GrepRequest::new("TODOS")
+            .with_budget(budget.clone())
+            .with_cursor(cursor.clone());
+        assert!(matches!(
+            grep_page(dir.path(), &files(), &other_pattern, &cancel),
+            Err(GrepError::CursorMismatch)
+        ));
+        let same = GrepRequest::new("TODO")
+            .with_budget(budget)
+            .with_cursor(cursor);
+        assert!(matches!(
+            grep_page(other.path(), &files(), &same, &cancel),
+            Err(GrepError::CursorMismatch)
+        ));
+        assert!(matches!(
+            GrepCursor::decode("nonsense"),
+            Err(GrepError::BadCursor)
+        ));
+        assert!(matches!(
+            GrepCursor::decode("g1.zz.0.00"),
+            Err(GrepError::BadCursor)
+        ));
+    }
+
+    #[test]
+    fn unsafe_paths_bad_patterns_and_oversize_files_are_handled() {
+        let dir = workspace();
+        let cancel = CancelToken::new();
+        for bad in ["../x", "/abs", "a/../b", "", "a\\b"] {
+            let list = vec![bad.to_owned()];
+            assert!(
+                matches!(
+                    grep_page(dir.path(), &list, &GrepRequest::new("x"), &cancel),
+                    Err(GrepError::UnsafePath(_))
+                ),
+                "{bad}"
+            );
+        }
+        assert!(matches!(
+            grep_page(dir.path(), &files(), &GrepRequest::new("("), &cancel),
+            Err(GrepError::Pattern(_))
+        ));
+        let budget = GrepBudget {
+            max_file_bytes: 10,
+            ..GrepBudget::default()
+        };
+        let req = GrepRequest::new("TODO").with_budget(budget);
+        let page = grep_page(dir.path(), &files(), &req, &cancel).unwrap();
+        // Every file is over 10 bytes, so every file is skipped.
+        assert!(page.results.is_empty());
+        assert_eq!(page.files_scanned, 0);
+    }
+
+    #[test]
+    fn glob_matcher_cases() {
+        let m = |g: &str, t: &str| {
+            let g: Vec<char> = g.chars().collect();
+            let t: Vec<char> = t.chars().collect();
+            glob_match(&g, &t)
+        };
+        assert!(m("*.rs", "main.rs"));
+        assert!(!m("*.rs", "src/main.rs"));
+        assert!(m("**/*.rs", "src/deep/main.rs"));
+        assert!(m("**/*.rs", "main.rs"));
+        assert!(m("src/**", "src/a/b"));
+        assert!(m("a?c", "abc"));
+        assert!(!m("a?c", "a/c"));
+    }
+}
diff --git a/crates/rightkit-search/src/html.rs b/crates/rightkit-search/src/html.rs

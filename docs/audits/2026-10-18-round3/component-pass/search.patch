@@ -0,0 +1,637 @@
+//! FTS5 index management and BM25 ranking inside SQLite (feature `sqlite`).
+//!
+//! [`crate::sql::Schema`] compiles a query to a `MATCH` predicate; this module owns the other
+//! half: creating the FTS5 table, keeping it in step with the rows it indexes, rebuilding and
+//! checking it, and ranking hits with SQLite's built-in `bm25()`.
+//!
+//! Three layouts are supported by [`Fts5Table`]:
+//!
+//! - **Own content** (default): the FTS table stores the text. Write with
+//!   [`Fts5Table::index_row`] and [`Fts5Table::remove_row`].
+//! - **External content** ([`Fts5Table::external_content`]): the FTS table is a projection of
+//!   columns of a source table and stores no text of its own. [`Fts5Table::ensure`] also creates
+//!   the three triggers that keep it in step with the source, so writes go to the source table.
+//! - **Contentless** ([`Fts5Table::contentless`]): only the index is stored. Deleting a row
+//!   needs SQLite 3.43 or later and [`Fts5Table::contentless_delete`].
+//!
+//! Every name that reaches SQL is checked as a plain identifier (ASCII letters, digits and
+//! underscore, not starting with a digit) and the tokenizer spec is restricted to letters,
+//! digits, spaces, `_` and `=`, so no caller string can add SQL. Values and the `MATCH`
+//! expression are always bound parameters.
+
+use rusqlite::{Connection, ToSql};
+use std::fmt;
+
+/// Failure to build or run an FTS5 statement.
+#[derive(Debug)]
+#[non_exhaustive]
+pub enum Fts5Error {
+    /// A table, column or rowid name that is not a plain identifier.
+    InvalidIdentifier(String),
+    /// A tokenizer spec with a character outside letters, digits, space, `_` and `=`.
+    InvalidTokenizer(String),
+    /// The table has no columns.
+    NoColumns,
+    /// A row with the wrong number of values, or a weight list of the wrong length.
+    ColumnCount {
+        expected: usize,
+        got: usize,
+    },
+    /// A BM25 weight that is not a finite number.
+    InvalidWeight,
+    /// The operation does not apply to this layout (for example writing the FTS table
+    /// directly when it is an external-content projection).
+    Unsupported(&'static str),
+    Sqlite(rusqlite::Error),
+}
+
+impl fmt::Display for Fts5Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidIdentifier(name) => write!(f, "not a plain SQL identifier: {name:?}"),
+            Self::InvalidTokenizer(spec) => write!(f, "unsupported tokenizer spec: {spec:?}"),
+            Self::NoColumns => write!(f, "FTS5 table has no columns"),
+            Self::ColumnCount { expected, got } => {
+                write!(f, "expected {expected} values, got {got}")
+            }
+            Self::InvalidWeight => write!(f, "BM25 weight is not finite"),
+            Self::Unsupported(why) => write!(f, "unsupported: {why}"),
+            Self::Sqlite(e) => write!(f, "SQLite: {e}"),
+        }
+    }
+}
+
+impl std::error::Error for Fts5Error {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Sqlite(e) => Some(e),
+            _ => None,
+        }
+    }
+}
+
+impl From<rusqlite::Error> for Fts5Error {
+    fn from(e: rusqlite::Error) -> Self {
+        Self::Sqlite(e)
+    }
+}
+
+fn check_ident(name: &str) -> Result<(), Fts5Error> {
+    let mut chars = name.chars();
+    let ok = match chars.next() {
+        Some(c) => {
+            (c.is_ascii_alphabetic() || c == '_')
+                && chars.all(|c| c.is_ascii_alphanumeric() || c == '_')
+        }
+        None => false,
+    };
+    if ok {
+        Ok(())
+    } else {
+        Err(Fts5Error::InvalidIdentifier(name.to_owned()))
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Content {
+    Own,
+    External { table: String, rowid: String },
+    Contentless,
+}
+
+/// One ranked hit: the FTS rowid and a score where higher is better (the negation of
+/// SQLite's `bm25()`, which is lower for better matches).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Fts5Hit {
+    pub rowid: i64,
+    pub score: f64,
+}
+
+/// Definition of one FTS5 table. See the module documentation for the layouts.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Fts5Table {
+    name: String,
+    columns: Vec<String>,
+    tokenizer: Option<String>,
+    prefixes: Vec<u32>,
+    content: Content,
+    contentless_delete: bool,
+}
+
+impl Fts5Table {
+    /// An own-content table named `name` with `columns`.
+    pub fn new(name: &str, columns: &[&str]) -> Result<Self, Fts5Error> {
+        check_ident(name)?;
+        if columns.is_empty() {
+            return Err(Fts5Error::NoColumns);
+        }
+        for column in columns {
+            check_ident(column)?;
+        }
+        Ok(Self {
+            name: name.to_owned(),
+            columns: columns.iter().map(|c| (*c).to_owned()).collect(),
+            tokenizer: None,
+            prefixes: Vec::new(),
+            content: Content::Own,
+            contentless_delete: false,
+        })
+    }
+
+    /// Sets the tokenizer spec, for example `unicode61 remove_diacritics 2` or
+    /// `porter unicode61`. Only letters, digits, spaces, `_` and `=` are accepted.
+    pub fn tokenizer(mut self, spec: &str) -> Result<Self, Fts5Error> {
+        let ok = !spec.trim().is_empty()
+            && spec
+                .chars()
+                .all(|c| c.is_ascii_alphanumeric() || matches!(c, ' ' | '_' | '='));
+        if !ok {
+            return Err(Fts5Error::InvalidTokenizer(spec.to_owned()));
+        }
+        self.tokenizer = Some(spec.trim().to_owned());
+        Ok(self)
+    }
+
+    /// Prefix index lengths (`prefix='2 3'`), so `ab*` queries do not scan the term list.
+    pub fn prefixes(mut self, lengths: &[u32]) -> Self {
+        self.prefixes = lengths.iter().copied().filter(|n| *n > 0).collect();
+        self
+    }
+
+    /// Makes the table a projection of `table`: it stores no text, reads it back from `table`
+    /// by `rowid_column`, and `ensure` creates triggers that mirror inserts, updates and
+    /// deletes. The FTS column names must be columns of `table`.
+    pub fn external_content(mut self, table: &str, rowid_column: &str) -> Result<Self, Fts5Error> {
+        check_ident(table)?;
+        check_ident(rowid_column)?;
+        self.content = Content::External {
+            table: table.to_owned(),
+            rowid: rowid_column.to_owned(),
+        };
+        Ok(self)
+    }
+
+    /// Makes the table contentless: only the index is kept, snippets and column reads are
+    /// unavailable.
+    pub fn contentless(mut self) -> Self {
+        self.content = Content::Contentless;
+        self
+    }
+
+    /// For a contentless table, allows `DELETE` and `UPDATE` (`contentless_delete=1`,
+    /// SQLite 3.43 or later).
+    pub fn contentless_delete(mut self, on: bool) -> Self {
+        self.contentless_delete = on;
+        self
+    }
+
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    pub fn columns(&self) -> &[String] {
+        &self.columns
+    }
+
+    /// `CREATE VIRTUAL TABLE IF NOT EXISTS ...`.
+    pub fn create_sql(&self) -> String {
+        let mut parts: Vec<String> = self.columns.clone();
+        if let Some(spec) = &self.tokenizer {
+            parts.push(format!("tokenize = '{spec}'"));
+        }
+        if !self.prefixes.is_empty() {
+            let list: Vec<String> = self.prefixes.iter().map(u32::to_string).collect();
+            parts.push(format!("prefix = '{}'", list.join(" ")));
+        }
+        match &self.content {
+            Content::Own => {}
+            Content::External { table, rowid } => {
+                parts.push(format!("content = '{table}'"));
+                parts.push(format!("content_rowid = '{rowid}'"));
+            }
+            Content::Contentless => {
+                parts.push("content = ''".to_owned());
+                if self.contentless_delete {
+                    parts.push("contentless_delete = 1".to_owned());
+                }
+            }
+        }
+        format!(
+            "CREATE VIRTUAL TABLE IF NOT EXISTS {} USING fts5({})",
+            self.name,
+            parts.join(", ")
+        )
+    }
+
+    /// The three `CREATE TRIGGER IF NOT EXISTS` statements that keep an external-content
+    /// table in step with its source table; empty for the other layouts.
+    pub fn trigger_sql(&self) -> Vec<String> {
+        let Content::External { table, rowid } = &self.content else {
+            return Vec::new();
+        };
+        let name = &self.name;
+        let cols = self.columns.join(", ");
+        let new_vals: Vec<String> = self.columns.iter().map(|c| format!("new.{c}")).collect();
+        let old_vals: Vec<String> = self.columns.iter().map(|c| format!("old.{c}")).collect();
+        let new_vals = new_vals.join(", ");
+        let old_vals = old_vals.join(", ");
+        let insert = format!("INSERT INTO {name}(rowid, {cols}) VALUES (new.{rowid}, {new_vals});");
+        let delete = format!(
+            "INSERT INTO {name}({name}, rowid, {cols}) VALUES ('delete', old.{rowid}, {old_vals});"
+        );
+        vec![
+            format!("CREATE TRIGGER IF NOT EXISTS {name}_ai AFTER INSERT ON {table} BEGIN {insert} END"),
+            format!("CREATE TRIGGER IF NOT EXISTS {name}_ad AFTER DELETE ON {table} BEGIN {delete} END"),
+            format!(
+                "CREATE TRIGGER IF NOT EXISTS {name}_au AFTER UPDATE ON {table} BEGIN {delete} {insert} END"
+            ),
+        ]
+    }
+
+    /// Creates the table and, for external content, its triggers. Safe to call at every start.
+    /// It does not index rows that already exist in the source; call [`Fts5Table::rebuild`]
+    /// once after creating a projection over a populated table.
+    pub fn ensure(&self, conn: &Connection) -> Result<(), Fts5Error> {
+        conn.execute_batch(&self.create_sql())?;
+        for sql in self.trigger_sql() {
+            conn.execute_batch(&sql)?;
+        }
+        Ok(())
+    }
+
+    /// True when the table exists in the main database.
+    pub fn exists(&self, conn: &Connection) -> Result<bool, Fts5Error> {
+        let n: i64 = conn.query_row(
+            "SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = ?1",
+            [&self.name],
+            |row| row.get(0),
+        )?;
+        Ok(n > 0)
+    }
+
+    /// Drops the triggers and the table.
+    pub fn drop_table(&self, conn: &Connection) -> Result<(), Fts5Error> {
+        let name = &self.name;
+        conn.execute_batch(&format!(
+            "DROP TRIGGER IF EXISTS {name}_ai; DROP TRIGGER IF EXISTS {name}_ad; \
+             DROP TRIGGER IF EXISTS {name}_au; DROP TABLE IF EXISTS {name};"
+        ))?;
+        Ok(())
+    }
+
+    /// Re-reads the source rows and rebuilds the whole index (`'rebuild'`). For an own-content
+    /// table it rebuilds from the stored text. Not available for a contentless table.
+    pub fn rebuild(&self, conn: &Connection) -> Result<(), Fts5Error> {
+        if self.content == Content::Contentless {
+            return Err(Fts5Error::Unsupported(
+                "a contentless table cannot be rebuilt",
+            ));
+        }
+        self.command(conn, "rebuild")
+    }
+
+    /// Merges the index segments (`'optimize'`).
+    pub fn optimize(&self, conn: &Connection) -> Result<(), Fts5Error> {
+        self.command(conn, "optimize")
+    }
+
+    /// Runs `'integrity-check'`. For an external-content projection it also compares the
+    /// index with the source table. A mismatch is an `Err(Fts5Error::Sqlite(..))`.
+    pub fn integrity_check(&self, conn: &Connection) -> Result<(), Fts5Error> {
+        let rank = i64::from(matches!(self.content, Content::External { .. }));
+        conn.execute(
+            &format!(
+                "INSERT INTO {0}({0}, rank) VALUES ('integrity-check', ?1)",
+                self.name
+            ),
+            [rank],
+        )?;
+        Ok(())
+    }
+
+    fn command(&self, conn: &Connection, command: &str) -> Result<(), Fts5Error> {
+        conn.execute_batch(&format!(
+            "INSERT INTO {0}({0}) VALUES ('{command}')",
+            self.name
+        ))?;
+        Ok(())
+    }
+
+    /// Inserts or replaces the row `rowid` of an own-content table (or inserts into a
+    /// contentless one). `values` pair with the columns by position.
+    pub fn index_row(
+        &self,
+        conn: &Connection,
+        rowid: i64,
+        values: &[&str],
+    ) -> Result<(), Fts5Error> {
+        self.writable()?;
+        if values.len() != self.columns.len() {
+            return Err(Fts5Error::ColumnCount {
+                expected: self.columns.len(),
+                got: values.len(),
+            });
+        }
+        if self.content == Content::Own || self.contentless_delete {
+            conn.execute(
+                &format!("DELETE FROM {} WHERE rowid = ?1", self.name),
+                [rowid],
+            )?;
+        }
+        let marks: Vec<String> = (2..=values.len() + 1).map(|i| format!("?{i}")).collect();
+        let sql = format!(
+            "INSERT INTO {}(rowid, {}) VALUES (?1, {})",
+            self.name,
+            self.columns.join(", "),
+            marks.join(", ")
+        );
+        let mut params: Vec<&dyn ToSql> = Vec::with_capacity(values.len() + 1);
+        params.push(&rowid);
+        for value in values {
+            params.push(value);
+        }
+        conn.execute(&sql, rusqlite::params_from_iter(params))?;
+        Ok(())
+    }
+
+    /// Removes the row `rowid` from an own-content table, or from a contentless table created
+    /// with [`Fts5Table::contentless_delete`]. Returns true when a row was removed.
+    pub fn remove_row(&self, conn: &Connection, rowid: i64) -> Result<bool, Fts5Error> {
+        self.writable()?;
+        if self.content == Content::Contentless && !self.contentless_delete {
+            return Err(Fts5Error::Unsupported(
+                "deleting from a contentless table needs contentless_delete",
+            ));
+        }
+        let n = conn.execute(
+            &format!("DELETE FROM {} WHERE rowid = ?1", self.name),
+            [rowid],
+        )?;
+        Ok(n > 0)
+    }
+
+    fn writable(&self) -> Result<(), Fts5Error> {
+        match self.content {
+            Content::External { .. } => Err(Fts5Error::Unsupported(
+                "write to the source table; its triggers update the projection",
+            )),
+            _ => Ok(()),
+        }
+    }
+
+    /// The SQL expression `bm25(table, w1, w2, ...)`, one weight per column in order (a
+    /// larger weight makes that column count more). `None` weights every column 1.
+    /// SQLite's `bm25()` is lower for better matches, so order ascending.
+    pub fn bm25_expr(&self, weights: Option<&[f64]>) -> Result<String, Fts5Error> {
+        let Some(weights) = weights else {
+            return Ok(format!("bm25({})", self.name));
+        };
+        if weights.len() != self.columns.len() {
+            return Err(Fts5Error::ColumnCount {
+                expected: self.columns.len(),
+                got: weights.len(),
+            });
+        }
+        if weights.iter().any(|w| !w.is_finite()) {
+            return Err(Fts5Error::InvalidWeight);
+        }
+        let list: Vec<String> = weights.iter().map(|w| format!("{w:?}")).collect();
+        Ok(format!("bm25({}, {})", self.name, list.join(", ")))
+    }
+
+    /// `SELECT rowid, <bm25> AS score FROM t WHERE t MATCH ?1 ORDER BY score LIMIT ?2`.
+    pub fn ranked_sql(&self, weights: Option<&[f64]>) -> Result<String, Fts5Error> {
+        Ok(format!(
+            "SELECT rowid, {} AS score FROM {} WHERE {} MATCH ?1 ORDER BY score, rowid LIMIT ?2",
+            self.bm25_expr(weights)?,
+            self.name,
+            self.name
+        ))
+    }
+
+    /// Runs `match_expr` (for example from [`crate::terms::Query::fts`]) and returns the best
+    /// `limit` rows, best first, ties by rowid. `Fts5Hit::score` is higher for better matches.
+    pub fn search(
+        &self,
+        conn: &Connection,
+        match_expr: &str,
+        weights: Option<&[f64]>,
+        limit: usize,
+    ) -> Result<Vec<Fts5Hit>, Fts5Error> {
+        if limit == 0 {
+            return Ok(Vec::new());
+        }
+        let sql = self.ranked_sql(weights)?;
+        let mut stmt = conn.prepare(&sql)?;
+        let limit = i64::try_from(limit).unwrap_or(i64::MAX);
+        let rows = stmt.query_map(rusqlite::params![match_expr, limit], |row| {
+            Ok(Fts5Hit {
+                rowid: row.get(0)?,
+                score: -row.get::<_, f64>(1)?,
+            })
+        })?;
+        let mut hits = Vec::new();
+        for row in rows {
+            hits.push(row?);
+        }
+        Ok(hits)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn identifiers_and_tokenizers_are_validated() {
+        assert!(matches!(
+            Fts5Table::new("bad name", &["a"]),
+            Err(Fts5Error::InvalidIdentifier(_))
+        ));
+        assert!(matches!(
+            Fts5Table::new("t", &["a; DROP TABLE x"]),
+            Err(Fts5Error::InvalidIdentifier(_))
+        ));
+        assert!(matches!(
+            Fts5Table::new("t", &[]),
+            Err(Fts5Error::NoColumns)
+        ));
+        let t = Fts5Table::new("t", &["a"]).unwrap();
+        assert!(matches!(
+            t.clone().tokenizer("unicode61'); DROP TABLE x; --"),
+            Err(Fts5Error::InvalidTokenizer(_))
+        ));
+        assert!(t.tokenizer("porter unicode61 remove_diacritics 2").is_ok());
+    }
+
+    #[test]
+    fn create_sql_covers_each_layout() {
+        let own = Fts5Table::new("msg_fts", &["subject", "body"])
+            .unwrap()
+            .tokenizer("unicode61 remove_diacritics 2")
+            .unwrap()
+            .prefixes(&[2, 3]);
+        assert_eq!(
+            own.create_sql(),
+            "CREATE VIRTUAL TABLE IF NOT EXISTS msg_fts USING fts5(subject, body, \
+             tokenize = 'unicode61 remove_diacritics 2', prefix = '2 3')"
+        );
+        let ext = Fts5Table::new("msg_fts", &["subject"])
+            .unwrap()
+            .external_content("messages", "id")
+            .unwrap();
+        assert!(ext
+            .create_sql()
+            .ends_with("content = 'messages', content_rowid = 'id')"));
+        assert_eq!(ext.trigger_sql().len(), 3);
+        assert!(own.trigger_sql().is_empty());
+        let none = Fts5Table::new("c", &["a"])
+            .unwrap()
+            .contentless()
+            .contentless_delete(true);
+        assert!(none
+            .create_sql()
+            .ends_with("content = '', contentless_delete = 1)"));
+    }
+
+    #[test]
+    fn own_content_index_search_and_remove() {
+        let conn = Connection::open_in_memory().unwrap();
+        let t = Fts5Table::new("docs", &["title", "body"]).unwrap();
+        t.ensure(&conn).unwrap();
+        t.ensure(&conn).unwrap();
+        assert!(t.exists(&conn).unwrap());
+        t.index_row(&conn, 1, &["rust guide", "rust rust rust"])
+            .unwrap();
+        t.index_row(&conn, 2, &["garden", "a rust note"]).unwrap();
+        t.index_row(&conn, 3, &["cooking", "pasta"]).unwrap();
+        t.index_row(&conn, 4, &["travel", "maps"]).unwrap();
+        t.index_row(&conn, 5, &["music", "scales"]).unwrap();
+        let hits = t.search(&conn, "rust", None, 10).unwrap();
+        let ids: Vec<i64> = hits.iter().map(|h| h.rowid).collect();
+        assert_eq!(ids, vec![1, 2]);
+        assert!(hits[0].score > hits[1].score);
+        // Replacing a row removes the old terms.
+        t.index_row(&conn, 1, &["pasta", "x"]).unwrap();
+        let ids: Vec<i64> = t
+            .search(&conn, "rust", None, 10)
+            .unwrap()
+            .iter()
+            .map(|h| h.rowid)
+            .collect();
+        assert_eq!(ids, vec![2]);
+        assert!(t.remove_row(&conn, 2).unwrap());
+        assert!(!t.remove_row(&conn, 2).unwrap());
+        assert!(t.search(&conn, "rust", None, 10).unwrap().is_empty());
+        assert!(t.search(&conn, "pasta", None, 0).unwrap().is_empty());
+        t.integrity_check(&conn).unwrap();
+        t.optimize(&conn).unwrap();
+        assert!(matches!(
+            t.index_row(&conn, 9, &["only one"]),
+            Err(Fts5Error::ColumnCount {
+                expected: 2,
+                got: 1
+            })
+        ));
+    }
+
+    #[test]
+    fn weights_make_a_column_count_more() {
+        let conn = Connection::open_in_memory().unwrap();
+        let t = Fts5Table::new("docs", &["title", "body"]).unwrap();
+        t.ensure(&conn).unwrap();
+        t.index_row(&conn, 1, &["needle", "filler filler filler"])
+            .unwrap();
+        t.index_row(&conn, 2, &["filler", "needle filler filler"])
+            .unwrap();
+        for id in 3..=6 {
+            t.index_row(&conn, id, &["other", "unrelated text"])
+                .unwrap();
+        }
+        let by_title = t.search(&conn, "needle", Some(&[10.0, 1.0]), 10).unwrap();
+        assert_eq!(by_title[0].rowid, 1);
+        let by_body = t.search(&conn, "needle", Some(&[1.0, 10.0]), 10).unwrap();
+        assert_eq!(by_body[0].rowid, 2);
+        assert!(matches!(
+            t.bm25_expr(Some(&[1.0])),
+            Err(Fts5Error::ColumnCount {
+                expected: 2,
+                got: 1
+            })
+        ));
+        assert!(matches!(
+            t.bm25_expr(Some(&[1.0, f64::NAN])),
+            Err(Fts5Error::InvalidWeight)
+        ));
+        assert_eq!(
+            t.bm25_expr(Some(&[2.0, 0.5])).unwrap(),
+            "bm25(docs, 2.0, 0.5)"
+        );
+    }
+
+    #[test]
+    fn external_content_projection_follows_the_source_table() {
+        let conn = Connection::open_in_memory().unwrap();
+        conn.execute_batch(
+            "CREATE TABLE messages(id INTEGER PRIMARY KEY, subject TEXT, body TEXT);
+             INSERT INTO messages(subject, body) VALUES ('before', 'existing words');",
+        )
+        .unwrap();
+        let t = Fts5Table::new("msg_fts", &["subject", "body"])
+            .unwrap()
+            .external_content("messages", "id")
+            .unwrap();
+        t.ensure(&conn).unwrap();
+        // Rows that existed before the projection need one rebuild.
+        assert!(t.search(&conn, "existing", None, 5).unwrap().is_empty());
+        t.rebuild(&conn).unwrap();
+        assert_eq!(t.search(&conn, "existing", None, 5).unwrap().len(), 1);
+        conn.execute(
+            "INSERT INTO messages(subject, body) VALUES ('hello', 'new text')",
+            [],
+        )
+        .unwrap();
+        assert_eq!(t.search(&conn, "hello", None, 5).unwrap()[0].rowid, 2);
+        conn.execute("UPDATE messages SET subject = 'changed' WHERE id = 2", [])
+            .unwrap();
+        assert!(t.search(&conn, "hello", None, 5).unwrap().is_empty());
+        assert_eq!(t.search(&conn, "changed", None, 5).unwrap().len(), 1);
+        conn.execute("DELETE FROM messages WHERE id = 2", [])
+            .unwrap();
+        assert!(t.search(&conn, "changed", None, 5).unwrap().is_empty());
+        t.integrity_check(&conn).unwrap();
+        assert!(matches!(
+            t.index_row(&conn, 1, &["a", "b"]),
+            Err(Fts5Error::Unsupported(_))
+        ));
+        t.drop_table(&conn).unwrap();
+        assert!(!t.exists(&conn).unwrap());
+    }
+
+    #[test]
+    fn contentless_tables_index_and_gate_delete() {
+        let conn = Connection::open_in_memory().unwrap();
+        let t = Fts5Table::new("c", &["text"]).unwrap().contentless();
+        t.ensure(&conn).unwrap();
+        t.index_row(&conn, 7, &["findable words"]).unwrap();
+        assert_eq!(t.search(&conn, "findable", None, 5).unwrap()[0].rowid, 7);
+        assert!(matches!(
+            t.remove_row(&conn, 7),
+            Err(Fts5Error::Unsupported(_))
+        ));
+        assert!(matches!(t.rebuild(&conn), Err(Fts5Error::Unsupported(_))));
+    }
+
+    #[test]
+    fn match_expression_is_bound_not_spliced() {
+        let conn = Connection::open_in_memory().unwrap();
+        let t = Fts5Table::new("docs", &["body"]).unwrap();
+        t.ensure(&conn).unwrap();
+        t.index_row(&conn, 1, &["plain words"]).unwrap();
+        // Not valid FTS5 syntax: it is an SQLite error, never executed as SQL.
+        assert!(t
+            .search(&conn, "x'); DROP TABLE docs; --", None, 5)
+            .is_err());
+        assert!(t.exists(&conn).unwrap());
+    }
+}

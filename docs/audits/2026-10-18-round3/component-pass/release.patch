+
+test("stop-app parses repeated --dir and --json, and needs a directory", () => {
+  assert.deepEqual(parseStopAppArgs(["--dir", "a", "--dir", "b", "--json"]), { dirs: ["a", "b"], json: true });
+  assert.throws(() => parseStopAppArgs([]), /at least one --dir/);
+  assert.throws(() => parseStopAppArgs(["--dir"]), /needs a value/);
+  assert.throws(() => parseStopAppArgs(["--nope"]), /unknown stop-app argument/);
+});

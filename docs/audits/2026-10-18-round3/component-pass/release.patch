index 0000000..f38dc89
--- /dev/null
+++ b/packages/release/real-user-env.mjs
@@ -0,0 +1,37 @@
+import os from "node:os";
+
+/**
+ * The environment an installed app is relaunched with (issue #690). A dev install can run from an agent shell inside a
+ * second Claude profile (HOME=~/ClaudeProfiles/claude-b-home, CLAUDE_CONFIG_DIR set); an app relaunched with that
+ * environment would then use the profile's folders. Every app RightKit installs is relaunched with HOME taken from the
+ * password database (the real account home) and WITHOUT CLAUDE_CONFIG_DIR.
+ */
+
+/**
+ * The real account home: `os.userInfo().homedir` (getpwuid on POSIX, the profile directory on Windows). Falls back to
+ * `env.HOME` (or `env.USERPROFILE` on Windows) only when `userInfo` throws or returns an empty homedir; returns null
+ * when nothing usable exists.
+ */
+export function realUserHome({ userInfo = os.userInfo, env = process.env, platform = process.platform } = {}) {
+  try {
+    const home = userInfo()?.homedir;
+    if (typeof home === "string" && home.length > 0) return home;
+  } catch { /* fall back to the environment below */ }
+  const fallback = platform === "win32" ? env?.USERPROFILE ?? env?.HOME : env?.HOME;
+  return typeof fallback === "string" && fallback.length > 0 ? fallback : null;
+}
+
+/**
+ * A copy of `env` for relaunching an installed app: HOME (and USERPROFILE on Windows) set to the real home, and
+ * CLAUDE_CONFIG_DIR removed. Nothing else is touched. The input object is never mutated.
+ */
+export function relaunchEnvironment(env = process.env, { userInfo = os.userInfo, platform = process.platform } = {}) {
+  const out = { ...env };
+  const home = realUserHome({ userInfo, env, platform });
+  if (home) {
+    out.HOME = home;
+    if (platform === "win32") out.USERPROFILE = home;
+  }
+  delete out.CLAUDE_CONFIG_DIR;
+  return out;
+}

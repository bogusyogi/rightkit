diff --git a/packages/release/work-folder-guard.mjs b/packages/release/work-folder-guard.mjs
new file mode 100644
index 0000000..354a86f
--- /dev/null
+++ b/packages/release/work-folder-guard.mjs
@@ -0,0 +1,153 @@
+// Work-folder guard (issue #763): publishing must leave no copies on disk. Pure functions; every effect goes
+// through an injectable `fs` object (default node:fs) and there is no process-wide state.
+//
+//   - removeWorkFolder: delete a staging/bundle/work folder, but only one strictly inside an allowed root.
+//   - pruneRetained: bound a retained-artefact folder by count and age.
+//   - assertLeftoverWithin: fail loudly when a run would leave more than a set size behind.
+//   - refuseRepoCopy: the release flow never copies a whole repository (or a parent of it) per release.
+//   - removeConsumedBundle: delete a qualification bundle once `publish cargo --from-evidence` consumed it.
+import nodeFs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+export const DEFAULT_MAX_LEFTOVER_BYTES = 256 * 1024 * 1024;
+export const MAX_LEFTOVER_ENV = "RIGHT_RELEASE_MAX_LEFTOVER_BYTES";
+export const DEFAULT_RETAIN = Object.freeze({ maxCount: 3, maxAgeMs: 7 * 24 * 60 * 60 * 1000 });
+
+export const WORK_FOLDER_REFUSED = "WORK_FOLDER_REFUSED";
+export const WORK_FOLDER_LEFTOVER_TOO_LARGE = "WORK_FOLDER_LEFTOVER_TOO_LARGE";
+export const WORK_FOLDER_NOT_REMOVED = "WORK_FOLDER_NOT_REMOVED";
+export const WORK_FOLDER_REPO_COPY = "WORK_FOLDER_REPO_COPY";
+export const WORK_FOLDER_BAD_LIMIT = "WORK_FOLDER_BAD_LIMIT";
+
+const coded = (code, message) => Object.assign(new Error(`[${code}] ${message}`), { code });
+const fold = (value) => (path.sep === "\\" ? value.toLowerCase() : value);
+const realOrResolved = (fs, target) => { try { return fs.realpathSync(target); } catch { return path.resolve(target); } };
+
+/** True when `child` is `parent` itself or lies inside it (lexical, after resolving both). */
+function isInsideOrEqual(parent, child) {
+  const relative = path.relative(fold(path.resolve(parent)), fold(path.resolve(child)));
+  return relative === "" || (!relative.startsWith("..") && !path.isAbsolute(relative));
+}
+const isStrictlyInside = (parent, child) => isInsideOrEqual(parent, child) && fold(path.resolve(parent)) !== fold(path.resolve(child));
+
+/** Total bytes of regular files under `dir` (recursive, symlinks and junctions counted as themselves, never followed). */
+export function dirSizeBytes(dir, { fs = nodeFs } = {}) {
+  let stat;
+  try { stat = fs.lstatSync(dir); } catch { return 0; }
+  if (!stat.isDirectory()) return stat.size;
+  let total = 0;
+  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+    const child = path.join(dir, entry.name);
+    if (entry.isDirectory()) total += dirSizeBytes(child, { fs });
+    else { try { total += fs.lstatSync(child).size; } catch { /* vanished while measuring */ } }
+  }
+  return total;
+}
+
+/**
+ * Remove one work folder. Refuses anything not strictly inside one of `allowedRoots`, the filesystem root, the
+ * home directory, or a path that is a symlink/junction. A missing folder is not an error.
+ * Returns { removed, bytes }.
+ */
+export function removeWorkFolder(dir, { fs = nodeFs, allowedRoots = [], homeDir = os.homedir() } = {}) {
+  if (typeof dir !== "string" || !dir.trim()) throw coded(WORK_FOLDER_REFUSED, "no folder named");
+  const target = path.resolve(dir);
+  if (path.parse(target).root === target) throw coded(WORK_FOLDER_REFUSED, `refusing to remove the filesystem root ${target}`);
+  if (homeDir && fold(path.resolve(homeDir)) === fold(target)) throw coded(WORK_FOLDER_REFUSED, `refusing to remove the home directory ${target}`);
+  if (!allowedRoots.length) throw coded(WORK_FOLDER_REFUSED, `no allowed root given; refusing to remove ${target}`);
+  let stat;
+  try { stat = fs.lstatSync(target); } catch { return { removed: false, bytes: 0 }; }
+  if (stat.isSymbolicLink()) throw coded(WORK_FOLDER_REFUSED, `refusing to remove ${target}: it is a symlink or junction`);
+  const realTarget = realOrResolved(fs, target);
+  const inside = allowedRoots.some((root) => isStrictlyInside(root, target) && isStrictlyInside(realOrResolved(fs, root), realTarget));
+  if (!inside) throw coded(WORK_FOLDER_REFUSED, `refusing to remove ${target}: not strictly inside an allowed root (${allowedRoots.join(", ")})`);
+  const bytes = dirSizeBytes(target, { fs });
+  fs.rmSync(target, { recursive: true, force: true });
+  return { removed: true, bytes };
+}
+
+/**
+ * Bound a retained-artefact folder: remove the oldest entries beyond `maxCount` and every entry older than
+ * `maxAgeMs`. Names in `keep` are never removed (and do not count toward maxCount); symlinks are skipped.
+ * Returns the removed names.
+ */
+export function pruneRetained(parentDir, { maxCount = DEFAULT_RETAIN.maxCount, maxAgeMs = DEFAULT_RETAIN.maxAgeMs, now = Date.now(), fs = nodeFs, keep = [] } = {}) {
+  let names;
+  try { names = fs.readdirSync(parentDir); } catch { return []; }
+  const kept = new Set(keep);
+  const rows = [];
+  for (const name of names) {
+    if (kept.has(name)) continue;
+    const entry = path.join(parentDir, name);
+    let stat;
+    try { stat = fs.lstatSync(entry); } catch { continue; }
+    if (stat.isSymbolicLink()) continue;
+    rows.push({ name, entry, mtimeMs: stat.mtimeMs });
+  }
+  rows.sort((a, b) => b.mtimeMs - a.mtimeMs || (a.name < b.name ? 1 : -1));
+  const removed = [];
+  rows.forEach((row, index) => {
+    if (index >= maxCount || now - row.mtimeMs > maxAgeMs) {
+      fs.rmSync(row.entry, { recursive: true, force: true });
+      removed.push(row.name);
+    }
+  });
+  return removed;
+}
+
+/** The leftover limit: `RIGHT_RELEASE_MAX_LEFTOVER_BYTES` when set (a positive integer), else the default. */
+export function resolveMaxLeftoverBytes(env = process.env) {
+  const text = env?.[MAX_LEFTOVER_ENV];
+  if (text === undefined || text === "") return DEFAULT_MAX_LEFTOVER_BYTES;
+  if (!/^[0-9]+$/.test(String(text)) || Number(text) < 1) throw coded(WORK_FOLDER_BAD_LIMIT, `${MAX_LEFTOVER_ENV} must be a positive integer number of bytes, got ${JSON.stringify(text)}`);
+  return Number(text);
+}
+
+/** Throws WORK_FOLDER_LEFTOVER_TOO_LARGE, naming each path and size, when the paths together exceed `maxBytes`. */
+export function assertLeftoverWithin(paths, maxBytes = resolveMaxLeftoverBytes(), { fs = nodeFs } = {}) {
+  const sizes = paths.map((p) => ({ path: p, bytes: dirSizeBytes(p, { fs }) }));
+  const total = sizes.reduce((sum, row) => sum + row.bytes, 0);
+  if (total > maxBytes) {
+    throw coded(WORK_FOLDER_LEFTOVER_TOO_LARGE, `this run would leave ${total} bytes on disk (limit ${maxBytes}; ${MAX_LEFTOVER_ENV} overrides): ${sizes.map((row) => `${row.path} = ${row.bytes} bytes`).join("; ")}`);
+  }
+  return { total, sizes };
+}
+
+/** Throws WORK_FOLDER_NOT_REMOVED when any of the paths still exists. */
+export function assertRemoved(paths, { fs = nodeFs } = {}) {
+  const left = paths.filter((p) => { try { fs.lstatSync(p); return true; } catch { return false; } });
+  if (left.length) throw coded(WORK_FOLDER_NOT_REMOVED, `work folder(s) still on disk after the run: ${left.join(", ")}`);
+}
+
+/** Throws WORK_FOLDER_REPO_COPY when asked to copy the repository root or a parent of it. */
+export function refuseRepoCopy(src, repoRoot) {
+  if (isInsideOrEqual(src, repoRoot)) throw coded(WORK_FOLDER_REPO_COPY, `refusing to copy ${path.resolve(src)}: it is or contains the repository ${path.resolve(repoRoot)}; releases never copy the whole repository`);
+}
+
+/**
+ * Delete a qualification bundle after `publish cargo --from-evidence <bundle>/gate.json` published from it.
+ * Only when the bundle directory is the gate file's parent and holds exactly gate.json plus the one
+ * `<name>-<version>.crate|.tgz` the evidence names (regular files only). Otherwise the bundle is left and the
+ * reason returned. Returns { removed, bytes, reason? }.
+ */
+export function removeConsumedBundle(gateFile, { fs = nodeFs, workspaceRoot, allowedRoots, homeDir } = {}) {
+  const gate = path.resolve(gateFile);
+  const bundleDir = path.dirname(gate);
+  if (path.basename(gate) !== "gate.json") return { removed: false, bytes: 0, reason: "evidence file is not named gate.json" };
+  if (workspaceRoot && isInsideOrEqual(bundleDir, workspaceRoot)) return { removed: false, bytes: 0, reason: "bundle directory contains the workspace" };
+  let evidence;
+  try { evidence = JSON.parse(fs.readFileSync(gate, "utf8")); } catch { return { removed: false, bytes: 0, reason: "gate.json is unreadable" }; }
+  if (typeof evidence?.name !== "string" || typeof evidence?.version !== "string") return { removed: false, bytes: 0, reason: "gate.json names no artifact" };
+  const stem = `${evidence.name.replace(/^@/, "").replace("/", "-")}-${evidence.version}`;
+  const allowedArtifacts = new Set([`${stem}.crate`, `${stem}.tgz`]);
+  let entries;
+  try { entries = fs.readdirSync(bundleDir, { withFileTypes: true }); } catch { return { removed: false, bytes: 0, reason: "bundle directory is unreadable" }; }
+  const others = entries.filter((entry) => entry.name !== "gate.json");
+  const regular = entries.every((entry) => entry.isFile());
+  if (!regular || others.length !== 1 || !allowedArtifacts.has(others[0].name)) {
+    return { removed: false, bytes: 0, reason: `bundle holds more than gate.json and the one artifact it names (${[...allowedArtifacts].join(" or ")})` };
+  }
+  const result = removeWorkFolder(bundleDir, { fs, allowedRoots: allowedRoots ?? [path.dirname(bundleDir)], homeDir });
+  return result;
+}

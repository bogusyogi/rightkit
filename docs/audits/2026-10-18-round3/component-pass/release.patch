diff --git a/packages/release/forbidden-crates.mjs b/packages/release/forbidden-crates.mjs
new file mode 100644
index 0000000..1c0adc6
--- /dev/null
+++ b/packages/release/forbidden-crates.mjs
@@ -0,0 +1,57 @@
+// Per-app forbidden-crate rule on the release dependency graph (#475). Pure Cargo.lock parsing via
+// smol-toml; nothing shells out to cargo. A release app declares `forbiddenCrates` (names) and the
+// gate fails when any is reachable from the app's root crate, naming the dependency path.
+import { existsSync, readFileSync } from "node:fs";
+import path from "node:path";
+import { parse } from "smol-toml";
+
+const depName = (entry) => String(entry).split(" ")[0];
+
+/**
+ * Violations for `forbidden` crate names reachable from `rootCrate` in `lockText`.
+ * Each is `{ crate, version, path: [rootCrate, ..., crate] }` (shortest path by crate name).
+ */
+export function findForbiddenCrates(lockText, rootCrate, forbidden) {
+  const banned = new Set((forbidden ?? []).map(String));
+  if (!banned.size) return [];
+  const packages = parse(lockText).package ?? [];
+  const byName = new Map();
+  for (const entry of packages) {
+    if (!byName.has(entry.name)) byName.set(entry.name, []);
+    byName.get(entry.name).push(entry);
+  }
+  if (!byName.has(rootCrate)) throw new Error(`root crate ${rootCrate} is not in Cargo.lock`);
+  const parent = new Map([[rootCrate, null]]);
+  const queue = [rootCrate];
+  while (queue.length) {
+    const name = queue.shift();
+    for (const entry of byName.get(name) ?? []) {
+      for (const dependency of entry.dependencies ?? []) {
+        const next = depName(dependency);
+        if (parent.has(next)) continue;
+        parent.set(next, name);
+        queue.push(next);
+      }
+    }
+  }
+  const violations = [];
+  for (const crate of [...banned].sort()) {
+    if (!parent.has(crate)) continue;
+    const trail = [];
+    for (let at = crate; at !== null; at = parent.get(at)) trail.unshift(at);
+    violations.push({ crate, version: byName.get(crate)?.[0]?.version ?? null, path: trail });
+  }
+  return violations;
+}
+
+/** Throws one error listing every forbidden crate found in the lock file's graph; returns [] when clean. */
+export function assertNoForbiddenCrates({ lockPath, rootCrate, forbidden, readFile = readFileSync, exists = existsSync }) {
+  if (!forbidden?.length) return [];
+  if (!exists(lockPath)) throw new Error(`forbidden-crate check needs ${path.resolve(lockPath)}, which does not exist`);
+  const violations = findForbiddenCrates(readFile(lockPath, "utf8"), rootCrate, forbidden);
+  if (violations.length) {
+    const lines = violations.map((v) => `  ${v.crate}${v.version ? ` ${v.version}` : ""}: ${v.path.join(" -> ")}`);
+    throw new Error(`forbidden crates in the release dependency graph of ${rootCrate}:\n${lines.join("\n")}`);
+  }
+  return violations;
+}

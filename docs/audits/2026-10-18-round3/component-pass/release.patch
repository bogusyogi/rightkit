diff --git a/packages/release/stop-app-processes.mjs b/packages/release/stop-app-processes.mjs
new file mode 100644
index 0000000..5683b89
--- /dev/null
+++ b/packages/release/stop-app-processes.mjs
@@ -0,0 +1,65 @@
+// Stop the running processes of ONE install before that install is removed or replaced (a running .exe is mandatory-locked
+// on Windows; a running .app keeps its old inode on macOS). A process is matched ONLY when its executable path lies inside
+// the install directory; never by name alone, so cargo/node/this script (whose command lines name the repo) and another
+// app's same-named binary are never touched.
+import { spawnSync } from "node:child_process";
+import path from "node:path";
+
+const windows = (platform) => platform === "win32";
+
+/** True when `file` is inside `dir` (never `dir` itself), compared with the platform's path rules (case-insensitive on Windows). */
+export function isInsideInstall(file, dir, platform = process.platform) {
+  if (typeof file !== "string" || !file || typeof dir !== "string" || !dir) return false;
+  const p = windows(platform) ? path.win32 : path.posix;
+  const norm = (value) => { const resolved = p.resolve(value); return windows(platform) ? resolved.toLowerCase() : resolved; };
+  const relative = p.relative(norm(dir), norm(file));
+  return relative !== "" && !relative.startsWith("..") && !p.isAbsolute(relative);
+}
+
+/** Pure: the pids of `processes` ([{pid, executablePath}]) whose executable is inside `installDir`, excluding `selfPid`. */
+export function selectProcessesInside(processes, installDir, { platform = process.platform, selfPid = process.pid } = {}) {
+  return processes
+    .filter((entry) => Number.isInteger(entry?.pid) && entry.pid > 0 && entry.pid !== selfPid && isInsideInstall(entry.executablePath, installDir, platform))
+    .map((entry) => entry.pid);
+}
+
+export function parsePsOutput(text) {
+  const out = [];
+  for (const line of String(text ?? "").split("\n")) {
+    const match = line.match(/^\s*(\d+)\s+(\/.*?)\s*$/);
+    if (match) out.push({ pid: Number(match[1]), executablePath: match[2] });
+  }
+  return out;
+}
+
+export function parseWindowsProcessJson(text) {
+  let value;
+  try { value = JSON.parse(String(text ?? "").trim() || "[]"); } catch { return []; }
+  return (Array.isArray(value) ? value : [value]).filter(Boolean)
+    .map((entry) => ({ pid: Number(entry.ProcessId), executablePath: entry.ExecutablePath }));
+}
+
+export function listProcesses({ platform = process.platform, run = spawnSync, systemRoot = process.env.SystemRoot ?? "C:\\Windows" } = {}) {
+  if (windows(platform)) {
+    const script = "Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath } | Select-Object ProcessId,ExecutablePath | ConvertTo-Json -Compress";
+    const result = run(path.win32.join(systemRoot, "System32", "WindowsPowerShell", "v1.0", "powershell.exe"), ["-NoProfile", "-NonInteractive", "-Command", script], { encoding: "utf8", windowsHide: true, shell: false, maxBuffer: 64 * 1024 * 1024 });
+    return result.status === 0 ? parseWindowsProcessJson(result.stdout) : [];
+  }
+  // `comm` is the full executable path on macOS.
+  const result = run("ps", ["-axo", "pid=,comm="], { encoding: "utf8", shell: false, maxBuffer: 64 * 1024 * 1024 });
+  return result.status === 0 ? parsePsOutput(result.stdout) : [];
+}
+
+/**
+ * Kill every running process whose executable is inside `installDir`. Returns the pids signalled. No-op when `installDir` is
+ * empty. `kill` is the seam tests inject (default process.kill with SIGKILL).
+ */
+export function stopAppProcessesInside(installDir, { platform = process.platform, run = spawnSync, list = listProcesses, kill = (pid) => process.kill(pid, "SIGKILL"), selfPid = process.pid, log = (line) => console.log(line) } = {}) {
+  if (typeof installDir !== "string" || !installDir.trim()) return [];
+  const pids = selectProcessesInside(list({ platform, run }), installDir, { platform, selfPid });
+  for (const pid of pids) {
+    try { kill(pid); } catch (error) { if (error?.code !== "ESRCH") throw error; }
+    log(`right-release dev: stopped pid ${pid} (executable inside ${installDir})`);
+  }
+  return pids;
+}
diff --git a/packages/release/stop-app-processes.test.mjs b/packages/release/stop-app-processes.test.mjs

+// The `runtimeArtifacts` block of right-release.config.mjs (bogusyogi/rightkit#753: it used to be read by nothing and silently ignored).
+//
+//   runtimeArtifacts: {
+//     asr: { schema: 1, appKey: "scraperight", role: "consumer", authorityAppKey: "heardright", artifactKind: "asr-model",
+//            delivery: "private-r2", entitlementTier: "pro" },
+//   }
+//
+// Each key names an artifact family with a locked promotion adapter. Today `asr` is the only one: the HeardRight authority and its
+// consumers (ScrapeRight) must declare the same adapter contract, which `assertAsrAdapterPair` (asr-artifact-adoption.mjs) checks
+// across two apps. This module checks one app's own block the moment its config is loaded, so a typo, a stale schema or a block for
+// a family RightKit does not know fails the release instead of being ignored. Extra fields inside an adapter are tolerated.
+const isObject = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+
+export class RuntimeArtifactsConfigError extends Error {
+  constructor(problems) {
+    super(`invalid runtimeArtifacts:\n${problems.map((line) => `- ${line}`).join("\n")}`);
+    this.name = "RuntimeArtifactsConfigError";
+    this.code = "RK_RUNTIME_ARTIFACTS_CONFIG";
+    this.problems = problems;
+  }
+}
+
+/** Known artifact families: the fixed values every adapter of the family must carry. */
+export const RUNTIME_ARTIFACT_FAMILIES = Object.freeze({
+  asr: Object.freeze({ authorityAppKey: "heardright", artifactKind: "asr-model", delivery: "private-r2", entitlementTier: "pro" }),
+});
+export const RUNTIME_ARTIFACT_ROLES = Object.freeze(["authority", "consumer"]);
+
+/** Every problem with `value` (undefined is fine: no block). */
+export function runtimeArtifactsProblems(value) {
+  if (value === undefined) return [];

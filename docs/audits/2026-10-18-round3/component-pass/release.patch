diff --git a/packages/release/stop-app-command.mjs b/packages/release/stop-app-command.mjs
new file mode 100644
index 0000000..30e7ced
--- /dev/null
+++ b/packages/release/stop-app-command.mjs
@@ -0,0 +1,47 @@
+#!/usr/bin/env node
+// `right-release stop-app --dir <install dir>... [--json]`: stop the running processes of an install before it is replaced, rebuilt or
+// deleted (a running .exe is mandatory-locked on Windows; a running .app keeps its old inode on macOS). A process is stopped ONLY when
+// its executable path lies inside one of the directories - never by name - so cargo, node, this command (whose command lines name the
+// repo) and another app's same-named binary are never touched. The filesystem root and the home directory are refused. It is the
+// command form of the dev installer's own cleanup and of `preflight.stopApps`; exit 0 whether or not anything was running.
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { resolveStopAppDir } from "./preflight-command.mjs";
+import { stopAppProcessesInside } from "./stop-app-processes.mjs";
+
+export function parseStopAppArgs(argv) {
+  const opts = { dirs: [], json: false };
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i];
+    if (arg === "--dir") {
+      const value = argv[i + 1];
+      if (!value || value.startsWith("--")) throw new Error("--dir needs a value");
+      opts.dirs.push(value);
+      i += 1;
+    } else if (arg === "--json") opts.json = true;
+    else throw new Error(`unknown stop-app argument: ${arg}`);
+  }
+  if (!opts.dirs.length) throw new Error("stop-app needs at least one --dir <install directory>");
+  return opts;
+}
+
+/** Stop every install in `dirs`; returns `[{ dir, pids }]`. `stop` and `cwd` are injectable. */
+export function stopApps(dirs, { cwd = process.cwd(), stop = stopAppProcessesInside, home, log = (line) => console.log(line) } = {}) {
+  const resolved = dirs.map((dir) => resolveStopAppDir(dir, { appRoot: cwd, home }));
+  return resolved.map((dir) => ({ dir, pids: stop(dir, { log: (line) => log(line.replace("right-release dev:", "right-release stop-app:")) }) }));
+}
+
+export function main(argv = process.argv.slice(2)) {
+  const opts = parseStopAppArgs(argv);
+  const results = stopApps(opts.dirs, { log: opts.json ? () => {} : undefined });
+  if (opts.json) console.log(JSON.stringify({ stopped: results.map(({ dir, pids }) => ({ dir: path.resolve(dir), pids })) }, null, 2));
+  else for (const { dir, pids } of results) console.log(`right-release stop-app: ${pids.length ? `stopped ${pids.length} process(es)` : "nothing running"} in ${dir}`);
+  return 0;
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? "").href) {
+  try { process.exitCode = main(); } catch (error) {
+    console.error(`right-release stop-app: ${error.code ? `[${error.code}] ` : ""}${error.message}`);
+    process.exitCode = 1;
+  }
+}

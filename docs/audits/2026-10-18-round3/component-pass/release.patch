@@ -0,0 +1,35 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { isInsideInstall, parsePsOutput, parseWindowsProcessJson, selectProcessesInside, stopAppProcessesInside } from "./stop-app-processes.mjs";
+
+test("matches only executables inside the install dir, never by name", () => {
+  const dir = "/Applications/Fixture.app";
+  assert.equal(isInsideInstall("/Applications/Fixture.app/Contents/MacOS/Fixture", dir, "darwin"), true);
+  assert.equal(isInsideInstall("/Applications/Fixture.app", dir, "darwin"), false);
+  assert.equal(isInsideInstall("/Applications/Fixture.app2/Contents/MacOS/Fixture", dir, "darwin"), false);
+  assert.equal(isInsideInstall("/tmp/elsewhere/Fixture", dir, "darwin"), false);
+});
+
+test("Windows matching is case-insensitive and rejects sibling prefixes", () => {
+  const dir = "C:\\Users\\a\\AppData\\Local\\Fixture";
+  assert.equal(isInsideInstall("c:\\users\\a\\appdata\\local\\fixture\\FIXTURE.exe", dir, "win32"), true);
+  assert.equal(isInsideInstall("C:\\Users\\a\\AppData\\Local\\Fixture-other\\fixture.exe", dir, "win32"), false);
+});
+
+test("never selects the current process and parses ps and PowerShell output", () => {
+  const procs = parsePsOutput("  12 /Applications/Fixture.app/Contents/MacOS/Fixture\n  13 /usr/bin/node\n  14 /Applications/Fixture.app/Contents/MacOS/Fixture-engine\n");
+  assert.deepEqual(selectProcessesInside(procs, "/Applications/Fixture.app", { platform: "darwin", selfPid: 14 }), [12]);
+  const win = parseWindowsProcessJson('[{"ProcessId":5,"ExecutablePath":"C:\\\\A\\\\x.exe"},{"ProcessId":6,"ExecutablePath":"C:\\\\B\\\\x.exe"}]');
+  assert.deepEqual(selectProcessesInside(win, "C:\\A", { platform: "win32", selfPid: 1 }), [5]);
+  assert.deepEqual(parseWindowsProcessJson('{"ProcessId":7,"ExecutablePath":"C:\\\\A\\\\y.exe"}'), [{ pid: 7, executablePath: "C:\\A\\y.exe" }]);
+});
+
+test("stopAppProcessesInside kills only matching pids and ignores an already-exited one", () => {
+  const killed = [];
+  const list = () => [{ pid: 20, executablePath: "/Apps/F.app/Contents/MacOS/F" }, { pid: 21, executablePath: "/Apps/Other.app/Contents/MacOS/F" }, { pid: 22, executablePath: "/Apps/F.app/Contents/MacOS/helper" }];
+  const kill = (pid) => { killed.push(pid); if (pid === 22) throw Object.assign(new Error("gone"), { code: "ESRCH" }); };
+  const pids = stopAppProcessesInside("/Apps/F.app", { platform: "darwin", list, kill, selfPid: 1, log: () => {} });
+  assert.deepEqual(pids, [20, 22]);
+  assert.deepEqual(killed, [20, 22]);
+  assert.deepEqual(stopAppProcessesInside("", { list: () => assert.fail("no list for empty dir") }), []);
+});

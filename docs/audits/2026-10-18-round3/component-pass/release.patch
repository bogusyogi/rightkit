@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import path from "node:path";
+import test from "node:test";
+import { evaluateExpectation, PreflightCommandError, resolveStopAppDir, runPreflightCommand, stopPreflightApps, validatePreflightCommand } from "./preflight-command.mjs";
+
+const APP = path.resolve("/rk-app");
+const quiet = { stdout: () => {}, stderr: () => {} };
+
+test("a command without expect asserts the exit status only and inherits its output", () => {
+  const calls = [];
+  const spawn = (cmd, args, options) => { calls.push({ cmd, args, options }); return { status: 0 }; };
+  runPreflightCommand({ cmd: "tool", args: ["--v"], cwd: "sub" }, { appRoot: APP, spawn });
+  assert.equal(calls[0].options.stdio, "inherit");
+  assert.equal(calls[0].options.cwd, path.resolve(APP, "sub"));
+  assert.throws(() => runPreflightCommand({ cmd: "tool" }, { appRoot: APP, spawn: () => ({ status: 3 }) }), /tool exited 3/);
+  assert.throws(() => runPreflightCommand({ cmd: "tool" }, { appRoot: APP, spawn: () => ({ error: new Error("ENOENT") }) }), /could not start/);
+});
+
+test("expect asserts output: includes, matches, excludes, stderr and a custom exit status", () => {
+  const result = { status: 0, stdout: "yt-dlp 2026.03.17\nok", stderr: "warn: x" };
+  const spawn = () => result;
+  const run = (expect) => runPreflightCommand({ cmd: "tool", expect }, { appRoot: APP, spawn, write: quiet });
+  assert.deepEqual(run({ stdoutIncludes: ["yt-dlp", "ok"], stdoutMatches: "\\d{4}\\.\\d{2}", stdoutExcludes: "FAIL", stderrIncludes: "warn", exit: [0, 1] }), { status: 0 });
+  assert.throws(() => run({ stdoutIncludes: "missing" }), /stdout does not contain "missing"/);
+  assert.throws(() => run({ stdoutMatches: "^nope" }), /stdout does not match/);
+  assert.throws(() => run({ stdoutExcludes: "ok" }), /stdout contains "ok"/);
+  assert.throws(() => run({ stderrMatches: "^fatal" }), /stderr does not match/);
+  assert.throws(() => runPreflightCommand({ cmd: "tool", expect: { stdoutIncludes: "x" } }, { appRoot: APP, spawn: () => ({ status: 2, stdout: "x" }), write: quiet }), /exit status 2, expected 0/);
+  assert.deepEqual(evaluateExpectation({ exit: [2] }, { status: 2 }), []);
+});
+
+test("output is echoed when expect captures it", () => {
+  const out = [];
+  runPreflightCommand({ cmd: "t", expect: { exit: 0 } }, { appRoot: APP, spawn: () => ({ status: 0, stdout: "A", stderr: "B" }), write: { stdout: (t) => out.push(["o", t]), stderr: (t) => out.push(["e", t]) } });
+  assert.deepEqual(out, [["o", "A"], ["e", "B"]]);
+});
+
+test("validation refuses unknown keys, bad regexes, empty expect and bad shapes", () => {
+  for (const bad of [null, {}, { cmd: "" }, { cmd: "t", extra: 1 }, { cmd: "t", args: [1] }, { cmd: "t", cwd: "" }, { cmd: "t", expect: {} }, { cmd: "t", expect: { nope: 1 } }, { cmd: "t", expect: { stdoutMatches: "(" } }, { cmd: "t", expect: { exit: -1 } }, { cmd: "t", expect: { stdoutIncludes: [] } }, { cmd: "t", expect: { stdoutIncludes: [""] } }]) {
+    assert.throws(() => validatePreflightCommand(bad), PreflightCommandError, JSON.stringify(bad));
+  }
+  assert.deepEqual(validatePreflightCommand({ cmd: "t", expect: { exit: 0, stdoutIncludes: "a" } }).expect, { exit: [0], stdoutIncludes: ["a"] });
+});
+
+test("stopApps resolves against the app, refuses the filesystem root and the home directory, and stops through the seam", () => {
+  const home = path.resolve("/rk-home");
+  assert.equal(resolveStopAppDir("install", { appRoot: APP, home }), path.resolve(APP, "install"));
+  assert.throws(() => resolveStopAppDir(path.parse(APP).root, { appRoot: APP, home }), /filesystem root/);
+  assert.throws(() => resolveStopAppDir(home, { appRoot: APP, home }), /home directory/);
+  assert.throws(() => resolveStopAppDir("", { appRoot: APP, home }), PreflightCommandError);
+  const seen = [];
+  assert.deepEqual(stopPreflightApps("install", { appRoot: APP, home, stop: (dir) => { seen.push(dir); return [4]; } }), [4]);
+  assert.deepEqual(seen, [path.resolve(APP, "install")]);
+});

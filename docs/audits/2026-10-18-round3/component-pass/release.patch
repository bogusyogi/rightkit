+import { tempRoot } from './test-support/temp-roots.mjs';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import test from 'node:test';
+import { cleanupConsumedBundle } from './publish-cargo.mjs';
+import {
+  DEFAULT_MAX_LEFTOVER_BYTES, DEFAULT_RETAIN, assertLeftoverWithin, assertRemoved, dirSizeBytes, pruneRetained,
+  refuseRepoCopy, removeConsumedBundle, removeWorkFolder, resolveMaxLeftoverBytes,
+} from './work-folder-guard.mjs';
+
+const write = (file, text = 'x') => { fs.mkdirSync(path.dirname(file), { recursive: true }); fs.writeFileSync(file, text); };
+const code = (expected) => (error) => error.code === expected;
+const age = (file, ms, now) => { const when = new Date(now - ms); fs.utimesSync(file, when, when); };
+
+test('dirSizeBytes sums files recursively and is 0 for a missing folder', () => {
+  const root = tempRoot('rk-wfg-');
+  write(path.join(root, 'a', 'one.txt'), '12345');
+  write(path.join(root, 'two.txt'), '123');
+  assert.equal(dirSizeBytes(root), 8);
+  assert.equal(dirSizeBytes(path.join(root, 'missing')), 0);
+});
+
+test('removeWorkFolder removes a folder strictly inside an allowed root and reports bytes', () => {
+  const root = tempRoot('rk-wfg-');
+  const work = path.join(root, 'work');
+  write(path.join(work, 'f.bin'), 'abcd');
+  assert.deepEqual(removeWorkFolder(work, { allowedRoots: [root] }), { removed: true, bytes: 4 });
+  assert.equal(fs.existsSync(work), false);
+  assert.deepEqual(removeWorkFolder(work, { allowedRoots: [root] }), { removed: false, bytes: 0 });
+});
+
+test('removeWorkFolder refuses outside the roots, the root itself, the filesystem root, the home dir and symlinks', () => {
+  const root = tempRoot('rk-wfg-');
+  const other = tempRoot('rk-wfg-');
+  write(path.join(other, 'keep.txt'));
+  assert.throws(() => removeWorkFolder(other, { allowedRoots: [root] }), code('WORK_FOLDER_REFUSED'));
+  assert.throws(() => removeWorkFolder(root, { allowedRoots: [root] }), code('WORK_FOLDER_REFUSED'));
+  assert.throws(() => removeWorkFolder(path.parse(root).root, { allowedRoots: [path.parse(root).root] }), code('WORK_FOLDER_REFUSED'));
+  assert.throws(() => removeWorkFolder(root, { allowedRoots: [path.dirname(root)], homeDir: root }), code('WORK_FOLDER_REFUSED'));
+  assert.throws(() => removeWorkFolder(path.join(root, 'x'), { allowedRoots: [] }), code('WORK_FOLDER_REFUSED'));
+  assert.throws(() => removeWorkFolder(path.join(root, '..', path.basename(other)), { allowedRoots: [root] }), code('WORK_FOLDER_REFUSED'));
+  const link = path.join(root, 'link');
+  try { fs.symlinkSync(other, link, 'junction'); } catch { return; } // a host that cannot create links skips this part
+  assert.throws(() => removeWorkFolder(link, { allowedRoots: [root] }), code('WORK_FOLDER_REFUSED'));
+  assert.equal(fs.existsSync(path.join(other, 'keep.txt')), true);
+});
+
+test('pruneRetained removes the oldest entries beyond maxCount', () => {
+  const root = tempRoot('rk-wfg-');
+  const now = Date.now();
+  for (const [name, ageMs] of [['a', 4000], ['b', 3000], ['c', 2000], ['d', 1000]]) {
+    write(path.join(root, name, 'f'));
+    age(path.join(root, name), ageMs, now);
+  }
+  const removed = pruneRetained(root, { maxCount: 2, maxAgeMs: 10 ** 9, now });
+  assert.deepEqual(removed.sort(), ['a', 'b']);
+  assert.deepEqual(fs.readdirSync(root).sort(), ['c', 'd']);
+});
+
+test('pruneRetained removes entries older than maxAgeMs but never a name in keep', () => {
+  const root = tempRoot('rk-wfg-');
+  const now = Date.now();
+  for (const [name, ageMs] of [['old', 100000], ['older-kept', 200000], ['fresh', 10]]) {
+    write(path.join(root, name, 'f'));
+    age(path.join(root, name), ageMs, now);
+  }
+  const removed = pruneRetained(root, { maxCount: 10, maxAgeMs: 5000, now, keep: ['older-kept'] });
+  assert.deepEqual(removed, ['old']);
+  assert.deepEqual(fs.readdirSync(root).sort(), ['fresh', 'older-kept']);
+  assert.deepEqual(pruneRetained(path.join(root, 'nope')), []);
+  assert.equal(DEFAULT_RETAIN.maxCount, 3);
+  assert.equal(DEFAULT_RETAIN.maxAgeMs, 7 * 24 * 60 * 60 * 1000);
+});
+
+test('assertLeftoverWithin passes within the limit and names each path and size past it', () => {
+  const root = tempRoot('rk-wfg-');
+  write(path.join(root, 'a', 'f'), '12345');
+  write(path.join(root, 'b', 'f'), '123');
+  const paths = [path.join(root, 'a'), path.join(root, 'b')];
+  assert.equal(assertLeftoverWithin(paths, 8).total, 8);
+  assert.throws(() => assertLeftoverWithin(paths, 7), (error) => {
+    assert.equal(error.code, 'WORK_FOLDER_LEFTOVER_TOO_LARGE');
+    assert.ok(error.message.includes(`${paths[0]} = 5 bytes`));
+    assert.ok(error.message.includes(`${paths[1]} = 3 bytes`));
+    return true;
+  });
+});
+
+test('the leftover limit defaults to 256 MiB and RIGHT_RELEASE_MAX_LEFTOVER_BYTES overrides it', () => {
+  assert.equal(DEFAULT_MAX_LEFTOVER_BYTES, 256 * 1024 * 1024);
+  assert.equal(resolveMaxLeftoverBytes({}), DEFAULT_MAX_LEFTOVER_BYTES);
+  assert.equal(resolveMaxLeftoverBytes({ RIGHT_RELEASE_MAX_LEFTOVER_BYTES: '10' }), 10);
+  assert.throws(() => resolveMaxLeftoverBytes({ RIGHT_RELEASE_MAX_LEFTOVER_BYTES: 'abc' }), code('WORK_FOLDER_BAD_LIMIT'));
+  assert.throws(() => resolveMaxLeftoverBytes({ RIGHT_RELEASE_MAX_LEFTOVER_BYTES: '0' }), code('WORK_FOLDER_BAD_LIMIT'));
+});
+
+test('assertRemoved fails while a work folder still exists', () => {
+  const root = tempRoot('rk-wfg-');
+  assertRemoved([path.join(root, 'gone')]);
+  assert.throws(() => assertRemoved([root]), code('WORK_FOLDER_NOT_REMOVED'));
+});
+
+test('refuseRepoCopy refuses the repository root and any parent of it, but allows a subfolder or a sibling', () => {
+  const base = path.join(os.tmpdir(), 'rk-wfg-repo');
+  const repo = path.join(base, 'repo');
+  assert.throws(() => refuseRepoCopy(repo, repo), code('WORK_FOLDER_REPO_COPY'));
+  assert.throws(() => refuseRepoCopy(base, repo), code('WORK_FOLDER_REPO_COPY'));
+  refuseRepoCopy(path.join(repo, 'crates', 'x'), repo);
+  refuseRepoCopy(path.join(base, 'sibling'), repo);
+});
+
+const bundle = (root, { extra = [] } = {}) => {
+  const dir = path.join(root, 'bundles', 'one');
+  write(path.join(dir, 'gate.json'), JSON.stringify({ name: 'rightkit-demo', version: '1.2.3' }));
+  write(path.join(dir, 'rightkit-demo-1.2.3.crate'), 'bytes');
+  for (const name of extra) write(path.join(dir, name));
+  return dir;
+};
+
+test('removeConsumedBundle deletes a bundle that holds only gate.json and the artifact it names', () => {
+  const root = tempRoot('rk-wfg-');
+  const dir = bundle(root);
+  const result = removeConsumedBundle(path.join(dir, 'gate.json'), { workspaceRoot: path.join(root, 'ws') });
+  assert.equal(result.removed, true);
+  assert.equal(fs.existsSync(dir), false);
+  assert.equal(fs.existsSync(path.join(root, 'bundles')), true);
+});
+
+test('removeConsumedBundle leaves a bundle with extra files or a mismatched artifact, and says why', () => {
+  const root = tempRoot('rk-wfg-');
+  const dir = bundle(root, { extra: ['notes.txt'] });
+  const result = removeConsumedBundle(path.join(dir, 'gate.json'), {});
+  assert.equal(result.removed, false);
+  assert.match(result.reason, /more than gate\.json/);
+  assert.equal(fs.existsSync(dir), true);
+  const other = tempRoot('rk-wfg-');
+  write(path.join(other, 'gate.json'), JSON.stringify({ name: 'rightkit-demo', version: '1.2.3' }));
+  write(path.join(other, 'something-else.crate'));
+  assert.equal(removeConsumedBundle(path.join(other, 'gate.json'), {}).removed, false);
+  assert.equal(removeConsumedBundle(path.join(other, 'evidence.json'), {}).removed, false);
+});
+
+test('removeConsumedBundle never removes a bundle that contains the workspace', () => {
+  const root = tempRoot('rk-wfg-');
+  const dir = bundle(root);
+  const result = removeConsumedBundle(path.join(dir, 'gate.json'), { workspaceRoot: path.join(dir, 'ws') });
+  assert.equal(result.removed, false);
+  assert.equal(fs.existsSync(dir), true);
+});
+
+test('cleanupConsumedBundle acts only after a real --from-evidence publish and logs what it did', () => {
+  const root = tempRoot('rk-wfg-');
+  const dir = bundle(root);
+  const logs = [];
+  const gate = path.join(dir, 'gate.json');
+  assert.equal(cleanupConsumedBundle({ dryRun: true, fromEvidence: true, evidence: gate }, { log: (line) => logs.push(line) }).removed, false);
+  assert.equal(cleanupConsumedBundle({ dryRun: false, evidence: gate }, { log: (line) => logs.push(line) }).removed, false);
+  assert.equal(fs.existsSync(dir), true);
+  const done = cleanupConsumedBundle({ dryRun: false, fromEvidence: true, evidence: gate, workspaceRoot: path.join(root, 'ws') }, { log: (line) => logs.push(line) });
+  assert.equal(done.removed, true);
+  assert.equal(fs.existsSync(dir), false);
+  assert.match(logs.join('\n'), /removed the consumed qualification bundle/);
+});
+
+test('cleanupConsumedBundle fails loudly when a kept bundle is larger than the limit', () => {
+  const root = tempRoot('rk-wfg-');
+  const dir = bundle(root, { extra: ['notes.txt'] });
+  assert.throws(() => cleanupConsumedBundle({ dryRun: false, fromEvidence: true, evidence: path.join(dir, 'gate.json') },
+    { log: () => {}, env: { RIGHT_RELEASE_MAX_LEFTOVER_BYTES: '1' } }), code('WORK_FOLDER_LEFTOVER_TOO_LARGE'));
+});

+  head.writeUInt32BE(0xcafebabe, 0);
+  head.writeUInt32BE(slices.length, 4);
+  const out = Buffer.alloc(offset);
+  Buffer.concat([head, ...entries]).copy(out, 0);
+  for (const { start, bytes } of placed) bytes.copy(out, start);
+  return out;
+}
+
+function pe({ checksum = 0, cert = 0, machine = 0x8664 } = {}) {
+  const sizeOfHeaders = 0x200;
+  const section = body(64);
+  const image = Buffer.alloc(sizeOfHeaders + section.length);
+  image.write("MZ", 0, "latin1");
+  image.writeUInt32LE(0x40, 0x3c);
+  image.write("PE\0\0", 0x40, "latin1");
+  image.writeUInt16LE(machine, 0x44);
+  image.writeUInt16LE(1, 0x46);
+  image.writeUInt16LE(240, 0x54);
+  const opt = 0x58;
+  image.writeUInt16LE(0x20b, opt);
+  image.writeUInt32LE(sizeOfHeaders, opt + 60);
+  image.writeUInt32LE(checksum, opt + 64);
+  image.writeUInt32LE(16, opt + 108);
+  const sec = opt + 240;
+  image.write(".text", sec, "latin1");
+  image.writeUInt32LE(section.length, sec + 16);
+  image.writeUInt32LE(sizeOfHeaders, sec + 20);
+  section.copy(image, sizeOfHeaders);
+  if (!cert) return image;
+  const certEntry = opt + 112 + 32;
+  image.writeUInt32LE(image.length, certEntry);
+  image.writeUInt32LE(cert, certEntry + 4);
+  return Buffer.concat([image, Buffer.alloc(cert, 0x5a)]);
+}
+
+test("a plain file digests to its whole-file sha256, for any arch", () => {
+  const bytes = Buffer.from("ffmpeg-bytes");
+  assert.equal(contentIdentity(bytes).format, "plain");
+  assert.equal(contentDigestFor(bytes, "aarch64"), sha256(bytes));
+  assert.equal(contentDigestFor(bytes, "x86_64"), sha256(bytes));
+});
+
+test("a thin Mach-O digests the same unsigned and signed, and differs from the whole-file hash", () => {
+  const unsigned = thin();
+  const signed = thin({ signed: true });
+  const a = contentIdentity(unsigned);
+  const b = contentIdentity(signed);
+  assert.equal(a.format, "macho");
+  assert.deepEqual(a.slices.map((slice) => slice.arch), ["aarch64"]);
+  assert.equal(a.slices[0].sha256, b.slices[0].sha256);
+  assert.notEqual(sha256(unsigned), sha256(signed));
+  assert.notEqual(a.slices[0].sha256, sha256(unsigned));
+  assert.equal(contentDigestFor(signed, "aarch64"), a.slices[0].sha256);
+  assert.equal(contentDigestFor(signed, "x86_64"), undefined);
+});
+
+test("changing a code byte changes the Mach-O digest", () => {
+  const changed = thin({ data: body(300, 7) });
+  assert.notEqual(contentIdentity(changed).slices[0].sha256, contentIdentity(thin()).slices[0].sha256);
+});
+
+test("x86_64 pages are 4 KiB and arm64 pages 16 KiB, so the same bytes digest differently per arch", () => {
+  const arm = contentIdentity(thin({ cputype: CPU_ARM64 })).slices[0];
+  const intel = contentIdentity(thin({ cputype: CPU_X86_64 })).slices[0];
+  assert.equal(arm.arch, "aarch64");
+  assert.equal(intel.arch, "x86_64");
+  assert.notEqual(arm.sha256, intel.sha256);
+});
+
+test("a universal Mach-O has one digest per slice, equal to the thin digests", () => {
+  const armThin = thin({ cputype: CPU_ARM64, signed: true });
+  const intelThin = thin({ cputype: CPU_X86_64 });
+  const identity = contentIdentity(fat([{ cputype: CPU_ARM64, bytes: armThin }, { cputype: CPU_X86_64, bytes: intelThin }]));
+  assert.equal(identity.format, "macho-universal");
+  assert.deepEqual(identity.slices.map((slice) => slice.arch), ["aarch64", "x86_64"]);
+  assert.equal(identity.slices[0].sha256, contentIdentity(armThin).slices[0].sha256);
+  assert.equal(identity.slices[1].sha256, contentIdentity(intelThin).slices[0].sha256);
+});
+
+test("a fat header that disagrees with its slice is malformed", () => {
+  assert.throws(() => contentIdentity(fat([{ cputype: CPU_X86_64, bytes: thin({ cputype: CPU_ARM64 }) }])), ContentDigestError);
+});
+
+test("a PE digests the same unsigned and signed (checksum and certificate table excluded)", () => {
+  const unsigned = pe();
+  const signed = pe({ checksum: 0xdeadbeef, cert: 64 });
+  const a = contentIdentity(unsigned);
+  const b = contentIdentity(signed);
+  assert.equal(a.format, "pe");
+  assert.equal(a.slices[0].arch, "x86_64");
+  assert.equal(a.slices[0].sha256, b.slices[0].sha256);
+  assert.notEqual(sha256(unsigned), sha256(signed));
+  assert.equal(contentDigestFor(signed, "x86_64"), a.slices[0].sha256);
+  assert.equal(contentDigestFor(signed, "aarch64"), undefined);
+  assert.equal(contentIdentity(pe({ machine: 0xaa64 })).slices[0].arch, "aarch64");
+});
+
+test("a certificate table that is not the tail of the PE is refused", () => {
+  const signed = pe({ cert: 64 });
+  assert.throws(() => contentIdentity(Buffer.concat([signed, Buffer.alloc(8)])), ContentDigestError);
+});
+
+test("malformed binaries are errors, never a whole-file fallback", () => {
+  assert.throws(() => contentIdentity(Buffer.from("MZ not a pe")), ContentDigestError);
+  const truncated = thin().subarray(0, 40);
+  assert.throws(() => contentIdentity(truncated), ContentDigestError);
+  const big = Buffer.alloc(64);
+  big.writeUInt32BE(0xfeedface, 0);
+  assert.throws(() => contentIdentity(big), /unsupported Mach-O flavour/);
+});

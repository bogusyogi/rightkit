+test("stopApps stops each install through the seam and reports the pids", () => {
+  const cwd = path.resolve("/rk-cwd");
+  const seen = [];
+  const results = stopApps(["a", "b"], { cwd, home: path.resolve("/rk-home"), stop: (dir) => { seen.push(dir); return dir.endsWith("a") ? [7, 8] : []; }, log: () => {} });

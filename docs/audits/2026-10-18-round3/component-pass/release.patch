diff --git a/packages/release/content-digest.mjs b/packages/release/content-digest.mjs
new file mode 100644
index 0000000..7446853
--- /dev/null
+++ b/packages/release/content-digest.mjs
@@ -0,0 +1,265 @@
+// Signature-independent content digest of a Mach-O (thin or universal), a PE image, or any other file.
+//
+// This is a byte-for-byte port of `crates/rightkit-ffmpeg/src/content_digest.rs` (the identity a rightkit-ffmpeg catalog row pins in
+// `contentSha256`). Code signing rewrites a binary (a Mach-O gains an LC_CODE_SIGNATURE blob, Authenticode adds a certificate table and
+// a checksum), so a whole-file SHA-256 of a shipped copy never equals the digest of the unsigned build that was reviewed. The digest
+// below hashes only what the signature does not touch, so unsigned, ad-hoc-signed and Developer-ID-signed copies of one build agree.
+// Every parse is bounds-checked; a structure that does not add up is a typed error, never a fallback to a whole-file hash.
+//
+//   Thin Mach-O (64-bit little-endian)  canonical image: load commands minus LC_CODE_SIGNATURE (freed bytes zeroed), __LINKEDIT sized to the
+//                                        content end (trailing zero padding dropped, vmsize page-rounded: 16 KiB arm64, 4 KiB x86_64), then the
+//                                        file bytes after the load-command area up to the content end.
+//   Universal Mach-O                     one thin digest per slice (padding and the fat header are not hashed).
+//   PE                                   the Authenticode image hash: everything except CheckSum, the certificate-table directory entry and the
+//                                        certificate table itself.
+//   anything else                        the plain SHA-256 of the bytes.
+import { createHash } from "node:crypto";
+
+export class ContentDigestError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = "ContentDigestError";
+    this.code = "CONTENT_DIGEST_MALFORMED";
+  }
+}
+
+const MH_MAGIC_64 = 0xfeedfacf;
+const LC_SEGMENT_64 = 0x19;
+const LC_CODE_SIGNATURE = 0x1d;
+const FAT_MAGIC = 0xcafebabe;
+const FAT_MAGIC_64 = 0xcafebabf;
+const CPU_TYPE_X86_64 = 0x01000007;
+const CPU_TYPE_ARM64 = 0x0100000c;
+const MACH_HEADER_64 = 32;
+const SEGMENT_64_MIN = 72;
+const CODE_SIGNATURE_CMD = 16;
+const MAX_FAT_ARCHS = 16;
+const UNSUPPORTED_MACHO_MAGICS = new Set([0xfeedface, 0xfeedfacf, 0xcefaedfe, 0xcffaedfe, 0xbebafeca, 0xbfbafeca]);
+
+const bad = (message) => { throw new ContentDigestError(message); };
+const sha256 = (...parts) => {
+  const hash = createHash("sha256");
+  for (const part of parts) hash.update(part);
+  return hash.digest("hex");
+};
+
+function reader(bytes, width, read) {
+  return (at) => (Number.isSafeInteger(at) && at >= 0 && at + width <= bytes.length ? read(bytes, at) : undefined);
+}
+const le16 = (bytes, at) => reader(bytes, 2, (b, i) => b.readUInt16LE(i))(at);
+const le32 = (bytes, at) => reader(bytes, 4, (b, i) => b.readUInt32LE(i))(at);
+const be32 = (bytes, at) => reader(bytes, 4, (b, i) => b.readUInt32BE(i))(at);
+const le64 = (bytes, at) => reader(bytes, 8, (b, i) => b.readBigUInt64LE(i))(at);
+const be64 = (bytes, at) => reader(bytes, 8, (b, i) => b.readBigUInt64BE(i))(at);
+const must = (value, why) => (value === undefined ? bad(why) : value);
+const safe = (big, why) => (typeof big === "bigint" && big <= BigInt(Number.MAX_SAFE_INTEGER) ? Number(big) : bad(why));
+
+function archName(cputype) {
+  if (cputype === CPU_TYPE_ARM64) return "aarch64";
+  if (cputype === CPU_TYPE_X86_64) return "x86_64";
+  return bad("unsupported CPU type");
+}
+
+const roundUp = (value, to) => Math.floor((value + to - 1) / to) * to;
+
+/** Digest of one thin Mach-O: { arch, sha256 }. */
+function machoSliceDigest(slice) {
+  const err = (why) => bad(`Mach-O: ${why}`);
+  if (le32(slice, 0) !== MH_MAGIC_64) err("not a 64-bit little-endian Mach-O");
+  const cputype = must(le32(slice, 4), "Mach-O: truncated header");
+  const arch = archName(cputype);
+  const ncmds = must(le32(slice, 16), "Mach-O: truncated header");
+  const sizeofcmds = must(le32(slice, 20), "Mach-O: truncated header");
+  const cmdsEnd = MACH_HEADER_64 + sizeofcmds;
+  if (cmdsEnd > slice.length) err("load commands run past the end of the file");
+
+  // (offset, size, cmd) of every command, validated and exactly tiling the command area.
+  const commands = [];
+  let offset = MACH_HEADER_64;
+  for (let index = 0; index < ncmds; index += 1) {
+    const cmd = must(le32(slice, offset), "Mach-O: truncated load command");
+    const size = must(le32(slice, offset + 4), "Mach-O: truncated load command");
+    if (size < 8 || size % 8 !== 0 || offset + size > cmdsEnd) err("load command size is invalid");
+    commands.push({ offset, size, cmd });
+    offset += size;
+  }
+  if (offset !== cmdsEnd) err("load commands do not fill sizeofcmds");
+
+  let signature;
+  let linkedit;
+  commands.forEach((command, index) => {
+    if (command.cmd === LC_CODE_SIGNATURE) {
+      if (command.size !== CODE_SIGNATURE_CMD || signature !== undefined) err("invalid or repeated LC_CODE_SIGNATURE");
+      signature = index;
+    } else if (command.cmd === LC_SEGMENT_64) {
+      if (command.size < SEGMENT_64_MIN) err("short LC_SEGMENT_64");
+      const name = slice.subarray(command.offset + 8, command.offset + 24);
+      const nul = name.indexOf(0);
+      if (name.subarray(0, nul === -1 ? name.length : nul).toString("latin1") === "__LINKEDIT") {
+        if (linkedit !== undefined) err("repeated __LINKEDIT");
+        linkedit = index;
+      }
+    }
+  });
+  if (linkedit === undefined) err("no __LINKEDIT segment");
+  const leOff = commands[linkedit].offset;
+  const vmsize = safe(le64(slice, leOff + 32), "Mach-O: truncated __LINKEDIT");
+  const fileoff = safe(le64(slice, leOff + 40), "Mach-O: truncated __LINKEDIT");
+  const filesize = safe(le64(slice, leOff + 48), "Mach-O: truncated __LINKEDIT");
+  const linkeditEnd = fileoff + filesize;
+  const length = slice.length;
+  if (fileoff < cmdsEnd || linkeditEnd !== length || vmsize < filesize || vmsize % 0x1000 !== 0) err("__LINKEDIT does not run to the end of the file");
+
+  let contentEnd = length;
+  if (signature !== undefined) {
+    const at = commands[signature].offset;
+    const dataoff = must(le32(slice, at + 8), "Mach-O: truncated signature");
+    const datasize = must(le32(slice, at + 12), "Mach-O: truncated signature");
+    if (dataoff < fileoff || dataoff + datasize !== length) err("code signature is not the tail of __LINKEDIT");
+    contentEnd = dataoff;
+  }
+  // Drop codesign's alignment padding (and nothing above __LINKEDIT's start).
+  let end = contentEnd;
+  while (end > fileoff && slice[end - 1] === 0) end -= 1;
+  const canonicalFilesize = end - fileoff;
+  const page = cputype === CPU_TYPE_ARM64 ? 0x4000 : 0x1000;
+  const canonicalVmsize = roundUp(canonicalFilesize, page);
+
+  // Rebuild the load-command area without the signature command; the freed bytes at its end are zero.
+  const head = Buffer.alloc(cmdsEnd);
+  slice.copy(head, 0, 0, MACH_HEADER_64);
+  let cursor = MACH_HEADER_64;
+  let newLinkeditAt = 0;
+  let removed = 0;
+  commands.forEach((command, index) => {
+    if (index === signature) { removed = command.size; return; }
+    if (index === linkedit) newLinkeditAt = cursor;
+    slice.copy(head, cursor, command.offset, command.offset + command.size);
+    cursor += command.size;
+  });
+  head.writeBigUInt64LE(BigInt(canonicalVmsize), newLinkeditAt + 32);
+  head.writeBigUInt64LE(BigInt(canonicalFilesize), newLinkeditAt + 48);
+  head.writeUInt32LE(ncmds - (signature === undefined ? 0 : 1), 16);
+  head.writeUInt32LE(sizeofcmds - removed, 20);
+  return { arch, sha256: sha256(head, slice.subarray(cmdsEnd, end)) };
+}
+
+function fatIdentity(bytes) {
+  const err = (why) => bad(`universal Mach-O: ${why}`);
+  const wide = be32(bytes, 0) === FAT_MAGIC_64;
+  const count = must(be32(bytes, 4), "universal Mach-O: truncated header");
+  if (count === 0 || count > MAX_FAT_ARCHS) err("implausible architecture count");
+  const entrySize = wide ? 32 : 20;
+  const tableEnd = 8 + entrySize * count;
+  if (tableEnd > bytes.length) err("architecture table runs past the end of the file");
+  const slices = [];
+  const seen = [];
+  const ranges = [];
+  for (let index = 0; index < count; index += 1) {
+    const at = 8 + index * entrySize;
+    const cputype = must(be32(bytes, at), "universal Mach-O: truncated entry");
+    const offset = wide ? safe(be64(bytes, at + 8), "universal Mach-O: truncated entry") : must(be32(bytes, at + 8), "universal Mach-O: truncated entry");
+    const size = wide ? safe(be64(bytes, at + 16), "universal Mach-O: truncated entry") : must(be32(bytes, at + 12), "universal Mach-O: truncated entry");
+    const end = offset + size;
+    if (size === 0 || offset < tableEnd || end > bytes.length) err("slice is empty or out of bounds");
+    if (seen.includes(cputype)) err("duplicate architecture");
+    if (ranges.some(([start, stop]) => offset < stop && start < end)) err("slices overlap");
+    seen.push(cputype);
+    ranges.push([offset, end]);
+    const digest = machoSliceDigest(bytes.subarray(offset, end));
+    if (digest.arch !== archName(cputype)) err("slice architecture differs from the fat header");
+    slices.push(digest);
+  }
+  return { format: "macho-universal", slices };
+}
+
+/** Authenticode SHA-256 of a PE image: { arch, sha256 }. */
+function peDigest(bytes) {
+  const err = (why) => bad(`PE: ${why}`);
+  const length = bytes.length;
+  const pe = must(le32(bytes, 0x3c), "PE: no PE header offset");
+  if (bytes.subarray(pe, pe + 4).toString("latin1") !== "PE\0\0" || pe + 4 > length) err("missing PE signature");
+  const machine = must(le16(bytes, pe + 4), "PE: truncated COFF header");
+  const arch = machine === 0x8664 ? "x86_64" : machine === 0xaa64 ? "aarch64" : err("unsupported machine type");
+  const nsections = must(le16(bytes, pe + 6), "PE: truncated COFF header");
+  const optSize = must(le16(bytes, pe + 20), "PE: truncated COFF header");
+  const opt = pe + 24;
+  const sectionsAt = opt + optSize;
+  if (sectionsAt > length) err("optional header runs past the end of the file");
+  const magic = le16(bytes, opt);
+  const dirs = magic === 0x10b ? 96 : magic === 0x20b ? 112 : err("unknown optional header magic");
+  if (optSize < dirs) err("optional header too short");
+  const checksumAt = opt + 64;
+  const sizeOfHeaders = must(le32(bytes, opt + 60), "PE: truncated optional header");
+  const dirCount = must(le32(bytes, opt + dirs - 4), "PE: truncated optional header");
+  const certEntry = dirCount > 4 && optSize >= dirs + 5 * 8 ? opt + dirs + 4 * 8 : undefined;
+  const tableEnd = sectionsAt + nsections * 40;
+  if (tableEnd > length) err("section table runs past the end of the file");
+  let floor = checksumAt + 4;
+  if (certEntry !== undefined) floor = Math.max(floor, certEntry + 8);
+  if (sizeOfHeaders > length || sizeOfHeaders < Math.max(floor, tableEnd)) err("SizeOfHeaders is inconsistent");
+
+  let certOffset = 0;
+  let certSize = 0;
+  if (certEntry !== undefined) {
+    certOffset = must(le32(bytes, certEntry), "PE: truncated directory");
+    certSize = must(le32(bytes, certEntry + 4), "PE: truncated directory");
+  }
+  if (certSize > 0 && (certOffset < sizeOfHeaders || certOffset + certSize !== length)) err("certificate table is not the tail of the file");
+
+  const sections = [];
+  for (let index = 0; index < nsections; index += 1) {
+    const at = sectionsAt + index * 40;
+    const size = must(le32(bytes, at + 16), "PE: truncated section");
+    const offset = must(le32(bytes, at + 20), "PE: truncated section");
+    if (size > 0) sections.push([offset, size]);
+  }
+  sections.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
+
+  const parts = [bytes.subarray(0, checksumAt)];
+  if (certEntry !== undefined) {
+    parts.push(bytes.subarray(checksumAt + 4, certEntry));
+    parts.push(bytes.subarray(certEntry + 8, sizeOfHeaders));
+  } else parts.push(bytes.subarray(checksumAt + 4, sizeOfHeaders));
+  let hashed = sizeOfHeaders;
+  let previousEnd = sizeOfHeaders;
+  const bodyEnd = length - certSize;
+  for (const [offset, size] of sections) {
+    const end = offset + size;
+    if (offset < previousEnd || end > bodyEnd) err("section overlaps the headers or the certificate table");
+    parts.push(bytes.subarray(offset, end));
+    hashed += size;
+    previousEnd = end;
+  }
+  // Authenticode hashes the trailing bytes starting at the count already hashed.
+  if (hashed > bodyEnd) err("hashed bytes exceed the file");
+  parts.push(bytes.subarray(hashed, bodyEnd));
+  return { arch, sha256: sha256(...parts) };
+}
+
+/**
+ * The signature-independent identity of `bytes`: `{ format: "macho" | "macho-universal" | "pe" | "plain", slices: [{ arch, sha256 }] }`.
+ * `arch` is "aarch64" or "x86_64" (null for a plain file); a universal Mach-O has one slice per architecture in fat-header order.
+ */
+export function contentIdentity(bytes) {
+  const buffer = Buffer.isBuffer(bytes) ? bytes : Buffer.from(bytes);
+  const magicBe = be32(buffer, 0);
+  const magicLe = le32(buffer, 0);
+  if (magicBe === FAT_MAGIC || magicBe === FAT_MAGIC_64) return fatIdentity(buffer);
+  if (magicLe === MH_MAGIC_64) return { format: "macho", slices: [machoSliceDigest(buffer)] };
+  // 32-bit, big-endian and swapped-fat Mach-O magics: not supported, never plain-hashed.
+  if (magicBe !== undefined && UNSUPPORTED_MACHO_MAGICS.has(magicBe)) bad("unsupported Mach-O flavour (only 64-bit little-endian is catalogued)");
+  if (buffer.length >= 2 && buffer[0] === 0x4d && buffer[1] === 0x5a) return { format: "pe", slices: [peDigest(buffer)] };
+  return { format: "plain", slices: [{ arch: null, sha256: sha256(buffer) }] };
+}
+
+/**
+ * The digest a catalog row's `contentSha256` is compared with: the plain SHA-256 for a plain file, otherwise the slice for `arch`
+ * ("aarch64" or "x86_64"). Returns undefined when a Mach-O or PE has no slice for `arch`. A universal Mach-O is the caller's to
+ * judge slice by slice (use `contentIdentity`).
+ */
+export function contentDigestFor(bytes, arch) {
+  const identity = contentIdentity(bytes);
+  if (identity.format === "plain") return identity.slices[0].sha256;
+  return identity.slices.find((slice) => slice.arch === arch)?.sha256;
+}
diff --git a/packages/release/content-digest.test.mjs b/packages/release/content-digest.test.mjs
new file mode 100644
index 0000000..dedb9b5
--- /dev/null
+++ b/packages/release/content-digest.test.mjs
@@ -0,0 +1,172 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import test from "node:test";
+import { ContentDigestError, contentDigestFor, contentIdentity } from "./content-digest.mjs";
+
+const sha256 = (bytes) => createHash("sha256").update(bytes).digest("hex");
+const CPU_ARM64 = 0x0100000c;
+const CPU_X86_64 = 0x01000007;
+
+function segment(name, vmsize, fileoff, filesize) {
+  const b = Buffer.alloc(72);
+  b.writeUInt32LE(0x19, 0);
+  b.writeUInt32LE(72, 4);
+  b.write(name, 8, "latin1");
+  b.writeBigUInt64LE(BigInt(vmsize), 32);
+  b.writeBigUInt64LE(BigInt(fileoff), 40);
+  b.writeBigUInt64LE(BigInt(filesize), 48);
+  return b;
+}
+
+function header(cputype, ncmds, sizeofcmds) {
+  const b = Buffer.alloc(32);
+  b.writeUInt32LE(0xfeedfacf, 0);
+  b.writeUInt32LE(cputype, 4);
+  b.writeUInt32LE(2, 12);
+  b.writeUInt32LE(ncmds, 16);
+  b.writeUInt32LE(sizeofcmds, 20);
+  return b;
+}
+
+const body = (length, seed = 0) => Buffer.from(Array.from({ length }, (_, i) => ((i + seed) % 250) + 1));
+
+/** A thin Mach-O. The unsigned form leaves 16 zero bytes of load-command room; the signed form spends them on LC_CODE_SIGNATURE. */
+function thin({ cputype = CPU_ARM64, signed = false, data = body(300) } = {}) {
+  if (!signed) {
+    return Buffer.concat([header(cputype, 1, 72), segment("__LINKEDIT", 0x1000, 120, data.length), Buffer.alloc(16), data]);
+  }
+  const blob = Buffer.alloc(24, 0x7e);
+  const dataoff = 120 + data.length + 8;
+  const signature = Buffer.alloc(16);
+  signature.writeUInt32LE(0x1d, 0);
+  signature.writeUInt32LE(16, 4);
+  signature.writeUInt32LE(dataoff, 8);
+  signature.writeUInt32LE(blob.length, 12);
+  const filesize = dataoff + blob.length - 120;
+  return Buffer.concat([header(cputype, 2, 88), segment("__LINKEDIT", 0x1000, 120, filesize), signature, data, Buffer.alloc(8), blob]);
+}
+
+function fat(slices) {
+  const entries = [];
+  let offset = 64;
+  const placed = slices.map(({ cputype, bytes }) => {
+    const entry = Buffer.alloc(20);
+    entry.writeUInt32BE(cputype, 0);
+    entry.writeUInt32BE(offset, 8);
+    entry.writeUInt32BE(bytes.length, 12);
+    entries.push(entry);
+    const start = offset;
+    offset += bytes.length + ((16 - (bytes.length % 16)) % 16);
+    return { start, bytes };
+  });

diff --git a/packages/release/binary-license-notices.mjs b/packages/release/binary-license-notices.mjs
new file mode 100644
index 0000000..5b27a45
--- /dev/null
+++ b/packages/release/binary-license-notices.mjs
@@ -0,0 +1,161 @@
+#!/usr/bin/env node
+// `right-release license-notices binaries [--config <file>] [--output <file>] [--product-name <name>] [--receipt <path>] [--check]`:
+// writes the notice appendix (one HTML file) for the binaries an app ships that no RightKit catalog row covers (a downloaded yt-dlp, a
+// vendored tool, a command-built helper). Catalog-backed sidecars (ffmpeg, onnxruntime, pdfium, whisper) write their own notices when
+// they are staged; everything else must be declared here, with its licence text, or the build has no right to ship it.
+//
+//   legal: { binaryNotices: { output: "legal/THIRD_PARTY_BINARIES.html", productName: "ScrapeRight", receipt: "src-tauri/binaries/stage-sidecar.json",
+//            binaries: [{ name: "yt-dlp", version: "2026.03.17" | "self-updating", license: "Unlicense", sourceUrl: "https://github.com/yt-dlp/yt-dlp",
+//                         files: ["legal/texts/yt-dlp-UNLICENSE.txt"], covers?: ["yt-dlp-helper"] }] } }
+//
+// Every `files` entry is an app-relative text file that must exist; no licence text is ever invented. With a `receipt` (the
+// stage-sidecar receipt, also settable with `--receipt`) every staged file of kind remote, command, cmake or prebuilt must belong to a
+// declared binary - by its entry name, or a name listed in `covers` - or the run fails naming the uncovered ones. The page records the
+// receipt-independent inputs only (declared fields and the sha256 of each text), so the same declaration always produces the same bytes.
+// `--check` writes nothing and exits 1 when the file on disk differs.
+import { createHash } from "node:crypto";
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { CommandSpecError, loadAppConfig, relativeInside } from "./command-spec.mjs";
+import { escapeHtml } from "./npm-license-notices.mjs";
+
+const fail = (message) => { throw new CommandSpecError(message); };
+const isObject = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+const KEYS = ["output", "productName", "receipt", "binaries"];
+const BINARY_KEYS = ["name", "version", "license", "sourceUrl", "files", "covers"];
+/** Receipt kinds with no catalog row behind them. */
+export const NON_CATALOG_KINDS = Object.freeze(["remote", "command", "cmake", "prebuilt"]);
+
+/** Resolve and validate `legal.binaryNotices` plus flags. */
+export function resolveBinaryNoticeOptions(config, flags = {}) {
+  const declared = config?.legal?.binaryNotices;
+  if (!isObject(declared)) fail("legal.binaryNotices must be an object");
+  const unknown = Object.keys(declared).filter((key) => !KEYS.includes(key));
+  if (unknown.length) fail(`legal.binaryNotices has unknown key(s): ${unknown.join(", ")} (allowed: ${KEYS.join(", ")})`);
+  const output = flags.output ?? declared.output;
+  if (output === undefined) fail("no output file: set legal.binaryNotices.output or pass --output");
+  relativeInside(output, "legal.binaryNotices.output");
+  const productName = flags.productName ?? declared.productName;
+  if (typeof productName !== "string" || !productName.trim()) fail("no product name: set legal.binaryNotices.productName or pass --product-name");
+  const receipt = flags.receipt ?? declared.receipt;
+  if (receipt !== undefined) relativeInside(receipt, "legal.binaryNotices.receipt");
+  if (!Array.isArray(declared.binaries) || !declared.binaries.length) fail("legal.binaryNotices.binaries must be a non-empty list");
+  const names = new Set();
+  const binaries = declared.binaries.map((item, index) => {
+    const label = `legal.binaryNotices.binaries[${index}]`;
+    if (!isObject(item)) fail(`${label} must be an object`);
+    const extra = Object.keys(item).filter((key) => !BINARY_KEYS.includes(key));
+    if (extra.length) fail(`${label} has unknown key(s): ${extra.join(", ")} (allowed: ${BINARY_KEYS.join(", ")})`);
+    for (const key of ["name", "version", "license"]) if (typeof item[key] !== "string" || !item[key].trim()) fail(`${label}.${key} must be a non-empty string`);
+    if (typeof item.sourceUrl !== "string" || !/^https:\/\/[^\s/]+\/\S*$/.test(item.sourceUrl)) fail(`${label}.sourceUrl must be an https:// URL of the source or release`);
+    if (!Array.isArray(item.files) || !item.files.length) fail(`${label}.files must list at least one licence/notice text file`);
+    const files = item.files.map((file, fileIndex) => relativeInside(file, `${label}.files[${fileIndex}]`));
+    const covers = item.covers ?? [];
+    if (!Array.isArray(covers) || covers.some((name) => typeof name !== "string" || !name.trim())) fail(`${label}.covers must be a list of staged entry names`);
+    for (const name of [item.name, ...covers]) {
+      if (names.has(name)) fail(`${label}: ${name} is declared twice`);
+      names.add(name);
+    }
+    return { name: item.name, version: item.version, license: item.license, sourceUrl: item.sourceUrl, files, covers: [...covers] };
+  });
+  return { output, productName, receipt, binaries };
+}
+
+/** The names of staged non-catalog entries that no declared binary covers. */
+export function uncoveredBinaries(receipt, binaries) {
+  const covered = new Set(binaries.flatMap((binary) => [binary.name, ...binary.covers]));
+  const missing = new Set();
+  for (const file of receipt?.files ?? []) {
+    if (!NON_CATALOG_KINDS.includes(file.kind)) continue;
+    const name = file.entryName ?? file.command ?? file.name;
+    if (!covered.has(name)) missing.add(name);
+  }
+  return [...missing].sort();
+}
+
+/** Render the appendix. `texts` maps an app-relative file to its text. Returns the HTML. */
+export function renderBinaryNotices({ productName, binaries, texts }) {
+  const sections = binaries.map((binary) => {
+    const bodies = binary.files.map((file) => `<h3>${escapeHtml(path.posix.basename(file))}</h3><pre>${escapeHtml(texts.get(file))}</pre>`).join("\n");
+    const digests = binary.files.map((file) => `${escapeHtml(path.posix.basename(file))} sha256=${createHash("sha256").update(texts.get(file)).digest("hex")}`).join("; ");
+    return `<section><h2>${escapeHtml(binary.name)} ${escapeHtml(binary.version)}</h2><p>License: ${escapeHtml(binary.license)}</p><p>Source: ${escapeHtml(binary.sourceUrl)}</p><p>Texts: ${digests}</p>\n${bodies}</section>`;
+  });
+  return `<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><title>${escapeHtml(productName)} bundled program licenses</title></head><body>
+<h1>${escapeHtml(productName)} bundled program licenses</h1>
+<p>Programs shipped with ${escapeHtml(productName)} that are not Cargo or npm dependencies; generated-by=right-release license-notices binaries</p>
+${sections.join("\n")}
+</body></html>
+`;
+}
+
+/** Generate (or check) the appendix for the app at `appRoot`. File access is injectable. */
+export function generateBinaryNotices({ appRoot, config, flags = {}, check = false, exists = existsSync, readText = (file) => readFileSync(file, "utf8"), writeText = (file, text) => { mkdirSync(path.dirname(file), { recursive: true }); writeFileSync(file, text); } }) {
+  const { output, productName, receipt, binaries } = resolveBinaryNoticeOptions(config, flags);
+  const texts = new Map();
+  for (const binary of binaries) {
+    for (const file of binary.files) {
+      const absolute = path.join(appRoot, file);
+      if (!exists(absolute)) fail(`${binary.name}: licence text ${file} does not exist; no text is invented, add the file`);
+      const text = String(readText(absolute)).replace(/\r\n/g, "\n");
+      if (!text.trim()) fail(`${binary.name}: licence text ${file} is empty`);
+      texts.set(file, text);
+    }
+  }
+  let uncovered = [];
+  if (receipt !== undefined) {
+    const receiptFile = path.join(appRoot, receipt);
+    if (!exists(receiptFile)) fail(`the stage-sidecar receipt ${receipt} does not exist; run right-release stage-sidecar first`);
+    let parsed;
+    try { parsed = JSON.parse(readText(receiptFile)); } catch (error) { fail(`the stage-sidecar receipt ${receipt} is not JSON (${error.message})`); }
+    uncovered = uncoveredBinaries(parsed, binaries);
+    if (uncovered.length) fail(`staged program(s) with no declared licence notice: ${uncovered.join(", ")}; declare them in legal.binaryNotices.binaries (name or covers)`);
+  }
+  const html = renderBinaryNotices({ productName, binaries, texts });
+  const target = path.join(appRoot, output);
+  if (check) {
+    const current = exists(target) ? String(readText(target)).replace(/\r\n/g, "\n") : null;
+    return { target, binaryCount: binaries.length, uncovered, upToDate: current === html };
+  }
+  writeText(target, html);
+  return { target, binaryCount: binaries.length, uncovered, upToDate: true };
+}
+
+export function parseBinaryNoticeArgs(argv) {
+  const opts = { config: "right-release.config.mjs", output: undefined, productName: undefined, receipt: undefined, check: false };
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i];
+    if (arg === "--config" || arg === "--output" || arg === "--product-name" || arg === "--receipt") {
+      const value = argv[i + 1];
+      if (!value || value.startsWith("--")) throw new Error(`${arg} needs a value`);
+      opts[arg === "--product-name" ? "productName" : arg.slice(2)] = value;
+      i += 1;
+    } else if (arg === "--check") opts.check = true;
+    else throw new Error(`unknown license-notices argument: ${arg}`);
+  }
+  return opts;
+}
+
+export async function main(argv = process.argv.slice(2)) {
+  const opts = parseBinaryNoticeArgs(argv);
+  const { config, appRoot } = await loadAppConfig(opts.config);
+  const outcome = generateBinaryNotices({ appRoot, config, flags: { output: opts.output, productName: opts.productName, receipt: opts.receipt }, check: opts.check });
+  if (opts.check) {
+    if (!outcome.upToDate) {
+      console.error(`right-release license-notices: ${outcome.target} is out of date; run right-release license-notices binaries`);
+      return 1;
+    }
+    console.log(`${outcome.target} is up to date (${outcome.binaryCount} program notices)`);
+    return 0;
+  }
+  console.log(`wrote ${outcome.binaryCount} program notices to ${outcome.target}`);
+  return 0;
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? "").href) {
+  main().then((code) => { process.exitCode = code; }, (error) => {
+    console.error(`right-release license-notices: ${error.code ? `[${error.code}] ` : ""}${error.message}`);
+    process.exitCode = 1;
+  });
+}
diff --git a/packages/release/binary-license-notices.test.mjs b/packages/release/binary-license-notices.test.mjs
new file mode 100644
index 0000000..3be5c88
--- /dev/null
+++ b/packages/release/binary-license-notices.test.mjs
@@ -0,0 +1,50 @@
+import assert from "node:assert/strict";
+import path from "node:path";
+import test from "node:test";
+import { generateBinaryNotices, parseBinaryNoticeArgs, renderBinaryNotices, resolveBinaryNoticeOptions, uncoveredBinaries } from "./binary-license-notices.mjs";
+
+const APP = path.resolve("/rk-app");
+const binary = (over = {}) => ({ name: "yt-dlp", version: "self-updating", license: "Unlicense", sourceUrl: "https://github.com/yt-dlp/yt-dlp", files: ["legal/yt-dlp.txt"], ...over });
+const config = (over = {}, extra = {}) => ({ legal: { binaryNotices: { output: "legal/BIN.html", productName: "ScrapeRight", binaries: [binary()], ...extra, ...over } } });
+const key = (name) => path.normalize(path.join(APP, name));
+const fakeFiles = (initial) => {
+  const files = new Map(Object.entries(initial).map(([k, v]) => [key(k), v]));
+  return { files, exists: (f) => files.has(path.normalize(f)), readText: (f) => files.get(path.normalize(f)), writeText: (f, t) => files.set(path.normalize(f), t) };
+};
+
+test("the appendix lists every declared program with its licence text and hashes; the same input gives the same bytes", () => {
+  const io = fakeFiles({ "legal/yt-dlp.txt": "This is free and unencumbered software\r\n" });
+  const first = generateBinaryNotices({ appRoot: APP, config: config(), ...io });
+  const html = io.files.get(key("legal/BIN.html"));
+  assert.match(html, /<h2>yt-dlp self-updating<\/h2>/);
+  assert.match(html, /free and unencumbered/);
+  assert.match(html, /Source: https:\/\/github\.com\/yt-dlp\/yt-dlp/);
+  assert.equal(first.binaryCount, 1);
+  assert.equal(generateBinaryNotices({ appRoot: APP, config: config(), check: true, ...io }).upToDate, true);
+  io.files.set(key("legal/BIN.html"), "stale");
+  assert.equal(generateBinaryNotices({ appRoot: APP, config: config(), check: true, ...io }).upToDate, false);
+  assert.equal(renderBinaryNotices({ productName: "P<", binaries: [binary()], texts: new Map([["legal/yt-dlp.txt", "a&b"]]) }).includes("P&lt;"), true);
+});
+
+test("a missing or empty licence text is an error (no text is invented)", () => {
+  assert.throws(() => generateBinaryNotices({ appRoot: APP, config: config(), ...fakeFiles({}) }), /does not exist/);
+  assert.throws(() => generateBinaryNotices({ appRoot: APP, config: config(), ...fakeFiles({ "legal/yt-dlp.txt": "  " }) }), /is empty/);
+});
+
+test("with a stage-sidecar receipt every staged non-catalog program must be declared", () => {
+  const receipt = { files: [{ kind: "remote", name: "yt-dlp" }, { kind: "remote", name: "base.zip", entryName: "yt-dlp" }, { kind: "command", name: "helper-0", command: "helper" }, { kind: "ffmpeg", name: "ffmpeg" }, { kind: "cargo-bin", name: "engine" }] };
+  assert.deepEqual(uncoveredBinaries(receipt, [binary()]), ["helper"]);
+  assert.deepEqual(uncoveredBinaries(receipt, [binary({ covers: ["helper"] })]), []);
+  const io = fakeFiles({ "legal/yt-dlp.txt": "text", "stage.json": JSON.stringify(receipt) });
+  assert.throws(() => generateBinaryNotices({ appRoot: APP, config: config({}, { receipt: "stage.json" }), ...io }), /no declared licence notice: helper/);
+  assert.equal(generateBinaryNotices({ appRoot: APP, config: config({ binaries: [binary({ covers: ["helper"] })] }, { receipt: "stage.json" }), ...io }).uncovered.length, 0);
+  assert.throws(() => generateBinaryNotices({ appRoot: APP, config: config({}, { receipt: "missing.json" }), ...io }), /receipt missing\.json does not exist/);
+});
+
+test("options are validated", () => {
+  for (const bad of [{ output: undefined }, { productName: "" }, { binaries: [] }, { binaries: [binary({ sourceUrl: "http://x" })] }, { binaries: [binary({ files: [] })] }, { binaries: [binary({ extra: 1 })] }, { binaries: [binary(), binary()] }, { binaries: [binary({ files: ["../x"] })] }, { nope: 1 }]) {
+    assert.throws(() => resolveBinaryNoticeOptions(config(bad)), /legal\.binaryNotices|no output|no product/, JSON.stringify(bad));
+  }
+  assert.throws(() => resolveBinaryNoticeOptions({}), /must be an object/);
+  assert.deepEqual(parseBinaryNoticeArgs(["--receipt", "r.json", "--check"]).receipt, "r.json");
+});
diff --git a/packages/release/broker-retry.mjs b/packages/release/broker-retry.mjs
new file mode 100644
index 0000000..2693192
--- /dev/null
+++ b/packages/release/broker-retry.mjs
@@ -0,0 +1,125 @@
+// Retry-with-backoff for the retryable RustRight broker codes.
+//
+// While the broker is cut over or restarted, a submission briefly gets one of these codes instead of a build
+// result. They mean "a runtime update is in progress, try again", never "this build failed", so `right-release dev`
+// and `doctor` wait through them (bounded) rather than failing on the first one. Any other failure is returned
+// unchanged on the first occurrence.
+
+export const RETRYABLE_BROKER_CODES = Object.freeze([
+  "RK_ACTIVATION_PENDING",
+  "RK_JOB_SUSPENDED",
+  "RK_DATA_ROOT_INITIALIZING",
+  "RK_BROKER_UNAVAILABLE",
+]);
+
+export const DEFAULT_BROKER_WAIT_MS = 180_000;
+export const MAX_BROKER_WAIT_MS = 600_000;
+export const BROKER_BACKOFF_INITIAL_MS = 500;
+export const BROKER_BACKOFF_MAX_MS = 5_000;
+
+const CODE_PATTERN = new RegExp(`\\b(${RETRYABLE_BROKER_CODES.join("|")})\\b`);
+
+const WAITING_ON = Object.freeze({
+  RK_ACTIVATION_PENDING: "the RustRight runtime update",
+  RK_JOB_SUSPENDED: "the RustRight runtime update",
+  RK_DATA_ROOT_INITIALIZING: "the RustRight data root to initialize",
+  RK_BROKER_UNAVAILABLE: "the RustRight broker to reopen",
+});
+
+/** The retryable broker code found in a spawnSync-style result (stderr, stdout, error.code, error.message), or undefined. */
+export function retryableBrokerCode(result) {
+  if (!result || typeof result !== "object") return undefined;
+  const sources = [result.error?.code, result.error?.message, result.stderr, result.stdout];
+  for (const source of sources) {
+    if (source === undefined || source === null) continue;
+    const match = CODE_PATTERN.exec(String(source));
+    if (match) return match[1];
+  }
+  return undefined;
+}
+
+/** Wait budget in milliseconds: RIGHT_RELEASE_BROKER_WAIT_MS (default 180000, capped at 600000, 0 disables waiting). */
+export function brokerWaitBudgetMs(env = process.env) {
+  const raw = env?.RIGHT_RELEASE_BROKER_WAIT_MS;
+  if (raw === undefined || raw === null || String(raw).trim() === "") return DEFAULT_BROKER_WAIT_MS;
+  const value = Number(String(raw).trim());
+  if (!Number.isFinite(value)) return DEFAULT_BROKER_WAIT_MS;
+  return Math.min(Math.max(Math.floor(value), 0), MAX_BROKER_WAIT_MS);
+}
+
+function defaultSleepSync(ms) {
+  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
+}
+
+function defaultSleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function defaultLog(message) {
+  console.error(message);
+}
+
+function seconds(ms) {
+  return Math.round(ms / 1000);
+}
+
+function waitingLine(code, elapsedMs) {
+  return `right-release: waiting for ${WAITING_ON[code]} (${code}), ${seconds(elapsedMs)}s elapsed`;
+}
+
+function exhausted(result, code, elapsedMs, label) {
+  const subject = label ? ` (${label})` : "";
+  const message = `right-release: gave up waiting for the RustRight runtime update${subject} after ${seconds(elapsedMs)}s; last broker code ${code}. Re-run once the update finishes, or raise RIGHT_RELEASE_BROKER_WAIT_MS (maximum ${MAX_BROKER_WAIT_MS}).`;
+  const base = result && typeof result === "object" ? result : {};
+  const priorStderr = base.stderr === undefined || base.stderr === null ? "" : String(base.stderr);
+  return {
+    ...base,
+    stderr: priorStderr ? `${priorStderr.replace(/\s*$/, "")}\n${message}\n` : `${message}\n`,
+    error: Object.assign(new Error(message), { code }),
+    brokerWait: { exhausted: true, code, elapsedMs, message },
+  };
+}
+
+function nextDelay(delay) {
+  return Math.min(delay * 2, BROKER_BACKOFF_MAX_MS);
+}
+
+/**
+ * Run `attempt()` (returns a spawnSync-style result) until it stops returning a retryable broker code or the
+ * wait budget is spent. Returns the final result unchanged, or an exhausted result with `brokerWait` and a clear
+ * `error` naming the last code and elapsed time.
+ */
+export function runWithBrokerRetrySync(attempt, { env = process.env, sleepSync = defaultSleepSync, now = Date.now, log = defaultLog, label } = {}) {
+  const budget = brokerWaitBudgetMs(env);
+  const start = now();
+  let delay = BROKER_BACKOFF_INITIAL_MS;
+  let result = attempt();
+  for (;;) {
+    const code = retryableBrokerCode(result);
+    if (!code || budget <= 0) return result;
+    const elapsed = now() - start;
+    if (elapsed >= budget) return exhausted(result, code, elapsed, label);
+    log(waitingLine(code, elapsed));
+    sleepSync(Math.min(delay, budget - elapsed));
+    delay = nextDelay(delay);
+    result = attempt();
+  }
+}
+
+/** Async twin of `runWithBrokerRetrySync`; `attempt()` may return a promise and `sleep(ms)` a promise. */
+export async function runWithBrokerRetry(attempt, { env = process.env, sleep = defaultSleep, now = Date.now, log = defaultLog, label } = {}) {
+  const budget = brokerWaitBudgetMs(env);
+  const start = now();
+  let delay = BROKER_BACKOFF_INITIAL_MS;
+  let result = await attempt();
+  for (;;) {
+    const code = retryableBrokerCode(result);
+    if (!code || budget <= 0) return result;
+    const elapsed = now() - start;
+    if (elapsed >= budget) return exhausted(result, code, elapsed, label);
+    log(waitingLine(code, elapsed));
+    await sleep(Math.min(delay, budget - elapsed));
+    delay = nextDelay(delay);
+    result = await attempt();
+  }
+}
diff --git a/packages/release/broker-retry.test.mjs b/packages/release/broker-retry.test.mjs
new file mode 100644
index 0000000..d36d5e6
--- /dev/null
+++ b/packages/release/broker-retry.test.mjs
@@ -0,0 +1,149 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  RETRYABLE_BROKER_CODES,
+  brokerWaitBudgetMs,
+  retryableBrokerCode,
+  runWithBrokerRetry,
+  runWithBrokerRetrySync,
+} from "./broker-retry.mjs";
+
+// A fake clock: sleeping advances time, so the loops are deterministic and instant.
+function harness(results, env = {}) {
+  let clock = 0;
+  const sleeps = [];
+  const logs = [];
+  let attempts = 0;
+  const attempt = () => {
+    const next = results[Math.min(attempts, results.length - 1)];
+    attempts += 1;
+    return typeof next === "function" ? next() : next;
+  };
+  const options = {
+    env,
+    now: () => clock,
+    sleepSync: (ms) => { sleeps.push(ms); clock += ms; },
+    sleep: async (ms) => { sleeps.push(ms); clock += ms; },
+    log: (line) => logs.push(line),
+    label: "test",
+  };
+  return { attempt, options, sleeps, logs, attempts: () => attempts };
+}
+
+const pending = (code) => ({ status: 1, stdout: "", stderr: `error: ${code}: broker busy\n` });
+
+test("the four retryable codes are frozen", () => {
+  assert.deepEqual([...RETRYABLE_BROKER_CODES], ["RK_ACTIVATION_PENDING", "RK_JOB_SUSPENDED", "RK_DATA_ROOT_INITIALIZING", "RK_BROKER_UNAVAILABLE"]);
+  assert.equal(Object.isFrozen(RETRYABLE_BROKER_CODES), true);
+});
+
+test("retryableBrokerCode scans stderr, stdout, error.code and error.message", () => {
+  assert.equal(retryableBrokerCode({ stderr: "x RK_JOB_SUSPENDED y" }), "RK_JOB_SUSPENDED");
+  assert.equal(retryableBrokerCode({ stdout: Buffer.from("RK_DATA_ROOT_INITIALIZING") }), "RK_DATA_ROOT_INITIALIZING");
+  assert.equal(retryableBrokerCode({ error: Object.assign(new Error("socket gone"), { code: "RK_BROKER_UNAVAILABLE" }) }), "RK_BROKER_UNAVAILABLE");
+  assert.equal(retryableBrokerCode({ error: new Error("RK_ACTIVATION_PENDING fence held") }), "RK_ACTIVATION_PENDING");
+  assert.equal(retryableBrokerCode({ status: 1, stderr: "error[E0425]: cannot find value" }), undefined);
+  assert.equal(retryableBrokerCode({ stderr: "RK_ACTIVATION_PENDING_EXTRA" }), undefined);
+  assert.equal(retryableBrokerCode(undefined), undefined);
+});
+
+test("each retryable code is retried and then succeeds", () => {
+  for (const code of RETRYABLE_BROKER_CODES) {
+    const h = harness([pending(code), pending(code), { status: 0, stdout: "ok", stderr: "" }]);
+    const result = runWithBrokerRetrySync(h.attempt, h.options);
+    assert.equal(result.status, 0, code);
+    assert.equal(h.attempts(), 3, code);
+    assert.deepEqual(h.sleeps, [500, 1000], code);
+    assert.equal(h.logs.length, 2, code);
+    assert.ok(h.logs[0].includes(`(${code})`), code);
+  }
+});
+
+test("the async variant retries the same way", async () => {
+  const h = harness([pending("RK_JOB_SUSPENDED"), { status: 0, stdout: "", stderr: "" }]);
+  const result = await runWithBrokerRetry(async () => h.attempt(), h.options);
+  assert.equal(result.status, 0);
+  assert.deepEqual(h.sleeps, [500]);
+  assert.equal(h.logs.length, 1);
+});
+
+test("a non-retryable failure is returned unchanged after one attempt", () => {
+  const failure = { status: 101, stdout: "", stderr: "error: could not compile `app`\n" };
+  const h = harness([failure]);
+  const result = runWithBrokerRetrySync(h.attempt, h.options);
+  assert.equal(result, failure);
+  assert.equal(h.attempts(), 1);
+  assert.deepEqual(h.sleeps, []);
+  assert.deepEqual(h.logs, []);
+});
+
+test("a spawn failure without a broker code is not retried", () => {
+  const failure = { status: null, error: Object.assign(new Error("spawn ENOENT"), { code: "ENOENT" }) };
+  const h = harness([failure]);
+  assert.equal(runWithBrokerRetrySync(h.attempt, h.options), failure);
+  assert.equal(h.attempts(), 1);
+});
+
+test("the backoff doubles from 500 ms to a 5 s cap", () => {
+  const h = harness([...Array(6).fill(pending("RK_ACTIVATION_PENDING")), { status: 0, stdout: "", stderr: "" }]);
+  const result = runWithBrokerRetrySync(h.attempt, h.options);
+  assert.equal(result.status, 0);
+  assert.deepEqual(h.sleeps, [500, 1000, 2000, 4000, 5000, 5000]);
+});
+
+test("each wait prints one line naming what it waits on and the elapsed seconds", () => {
+  const h = harness([...Array(4).fill(pending("RK_ACTIVATION_PENDING")), { status: 0, stdout: "", stderr: "" }]);
+  runWithBrokerRetrySync(h.attempt, h.options);
+  assert.deepEqual(h.logs, [
+    "right-release: waiting for the RustRight runtime update (RK_ACTIVATION_PENDING), 0s elapsed",
+    "right-release: waiting for the RustRight runtime update (RK_ACTIVATION_PENDING), 1s elapsed",
+    "right-release: waiting for the RustRight runtime update (RK_ACTIVATION_PENDING), 2s elapsed",
+    "right-release: waiting for the RustRight runtime update (RK_ACTIVATION_PENDING), 4s elapsed",
+  ]);
+});
+
+test("an exhausted budget fails with the last code and the elapsed time", () => {
+  const h = harness([pending("RK_DATA_ROOT_INITIALIZING")], { RIGHT_RELEASE_BROKER_WAIT_MS: "3000" });
+  const result = runWithBrokerRetrySync(h.attempt, h.options);
+  // Sleeps: 500, 1000, 1500 (clamped to the 1500 ms that remain) = 3000 ms, then the budget is spent.
+  assert.deepEqual(h.sleeps, [500, 1000, 1500]);
+  assert.equal(h.attempts(), 4);
+  assert.equal(result.brokerWait.exhausted, true);
+  assert.equal(result.brokerWait.code, "RK_DATA_ROOT_INITIALIZING");
+  assert.equal(result.brokerWait.elapsedMs, 3000);
+  assert.equal(result.error.code, "RK_DATA_ROOT_INITIALIZING");
+  assert.match(result.error.message, /gave up waiting for the RustRight runtime update/);
+  assert.match(result.error.message, /after 3s/);
+  assert.match(result.error.message, /RK_DATA_ROOT_INITIALIZING/);
+  assert.match(result.stderr, /RK_DATA_ROOT_INITIALIZING/);
+  assert.equal(result.status, 1);
+});
+
+test("RIGHT_RELEASE_BROKER_WAIT_MS=0 disables waiting", () => {
+  const first = pending("RK_ACTIVATION_PENDING");
+  const h = harness([first], { RIGHT_RELEASE_BROKER_WAIT_MS: "0" });
+  const result = runWithBrokerRetrySync(h.attempt, h.options);
+  assert.equal(result, first);
+  assert.equal(h.attempts(), 1);
+  assert.deepEqual(h.sleeps, []);
+  assert.deepEqual(h.logs, []);
+});
+
+test("the wait budget defaults to 180 s, honours the override and caps at 600 s", () => {
+  assert.equal(brokerWaitBudgetMs({}), 180000);
+  assert.equal(brokerWaitBudgetMs({ RIGHT_RELEASE_BROKER_WAIT_MS: "" }), 180000);
+  assert.equal(brokerWaitBudgetMs({ RIGHT_RELEASE_BROKER_WAIT_MS: "nonsense" }), 180000);
+  assert.equal(brokerWaitBudgetMs({ RIGHT_RELEASE_BROKER_WAIT_MS: "1234" }), 1234);
+  assert.equal(brokerWaitBudgetMs({ RIGHT_RELEASE_BROKER_WAIT_MS: "0" }), 0);
+  assert.equal(brokerWaitBudgetMs({ RIGHT_RELEASE_BROKER_WAIT_MS: "-5" }), 0);
+  assert.equal(brokerWaitBudgetMs({ RIGHT_RELEASE_BROKER_WAIT_MS: "99999999" }), 600000);
+});
+
+test("the default budget waits through a long runtime update before giving up", () => {
+  const h = harness([pending("RK_BROKER_UNAVAILABLE")]);
+  const result = runWithBrokerRetrySync(h.attempt, h.options);
+  assert.equal(result.brokerWait.exhausted, true);
+  assert.equal(result.brokerWait.elapsedMs, 180000);
+  assert.equal(h.sleeps.reduce((sum, ms) => sum + ms, 0), 180000);
+  assert.ok(Math.max(...h.sleeps) <= 5000);
+});

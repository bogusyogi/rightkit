+import assert from "node:assert/strict";
+import { existsSync, mkdtempSync, mkdirSync, utimesSync, writeFileSync } from "node:fs";
+import { mkdtemp } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+import { removeTrackedTempDirs, sweepStaleTestDirs, trackedTempDirs } from "./test-support/temp-cleanup.mjs";
+
+test("directories made with mkdtemp under the OS temp dir are tracked and removed on cleanup (#773)", async () => {
+  const a = mkdtempSync(path.join(os.tmpdir(), "right-release-test-cleanup-"));
+  const b = await mkdtemp(path.join(os.tmpdir(), "right-release-test-cleanup-"));
+  writeFileSync(path.join(a, "file"), "x");
+  assert.ok(trackedTempDirs().includes(path.resolve(a)));
+  assert.ok(trackedTempDirs().includes(path.resolve(b)));
+  removeTrackedTempDirs();
+  assert.equal(existsSync(a), false);
+  assert.equal(existsSync(b), false);
+  assert.deepEqual(trackedTempDirs(), []);
+});
+
+test("the stale sweep removes only old right-release-test-* directories directly under the temp dir", () => {
+  const tmp = mkdtempSync(path.join(os.tmpdir(), "rk-sweep-host-"));
+  const old = path.join(tmp, "right-release-test-old");
+  const fresh = path.join(tmp, "right-release-test-fresh");
+  const other = path.join(tmp, "unrelated-old");
+  for (const dir of [old, fresh, other]) mkdirSync(dir);
+  const longAgo = new Date(Date.now() - 3 * 24 * 60 * 60 * 1000);
+  utimesSync(old, longAgo, longAgo);
+  utimesSync(other, longAgo, longAgo);
+  assert.deepEqual(sweepStaleTestDirs({ tmp }), [old]);
+  assert.equal(existsSync(old), false);
+  assert.equal(existsSync(fresh), true);
+  assert.equal(existsSync(other), true);
+});

diff --git a/packages/release/runtime-artifacts-config.test.mjs b/packages/release/runtime-artifacts-config.test.mjs
new file mode 100644
index 0000000..aed16a2
--- /dev/null
+++ b/packages/release/runtime-artifacts-config.test.mjs
@@ -0,0 +1,18 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { assertRuntimeArtifactsConfig, runtimeArtifactsProblems, RuntimeArtifactsConfigError } from "./runtime-artifacts-config.mjs";
+
+const consumer = { schema: 1, appKey: "scraperight", role: "consumer", authorityAppKey: "heardright", artifactKind: "asr-model", delivery: "private-r2", entitlementTier: "pro" };
+
+test("an absent block is fine; a valid asr adapter is reported for the doctor output", () => {
+  assert.deepEqual(assertRuntimeArtifactsConfig(undefined), []);
+  assert.deepEqual(assertRuntimeArtifactsConfig({ asr: consumer }), [{ family: "asr", role: "consumer" }]);
+  assert.deepEqual(assertRuntimeArtifactsConfig({ asr: { ...consumer, appKey: "heardright", role: "authority", extra: true } }), [{ family: "asr", role: "authority" }]);
+});
+
+test("a malformed or unknown block is an error instead of being ignored (#753)", () => {
+  for (const bad of ["x", [], { tts: consumer }, { asr: null }, { asr: { ...consumer, schema: 2 } }, { asr: { ...consumer, role: "other" } }, { asr: { ...consumer, delivery: "public" } }, { asr: { ...consumer, authorityAppKey: "x" } }, { asr: { ...consumer, role: "authority" } }, { asr: { ...consumer, appKey: "" } }]) {
+    assert.throws(() => assertRuntimeArtifactsConfig(bad), RuntimeArtifactsConfigError, JSON.stringify(bad));
+  }
+  assert.match(runtimeArtifactsProblems({ tts: consumer })[0], /unknown artifact family/);
+});

@@ -0,0 +1,181 @@
+// Declarative staging of macOS helper apps into a release build (before signing).
+//
+//   targets.mac.macHelpers = [{
+//     kind: "cloudkit",                         // only kind today: swift/RightKitCloudKitHelper
+//     product: "rightkit-cloudkit-helper",      // SwiftPM executable product (also the helper's CFBundleExecutable)
+//     bundleId: "app.example.cloudkit-helper",  // the helper's OWN bundle id under the app's team
+//     containerId: "iCloud.app.example",        // CloudKit container the helper may open
+//     profile: "release/cloudkit-helper.provisionprofile",   // Developer ID profile that authorizes the helper (relative to the app root)
+//     dest: "Contents/Library/LoginItems/RightKitCloudKitHelper.app",  // path inside the main .app
+//     teamId: "ABCDE12345",                     // optional; default env APPLE_TEAM_ID
+//     package: "path/to/RightKitCloudKitHelper",// optional; default the swift package shipped in this repository
+//   }]
+//
+// Three steps, all pure of signing:
+//   1. prepareMacHelperEntitlements: fill entitlements.template.plist (TEAMID, bundle id, container id) into
+//      <root>/.right-release/mac-helpers/<product>.entitlements.plist. Runs before sign validation (the file must exist then).
+//   2. stageMacHelpers: `swift build -c release` universal (arm64 + x86_64), wrap the binary in <dest> with an Info.plist.
+//   3. macHelperNestedCode: registers each helper as sign.nestedCode (identifier, filled entitlements, provisioningProfile), so
+//      the nested signing path embeds the profile (mac-nested-profile.mjs: proves it authorizes the entitlements), signs the helper
+//      inside-out and the app seal covers it. A bare Mach-O is killed at launch; the iCloud keys are honoured only for an own .app.
+import { chmodSync, copyFileSync, existsSync, mkdirSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { spawnSync } from "./background-process.mjs";
+
+export const MAC_HELPER_KINDS = Object.freeze(["cloudkit"]);
+const KEYS = new Set(["kind", "product", "bundleId", "containerId", "profile", "dest", "teamId", "package"]);
+const PRODUCT = /^[A-Za-z][A-Za-z0-9_-]{0,63}$/;
+const BUNDLE_ID = /^[A-Za-z0-9][A-Za-z0-9.-]{0,254}$/;
+const CONTAINER_ID = /^iCloud\.[A-Za-z0-9][A-Za-z0-9.-]{0,240}$/;
+const TEAM_ID = /^[A-Z0-9]{10}$/;
+const DEFAULT_PACKAGE = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../swift/RightKitCloudKitHelper");
+const ARCHES = ["arm64", "x86_64"];
+
+const invalid = (message) => Object.assign(new Error(message), { code: "MAC_HELPER_CONFIG_INVALID" });
+const failed = (code, message) => Object.assign(new Error(message), { code });
+const isPlainObject = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+const output = (result) => `${result.stdout ?? ""}\n${result.stderr ?? ""}`.trim();
+const xmlEscape = (value) => String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+const toPosix = (file) => file.split(path.sep).join("/");
+
+function contained(root, value, label, errors, { mustExist, isFile }) {
+  if (typeof value !== "string" || !value.trim()) { errors.push(`${label} must be a non-empty path string`); return undefined; }
+  if (path.isAbsolute(value) || /^[A-Za-z]:/.test(value) || value.includes("\0")) { errors.push(`${label} must be relative to the release config directory: ${value}`); return undefined; }
+  const resolved = path.resolve(root, value);
+  const relative = path.relative(root, resolved);
+  if (relative.startsWith("..") || path.isAbsolute(relative)) { errors.push(`${label} must stay inside the release config directory: ${value}`); return undefined; }
+  if (mustExist && !isFile(resolved)) { errors.push(`${label} file not found: ${value}`); return undefined; }
+  return resolved;
+}
+
+/**
+ * Validate `targets.mac.macHelpers`. Collects every problem, then throws one MAC_HELPER_CONFIG_INVALID error.
+ * Returns [{ kind, product, bundleId, containerId, profile (as declared), profileFile (absolute), dest, teamId?, package (absolute) }].
+ * Injectable: isFile, isDirectory.
+ */
+export function validateMacHelpersConfig(macHelpers, { root, isFile = (file) => existsSync(file) && statSync(file).isFile(), isDirectory = (file) => existsSync(file) && statSync(file).isDirectory() } = {}) {
+  const errors = [];
+  const out = [];
+  if (!Array.isArray(macHelpers) || !macHelpers.length) throw invalid("macHelpers must be a non-empty array");
+  const absoluteRoot = path.resolve(root);
+  const seen = { product: new Set(), bundleId: new Set(), dest: new Set() };
+  macHelpers.forEach((entry, index) => {
+    const label = `macHelpers[${index}]`;
+    if (!isPlainObject(entry)) { errors.push(`${label} must be an object { kind, product, bundleId, containerId, profile, dest }`); return; }
+    for (const key of Object.keys(entry)) if (!KEYS.has(key)) errors.push(`${label}: unknown key ${JSON.stringify(key)} (allowed: ${[...KEYS].join(", ")})`);
+    if (!MAC_HELPER_KINDS.includes(entry.kind)) errors.push(`${label}.kind must be one of: ${MAC_HELPER_KINDS.join(", ")}`);
+    if (typeof entry.product !== "string" || !PRODUCT.test(entry.product)) errors.push(`${label}.product must be a SwiftPM product name (letters, digits, '-' and '_', starting with a letter)`);
+    if (typeof entry.bundleId !== "string" || !BUNDLE_ID.test(entry.bundleId)) errors.push(`${label}.bundleId must be 1-255 characters of letters, digits, '.' and '-'`);
+    if (typeof entry.containerId !== "string" || !CONTAINER_ID.test(entry.containerId)) errors.push(`${label}.containerId must look like iCloud.<reverse.dns>`);
+    if (entry.teamId !== undefined && (typeof entry.teamId !== "string" || !TEAM_ID.test(entry.teamId))) errors.push(`${label}.teamId must be a 10-character Apple team id`);
+    const profileFile = contained(absoluteRoot, entry.profile, `${label}.profile`, errors, { mustExist: true, isFile });
+    if (profileFile && !/\.provisionprofile$/.test(profileFile)) errors.push(`${label}.profile must be a macOS .provisionprofile file: ${entry.profile}`);
+    let dest;
+    if (typeof entry.dest !== "string" || !entry.dest.trim() || entry.dest !== entry.dest.trim()) errors.push(`${label}.dest must be a non-empty bundle-relative path`);
+    else {
+      const segments = entry.dest.split("/");
+      if (entry.dest.includes("\\") || entry.dest.includes("\0") || path.posix.isAbsolute(entry.dest) || /^[A-Za-z]:/.test(entry.dest) || segments.some((segment) => segment === "" || segment === "." || segment === "..")) errors.push(`${label}.dest must use forward slashes with no empty, '.' or '..' segments: ${entry.dest}`);
+      else if (segments[0] !== "Contents" || segments.length < 3 || !/\.app$/.test(entry.dest)) errors.push(`${label}.dest must name a helper .app under Contents/ (for example Contents/Library/LoginItems/Helper.app): ${entry.dest}`);
+      else dest = entry.dest;
+    }
+    const pkg = entry.package === undefined ? DEFAULT_PACKAGE : contained(absoluteRoot, entry.package, `${label}.package`, errors, { mustExist: false });
+    if (pkg && !isDirectory(pkg)) errors.push(`${label}.package is not a directory: ${pkg}`);
+    for (const [name, value] of [["product", entry.product], ["bundleId", entry.bundleId], ["dest", dest]]) {
+      if (typeof value !== "string") continue;
+      if (seen[name].has(value)) errors.push(`${label}.${name}: duplicate ${JSON.stringify(value)}`);
+      seen[name].add(value);
+    }
+    out.push({ kind: entry.kind, product: entry.product, bundleId: entry.bundleId, containerId: entry.containerId, profile: entry.profile, profileFile, dest, ...(entry.teamId ? { teamId: entry.teamId } : {}), package: pkg });
+  });
+  if (errors.length) throw invalid(`invalid macOS helper configuration:\n${errors.map((line) => `- ${line}`).join("\n")}`);
+  return out;
+}
+
+/** Fill entitlements.template.plist. Every placeholder must be present and none may remain. Pure. */
+export function fillEntitlementsTemplate(template, { teamId, bundleId, containerId }) {
+  if (!TEAM_ID.test(teamId ?? "")) throw failed("MAC_HELPER_ENTITLEMENTS_INVALID", `cannot fill the entitlements template: team id ${JSON.stringify(teamId)} is not a 10-character Apple team id (set macHelpers[].teamId or APPLE_TEAM_ID)`);
+  let text = template;
+  for (const [placeholder, value] of [["&lt;TEAMID&gt;", teamId], ["&lt;app bundle id&gt;", bundleId], ["&lt;iCloud.container.id&gt;", containerId]]) {
+    if (!text.includes(placeholder)) throw failed("MAC_HELPER_ENTITLEMENTS_INVALID", `entitlements template has no ${placeholder.replace(/&lt;/g, "<").replace(/&gt;/g, ">")} placeholder`);
+    text = text.split(placeholder).join(xmlEscape(value));
+  }
+  const left = /&lt;[^&]{1,80}&gt;/.exec(text);
+  if (left) throw failed("MAC_HELPER_ENTITLEMENTS_INVALID", `entitlements template still has an unfilled placeholder: ${left[0].replace(/&lt;/g, "<").replace(/&gt;/g, ">")}`);
+  return text;
+}
+
+/** Where the filled entitlements of a helper are written (inside the app root, so sign validation accepts the path). */
+export const macHelperEntitlementsFile = (root, helper) => path.join(path.resolve(root), ".right-release", "mac-helpers", `${helper.product}.entitlements.plist`);
+
+/**
+ * Write each helper's filled entitlements file. Call before validateMacSigningConfig (it requires the file to exist).
+ * Injectable: env, readFile, writeFile, mkdir. Returns [{ product, file }].
+ */
+export function prepareMacHelperEntitlements(helpers, { root, env = process.env, readFile = (file) => readFileSync(file, "utf8"), writeFile = writeFileSync, mkdir = mkdirSync } = {}) {
+  return helpers.map((helper) => {
+    const templateFile = path.join(helper.package, "entitlements.template.plist");
+    let template;
+    try { template = readFile(templateFile); } catch (cause) { throw failed("MAC_HELPER_ENTITLEMENTS_INVALID", `${helper.product}: cannot read ${templateFile}: ${cause.message}`); }
+    const teamId = helper.teamId ?? env.APPLE_TEAM_ID?.trim();
+    const filled = fillEntitlementsTemplate(template, { teamId, bundleId: helper.bundleId, containerId: helper.containerId });
+    const file = macHelperEntitlementsFile(root, helper);
+    mkdir(path.dirname(file), { recursive: true });
+    writeFile(file, filled);
+    return { product: helper.product, file };
+  });
+}
+
+/** sign.nestedCode entries for the helpers: stable identifier, filled entitlements, own provisioning profile. Merge into sign.nestedCode before validation. */
+export function macHelperNestedCode(helpers, { root }) {
+  return Object.fromEntries(helpers.map((helper) => [helper.dest, {
+    identifier: helper.bundleId,
+    entitlements: toPosix(path.relative(path.resolve(root), macHelperEntitlementsFile(root, helper))),
+    provisioningProfile: toPosix(helper.profile),
+    options: [],
+  }]));
+}
+
+/** Info.plist of the wrapper bundle: a background (LSUIElement) app named by its executable. Pure. */
+export function helperInfoPlist({ product, bundleId, version = "1.0.0" }) {
+  const entries = [["CFBundleDevelopmentRegion", "en"], ["CFBundleExecutable", product], ["CFBundleIdentifier", bundleId], ["CFBundleInfoDictionaryVersion", "6.0"], ["CFBundleName", product], ["CFBundlePackageType", "APPL"], ["CFBundleShortVersionString", version], ["CFBundleVersion", version], ["LSMinimumSystemVersion", "14.0"]];
+  return `<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0">\n<dict>\n${entries.map(([key, value]) => `\t<key>${key}</key>\n\t<string>${xmlEscape(value)}</string>`).join("\n")}\n\t<key>LSUIElement</key>\n\t<true/>\n</dict>\n</plist>\n`;
+}
+
+function checked(run, command, args, code, cwd) {
+  const result = run(command, args, { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], windowsHide: true, shell: false });
+  if (result.error || result.status !== 0) throw failed(code, `${command} ${args.join(" ")} failed (${result.status ?? "unavailable"}): ${result.error?.message || output(result) || "no output"}`);
+  return result;
+}
+
+/**
+ * Build and wrap each helper into `appBundle` at helper.dest. Never signs and never embeds the profile (the nested signing step
+ * does both, in order). Throws before touching the app when not on macOS or when the build is not universal.
+ * Injectable: run, platform, ops ({ exists, rm, mkdir, copy, chmod, write }). Returns [{ product, dest, executable, archs }].
+ */
+export function stageMacHelpers(helpers, { appBundle, version, run = spawnSync, platform = process.platform, ops = {} } = {}) {
+  const fs = { exists: existsSync, rm: (file) => rmSync(file, { recursive: true, force: true }), mkdir: (file) => mkdirSync(file, { recursive: true }), copy: copyFileSync, chmod: chmodSync, write: writeFileSync, ...ops };
+  if (platform !== "darwin") throw failed("MAC_HELPER_STAGE_UNSUPPORTED", "staging macOS helpers needs a macOS host (swift build, lipo)");
+  if (!appBundle || !fs.exists(appBundle)) throw failed("MAC_HELPER_STAGE_FAILED", `app bundle not found: ${appBundle}`);
+  const app = path.resolve(appBundle);
+  return helpers.map((helper) => {
+    const buildArgs = ["build", "-c", "release", ...ARCHES.flatMap((arch) => ["--arch", arch]), "--package-path", helper.package, "--product", helper.product];
+    checked(run, "swift", buildArgs, "MAC_HELPER_BUILD_FAILED", helper.package);
+    const binPath = checked(run, "swift", [...buildArgs, "--show-bin-path"], "MAC_HELPER_BUILD_FAILED", helper.package).stdout.trim().split("\n").pop().trim();
+    const built = path.join(binPath, helper.product);
+    if (!binPath || !fs.exists(built)) throw failed("MAC_HELPER_BUILD_FAILED", `${helper.product}: built executable not found at ${built}`);
+    const archs = checked(run, "lipo", ["-archs", built], "MAC_HELPER_NOT_UNIVERSAL", helper.package).stdout.trim().split(/\s+/).filter(Boolean);
+    const missing = ARCHES.filter((arch) => !archs.includes(arch));
+    if (missing.length) throw failed("MAC_HELPER_NOT_UNIVERSAL", `${helper.product} must be universal (${ARCHES.join(" + ")}); lipo reports: ${archs.join(" ") || "nothing"}`);
+    const bundle = path.join(app, ...helper.dest.split("/"));
+    const relative = path.relative(app, bundle);
+    if (relative.startsWith("..") || path.isAbsolute(relative)) throw failed("MAC_HELPER_STAGE_FAILED", `${helper.dest} resolves outside ${app}`);
+    fs.rm(bundle);
+    fs.mkdir(path.join(bundle, "Contents", "MacOS"));
+    const executable = path.join(bundle, "Contents", "MacOS", helper.product);
+    fs.copy(built, executable);
+    fs.chmod(executable, 0o755);
+    fs.write(path.join(bundle, "Contents", "Info.plist"), helperInfoPlist({ product: helper.product, bundleId: helper.bundleId, ...(version ? { version } : {}) }));
+    return { product: helper.product, dest: helper.dest, executable, archs };
+  });
+}
diff --git a/packages/release/mac-helper-stage.test.mjs b/packages/release/mac-helper-stage.test.mjs
new file mode 100644
index 0000000..4d03da8
--- /dev/null
+++ b/packages/release/mac-helper-stage.test.mjs
@@ -0,0 +1,119 @@
+import assert from "node:assert/strict";
+import path from "node:path";
+import test from "node:test";
+import { fillEntitlementsTemplate, helperInfoPlist, macHelperEntitlementsFile, macHelperNestedCode, prepareMacHelperEntitlements, stageMacHelpers, validateMacHelpersConfig } from "./mac-helper-stage.mjs";
+
+const ROOT = path.resolve("/rk-app");
+const TEMPLATE = `<plist><dict>
+<!-- Per-app values in angle brackets are filled in -->
+<key>com.apple.application-identifier</key><string>&lt;TEAMID&gt;.&lt;app bundle id&gt;</string>
+<key>com.apple.developer.team-identifier</key><string>&lt;TEAMID&gt;</string>
+<key>com.apple.developer.icloud-container-identifiers</key><array><string>&lt;iCloud.container.id&gt;</string></array>
+</dict></plist>`;
+
+const declared = (overrides = {}) => ({ kind: "cloudkit", product: "rightkit-cloudkit-helper", bundleId: "app.example.cloudkit-helper", containerId: "iCloud.app.example", profile: "release/helper.provisionprofile", dest: "Contents/Library/LoginItems/RightKitCloudKitHelper.app", teamId: "ABCDE12345", ...overrides });
+const validate = (list, extra = {}) => validateMacHelpersConfig(list, { root: ROOT, isFile: () => true, isDirectory: () => true, ...extra });
+
+test("a valid cloudkit helper normalizes with an absolute profile and package", () => {
+  const [helper] = validate([declared()]);
+  assert.equal(helper.profileFile, path.resolve(ROOT, "release/helper.provisionprofile"));
+  assert.equal(helper.profile, "release/helper.provisionprofile");
+  assert.ok(path.isAbsolute(helper.package));
+});
+
+test("config validation collects every problem", () => {
+  const list = [declared({ kind: "other", product: "1bad", bundleId: "bad id", containerId: "app.example", profile: "../x.provisionprofile", dest: "Library/X.app", extra: 1, teamId: "short" })];
+  assert.throws(() => validate(list), (error) => {
+    assert.equal(error.code, "MAC_HELPER_CONFIG_INVALID");
+    for (const part of ["unknown key \"extra\"", ".kind must be", ".product must be", ".bundleId must be", ".containerId must look like", ".teamId must be", "must stay inside", ".dest must name a helper .app"]) assert.ok(error.message.includes(part), `${part}\n${error.message}`);
+    return true;
+  });
+  assert.throws(() => validate([]), /non-empty array/);
+  assert.throws(() => validate([declared()], { isFile: () => false }), /profile file not found/);
+  assert.throws(() => validate([declared(), declared()]), /duplicate/);
+  assert.throws(() => validate([declared({ profile: "release/helper.txt" })]), /\.provisionprofile/);
+  assert.throws(() => validate([declared({ dest: "Contents/../X.app" })]), /no empty, '\.' or '\.\.'/);
+});
+
+test("the entitlements template is filled completely and fails on a missing placeholder or team", () => {
+  const filled = fillEntitlementsTemplate(TEMPLATE, { teamId: "ABCDE12345", bundleId: "app.example.cloudkit-helper", containerId: "iCloud.app.example" });
+  assert.match(filled, /<string>ABCDE12345\.app\.example\.cloudkit-helper<\/string>/);
+  assert.match(filled, /<string>iCloud\.app\.example<\/string>/);
+  assert.doesNotMatch(filled, /&lt;/);
+  assert.throws(() => fillEntitlementsTemplate(TEMPLATE.replace("&lt;iCloud.container.id&gt;", "x"), { teamId: "ABCDE12345", bundleId: "a.b", containerId: "iCloud.a" }), /no <iCloud\.container\.id> placeholder/);
+  assert.throws(() => fillEntitlementsTemplate(TEMPLATE, { teamId: undefined, bundleId: "a.b", containerId: "iCloud.a" }), /team id/);
+  assert.throws(() => fillEntitlementsTemplate(`${TEMPLATE}&lt;SURPRISE&gt;`, { teamId: "ABCDE12345", bundleId: "a.b", containerId: "iCloud.a" }), /unfilled placeholder: <SURPRISE>/);
+});
+
+test("prepare writes the filled plist under the app root; the team falls back to APPLE_TEAM_ID", () => {
+  const [helper] = validate([declared({ teamId: undefined })]);
+  const writes = [];
+  const made = prepareMacHelperEntitlements([helper], { root: ROOT, env: { APPLE_TEAM_ID: "ZZZZZ99999" }, readFile: () => TEMPLATE, writeFile: (file, text) => writes.push([file, text]), mkdir: () => {} });
+  assert.equal(made[0].file, macHelperEntitlementsFile(ROOT, helper));
+  assert.match(writes[0][1], /ZZZZZ99999\.app\.example\.cloudkit-helper/);
+  assert.throws(() => prepareMacHelperEntitlements([helper], { root: ROOT, env: {}, readFile: () => TEMPLATE, writeFile: () => {}, mkdir: () => {} }), /team id/);
+});
+
+test("helpers register as nestedCode with identifier, entitlements and their own profile", () => {
+  const [helper] = validate([declared()]);
+  assert.deepEqual(macHelperNestedCode([helper], { root: ROOT }), {
+    "Contents/Library/LoginItems/RightKitCloudKitHelper.app": {
+      identifier: "app.example.cloudkit-helper",
+      entitlements: ".right-release/mac-helpers/rightkit-cloudkit-helper.entitlements.plist",
+      provisioningProfile: "release/helper.provisionprofile",
+      options: [],
+    },
+  });
+});
+
+test("Info.plist names the executable and bundle id and marks a background app", () => {
+  const plist = helperInfoPlist({ product: "rightkit-cloudkit-helper", bundleId: "app.example.cloudkit-helper", version: "2.3.4" });
+  assert.match(plist, /<key>CFBundleExecutable<\/key>\s*<string>rightkit-cloudkit-helper<\/string>/);
+  assert.match(plist, /<key>CFBundleIdentifier<\/key>\s*<string>app\.example\.cloudkit-helper<\/string>/);
+  assert.match(plist, /<key>CFBundleShortVersionString<\/key>\s*<string>2\.3\.4<\/string>/);
+  assert.match(plist, /<key>LSUIElement<\/key>\s*<true\/>/);
+});
+
+function stageHarness({ archs = "x86_64 arm64", platform = "darwin" } = {}) {
+  const calls = [];
+  const log = [];
+  const run = (command, args) => {
+    calls.push([command, ...args]);
+    if (command === "swift") return { status: 0, stdout: args.includes("--show-bin-path") ? "/pkg/.build/apple/Products/Release\n" : "built", stderr: "" };
+    if (command === "lipo") return { status: 0, stdout: `${archs}\n`, stderr: "" };
+    return { status: 1, stdout: "", stderr: "unexpected" };
+  };
+  const ops = { exists: () => true, rm: (file) => log.push(["rm", file]), mkdir: (file) => log.push(["mkdir", file]), copy: (from, to) => log.push(["copy", from, to]), chmod: (file, mode) => log.push(["chmod", file, mode]), write: (file) => log.push(["write", file]) };
+  return { calls, log, options: { appBundle: path.resolve("/out/App.app"), run, platform, ops } };
+}
+
+test("staging builds universal, wraps the binary in the dest bundle and never signs or embeds the profile", () => {
+  const [helper] = validate([declared()]);
+  const { calls, log, options } = stageHarness();
+  const records = stageMacHelpers([{ ...helper, package: "/pkg" }], options);
+  const build = calls[0];
+  assert.deepEqual(build.slice(0, 3), ["swift", "build", "-c"]);
+  assert.ok(build.join(" ").includes("--arch arm64 --arch x86_64"));
+  assert.ok(build.includes("--product") && build.includes("rightkit-cloudkit-helper"));
+  assert.ok(calls.some((call) => call.includes("--show-bin-path")));
+  assert.equal(calls.some((call) => ["codesign", "security"].includes(call[0])), false);
+  const bundle = path.join(path.resolve("/out/App.app"), "Contents", "Library", "LoginItems", "RightKitCloudKitHelper.app");
+  assert.deepEqual(log[0], ["rm", bundle]);
+  assert.ok(log.some((entry) => entry[0] === "copy" && entry[2] === path.join(bundle, "Contents", "MacOS", "rightkit-cloudkit-helper")));
+  assert.ok(log.some((entry) => entry[0] === "write" && entry[1] === path.join(bundle, "Contents", "Info.plist")));
+  assert.equal(log.some((entry) => String(entry[2] ?? entry[1]).includes("embedded.provisionprofile")), false);
+  assert.deepEqual(records[0].archs.sort(), ["arm64", "x86_64"]);
+});
+
+test("a thin binary, a non-macOS host or a failed build is refused before the bundle is touched", () => {
+  const [helper] = validate([declared()]);
+  const thin = stageHarness({ archs: "arm64" });
+  assert.throws(() => stageMacHelpers([helper], thin.options), (error) => error.code === "MAC_HELPER_NOT_UNIVERSAL" && /x86_64|universal/.test(error.message));
+  assert.deepEqual(thin.log, []);
+  const win = stageHarness({ platform: "win32" });
+  assert.throws(() => stageMacHelpers([helper], win.options), /macOS host/);
+  const broken = stageHarness();
+  broken.options.run = () => ({ status: 1, stdout: "", stderr: "compile error" });
+  assert.throws(() => stageMacHelpers([helper], broken.options), (error) => error.code === "MAC_HELPER_BUILD_FAILED" && /compile error/.test(error.message));
+  assert.deepEqual(broken.log, []);
+});
diff --git a/packages/release/mac-nested-profile.mjs b/packages/release/mac-nested-profile.mjs
new file mode 100644
index 0000000..f2fbeff
--- /dev/null
+++ b/packages/release/mac-nested-profile.mjs
@@ -0,0 +1,135 @@
+// Provisioning profiles for nested helper bundles in the release (Developer ID) signing path.
+//
+// A helper such as Contents/Library/LoginItems/X.app that requests profile-restricted entitlements (iCloud/CloudKit,
+// keychain-access-groups, application groups, an explicit application-identifier) is killed at launch unless its OWN
+// Contents/embedded.provisionprofile authorizes every one of them. `sign.nestedCode[key].provisioningProfile` names that profile;
+// this module decodes it (`security cms -D`, the same route as development-signing.mjs), proves it authorizes what the helper's
+// entitlements request, and only then copies it into the helper, before the helper is signed (inside-out: the copy is part of the
+// helper's sealed resources). Fails closed: any mismatch throws before any file is copied.
+import { copyFileSync, existsSync, statSync } from "node:fs";
+import path from "node:path";
+import { spawnSync } from "./background-process.mjs";
+
+export class NestedProfileError extends Error {
+  constructor(message, details = {}) {
+    super(message);
+    this.name = "NestedProfileError";
+    this.code = "MAC_NESTED_PROFILE_INVALID";
+    Object.assign(this, details);
+  }
+}
+
+const output = (result) => `${result.stdout ?? ""}\n${result.stderr ?? ""}`.trim();
+const runOptions = (extra = {}) => ({ encoding: "utf8", stdio: ["pipe", "pipe", "pipe"], windowsHide: true, shell: false, ...extra });
+
+// plutil JSON conversion rejects the date/data values in provisioning profiles, so profiles go through plistlib.
+const PROFILE_PARSER = "import base64,datetime,json,plistlib,sys\ndef encode(v):\n if isinstance(v,bytes): return base64.b64encode(v).decode('ascii')\n if isinstance(v,(datetime.date,datetime.datetime)): return v.isoformat()\n raise TypeError(type(v).__name__)\nprint(json.dumps(plistlib.loads(sys.stdin.buffer.read()),default=encode))";
+
+/** Decode a .provisionprofile to its plist as an object. Throws NestedProfileError for an unreadable, non-OSX or expired profile. Injectable: run, now. */
+export function decodeProvisioningProfile(file, { run = spawnSync, now = Date.now() } = {}) {
+  const cms = run("security", ["cms", "-D", "-i", file], runOptions());
+  if (cms.error || cms.status !== 0) throw new NestedProfileError(`cannot decode provisioning profile ${file} (security cms -D): ${cms.error?.message || output(cms) || `exit ${cms.status ?? "unavailable"}`}`);
+  const parsed = run("python3", ["-c", PROFILE_PARSER], runOptions({ input: cms.stdout }));
+  let profile;
+  try {
+    if (parsed.error || parsed.status !== 0) throw new Error(parsed.error?.message || output(parsed));
+    profile = JSON.parse(parsed.stdout);
+  } catch (cause) { throw new NestedProfileError(`cannot parse provisioning profile ${file}: ${cause.message}`); }
+  if (!Array.isArray(profile.TeamIdentifier) || profile.TeamIdentifier.length !== 1 || !profile.TeamIdentifier[0]) throw new NestedProfileError(`provisioning profile ${file} must name exactly one team`);
+  if (!Array.isArray(profile.Platform) || !profile.Platform.includes("OSX")) throw new NestedProfileError(`provisioning profile ${file} must target OSX`);
+  if (!(Date.parse(profile.ExpirationDate) > now)) throw new NestedProfileError(`provisioning profile ${file} is expired or has no expiration date`);
+  return profile;
+}
+
+const asList = (value) => (Array.isArray(value) ? value : value === undefined ? [] : [value]);
+/** A grant list entry matches a requested value exactly, as "*", or as a trailing-"*" prefix (TEAMID.* style wildcards). */
+const granted = (grants, value) => asList(grants).some((grant) => typeof grant === "string" && (grant === value || grant === "*" || (grant.endsWith("*") && value.startsWith(grant.slice(0, -1)))));
+
+const KEY = Object.freeze({
+  appId: ["com.apple.application-identifier", "application-identifier"],
+  team: "com.apple.developer.team-identifier",
+  containers: "com.apple.developer.icloud-container-identifiers",
+  services: "com.apple.developer.icloud-services",
+  environment: "com.apple.developer.icloud-container-environment",
+  keychain: "keychain-access-groups",
+  groups: "com.apple.security.application-groups",
+});
+
+/** The profile-restricted entitlement keys this module proves against a profile (present in the requested set). */
+export const restrictedEntitlementKeys = (requested) => Object.keys(requested ?? {}).filter((key) => [...KEY.appId, KEY.team, KEY.containers, KEY.services, KEY.environment, KEY.keychain, KEY.groups].includes(key));
+
+/**
+ * Problems (strings) where `profile` (decoded plist) does not authorize `requested` (the helper's entitlements as an object).
+ * Checks application-identifier / team, icloud-container-identifiers (+ services and environment), keychain-access-groups and
+ * application-groups. Empty array = authorized. Pure.
+ */
+export function profileEntitlementProblems(profile, requested) {
+  const problems = [];
+  const have = profile?.Entitlements ?? {};
+  const team = profile?.TeamIdentifier?.[0];
+  const keys = restrictedEntitlementKeys(requested);
+  if (!keys.length) return ["the helper's entitlements request no profile-restricted entitlement, so an embedded profile has nothing to authorize"];
+  for (const key of KEY.appId) {
+    if (requested[key] === undefined) continue;
+    const mine = requested[key];
+    const theirs = KEY.appId.map((name) => have[name]).find((value) => value !== undefined);
+    if (typeof mine !== "string" || !mine) problems.push(`${key} must be a non-empty string`);
+    else if (!granted(theirs, mine)) problems.push(`${key} ${mine} is not authorized by the profile (profile: ${JSON.stringify(theirs ?? null)})`);
+    else if (team && !mine.startsWith(`${team}.`)) problems.push(`${key} ${mine} is not under the profile team ${team}`);
+  }
+  if (requested[KEY.team] !== undefined) {
+    if (requested[KEY.team] !== team) problems.push(`${KEY.team} ${JSON.stringify(requested[KEY.team])} does not match the profile team ${team}`);
+    else if (have[KEY.team] !== undefined && have[KEY.team] !== team) problems.push(`${KEY.team}: the profile's own entitlement ${JSON.stringify(have[KEY.team])} disagrees with its TeamIdentifier ${team}`);
+  }
+  const list = (key, label) => {
+    if (requested[key] === undefined) return;
+    const wanted = asList(requested[key]);
+    if (!wanted.every((value) => typeof value === "string" && value)) { problems.push(`${key} must be a list of non-empty strings`); return; }
+    if (have[key] === undefined) { problems.push(`${key} is requested but the profile does not carry ${label}`); return; }
+    for (const value of wanted) if (!granted(have[key], value)) problems.push(`${key} ${value} is not authorized by the profile (profile: ${JSON.stringify(have[key])})`);
+  };
+  list(KEY.containers, "iCloud containers");
+  list(KEY.services, "iCloud services");
+  list(KEY.environment, "an iCloud container environment");
+  list(KEY.keychain, "keychain access groups");
+  list(KEY.groups, "application groups");
+  return problems;
+}
+
+function readEntitlements(file, run) {
+  const result = run("plutil", ["-convert", "json", "-o", "-", file], runOptions());
+  try {
+    if (result.error || result.status !== 0) throw new Error(result.error?.message || output(result));
+    const value = JSON.parse(result.stdout);
+    if (value === null || typeof value !== "object" || Array.isArray(value)) throw new Error("not a dictionary");
+    return value;
+  } catch (cause) { throw new NestedProfileError(`cannot read entitlements ${file}: ${cause.message}`); }
+}
+
+/**
+ * For every planned nested item that carries `provisioningProfile`: decode the profile, prove it authorizes the item's entitlements,
+ * then copy it to <item.file>/Contents/embedded.provisionprofile. All proofs run before the first copy, so a failure leaves the
+ * bundle untouched. Items without a profile are ignored. Returns [{ file, profile, team, applicationIdentifier?, restricted }].
+ * Injectable: run, now, exists, isDirectory, copy.
+ */
+export function embedNestedProvisioningProfiles(nested, { run = spawnSync, now = Date.now(), exists = existsSync, isDirectory = (file) => statSync(file).isDirectory(), copy = copyFileSync } = {}) {
+  const planned = [];
+  for (const item of nested.filter((entry) => entry.provisioningProfile)) {
+    const label = item.file;
+    if (!exists(item.provisioningProfile)) throw new NestedProfileError(`${label}: provisioning profile not found: ${item.provisioningProfile}`);
+    if (!item.entitlements) throw new NestedProfileError(`${label}: provisioningProfile needs entitlements; nothing declares what the profile must authorize`);
+    if (!exists(item.file) || !isDirectory(item.file) || !exists(path.join(item.file, "Contents"))) throw new NestedProfileError(`${label}: provisioningProfile applies only to a nested bundle with a Contents directory`);
+    const profile = decodeProvisioningProfile(item.provisioningProfile, { run, now });
+    const requested = readEntitlements(item.entitlements, run);
+    const problems = profileEntitlementProblems(profile, requested);
+    if (problems.length) throw new NestedProfileError(`${label}: provisioning profile ${item.provisioningProfile} does not authorize the helper's entitlements ${item.entitlements}:\n${problems.map((line) => `- ${line}`).join("\n")}`, { problems });
+    planned.push({ item, profile, requested });
+  }
+  const records = [];
+  for (const { item, profile, requested } of planned) {
+    copy(item.provisioningProfile, path.join(item.file, "Contents", "embedded.provisionprofile"));
+    const applicationIdentifier = KEY.appId.map((name) => requested[name]).find((value) => value !== undefined);
+    records.push({ file: item.file, profile: item.provisioningProfile, team: profile.TeamIdentifier[0], ...(applicationIdentifier ? { applicationIdentifier } : {}), restricted: restrictedEntitlementKeys(requested) });
+  }
+  return records;
+}
diff --git a/packages/release/mac-nested-profile.test.mjs b/packages/release/mac-nested-profile.test.mjs
new file mode 100644
index 0000000..f393fb5
--- /dev/null
+++ b/packages/release/mac-nested-profile.test.mjs
@@ -0,0 +1,126 @@
+import assert from "node:assert/strict";
+import path from "node:path";
+import test from "node:test";
+import { decodeProvisioningProfile, embedNestedProvisioningProfiles, profileEntitlementProblems, restrictedEntitlementKeys } from "./mac-nested-profile.mjs";
+
+const NOW = Date.parse("2026-10-17T00:00:00Z");
+const TEAM = "ABCDE12345";
+
+const profile = (overrides = {}) => ({
+  TeamIdentifier: [TEAM],
+  Platform: ["OSX"],
+  ExpirationDate: "2027-01-01T00:00:00",
+  Entitlements: {
+    "com.apple.application-identifier": `${TEAM}.app.example.helper`,
+    "com.apple.developer.team-identifier": TEAM,
+    "com.apple.developer.icloud-container-identifiers": ["iCloud.app.example"],
+    "com.apple.developer.icloud-services": "*",
+    "com.apple.developer.icloud-container-environment": ["Production"],
+    "keychain-access-groups": [`${TEAM}.*`],
+    "com.apple.security.application-groups": [`${TEAM}.group.app.example`],
+  },
+  ...overrides,
+});
+
+const requested = (overrides = {}) => ({
+  "com.apple.application-identifier": `${TEAM}.app.example.helper`,
+  "com.apple.developer.team-identifier": TEAM,
+  "com.apple.developer.icloud-container-identifiers": ["iCloud.app.example"],
+  "com.apple.developer.icloud-services": ["CloudKit"],
+  "com.apple.developer.icloud-container-environment": "Production",
+  "keychain-access-groups": [`${TEAM}.app.example`],
+  "com.apple.security.application-groups": [`${TEAM}.group.app.example`],
+  ...overrides,
+});
+
+test("a profile that carries everything the helper requests authorizes it", () => {
+  assert.deepEqual(profileEntitlementProblems(profile(), requested()), []);
+});
+
+test("each restricted entitlement class fails closed on its own", () => {
+  const cases = [
+    [{ "com.apple.application-identifier": `${TEAM}.app.other.helper` }, /application-identifier.*not authorized/],
+    [{ "com.apple.application-identifier": "ZZZZZ99999.app.example.helper" }, /not authorized|not under the profile team/],
+    [{ "com.apple.developer.team-identifier": "ZZZZZ99999" }, /does not match the profile team/],
+    [{ "com.apple.developer.icloud-container-identifiers": ["iCloud.app.example", "iCloud.app.other"] }, /iCloud\.app\.other is not authorized/],
+    [{ "com.apple.developer.icloud-container-environment": "Development" }, /Development is not authorized/],
+    [{ "keychain-access-groups": ["OTHERTEAM01.app.example"] }, /keychain-access-groups OTHERTEAM01/],
+    [{ "com.apple.security.application-groups": [`${TEAM}.group.app.other`] }, /group\.app\.other is not authorized/],
+  ];
+  for (const [override, pattern] of cases) {
+    const problems = profileEntitlementProblems(profile(), requested(override));
+    assert.ok(problems.some((line) => pattern.test(line)), `${JSON.stringify(override)} -> ${problems.join(" | ")}`);
+  }
+});
+
+test("a requested key the profile does not carry at all is a problem, wildcards match by prefix", () => {
+  const bare = profile({ Entitlements: { "com.apple.application-identifier": `${TEAM}.*` } });
+  const problems = profileEntitlementProblems(bare, { "com.apple.application-identifier": `${TEAM}.app.example.helper`, "keychain-access-groups": [`${TEAM}.app.example`] });
+  assert.equal(problems.length, 1);
+  assert.match(problems[0], /keychain-access-groups is requested but the profile does not carry/);
+});
+
+test("entitlements with no restricted key cannot justify a profile", () => {
+  assert.deepEqual(restrictedEntitlementKeys({ "com.apple.security.cs.allow-jit": true }), []);
+  const problems = profileEntitlementProblems(profile(), { "com.apple.security.cs.allow-jit": true });
+  assert.match(problems[0], /nothing to authorize/);
+});
+
+function fakeRun(table) {
+  const calls = [];
+  const run = (command, args, options) => {
+    calls.push([command, ...args]);
+    if (command === "security") return { status: 0, stdout: `cms:${args[3]}`, stderr: "" };
+    if (command === "python3") return { status: 0, stdout: JSON.stringify(table.profiles[options.input.replace("cms:", "")]), stderr: "" };
+    if (command === "plutil") return { status: 0, stdout: JSON.stringify(table.entitlements[args[4]]), stderr: "" };
+    return { status: 1, stdout: "", stderr: `unexpected ${command}` };
+  };
+  return { run, calls };
+}
+
+test("decodeProvisioningProfile rejects expired, non-OSX and failed decodes", () => {
+  const decode = (value, status = 0) => decodeProvisioningProfile("p.provisionprofile", { now: NOW, run: (command) => (command === "security" ? { status, stdout: "x", stderr: "bad cms" } : { status: 0, stdout: JSON.stringify(value), stderr: "" }) });
+  assert.equal(decode(profile()).TeamIdentifier[0], TEAM);
+  assert.throws(() => decode(profile({ ExpirationDate: "2026-01-01T00:00:00" })), /expired/);
+  assert.throws(() => decode(profile({ Platform: ["iOS"] })), /target OSX/);
+  assert.throws(() => decode(profile({ TeamIdentifier: [] })), /exactly one team/);
+  assert.throws(() => decode(profile(), 1), /cannot decode provisioning profile/);
+});
+
+const item = (overrides = {}) => ({ file: path.join("/app/Contents/Library/LoginItems/Helper.app"), provisioningProfile: "/p/helper.provisionprofile", entitlements: "/e/helper.plist", options: [], ...overrides });
+const deps = (table, copies = []) => ({ ...fakeRun(table), now: NOW, exists: () => true, isDirectory: () => true, copy: (from, to) => copies.push([from, to]) });
+
+test("embedding copies the profile into Contents/embedded.provisionprofile after proving it", () => {
+  const copies = [];
+  const d = deps({ profiles: { "/p/helper.provisionprofile": profile() }, entitlements: { "/e/helper.plist": requested() } }, copies);
+  const records = embedNestedProvisioningProfiles([item(), { file: "/app/Contents/Helpers/tool", options: [] }], d);
+  assert.equal(records.length, 1);
+  assert.equal(records[0].team, TEAM);
+  assert.equal(records[0].applicationIdentifier, `${TEAM}.app.example.helper`);
+  assert.deepEqual(copies, [["/p/helper.provisionprofile", path.join(item().file, "Contents", "embedded.provisionprofile")]]);
+});
+
+test("an unauthorized profile throws and copies nothing, even for earlier valid helpers", () => {
+  const copies = [];
+  const good = item();
+  const bad = item({ file: "/app/Contents/Library/LoginItems/Bad.app", provisioningProfile: "/p/bad.provisionprofile", entitlements: "/e/bad.plist" });
+  const d = deps({
+    profiles: { "/p/helper.provisionprofile": profile(), "/p/bad.provisionprofile": profile() },
+    entitlements: { "/e/helper.plist": requested(), "/e/bad.plist": requested({ "com.apple.developer.icloud-container-identifiers": ["iCloud.app.other"] }) },
+  }, copies);
+  assert.throws(() => embedNestedProvisioningProfiles([good, bad], d), (error) => error.code === "MAC_NESTED_PROFILE_INVALID" && /Bad\.app/.test(error.message) && /iCloud\.app\.other/.test(error.message));
+  assert.deepEqual(copies, []);
+});
+
+test("missing entitlements, a non-bundle target or a missing profile fail closed", () => {
+  const table = { profiles: { "/p/helper.provisionprofile": profile() }, entitlements: { "/e/helper.plist": requested() } };
+  assert.throws(() => embedNestedProvisioningProfiles([item({ entitlements: undefined })], deps(table)), /needs entitlements/);
+  assert.throws(() => embedNestedProvisioningProfiles([item()], { ...deps(table), isDirectory: () => false }), /nested bundle/);
+  assert.throws(() => embedNestedProvisioningProfiles([item()], { ...deps(table), exists: (file) => !file.endsWith(".provisionprofile") }), /profile not found/);
+});
+
+test("nothing carries a profile: nothing is decoded or copied", () => {
+  const d = deps({ profiles: {}, entitlements: {} });
+  assert.deepEqual(embedNestedProvisioningProfiles([{ file: "/app/Contents/Helpers/tool", options: [] }], d), []);
+  assert.deepEqual(d.calls, []);
+});
diff --git a/packages/release/mac-runtime-manifest.mjs b/packages/release/mac-runtime-manifest.mjs
new file mode 100644
index 0000000..a862567
--- /dev/null
+++ b/packages/release/mac-runtime-manifest.mjs
@@ -0,0 +1,140 @@
+// Declarative runtime-manifest refresh for macOS bundles: `sign.runtimeManifest`.
+//
+//   sign: { runtimeManifest: { path: "Contents/Resources/runtime/manifest.json", format: "files-v1" } }
+//
+// codesign rewrites every Mach-O it signs, so the sha256 (and byte size) an app recorded for its bundled runtimes at
+// staging time no longer matches the signed bytes. The app verifies those against the shipped files and fails closed, so the
+// manifest must be re-described AFTER all nested code is signed and BEFORE the outer app seal (the seal covers the manifest).
+//
+// Formats (the `format` field; default "files-v1"):
+//   files-v1  CutRight's runtime/manifest.json shape: a top-level `files` array of
+//             { path, sha256, bytes? | size? } where `path` is a POSIX path relative to the manifest's own directory.
+//             Every other field and the key order of every entry are preserved; only sha256 and the size field the entry
+//             already has are rewritten. Indentation (tab or N spaces) and the trailing newline convention are preserved.
+//
+// Fail closed: manifest missing / not a regular file / outside the bundle, unknown format, malformed JSON or entries, a listed
+// file that is missing, not a regular file, a symlink, outside the bundle, or the bundle's main executable (the seal rewrites it).
+// This module never runs a subprocess.
+import { createHash } from "node:crypto";
+import { lstatSync, readFileSync, realpathSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { mainExecutableName } from "./mac-bundle-signing.mjs";
+
+export const RUNTIME_MANIFEST_FORMATS = Object.freeze(["files-v1"]);
+export const DEFAULT_RUNTIME_MANIFEST_FORMAT = "files-v1";
+const KEYS = new Set(["path", "format"]);
+
+const fail = (message, code = "MAC_RUNTIME_MANIFEST_INVALID") => Object.assign(new Error(message), { code });
+const isPlainObject = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+
+/** Why a bundle-relative POSIX path is unacceptable, or null. */
+function relativePathProblem(value) {
+  if (typeof value !== "string" || !value.trim() || value !== value.trim()) return "must be a non-empty path without surrounding whitespace";
+  if (value.includes("\0") || value.includes("\\")) return 'must use "/" separators and no NUL';
+  if (path.posix.isAbsolute(value) || /^[A-Za-z]:/.test(value)) return "must be relative";
+  if (value.split("/").some((segment) => segment === "" || segment === "." || segment === "..")) return 'must not contain empty, "." or ".." segments or a trailing slash';
+  return null;
+}
+
+/**
+ * Validate `sign.runtimeManifest`. Pushes problems onto `errors` (config validation collects them) and returns the normalized
+ * { path, format } or undefined. `undefined` input returns undefined without an error.
+ */
+export function validateRuntimeManifestConfig(config, errors, label = "sign.runtimeManifest") {
+  if (config === undefined) return undefined;
+  const before = errors.length;
+  if (!isPlainObject(config)) { errors.push(`${label} must be an object { path, format? }`); return undefined; }
+  for (const key of Object.keys(config)) if (!KEYS.has(key)) errors.push(`${label}: unknown key ${JSON.stringify(key)} (allowed: path, format)`);
+  const problem = relativePathProblem(config.path);
+  if (problem) errors.push(`${label}.path ${problem} (a path inside the .app bundle)`);
+  else if (!config.path.toLowerCase().endsWith(".json")) errors.push(`${label}.path must name a .json file: ${config.path}`);
+  const format = config.format ?? DEFAULT_RUNTIME_MANIFEST_FORMAT;
+  if (!RUNTIME_MANIFEST_FORMATS.includes(format)) errors.push(`${label}.format ${JSON.stringify(format)} is not understood (supported: ${RUNTIME_MANIFEST_FORMATS.join(", ")})`);
+  return errors.length > before ? undefined : { path: config.path, format };
+}
+
+/** Detect the JSON indent of an existing manifest: a tab, or the leading spaces of its first indented line; 2 spaces otherwise. */
+function detectIndent(text) {
+  const match = /^([ \t]+)\S/m.exec(text);
+  if (!match) return 2;
+  return match[1].startsWith("\t") ? "\t" : match[1].length;
+}
+
+const defaultFs = { lstat: lstatSync, realpath: realpathSync, readFile: (file) => readFileSync(file), writeFile: (file, text) => writeFileSync(file, text) };
+
+const within = (root, file) => file === root || file.startsWith(root.endsWith(path.sep) ? root : root + path.sep);
+
+/**
+ * Recompute a runtime manifest from the signed bytes in `app` WITHOUT writing.
+ * Returns { manifestFile, format, text, changed, entries: [{ path, file, sha256, size? }] }.
+ * Injectable: fs { lstat, realpath, readFile(file) -> Buffer, writeFile }, mainName.
+ */
+export function computeRuntimeManifest({ app, runtimeManifest, fs = {}, mainName = mainExecutableName }) {
+  const io = { ...defaultFs, ...fs };
+  const problem = [];
+  const config = validateRuntimeManifestConfig(runtimeManifest, problem);
+  if (!config) throw fail(problem.length ? problem.join("; ") : "sign.runtimeManifest is required");
+  const appReal = io.realpath(app);
+  const manifestFile = path.join(app, ...config.path.split("/"));
+  const checkFile = (file, label) => {
+    let info;
+    try { info = io.lstat(file); } catch { throw fail(`${label} is missing from the bundle: ${file}`, "MAC_RUNTIME_MANIFEST_MISSING"); }
+    if (info.isSymbolicLink()) throw fail(`${label} is a symlink; list the real file: ${file}`);
+    if (!info.isFile()) throw fail(`${label} is not a regular file: ${file}`);
+    const real = io.realpath(file);
+    if (!within(appReal, real)) throw fail(`${label} resolves outside the bundle: ${file}`);
+    return real;
+  };
+  const manifestReal = checkFile(manifestFile, `runtime manifest ${config.path}`);
+  const original = Buffer.from(io.readFile(manifestFile)).toString("utf8");
+  let manifest;
+  try { manifest = JSON.parse(original); } catch { throw fail(`runtime manifest ${config.path} is not valid JSON`); }
+  // files-v1 (the only format): { files: [{ path, sha256, bytes?|size? }] }
+  if (!isPlainObject(manifest) || !Array.isArray(manifest.files)) throw fail(`runtime manifest ${config.path} is not format ${config.format}: expected a top-level "files" array`);
+  const baseDir = path.dirname(manifestFile);
+  const mainReal = (() => {
+    try { return io.realpath(path.join(app, "Contents", "MacOS", mainName(app))); } catch { return null; }
+  })();
+  const seen = new Set();
+  const entries = manifest.files.map((entry, index) => {
+    const label = `runtime manifest ${config.path} files[${index}]`;
+    if (!isPlainObject(entry)) throw fail(`${label} must be an object`);
+    const bad = relativePathProblem(entry.path);
+    if (bad) throw fail(`${label}.path ${bad}: ${JSON.stringify(entry.path)}`);
+    if (seen.has(entry.path)) throw fail(`${label}.path is listed twice: ${entry.path}`);
+    seen.add(entry.path);
+    if (typeof entry.sha256 !== "string") throw fail(`${label} has no sha256 string (format ${config.format})`);
+    for (const key of ["bytes", "size"]) if (key in entry && !Number.isSafeInteger(entry[key])) throw fail(`${label}.${key} must be an integer`);
+    const file = path.join(baseDir, ...entry.path.split("/"));
+    if (!within(path.resolve(app), path.resolve(file))) throw fail(`${label}.path is outside the bundle: ${entry.path}`);
+    const real = checkFile(file, `${label} (${entry.path})`);
+    if (real === manifestReal) throw fail(`${label} lists the manifest itself`);
+    if (mainReal && real === mainReal) throw fail(`${label} lists the bundle's main executable, which the app seal rewrites after this refresh: ${entry.path}`);
+    return { entry, path: entry.path, file, bytes: Buffer.from(io.readFile(file)) };
+  });
+  const described = entries.map(({ entry, path: relative, file, bytes }) => {
+    entry.sha256 = createHash("sha256").update(bytes).digest("hex");
+    for (const key of ["bytes", "size"]) if (key in entry) entry[key] = bytes.length;
+    return { path: relative, file, sha256: entry.sha256, size: bytes.length };
+  });
+  const text = `${JSON.stringify(manifest, null, detectIndent(original))}${original.endsWith("\n") ? "\n" : ""}`;
+  return { manifestFile, format: config.format, text, changed: text !== original, entries: described };
+}
+
+/**
+ * Re-describe every file the manifest lists from its signed bytes and rewrite the manifest. Run it after all nested code is
+ * signed and before the outer app seal. Returns { manifestFile, format, changed, entries }. Writes only when something changed.
+ */
+export function refreshRuntimeManifest(options) {
+  const io = { ...defaultFs, ...(options.fs ?? {}) };
+  const result = computeRuntimeManifest(options);
+  if (result.changed) io.writeFile(result.manifestFile, result.text);
+  return { manifestFile: result.manifestFile, format: result.format, changed: result.changed, entries: result.entries };
+}
+
+/** Read-only check (use after the app seal): throws when the recorded hashes no longer match the bundle's bytes. */
+export function verifyRuntimeManifest(options) {
+  const result = computeRuntimeManifest(options);
+  if (result.changed) throw fail(`runtime manifest ${options.runtimeManifest.path} does not match the signed bytes in the bundle`, "MAC_RUNTIME_MANIFEST_STALE");
+  return { manifestFile: result.manifestFile, format: result.format, entries: result.entries };
+}
diff --git a/packages/release/mac-runtime-manifest.test.mjs b/packages/release/mac-runtime-manifest.test.mjs
new file mode 100644
index 0000000..f2a7ae6
--- /dev/null
+++ b/packages/release/mac-runtime-manifest.test.mjs
@@ -0,0 +1,183 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import path from "node:path";
+import test from "node:test";
+import { signMacosBundleInOrder } from "./mac-sign-core.mjs";
+import { computeRuntimeManifest, refreshRuntimeManifest, validateRuntimeManifestConfig, verifyRuntimeManifest } from "./mac-runtime-manifest.mjs";
+import { validateMacSigningConfig } from "./mac-signing-matrix.mjs";
+
+const APP = path.resolve(path.sep, "work", "Demo.app");
+const at = (relative) => path.join(APP, ...relative.split("/"));
+const MANIFEST = "Contents/Resources/runtime/manifest.json";
+const sha = (bytes) => createHash("sha256").update(bytes).digest("hex");
+
+// A fake bundle: a map of absolute path -> Buffer | { link: target }. Directories are implicit.
+function fakeBundle(files, { log = [] } = {}) {
+  const store = new Map(Object.entries(files).map(([relative, bytes]) => [at(relative), typeof bytes === "string" ? Buffer.from(bytes) : bytes]));
+  const resolveLink = (file) => { const value = store.get(file); return value?.link ? resolveLink(value.link) : file; };
+  return {
+    store, log,
+    fs: {
+      lstat: (file) => { const value = store.get(file); if (!value) throw new Error("ENOENT"); return { isSymbolicLink: () => Boolean(value.link), isFile: () => !value.link }; },
+      realpath: (file) => (file === APP ? APP : resolveLink(file)),
+      readFile: (file) => store.get(file),
+      writeFile: (file, text) => { log.push(`write ${path.basename(file)}`); store.set(file, Buffer.from(text)); },
+    },
+  };
+}
+
+const manifestText = (files, { indent = 2, extra = {}, newline = true } = {}) => `${JSON.stringify({ schema: 1, platform: "macos-arm64", ...extra, files }, null, indent)}${newline ? "\n" : ""}`;
+const entry = (name, bytes, key = "bytes") => ({ path: name, sha256: sha(bytes), [key]: bytes.length });
+const mainName = () => "demo";
+
+test("refresh re-describes every listed file from the signed bytes and keeps the formatting", () => {
+  const unsigned = Buffer.from("unsigned");
+  const bundle = fakeBundle({
+    "Contents/MacOS/demo": "main",
+    "Contents/Resources/runtime/ffmpeg": "signed-ffmpeg-bytes",
+    "Contents/Resources/runtime/lib/libort.dylib": "signed-ort",
+    [MANIFEST]: manifestText([entry("ffmpeg", unsigned), entry("lib/libort.dylib", unsigned)], { indent: 4, extra: { license: "LGPL" } }),
+  });
+  const result = refreshRuntimeManifest({ app: APP, runtimeManifest: { path: MANIFEST }, fs: bundle.fs, mainName });
+  assert.equal(result.changed, true);
+  const written = bundle.store.get(at(MANIFEST)).toString();
+  const parsed = JSON.parse(written);
+  assert.deepEqual(parsed.files, [entry("ffmpeg", Buffer.from("signed-ffmpeg-bytes")), entry("lib/libort.dylib", Buffer.from("signed-ort"))]);
+  assert.deepEqual(Object.keys(parsed), ["schema", "platform", "license", "files"], "top-level key order is preserved");
+  assert.deepEqual(Object.keys(parsed.files[0]), ["path", "sha256", "bytes"], "entry key order is preserved");
+  assert.match(written, /^ {4}"schema"/m, "indent is preserved");
+  assert.ok(written.endsWith("}\n"), "trailing newline is preserved");
+});
+
+test("refresh is deterministic: a second run changes nothing and writes nothing", () => {
+  const bundle = fakeBundle({ "Contents/Resources/runtime/tool": "signed", [MANIFEST]: manifestText([entry("tool", Buffer.from("old"))]) });
+  const options = { app: APP, runtimeManifest: { path: MANIFEST }, fs: bundle.fs, mainName };
+  refreshRuntimeManifest(options);
+  const first = bundle.store.get(at(MANIFEST)).toString();
+  const again = refreshRuntimeManifest(options);
+  assert.equal(again.changed, false);
+  assert.equal(bundle.store.get(at(MANIFEST)).toString(), first);
+  assert.deepEqual(bundle.log, ["write manifest.json"], "only the first run wrote");
+});
+
+test("size fields: `size` is rewritten when present, and no size key is added when the entry has none", () => {

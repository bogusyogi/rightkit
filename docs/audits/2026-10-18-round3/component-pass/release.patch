@@ -0,0 +1,40 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { realUserHome, relaunchEnvironment } from "./real-user-env.mjs";
+
+const passwd = (homedir) => () => ({ homedir });
+
+test("realUserHome prefers the password database over env.HOME", () => {
+  assert.equal(realUserHome({ userInfo: passwd("/Users/real"), env: { HOME: "/Users/real/ClaudeProfiles/claude-b-home" }, platform: "darwin" }), "/Users/real");
+});
+
+test("realUserHome falls back to env.HOME only when userInfo throws or returns an empty homedir", () => {
+  const env = { HOME: "/home/fallback", USERPROFILE: "C:\\Users\\fallback" };
+  assert.equal(realUserHome({ userInfo: () => { throw new Error("no passwd entry"); }, env, platform: "linux" }), "/home/fallback");
+  assert.equal(realUserHome({ userInfo: passwd(""), env, platform: "darwin" }), "/home/fallback");
+  assert.equal(realUserHome({ userInfo: passwd(""), env, platform: "win32" }), "C:\\Users\\fallback");
+  assert.equal(realUserHome({ userInfo: passwd(""), env: {}, platform: "darwin" }), null);
+});
+
+test("relaunchEnvironment sets HOME to the real home, drops CLAUDE_CONFIG_DIR, and leaves the rest and the input alone", () => {
+  const env = { HOME: "/Users/real/ClaudeProfiles/claude-b-home", CLAUDE_CONFIG_DIR: "/Users/real/ClaudeProfiles/claude-b", CLAUDE_CODE_OTHER: "keep", PATH: "/usr/bin" };
+  const out = relaunchEnvironment(env, { userInfo: passwd("/Users/real"), platform: "darwin" });
+  assert.equal(out.HOME, "/Users/real");
+  assert.equal("CLAUDE_CONFIG_DIR" in out, false);
+  assert.equal(out.CLAUDE_CODE_OTHER, "keep");
+  assert.equal(out.PATH, "/usr/bin");
+  assert.equal(out.USERPROFILE, undefined, "USERPROFILE is only set on Windows");
+  assert.equal(env.CLAUDE_CONFIG_DIR, "/Users/real/ClaudeProfiles/claude-b", "the input is not mutated");
+  assert.equal(env.HOME, "/Users/real/ClaudeProfiles/claude-b-home");
+});
+
+test("relaunchEnvironment on Windows also sets USERPROFILE, and keeps HOME untouched when no real home can be found", () => {
+  const win = relaunchEnvironment({ USERPROFILE: "C:\\profile-b", CLAUDE_CONFIG_DIR: "x" }, { userInfo: passwd("C:\\Users\\real"), platform: "win32" });
+  assert.equal(win.USERPROFILE, "C:\\Users\\real");
+  assert.equal(win.HOME, "C:\\Users\\real");
+  assert.equal("CLAUDE_CONFIG_DIR" in win, false);
+  const none = relaunchEnvironment({ CLAUDE_CONFIG_DIR: "x" }, { userInfo: () => { throw new Error("x"); }, platform: "darwin" });
+  assert.equal("HOME" in none, false);
+  assert.equal("CLAUDE_CONFIG_DIR" in none, false);
+});

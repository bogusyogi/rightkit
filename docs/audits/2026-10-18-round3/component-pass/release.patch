+++ b/packages/release/forbidden-crates.test.mjs
@@ -0,0 +1,52 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { assertNoForbiddenCrates, findForbiddenCrates } from "./forbidden-crates.mjs";
+
+const lock = `
+[[package]]
+name = "app"
+version = "1.0.0"
+dependencies = ["mid", "serde 1.0.0"]
+
+[[package]]
+name = "mid"
+version = "0.1.0"
+dependencies = ["openssl 0.10.0"]
+
+[[package]]
+name = "openssl"
+version = "0.10.0"
+
+[[package]]
+name = "serde"
+version = "1.0.0"
+
+[[package]]
+name = "unrelated"
+version = "1.0.0"
+dependencies = ["reqwest"]
+
+[[package]]
+name = "reqwest"
+version = "0.12.0"
+`;
+
+test("reports the dependency path of a reachable forbidden crate", () => {
+  assert.deepEqual(findForbiddenCrates(lock, "app", ["openssl"]), [{ crate: "openssl", version: "0.10.0", path: ["app", "mid", "openssl"] }]);
+});
+
+test("ignores forbidden crates outside the root's graph and empty rules", () => {
+  assert.deepEqual(findForbiddenCrates(lock, "app", ["reqwest"]), []);
+  assert.deepEqual(findForbiddenCrates(lock, "app", []), []);
+});
+
+test("unknown root crate is an error", () => {
+  assert.throws(() => findForbiddenCrates(lock, "nope", ["openssl"]), /not in Cargo.lock/);
+});
+
+test("assertNoForbiddenCrates throws naming every violation and passes when clean", () => {
+  const deps = { exists: () => true, readFile: () => lock };
+  assert.throws(() => assertNoForbiddenCrates({ lockPath: "Cargo.lock", rootCrate: "app", forbidden: ["openssl", "serde"], ...deps }), /openssl 0\.10\.0: app -> mid -> openssl[\s\S]*serde 1\.0\.0: app -> serde/);
+  assert.deepEqual(assertNoForbiddenCrates({ lockPath: "Cargo.lock", rootCrate: "app", forbidden: ["reqwest"], ...deps }), []);
+  assert.throws(() => assertNoForbiddenCrates({ lockPath: "x", rootCrate: "app", forbidden: ["a"], exists: () => false }), /does not exist/);
+});

diff --git a/packages/release/preflight-command.mjs b/packages/release/preflight-command.mjs
new file mode 100644
index 0000000..8ade673
--- /dev/null
+++ b/packages/release/preflight-command.mjs
@@ -0,0 +1,115 @@
+// Declared preflight steps of `targets.<platform>.preflight` that run before the build starts:
+//
+//   preflight: {
+//     stopApps: ["<install dir>", ...],        // stop the running processes of an install (see stop-app-processes.mjs)
+//     commands: [{ cmd, args?, cwd?, expect?: { exit?, stdoutIncludes?, stdoutMatches?, stdoutExcludes?, stderrIncludes?, stderrMatches? } }],
+//   }
+//
+// `commands` without `expect` assert the exit status only (the output goes straight to the terminal), exactly as before. With
+// `expect` the output is captured, echoed, and asserted too: `exit` is the expected status (a number or a list, default 0);
+// `stdoutIncludes` / `stderrIncludes` are strings (one or a list) that must all occur; `stdoutMatches` / `stderrMatches` are regular
+// expression sources (one or a list) that must all match; `stdoutExcludes` strings may not occur. An unknown key or an invalid
+// regular expression is a configuration error, never ignored. `stopApps` entries are directories (absolute, or relative to the app):
+// a process is stopped only when its executable lies inside one, never by name, and the filesystem root or the home directory are refused.
+import { spawnSync } from "node:child_process";
+import os from "node:os";
+import path from "node:path";
+import { stopAppProcessesInside } from "./stop-app-processes.mjs";
+
+export class PreflightCommandError extends Error {
+  constructor(message) { super(message); this.name = "PreflightCommandError"; this.code = "RK_PREFLIGHT_COMMAND"; }
+}
+const fail = (message) => { throw new PreflightCommandError(message); };
+const isObject = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+
+export const PREFLIGHT_COMMAND_KEYS = Object.freeze(["cmd", "args", "cwd", "expect"]);
+export const PREFLIGHT_EXPECT_KEYS = Object.freeze(["exit", "stdoutIncludes", "stdoutMatches", "stdoutExcludes", "stderrIncludes", "stderrMatches"]);
+
+const list = (value) => (Array.isArray(value) ? value : [value]);
+const textList = (value, label) => {
+  const items = list(value);
+  if (!items.length || items.some((item) => typeof item !== "string" || item === "")) fail(`${label} must be a non-empty string or a list of non-empty strings`);
+  return items;
+};
+
+/** Validate one preflight command and return its normalised form `{ cmd, args, cwd, expect? }`. */
+export function validatePreflightCommand(command, label = "preflight.commands[]") {
+  if (!isObject(command)) fail(`${label} must be an object`);
+  const unknown = Object.keys(command).filter((key) => !PREFLIGHT_COMMAND_KEYS.includes(key));
+  if (unknown.length) fail(`${label} has unknown key(s): ${unknown.join(", ")} (allowed: ${PREFLIGHT_COMMAND_KEYS.join(", ")})`);
+  if (typeof command.cmd !== "string" || !command.cmd.trim()) fail(`${label}.cmd must be a non-empty string`);
+  if (command.args !== undefined && (!Array.isArray(command.args) || command.args.some((arg) => typeof arg !== "string"))) fail(`${label}.args must be a list of strings`);
+  if (command.cwd !== undefined && (typeof command.cwd !== "string" || !command.cwd.trim())) fail(`${label}.cwd must be a non-empty string`);
+  const out = { cmd: command.cmd, args: command.args ? [...command.args] : [], cwd: command.cwd ?? "." };
+  if (command.expect === undefined) return out;
+  const expect = command.expect;
+  if (!isObject(expect)) fail(`${label}.expect must be an object`);
+  const extra = Object.keys(expect).filter((key) => !PREFLIGHT_EXPECT_KEYS.includes(key));
+  if (extra.length) fail(`${label}.expect has unknown key(s): ${extra.join(", ")} (allowed: ${PREFLIGHT_EXPECT_KEYS.join(", ")})`);
+  if (!Object.keys(expect).length) fail(`${label}.expect is empty; declare at least one assertion`);
+  const normalised = {};
+  if (expect.exit !== undefined) {
+    const codes = list(expect.exit);
+    if (!codes.length || codes.some((code) => !Number.isInteger(code) || code < 0)) fail(`${label}.expect.exit must be a non-negative integer or a list of them`);
+    normalised.exit = [...codes];
+  }
+  for (const key of ["stdoutIncludes", "stdoutExcludes", "stderrIncludes"]) if (expect[key] !== undefined) normalised[key] = textList(expect[key], `${label}.expect.${key}`);
+  for (const key of ["stdoutMatches", "stderrMatches"]) {
+    if (expect[key] === undefined) continue;
+    normalised[key] = textList(expect[key], `${label}.expect.${key}`);
+    for (const source of normalised[key]) {
+      try { new RegExp(source); } catch (error) { fail(`${label}.expect.${key} has an invalid regular expression ${JSON.stringify(source)} (${error.message})`); }
+    }
+  }
+  return { ...out, expect: normalised };
+}
+
+/** The assertions that did not hold, as sentences. `result` is `{ status, stdout, stderr }`. */
+export function evaluateExpectation(expect, result) {
+  const problems = [];
+  const stdout = String(result.stdout ?? "");
+  const stderr = String(result.stderr ?? "");
+  const allowed = expect.exit ?? [0];
+  if (!allowed.includes(result.status)) problems.push(`exit status ${result.status ?? "none"}, expected ${allowed.join(" or ")}`);
+  for (const text of expect.stdoutIncludes ?? []) if (!stdout.includes(text)) problems.push(`stdout does not contain ${JSON.stringify(text)}`);
+  for (const text of expect.stdoutExcludes ?? []) if (stdout.includes(text)) problems.push(`stdout contains ${JSON.stringify(text)}`);
+  for (const source of expect.stdoutMatches ?? []) if (!new RegExp(source).test(stdout)) problems.push(`stdout does not match /${source}/`);
+  for (const text of expect.stderrIncludes ?? []) if (!stderr.includes(text)) problems.push(`stderr does not contain ${JSON.stringify(text)}`);
+  for (const source of expect.stderrMatches ?? []) if (!new RegExp(source).test(stderr)) problems.push(`stderr does not match /${source}/`);
+  return problems;
+}
+
+const tailOf = (text) => String(text ?? "").trim().split("\n").slice(-6).join("\n");
+
+/** Run one declared preflight command; throws a PreflightCommandError naming every failed assertion. `spawn` is injectable. */
+export function runPreflightCommand(declared, { appRoot, env = process.env, spawn = spawnSync, write = { stdout: (text) => process.stdout.write(text), stderr: (text) => process.stderr.write(text) } } = {}) {
+  const command = validatePreflightCommand(declared);
+  const cwd = path.resolve(appRoot, command.cwd);
+  if (!command.expect) {
+    const result = spawn(command.cmd, command.args, { cwd, env, stdio: "inherit", windowsHide: true, shell: false });
+    if (result.error) fail(`${command.cmd} could not start: ${result.error.message}`);
+    if (result.status !== 0) fail(`${command.cmd} exited ${result.status}`);
+    return { status: result.status };
+  }
+  const result = spawn(command.cmd, command.args, { cwd, env, encoding: "utf8", maxBuffer: 64 * 1024 * 1024, windowsHide: true, shell: false });
+  if (result.error) fail(`${command.cmd} could not start: ${result.error.message}`);
+  if (result.stdout) write.stdout(String(result.stdout));
+  if (result.stderr) write.stderr(String(result.stderr));
+  const problems = evaluateExpectation(command.expect, result);
+  if (problems.length) fail(`preflight command ${[command.cmd, ...command.args].join(" ")} failed its expectations: ${problems.join("; ")}${result.stdout ? `\nstdout (tail):\n${tailOf(result.stdout)}` : ""}${result.stderr ? `\nstderr (tail):\n${tailOf(result.stderr)}` : ""}`);
+  return { status: result.status };
+}
+
+/** A `stopApps` directory resolved against the app root; the filesystem root, the home directory and non-strings are refused. */
+export function resolveStopAppDir(dir, { appRoot, home = os.homedir() } = {}) {
+  if (typeof dir !== "string" || !dir.trim()) fail("preflight.stopApps entries must be non-empty directory paths");
+  const resolved = path.resolve(appRoot ?? process.cwd(), dir);
+  if (path.parse(resolved).root === resolved) fail(`preflight.stopApps refuses the filesystem root: ${dir}`);
+  if (home && path.resolve(home).toLowerCase() === resolved.toLowerCase()) fail(`preflight.stopApps refuses the home directory: ${dir}`);
+  return resolved;
+}
+
+/** Stop the running processes of the install in `dir`. `stop` is injectable. Returns the stopped pids. */
+export function stopPreflightApps(dir, { appRoot, stop = stopAppProcessesInside, home } = {}) {
+  return stop(resolveStopAppDir(dir, { appRoot, home }));
+}

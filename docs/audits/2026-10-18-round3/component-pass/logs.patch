@@ -0,0 +1,134 @@
+import type { LogsClient } from './index.js';
+import type { WindowCrashTarget } from './crash.js';
+
+/** Event name written for every captured renderer error. */
+export const RENDERER_ERROR_EVENT = 'renderer_error';
+
+export type RendererErrorKind = 'uncaught' | 'rejection';
+
+/** The slice of `Storage` the persisted ring buffer needs. Injected so non-DOM hosts work. */
+export interface RingStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+/** One persisted, content-free entry. */
+export interface RendererErrorEntry {
+  ts_ms: number;
+  surface: string;
+  kind: RendererErrorKind;
+  code: string;
+  /** Times this kind and code repeated in a row (deduplicated). */
+  count: number;
+}
+
+export interface RendererErrorCaptureOptions {
+  /** Which UI surface the listener runs in. Sent as the `surface` field. */
+  surface: string;
+  /** Default: `globalThis`. */
+  target?: WindowCrashTarget;
+  /** Persist the newest entries here (for example `localStorage`) so they survive a reload. */
+  storage?: RingStorage;
+  /** Storage key. Default `rightkit.logs.renderer_errors`. */
+  storageKey?: string;
+  /** Newest entries kept in storage. Default 50. */
+  maxEntries?: number;
+  /** An identical kind and code within this many ms of the previous one is counted, not logged
+   * again. Default 1000. */
+  dedupMs?: number;
+  now?: () => number;
+}
+
+const DEFAULT_KEY = 'rightkit.logs.renderer_errors';
+const installed = new WeakMap<object, () => void>();
+
+function errorCode(reason: unknown): string {
+  let name: unknown;
+  if (reason instanceof Error) name = reason.name;
+  else if (reason !== null && typeof reason === 'object') name = (reason as { name?: unknown }).name;
+  return typeof name === 'string' && /^[A-Za-z0-9_.:-]{1,64}$/.test(name) ? name : 'Error';
+}
+
+/** Reads the persisted ring buffer. Returns `[]` when storage is missing, empty or corrupt. */
+export function readRendererErrorRing(
+  storage: RingStorage,
+  storageKey: string = DEFAULT_KEY,
+): RendererErrorEntry[] {
+  try {
+    const parsed: unknown = JSON.parse(storage.getItem(storageKey) ?? '[]');
+    return Array.isArray(parsed) ? (parsed as RendererErrorEntry[]) : [];
+  } catch {
+    return [];
+  }
+}
+
+/**
+ * Opt-in: capture window `error` and `unhandledrejection` as content-free `renderer_error`
+ * events on `client`: fields `surface`, `kind` (`uncaught` | `rejection`) and `code` (the error
+ * name only, never the message or stack). The app's `allowedFields` must include `surface`,
+ * `kind` and `code`. Repeats of the same kind and code inside `dedupMs` are counted, not
+ * logged. With `storage`, the newest `maxEntries` entries are also kept in a ring buffer that
+ * survives a reload (read it with {@link readRendererErrorRing}).
+ *
+ * Idempotent per target: a second call returns the first call's uninstall function and adds no
+ * listeners. Nothing here throws into the page.
+ */
+export function installRendererErrorCapture(
+  client: Pick<LogsClient, 'error'>,
+  options: RendererErrorCaptureOptions,
+): () => void {
+  const target = options.target ?? (globalThis as unknown as WindowCrashTarget);
+  const existing = installed.get(target as object);
+  if (existing) return existing;
+
+  const now = options.now ?? Date.now;
+  const dedupMs = Math.max(0, options.dedupMs ?? 1_000);
+  const maxEntries = Math.max(1, options.maxEntries ?? 50);
+  const storageKey = options.storageKey ?? DEFAULT_KEY;
+  let last: { kind: RendererErrorKind; code: string; at: number; entry: RendererErrorEntry } | null = null;
+
+  function persist(entry: RendererErrorEntry, repeated: boolean): void {
+    const storage = options.storage;
+    if (!storage) return;
+    try {
+      const ring = readRendererErrorRing(storage, storageKey);
+      if (repeated && ring.length > 0) ring[ring.length - 1] = entry;
+      else ring.push(entry);
+      storage.setItem(storageKey, JSON.stringify(ring.slice(-maxEntries)));
+    } catch {
+      // storage can be full or blocked; capture must not raise
+    }
+  }
+
+  function record(kind: RendererErrorKind, reason: unknown): void {
+    try {
+      const code = errorCode(reason);
+      const at = now();
+      if (last && last.kind === kind && last.code === code && at - last.at <= dedupMs) {
+        last.entry.count += 1;
+        last.at = at;
+        persist(last.entry, true);
+        return;
+      }
+      const entry: RendererErrorEntry = { ts_ms: at, surface: options.surface, kind, code, count: 1 };
+      last = { kind, code, at, entry };
+      client.error(RENDERER_ERROR_EVENT, { surface: options.surface, kind, code });
+      persist(entry, false);
+    } catch {
+      // never raise from the error path
+    }
+  }
+
+  const onError = (event: any): void => record('uncaught', event?.error ?? event);
+  const onRejection = (event: any): void => record('rejection', event?.reason);
+
+  target.addEventListener('error', onError);
+  target.addEventListener('unhandledrejection', onRejection);
+  const uninstall = (): void => {
+    target.removeEventListener('error', onError);
+    target.removeEventListener('unhandledrejection', onRejection);
+    installed.delete(target as object);
+  };
+  installed.set(target as object, uninstall);
+  return uninstall;
+}

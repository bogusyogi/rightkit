index 0000000..369c05d
--- /dev/null
+++ b/crates/rightkit-logs/src/keytext.rs
@@ -0,0 +1,264 @@
+//! Text-line redaction that replaces the value of chosen `key=value` pairs with a stable token.
+//!
+//! [`RedactionPolicy`](crate::RedactionPolicy) works on JSON keys. Plain text log lines such as
+//! `sync ok account=ada@example.com label=Work` carry the same data inline. A
+//! [`KeyTokenRedactor`] replaces each such value with a token derived from the value, so the same
+//! account always shows the same token and a reader can still tell two accounts apart and follow
+//! one across lines, without the value itself being written.
+
+const TOKEN_MARK: u8 = b'#';
+const TOKEN_HEX_LEN: usize = 16;
+
+/// A stable token for `value`: `#` and 16 lower-case hex digits, the first 8 bytes of
+/// HMAC-SHA256 keyed with `salt` over `value` (`rightkit_crypto::hmac_sha256`).
+///
+/// The same `(value, salt)` always gives the same token, on every platform. Without the salt the
+/// token cannot be recomputed from a guessed value, so keep `salt` an app-private secret (for
+/// example a random per-install string): with an empty or public salt, a value with few
+/// possibilities (a short label) can still be found by trying candidates. The token is truncated
+/// to 64 bits, which is enough to tell accounts apart in a log, not to authenticate anything.
+pub fn key_token(value: &str, salt: &str) -> String {
+    let mac = rightkit_crypto::hmac_sha256(salt.as_bytes(), value.as_bytes());
+    let hex = rightkit_crypto::hex_encode(&mac[..TOKEN_HEX_LEN / 2]);
+    format!("#{hex}")
+}
+
+/// Replaces the value of each configured `key=` pair in a text line with [`key_token`].
+///
+/// Keys match case-insensitively at a word start (`account=` matches `Account=` but not
+/// `my_account=`). A value runs to the next whitespace or one of `, ; & ) ] }`, or, when it starts
+/// with `"` or `'`, to the matching quote (the quotes stay). An empty value, and a value that is
+/// already a token, are left unchanged, so redacting twice gives the same text. All other text is
+/// untouched; combine with [`scrub_text`](crate::scrub_text) for credentials and paths.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct KeyTokenRedactor {
+    /// Lower-case `key=` needles.
+    needles: Vec<String>,
+    salt: String,
+}
+
+impl KeyTokenRedactor {
+    /// Redact the values of `keys` (for example `["account", "label"]`). A trailing `=` on a key
+    /// is ignored and empty keys are skipped.
+    pub fn new<I, S>(keys: I) -> Self
+    where
+        I: IntoIterator<Item = S>,
+        S: AsRef<str>,
+    {
+        let needles = keys
+            .into_iter()
+            .map(|key| {
+                key.as_ref()
+                    .trim()
+                    .trim_end_matches('=')
+                    .to_ascii_lowercase()
+            })
+            .filter(|key| !key.is_empty())
+            .map(|key| format!("{key}="))
+            .collect();
+        Self {
+            needles,
+            salt: String::new(),
+        }
+    }
+
+    /// The HMAC key for every token. Use an app-private secret: tokens then differ between apps
+    /// and cannot be recomputed from guessed values. Default is empty (unkeyed in effect).
+    pub fn with_salt(mut self, salt: impl Into<String>) -> Self {
+        self.salt = salt.into();
+        self
+    }
+
+    /// The token for `value` under this redactor's salt (see [`key_token`]).
+    pub fn token(&self, value: &str) -> String {
+        key_token(value, &self.salt)
+    }
+
+    /// `line` with the value of every configured `key=` replaced by its token.
+    pub fn redact(&self, line: &str) -> String {
+        if self.needles.is_empty() {
+            return line.to_string();
+        }
+        let lower = line.to_ascii_lowercase();
+        let bytes = line.as_bytes();
+        let mut out = String::with_capacity(line.len());
+        let mut pos = 0usize;
+        while pos < line.len() {
+            let Some((start, needle_len)) = self.next_match(&lower, bytes, pos) else {
+                break;
+            };
+            let value_start = start + needle_len;
+            let (inner_start, inner_end, after) = value_span(line, value_start);
+            out.push_str(&line[pos..inner_start]);
+            let inner = &line[inner_start..inner_end];
+            if inner.is_empty() || is_token(inner) {
+                out.push_str(inner);
+            } else {
+                out.push_str(&self.token(inner));
+            }
+            out.push_str(&line[inner_end..after]);
+            pos = after;
+        }
+        out.push_str(&line[pos..]);
+        out
+    }
+
+    /// Earliest `key=` at or after `from` that starts a word: `(start, needle length)`.
+    fn next_match(&self, lower: &str, bytes: &[u8], from: usize) -> Option<(usize, usize)> {
+        let mut best: Option<(usize, usize)> = None;
+        for needle in &self.needles {
+            let mut search = from;
+            while let Some(rel) = lower[search..].find(needle.as_str()) {
+                let start = search + rel;
+                if start == 0 || !is_key_byte(bytes[start - 1]) {
+                    if best.is_none_or(|(found, _)| start < found) {
+                        best = Some((start, needle.len()));
+                    }
+                    break;
+                }
+                // `start` is the first byte of an ASCII needle, so `start + 1` is a boundary.
+                search = start + 1;
+            }
+        }
+        best
+    }
+}
+
+/// [`KeyTokenRedactor`] with no salt, for one-off calls: the value of each of `keys` in `line`
+/// becomes its [`key_token`].
+pub fn redact_key_values(line: &str, keys: &[&str]) -> String {
+    KeyTokenRedactor::new(keys.iter().copied()).redact(line)
+}
+
+fn is_key_byte(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-'
+}
+
+fn is_token(text: &str) -> bool {
+    let bytes = text.as_bytes();
+    bytes.len() == TOKEN_HEX_LEN + 1
+        && bytes[0] == TOKEN_MARK
+        && bytes[1..]
+            .iter()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(b))
+}
+
+/// `(inner start, inner end, end of the whole value including a closing quote)` for the value
+/// that begins at `value_start`.
+fn value_span(line: &str, value_start: usize) -> (usize, usize, usize) {
+    let bytes = line.as_bytes();
+    match bytes.get(value_start) {
+        Some(&quote) if quote == b'"' || quote == b'\'' => {
+            let inner_start = value_start + 1;
+            match line[inner_start..].find(quote as char) {
+                Some(rel) => (inner_start, inner_start + rel, inner_start + rel + 1),
+                None => (inner_start, line.len(), line.len()),
+            }
+        }
+        _ => {
+            let end = bytes[value_start.min(bytes.len())..]
+                .iter()
+                .position(|b| b.is_ascii_whitespace() || b",;&)]}".contains(b))
+                .map_or(line.len(), |rel| value_start + rel);
+            (value_start, end, end)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn token_is_stable_and_distinguishes_values_and_salts() {
+        let mac = rightkit_crypto::hmac_sha256(b"s", b"a@b.c");
+        assert_eq!(
+            key_token("a@b.c", "s"),
+            format!("#{}", rightkit_crypto::hex_encode(&mac[..8]))
+        );
+        assert_eq!(key_token("a@b.c", "s").len(), 17);
+        assert_eq!(key_token("a@b.c", "s"), key_token("a@b.c", "s"));
+        assert_ne!(key_token("a@b.c", "s"), key_token("a@b.c", "t"));
+        assert_ne!(key_token("a@b.c", "s"), key_token("d@b.c", "s"));
+    }
+
+    #[test]
+    fn replaces_account_and_label_values_and_keeps_the_rest() {
+        let r = KeyTokenRedactor::new(["account", "label"]);
+        let out = r.redact("sync ok account=ada@example.com label=Work n=3");
+        assert_eq!(
+            out,
+            format!(
+                "sync ok account={} label={} n=3",
+                r.token("ada@example.com"),
+                r.token("Work")
+            )
+        );
+        assert!(!out.contains("ada@example.com"));
+    }
+
+    #[test]
+    fn same_value_gives_the_same_token_on_every_line() {
+        let r = KeyTokenRedactor::new(["account"]);
+        let token = r.token("ada@example.com");
+        assert!(r
+            .redact("one account=ada@example.com")
+            .ends_with(&format!("account={token}")));
+        assert!(r
+            .redact("two account=ada@example.com, done")
+            .contains(&format!("account={token}, done")));
+    }
+
+    #[test]
+    fn keys_match_case_insensitively_at_word_starts_only() {
+        let r = KeyTokenRedactor::new(["account"]);
+        let out = r.redact("my_account=keep Account=hide");
+        assert!(out.starts_with("my_account=keep "));
+        assert!(!out.contains("hide"));
+    }
+
+    #[test]
+    fn quoted_values_keep_their_quotes_and_unterminated_runs_to_the_end() {
+        let r = KeyTokenRedactor::new(["label"]);
+        let out = r.redact("label=\"Work stuff\" next label='x y");
+        assert_eq!(
+            out,
+            format!(
+                "label=\"{}\" next label='{}",
+                r.token("Work stuff"),
+                r.token("x y")
+            )
+        );
+    }
+
+    #[test]
+    fn empty_values_and_existing_tokens_are_left_alone_so_redaction_is_idempotent() {
+        let r = KeyTokenRedactor::new(["account"]);
+        assert_eq!(r.redact("account= next"), "account= next");
+        let once = r.redact("account=ada");
+        assert_eq!(r.redact(&once), once);
+    }
+
+    #[test]
+    fn salt_changes_tokens_and_no_keys_is_a_no_op() {
+        let plain = KeyTokenRedactor::new(["account"]);
+        let salted = KeyTokenRedactor::new(["account"]).with_salt("app");
+        assert_ne!(plain.token("ada"), salted.token("ada"));
+        assert_eq!(
+            KeyTokenRedactor::new(Vec::<String>::new()).redact("account=ada"),
+            "account=ada"
+        );
+        assert_eq!(
+            redact_key_values("account=ada", &["account"]),
+            format!("account={}", key_token("ada", ""))
+        );
+    }
+
+    #[test]
+    fn handles_non_ascii_text_around_the_pairs() {
+        let r = KeyTokenRedactor::new(["account"]);
+        let out = r.redact("né account=ada é");
+        assert!(out.starts_with("né account=#"));
+        assert!(out.ends_with(" é"));
+    }
+}

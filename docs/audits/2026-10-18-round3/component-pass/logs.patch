+import { describe, expect, it, vi } from 'vitest';
+import {
+  RENDERER_ERROR_EVENT,
+  installRendererErrorCapture,
+  readRendererErrorRing,
+  type RingStorage,
+} from './renderer-errors.js';
+import type { WindowCrashTarget } from './crash.js';
+
+function fakeTarget() {
+  const handlers = new Map<string, (e: unknown) => void>();
+  const target: WindowCrashTarget = {
+    addEventListener: (t, l) => void handlers.set(t, l),
+    removeEventListener: (t) => void handlers.delete(t),
+  };
+  return { target, handlers };
+}
+
+function memoryStorage(): RingStorage & { data: Map<string, string> } {
+  const data = new Map<string, string>();
+  return { data, getItem: (k) => data.get(k) ?? null, setItem: (k, v) => void data.set(k, v) };
+}
+
+describe('installRendererErrorCapture', () => {
+  it('logs a content-free renderer_error with the error name as code', () => {
+    const client = { error: vi.fn() };
+    const { target, handlers } = fakeTarget();
+    installRendererErrorCapture(client, { surface: 'main', target });
+    handlers.get('error')!({ error: new TypeError('secret user text') });
+    handlers.get('unhandledrejection')!({ reason: 'plain string' });
+    expect(client.error).toHaveBeenNthCalledWith(1, RENDERER_ERROR_EVENT, {
+      surface: 'main',
+      kind: 'uncaught',
+      code: 'TypeError',
+    });
+    expect(client.error).toHaveBeenNthCalledWith(2, RENDERER_ERROR_EVENT, {
+      surface: 'main',
+      kind: 'rejection',
+      code: 'Error',
+    });
+    expect(JSON.stringify(client.error.mock.calls)).not.toContain('secret user text');
+  });
+
+  it('is idempotent per target and uninstalls cleanly', () => {
+    const client = { error: vi.fn() };
+    const { target, handlers } = fakeTarget();
+    const off = installRendererErrorCapture(client, { surface: 'main', target });
+    const again = installRendererErrorCapture(client, { surface: 'main', target });
+    expect(again).toBe(off);
+    expect(handlers.size).toBe(2);
+    off();
+    expect(handlers.size).toBe(0);
+    installRendererErrorCapture(client, { surface: 'main', target });
+    expect(handlers.size).toBe(2);
+  });
+
+  it('deduplicates repeats inside the window and counts them in the ring buffer', () => {
+    const client = { error: vi.fn() };
+    const { target, handlers } = fakeTarget();
+    const storage = memoryStorage();
+    let t = 1000;
+    installRendererErrorCapture(client, { surface: 's', target, storage, dedupMs: 500, now: () => t });
+    const boom = () => handlers.get('error')!({ error: new RangeError('x') });
+    boom();
+    t = 1200;
+    boom();
+    t = 3000;
+    boom();
+    expect(client.error).toHaveBeenCalledTimes(2);
+    const ring = readRendererErrorRing(storage);
+    expect(ring.map((e) => e.count)).toEqual([2, 1]);
+    expect(ring[0]).toMatchObject({ surface: 's', kind: 'uncaught', code: 'RangeError' });
+  });
+
+  it('keeps only the newest entries and survives broken or corrupt storage', () => {
+    const client = { error: vi.fn() };
+    const { target, handlers } = fakeTarget();
+    const storage = memoryStorage();
+    let t = 0;
+    installRendererErrorCapture(client, {
+      surface: 's',
+      target,
+      storage,
+      maxEntries: 2,
+      dedupMs: 0,
+      now: () => (t += 10),
+    });
+    for (const name of ['A', 'B', 'C']) {
+      const e = new Error('m');
+      e.name = name;
+      handlers.get('error')!({ error: e });
+    }
+    expect(readRendererErrorRing(storage).map((e) => e.code)).toEqual(['B', 'C']);
+    storage.data.set('rightkit.logs.renderer_errors', '{not json');
+    expect(readRendererErrorRing(storage)).toEqual([]);
+    const { target: t2, handlers: h2 } = fakeTarget();
+    const broken: RingStorage = {
+      getItem: () => {
+        throw new Error('blocked');
+      },
+      setItem: () => {
+        throw new Error('blocked');
+      },
+    };
+    installRendererErrorCapture(client, { surface: 's', target: t2, storage: broken });
+    expect(() => h2.get('error')!({ error: new Error('x') })).not.toThrow();
+  });
+
+  it('never throws when the client throws', () => {
+    const { target, handlers } = fakeTarget();
+    installRendererErrorCapture(
+      {
+        error: () => {
+          throw new Error('boom');
+        },
+      },
+      { surface: 's', target },
+    );
+    expect(() => handlers.get('unhandledrejection')!({ reason: new Error('x') })).not.toThrow();
+  });
+});

+/// Delete every daily file `<prefix>.YYYY-MM-DD.jsonl` in `dir` for each of `file_prefixes`, and
+/// return how many were removed. Use it for a "clear logs" action over a whole family of logs
+/// (for example the app's own prefix and its engine's) in one call. Only names of that exact form
+/// are touched, so other files and rotated copies in the directory stay. A missing directory
+/// removes nothing (`Ok(0)`). Every file is attempted; if some cannot be removed (for example one
+/// held open without delete sharing), the first error is returned after the rest were tried. A
+/// running [`TracingGuard`] keeps writing: on Windows and Unix its open file is unlinked and the
+/// next write after midnight (or after the next install) creates a fresh one.
+pub fn clear_tracing_logs(dir: &Path, file_prefixes: &[&str]) -> io::Result<usize> {
+    let mut removed = 0usize;
+    let mut first_error: Option<io::Error> = None;
+    for prefix in file_prefixes {
+        validate_prefix(prefix)?;
+        for name in daily_file_names(dir, prefix)? {
+            match fs::remove_file(dir.join(&name)) {
+                Ok(()) => removed += 1,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                Err(error) => {
+                    first_error.get_or_insert(error);
+                }
+            }
+        }
+    }
+    match first_error {
+        Some(error) => Err(error),
+        None => Ok(removed),
+    }
+}

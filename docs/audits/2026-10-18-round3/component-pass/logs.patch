+/// Shift `path` into the numbered chain `path.1`, `path.2`, ... `path.keep` now, whatever its
+/// size: the oldest (`path.keep`) is removed, each `path.k` becomes `path.k+1`, and `path`
+/// becomes `path.1`. `keep` of `0` behaves as `1`. A missing or empty `path` is left alone
+/// (`Ok`). The caller decides when to rotate (for example on a size check); nothing here reads
+/// the size.
+pub fn rotate_numbered(path: &Path, keep: u32) -> io::Result<()> {
+    match fs::metadata(path) {
+        Ok(m) if m.len() > 0 => {}
+        _ => return Ok(()),
+    }
+    roll_generations(path, keep, "app.log", RotatedNaming::Suffix)
+}
+
 /// After a failed rotation: refuse the append once the current file is at twice the rotation size.

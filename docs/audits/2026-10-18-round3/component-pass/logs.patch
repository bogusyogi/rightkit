+/// Warn-and-continue form of [`install_tracing`]: it never fails. When logging cannot be set up
+/// (an invalid prefix or filter, an unusable directory, or a global subscriber that is already
+/// installed), it prints one `[rightkit-logs] ...` line on stderr and returns
+/// [`TracingGuard::noop`], so the app carries on without file logs and calling it again is
+/// harmless. On success it is the same as [`install_tracing`].
+pub fn install_tracing_or_warn(config: TracingFileConfig) -> TracingGuard {
+    let dir = config.dir.clone();
+    match install_tracing(config) {
+        Ok(guard) => guard,
+        Err(error) => {
+            report(&dir, &error);
+            TracingGuard::noop()
+        }
+    }
+}

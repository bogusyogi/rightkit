+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn dir(label: &str) -> PathBuf {
+        let d = std::env::temp_dir().join(format!(
+            "rightkit-logs-rotate-{label}-{}-{}",
+            std::process::id(),
+            crate::now_ms()
+        ));
+        let _ = fs::remove_dir_all(&d);
+        fs::create_dir_all(&d).unwrap();
+        d
+    }
+
+    #[test]
+    fn rotate_numbered_shifts_the_chain_and_drops_the_oldest() {
+        let d = dir("numbered");
+        let log = d.join("daemon.log");
+        for run in ["one", "two", "three", "four"] {
+            fs::write(&log, run).unwrap();
+            rotate_numbered(&log, 3).unwrap();
+        }
+        assert!(!log.exists());
+        let read = |n: &str| fs::read_to_string(d.join(n)).unwrap();
+        assert_eq!(read("daemon.log.1"), "four");
+        assert_eq!(read("daemon.log.2"), "three");
+        assert_eq!(read("daemon.log.3"), "two");
+        assert!(!d.join("daemon.log.4").exists());
+    }
+
+    #[test]
+    fn rotate_numbered_leaves_a_missing_or_empty_file_alone() {
+        let d = dir("numbered-empty");
+        let log = d.join("daemon.log");
+        rotate_numbered(&log, 2).unwrap();
+        fs::write(&log, "").unwrap();
+        rotate_numbered(&log, 2).unwrap();
+        assert!(log.exists());
+        assert!(!d.join("daemon.log.1").exists());
+    }
+}

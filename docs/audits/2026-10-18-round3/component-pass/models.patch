+//! `DownloadSource` (a caller-chosen route for a pinned model), the serde `ModelStatus` and the
+//! effective-directory lookup (Orthic-Labs/rightkit#727, #741). Real files and a tiny local HTTP
+//! server; nothing here touches the shared suite root.
+
+use rightkit_models::suite::catalog::{ModelSpec, ModelTier, RemoteFile, SpecFile, SpecSource};
+use rightkit_models::suite::manifest::VerifyMode;
+use rightkit_models::suite::store::{self, EnsureOptions};
+use rightkit_models::suite::{
+    effective_dir_at, DownloadSource, EffectiveSource, EntryState, ModelStatus,
+};
+use sha2::{Digest, Sha256};
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Write};
+use std::net::TcpListener;
+use std::sync::{Arc, Mutex};
+
+const WEIGHTS: &[u8] = b"weights-bytes";
+const VOCAB: &[u8] = b"vocab-bytes";
+
+fn sha(bytes: &[u8]) -> String {
+    Sha256::digest(bytes)
+        .iter()
+        .map(|x| format!("{x:02x}"))
+        .collect()
+}
+
+fn leak(s: impl Into<String>) -> &'static str {
+    Box::leak(s.into().into_boxed_str())
+}
+
+fn http() -> rightkit_models::http::ModelHttp {
+    rightkit_models::http::http_client_with_options(rightkit_models::http::ModelHttpOptions {
+        proxy: rightkit_models::http::ProxyMode::None,
+        address_policy: rightkit_http::AddressPolicy::public_web()
+            .allow_if(vec!["127.0.0.1".to_string()], |ip| ip.is_loopback()),
+        ..Default::default()
+    })
+}
+
+/// Serves `routes` (path to body) over plain HTTP, one request per connection, and records each
+/// request as `(request line, had an Authorization header)`.
+struct Server {
+    base: String,
+    log: Arc<Mutex<Vec<(String, bool)>>>,
+}
+
+fn serve(routes: Vec<(&str, Vec<u8>)>) -> Server {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let base = format!("http://{}", listener.local_addr().unwrap());
+    let routes: HashMap<String, Vec<u8>> = routes
+        .into_iter()
+        .map(|(path, body)| (path.to_string(), body))
+        .collect();
+    let log = Arc::new(Mutex::new(Vec::new()));
+    let seen = log.clone();
+    std::thread::spawn(move || {
+        for stream in listener.incoming() {
+            let Ok(mut stream) = stream else { continue };
+            let mut reader = BufReader::new(stream.try_clone().unwrap());
+            let mut request_line = String::new();
+            if reader.read_line(&mut request_line).is_err() {
+                continue;
+            }
+            let mut authorized = false;
+            loop {
+                let mut line = String::new();
+                if reader.read_line(&mut line).unwrap_or(0) == 0 || line.trim().is_empty() {
+                    break;
+                }
+                authorized |= line.to_ascii_lowercase().starts_with("authorization:");
+            }
+            let request_line = request_line.trim().to_string();
+            let path = request_line.split(' ').nth(1).unwrap_or("").to_string();
+            seen.lock().unwrap().push((request_line, authorized));
+            let response = match routes.get(&path) {
+                Some(body) => {
+                    let mut out = format!(
+                        "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+                        body.len()
+                    )
+                    .into_bytes();
+                    out.extend_from_slice(body);
+                    out
+                }
+                None => b"HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
+                    .to_vec(),
+            };
+            let _ = stream.write_all(&response);
+        }
+    });
+    Server { base, log }
+}
+
+fn spec_files(files: &[(&'static str, &[u8])]) -> &'static [SpecFile] {
+    let list: Vec<SpecFile> = files
+        .iter()
+        .map(|(path, bytes)| SpecFile {
+            path,
+            sha256: Some(leak(sha(bytes))),
+            size: Some(bytes.len() as u64),
+        })
+        .collect();
+    Box::leak(list.into_boxed_slice())
+}
+
+/// A pinned two-file model with no catalog URL, like the EmbeddingGemma 2 Q4 bundle.
+fn urlless_spec(id: &'static str) -> ModelSpec {
+    let remote: Vec<RemoteFile> = [("weights.bin", WEIGHTS), ("sub/vocab.txt", VOCAB)]
+        .iter()
+        .map(|(path, bytes)| RemoteFile {
+            path,
+            url: None,
+            sha256: Some(leak(sha(bytes))),
+            size: Some(bytes.len() as u64),
+        })
+        .collect();
+    ModelSpec {
+        id,
+        label: "Pinned model",
+        tier: ModelTier::AddOn,
+        entitlement: false,
+        version: "r1",
+        size_hint_bytes: (WEIGHTS.len() + VOCAB.len()) as u64,
+        files: spec_files(&[("weights.bin", WEIGHTS), ("sub/vocab.txt", VOCAB)]),
+        source: SpecSource::Files(Box::leak(remote.into_boxed_slice())),
+        legacy_dirs: &[],
+        retired_legacy_paths: &[],
+        retired_store_ids: &[],
+    }
+}
+
+fn opts(app: &'static str) -> EnsureOptions<'static> {
+    EnsureOptions {
+        seed_dir: None,
+        authorization: Some("Bearer app-secret"),
+        app_id: app,
+    }
+}
+
+#[test]
+fn source_validation_accepts_a_base_and_refuses_unsafe_values() {
+    let source = DownloadSource::new("https://mirror.example/models/gemma/").unwrap();
+    assert_eq!(source.as_str(), "https://mirror.example/models/gemma");
+    assert_eq!(
+        source.file_url("sub/vocab.txt"),
+        "https://mirror.example/models/gemma/sub/vocab.txt"
+    );
+    for bad in [
+        "",
+        "ftp://mirror.example/x",
+        "mirror.example/x",
+        "https://",
+        "https:///path",
+        "https://user:pw@mirror.example/x",
+        "https://mirror.example/x?token=1",
+        "https://mirror.example/x#frag",
+        "https://mirror.example/a b",
+    ] {
+        assert!(DownloadSource::new(bad).is_err(), "{bad:?} must be refused");
+    }
+}
+
+#[test]
+fn a_urlless_pinned_model_installs_from_a_source_without_the_app_bearer() {
+    let server = serve(vec![
+        ("/mirror/weights.bin", WEIGHTS.to_vec()),
+        ("/mirror/sub/vocab.txt", VOCAB.to_vec()),
+    ]);
+    let spec = urlless_spec("gemma-like");
+    let root = tempfile::tempdir().unwrap();
+    let models = root.path().join("models");
+
+    // Without a source the catalog has no route.
+    let err = store::ensure_ready(&http(), &models, &spec, &opts("mail"), |_| {}).unwrap_err();
+    assert!(err.contains("no download endpoint"), "{err}");
+
+    let source = DownloadSource::new(format!("{}/mirror", server.base)).unwrap();
+    let status = store::ensure_ready_from_source(
+        &http(),
+        &models,
+        &spec,
+        &opts("mail"),
+        &source,
+        &|| false,
+        |_| {},
+    )
+    .unwrap();
+    assert_eq!(status.state, EntryState::Ready);
+    assert_eq!(std::fs::read(models.join("gemma-like/weights.bin")).unwrap(), WEIGHTS);
+
+    let log = server.log.lock().unwrap();
+    assert_eq!(log.len(), 2, "{log:?}");
+    assert!(log.iter().all(|(_, authorized)| !authorized), "bearer leaked: {log:?}");
+    assert!(log.iter().any(|(line, _)| line.starts_with("GET /mirror/sub/vocab.txt")));
+}
+
+#[test]
+fn a_source_cannot_supply_wrong_bytes_for_a_pinned_file() {
+    let server = serve(vec![
+        ("/mirror/weights.bin", b"tampered-bytes".to_vec()),
+        ("/mirror/sub/vocab.txt", VOCAB.to_vec()),
+    ]);
+    let spec = urlless_spec("gemma-tampered");
+    let root = tempfile::tempdir().unwrap();
+    let models = root.path().join("models");
+    let source = DownloadSource::new(format!("{}/mirror", server.base)).unwrap();
+    let result = store::ensure_ready_from_source(
+        &http(),
+        &models,
+        &spec,
+        &opts("mail"),
+        &source,
+        &|| false,
+        |_| {},
+    );
+    assert!(result.is_err());
+    assert_ne!(
+        store::status_at(&models, &spec, VerifyMode::Full).state,
+        EntryState::Ready
+    );
+}
+
+#[test]
+fn model_status_serializes_as_plain_json_and_round_trips() {
+    let spec = urlless_spec("status-json");
+    let root = tempfile::tempdir().unwrap();
+    let status = store::status_at(root.path(), &spec, VerifyMode::Size);
+    let value = serde_json::to_value(&status).unwrap();
+    assert_eq!(value["state"], "missing");
+    assert_eq!(value["tier"], "add_on");
+    assert_eq!(value["id"], "status-json");
+    assert_eq!(value["files_total"], 2);
+    let back: ModelStatus = serde_json::from_value(value).unwrap();
+    assert_eq!(back.state, EntryState::Missing);
+    assert_eq!(back.dir, status.dir);
+    assert_eq!(back.needed, status.needed);
+}
+
+#[test]
+fn effective_dir_prefers_the_shared_copy_then_a_ready_seed_and_is_none_otherwise() {
+    let server = serve(vec![
+        ("/m/weights.bin", WEIGHTS.to_vec()),
+        ("/m/sub/vocab.txt", VOCAB.to_vec()),
+    ]);
+    let spec = urlless_spec("effective");
+    let root = tempfile::tempdir().unwrap();
+    let models = root.path().join("models");
+    let seed = root.path().join("seed").join("effective");
+
+    assert_eq!(effective_dir_at(&models, &spec, &[], Some(&seed)), None);
+
+    // A seed directory that carries the trusted manifest and verifying files is accepted.
+    std::fs::create_dir_all(seed.join("sub")).unwrap();
+    std::fs::write(seed.join("weights.bin"), WEIGHTS).unwrap();
+    std::fs::write(seed.join("sub/vocab.txt"), VOCAB).unwrap();
+    assert_eq!(effective_dir_at(&models, &spec, &[], Some(&seed)), None, "no manifest yet");
+    rightkit_models::suite::manifest::write_manifest(&seed, &spec.expected_manifest()).unwrap();
+    let found = effective_dir_at(&models, &spec, &[], Some(&seed)).unwrap();
+    assert_eq!(found.source, EffectiveSource::Seed);
+    assert_eq!(found.dir, seed);
+
+    // Once the shared store holds a ready copy it wins over the seed.
+    let source = DownloadSource::new(format!("{}/m", server.base)).unwrap();
+    store::ensure_ready_from_source(
+        &http(),
+        &models,
+        &spec,
+        &opts("mail"),
+        &source,
+        &|| false,
+        |_| {},
+    )
+    .unwrap();
+    let found = effective_dir_at(&models, &spec, &[], Some(&seed)).unwrap();
+    assert_eq!(found.source, EffectiveSource::Shared);
+    assert_eq!(found.dir, models.join("effective"));
+    let json = serde_json::to_value(&found).unwrap();
+    assert_eq!(json["source"], "shared");
+}

+/// A [`Gpu`] plus what [`Gpu`] cannot carry without a breaking change: the raw VRAM in MiB and
+/// which probe reported the entry (Orthic-Labs/rightkit#709). Returned next to a [`Hardware`] by
+/// [`Hardware::probe_with_runner_detailed`] and [`Hardware::detect_detailed`], where `details[i]`
+/// describes `hw.gpus[i]`.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct GpuDetail {
+    /// The same entry as in `Hardware::gpus` (`vram_gb` is rounded to 0.1 GB).
+    pub gpu: Gpu,
+    /// Raw VRAM in MiB as the probe reported it, unrounded: 16376 MiB stays 16376. `None` when the
+    /// probe gave no figure.
+    pub vram_mib: Option<u64>,
+    /// Which probe supplied the entry's memory figure (or the entry itself when it has none): one
+    /// of the `GpuDetail::SOURCE_*` names. `None` for a synthesized entry.
+    pub source: Option<String>,
+}
+
+impl GpuDetail {
+    /// `source` of a card read from `nvidia-smi`.
+    pub const SOURCE_NVIDIA_SMI: &'static str = "nvidia-smi";
+    /// `source` of a card read from `wmic path win32_VideoController`.
+    pub const SOURCE_WMIC: &'static str = "wmic Win32_VideoController";
+    /// `source` of a card read from `system_profiler SPDisplaysDataType`.
+    pub const SOURCE_SYSTEM_PROFILER: &'static str = "system_profiler SPDisplaysDataType";
+    /// `source` of a card read from the Windows display-class registry keys.
+    pub const SOURCE_REGISTRY: &'static str = "registry display class";
+
+    pub(crate) fn new(gpu: Gpu, vram_mib: Option<u64>, source: Option<&str>) -> Self {
+        Self {
+            gpu,
+            vram_mib,
+            source: source.map(str::to_string),
+        }
+    }
+}
+
+/// MiB (rounded to the nearest) from a byte count.
+pub(crate) fn bytes_to_mib(bytes: u64) -> u64 {
+    (bytes + (1 << 19)) >> 20
+}
+
+fn plain(details: Vec<GpuDetail>) -> Vec<Gpu> {
+    details.into_iter().map(|detail| detail.gpu).collect()
+}

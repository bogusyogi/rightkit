+impl DownloadSource {
+    /// Check and keep `url`: `http://` or `https://` with a host, no whitespace or control
+    /// characters, no user information (`user:password@`), no query or fragment. A trailing `/`
+    /// is dropped. Address policy (loopback and private ranges) is the HTTP client's job.
+    pub fn new(url: impl AsRef<str>) -> Result<Self, String> {

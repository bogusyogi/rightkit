 /// Lowercase, strip IPv6 brackets and one trailing dot.
+fn normalize_path_prefix(prefix: &str) -> String {
+    let trimmed = prefix.trim_end_matches('/');
+    if trimmed.is_empty() {
+        String::new()
+    } else if trimmed.starts_with('/') {
+        trimmed.to_string()
+    } else {
+        format!("/{trimmed}")
+    }
+}
+
+/// True when `path` (query and fragment ignored) is inside one of `prefixes`, on whole
+/// segments, and holds no segment a server could resolve differently from this check.
+fn path_in_scope(path: &str, prefixes: &[String]) -> bool {
+    let path = path.split(['?', '#']).next().unwrap_or("");
+    let path = if path.is_empty() { "/" } else { path };
+    if path.contains('\\') {
+        return false;
+    }
+    for seg in path.split('/') {
+        let lower = seg.to_ascii_lowercase();
+        if lower.contains("%2f") || lower.contains("%5c") {
+            return false;
+        }
+        let decoded = lower.replace("%2e", ".");
+        if decoded == "." || decoded == ".." {
+            return false;
+        }
+    }
+    prefixes.iter().any(|p| {
+        p.is_empty()
+            || path == p.as_str()
+            || (path.starts_with(p.as_str()) && path[p.len()..].starts_with('/'))
+    })
+}
+

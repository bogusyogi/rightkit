+//! The per-attempt outcome observer, the delivery predicate on errors, and the first-party
+//! path-prefix scope, end to end against the mock server.
+
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use rightkit_http::testing::{loopback_config, loopback_policy, MockResponse, MockServer};
+use rightkit_http::*;
+
+fn config(max: u32) -> ClientConfig {
+    ClientConfig {
+        retry: RetryPolicy {
+            max_attempts: max,
+            initial_backoff: Duration::from_millis(5),
+            max_backoff: Duration::from_millis(10),
+            jitter: 0.0,
+            ..RetryPolicy::default()
+        },
+        ..loopback_config()
+    }
+}
+
+#[test]
+fn outcome_hook_reports_every_attempt_with_status_and_delay() {
+    let server = MockServer::start(|_, _| MockResponse::text(503, "busy"));
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let s = seen.clone();
+    let client = Client::new(config(3).on_outcome(move |o: &AttemptOutcome| {
+        s.lock()
+            .unwrap()
+            .push((o.attempt, o.max_attempts, o.status, o.delay.is_some()));
+    }));
+    let _ = client.send(&Request::get(server.url("/x")));
+    assert_eq!(
+        *seen.lock().unwrap(),
+        vec![
+            (1, 3, Some(503), true),
+            (2, 3, Some(503), true),
+            (3, 3, Some(503), false)
+        ]
+    );
+}
+
+#[test]
+fn outcome_hook_reports_a_success_as_the_final_attempt() {
+    let server = MockServer::start(|_, _| MockResponse::text(200, "ok"));
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let s = seen.clone();
+    let client = Client::new(config(3).on_outcome(move |o: &AttemptOutcome| {
+        s.lock().unwrap().push((o.attempt, o.status, o.delay));
+    }));
+    client.send(&Request::get(server.url("/x"))).unwrap();
+    assert_eq!(*seen.lock().unwrap(), vec![(1, Some(200), None)]);
+}
+
+#[test]
+fn outcome_hook_reports_an_error_class_and_the_error_may_have_been_delivered() {
+    // Nothing listens on port 1: a connect-phase failure, so nothing reached a server.
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let s = seen.clone();
+    let client = Client::new(config(1).on_outcome(move |o: &AttemptOutcome| {
+        s.lock().unwrap().push((o.status, o.error_class));
+    }));
+    let err = client
+        .send(&Request::post("http://127.0.0.1:1/x"))
+        .unwrap_err();
+    assert!(!err.request_may_have_been_delivered(), "{err:?}");
+    assert_eq!(
+        *seen.lock().unwrap(),
+        vec![(None, Some(ErrorClass::Transport))]
+    );
+}
+
+#[test]
+fn a_status_error_may_have_been_delivered() {
+    let server = MockServer::start(|_, _| MockResponse::text(500, "boom"));
+    let client = Client::new(config(1));
+    let resp = client.send(&Request::post(server.url("/x")));
+    if let Err(err) = resp {
+        assert!(err.request_may_have_been_delivered(), "{err:?}");
+    }
+}
+
+#[test]
+fn path_prefix_scope_refuses_paths_outside_it_before_sending() {
+    let server = MockServer::start(|_, _| MockResponse::text(200, "ok"));
+    let policy = loopback_policy().first_party_path_prefix("127.0.0.1", "/v1");
+    let client = Client::new(config(1).address_policy(policy));
+    client.send(&Request::get(server.url("/v1/models"))).unwrap();
+    let err = client.send(&Request::get(server.url("/admin"))).unwrap_err();
+    assert!(matches!(err, HttpError::AddressDenied { .. }), "{err:?}");
+    assert!(!err.request_may_have_been_delivered());
+    assert_eq!(server.request_count(), 1);
+}

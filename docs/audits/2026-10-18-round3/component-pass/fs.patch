+/// Whether `dir` carries the marker `options.file_name` (the migration into it already happened).
+/// A marker that is a symlink or a directory does not count.
+pub fn is_marked(dir: &Path, options: &MarkOptions) -> bool {
+    check_marker_name(&options.file_name).is_ok()
+        && fs::symlink_metadata(dir.join(&options.file_name))
+            .map(|m| m.is_file())
+            .unwrap_or(false)

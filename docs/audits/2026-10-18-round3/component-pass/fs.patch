+/// [`migrate_dir`] that leaves a marker file in the new folder. See the module docs ("Move and
+/// mark"). The marker holds `from` (as an absolute path), the time in Unix milliseconds and the note.
+/// `options.file_name` must be a plain file name ([`FsError::BadName`]). Writing the marker into the
+/// source is the first step: if that fails nothing has moved.
+pub fn migrate_dir_marked(
+    from: &Path,
+    to: &Path,
+    options: &MarkOptions,
+) -> Result<MarkedMigration> {
+    check_marker_name(&options.file_name)?;
+    let meta = fs::symlink_metadata(from).map_err(|e| FsError::io(from, e))?;
+    if meta.file_type().is_symlink() {
+        return Err(FsError::Symlink(from.to_path_buf()));
+    }
+    if !meta.is_dir() {
+        return Err(FsError::NotADirectory(from.to_path_buf()));
+    }
+    let abs_from = std::path::absolute(from).map_err(|e| FsError::io(from, e))?;
+    let marker_in_source = abs_from.join(&options.file_name);
+    // Remember a marker that is already there so a failed move can put it back.
+    let previous = match fs::symlink_metadata(&marker_in_source) {
+        Ok(meta) if meta.is_file() => Some(
+            fs::read(&marker_in_source).map_err(|e| FsError::io(&marker_in_source, e))?,
+        ),
+        Ok(_) => return Err(FsError::NotAFile(marker_in_source)),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => None,
+        Err(e) => return Err(FsError::io(&marker_in_source, e)),
+    };
+    let text = marker_text(&abs_from, options.note.as_deref());
+    crate::atomic::atomic_write(&marker_in_source, text.as_bytes())?;
+    match migrate_dir(from, to) {
+        Ok(migrated) => {
+            let abs_to = std::path::absolute(to).map_err(|e| FsError::io(to, e))?;
+            Ok(MarkedMigration {
+                migrated,
+                marker: abs_to.join(&options.file_name),
+            })
+        }
+        Err(e) => {
+            // Nothing moved (or the source is still whole): restore the source's own marker state.
+            match previous {
+                Some(bytes) => {
+                    let _ = crate::atomic::atomic_write(&marker_in_source, &bytes);
+                }
+                None => {
+                    let _ = fs::remove_file(&marker_in_source);
+                }
+            }
+            Err(e)
+        }
+    }
+}

+/// `$HOME` when set and non-empty, else the account database's home for the real uid.
+#[cfg(unix)]
+fn unix_home() -> Option<PathBuf> {
+    use std::os::unix::ffi::OsStringExt;
+    if let Some(h) = std::env::var_os("HOME").filter(|h| !h.is_empty()) {
+        return Some(PathBuf::from(h));
+    }
+    #[cfg(any(target_os = "android", target_os = "ios", target_os = "emscripten"))]
+    {
+        None
+    }
+    #[cfg(not(any(target_os = "android", target_os = "ios", target_os = "emscripten")))]
+    {
+        // SAFETY: `passwd` is plain data that getpwuid_r fills; the buffer outlives the call and
+        // `pw_dir` is read only when the call succeeded and `result` is non-null, then copied.
+        unsafe {
+            let size = match libc::sysconf(libc::_SC_GETPW_R_SIZE_MAX) {
+                n if n < 0 => 512usize,
+                n => n as usize,
+            };
+            let mut buf: Vec<u8> = vec![0; size];
+            let mut passwd: libc::passwd = std::mem::zeroed();
+            let mut result = std::ptr::null_mut();
+            let rc = libc::getpwuid_r(
+                libc::getuid(),
+                &mut passwd,
+                buf.as_mut_ptr().cast(),
+                buf.len(),
+                &mut result,
+            );
+            if rc != 0 || result.is_null() || passwd.pw_dir.is_null() {
+                return None;
+            }
+            let bytes = std::ffi::CStr::from_ptr(passwd.pw_dir).to_bytes();
+            if bytes.is_empty() {
+                None
+            } else {
+                Some(PathBuf::from(std::ffi::OsString::from_vec(bytes.to_vec())))
+            }
+        }
+    }
+}
+
+/// macOS: `<home>/<mac_name>`. Other unix: the XDG entry `xdg_name`. Not compiled on Windows.
+#[cfg(not(windows))]
+fn unix_user_dir(mac_name: &str, xdg_name: &str) -> Option<PathBuf> {
+    #[cfg(not(unix))]
+    {
+        let _ = (mac_name, xdg_name);
+        None
+    }
+    #[cfg(all(unix, target_os = "macos"))]
+    {
+        let _ = xdg_name;
+        unix_home().map(|h| h.join(mac_name))
+    }
+    #[cfg(all(unix, not(target_os = "macos")))]
+    {
+        let _ = mac_name;
+        let home = unix_home()?;
+        let config = std::env::var_os("XDG_CONFIG_HOME")
+            .map(PathBuf::from)
+            .filter(|p| p.is_absolute())
+            .unwrap_or_else(|| home.join(".config"));
+        let bytes = std::fs::read(config.join("user-dirs.dirs")).unwrap_or_default();
+        parse_xdg_user_dir(&home, &bytes, xdg_name)
+    }
+}
+
+/// The value of `XDG_<name>_DIR` in the bytes of a `user-dirs.dirs` file, resolved against
+/// `home`. Only `"$HOME/x"` and `"/x"` are understood; `"$HOME/"` (the XDG way to disable a
+/// folder), an empty value, a relative value or a missing key give `None`. The first line that
+/// names the key and has a usable value wins. Pure.
+#[cfg(unix)]
+#[cfg_attr(target_os = "macos", allow(dead_code))]
+pub(crate) fn parse_xdg_user_dir(home: &std::path::Path, file: &[u8], name: &str) -> Option<PathBuf> {
+    use std::os::unix::ffi::OsStringExt;
+    let wanted = format!("XDG_{name}_DIR");
+    for line in file.split(|b| *b == b'\n') {
+        let Some(eq) = line.iter().position(|b| *b == b'=') else {
+            continue;
+        };
+        if trim_blank(&line[..eq]) != wanted.as_bytes() {
+            continue;
+        }
+        let value = trim_blank(&line[eq + 1..]);
+        let Some(inner) = value
+            .strip_prefix(b"\"")
+            .and_then(|v| v.strip_suffix(b"\""))
+        else {
+            continue;
+        };
+        let (relative, rest) = if inner == b"$HOME/" {
+            continue;
+        } else if let Some(rest) = inner.strip_prefix(b"$HOME/") {
+            (true, rest)
+        } else if inner.starts_with(b"/") {
+            (false, inner)
+        } else {
+            continue;
+        };
+        let value = std::ffi::OsString::from_vec(shell_unescape(rest));
+        return Some(if relative {
+            home.join(value)
+        } else {
+            PathBuf::from(value)
+        });
+    }
+    None
+}
+
+#[cfg(unix)]
+fn trim_blank(bytes: &[u8]) -> &[u8] {
+    let blank = |b: &u8| *b == b' ' || *b == b'\t';
+    let start = bytes.iter().take_while(|b| blank(b)).count();
+    let bytes = &bytes[start..];
+    let end = bytes.iter().rev().take_while(|b| blank(b)).count();
+    &bytes[..bytes.len() - end]
+}
+
+/// POSIX double-quote unescape as `xdg-user-dirs-update` writes it: a backslash takes the next byte.
+#[cfg(unix)]
+fn shell_unescape(escaped: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(escaped.len());
+    let mut it = escaped.iter().copied();
+    while let Some(b) = it.next() {
+        if b == b'\\' {
+            if let Some(next) = it.next() {
+                out.push(next);
+            }
+        } else {
+            out.push(b);
+        }
+    }
+    out
+}

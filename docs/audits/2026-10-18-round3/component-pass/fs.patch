+//! Publish several finished files as one group: all of them become visible, or none of them does.
+//!
+//! [`publish_group`] is the multi-file counterpart of [`crate::publish_file`], for a set of files that
+//! only make sense together (a database and its index, a manifest and the data it lists, a settings
+//! file and its schema). Each entry is a finished staging file the caller wrote next to its
+//! destination; the destinations may be in different directories.
+//!
+//! # What it does
+//!
+//! 1. **Validate.** Every staging file is a real regular file (a symlink is refused), every
+//!    destination is absent or a real regular file (a symlink or directory is refused), no
+//!    destination appears twice, and no staging file is its own destination. Nothing is touched when
+//!    this fails.
+//! 2. **Back up.** Each existing destination is backed up as a sibling `.<name>.rkbak-<pid>-<n>`: a
+//!    hard link when the volume has them (the backup then keeps the old bytes when the destination is
+//!    replaced by rename), else a copy. A destination is never moved away, so readers keep seeing a
+//!    complete file at every name throughout. A backup failure removes the backups already made and
+//!    changes nothing else.
+//! 3. **Publish.** Each staging file replaces its destination with [`crate::publish_file_with`]
+//!    (atomic per file). The cancel gate ([`GroupOptions::cancel`]) is asked before every file.
+//! 4. **Roll back on failure or cancel.** Every destination already published is put back (the
+//!    backup renamed over it, or the new file removed when the destination did not exist), in reverse
+//!    order, and the backups are removed. Staging files that were not published are left in place;
+//!    ones that were published no longer exist as staging files (they became the destination, and the
+//!    rollback restored the old content).
+//! 5. **Commit.** After the last file is in place the backups are removed. A backup that cannot be
+//!    removed is reported in [`GroupPublished::leftover_backups`], not as an error.
+//!
+//! # Guarantees and limits
+//!
+//! * The group is **not** one atomic step for a concurrent reader: between the first and the last
+//!   publish a reader can see some new files and some old. It is all-or-nothing for the outcome: when
+//!   the call returns `Ok` every file is new; when it returns an error each destination holds the
+//!   content it had before (rollback failures excepted, below).
+//! * A crash in the middle leaves a mix of old and new files and the backups `.<name>.rkbak-<pid>-*`
+//!   next to the destinations that existed. Nothing here recovers from that on the next start; a
+//!   caller that needs it keeps its own commit marker.
+//! * If a rollback step itself fails, the remaining steps still run, the backups that could not be
+//!   restored are **kept**, and the error says which destinations are in doubt and where their backups
+//!   are.
+//! * A cancel is reported as an [`FsError::Io`] of kind [`io::ErrorKind::Interrupted`] after the
+//!   rollback ([`FsError::kind`]).
+//! * Each file's publish is durable by default ([`GroupOptions::durable`]); the backups are not
+//!   synced.
+//!
+//! Not compiled or run when written.
+
+use crate::atomic::{publish_file_with, AtomicWriteOptions, ReplaceMode, RetryPolicy};
+use crate::error::{FsError, Result};
+use std::io;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+
+static COUNTER: AtomicU64 = AtomicU64::new(0);
+
+/// One file of a group: the finished staging file and the path it becomes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GroupEntry {
+    /// The finished file, closed by its writer, on the same volume as `dest`.
+    pub staged: PathBuf,
+    /// Where it must appear.
+    pub dest: PathBuf,
+}
+
+impl GroupEntry {
+    /// An entry publishing `staged` at `dest`.
+    pub fn new(staged: impl Into<PathBuf>, dest: impl Into<PathBuf>) -> Self {
+        Self {
+            staged: staged.into(),
+            dest: dest.into(),
+        }
+    }
+}
+
+/// Options for [`publish_group`].
+#[derive(Clone, Copy)]
+#[non_exhaustive]
+pub struct GroupOptions<'a> {
+    /// Asked before the backups are made and before every file is published; `true` cancels (the
+    /// group is rolled back). Not asked after the last file is in place.
+    pub cancel: Option<&'a dyn Fn() -> bool>,
+    /// Sync each staging file and its directory when publishing it. Default `true`.
+    pub durable: bool,
+    /// Retry a publish or restore step on Windows sharing violations. Default 5 retries, 20 ms apart.
+    pub retry_sharing_violation: Option<RetryPolicy>,
+}
+
+impl Default for GroupOptions<'_> {
+    fn default() -> Self {
+        Self {
+            cancel: None,
+            durable: true,
+            retry_sharing_violation: Some(RetryPolicy::new(5, Duration::from_millis(20))),
+        }
+    }
+}
+
+impl std::fmt::Debug for GroupOptions<'_> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("GroupOptions")
+            .field("cancel", &self.cancel.map(|_| "<gate>"))
+            .field("durable", &self.durable)
+            .field("retry_sharing_violation", &self.retry_sharing_violation)
+            .finish()
+    }
+}
+
+impl<'a> GroupOptions<'a> {
+    /// The defaults.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Set the cancel gate.
+    pub fn cancel(mut self, gate: &'a dyn Fn() -> bool) -> Self {
+        self.cancel = Some(gate);
+        self
+    }
+
+    /// Set whether each file's publish is durable.
+    pub fn durable(mut self, durable: bool) -> Self {
+        self.durable = durable;
+        self
+    }
+}
+
+/// What [`publish_group`] did.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct GroupPublished {
+    /// Files published (the group's size).
+    pub published: usize,
+    /// Of those, how many replaced an existing file.
+    pub replaced: usize,
+    /// Destinations whose content is in place but whose directory sync failed (they may not survive a
+    /// power loss).
+    pub unsynced: Vec<PathBuf>,
+    /// Backups that could not be removed after the commit (harmless; a caller may delete them).
+    pub leftover_backups: Vec<PathBuf>,
+}
+
+struct Slot {
+    entry: GroupEntry,
+    backup: Option<PathBuf>,
+    published: bool,
+}
+
+/// Publish every entry, or none. See the module docs for the steps, the guarantees and the limits.
+pub fn publish_group(entries: &[GroupEntry], options: &GroupOptions<'_>) -> Result<GroupPublished> {
+    validate(entries)?;
+    let cancelled = || options.cancel.is_some_and(|gate| gate());
+    let cancel_error = |path: &Path| {
+        FsError::io(
+            path,
+            io::Error::new(
+                io::ErrorKind::Interrupted,
+                "the group publish was cancelled and rolled back",
+            ),
+        )
+    };
+    let mut slots: Vec<Slot> = entries
+        .iter()
+        .map(|entry| Slot {
+            entry: entry.clone(),
+            backup: None,
+            published: false,
+        })
+        .collect();
+
+    if cancelled() {
+        return Err(cancel_error(&entries[0].dest));
+    }
+
+    // Backups first, so a failure here has changed nothing but the backups themselves.
+    for index in 0..slots.len() {
+        match make_backup(&slots[index].entry.dest) {
+            Ok(backup) => slots[index].backup = backup,
+            Err(e) => {
+                remove_backups(&slots);
+                return Err(e);
+            }
+        }
+    }
+
+    let mut unsynced = Vec::new();
+    for index in 0..slots.len() {
+        if cancelled() {
+            let path = slots[index].entry.dest.clone();
+            return Err(fail(&mut slots, cancel_error(&path)));
+        }
+        let publish = AtomicWriteOptions {
+            replace: ReplaceMode::MoveWriteThrough,
+            durable: options.durable,
+            retry_sharing_violation: options.retry_sharing_violation,
+            ..AtomicWriteOptions::default()
+        };
+        let entry = slots[index].entry.clone();
+        match publish_file_with(&entry.staged, &entry.dest, publish) {
+            Ok(()) => slots[index].published = true,
+            Err(e) if e.target_replaced() => {
+                // The content is in place; only a sync or cleanup step failed.
+                slots[index].published = true;
+                unsynced.push(entry.dest.clone());
+            }
+            Err(e) => return Err(fail(&mut slots, e)),
+        }
+    }
+
+    let replaced = slots.iter().filter(|s| s.backup.is_some()).count();
+    let leftover_backups = remove_backups(&slots);
+    Ok(GroupPublished {
+        published: slots.len(),
+        replaced,
+        unsynced,
+        leftover_backups,
+    })
+}
+
+fn validate(entries: &[GroupEntry]) -> Result<()> {
+    if entries.is_empty() {
+        return Err(FsError::io(
+            Path::new("."),
+            io::Error::new(io::ErrorKind::InvalidInput, "an empty publish group"),
+        ));
+    }
+    for (index, entry) in entries.iter().enumerate() {
+        if entry.staged == entry.dest {
+            return Err(FsError::io(
+                &entry.dest,
+                io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "a staging file cannot be its own destination",
+                ),
+            ));
+        }
+        if entries[..index].iter().any(|other| other.dest == entry.dest) {
+            return Err(FsError::io(
+                &entry.dest,
+                io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "the same destination appears twice in the group",
+                ),
+            ));
+        }
+        match std::fs::symlink_metadata(&entry.staged) {
+            Ok(meta) if meta.file_type().is_symlink() => {
+                return Err(FsError::Symlink(entry.staged.clone()))
+            }
+            Ok(meta) if !meta.is_file() => return Err(FsError::NotAFile(entry.staged.clone())),
+            Ok(_) => {}
+            Err(e) => return Err(FsError::io(&entry.staged, e)),
+        }
+        match std::fs::symlink_metadata(&entry.dest) {
+            Ok(meta) if meta.file_type().is_symlink() => {
+                return Err(FsError::Symlink(entry.dest.clone()))
+            }
+            Ok(meta) if !meta.is_file() => return Err(FsError::NotAFile(entry.dest.clone())),
+            Ok(_) => {}
+            Err(e) if e.kind() == io::ErrorKind::NotFound => {}
+            Err(e) => return Err(FsError::io(&entry.dest, e)),
+        }
+    }
+    Ok(())
+}
+
+/// Back up `dest` beside itself, or `None` when it does not exist.
+fn make_backup(dest: &Path) -> Result<Option<PathBuf>> {
+    match std::fs::symlink_metadata(dest) {
+        Ok(_) => {}
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(e) => return Err(FsError::io(dest, e)),
+    }
+    let backup = backup_name(dest)?;
+    if std::fs::hard_link(dest, &backup).is_ok() {
+        return Ok(Some(backup));
+    }
+    match std::fs::copy(dest, &backup) {
+        Ok(_) => Ok(Some(backup)),
+        Err(e) => {
+            let _ = std::fs::remove_file(&backup);
+            Err(FsError::io(dest, e))
+        }
+    }
+}
+
+fn backup_name(dest: &Path) -> Result<PathBuf> {
+    let dir = match dest.parent() {
+        Some(p) if !p.as_os_str().is_empty() => p,
+        _ => Path::new("."),
+    };
+    let name = dest
+        .file_name()
+        .ok_or_else(|| FsError::BadName(dest.display().to_string()))?
+        .to_string_lossy()
+        .chars()
+        .take(100)
+        .collect::<String>();
+    Ok(dir.join(format!(
+        ".{name}.rkbak-{}-{}",
+        std::process::id(),
+        COUNTER.fetch_add(1, Ordering::Relaxed)
+    )))
+}
+
+/// Remove every backup; return those that could not be removed.
+fn remove_backups(slots: &[Slot]) -> Vec<PathBuf> {
+    let mut left = Vec::new();
+    for slot in slots {
+        if let Some(backup) = &slot.backup {
+            match std::fs::remove_file(backup) {
+                Ok(()) => {}
+                Err(e) if e.kind() == io::ErrorKind::NotFound => {}
+                Err(_) => left.push(backup.clone()),
+            }
+        }
+    }
+    left
+}
+
+/// Roll back what was published, then return `cause` (or the rollback failure, which names the
+/// destinations in doubt).
+fn fail(slots: &mut [Slot], cause: FsError) -> FsError {
+    let retry = Some(RetryPolicy::new(5, Duration::from_millis(20)));
+    let mut in_doubt: Vec<String> = Vec::new();
+    for slot in slots.iter_mut().rev() {
+        if !slot.published {
+            continue;
+        }
+        let dest = &slot.entry.dest;
+        let restored = match &slot.backup {
+            Some(backup) => publish_file_with(
+                backup,
+                dest,
+                AtomicWriteOptions {
+                    replace: ReplaceMode::Rename,
+                    durable: false,
+                    retry_sharing_violation: retry,
+                    ..AtomicWriteOptions::default()
+                },
+            )
+            .map(|()| true)
+            .or_else(|e| if e.target_replaced() { Ok(true) } else { Err(e) }),
+            None => match std::fs::remove_file(dest) {
+                Ok(()) => Ok(true),
+                Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(true),
+                Err(e) => Err(FsError::io(dest, e)),
+            },
+        };
+        match restored {
+            Ok(_) => {
+                // The backup was renamed onto the destination; it no longer exists as a backup.
+                slot.backup = None;
+                slot.published = false;
+            }
+            Err(e) => in_doubt.push(match &slot.backup {
+                Some(backup) => format!(
+                    "{} (old content kept at {}): {e}",
+                    dest.display(),
+                    backup.display()
+                ),
+                None => format!("{} (new file could not be removed): {e}", dest.display()),
+            }),
+        }
+    }
+    // Backups of entries whose rollback succeeded are gone or removable; keep the ones in doubt.
+    let keep: Vec<bool> = slots.iter().map(|s| s.published).collect();
+    for (slot, in_doubt_slot) in slots.iter().zip(keep) {
+        if in_doubt_slot {
+            continue;
+        }
+        if let Some(backup) = &slot.backup {
+            let _ = std::fs::remove_file(backup);
+        }
+    }
+    if in_doubt.is_empty() {
+        cause
+    } else {
+        let first = slots
+            .first()
+            .map(|s| s.entry.dest.clone())
+            .unwrap_or_default();
+        FsError::io(
+            first,
+            io::Error::other(format!(
+                "the group publish failed ({cause}) and the rollback did not finish; in doubt: {}",
+                in_doubt.join("; ")
+            )),
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use std::sync::atomic::AtomicUsize;
+
+    fn staged(dir: &Path, name: &str, text: &str) -> PathBuf {
+        let path = dir.join(format!("{name}.new"));
+        fs::write(&path, text).unwrap();
+        path
+    }
+
+    fn names(dir: &Path) -> Vec<String> {
+        let mut v: Vec<String> = fs::read_dir(dir)
+            .unwrap()
+            .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+            .collect();
+        v.sort();
+        v
+    }
+
+    #[test]
+    fn every_file_is_published_and_backups_are_removed() {
+        let dir = tempfile::tempdir().unwrap();
+        let (a, b) = (dir.path().join("a.db"), dir.path().join("b.idx"));
+        fs::write(&a, "old a").unwrap();
+        let entries = [
+            GroupEntry::new(staged(dir.path(), "a", "new a"), &a),
+            GroupEntry::new(staged(dir.path(), "b", "new b"), &b),
+        ];
+        let done = publish_group(&entries, &GroupOptions::new().durable(false)).unwrap();
+        assert_eq!((done.published, done.replaced), (2, 1));
+        assert!(done.leftover_backups.is_empty());
+        assert_eq!(fs::read_to_string(&a).unwrap(), "new a");
+        assert_eq!(fs::read_to_string(&b).unwrap(), "new b");
+        assert_eq!(names(dir.path()), ["a.db", "b.idx"]);
+    }
+
+    #[test]
+    fn a_cancel_before_the_second_file_rolls_the_first_back() {
+        let dir = tempfile::tempdir().unwrap();
+        let (a, b) = (dir.path().join("a.db"), dir.path().join("b.idx"));
+        fs::write(&a, "old a").unwrap();
+        fs::write(&b, "old b").unwrap();
+        let entries = [
+            GroupEntry::new(staged(dir.path(), "a", "new a"), &a),
+            GroupEntry::new(staged(dir.path(), "b", "new b"), &b),
+        ];
+        // Asked once before the backups and once before each file: cancel on the third question.
+        let asked = AtomicUsize::new(0);
+        let gate = || asked.fetch_add(1, Ordering::SeqCst) == 2;
+        let err = publish_group(&entries, &GroupOptions::new().durable(false).cancel(&gate))
+            .unwrap_err();
+        assert_eq!(err.kind(), Some(io::ErrorKind::Interrupted), "{err:?}");
+        assert_eq!(fs::read_to_string(&a).unwrap(), "old a");
+        assert_eq!(fs::read_to_string(&b).unwrap(), "old b");
+        // Only the staging file of the unpublished entry is left, and no backups.
+        assert_eq!(names(dir.path()), ["a.db", "b.idx", "b.new"]);
+    }
+
+    #[test]
+    fn a_failing_publish_restores_old_content_and_removes_new_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let (a, b) = (dir.path().join("a.db"), dir.path().join("b.idx"));
+        fs::write(&a, "old a").unwrap();
+        // The second staging file vanishes after validation would have passed: simulate with a
+        // staging file that is replaced by a directory only after the first file is published, by
+        // making the destination of the second entry a path whose parent does not exist.
+        let missing_parent = dir.path().join("no-such-dir").join("c.bin");
+        let entries = [
+            GroupEntry::new(staged(dir.path(), "a", "new a"), &a),
+            GroupEntry::new(staged(dir.path(), "b", "new b"), &b),
+            GroupEntry::new(staged(dir.path(), "c", "new c"), &missing_parent),
+        ];
+        let err = publish_group(&entries, &GroupOptions::new().durable(false)).unwrap_err();
+        assert!(err.is_not_found() || err.kind().is_some(), "{err:?}");
+        assert_eq!(fs::read_to_string(&a).unwrap(), "old a");
+        assert!(!b.exists(), "a new file the group created is removed");
+        assert!(names(dir.path()).iter().all(|n| !n.contains(".rkbak-")));
+    }
+
+    #[test]
+    fn invalid_groups_change_nothing() {
+        let dir = tempfile::tempdir().unwrap();
+        let a = dir.path().join("a.db");
+        let s = staged(dir.path(), "a", "x");
+        assert!(publish_group(&[], &GroupOptions::new()).is_err());
+        let twice = [GroupEntry::new(&s, &a), GroupEntry::new(&s, &a)];
+        assert!(publish_group(&twice, &GroupOptions::new()).is_err());
+        let own = [GroupEntry::new(&s, &s)];
+        assert!(publish_group(&own, &GroupOptions::new()).is_err());
+        let absent = [GroupEntry::new(dir.path().join("none"), &a)];
+        assert!(publish_group(&absent, &GroupOptions::new()).is_err());
+        let dest_dir = dir.path().join("d");
+        fs::create_dir(&dest_dir).unwrap();
+        let onto_dir = [GroupEntry::new(&s, &dest_dir)];
+        assert!(matches!(
+            publish_group(&onto_dir, &GroupOptions::new()).unwrap_err(),
+            FsError::NotAFile(_)
+        ));
+        assert!(!a.exists());
+        assert!(s.exists());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_symlink_destination_is_refused() {
+        let dir = tempfile::tempdir().unwrap();
+        let target = dir.path().join("t");
+        fs::write(&target, "keep").unwrap();
+        let link = dir.path().join("l");
+        std::os::unix::fs::symlink(&target, &link).unwrap();
+        let entries = [GroupEntry::new(staged(dir.path(), "l", "new"), &link)];
+        assert!(matches!(
+            publish_group(&entries, &GroupOptions::new()).unwrap_err(),
+            FsError::Symlink(_)
+        ));
+        assert_eq!(fs::read_to_string(&target).unwrap(), "keep");
+    }
+}

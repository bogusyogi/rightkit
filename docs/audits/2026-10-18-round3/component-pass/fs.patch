+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use std::path::Path;
+
+    const HOME: &str = "/home/bob";
+
+    fn p(file: &str, name: &str) -> Option<PathBuf> {
+        parse_xdg_user_dir(Path::new(HOME), file.as_bytes(), name)
+    }
+
+    #[test]
+    fn empty_file_has_nothing() {
+        assert_eq!(p("", "DESKTOP"), None);
+    }
+
+    #[test]
+    fn home_relative_and_absolute() {
+        let f = "XDG_DESKTOP_DIR=\"$HOME/Desktop\"\nXDG_DOCUMENTS_DIR=\"/data/docs\"\n";
+        assert_eq!(p(f, "DESKTOP"), Some(PathBuf::from("/home/bob/Desktop")));
+        assert_eq!(p(f, "DOCUMENTS"), Some(PathBuf::from("/data/docs")));
+        assert_eq!(p(f, "DOWNLOAD"), None);
+    }
+
+    #[test]
+    fn disabled_empty_relative_and_unquoted_are_none() {
+        assert_eq!(p("XDG_DESKTOP_DIR=\"$HOME/\"", "DESKTOP"), None);
+        assert_eq!(p("XDG_DESKTOP_DIR=\"\"", "DESKTOP"), None);
+        assert_eq!(p("XDG_DESKTOP_DIR=\"desk\"", "DESKTOP"), None);
+        assert_eq!(p("XDG_DESKTOP_DIR=$HOME/Desktop", "DESKTOP"), None);
+        assert_eq!(p("XDG_DESKTOP_DIR=\"$HOxyzME/Desktop\"", "DESKTOP"), None);
+    }
+
+    #[test]
+    fn comments_blanks_and_escapes() {
+        let f = "# XDG_DESKTOP_DIR=\"$HOME/Old\"\n  \tXDG_DESKTOP_DIR = \"$HOME/My\\ \\$Desk\"  \n";
+        // The key is trimmed of blanks around it; the `=` split keeps the value side trimmed.
+        assert_eq!(p(f, "DESKTOP"), Some(PathBuf::from("/home/bob/My $Desk")));
+    }
+
+    #[test]
+    fn first_usable_line_wins_and_crlf_is_not_a_value() {
+        let f = "XDG_DOWNLOAD_DIR=\"$HOME/\"\nXDG_DOWNLOAD_DIR=\"$HOME/Dl\"\n";
+        assert_eq!(p(f, "DOWNLOAD"), Some(PathBuf::from("/home/bob/Dl")));
+        // A CRLF file leaves a trailing CR, which breaks the closing quote: dirs-sys also skips it.
+        assert_eq!(p("XDG_DESKTOP_DIR=\"$HOME/D\"\r\n", "DESKTOP"), None);
+    }
+
+    #[test]
+    fn real_functions_agree_with_each_other_on_unix() {
+        if let Some(h) = home() {
+            assert!(h.is_absolute() || std::env::var_os("HOME").is_some());
+            #[cfg(target_os = "macos")]
+            {
+                assert_eq!(desktop(), Some(h.join("Desktop")));
+                assert_eq!(documents(), Some(h.join("Documents")));
+                assert_eq!(downloads(), Some(h.join("Downloads")));
+            }
+        }
+    }
+}

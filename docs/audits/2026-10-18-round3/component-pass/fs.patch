+//! The test-mode gate for a Tauri (or any desktop) app: one decision, made once at process start,
+//! that says whether this process was launched under test, plus the build-script helper that turns
+//! the app's Cargo features into `cfg`s.
+//!
+//! Std only; no Cargo feature is needed to use the pure parts, so an app can name this crate in
+//! `[build-dependencies]` with `default-features = false`.
+//!
+//! # Runtime
+//!
+//! The app passes the NAMES of two environment variables ([`Variables`]): the service variable
+//! (set by the test launcher) and the isolated data-directory variable.
+//!
+//! * [`TestMode::Off`]: the service variable is unset or blank. The directory variable alone does
+//!   nothing.
+//! * [`TestMode::On`]: the service variable is set and the directory variable is an absolute path
+//!   without `..` that is created (or exists) and passes the [`Guard`].
+//! * [`TestMode::Refuse`]: the service variable is set but the directory is unset, empty,
+//!   relative, contains `..`, is the user's home folder or an ancestor of it, is at or inside a
+//!   user folder (Documents, Desktop, Downloads, Pictures, Music, Movies, Videos, Public), is at,
+//!   inside or above one of the app's real folders ([`Guard::real_dir`]), resolves (through a
+//!   symlink) into any of those, or cannot become a directory. The process exits before it
+//!   creates anything else; it never falls back to the real folders.
+//!
+//! With the crate feature `test-mode`, [`init_or_exit`] reads the real environment once and exits
+//! with status 2 and one stderr line on `Refuse`; [`current`] returns the decision and panics if
+//! it was never made. Without the feature, [`current`] is a constant `Off`, the reading code is
+//! not compiled, and the release binary carries none of this crate's reading code or the
+//! [`COMPILED_MARKER`].
+//!
+//! # Build script
+//!
+//! [`build::emit`] reads the `CARGO_FEATURE_*` variables of the app's own build script, emits
+//! `cargo:rustc-cfg=test_mode_enabled` (name configurable) and the matching `check-cfg`, applies
+//! the [`build::ReleaseGuard`], and returns [`build::Resolved`] so the app derives its own
+//! combined cfgs. [`forbid_in_release!`] is the `compile_error!` guard for features that must
+//! never be in a release profile.
+//!
+//! The visible marker is [`VISIBLE_MARKER`] (window title suffix via [`TestMode::title_suffix`])
+//! and the startup line is [`TestMode::status_line`].
+
+use std::ffi::OsStr;
+use std::path::{Component, Path, PathBuf};
+
+/// Embedded (feature `test-mode` only) so a release scanner can refuse a binary that contains it.
+pub const COMPILED_MARKER: &str = "RIGHTKIT-TEST-MODE-COMPILED";
+
+/// Text an app shows in its window title or chrome while test mode is on.
+pub const VISIBLE_MARKER: &str = "[TEST MODE]";
+
+#[cfg(feature = "test-mode")]
+#[used]
+static COMPILED_MARKER_BYTES: [u8; COMPILED_MARKER.len()] = {
+    let mut out = [0u8; COMPILED_MARKER.len()];
+    let src = COMPILED_MARKER.as_bytes();
+    let mut i = 0;
+    while i < src.len() {
+        out[i] = src[i];
+        i += 1;
+    }
+    out
+};
+
+/// What the process was launched as.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum TestMode {
+    Off,
+    On { data_dir: PathBuf },
+    Refuse { reason: String },
+}
+
+/// The names of the two environment variables, supplied by the app.
+#[derive(Debug, Clone, Copy)]
+pub struct Variables<'a> {
+    pub service: &'a str,
+    pub data_dir: &'a str,
+}
+
+impl TestMode {
+    pub fn is_on(&self) -> bool {
+        matches!(self, TestMode::On { .. })
+    }
+
+    /// The isolated data directory when test mode is on.
+    pub fn data_dir(&self) -> Option<&Path> {
+        match self {
+            TestMode::On { data_dir } => Some(data_dir),
+            _ => None,
+        }
+    }
+
+    /// The one startup line: `test mode: on, data dir <path>`, `test mode: off`, or the refusal.
+    pub fn status_line(&self) -> String {
+        match self {
+            TestMode::Off => "test mode: off".to_string(),
+            TestMode::On { data_dir } => format!("test mode: on, data dir {}", data_dir.display()),
+            TestMode::Refuse { reason } => format!("test mode: refused, {reason}"),
+        }
+    }
+
+    /// `" [TEST MODE]"` while on, empty otherwise: append it to a window title.
+    pub fn title_suffix(&self) -> &'static str {
+        if self.is_on() {
+            " [TEST MODE]"
+        } else {
+            ""
+        }
+    }
+}
+
+const USER_FOLDERS: [&str; 8] = [
+    "Documents",
+    "Desktop",
+    "Downloads",
+    "Pictures",
+    "Music",
+    "Movies",
+    "Videos",
+    "Public",
+];
+
+/// The folders an isolated data directory must stay away from.
+#[derive(Debug, Clone, Default)]
+pub struct Guard {
+    home: Option<PathBuf>,
+    real_dirs: Vec<PathBuf>,
+}
+
+impl Guard {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// The home folder from `HOME` (or `USERPROFILE`), when set and absolute.
+    pub fn from_environment() -> Self {
+        let home = std::env::var_os("HOME")
+            .filter(|v| !v.is_empty())
+            .or_else(|| std::env::var_os("USERPROFILE").filter(|v| !v.is_empty()))
+            .map(PathBuf::from)
+            .filter(|p| p.is_absolute());
+        Self {
+            home,
+            real_dirs: Vec::new(),
+        }
+    }
+
+    pub fn home(mut self, home: impl Into<PathBuf>) -> Self {
+        self.home = Some(home.into());
+        self
+    }
+
+    /// One of the app's real data, local, cache or config folders. The isolated directory may not
+    /// be at, inside or above it.
+    pub fn real_dir(mut self, dir: impl Into<PathBuf>) -> Self {
+        self.real_dirs.push(dir.into());
+        self
+    }
+
+    /// Why `path` is not an acceptable isolated directory, or `None`.
+    pub fn violation(&self, path: &Path) -> Option<String> {
+        let ci = cfg!(any(windows, target_os = "macos"));
+        if let Some(home) = &self.home {
+            if inside_or_equal(home, path, ci) {
+                return Some("is the home folder or contains it".to_string());
+            }
+            for name in USER_FOLDERS {
+                if inside_or_equal(path, &home.join(name), ci) {
+                    return Some(format!("is inside the user folder {name}"));
+                }
+            }
+        }
+        for real in &self.real_dirs {
+            if inside_or_equal(path, real, ci) || inside_or_equal(real, path, ci) {
+                return Some(format!("overlaps the real app folder {}", real.display()));
+            }
+        }
+        None
+    }
+}
+
+fn parts(path: &Path, ci: bool) -> Vec<String> {
+    path.to_string_lossy()
+        .split(|c: char| c == '/' || (cfg!(windows) && c == '\\'))
+        .filter(|c| !c.is_empty())
+        .map(|c| if ci { c.to_lowercase() } else { c.to_string() })
+        .collect()
+}
+
+/// Whether `path` is `base` or below it, component-wise.
+fn inside_or_equal(path: &Path, base: &Path, ci: bool) -> bool {
+    let (p, b) = (parts(path, ci), parts(base, ci));
+    p.len() >= b.len() && p[..b.len()] == b[..]
+}
+
+/// The pure decision. `ensure_dir` makes the directory exist and returns its resolved path (symlinks
+/// followed), or says why it cannot, so the decision stays testable without a disk.
+pub fn decide(
+    vars: &Variables<'_>,
+    service: Option<&str>,
+    data_dir: Option<&OsStr>,
+    guard: &Guard,
+    ensure_dir: &dyn Fn(&Path) -> Result<PathBuf, String>,
+) -> TestMode {
+    if service.is_none_or(|value| value.trim().is_empty()) {
+        return TestMode::Off;
+    }
+    let refuse = |why: &str| TestMode::Refuse {
+        reason: format!("{} is set but {} {why}", vars.service, vars.data_dir),
+    };
+    let Some(raw) = data_dir else {
+        return refuse("is not set");
+    };
+    if raw.is_empty() {
+        return refuse("is empty");
+    }
+    let path = PathBuf::from(raw);
+    if !path.is_absolute() {
+        return refuse("is not an absolute path");
+    }
+    if path.components().any(|c| c == Component::ParentDir) {
+        return refuse("contains `..`");
+    }
+    if let Some(why) = guard.violation(&path) {
+        return refuse(&why);
+    }
+    let resolved = match ensure_dir(&path) {
+        Ok(resolved) => resolved,
+        Err(error) => return refuse(&format!("cannot be used as a directory ({error})")),
+    };
+    if let Some(why) = guard.violation(&resolved) {
+        return refuse(&format!("resolves to {}, which {why}", resolved.display()));
+    }
+    TestMode::On { data_dir: resolved }
+}
+
+#[cfg(feature = "test-mode")]
+static MODE: std::sync::OnceLock<TestMode> = std::sync::OnceLock::new();
+
+#[cfg(feature = "test-mode")]
+fn ensure_dir_on_disk(path: &Path) -> Result<PathBuf, String> {
+    std::fs::create_dir_all(path).map_err(|error| error.to_string())?;
+    if !path.is_dir() {
+        return Err("not a directory".to_string());
+    }
+    crate::plain::canonicalize_plain(path).map_err(|error| error.to_string())
+}
+
+/// Decide once from the real environment (feature `test-mode`). On `Refuse` print one line to
+/// stderr and exit with status 2. Call it first in the process, before any window, file, log,
+/// plugin or credential access. `guard` should carry the app's real folders
+/// ([`Guard::from_environment`] plus [`Guard::real_dir`]).
+#[cfg(feature = "test-mode")]
+pub fn init_or_exit(product: &str, vars: &Variables<'_>, guard: &Guard) -> &'static TestMode {
+    let mode = MODE.get_or_init(|| {
+        decide(
+            vars,
+            std::env::var(vars.service).ok().as_deref(),
+            std::env::var_os(vars.data_dir).as_deref(),
+            guard,
+            &ensure_dir_on_disk,
+        )
+    });
+    if let TestMode::Refuse { .. } = mode {
+        eprintln!("{product}: {}", mode.status_line());
+        std::process::exit(2);
+    }
+    mode
+}
+
+/// The decision made at start. Panics if [`init_or_exit`] has not run: an unmade decision must
+/// never quietly mean "use the real folders".
+#[cfg(feature = "test-mode")]
+pub fn current() -> &'static TestMode {
+    MODE.get()
+        .expect("test_mode::init_or_exit must run before the first use")
+}
+
+/// Without feature `test-mode` the decision is always `Off` and nothing reads the environment.
+#[cfg(not(feature = "test-mode"))]
+pub fn current() -> &'static TestMode {
+    static OFF: TestMode = TestMode::Off;
+    &OFF
+}
+
+/// Choose between a real and a test implementation of anything, keyed on [`current`].
+pub fn select<T>(real: impl FnOnce() -> T, test: impl FnOnce() -> T) -> T {
+    if current().is_on() {
+        test()
+    } else {
+        real()
+    }
+}
+
+/// Fail the compile when a feature of the expanding crate is on in a build without
+/// `debug_assertions`: `rightkit_fs::forbid_in_release!("qa-native");`.
+#[macro_export]
+macro_rules! forbid_in_release {
+    ($feature:literal) => {
+        #[cfg(all(not(debug_assertions), feature = $feature))]
+        compile_error!(concat!(
+            "feature `",
+            $feature,
+            "` must never be enabled in release builds"
+        ));
+    };
+}
+
+/// The helper an app's `build.rs` calls. Std only.
+pub mod build {
+    use std::ffi::OsString;
+
+    /// When enabling the test feature is a build failure.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub enum ReleaseGuard<'a> {
+        /// Never (a dev build may use any profile; check the built artifact for [`super::COMPILED_MARKER`]).
+        None,
+        /// The test feature, or a legacy feature, on while `debug_assertions` is off.
+        WithoutDebugAssertions,
+        /// The test feature on while this environment variable is set and non-empty (for example
+        /// one the release tool exports).
+        WhenEnvSet(&'a str),
+    }
+
+    #[derive(Debug, Clone, Copy)]
+    pub struct Spec<'a> {
+        /// The app's Cargo feature that turns test mode on, e.g. `dev-control`.
+        pub feature: &'a str,
+        /// Older compile-time automation features that switch test mode off (and that the
+        /// guard also refuses in release).
+        pub legacy_features: &'a [&'a str],
+        /// The cfg name to emit (default `test_mode_enabled`).
+        pub cfg: &'a str,
+        pub guard: ReleaseGuard<'a>,
+    }
+
+    impl<'a> Spec<'a> {
+        pub fn new(feature: &'a str) -> Self {
+            Self {
+                feature,
+                legacy_features: &[],
+                cfg: "test_mode_enabled",
+                guard: ReleaseGuard::WithoutDebugAssertions,
+            }
+        }
+    }
+
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub struct Resolved {
+        /// The cfg is emitted.
+        pub test_mode: bool,
+        /// A legacy automation feature is on.
+        pub legacy_automation: bool,
+        pub debug_assertions: bool,
+    }
+
+    /// `dev-control` becomes `CARGO_FEATURE_DEV_CONTROL`.
+    pub fn feature_var(feature: &str) -> String {
+        format!("CARGO_FEATURE_{}", feature.to_uppercase().replace('-', "_"))
+    }
+
+    /// Pure resolution over an injected environment. `Err` is the release-guard message.
+    pub fn resolve(
+        spec: &Spec<'_>,
+        env: &dyn Fn(&str) -> Option<OsString>,
+    ) -> Result<Resolved, String> {
+        let on = |name: &str| env(&feature_var(name)).is_some();
+        let debug_assertions = env("CARGO_CFG_DEBUG_ASSERTIONS").is_some();
+        let requested = on(spec.feature);
+        let legacy = spec.legacy_features.iter().any(|f| on(f));
+        let refuse = match spec.guard {
+            ReleaseGuard::None => false,
+            ReleaseGuard::WithoutDebugAssertions => !debug_assertions && (requested || legacy),
+            ReleaseGuard::WhenEnvSet(name) => {
+                env(name).is_some_and(|v| !v.is_empty()) && (requested || legacy)
+            }
+        };
+        if refuse {
+            return Err(format!(
+                "test features (`{}` and legacy {:?}) must never be enabled in a release build",
+                spec.feature, spec.legacy_features
+            ));
+        }
+        Ok(Resolved {
+            test_mode: requested && !legacy,
+            legacy_automation: legacy,
+            debug_assertions,
+        })
+    }
+
+    /// Emit `check-cfg` and the test-mode cfg, and fail the build (panic) on a guard violation.
+    /// Call it from `build.rs` before `tauri_build::build()`; add `check-cfg` for any cfg of the
+    /// app's own that derives from [`Resolved`].
+    pub fn emit(spec: &Spec<'_>) -> Resolved {
+        println!("cargo:rustc-check-cfg=cfg({})", spec.cfg);
+        println!("cargo:rerun-if-env-changed=CARGO_CFG_DEBUG_ASSERTIONS");
+        let resolved =
+            resolve(spec, &|name| std::env::var_os(name)).unwrap_or_else(|why| panic!("{why}"));
+        if resolved.test_mode {
+            println!("cargo:rustc-cfg={}", spec.cfg);
+        }
+        resolved
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::ffi::OsString;
+
+    fn vars() -> Variables<'static> {
+        Variables {
+            service: "SVC_VAR",
+            data_dir: "DIR_VAR",
+        }
+    }
+
+    fn root() -> PathBuf {
+        std::env::temp_dir().join("tm-root")
+    }
+
+    fn ok(p: &Path) -> Result<PathBuf, String> {
+        Ok(p.to_path_buf())
+    }
+
+    #[test]
+    fn decide_table() {
+        let home = root().join("home");
+        let guard = Guard::new()
+            .home(&home)
+            .real_dir(home.join("AppData").join("App"));
+        let good = root().join("iso");
+        let blocked = root().join("blocked");
+        let ensure = |p: &Path| {
+            if p == blocked {
+                Err("denied".to_string())
+            } else {
+                Ok(p.to_path_buf())
+            }
+        };
+        let some = |p: &Path| Some(p.as_os_str().to_owned());
+        let cases: Vec<(&str, Option<&str>, Option<OsString>, &str)> = vec![
+            ("service unset", None, some(&good), "off"),
+            ("service unset, no dir", None, None, "off"),
+            ("service empty", Some(""), some(&good), "off"),
+            ("service blank", Some("  "), some(&good), "off"),
+            ("service and dir", Some("svc"), some(&good), "on"),
+            ("dir unset", Some("svc"), None, "refuse"),
+            ("dir empty", Some("svc"), Some(OsString::new()), "refuse"),
+            (
+                "dir relative",
+                Some("svc"),
+                Some("relative/dir".into()),
+                "refuse",
+            ),
+            ("dir cannot be made", Some("svc"), some(&blocked), "refuse"),
+            (
+                "dir has ..",
+                Some("svc"),
+                some(&good.join("..").join("x")),
+                "refuse",
+            ),
+            ("dir is home", Some("svc"), some(&home), "refuse"),
+            ("dir above home", Some("svc"), some(&root()), "refuse"),
+            (
+                "dir in Documents",
+                Some("svc"),
+                some(&home.join("Documents").join("t")),
+                "refuse",
+            ),
+            (
+                "dir in Downloads",
+                Some("svc"),
+                some(&home.join("Downloads")),
+                "refuse",
+            ),
+            (
+                "dir in home, not a user folder",
+                Some("svc"),
+                some(&home.join("scratch")),
+                "on",
+            ),
+            (
+                "dir is the real app dir",
+                Some("svc"),
+                some(&home.join("AppData").join("App")),
+                "refuse",
+            ),
+            (
+                "dir in the real app dir",
+                Some("svc"),
+                some(&home.join("AppData").join("App").join("x")),
+                "refuse",
+            ),
+            (
+                "dir above the real app dir",
+                Some("svc"),
+                some(&home.join("AppData")),
+                "refuse",
+            ),
+        ];
+        for (label, service, dir, expected) in cases {
+            let mode = decide(&vars(), service, dir.as_deref(), &guard, &ensure);
+            let got = match &mode {
+                TestMode::Off => "off",
+                TestMode::On { .. } => "on",
+                TestMode::Refuse { .. } => "refuse",
+            };
+            assert_eq!(got, expected, "{label}: {mode:?}");
+            if let TestMode::Refuse { reason } = &mode {
+                assert!(
+                    reason.contains("SVC_VAR") && reason.contains("DIR_VAR"),
+                    "{label}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn a_symlink_into_a_real_folder_is_refused_after_resolution() {
+        let home = root().join("home");
+        let guard = Guard::new().home(&home);
+        let link = root().join("link");
+        let target = home.join("Documents").join("real");
+        let ensure = |_: &Path| Ok(target.clone());
+        let mode = decide(
+            &vars(),
+            Some("svc"),
+            Some(link.as_os_str()),
+            &guard,
+            &ensure,
+        );
+        match mode {
+            TestMode::Refuse { reason } => assert!(reason.contains("resolves to"), "{reason}"),
+            other => panic!("{other:?}"),
+        }
+    }
+
+    #[test]
+    fn on_reports_the_resolved_directory_and_marker_lines() {
+        let dir = root().join("iso");
+        let mode = decide(
+            &vars(),
+            Some("svc"),
+            Some(dir.as_os_str()),
+            &Guard::new(),
+            &ok,
+        );
+        assert_eq!(mode.data_dir(), Some(dir.as_path()));
+        assert_eq!(
+            mode.status_line(),
+            format!("test mode: on, data dir {}", dir.display())
+        );
+        assert_eq!(mode.title_suffix(), " [TEST MODE]");
+        assert!(mode.title_suffix().contains(&VISIBLE_MARKER[..]));
+        let off = TestMode::Off;
+        assert_eq!(off.status_line(), "test mode: off");
+        assert_eq!(off.title_suffix(), "");
+    }
+
+    #[cfg(not(feature = "test-mode"))]
+    #[test]
+    fn without_the_feature_current_is_off_and_select_takes_the_real_side() {
+        assert_eq!(current(), &TestMode::Off);
+        assert_eq!(select(|| "real", || "test"), "real");
+    }
+
+    #[cfg(feature = "test-mode")]
+    #[test]
+    fn the_compiled_marker_is_embedded_with_the_feature() {
+        assert_eq!(&COMPILED_MARKER_BYTES[..], COMPILED_MARKER.as_bytes());
+    }
+
+    fn env_of(pairs: &[(&str, &str)]) -> impl Fn(&str) -> Option<OsString> {
+        let pairs: Vec<(String, String)> = pairs
+            .iter()
+            .map(|(k, v)| (k.to_string(), v.to_string()))
+            .collect();
+        move |k: &str| {
+            pairs
+                .iter()
+                .find(|(n, _)| n == k)
+                .map(|(_, v)| OsString::from(v))
+        }
+    }
+
+    #[test]
+    fn build_resolution_table() {
+        use build::*;
+        let legacy = ["qa-native", "dev-native"];
+        let spec = |guard| Spec {
+            feature: "dev-control",
+            legacy_features: &legacy,
+            cfg: "test_mode_enabled",
+            guard,
+        };
+        assert_eq!(feature_var("dev-control"), "CARGO_FEATURE_DEV_CONTROL");
+        // (env, guard, expected test_mode / legacy, or None for a guard failure)
+        let dbg = ("CARGO_CFG_DEBUG_ASSERTIONS", "");
+        let tm = ("CARGO_FEATURE_DEV_CONTROL", "1");
+        let qa = ("CARGO_FEATURE_QA_NATIVE", "1");
+        let g = ReleaseGuard::WithoutDebugAssertions;
+        let r = resolve(&spec(g), &env_of(&[])).unwrap();
+        assert!(!r.test_mode && !r.legacy_automation && !r.debug_assertions);
+        let r = resolve(&spec(g), &env_of(&[dbg, tm])).unwrap();
+        assert!(r.test_mode && !r.legacy_automation && r.debug_assertions);
+        let r = resolve(&spec(g), &env_of(&[dbg, tm, qa])).unwrap();
+        assert!(!r.test_mode && r.legacy_automation);
+        assert!(resolve(&spec(g), &env_of(&[tm])).is_err());
+        assert!(resolve(&spec(g), &env_of(&[qa])).is_err());
+        assert!(
+            resolve(&spec(ReleaseGuard::None), &env_of(&[tm]))
+                .unwrap()
+                .test_mode
+        );
+        let env_guard = ReleaseGuard::WhenEnvSet("RELEASE_BUILD");
+        assert!(resolve(&spec(env_guard), &env_of(&[tm])).unwrap().test_mode);
+        assert!(resolve(&spec(env_guard), &env_of(&[tm, ("RELEASE_BUILD", "1")])).is_err());
+        assert!(resolve(&spec(env_guard), &env_of(&[("RELEASE_BUILD", "1")])).is_ok());
+    }
+}

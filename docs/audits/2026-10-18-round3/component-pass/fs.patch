+
+fn check_marker_name(name: &str) -> Result<()> {
+    let plain = !name.is_empty()
+        && name != "."
+        && name != ".."
+        && !name.contains(['/', '\\', '\0', ':']);
+    if plain {
+        Ok(())
+    } else {
+        Err(FsError::BadName(name.to_string()))
+    }
+}
+
+fn marker_text(from: &Path, note: Option<&str>) -> String {
+    let at_ms = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0);
+    let mut out = format!(
+        "{{\n  \"from\": {},\n  \"at_ms\": {at_ms}",
+        json_string(&from.to_string_lossy())
+    );
+    if let Some(note) = note {
+        out.push_str(&format!(",\n  \"note\": {}", json_string(note)));
+    }
+    out.push_str("\n}\n");
+    out
+}
+
+fn json_string(text: &str) -> String {
+    let mut out = String::with_capacity(text.len() + 2);
+    out.push('"');
+    for c in text.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}

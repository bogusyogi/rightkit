@@ -0,0 +1,269 @@
+//! The user's own folders: home, Desktop, Documents and Downloads.
+//!
+//! Each function gives the same answer as the `dirs` crate (`home_dir`, `desktop_dir`,
+//! `document_dir`, `download_dir`), so an app can drop `dirs` for these:
+//!
+//! * **Windows.** The Profile, Desktop, Documents and Downloads known folders, asked of
+//!   `SHGetKnownFolderPath` with no environment fallback (a redirected `%USERPROFILE%` does not
+//!   move them; a folder the user relocated is followed).
+//! * **macOS.** `$HOME` (else the account database), then `Desktop`, `Documents` and `Downloads`
+//!   under it.
+//! * **Linux and other unix.** `$HOME` (else the account database); the three folders come from
+//!   `$XDG_CONFIG_HOME/user-dirs.dirs` (else `~/.config/user-dirs.dirs`), `None` when the file or
+//!   the entry is missing, disabled (`"$HOME/"`) or not in the `"$HOME/x"` / `"/x"` forms.
+//!
+//! These are the real folders of the account, not the per-app folders of [`AppDirs`](super::AppDirs):
+//! they ignore the test root and every QA override. Nothing here creates a directory.
+
+use std::path::PathBuf;
+
+/// The user's home folder, or `None` when the platform cannot say.
+pub fn home() -> Option<PathBuf> {
+    #[cfg(windows)]
+    {
+        super::known::known_folder(&super::known::PROFILE)
+    }
+    #[cfg(unix)]
+    {
+        unix_home()
+    }
+    #[cfg(not(any(windows, unix)))]
+    {
+        None
+    }
+}
+
+/// The user's Desktop folder, or `None`.
+pub fn desktop() -> Option<PathBuf> {
+    #[cfg(windows)]
+    {
+        super::known::known_folder(&super::known::DESKTOP)
+    }
+    #[cfg(not(windows))]
+    {
+        unix_user_dir("Desktop", "DESKTOP")
+    }
+}
+
+/// The user's Documents folder, or `None`.

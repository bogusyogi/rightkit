@@ -0,0 +1,252 @@
+//! Remove a directory tree, retrying what Windows refuses for a moment.
+//!
+//! [`remove_tree`] is `std::fs::remove_dir_all` with two additions that a Windows desktop app needs:
+//! every removal step is retried (a short bounded number of times) when Windows reports a sharing
+//! or lock violation or a delete that is still pending (an indexer, an antivirus scan or a just-closed
+//! handle holds the entry for a few milliseconds), and a read-only file is made writable and removed.
+//! On other platforms nothing is ever retried.
+//!
+//! * A symlink or junction **inside** the tree is removed as an entry; its target is never followed
+//!   and never touched.
+//! * The **root** must be a real directory: a symlink or junction is refused ([`FsError::Symlink`]), a
+//!   file is [`FsError::NotADirectory`]. A root that does not exist is not an error: the result is
+//!   `Ok(false)`.
+//! * Not atomic: a failure part-way leaves what was not yet removed and returns the error.
+//! * Windows retry classes are `ERROR_SHARING_VIOLATION` (32), `ERROR_LOCK_VIOLATION` (33),
+//!   `ERROR_ACCESS_DENIED` (5), `ERROR_DIR_NOT_EMPTY` (145) and `ERROR_DELETE_PENDING` (303). A real
+//!   permission failure therefore costs `attempts * delay` before it is reported.
+//!
+//! Not compiled or run when written.
+
+use crate::error::{FsError, Result};
+use std::fs;
+use std::io;
+use std::path::Path;
+use std::time::Duration;
+
+/// How hard [`remove_tree`] retries on Windows.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct RemoveOptions {
+    /// Retries per entry after the first attempt. Zero means one attempt. Ignored off Windows.
+    pub attempts: u32,
+    /// Pause before each retry.
+    pub delay: Duration,
+}
+
+impl Default for RemoveOptions {
+    fn default() -> Self {
+        Self {
+            attempts: 8,
+            delay: Duration::from_millis(50),
+        }
+    }
+}
+
+impl RemoveOptions {
+    /// `attempts` retries, `delay` apart.
+    pub fn new(attempts: u32, delay: Duration) -> Self {
+        Self { attempts, delay }
+    }
+}
+
+/// Remove the directory tree at `root`. Returns `Ok(true)` when a tree was removed and `Ok(false)`
+/// when `root` did not exist. See the module docs for the rules.
+pub fn remove_tree(root: &Path, options: &RemoveOptions) -> Result<bool> {
+    match fs::symlink_metadata(root) {
+        Ok(meta) if meta.file_type().is_symlink() => {
+            return Err(FsError::Symlink(root.to_path_buf()))
+        }
+        Ok(meta) if !meta.is_dir() => return Err(FsError::NotADirectory(root.to_path_buf())),
+        Ok(_) => {}
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(false),
+        Err(e) => return Err(FsError::io(root, e)),
+    }
+    remove_contents(root, options)?;
+    match with_retry(options, || fs::remove_dir(root)) {
+        Ok(()) => Ok(true),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(true),
+        Err(e) => Err(FsError::io(root, e)),
+    }
+}
+
+fn remove_contents(dir: &Path, options: &RemoveOptions) -> Result<()> {
+    let entries = match fs::read_dir(dir) {
+        Ok(entries) => entries,
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(()),
+        Err(e) => return Err(FsError::io(dir, e)),
+    };
+    for entry in entries {
+        let entry = entry.map_err(|e| FsError::io(dir, e))?;
+        let path = entry.path();
+        let kind = match entry.file_type() {
+            Ok(kind) => kind,
+            Err(e) if e.kind() == io::ErrorKind::NotFound => continue,
+            Err(e) => return Err(FsError::io(&path, e)),
+        };
+        if kind.is_symlink() {
+            // A file symlink goes with `remove_file`; a directory symlink or junction on Windows
+            // needs `remove_dir`. Neither follows the link.
+            let result = with_retry(options, || match remove_file_writable(&path) {
+                Err(e) if cfg!(windows) && e.kind() != io::ErrorKind::NotFound => {
+                    fs::remove_dir(&path).or(Err(e))
+                }
+                other => other,
+            });
+            ignore_missing(result).map_err(|e| FsError::io(&path, e))?;
+        } else if kind.is_dir() {
+            remove_contents(&path, options)?;
+            ignore_missing(with_retry(options, || fs::remove_dir(&path)))
+                .map_err(|e| FsError::io(&path, e))?;
+        } else {
+            ignore_missing(with_retry(options, || remove_file_writable(&path)))
+                .map_err(|e| FsError::io(&path, e))?;
+        }
+    }
+    Ok(())
+}
+
+fn ignore_missing(result: io::Result<()>) -> io::Result<()> {
+    match result {
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(()),
+        other => other,
+    }
+}
+
+/// `remove_file`; on a permission failure, clear the read-only attribute and try once more.
+fn remove_file_writable(path: &Path) -> io::Result<()> {
+    match fs::remove_file(path) {
+        Err(e) if e.kind() == io::ErrorKind::PermissionDenied => {
+            let Ok(meta) = fs::symlink_metadata(path) else {
+                return Err(e);
+            };
+            let mut permissions = meta.permissions();
+            if !permissions.readonly() {
+                return Err(e);
+            }
+            #[allow(clippy::permissions_set_readonly_false)]
+            permissions.set_readonly(false);
+            if fs::set_permissions(path, permissions).is_err() {
+                return Err(e);
+            }
+            fs::remove_file(path)
+        }
+        other => other,
+    }
+}
+
+#[cfg(windows)]
+fn transient(error: &io::Error) -> bool {
+    matches!(error.raw_os_error(), Some(5 | 32 | 33 | 145 | 303))
+}
+
+#[cfg(not(windows))]
+fn transient(_error: &io::Error) -> bool {
+    false
+}
+
+fn with_retry(options: &RemoveOptions, mut op: impl FnMut() -> io::Result<()>) -> io::Result<()> {
+    let mut left = options.attempts;
+    loop {
+        match op() {
+            Err(e) if left > 0 && transient(&e) => {
+                left -= 1;
+                std::thread::sleep(options.delay);
+            }
+            other => return other,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn opts() -> RemoveOptions {
+        RemoveOptions::new(2, Duration::ZERO)
+    }
+
+    #[test]
+    fn removes_a_nested_tree_and_reports_it() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().join("t");
+        fs::create_dir_all(root.join("a/b")).unwrap();
+        fs::write(root.join("a/b/f"), "x").unwrap();
+        fs::write(root.join("g"), "y").unwrap();
+        assert!(remove_tree(&root, &opts()).unwrap());
+        assert!(!root.exists());
+    }
+
+    #[test]
+    fn a_missing_root_is_false_not_an_error() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(!remove_tree(&dir.path().join("none"), &opts()).unwrap());
+    }
+
+    #[test]
+    fn a_file_root_is_refused_and_kept() {
+        let dir = tempfile::tempdir().unwrap();
+        let file = dir.path().join("f");
+        fs::write(&file, "x").unwrap();
+        assert!(matches!(
+            remove_tree(&file, &opts()).unwrap_err(),
+            FsError::NotADirectory(_)
+        ));
+        assert!(file.exists());
+    }
+
+    #[test]
+    fn a_read_only_file_is_removed() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().join("t");
+        fs::create_dir(&root).unwrap();
+        let file = root.join("ro");
+        fs::write(&file, "x").unwrap();
+        let mut permissions = fs::metadata(&file).unwrap().permissions();
+        permissions.set_readonly(true);
+        fs::set_permissions(&file, permissions).unwrap();
+        assert!(remove_tree(&root, &opts()).unwrap());
+        assert!(!root.exists());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_symlink_inside_is_removed_without_touching_its_target() {
+        let dir = tempfile::tempdir().unwrap();
+        let outside = dir.path().join("outside");
+        fs::create_dir(&outside).unwrap();
+        fs::write(outside.join("keep"), "keep").unwrap();
+        let root = dir.path().join("t");
+        fs::create_dir(&root).unwrap();
+        std::os::unix::fs::symlink(&outside, root.join("link")).unwrap();
+        assert!(remove_tree(&root, &opts()).unwrap());
+        assert_eq!(fs::read_to_string(outside.join("keep")).unwrap(), "keep");
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_symlink_root_is_refused() {
+        let dir = tempfile::tempdir().unwrap();
+        let outside = dir.path().join("outside");
+        fs::create_dir(&outside).unwrap();
+        let link = dir.path().join("link");
+        std::os::unix::fs::symlink(&outside, &link).unwrap();
+        assert!(matches!(
+            remove_tree(&link, &opts()).unwrap_err(),
+            FsError::Symlink(_)
+        ));
+        assert!(outside.exists());
+    }
+
+    #[test]
+    fn the_retry_loop_stops_at_the_first_non_transient_error_and_on_success() {
+        let mut calls = 0;
+        let result = with_retry(&opts(), || {
+            calls += 1;
+            Err(io::Error::from(io::ErrorKind::NotFound))
+        });
+        assert!(result.is_err());
+        assert_eq!(calls, 1);
+        assert!(with_retry(&opts(), || Ok(())).is_ok());
+    }
+}

+#[test]
+fn readers_opened_counts_pool_builds_not_checkouts() {
+    let dir = tempfile::tempdir().unwrap();
+    let (options, _writer) = fixture(&dir);
+    let pool = options.open_read_pool(2).unwrap();
+    assert_eq!(pool.readers_opened(), 1, "the first reader opens with the pool");
+    drop(pool.get().unwrap());
+    drop(pool.get().unwrap());
+    assert_eq!(pool.readers_opened(), 1, "a returned reader is reused");
+    let first = pool.get().unwrap();
+    let second = pool.get().unwrap();
+    assert_eq!(pool.readers_opened(), 2, "the second checkout opened a new reader");
+    drop((first, second));
+    assert_eq!(pool.clone().readers_opened(), 2, "clones share the count");
+}
+
+#[test]
+fn the_init_hook_counts_every_connection_opened() {
+    let dir = tempfile::tempdir().unwrap();
+    let (mut options, _writer) = fixture(&dir);
+    let opened = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let seen = opened.clone();
+    options.init = Some(std::sync::Arc::new(move |_: &Connection| {
+        seen.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        Ok(())
+    }));
+    let pool = options.open_read_pool(1).unwrap();
+    let _writer = options.open_writer().unwrap();
+    assert_eq!(opened.load(std::sync::atomic::Ordering::SeqCst), 2);
+    assert_eq!(pool.readers_opened(), 1);
+}

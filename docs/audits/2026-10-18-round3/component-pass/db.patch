new file mode 100644
index 0000000..8b08d8a
--- /dev/null
+++ b/crates/rightkit-db/tests/migrate_hooks.rs
@@ -0,0 +1,187 @@
+//! Stateful migration backup hooks: closures that capture state for the backup name, a gate before
+//! the backup, a check after it, and pruning. Real SQLite files.
+
+use rightkit_db::{
+    migrate_with_hooks, user_version, DbError, DbOptions, MigrateHooks, MigrateOptions, Migration,
+};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+
+fn migrations() -> Vec<Migration> {
+    vec![
+        Migration::sql(1, "create", "CREATE TABLE t(v INTEGER);"),
+        Migration::sql(2, "add_w", "ALTER TABLE t ADD COLUMN w INTEGER;"),
+    ]
+}
+
+fn fresh(dir: &tempfile::TempDir) -> PathBuf {
+    dir.path().canonicalize().unwrap().join("app.sqlite")
+}
+
+/// A writer at schema version 1, so the next migrate has an existing database to back up.
+fn at_version_one(path: &Path) -> rightkit_db::rusqlite::Connection {
+    let conn = DbOptions::new(path).open_writer().unwrap();
+    rightkit_db::migrate(
+        &conn,
+        Some(path),
+        &migrations()[..1],
+        &MigrateOptions::default(),
+    )
+    .unwrap();
+    conn
+}
+
+#[test]
+fn a_closure_that_captures_state_names_the_backup() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = fresh(&dir);
+    let conn = at_version_one(&path);
+    let stamp = String::from("20261018T101500");
+    let hooks = MigrateHooks::new()
+        .with_backup_name(move |from, to| format!("snap-{stamp}-v{from}-v{to}.bak"));
+    let report = migrate_with_hooks(
+        &conn,
+        Some(&path),
+        &migrations(),
+        &MigrateOptions::default(),
+        &hooks,
+    )
+    .unwrap();
+    let expected = path.with_file_name("snap-20261018T101500-v1-v2.bak");
+    assert_eq!(report.backup, Some(expected.clone()));
+    assert!(expected.exists());
+    assert_eq!(user_version(&conn).unwrap(), 2);
+}
+
+#[test]
+fn a_hooked_name_gets_the_same_plain_name_checks() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = fresh(&dir);
+    let conn = at_version_one(&path);
+    let hooks = MigrateHooks::new().with_backup_name(|_, _| "../escape.bak".to_string());
+    let error = migrate_with_hooks(
+        &conn,
+        Some(&path),
+        &migrations(),
+        &MigrateOptions::default(),
+        &hooks,
+    )
+    .unwrap_err();
+    assert!(matches!(error, DbError::Backup(_)), "{error:?}");
+    assert_eq!(user_version(&conn).unwrap(), 1);
+}
+
+#[test]
+fn a_before_backup_gate_can_refuse_and_nothing_is_written() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = fresh(&dir);
+    let conn = at_version_one(&path);
+    let free_bytes = 10_u64;
+    let hooks = MigrateHooks::new().with_before_backup(move |db, _backup| {
+        let needed = std::fs::metadata(db).map_or(0, |m| m.len());
+        if free_bytes < needed {
+            Err(format!("only {free_bytes} bytes free, {needed} needed"))
+        } else {
+            Ok(())
+        }
+    });
+    let error = migrate_with_hooks(
+        &conn,
+        Some(&path),
+        &migrations(),
+        &MigrateOptions::default(),
+        &hooks,
+    )
+    .unwrap_err();
+    match error {
+        DbError::Backup(message) => assert!(message.contains("bytes free"), "{message}"),
+        other => panic!("expected Backup, got {other:?}"),
+    }
+    assert_eq!(user_version(&conn).unwrap(), 1);
+    assert!(!path.with_file_name("app.sqlite.pre-v2.bak").exists());
+}
+
+#[test]
+fn a_stateful_verify_runs_on_the_backup_and_can_stop_the_migration() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = fresh(&dir);
+    let conn = at_version_one(&path);
+    let calls = Arc::new(AtomicUsize::new(0));
+    let seen = calls.clone();
+    let hooks = MigrateHooks::new().with_verify_backup(move |backup| {
+        seen.fetch_add(1, Ordering::SeqCst);
+        if backup.exists() {
+            Err("message count differs".to_string())
+        } else {
+            Ok(())
+        }
+    });
+    let error = migrate_with_hooks(
+        &conn,
+        Some(&path),
+        &migrations(),
+        &MigrateOptions::default(),
+        &hooks,
+    )
+    .unwrap_err();
+    assert!(matches!(error, DbError::Backup(_)), "{error:?}");
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert_eq!(user_version(&conn).unwrap(), 1, "no step ran");
+    assert!(
+        path.with_file_name("app.sqlite.pre-v2.bak").exists(),
+        "the backup is kept"
+    );
+}
+
+#[test]
+fn a_retention_hook_replaces_the_count_based_pruning() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = fresh(&dir);
+    let conn = at_version_one(&path);
+    let called = Arc::new(AtomicUsize::new(0));
+    let seen = called.clone();
+    let hooks = MigrateHooks::new().with_retain_backups(move |db, newest| {
+        seen.fetch_add(1, Ordering::SeqCst);
+        assert_eq!(db.file_name().unwrap(), "app.sqlite");
+        assert!(newest.exists());
+    });
+    let options = MigrateOptions {
+        backup_retention: Some(0),
+        ..MigrateOptions::default()
+    };
+    let report = migrate_with_hooks(&conn, Some(&path), &migrations(), &options, &hooks).unwrap();
+    assert_eq!(called.load(Ordering::SeqCst), 1);
+    assert!(report.backup.unwrap().exists());
+}
+
+#[test]
+fn no_hooks_behaves_like_migrate() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = fresh(&dir);
+    let conn = at_version_one(&path);
+    let report = migrate_with_hooks(
+        &conn,
+        Some(&path),
+        &migrations(),
+        &MigrateOptions::default(),
+        &MigrateHooks::new(),
+    )
+    .unwrap();
+    assert_eq!(
+        report.backup,
+        Some(path.with_file_name("app.sqlite.pre-v2.bak"))
+    );
+}
+
+#[test]
+fn open_writer_migrated_with_hooks_runs_the_hooks() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = fresh(&dir);
+    drop(at_version_one(&path));
+    let hooks = MigrateHooks::new().with_backup_name(|_, to| format!("kept-v{to}.bak"));
+    let (_conn, report) = DbOptions::new(&path)
+        .open_writer_migrated_with_hooks(&migrations(), &MigrateOptions::default(), &hooks)
+        .unwrap();
+    assert_eq!(report.backup, Some(path.with_file_name("kept-v2.bak")));
+}

+    let job = WalCheckpointJob::new(&path, policy(1, 1, Duration::ZERO)).unwrap();
+    let sequence = job.tick_passive_then_restart(&conn, 1).unwrap();
+    let passive = sequence.passive.expect("a PASSIVE ran");
+    assert_eq!(passive.mode, WalCheckpointMode::Passive);
+    assert_eq!(passive.status.busy, 0);
+    assert!(sequence.restart.is_none(), "no reader held the log back");
+}
+
+#[test]
+fn below_the_minimum_neither_checkpoint_runs() {
+    let dir = tempfile::tempdir().unwrap();
+    let (path, conn) = wal_writer(&dir);
+    let job = WalCheckpointJob::new(&path, policy(1, 1, Duration::ZERO)).unwrap();
+    let sequence = job.tick_passive_then_restart(&conn, u64::MAX).unwrap();
+    assert!(sequence.passive.is_none() && sequence.restart.is_none());
+}
+
+#[test]
+fn an_incomplete_passive_is_followed_by_restart_once_quiet() {
+    let dir = tempfile::tempdir().unwrap();
+    let (path, conn) = wal_writer(&dir);
+    // Do not wait on the reader below: RESTART reports busy instead of sleeping on it.
+    conn.busy_timeout(Duration::ZERO).unwrap();
+    let reader = DbOptions::new(&path).open_reader().unwrap();
+    reader.execute_batch("BEGIN;").unwrap();
+    reader
+        .query_row("SELECT count(*) FROM t", [], |row| row.get::<_, i64>(0))
+        .unwrap();
+    // New frames after the reader's snapshot: PASSIVE cannot copy them while the reader lives.
+    conn.execute_batch("INSERT INTO t VALUES ('y');").unwrap();

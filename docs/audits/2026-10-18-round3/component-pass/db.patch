+    let passive = sequence.passive.expect("a PASSIVE ran");
+    assert!(passive.status.checkpointed_frames < passive.status.log_frames);
+    assert!(sequence.restart.is_none(), "not quiet long enough");
+
+    let quiet = WalCheckpointJob::new(&path, policy(1, 1, Duration::from_secs(1))).unwrap();
+    let later = Instant::now() + Duration::from_secs(5);
+    let sequence = quiet.tick_passive_then_restart_at(&conn, 1, later).unwrap();
+    assert!(sequence.passive.is_some());
+    let restart = sequence.restart.expect("an incomplete PASSIVE escalates");
+    assert_eq!(restart.mode, WalCheckpointMode::Restart);

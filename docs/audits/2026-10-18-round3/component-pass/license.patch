@@ -0,0 +1,203 @@
+//! Token-version policy: verification restricted to chosen token `v` values, and the legacy v1
+//! migration path.
+//!
+//! [`verify_token`](crate::verify_token) does not look at the token's `v` claim, so it accepts
+//! any version whose payload parses. These functions let a caller state which versions it
+//! accepts, and give the retiring v1 format a hard sunset. A v1 payload carries the same core
+//! claims as v2 (`v, id, app, tier, features, device_id, iat, exp`) and none of the additive
+//! lifecycle claims, so it decodes into the same [`Entitlement`]. Signature, app and device
+//! checks are the normal ones and run first; the version and sunset checks apply only to an
+//! authenticated token, so a forged token never learns anything from them.
+
+use std::fmt;
+
+use crate::{authenticate_token_any_device, check_time_and_lifecycle, Entitlement, VerifyError};
+
+/// The legacy token version `v == 1`.
+pub const LEGACY_TOKEN_VERSION: u8 = 1;
+
+/// Why a version-restricted verification refused.
+#[derive(Debug, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum VersionedVerifyError {
+    /// The token authenticated but its `v` is not accepted here.
+    UnsupportedVersion { got: u8 },
+    /// A legacy token authenticated but the migration window is over (`now >= sunset`).
+    LegacySunset { sunset: i64, now: i64 },
+    /// The ordinary verification failed.
+    Verify(VerifyError),
+}
+
+impl fmt::Display for VersionedVerifyError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::UnsupportedVersion { got } => {
+                write!(f, "license token version {got} is not accepted")
+            }
+            Self::LegacySunset { sunset, now } => {
+                write!(
+                    f,
+                    "legacy license tokens are no longer accepted ({now} >= {sunset})"
+                )
+            }
+            Self::Verify(e) => write!(f, "{e}"),
+        }
+    }
+}
+
+impl std::error::Error for VersionedVerifyError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Verify(e) => Some(e),
+            _ => None,
+        }
+    }
+}
+
+impl From<VerifyError> for VersionedVerifyError {
+    fn from(e: VerifyError) -> Self {
+        Self::Verify(e)
+    }
+}
+
+/// [`verify_token_any_device`](crate::verify_token_any_device) that also requires the token's
+/// `v` to be one of `accepted_versions`. An empty list accepts nothing. Order: signature, app,
+/// device, version, then `iat`, expiry and lifecycle.
+pub fn verify_token_accepting_versions(
+    token: &str,
+    pubkey: &[u8; 32],
+    expected_app: &str,
+    device_ids: &[&str],
+    now_unix: i64,
+    accepted_versions: &[u8],
+) -> Result<Entitlement, VersionedVerifyError> {
+    let ent = authenticate_token_any_device(token, pubkey, expected_app, device_ids)?;
+    if !accepted_versions.contains(&ent.v) {
+        return Err(VersionedVerifyError::UnsupportedVersion { got: ent.v });
+    }
+    Ok(check_time_and_lifecycle(ent, now_unix)?)
+}
+
+/// Verify a legacy v1 token during its migration window. Only `v == 1` passes (a v2 token is
+/// [`VersionedVerifyError::UnsupportedVersion`]; use [`verify_token`](crate::verify_token)
+/// for those), and only while `now_unix < sunset_unix`; afterwards an otherwise valid v1 token
+/// is [`VersionedVerifyError::LegacySunset`]. The sunset is the caller's (for example the
+/// 2027-01-01 cutoff ScrapeRight keeps), passed in so the policy stays with the app. Order:
+/// signature, app, device, version, sunset, then `iat`, expiry and lifecycle.
+pub fn verify_legacy_token(
+    token: &str,
+    pubkey: &[u8; 32],
+    expected_app: &str,
+    device_ids: &[&str],
+    now_unix: i64,
+    sunset_unix: i64,
+) -> Result<Entitlement, VersionedVerifyError> {
+    let ent = authenticate_token_any_device(token, pubkey, expected_app, device_ids)?;
+    if ent.v != LEGACY_TOKEN_VERSION {
+        return Err(VersionedVerifyError::UnsupportedVersion { got: ent.v });
+    }
+    if now_unix >= sunset_unix {
+        return Err(VersionedVerifyError::LegacySunset {
+            sunset: sunset_unix,
+            now: now_unix,
+        });
+    }
+    Ok(check_time_and_lifecycle(ent, now_unix)?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use base64::Engine;
+    use ed25519_dalek::{Signer, SigningKey};
+
+    const APP: &str = "scraperight";
+    const DEV: &str = "dev-1";
+
+    fn key() -> SigningKey {
+        SigningKey::from_bytes(&[7_u8; 32])
+    }
+    fn pubkey() -> [u8; 32] {
+        key().verifying_key().to_bytes()
+    }
+    fn token(v: u8, tier: &str, exp: i64) -> String {
+        let payload = format!(
+            r#"{{"v":{v},"id":"lic_1","app":"{APP}","tier":"{tier}","features":[],"device_id":"{DEV}","iat":1000,"exp":{exp}}}"#
+        );
+        let e = base64::engine::general_purpose::URL_SAFE_NO_PAD;
+        let sig = key().sign(payload.as_bytes());
+        format!("{}.{}", e.encode(payload.as_bytes()), e.encode(sig.to_bytes()))
+    }
+
+    #[test]
+    fn legacy_v1_verifies_before_sunset() {
+        let t = token(1, "pro", 9_000);
+        let e = verify_legacy_token(&t, &pubkey(), APP, &[DEV], 2_000, 5_000).unwrap();
+        assert_eq!(e.v, 1);
+        assert!(e.is_pro());
+        assert!(e.license_kind.is_none());
+    }
+
+    #[test]
+    fn legacy_v1_refused_at_and_after_sunset() {
+        let t = token(1, "pro", 9_000);
+        for now in [5_000, 6_000] {
+            assert_eq!(
+                verify_legacy_token(&t, &pubkey(), APP, &[DEV], now, 5_000),
+                Err(VersionedVerifyError::LegacySunset { sunset: 5_000, now })
+            );
+        }
+    }
+
+    #[test]
+    fn legacy_refuses_v2_and_current_path_still_takes_it() {
+        let t = token(2, "pro", 9_000);
+        assert_eq!(
+            verify_legacy_token(&t, &pubkey(), APP, &[DEV], 2_000, 5_000),
+            Err(VersionedVerifyError::UnsupportedVersion { got: 2 })
+        );
+        assert!(verify_token_accepting_versions(&t, &pubkey(), APP, &[DEV], 2_000, &[1, 2]).is_ok());
+    }
+
+    #[test]
+    fn accepted_versions_filters_and_empty_accepts_nothing() {
+        let t = token(1, "pro", 9_000);
+        assert_eq!(
+            verify_token_accepting_versions(&t, &pubkey(), APP, &[DEV], 2_000, &[2]),
+            Err(VersionedVerifyError::UnsupportedVersion { got: 1 })
+        );
+        assert_eq!(
+            verify_token_accepting_versions(&t, &pubkey(), APP, &[DEV], 2_000, &[]),
+            Err(VersionedVerifyError::UnsupportedVersion { got: 1 })
+        );
+    }
+
+    #[test]
+    fn authentication_and_expiry_failures_pass_through() {
+        let t = token(1, "pro", 3_000);
+        assert_eq!(
+            verify_legacy_token(&t, &pubkey(), APP, &[DEV], 4_000, 9_000),
+            Err(VersionedVerifyError::Verify(VerifyError::Expired { exp: 3_000, now: 4_000 }))
+        );
+        assert_eq!(
+            verify_legacy_token(&t, &pubkey(), APP, &["other"], 2_000, 9_000),
+            Err(VersionedVerifyError::Verify(VerifyError::DeviceMismatch))
+        );
+        assert!(verify_legacy_token(&t, &[9_u8; 32], APP, &[DEV], 2_000, 9_000).is_err());
+        assert_eq!(
+            verify_legacy_token(&t, &pubkey(), "other", &[DEV], 2_000, 9_000),
+            Err(VersionedVerifyError::Verify(VerifyError::AppMismatch {
+                expected: "other".into(),
+                got: APP.into()
+            }))
+        );
+    }
+
+    #[test]
+    fn sunset_is_not_revealed_for_a_forged_token() {
+        let mut t = token(1, "pro", 9_000);
+        t.push('A');
+        let r = verify_legacy_token(&t, &pubkey(), APP, &[DEV], 99_999, 5_000);
+        assert!(matches!(r, Err(VersionedVerifyError::Verify(_))));
+    }
+}

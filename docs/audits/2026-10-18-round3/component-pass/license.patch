+fn engine_with_source(
+    source: impl rightkit_license::TokenSource + 'static,
+    now: Arc<AtomicI64>,
+) -> EngineEntitlements {
+    let cfg = EngineEntitlementsConfig::new(pubkey(), APP, std::env::temp_dir(), || {
+        Ok(DEVICE.to_string())
+    })
+    .with_token_source(source);
+    EngineEntitlements::new(cfg).with_wall_clock(move || Ok(now.load(Ordering::SeqCst)))
+}
+
+#[test]
+fn token_source_supplies_a_pro_token_without_a_file() {
+    let token = Claims::term(NOW - 100, NOW + 10_000).token();
+    let e = engine_with_source(move || Ok::<Option<String>, String>(Some(format!("  {token}\n"))), clock());
+    assert!(e.require_pro().is_ok());
+}
+
+#[test]
+fn token_source_none_is_no_license_and_error_is_unreadable() {
+    let e = engine_with_source(|| Ok::<Option<String>, String>(None), clock());
+    assert_eq!(e.require_pro(), Err(E::NoLicense));
+    let e = engine_with_source(|| Err::<Option<String>, String>("store locked".to_string()), clock());
+    assert_eq!(e.require_pro(), Err(E::Unreadable("store locked".to_string())));
+    let e = engine_with_source(|| Ok::<Option<String>, String>(Some("   ".to_string())), clock());
+    assert!(matches!(e.require_pro(), Err(E::Unreadable(_))));
+    let e = engine_with_source(|| Ok::<Option<String>, String>(Some("a".repeat(20_000))), clock());
+    assert!(matches!(e.require_pro(), Err(E::Unreadable(_))));
+}
+
+#[test]
+fn token_source_token_is_still_authenticated() {
+    let mut c = Claims::term(NOW - 100, NOW + 10_000);
+    c.tier = "pro";
+    let token = c.token();
+    let e = engine_with_source(move || Ok::<Option<String>, String>(Some(token.clone())), clock());
+    assert!(e.require_pro().is_ok());
+    let wrong_device = Claims::term(NOW - 100, NOW + 10_000).token();
+    let cfg = EngineEntitlementsConfig::new(pubkey(), APP, std::env::temp_dir(), || {
+        Ok("someone-else".to_string())
+    })
+    .with_token_source(move || Ok::<Option<String>, String>(Some(wrong_device.clone())));
+    let e = EngineEntitlements::new(cfg).with_wall_clock(|| Ok(NOW));
+    assert_eq!(e.require_pro(), Err(E::Invalid(VerifyError::DeviceMismatch)));
+}

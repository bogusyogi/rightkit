+//! [`TokenSource`] backed by the OS credential store (feature `credential-token`).
+
+use rightkit_credentials::Store;
+
+use crate::TokenSource;
+
+/// Reads the signed licence token from the OS credential store (Keychain, Credential
+/// Manager, Secret Service, Android Keystore) through a `rightkit-credentials` [`Store`],
+/// so the token never sits in a plain file. Use it with
+/// [`EngineEntitlementsConfig::with_token_source`](crate::EngineEntitlementsConfig::with_token_source).
+///
+/// The app (the window side) writes the token to `account` with the same store; the engine
+/// only reads. A missing item is "no token" (Free); a store failure is
+/// [`EngineEntitlementError::Unreadable`](crate::EngineEntitlementError::Unreadable) carrying
+/// the store's error text, never the secret. The token is authenticated as for any source.
+pub struct CredentialTokenSource {
+    store: Store,
+    account: String,
+}
+
+impl CredentialTokenSource {
+    /// `store` is the app's credential store and `account` the item that holds the token.
+    pub fn new(store: Store, account: impl Into<String>) -> Self {
+        Self {
+            store,
+            account: account.into(),
+        }
+    }
+}
+
+impl TokenSource for CredentialTokenSource {
+    fn read_token(&self) -> Result<Option<String>, String> {
+        match self.store.get(&self.account) {
+            Ok(None) => Ok(None),
+            Ok(Some(secret)) => secret
+                .expose_str()
+                .map(|s| Some(s.to_string()))
+                .map_err(|_| "stored licence token is not valid UTF-8".to_string()),
+            Err(e) => Err(e.to_string()),
+        }
+    }
+}

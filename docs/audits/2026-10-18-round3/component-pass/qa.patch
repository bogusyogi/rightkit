+import { describe, expect, it } from 'vitest';
+import { QaPage } from './page.js';
+
+/** A client double: records sends, lets a test supply replies, and ignores event subscriptions. */
+function pageWithClient(reply: (method: string, params: any) => any = () => ({})) {
+  const sends: Array<{ method: string; params: any; session?: string }> = [];
+  const client: any = {
+    timeout: 1000,
+    send: async (method: string, params: any = {}, session?: string) => { sends.push({ method, params, session }); return reply(method, params) ?? {}; },
+    on: () => () => {},
+    onAny: () => () => {},
+    rejectSession: () => {},
+  };
+  const page = new QaPage(client, 'T1', 'S1', () => {});
+  return { page, sends, client };
+}
+
+describe('QaPage.navigate', () => {
+  it('is goto: it forwards the url and options unchanged', async () => {
+    const { page } = pageWithClient();
+    const seen: unknown[][] = [];
+    (page as any).goto = async (...args: unknown[]) => { seen.push(args); };
+    await page.navigate('http://127.0.0.1:1/x', { waitUntil: 'domcontentloaded', timeout: 2000 });
+    expect(seen).toEqual([['http://127.0.0.1:1/x', { waitUntil: 'domcontentloaded', timeout: 2000 }]]);
+  });
+});
+
+describe('emulation helpers', () => {
+  it('setViewport and clearViewport send the device metrics commands', async () => {
+    const { page, sends } = pageWithClient();
+    await page.setViewport({ width: 390, height: 844, deviceScaleFactor: 3, mobile: true });
+    await page.clearViewport();
+    expect(sends.map((s) => s.method)).toEqual(['Emulation.setDeviceMetricsOverride', 'Emulation.clearDeviceMetricsOverride']);
+    expect(sends[0].params).toEqual({ width: 390, height: 844, deviceScaleFactor: 3, mobile: true });
+    expect(sends[1].params).toEqual({});
+  });
+  it('setEmulatedMedia maps features to name/value strings, and no argument clears both', async () => {
+    const { page, sends } = pageWithClient();
+    await page.setEmulatedMedia({ media: 'print', features: { 'prefers-color-scheme': 'dark', 'prefers-reduced-motion': 'reduce' } });
+    await page.setEmulatedMedia();
+    expect(sends[0]).toEqual({ method: 'Emulation.setEmulatedMedia', session: 'S1', params: { media: 'print', features: [

+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { bindQaDevRoot, resetQaDevRoot } from './devroot.js';
+import { DEV_ROOT_MARKER, assertQaLaunchSafe, UserDataViolation } from './userdata.js';
+
+const cleanup: string[] = [];
+function fakeHome(): string {
+  const dir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'rkqa-devroot-')));
+  cleanup.push(dir);
+  return dir;
+}
+afterEach(() => { for (const dir of cleanup.splice(0)) fs.rmSync(dir, { recursive: true, force: true }); });
+
+describe('bindQaDevRoot', () => {
+  it('binds a persistent root outside the temp roots and the launch guard accepts it', () => {
+    const userHome = fakeHome();
+    const root = bindQaDevRoot({ app: 'mailright', dir: path.join(userHome, 'MailRightDevRoot'), userHomes: [userHome], tempRoots: [] });
+    expect(root.bound).toBe('dev-root');
+    expect(fs.existsSync(path.join(root.home, DEV_ROOT_MARKER))).toBe(true);
+    expect(root.env.RIGHTKIT_QA_DATA_DIR).toBe(root.dataDir);
+    expect(root.env.HOME).toBe(root.home);
+    expect(() => assertQaLaunchSafe(root, { userHomes: [userHome], tempRoots: [] })).not.toThrow();
+    expect(() => assertQaLaunchSafe(root, { userHomes: [userHome], tempRoots: [], dirs: [userHome] })).toThrow(UserDataViolation);
+  });
+
+  it('is idempotent and keeps data across binds', () => {
+    const userHome = fakeHome();
+    const options = { app: 'mailright', dir: path.join(userHome, 'DevRoot'), userHomes: [userHome], tempRoots: [] };
+    const first = bindQaDevRoot(options);
+    fs.writeFileSync(path.join(first.dataDir, 'keep.txt'), 'x');
+    const second = bindQaDevRoot(options);
+    expect(fs.readFileSync(path.join(second.dataDir, 'keep.txt'), 'utf8')).toBe('x');
+    resetQaDevRoot(second);
+    expect(fs.existsSync(path.join(second.dataDir, 'keep.txt'))).toBe(true);
+    resetQaDevRoot(second, { data: true });
+    expect(fs.existsSync(path.join(second.dataDir, 'keep.txt'))).toBe(false);
+  });
+
+  it('refuses a home directory, a relative path, another app, and a non-empty unmarked directory', () => {
+    const userHome = fakeHome();
+    const guardOptions = { userHomes: [userHome], tempRoots: [] as string[] };
+    expect(() => bindQaDevRoot({ app: 'a', dir: userHome, ...guardOptions })).toThrow(UserDataViolation);
+    expect(() => bindQaDevRoot({ app: 'a', dir: 'relative/dir', ...guardOptions })).toThrow(UserDataViolation);
+    const dir = path.join(userHome, 'Root');
+    bindQaDevRoot({ app: 'a', dir, ...guardOptions });
+    expect(() => bindQaDevRoot({ app: 'b', dir, ...guardOptions })).toThrow(/bound to a/);
+    const other = path.join(userHome, 'Other');
+    fs.mkdirSync(other);
+    fs.writeFileSync(path.join(other, 'user-file.txt'), 'data');
+    expect(() => bindQaDevRoot({ app: 'a', dir: other, ...guardOptions })).toThrow(/not adopted/);
+    expect(fs.existsSync(path.join(other, DEV_ROOT_MARKER))).toBe(false);
+  });
+
+  it('refuses forbidden locations and leaves no marker behind', () => {
+    const userHome = fakeHome();
+    const docs = path.join(userHome, 'Documents', 'Root');
+    expect(() => bindQaDevRoot({ app: 'a', dir: docs, userHomes: [userHome], tempRoots: [] })).toThrow(UserDataViolation);
+    expect(fs.existsSync(path.join(docs, DEV_ROOT_MARKER))).toBe(false);
+  });
+
+  it('a workspace claiming dev-root without the marker is refused', () => {
+    const dir = fakeHome();
+    expect(() => assertQaLaunchSafe({ home: dir, env: {}, bound: 'dev-root' }, { tempRoots: [dir] })).toThrow(/no \.rightkit-devroot\.json marker/);
+  });
+});
diff --git a/packages/qa/src/devroot.ts b/packages/qa/src/devroot.ts
new file mode 100644
index 0000000..c1a0f60
--- /dev/null
+++ b/packages/qa/src/devroot.ts
@@ -0,0 +1,106 @@
+// A persistent, bound dev root: one dedicated directory an app's dev/QA runs keep using across runs
+// (for example `~/MailRightDevRoot`), instead of a throwaway home under system temp.
+//
+// `createQaWorkspace` homes live directly under `<system temp>/rightkit-qa` and are deleted with the run, so a
+// persistent root outside temp was refused by `createQaWorkspace`, `assertQaLaunchSafe` and `spawnQaApp`
+// (Orthic-Labs/rightkit#674). `bindQaDevRoot` is the sanctioned way: the directory is created or adopted once, carries
+// a marker bound to one app, and is then accepted by the launch guard. All forbidden-location rules still apply
+// (user folders, cloud storage, volumes, UNC paths, the app's real data directory), and a dev root is never deleted by
+// `disposeQaWorkspace`.
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { DEV_ROOT_MARKER, QaLaunchGuard, UserDataViolation, resolveForGuard, type GuardOptions } from './userdata.js';
+import { qaWorkspaceEnv } from './workspace.js';
+
+/** A persistent QA home. Accepted wherever the launch guard takes a workspace (`spawnQaApp`, `assertQaLaunchSafe`, `seedFrom`). */
+export interface QaDevRoot {
+  runId: string;
+  appKey: string;
+  /** The bound directory. Same as `home`. */
+  root: string;
+  home: string;
+  dataDir: string;
+  evidenceDir: string;
+  captureDir: string;
+  env: Record<string, string>;
+  bound: 'dev-root';
+}
+
+export interface BindQaDevRootOptions extends GuardOptions {
+  /** The app this root belongs to; a root bound to another app is refused. */
+  app: string;
+  /** Absolute directory. Created when missing. An existing directory must be empty or already bound to `app`. */
+  dir: string;
+}
+
+function safeApp(app: string): string {
+  const v = String(app ?? '').trim();
+  if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(v)) throw new Error(`unsafe QA app: ${app}`);
+  return v;
+}
+
+/**
+ * Create or adopt `dir` as the persistent dev root of `app` and return a workspace for it. The directory must be
+ * absolute, must not be a home directory or filesystem root, must break none of the forbidden-location rules, and must
+ * be empty or already bound to the same app (a non-empty directory without the marker is never adopted). Safe to call on
+ * every run: an existing binding is reused and its data kept.
+ */
+export function bindQaDevRoot(options: BindQaDevRootOptions): QaDevRoot {
+  const app = safeApp(options.app);
+  if (!path.isAbsolute(options.dir) || options.dir.split(/[\\/]+/).includes('..')) throw new UserDataViolation(options.dir, 'unresolvable', 'a dev root must be an absolute path with no `..`');
+  const home = resolveForGuard(options.dir);
+  const markerPath = path.join(home, DEV_ROOT_MARKER);
+  if (fs.existsSync(home)) {
+    if (!fs.statSync(home).isDirectory()) throw new UserDataViolation(home, 'not-a-qa-root', 'the path exists and is not a directory');
+    if (!fs.existsSync(markerPath) && fs.readdirSync(home).length > 0) throw new UserDataViolation(home, 'not-a-qa-root', `a non-empty directory without ${DEV_ROOT_MARKER} is not adopted as a dev root`);
+  }
+  const existing = readMarker(markerPath);
+  if (existing && existing !== app) throw new UserDataViolation(home, 'not-a-qa-root', `the dev root is bound to ${existing}, not ${app}`);
+  // The location is judged with the same guard a launch uses; the marker is written first only because the guard
+  // reads it, and it is removed again when the guard refuses a root this call created.
+  const created = !fs.existsSync(home);
+  fs.mkdirSync(home, { recursive: true });
+  if (!existing) fs.writeFileSync(markerPath, JSON.stringify({ schemaVersion: 1, app, createdAtMs: Date.now() }));
+  try {
+    QaLaunchGuard.forWorkspace({ home, appKey: app, bound: 'dev-root' }, options);
+  } catch (error) {
+    if (!existing) fs.rmSync(markerPath, { force: true });
+    if (created) { try { fs.rmdirSync(home); } catch { /* not empty or in use: leave it */ } }
+    throw error;
+  }
+  const dataDir = path.join(home, 'data');
+  const evidenceDir = path.join(home, 'evidence');
+  const captureDir = path.join(home, 'captures');
+  const tmpDir = path.join(home, 'tmp');
+  const cacheDir = path.join(home, 'cache');
+  for (const dir of [dataDir, evidenceDir, captureDir, tmpDir, cacheDir]) fs.mkdirSync(dir, { recursive: true });
+  const runId = 'dev-root';
+  return {
+    runId, appKey: app, root: home, home, dataDir, evidenceDir, captureDir, bound: 'dev-root',
+    env: qaWorkspaceEnv({ appKey: app, runId, home, dataDir, tmpDir, cacheDir, evidenceDir, captureDir }),
+  };
+}
+
+function readMarker(markerPath: string): string | undefined {
+  try {
+    const marker = JSON.parse(fs.readFileSync(markerPath, 'utf8')) as { schemaVersion?: unknown; app?: unknown };
+    return marker.schemaVersion === 1 && typeof marker.app === 'string' ? marker.app : undefined;
+  } catch { return undefined; }
+}
+
+export interface ResetQaDevRootOptions {
+  /** Also empty the app data directory (the default keeps it: that is what a persistent root is for). */
+  data?: boolean;
+}
+
+/** Empty the dev root's volatile `tmp`, `cache`, `evidence` and `captures` directories (and `data` with `data: true`). The root and its marker stay. */
+export function resetQaDevRoot(root: QaDevRoot, options: ResetQaDevRootOptions = {}): void {
+  QaLaunchGuard.forWorkspace(root, {});
+  const names = ['tmp', 'cache', 'evidence', 'captures', ...(options.data ? ['data'] : [])];
+  for (const name of names) {
+    const dir = path.join(root.home, name);
+    fs.rmSync(dir, { recursive: true, force: true });
+    fs.mkdirSync(dir, { recursive: true });
+  }
+}
diff --git a/packages/qa/src/dialog.ts b/packages/qa/src/dialog.ts
new file mode 100644
index 0000000..751d438
--- /dev/null
+++ b/packages/qa/src/dialog.ts
@@ -0,0 +1,22 @@
+/** Browser-only QA seam. Import via `@rightkit/qa/dialog` (no Node dependencies). */
+export type QaDialogAnswer = string | string[] | null;
+
+export interface QaDialogTarget {
+  __RIGHTKIT_QA_DIALOG__?: QaDialogAnswer;
+}
+
+/**
+ * Read a persistent answer when enabled. `undefined` opens the OS dialog, `null`
+ * cancels it. Guard the call with a build-time QA constant so release tree shaking
+ * removes this module & its marker. Answers stay set until changed or cleared.
+ */
+export function qaDialogAnswer(
+  enabled: boolean,
+  target: QaDialogTarget = globalThis as unknown as QaDialogTarget,
+): QaDialogAnswer | undefined {
+  if (!enabled) return undefined;
+  const answer = target.__RIGHTKIT_QA_DIALOG__;
+  if (answer === undefined || answer === null || typeof answer === 'string') return answer;
+  if (Array.isArray(answer) && answer.every(path => typeof path === 'string')) return [...answer];
+  throw new TypeError('Invalid QA dialog answer: expected string, string[] or null');
+}

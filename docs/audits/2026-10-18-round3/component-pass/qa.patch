@@ -0,0 +1,122 @@
+import fs from 'node:fs';
+import net from 'node:net';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { ControlClient, ControlError, readControlRecord } from './control.js';
+import { parseControlArgs } from './control-cli.js';
+
+const cleanup: (() => void)[] = [];
+afterEach(() => { for (const close of cleanup.splice(0).reverse()) close(); });
+
+/** A fake control server on a Unix socket (a named pipe on Windows) speaking the daemon's JSON lines. */
+async function fakeServer(handle: (request: any, write: (frame: unknown) => void) => void, helloExtra: Record<string, unknown> = {}) {
+  const suite = fs.mkdtempSync(path.join(os.tmpdir(), 'rkqa-ctl-'));
+  cleanup.push(() => fs.rmSync(suite, { recursive: true, force: true }));
+  const service = 'control-test';
+  fs.mkdirSync(path.join(suite, 'runtime', service), { recursive: true });
+  const endpoint = process.platform === 'win32' ? `\\\\.\\pipe\\rkqa-ctl-${process.pid}-${Date.now()}` : path.join(suite, 'runtime', service, 's.sock');
+  const received: any[] = [];
+  const server = net.createServer((socket) => {
+    socket.setEncoding('utf8');
+    let buffer = '';
+    const write = (frame: unknown) => socket.write(`${JSON.stringify(frame)}\n`);
+    socket.on('data', (chunk: string) => {
+      buffer += chunk;
+      for (let nl = buffer.indexOf('\n'); nl >= 0; nl = buffer.indexOf('\n')) {
+        const frame = JSON.parse(buffer.slice(0, nl)); buffer = buffer.slice(nl + 1); received.push(frame);
+        if (frame.type === 'hello') write({ type: 'hello', ok: frame.app === 'right-qa', ...(frame.app === 'right-qa' ? { service, methods: ['eval'], ...helloExtra } : { error: { code: 'not_allowed', message: 'app not allowed' } }) });
+        else handle(frame, write);
+      }
+    });
+  });
+  await new Promise<void>((resolve) => server.listen(endpoint, resolve));
+  cleanup.push(() => server.close());
+  fs.writeFileSync(path.join(suite, 'runtime', service, 'service.json'), JSON.stringify({ protocol_major: 1, protocol_minor: 0, service, role: 'test', pid: process.pid, endpoint }));
+  return { suite, service, received };
+}
+
+describe('ControlClient', () => {
+  it('discovers the service, says hello as right-qa and returns a result', async () => {
+    const { suite, service, received } = await fakeServer((req, write) => write({ type: 'response', id: req.id, ok: true, result: { echoed: req.params } }));
+    const client = await ControlClient.connect({ suiteRoot: suite, service, timeoutMs: 2000 });
+    cleanup.push(() => client.close());
+    expect(await client.call('eval', { js: 'return 1' })).toEqual({ echoed: { js: 'return 1' } });
+    expect(received[0]).toMatchObject({ type: 'hello', app: 'right-qa', protocol_major: 1 });
+    expect(received[1]).toMatchObject({ type: 'request', method: 'eval', params: { js: 'return 1' } });
+  });
+
+  it('sends evaluate as the js param and matches overlapping calls by id', async () => {
+    const { suite, service } = await fakeServer((req, write) => {
+      if (req.params.js === 'slow') setTimeout(() => write({ type: 'response', id: req.id, ok: true, result: 'slow' }), 50);
+      else write({ type: 'response', id: req.id, ok: true, result: req.params.js });
+    });
+    const client = await ControlClient.connect({ suiteRoot: suite, service, timeoutMs: 2000 });
+    cleanup.push(() => client.close());
+    const [slow, fast] = await Promise.all([client.evaluate('slow'), client.evaluate('fast')]);
+    expect([slow, fast]).toEqual(['slow', 'fast']);
+  });
+
+  it('turns an error answer into a ControlError with the code', async () => {
+    const { suite, service } = await fakeServer((req, write) => write({ type: 'response', id: req.id, ok: false, error: { code: 'not_allowed', message: 'nope', retryable: false } }));
+    const client = await ControlClient.connect({ suiteRoot: suite, service, timeoutMs: 2000 });
+    cleanup.push(() => client.close());
+    await expect(client.call('click', {})).rejects.toMatchObject({ name: 'ControlError', code: 'not_allowed' });
+  });
+
+  it('forwards events and assembles a chunked result through rk.fetch', async () => {
+    const pieces = ['{"a":', '[1,2]}'];
+    const { suite, service, received } = await fakeServer((req, write) => {
+      if (req.method === 'screenshot') {
+        write({ type: 'event', id: req.id, event: { progress: 1 } });
+        write({ type: 'response', id: req.id, ok: true, result: null, chunked: { id: 'c1', bytes: pieces.join('').length, count: pieces.length } });
+      } else if (req.method === 'rk.fetch') write({ type: 'response', id: req.id, ok: true, result: { seq: req.params.seq, text: pieces[req.params.seq] } });
+    }, { max_message: 1024 });
+    const client = await ControlClient.connect({ suiteRoot: suite, service, timeoutMs: 2000 });
+    cleanup.push(() => client.close());
+    const events: unknown[] = [];
+    expect(await client.call('screenshot', {}, { onEvent: (event) => events.push(event) })).toEqual({ a: [1, 2] });
+    expect(events).toEqual([{ progress: 1 }]);
+    expect(received.find((frame) => frame.method === 'screenshot')).toMatchObject({ chunked_ok: true });
+  });
+
+  it('rejects pending calls when the connection closes and times out silent calls', async () => {
+    const { suite, service } = await fakeServer(() => { /* never answers */ });
+    const client = await ControlClient.connect({ suiteRoot: suite, service, timeoutMs: 2000 });
+    await expect(client.call('eval', {}, { timeoutMs: 40 })).rejects.toMatchObject({ code: 'timeout', retryable: true });
+    client.close();
+    await expect(client.call('eval', {})).rejects.toBeInstanceOf(ControlError);
+  });
+
+  it('refuses an app label the server does not allow', async () => {
+    const { suite, service } = await fakeServer(() => {});
+    await expect(ControlClient.connect({ suiteRoot: suite, service, app: 'other', timeoutMs: 2000 })).rejects.toMatchObject({ code: 'not_allowed' });
+  });
+});
+
+describe('discovery', () => {
+  it('validates the service name, the suite root and the record', () => {
+    expect(() => readControlRecord('/x', 'Bad Name')).toThrow('lowercase');
+    expect(() => readControlRecord('relative', 'ok')).toThrow('absolute');
+    const suite = fs.mkdtempSync(path.join(os.tmpdir(), 'rkqa-ctl-'));
+    cleanup.push(() => fs.rmSync(suite, { recursive: true, force: true }));
+    expect(() => readControlRecord(suite, 'ok')).toThrow(/service_unavailable/);
+    fs.mkdirSync(path.join(suite, 'runtime', 'ok'), { recursive: true });
+    fs.writeFileSync(path.join(suite, 'runtime', 'ok', 'service.json'), JSON.stringify({ protocol_major: 2, endpoint: 'x', pid: 1 }));
+    expect(() => readControlRecord(suite, 'ok')).toThrow(/protocol/);
+  });
+});
+
+describe('rightkit-qa-control arguments', () => {
+  it('parses options, the method and JSON params', () => {
+    expect(parseControlArgs(['--suite', '/s', '--service', 'svc', '--timeout', '500', 'eval', '{"js":"1"}'])).toEqual({ suiteRoot: '/s', service: 'svc', timeoutMs: 500, method: 'eval', params: { js: '1' } });
+    expect(parseControlArgs(['health'])).toEqual({ method: 'health', params: {} });
+  });
+  it('rejects a missing method, bad JSON, unknown options and a bad timeout', () => {
+    expect(() => parseControlArgs([])).toThrow('missing <method>');
+    expect(() => parseControlArgs(['eval', '{nope'])).toThrow('not JSON');
+    expect(() => parseControlArgs(['--wat', 'x'])).toThrow('unknown option');
+    expect(() => parseControlArgs(['--timeout', '0', 'x'])).toThrow('--timeout');
+    expect(() => parseControlArgs(['a', '{}', 'b'])).toThrow('unexpected argument');
+  });
+});

+/// Which ffmpeg detect filter produced a log: the spelling of its start and end keys differs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DetectFilter {
+    /// `-vf blackdetect`: `black_start:` / `black_end:`.
+    Black,
+    /// `-vf freezedetect`: `lavfi.freezedetect.freeze_start:` / `freeze_end:`.
+    Freeze,
+    /// `-af silencedetect`: `silence_start:` / `silence_end:`.
+    Silence,
+}
+
+impl DetectFilter {
+    fn keys(self) -> (&'static str, &'static str) {
+        match self {
+            DetectFilter::Black => ("black_start:", "black_end:"),
+            DetectFilter::Freeze => ("freeze_start:", "freeze_end:"),
+            DetectFilter::Silence => ("silence_start:", "silence_end:"),
+        }
+    }
+}
+
+fn number_after(line: &str, key: &str) -> Option<f64> {
+    let rest = line[line.find(key)? + key.len()..].trim_start();
+    let end = rest
+        .find(|c: char| !(c.is_ascii_digit() || matches!(c, '.' | '-' | '+' | 'e' | 'E')))
+        .unwrap_or(rest.len());
+    rest[..end].parse().ok()
+}
+
+/// Intervals out of an ffmpeg `blackdetect`, `freezedetect` or `silencedetect` log (its stderr, run with
+/// `-nostats` and a log level of at least `info`). A start without an end (the media ended inside the
+/// span) closes at `media_end_s` when it is given and is dropped otherwise; an end without a start
+/// (a log cut at the front) opens at 0. `blackdetect` prints the whole span on one line; the other two
+/// print start and end on separate lines. Spans shorter than `min_s` are dropped.
+pub fn parse_detect_intervals(
+    log: &str,
+    filter: DetectFilter,
+    media_end_s: Option<f64>,
+    min_s: f64,
+) -> Vec<Interval> {
+    let (start_key, end_key) = filter.keys();
+    let mut out: Vec<Interval> = vec![];
+    let mut open: Option<f64> = None;
+    for line in log.lines() {
+        let start = number_after(line, start_key);
+        let end = number_after(line, end_key);
+        match (start, end) {
+            (Some(s), Some(e)) => {
+                open = None;
+                out.push(Interval { start_s: s, end_s: e });
+            }
+            (Some(s), None) => open = Some(s),
+            (None, Some(e)) => out.push(Interval {
+                start_s: open.take().unwrap_or(0.0),
+                end_s: e,
+            }),
+            (None, None) => {}
+        }
+    }
+    if let (Some(s), Some(end)) = (open, media_end_s) {
+        out.push(Interval { start_s: s, end_s: end });
+    }
+    out.retain(|iv| iv.end_s >= iv.start_s && iv.duration_s() + 1e-9 >= min_s);
+    out
+}

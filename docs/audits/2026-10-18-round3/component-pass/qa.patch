+    const ba = b.data[o + 3]! / 255;
+    const [y1, i1, q1] = yiq(blend(a.data[o]!, aa), blend(a.data[o + 1]!, aa), blend(a.data[o + 2]!, aa));
+    const [y2, i2, q2] = yiq(blend(b.data[o]!, ba), blend(b.data[o + 1]!, ba), blend(b.data[o + 2]!, ba));
+    const dy = y1 - y2;
+    const di = i1 - i2;
+    const dq = q1 - q2;
+    const delta = 0.5053 * dy * dy + 0.299 * di * di + 0.1957 * dq * dq;
+    if (delta > maxDelta) {
+      changed += 1;
+      out[o] = 255; out[o + 1] = 0; out[o + 2] = 0; out[o + 3] = 255;
+    } else {
+      const gray = Math.round(blend(y1, 0.1));
+      out[o] = out[o + 1] = out[o + 2] = gray; out[o + 3] = 255;
+    }
+  }
+  return { changed, total, changedPct: total === 0 ? 0 : (changed / total) * 100, diff: { width: a.width, height: a.height, data: out } };
+}
+
+export interface BaselineOptions extends PixelDiffOptions {
+  baselineDir: string;
+  /** Allowed changed pixels in percent. Default 0.5. */
+  tolerancePct?: number;
+  /** Where diff images of failures go. Default: no diff image written. */
+  diffDir?: string;
+  /** Write the screenshot as the new baseline instead of comparing. */
+  update?: boolean;
+}
+
+export type BaselineStatus = 'passed' | 'updated' | 'missing-baseline' | 'size-changed' | 'exceeded';
+
+export interface BaselineResult {
+  name: string;
+  status: BaselineStatus;
+  ok: boolean;
+  changedPct?: number;
+  detail?: string;
+  diffPath?: string;
+}
+
+function safeName(name: string): string {
+  if (!name || name.includes('/') || name.includes('\\') || name === '.' || name === '..') {
+    throw new RangeError(`baseline name must be a plain file name: ${JSON.stringify(name)}`);
+  }
+  return name.endsWith('.png') ? name : `${name}.png`;
+}
+
+/** Compare one screenshot (PNG bytes) with `<baselineDir>/<name>.png`. Never throws for a mismatch; returns the verdict. */
+export function compareToBaseline(name: string, png: Uint8Array, options: BaselineOptions): BaselineResult {
+  const file = safeName(name);
+  const baselinePath = path.join(options.baselineDir, file);
+  if (options.update) {
+    fs.mkdirSync(options.baselineDir, { recursive: true });
+    fs.writeFileSync(baselinePath, png);
+    return { name: file, status: 'updated', ok: true };
+  }
+  if (!fs.existsSync(baselinePath)) return { name: file, status: 'missing-baseline', ok: false, detail: 'missing baseline' };
+  const baseline = decodePng(fs.readFileSync(baselinePath));
+  const current = decodePng(png);
+  if (baseline.width !== current.width || baseline.height !== current.height) {
+    return {
+      name: file,
+      status: 'size-changed',
+      ok: false,
+      detail: `size changed ${baseline.width}x${baseline.height} -> ${current.width}x${current.height}`,
+    };
+  }
+  const result = diffImages(baseline, current, options);
+  const tolerance = options.tolerancePct ?? 0.5;
+  if (result.changedPct <= tolerance) return { name: file, status: 'passed', ok: true, changedPct: result.changedPct };
+  let diffPath: string | undefined;
+  if (options.diffDir) {
+    fs.mkdirSync(options.diffDir, { recursive: true });
+    diffPath = path.join(options.diffDir, file);
+    fs.writeFileSync(diffPath, encodePng(result.diff));
+  }
+  return { name: file, status: 'exceeded', ok: false, changedPct: result.changedPct, detail: `${result.changedPct.toFixed(3)}% changed (tolerance ${tolerance}%)`, diffPath };
+}
+
+/** Compare every `.png` in `currentDir` against the baselines of the same name. */
+export function compareDirToBaselines(currentDir: string, options: BaselineOptions): BaselineResult[] {
+  const files = fs.readdirSync(currentDir).filter((f) => f.endsWith('.png')).sort();
+  if (files.length === 0) throw new Error(`no current screenshots found in ${currentDir}`);
+  return files.map((f) => compareToBaseline(f, fs.readFileSync(path.join(currentDir, f)), options));
+}

+import { afterEach, describe, expect, it } from 'vitest';
+import { mkdtemp, readdir, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { QaBrowserSession, TimeoutError } from './index.js';
+import { mockCdp, pageResponder } from '../test/mock-cdp.js';
+
+const cleanup: (() => Promise<unknown>)[] = [];
+afterEach(async () => { for (const close of cleanup.splice(0).reverse()) await close(); });
+
+async function fixture(handler = pageResponder) {
+  const server = await mockCdp(handler); cleanup.push(server.close);
+  const browser = await QaBrowserSession.connect(server.endpoint, { timeout: 500 });
+  cleanup.push(() => browser.close().catch(() => {}));
+  const page = await browser.newPage();
+  return { server, browser, page };
+}
+
+describe('page error recorder, captureEvidence and clickUntil (rightkit#387)', () => {
+  it('pageErrors keeps exceptions and console.error and drops other console calls', async () => {
+    const { page, server } = await fixture();
+    server.emit({ method: 'Runtime.consoleAPICalled', sessionId: 'session', params: { type: 'log', args: [{ type: 'string', value: 'hello' }], timestamp: 1 } });
+    server.emit({ method: 'Runtime.consoleAPICalled', sessionId: 'session', params: { type: 'error', args: [{ type: 'string', value: 'bad' }], timestamp: 2 } });
+    server.emit({ method: 'Runtime.exceptionThrown', sessionId: 'session', params: { timestamp: 3, exceptionDetails: { text: 'Uncaught (in promise)', exception: { type: 'object', description: 'Error: rejected' } } } });
+    await page.evaluate('1');
+    expect(page.pageErrors().map((entry) => entry.text)).toEqual(['bad', 'Error: rejected']);
+    expect(() => page.assertNoPageErrors()).toThrow(/2 page error\(s\)/);
+    expect(() => page.assertNoPageErrors({ ignore: /bad|rejected/ })).not.toThrow();
+    page.clearConsoleEntries();
+    expect(() => page.assertNoPageErrors()).not.toThrow();
+  });
+
+  it('captureEvidence writes the screenshot and JSON dump and validates its arguments', async () => {
+    const { page } = await fixture((message, send) => {
+      if (message.method === 'Page.captureScreenshot') send({ id: message.id, result: { data: Buffer.from('png').toString('base64') } });
+      else pageResponder(message, send);
+    });
+    const dir = await mkdtemp(path.join(tmpdir(), 'rkqa-evidence-'));
+    cleanup.push(() => rm(dir, { recursive: true, force: true }));
+    const written = await page.captureEvidence({ directory: dir, label: 'journey', reason: 'step 3 failed', extra: () => ({ step: 3 }) });
+    expect((await readdir(dir)).length).toBeGreaterThanOrEqual(1);
+    const dump = JSON.parse(await readFile(written.json, 'utf8'));
+    expect(dump).toMatchObject({ label: 'journey', predicate: 'step 3 failed', extra: { step: 3 } });
+    await expect(page.captureEvidence({ directory: 'relative', label: 'x' })).rejects.toThrow('absolute path');
+    await expect(page.captureEvidence({ directory: dir, label: '../x' })).rejects.toThrow('label');
+  });
+
+  it('clickUntil validates its options', async () => {
+    const { page } = await fixture();
+    await expect(page.clickUntil('#go', () => true, { attempts: 0 })).rejects.toThrow('attempts');
+    await expect(page.clickUntil('#go', () => true, { intervalMs: 0 })).rejects.toThrow('intervalMs');
+  });
+
+  it('clickUntil stops after the first click when the condition already holds', async () => {
+    const { page, server } = await fixture();
+    // The default responder answers every evaluation with true, so the element resolves and the condition holds at once.
+    const clicks = await page.clickUntil('#go', () => true, { attempts: 3, intervalMs: 200 }).catch((error) => error);
+    if (typeof clicks === 'number') expect(clicks).toBe(1);
+    else expect(clicks).not.toBeInstanceOf(TimeoutError);
+    expect(server.messages.filter((message) => message.method === 'Input.dispatchMouseEvent' && message.params.type === 'mousePressed').length).toBeLessThanOrEqual(1);
+  });
+});

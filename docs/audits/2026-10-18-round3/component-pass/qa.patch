+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { compareDirToBaselines, compareToBaseline, decodePng, diffImages, encodePng, type RgbaImage } from './pixeldiff.js';
+
+const roots: string[] = [];
+function tempRoot(): string {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'rightkit-pixeldiff-'));
+  roots.push(root);
+  return root;
+}
+afterEach(() => {
+  for (const root of roots.splice(0)) fs.rmSync(root, { recursive: true, force: true });
+});
+
+function solid(width: number, height: number, rgba: [number, number, number, number]): RgbaImage {
+  const data = new Uint8Array(width * height * 4);
+  for (let i = 0; i < width * height; i += 1) data.set(rgba, i * 4);
+  return { width, height, data };
+}
+
+function withPixels(image: RgbaImage, count: number, rgba: [number, number, number, number]): RgbaImage {
+  const data = image.data.slice();
+  for (let i = 0; i < count; i += 1) data.set(rgba, i * 4);
+  return { ...image, data };
+}
+
+describe('PNG codec', () => {
+  it('round-trips RGBA', () => {
+    const image = withPixels(solid(7, 5, [10, 20, 30, 255]), 9, [200, 100, 50, 128]);
+    const back = decodePng(encodePng(image));
+    expect(back.width).toBe(7);
+    expect(back.height).toBe(5);
+    expect(Array.from(back.data)).toEqual(Array.from(image.data));
+  });
+
+  it('rejects data that is not a PNG', () => {
+    expect(() => decodePng(new Uint8Array([1, 2, 3, 4, 5, 6, 7, 8, 9]))).toThrow(/not a PNG/);
+  });
+});
+
+describe('diffImages', () => {
+  it('reports no change for equal images', () => {
+    const a = solid(10, 10, [255, 255, 255, 255]);
+    const r = diffImages(a, a);
+    expect(r.changed).toBe(0);
+    expect(r.changedPct).toBe(0);
+  });
+
+  it('counts changed pixels and marks them red in the diff image', () => {
+    const a = solid(10, 10, [255, 255, 255, 255]);
+    const b = withPixels(a, 5, [0, 0, 0, 255]);
+    const r = diffImages(a, b);
+    expect(r.changed).toBe(5);
+    expect(r.total).toBe(100);
+    expect(r.changedPct).toBe(5);
+    expect(Array.from(r.diff.data.slice(0, 4))).toEqual([255, 0, 0, 255]);
+  });
+
+  it('ignores differences below the colour threshold', () => {
+    const a = solid(4, 4, [100, 100, 100, 255]);
+    const b = solid(4, 4, [101, 100, 100, 255]);
+    expect(diffImages(a, b).changed).toBe(0);
+    expect(diffImages(a, b, { threshold: 0 }).changed).toBe(16);
+  });
+
+  it('refuses different sizes and bad thresholds', () => {
+    expect(() => diffImages(solid(2, 2, [0, 0, 0, 255]), solid(3, 2, [0, 0, 0, 255]))).toThrow(RangeError);
+    expect(() => diffImages(solid(1, 1, [0, 0, 0, 255]), solid(1, 1, [0, 0, 0, 255]), { threshold: 2 })).toThrow(RangeError);
+  });
+});
+
+describe('baselines', () => {
+  const white = solid(20, 10, [255, 255, 255, 255]);
+
+  it('update writes the baseline; an equal screenshot passes', () => {
+    const root = tempRoot();
+    const baselineDir = path.join(root, 'base');
+    const png = encodePng(white);
+    expect(compareToBaseline('home', png, { baselineDir, update: true }).status).toBe('updated');
+    expect(fs.existsSync(path.join(baselineDir, 'home.png'))).toBe(true);
+    const r = compareToBaseline('home', png, { baselineDir });
+    expect(r.ok).toBe(true);
+    expect(r.status).toBe('passed');
+  });
+
+  it('missing baseline fails', () => {
+    const r = compareToBaseline('nope', encodePng(white), { baselineDir: path.join(tempRoot(), 'b') });
+    expect(r).toMatchObject({ ok: false, status: 'missing-baseline' });
+  });
+
+  it('size change fails without a diff image', () => {
+    const root = tempRoot();
+    const baselineDir = path.join(root, 'base');
+    compareToBaseline('a', encodePng(white), { baselineDir, update: true });
+    const r = compareToBaseline('a', encodePng(solid(21, 10, [255, 255, 255, 255])), { baselineDir, diffDir: path.join(root, 'diff') });
+    expect(r.status).toBe('size-changed');
+    expect(r.detail).toContain('20x10 -> 21x10');
+  });
+
+  it('tolerance decides, and a failure writes a diff image', () => {
+    const root = tempRoot();
+    const baselineDir = path.join(root, 'base');
+    const diffDir = path.join(root, 'diff');
+    compareToBaseline('a', encodePng(white), { baselineDir, update: true });
+    const changed = encodePng(withPixels(white, 10, [0, 0, 0, 255])); // 5%
+    expect(compareToBaseline('a', changed, { baselineDir, tolerancePct: 6 }).ok).toBe(true);
+    const r = compareToBaseline('a', changed, { baselineDir, tolerancePct: 1, diffDir });
+    expect(r.status).toBe('exceeded');
+    expect(r.changedPct).toBe(5);
+    expect(r.diffPath).toBe(path.join(diffDir, 'a.png'));
+    expect(decodePng(fs.readFileSync(r.diffPath!)).width).toBe(20);
+  });
+
+  it('rejects names that escape the baseline directory', () => {
+    expect(() => compareToBaseline('../x', encodePng(white), { baselineDir: tempRoot() })).toThrow(RangeError);
+  });
+
+  it('compares a whole directory', () => {
+    const root = tempRoot();
+    const currentDir = path.join(root, 'cur');
+    fs.mkdirSync(currentDir);
+    fs.writeFileSync(path.join(currentDir, 'one.png'), encodePng(white));
+    fs.writeFileSync(path.join(currentDir, 'two.png'), encodePng(white));
+    const baselineDir = path.join(root, 'base');
+    compareToBaseline('one', encodePng(white), { baselineDir, update: true });
+    const results = compareDirToBaselines(currentDir, { baselineDir });
+    expect(results.map((r) => [r.name, r.status])).toEqual([['one.png', 'passed'], ['two.png', 'missing-baseline']]);
+    expect(() => compareDirToBaselines(path.join(root, 'base-empty-none'), { baselineDir })).toThrow();
+  });
+});

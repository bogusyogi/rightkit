+        let js = checked_js("a[x=\"y'z\"]");
+        assert!(js.contains(r#"querySelector("a[x=\"y'z\"]")"#));
+        let js = button_point_js(".rk-legal-gate", "Agree & continue");
+        assert!(js.contains(r#"".rk-legal-gate" + ' button'"#));
+        assert!(js.contains(r#"==="Agree & continue""#));
+    }
+
+    #[test]
+    fn legal_gate_defaults_match_the_component() {
+        let g = LegalGate::default();
+        assert_eq!(g.root, ".rk-legal-gate");
+        assert_eq!(g.checks.len(), 2);
+        assert!(g.checks[0].contains("value=\"individual\""));
+        assert_eq!(g.agree_label, "Agree & continue");
+        let done = gate_done_js(&g.root, &g.ready);
+        assert!(
+            done.contains(".rk-legal-gate") && done.contains("#root > *") && done.contains("&& !")
+        );
+        assert!(gate_mounted_js(&g.root, &g.ready).contains("||"));

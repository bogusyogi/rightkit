@@ -0,0 +1,244 @@
+// JavaScript client for the embedded Tauri control server (`rightkit-qa` feature `control`, QA builds only).
+//
+// The server speaks the shared rightkit-daemon convention: `<suite root>/runtime/<service>/service.json` names the
+// endpoint (a Unix socket, or a Windows named pipe), the client opens it and says `hello` as an app label on the
+// server's allowlist (`right-qa` by default), then sends bounded JSON-line requests and reads the response with the
+// same `id`. Results larger than one frame arrive in pieces (`chunked`) and are fetched with `rk.fetch`.
+//
+// This client does not launch the app: the launcher (the Rust harness, or a script) starts it with
+// `RIGHTKIT_CONTROL_SERVICE=<service>` and an isolated `RIGHTKIT_SUITE_ROOT`, and passes both here.
+// Orthic-Labs/rightkit#752. No TCP, no token. On Unix the endpoint must be owned by the current user; Node cannot read
+// the peer uid of a socket, so the Rust `Client` remains the stricter transport.
+
+import fs from 'node:fs';
+import net from 'node:net';
+import path from 'node:path';
+
+/** Largest frame either side accepts: the daemon's 16 MiB default. */
+export const CONTROL_FRAME_LIMIT = 16 * 1024 * 1024;
+export const CONTROL_PROTOCOL_MAJOR = 1;
+export const DEFAULT_CONTROL_APP = 'right-qa';
+const DEFAULT_TIMEOUT_MS = 30_000;
+
+/** An error answer from the server, or a transport failure. `code` is the server's error code when it sent one. */
+export class ControlError extends Error {
+  readonly code: string;
+  readonly retryable: boolean;
+  constructor(code: string, message: string, retryable = false) {
+    super(`control ${code}: ${message}`);
+    this.name = 'ControlError';
+    this.code = code;
+    this.retryable = retryable;
+  }
+}
+
+export interface ControlConnectOptions {
+  /** The launcher's isolated suite root (its `RIGHTKIT_SUITE_ROOT`). Default: that environment variable. */
+  suiteRoot?: string;
+  /** The service name given to the app in `RIGHTKIT_CONTROL_SERVICE` (lowercase letters, digits, dashes). Default: that environment variable. */
+  service?: string;
+  /** Allowlist label sent in `hello`. Default `right-qa`. */
+  app?: string;
+  /** Connect + hello budget, and the default per-call budget, in ms. Default 30000. */
+  timeoutMs?: number;
+}
+
+export interface ControlCallOptions {
+  timeoutMs?: number;
+  /** Receives the `event` frames of this request. */
+  onEvent?: (event: unknown) => void;
+}
+
+export interface ServiceRecordFile {
+  protocol_major: number;
+  endpoint: string;
+  pid: number;
+  role?: string;
+  service?: string;
+}
+
+/** Reads and validates `<suiteRoot>/runtime/<service>/service.json`. Throws a ControlError when it is absent or malformed. */
+export function readControlRecord(suiteRoot: string, service: string): ServiceRecordFile {
+  if (!/^[a-z0-9-]+$/.test(service)) throw new ControlError('bad_service', 'the service name must be lowercase letters, digits and dashes');
+  if (!path.isAbsolute(suiteRoot)) throw new ControlError('bad_suite', 'the suite root must be an absolute path');
+  const file = path.join(suiteRoot, 'runtime', service, 'service.json');
+  let record: Partial<ServiceRecordFile>;
+  try { record = JSON.parse(fs.readFileSync(file, 'utf8')); } catch (error) {
+    throw new ControlError('service_unavailable', `no readable ${file}: ${error instanceof Error ? error.message : String(error)}`, true);
+  }
+  if (typeof record.endpoint !== 'string' || !record.endpoint || typeof record.pid !== 'number' || typeof record.protocol_major !== 'number') throw new ControlError('service_unavailable', `${file} is not a service record`, true);
+  if (record.protocol_major !== CONTROL_PROTOCOL_MAJOR) throw new ControlError('protocol', `the server speaks protocol ${record.protocol_major}, this client ${CONTROL_PROTOCOL_MAJOR}`);
+  return record as ServiceRecordFile;
+}
+
+function assertOwnEndpoint(endpoint: string): void {
+  if (process.platform === 'win32' || typeof process.getuid !== 'function') return;
+  let stat: fs.Stats;
+  try { stat = fs.statSync(endpoint); } catch (error) { throw new ControlError('service_unavailable', `endpoint ${endpoint}: ${error instanceof Error ? error.message : String(error)}`, true); }
+  if (stat.uid !== process.getuid()) throw new ControlError('not_owner', `endpoint ${endpoint} is not owned by the current user`);
+}
+
+interface Pending {
+  resolve: (frame: Record<string, any>) => void;
+  reject: (error: Error) => void;
+  onEvent?: (event: unknown) => void;
+}
+
+/** One connection to one launched app's control server. Calls may overlap; each is matched by its id. */
+export class ControlClient {
+  private nextId = 1;
+  private buffer = '';
+  private readonly pending = new Map<number, Pending>();
+  private hello?: Pending;
+  private closedError?: Error;
+
+  private constructor(private readonly socket: net.Socket, readonly record: ServiceRecordFile, private readonly timeoutMs: number) {
+    socket.setEncoding('utf8');
+    socket.on('data', (chunk: string) => this.onData(chunk));
+    socket.on('error', (error) => this.fail(new ControlError('io', error.message, true)));
+    socket.on('close', () => this.fail(new ControlError('connection_closed', 'the control connection closed', true)));
+  }
+
+  /** Discovers the service, connects and says hello. */
+  static async connect(options: ControlConnectOptions = {}): Promise<ControlClient> {
+    const suiteRoot = options.suiteRoot ?? process.env.RIGHTKIT_SUITE_ROOT;
+    const service = options.service ?? process.env.RIGHTKIT_CONTROL_SERVICE;
+    if (!suiteRoot) throw new ControlError('bad_suite', 'no suite root: pass suiteRoot or set RIGHTKIT_SUITE_ROOT');
+    if (!service) throw new ControlError('bad_service', 'no service: pass service or set RIGHTKIT_CONTROL_SERVICE');
+    const timeoutMs = options.timeoutMs ?? DEFAULT_TIMEOUT_MS;
+    const record = readControlRecord(suiteRoot, service);
+    assertOwnEndpoint(record.endpoint);
+    const socket = await new Promise<net.Socket>((resolve, reject) => {
+      const connection = net.connect(record.endpoint);
+      const timer = setTimeout(() => { connection.destroy(); reject(new ControlError('timeout', `connecting to ${record.endpoint} took over ${timeoutMs} ms`, true)); }, timeoutMs);
+      connection.once('connect', () => { clearTimeout(timer); resolve(connection); });
+      connection.once('error', (error) => { clearTimeout(timer); reject(new ControlError('service_unavailable', `${record.endpoint}: ${error.message}`, true)); });
+    });
+    const client = new ControlClient(socket, record, timeoutMs);
+    try { await client.sayHello(options.app ?? DEFAULT_CONTROL_APP); } catch (error) { client.close(); throw error; }
+    return client;
+  }
+
+  /** The server's hello answer: the methods this app may call and the frame/chunk limits. */
+  helloInfo?: Record<string, any>;
+
+  private sayHello(app: string): Promise<void> {
+    return new Promise<void>((resolve, reject) => {
+      const timer = setTimeout(() => reject(new ControlError('timeout', `hello took over ${this.timeoutMs} ms`, true)), this.timeoutMs);
+      this.hello = {
+        resolve: (frame) => {
+          clearTimeout(timer);
+          if (frame.ok !== true) reject(controlErrorFrom(frame.error));
+          else { this.helloInfo = frame; resolve(); }
+        },
+        reject: (error) => { clearTimeout(timer); reject(error); },
+      };
+      this.write({ type: 'hello', app, protocol_major: CONTROL_PROTOCOL_MAJOR });
+    });
+  }
+
+  private write(frame: unknown): void {
+    if (this.closedError) throw this.closedError;
+    const line = JSON.stringify(frame);
+    if (Buffer.byteLength(line) > CONTROL_FRAME_LIMIT) throw new ControlError('request_too_large', 'the request exceeds the 16 MiB frame limit');
+    this.socket.write(`${line}\n`);
+  }
+
+  private onData(chunk: string): void {
+    this.buffer += chunk;
+    if (this.buffer.length > CONTROL_FRAME_LIMIT * 2 && !this.buffer.includes('\n')) { this.fail(new ControlError('response_too_large', 'a reply frame exceeds the 16 MiB limit')); this.socket.destroy(); return; }
+    for (let newline = this.buffer.indexOf('\n'); newline >= 0; newline = this.buffer.indexOf('\n')) {
+      const line = this.buffer.slice(0, newline);
+      this.buffer = this.buffer.slice(newline + 1);
+      if (!line.trim()) continue;
+      let frame: Record<string, any>;
+      try { frame = JSON.parse(line); } catch { continue; }
+      this.dispatch(frame);
+    }
+  }
+
+  private dispatch(frame: Record<string, any>): void {
+    if (frame.type === 'hello') {
+      const hello = this.hello; this.hello = undefined; hello?.resolve(frame); return;
+    }
+    if (typeof frame.id !== 'number') return;
+    const pending = this.pending.get(frame.id);
+    if (!pending) return;
+    if (frame.type === 'event') { try { pending.onEvent?.(frame.event); } catch { /* a listener's failure is its own */ } return; }
+    if (frame.type === 'response') { this.pending.delete(frame.id); pending.resolve(frame); }
+  }
+
+  private fail(error: Error): void {
+    if (this.closedError) return;
+    this.closedError = error;
+    const hello = this.hello; this.hello = undefined; hello?.reject(error);
+    for (const pending of this.pending.values()) pending.reject(error);
+    this.pending.clear();
+  }
+
+  private request(method: string, params: unknown, options: ControlCallOptions, chunkedOk: boolean): Promise<Record<string, any>> {
+    if (this.closedError) return Promise.reject(this.closedError);
+    const id = this.nextId++;
+    const timeoutMs = options.timeoutMs ?? this.timeoutMs;
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => { this.pending.delete(id); reject(new ControlError('timeout', `request ${method} took over ${timeoutMs} ms`, true)); }, timeoutMs);
+      this.pending.set(id, {
+        resolve: (frame) => { clearTimeout(timer); if (frame.ok === true) resolve(frame); else reject(controlErrorFrom(frame.error)); },
+        reject: (error) => { clearTimeout(timer); reject(error); },
+        onEvent: options.onEvent,
+      });
+      try { this.write({ type: 'request', id, method, params: params ?? {}, ...(chunkedOk ? { chunked_ok: true } : {}) }); } catch (error) {
+        clearTimeout(timer); this.pending.delete(id); reject(error as Error);
+      }
+    });
+  }
+
+  /** Calls one control method (`eval`, `click`, `screenshot`, ...) and resolves its result. */
+  async call<T = any>(method: string, params: unknown = {}, options: ControlCallOptions = {}): Promise<T> {
+    const maxMessage = Number(this.helloInfo?.max_message ?? 0);
+    const frame = await this.request(method, params, options, maxMessage > 0);
+    if (frame.chunked) return (await this.assemble(frame.chunked, options)) as T;
+    return frame.result as T;
+  }
+
+  private async assemble(held: { id?: unknown; bytes?: unknown; count?: unknown }, options: ControlCallOptions): Promise<unknown> {
+    const bytes = Number(held.bytes), count = Number(held.count);
+    if (typeof held.id !== 'string' || !Number.isInteger(bytes) || !Number.isInteger(count) || count < 0) throw new ControlError('bad_chunk', 'the chunked result is malformed');
+    let joined = '';
+    for (let seq = 0; seq < count; seq += 1) {
+      const piece = await this.request('rk.fetch', { id: held.id, seq }, options, false);
+      const text = piece.result?.text;
+      if (typeof text !== 'string') throw new ControlError('bad_chunk', 'a result piece has no text');
+      joined += text;
+      if (Buffer.byteLength(joined) > bytes) throw new ControlError('bad_chunk', 'the result pieces add up to more than announced');
+    }
+    if (Buffer.byteLength(joined) !== bytes) throw new ControlError('bad_chunk', 'the result pieces add up to less than announced');
+    return JSON.parse(joined);
+  }
+
+  health(): Promise<any> { return this.call('health'); }
+  /** Evaluates JavaScript in the app's webview (`eval`). */
+  evaluate<T = any>(js: string): Promise<T> { return this.call<T>('eval', { js }); }
+  dom(params: Record<string, unknown> = {}): Promise<any> { return this.call('dom', params); }
+  ax(params: Record<string, unknown> = {}): Promise<any> { return this.call('ax', params); }
+  screenshot(params: Record<string, unknown> = {}): Promise<any> { return this.call('screenshot', params); }
+  click(params: Record<string, unknown>): Promise<any> { return this.call('click', params); }
+  type(params: Record<string, unknown>): Promise<any> { return this.call('type', params); }
+  key(params: Record<string, unknown>): Promise<any> { return this.call('key', params); }
+
+  close(): void {
+    this.fail(new ControlError('connection_closed', 'the client closed the connection'));
+    this.socket.destroy();
+  }
+}
+
+function controlErrorFrom(error: unknown): ControlError {
+  const value = (error ?? {}) as { code?: unknown; message?: unknown; retryable?: unknown };
+  return new ControlError(typeof value.code === 'string' ? value.code : 'error', typeof value.message === 'string' ? value.message : 'the server refused the request', value.retryable === true);
+}
+
+/** Connect, run `body`, and always close. */
+export async function withControl<T>(options: ControlConnectOptions, body: (client: ControlClient) => Promise<T>): Promise<T> {
+  const client = await ControlClient.connect(options);
+  try { return await body(client); } finally { client.close(); }
+}

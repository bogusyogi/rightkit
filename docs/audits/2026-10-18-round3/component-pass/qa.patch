diff --git a/crates/rightkit-qa/src/crawl.rs b/crates/rightkit-qa/src/crawl.rs
new file mode 100644
index 0000000..a17ae51
--- /dev/null
+++ b/crates/rightkit-qa/src/crawl.rs
@@ -0,0 +1,487 @@
+//! Control crawler, interaction inventory and cross-platform parity report
+//! (Orthic-Labs/rightkit#427; lifted from Pulse's `qa-e2e` `CRAWL_JS` / `write_inventory` and its
+//! `compare.mjs`).
+//!
+//! * [`CRAWL_JS`] is a `Control::eval` body that lists every interactive control of the page the app
+//!   shows now: role, accessible name, tag, id, enabled and visible state, focusability and box.
+//! * [`crawl_section`] runs it on a [`Control`] and returns a [`SectionInventory`]; an [`Inventory`] is
+//!   the sections of one app on one platform, written to JSON by [`Inventory::write`].
+//! * [`compare_inventories`] compares the inventory of one platform with another's (a macOS run
+//!   against a Windows run of the same app) and reports controls only one side has and controls whose
+//!   state differs, as a [`ParityReport`] with a pass/fail verdict and a Markdown rendering.
+//!
+//! The same JSON shape is produced by `@rightkit/qa` (`crawlControls`, `compareInventories`), so a
+//! Rust run on one host and a Node run on the other compare directly.
+use crate::control::Control;
+use crate::util::{err, Result};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+use std::path::Path;
+
+/// Schema version of the inventory JSON.
+pub const INVENTORY_SCHEMA: u32 = 1;
+
+/// A `Control::eval` function body returning the page's interactive controls, in document order, as
+/// `{url, title, controls: [{key, role, name, tag, id, type, href, disabled, visible, focusable,
+/// box: [x, y, w, h]}]}`. Read-only; it changes nothing in the page.
+pub const CRAWL_JS: &str = r#"
+var SEL = 'a[href],button,input:not([type=hidden]),select,textarea,summary,[role=button],[role=link],[role=tab],[role=menuitem],[role=menuitemcheckbox],[role=menuitemradio],[role=checkbox],[role=radio],[role=switch],[role=combobox],[role=slider],[role=option],[tabindex]:not([tabindex="-1"])';
+var ROLES = {A:'link',BUTTON:'button',SELECT:'combobox',TEXTAREA:'textbox',SUMMARY:'button'};
+var INPUT_ROLES = {checkbox:'checkbox',radio:'radio',range:'slider',button:'button',submit:'button',reset:'button',number:'spinbutton',search:'searchbox'};
+function roleOf(e) {
+  var r = e.getAttribute('role');
+  if (r) return r.trim().split(/\s+/)[0];
+  if (e.tagName === 'INPUT') return INPUT_ROLES[e.type] || 'textbox';
+  return ROLES[e.tagName] || null;
+}
+function nameOf(e) {
+  var ids = e.getAttribute('aria-labelledby');
+  var labelled = ids ? ids.split(/\s+/).map(function (i) { var n = document.getElementById(i); return n ? n.textContent : ''; }).join(' ') : '';
+  var labels = e.labels && e.labels.length ? Array.prototype.map.call(e.labels, function (l) { return l.innerText; }).join(' ') : '';
+  return (e.getAttribute('aria-label') || labelled || labels || e.innerText || e.value || e.getAttribute('title') || e.getAttribute('placeholder') || '').replace(/\s+/g, ' ').trim().slice(0, 120);
+}
+function visibleOf(e) {
+  for (var p = e; p; p = p.parentElement) {
+    var s = getComputedStyle(p);
+    if (s.display === 'none' || s.visibility === 'hidden' || s.visibility === 'collapse') return false;
+  }
+  var r = e.getBoundingClientRect();
+  return r.width > 0 && r.height > 0;
+}
+var out = [];
+Array.prototype.forEach.call(document.querySelectorAll(SEL), function (e) {
+  var r = e.getBoundingClientRect();
+  var role = roleOf(e);
+  var name = nameOf(e);
+  var disabled = !!e.disabled || e.getAttribute('aria-disabled') === 'true' || !!e.closest('fieldset[disabled]');
+  out.push({
+    key: (role || e.tagName.toLowerCase()) + ':' + name,
+    role: role, name: name, tag: e.tagName.toLowerCase(), id: e.id || null,
+    type: e.type || null, href: e.tagName === 'A' ? (e.getAttribute('href') || null) : null,
+    disabled: disabled, visible: visibleOf(e),
+    focusable: !disabled && (e.tabIndex >= 0),
+    box: [Math.round(r.left), Math.round(r.top), Math.round(r.width), Math.round(r.height)]
+  });
+});
+return {url: location.href, title: document.title, controls: out};
+"#;
+
+/// One interactive control.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ControlEntry {
+    /// `<role or tag>:<accessible name>`, the identity the parity report matches on. Several controls
+    /// with the same key are matched by their order of appearance.
+    pub key: String,
+    pub role: Option<String>,
+    pub name: String,
+    pub tag: String,
+    #[serde(default)]
+    pub id: Option<String>,
+    #[serde(default, rename = "type")]
+    pub input_type: Option<String>,
+    #[serde(default)]
+    pub href: Option<String>,
+    pub disabled: bool,
+    pub visible: bool,
+    pub focusable: bool,
+    /// `[x, y, width, height]` in viewport CSS pixels. Compared by neither side of a parity run
+    /// (window sizes and platform metrics differ); kept as evidence.
+    #[serde(rename = "box")]
+    pub rect: [i64; 4],
+}
+
+/// The controls of one screen or section of the app.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct SectionInventory {
+    /// The caller's name for the section (`"settings/general"`).
+    pub id: String,
+    pub url: String,
+    pub title: String,
+    pub controls: Vec<ControlEntry>,
+}
+
+/// The inventory of one app on one platform.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Inventory {
+    pub schema: u32,
+    pub app: String,
+    /// `macos`, `windows`, `linux`: what the parity report calls this side.
+    pub platform: String,
+    pub sections: Vec<SectionInventory>,
+}
+
+impl Inventory {
+    pub fn new(app: &str, platform: &str) -> Self {
+        Inventory {
+            schema: INVENTORY_SCHEMA,
+            app: app.into(),
+            platform: platform.into(),
+            sections: vec![],
+        }
+    }
+
+    /// Add a section; a second section with the same id replaces the first.
+    pub fn push(&mut self, section: SectionInventory) {
+        self.sections.retain(|s| s.id != section.id);
+        self.sections.push(section);
+    }
+
+    /// Total controls over all sections.
+    pub fn control_count(&self) -> usize {
+        self.sections.iter().map(|s| s.controls.len()).sum()
+    }
+
+    /// Parse an inventory from JSON text, refusing another schema.
+    pub fn parse(text: &str) -> Result<Self> {
+        let inv: Inventory = serde_json::from_str(text)?;
+        if inv.schema != INVENTORY_SCHEMA {
+            return err(format!(
+                "inventory schema {} is not supported (this crate reads {INVENTORY_SCHEMA})",
+                inv.schema
+            ));
+        }
+        Ok(inv)
+    }
+
+    /// Read an inventory file.
+    pub fn read(path: &Path) -> Result<Self> {
+        Self::parse(&std::fs::read_to_string(path)?)
+    }
+
+    /// Write the inventory as pretty JSON (parent directories created).
+    pub fn write(&self, path: &Path) -> Result<()> {
+        if let Some(dir) = path.parent() {
+            std::fs::create_dir_all(dir)?;
+        }
+        std::fs::write(path, serde_json::to_vec_pretty(self)?)?;
+        Ok(())
+    }
+}
+
+/// Turn the value [`CRAWL_JS`] returns into a section.
+pub fn section_from_value(id: &str, value: &Value) -> Result<SectionInventory> {
+    let controls = value
+        .get("controls")
+        .cloned()
+        .ok_or_else(|| crate::util::Error("the crawl result has no `controls`".into()))?;
+    Ok(SectionInventory {
+        id: id.into(),
+        url: value["url"].as_str().unwrap_or_default().into(),
+        title: value["title"].as_str().unwrap_or_default().into(),
+        controls: serde_json::from_value(controls)?,
+    })
+}
+
+/// Crawl the page the app shows now. Read-only.
+pub fn crawl_section(control: &Control, id: &str) -> Result<SectionInventory> {
+    section_from_value(id, &control.eval(CRAWL_JS)?)
+}
+
+/// One difference between two sides of a parity run.
+#[derive(Debug, Clone, PartialEq, Serialize)]
+pub struct ParityDifference {
+    pub section: String,
+    pub key: String,
+    /// `only_in_a`, `only_in_b`, `state`, or `section_missing_in_a` / `section_missing_in_b`.
+    pub kind: String,
+    /// What differs, for a `state` difference (`disabled: false vs true`).
+    pub detail: String,
+}
+
+/// The result of [`compare_inventories`].
+#[derive(Debug, Clone, PartialEq, Serialize)]
+pub struct ParityReport {
+    pub a: String,
+    pub b: String,
+    pub sections_compared: usize,
+    pub controls_compared: usize,
+    pub differences: Vec<ParityDifference>,
+}
+
+impl ParityReport {
+    /// No differences.
+    pub fn is_pass(&self) -> bool {
+        self.differences.is_empty()
+    }
+
+    /// `PASS` or `FAIL`.
+    pub fn verdict(&self) -> &'static str {
+        if self.is_pass() {
+            "PASS"
+        } else {
+            "FAIL"
+        }
+    }
+
+    /// The report as Markdown: a verdict line and a table of differences.
+    pub fn to_markdown(&self) -> String {
+        let mut out = format!(
+            "# Parity {} vs {}: {}\n\n{} section(s), {} control(s) compared, {} difference(s).\n",
+            self.a,
+            self.b,
+            self.verdict(),
+            self.sections_compared,
+            self.controls_compared,
+            self.differences.len()
+        );
+        if !self.differences.is_empty() {
+            out.push_str("\n| Section | Control | Kind | Detail |\n|---|---|---|---|\n");
+            for d in &self.differences {
+                out.push_str(&format!(
+                    "| {} | {} | {} | {} |\n",
+                    cell(&d.section),
+                    cell(&d.key),
+                    d.kind,
+                    cell(&d.detail)
+                ));
+            }
+        }
+        out
+    }
+}
+
+fn cell(text: &str) -> String {
+    text.replace('|', "\\|").replace('\n', " ")
+}
+
+/// Options of [`compare_inventories`].
+#[derive(Debug, Clone)]
+pub struct ParityOptions {
+    /// Controls whose `key` contains one of these are ignored on both sides (platform-only chrome,
+    /// such as a Windows title-bar button).
+    pub ignore_keys: Vec<String>,
+    /// Compare the `focusable` state too. Default `true`.
+    pub compare_focusable: bool,
+}
+
+impl Default for ParityOptions {
+    fn default() -> Self {
+        ParityOptions {
+            ignore_keys: vec![],
+            compare_focusable: true,
+        }
+    }
+}
+
+/// Compare the inventory of one platform (`a`) with another's (`b`). Sections match by id and controls
+/// by `key`, in order of appearance when several share a key. A control only one side lists, a section
+/// only one side crawled, and a difference in `disabled`, `visible` or (optionally) `focusable` are
+/// differences; positions, sizes and ids are not compared.
+pub fn compare_inventories(a: &Inventory, b: &Inventory, options: &ParityOptions) -> ParityReport {
+    let mut report = ParityReport {
+        a: a.platform.clone(),
+        b: b.platform.clone(),
+        sections_compared: 0,
+        controls_compared: 0,
+        differences: vec![],
+    };
+    let ignored = |key: &str| options.ignore_keys.iter().any(|i| key.contains(i.as_str()));
+    let mut ids: Vec<&str> = a.sections.iter().map(|s| s.id.as_str()).collect();
+    for s in &b.sections {
+        if !ids.contains(&s.id.as_str()) {
+            ids.push(&s.id);
+        }
+    }
+    for id in ids {
+        let (sa, sb) = (
+            a.sections.iter().find(|s| s.id == id),
+            b.sections.iter().find(|s| s.id == id),
+        );
+        let (sa, sb) = match (sa, sb) {
+            (Some(x), Some(y)) => (x, y),
+            (Some(_), None) => {
+                report.differences.push(diff(id, "", "section_missing_in_b", ""));
+                continue;
+            }
+            (None, Some(_)) => {
+                report.differences.push(diff(id, "", "section_missing_in_a", ""));
+                continue;
+            }
+            (None, None) => continue,
+        };
+        report.sections_compared += 1;
+        let group = |s: &SectionInventory| {
+            let mut m: BTreeMap<String, Vec<&ControlEntry>> = BTreeMap::new();
+            for c in s.controls.iter().filter(|c| !ignored(&c.key)) {
+                m.entry(c.key.clone()).or_default().push(c);
+            }
+            m
+        };
+        let (ga, gb) = (group(sa), group(sb));
+        let mut keys: Vec<&String> = ga.keys().collect();
+        for k in gb.keys() {
+            if !ga.contains_key(k) {
+                keys.push(k);
+            }
+        }
+        keys.sort();
+        for key in keys {
+            let empty = vec![];
+            let (la, lb) = (ga.get(key).unwrap_or(&empty), gb.get(key).unwrap_or(&empty));
+            for i in 0..la.len().max(lb.len()) {
+                let label = if la.len().max(lb.len()) > 1 {
+                    format!("{key} #{}", i + 1)
+                } else {
+                    key.clone()
+                };
+                match (la.get(i), lb.get(i)) {
+                    (Some(x), Some(y)) => {
+                        report.controls_compared += 1;
+                        let mut parts = vec![];
+                        if x.disabled != y.disabled {
+                            parts.push(format!("disabled: {} vs {}", x.disabled, y.disabled));
+                        }
+                        if x.visible != y.visible {
+                            parts.push(format!("visible: {} vs {}", x.visible, y.visible));
+                        }
+                        if options.compare_focusable && x.focusable != y.focusable {
+                            parts.push(format!("focusable: {} vs {}", x.focusable, y.focusable));
+                        }
+                        if !parts.is_empty() {
+                            report
+                                .differences
+                                .push(diff(id, &label, "state", &parts.join("; ")));
+                        }
+                    }
+                    (Some(_), None) => report.differences.push(diff(id, &label, "only_in_a", "")),
+                    (None, Some(_)) => report.differences.push(diff(id, &label, "only_in_b", "")),
+                    (None, None) => {}
+                }
+            }
+        }
+    }
+    report
+}
+
+fn diff(section: &str, key: &str, kind: &str, detail: &str) -> ParityDifference {
+    ParityDifference {
+        section: section.into(),
+        key: key.into(),
+        kind: kind.into(),
+        detail: detail.into(),
+    }
+}
+
+/// The `{section: control count}` summary of an inventory, for a run report.
+pub fn summary(inv: &Inventory) -> Value {
+    let mut m = serde_json::Map::new();
+    for s in &inv.sections {
+        m.insert(s.id.clone(), json!(s.controls.len()));
+    }
+    json!({"app": inv.app, "platform": inv.platform, "sections": m, "controls": inv.control_count()})
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn control(role: &str, name: &str, disabled: bool) -> ControlEntry {
+        ControlEntry {
+            key: format!("{role}:{name}"),
+            role: Some(role.into()),
+            name: name.into(),
+            tag: "button".into(),
+            id: None,
+            input_type: None,
+            href: None,
+            disabled,
+            visible: true,
+            focusable: !disabled,
+            rect: [0, 0, 10, 10],
+        }
+    }
+
+    fn inv(platform: &str, controls: Vec<ControlEntry>) -> Inventory {
+        let mut i = Inventory::new("demo", platform);
+        i.push(SectionInventory {
+            id: "home".into(),
+            url: "app://home".into(),
+            title: "Home".into(),
+            controls,
+        });
+        i
+    }
+
+    #[test]
+    fn crawl_script_is_a_function_body_that_returns_the_inventory_shape() {
+        assert!(CRAWL_JS.trim_end().ends_with("controls: out};"));
+        for needle in ["querySelectorAll(SEL)", "aria-labelledby", "focusable", "box:"] {
+            assert!(CRAWL_JS.contains(needle), "{needle}");
+        }
+    }
+
+    #[test]
+    fn a_crawl_value_becomes_a_section() {
+        let value = json!({
+            "url": "app://x", "title": "X",
+            "controls": [{"key": "button:Save", "role": "button", "name": "Save", "tag": "button",
+                          "id": null, "type": "submit", "href": null, "disabled": false,
+                          "visible": true, "focusable": true, "box": [1, 2, 3, 4]}]
+        });
+        let s = section_from_value("main", &value).unwrap();
+        assert_eq!(s.controls[0].key, "button:Save");
+        assert_eq!(s.controls[0].rect, [1, 2, 3, 4]);
+        assert_eq!(s.controls[0].input_type.as_deref(), Some("submit"));
+        assert!(section_from_value("main", &json!({})).is_err());
+    }
+
+    #[test]
+    fn identical_inventories_pass() {
+        let a = inv("macos", vec![control("button", "Save", false), control("link", "Help", false)]);
+        let b = inv("windows", vec![control("link", "Help", false), control("button", "Save", false)]);
+        let r = compare_inventories(&a, &b, &ParityOptions::default());
+        assert!(r.is_pass(), "{r:?}");
+        assert_eq!(r.controls_compared, 2);
+        assert_eq!(r.verdict(), "PASS");
+    }
+
+    #[test]
+    fn missing_controls_and_state_differences_fail_with_a_table() {
+        let a = inv("macos", vec![control("button", "Save", false), control("button", "Mac only", false)]);
+        let b = inv("windows", vec![control("button", "Save", true), control("button", "Win | only", false)]);
+        let r = compare_inventories(&a, &b, &ParityOptions::default());
+        let kinds: Vec<&str> = r.differences.iter().map(|d| d.kind.as_str()).collect();
+        assert!(kinds.contains(&"state") && kinds.contains(&"only_in_a") && kinds.contains(&"only_in_b"), "{kinds:?}");
+        let md = r.to_markdown();
+        assert!(md.starts_with("# Parity macos vs windows: FAIL"));
+        assert!(md.contains("disabled: false vs true"));
+        assert!(md.contains("Win \\| only"), "pipes are escaped in cells");
+    }
+
+    #[test]
+    fn duplicates_match_in_order_and_ignores_apply() {
+        let a = inv("macos", vec![control("button", "OK", false), control("button", "OK", false), control("button", "Chrome", false)]);
+        let b = inv("windows", vec![control("button", "OK", false)]);
+        let mut o = ParityOptions::default();
+        o.ignore_keys.push("Chrome".into());
+        let r = compare_inventories(&a, &b, &o);
+        assert_eq!(r.differences.len(), 1);
+        assert_eq!(r.differences[0].key, "button:OK #2");
+        assert_eq!(r.differences[0].kind, "only_in_a");
+    }
+
+    #[test]
+    fn a_section_only_one_side_crawled_is_reported() {
+        let a = inv("macos", vec![]);
+        let mut b = inv("windows", vec![]);
+        b.push(SectionInventory { id: "extra".into(), url: String::new(), title: String::new(), controls: vec![] });
+        let r = compare_inventories(&a, &b, &ParityOptions::default());
+        assert_eq!(r.differences.len(), 1);
+        assert_eq!(r.differences[0].kind, "section_missing_in_a");
+    }
+
+    #[test]
+    fn inventories_round_trip_and_refuse_another_schema() {
+        let a = inv("macos", vec![control("button", "Save", false)]);
+        let dir = std::env::temp_dir().join(format!("rkqa-crawl-{}", crate::util::new_id()));
+        let path = dir.join("nested").join("inv.json");
+        a.write(&path).unwrap();
+        assert_eq!(Inventory::read(&path).unwrap(), a);
+        let mut other = serde_json::to_value(&a).unwrap();
+        other["schema"] = json!(99);
+        assert!(Inventory::parse(&other.to_string()).is_err());
+        assert_eq!(summary(&a)["controls"], 1);
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}

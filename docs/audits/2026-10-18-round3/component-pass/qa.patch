+/// The sliding window a [`loudness_series`] point is measured over.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SeriesWindow {
+    /// 400 ms (EBU momentary loudness).
+    Momentary,
+    /// 3 s (EBU short-term loudness).
+    ShortTerm,
+}
+
+impl SeriesWindow {
+    fn hops(self) -> usize {
+        match self {
+            SeriesWindow::Momentary => 4,
+            SeriesWindow::ShortTerm => 30,
+        }
+    }
+}
+
+/// Loudness of one window of a [`loudness_series`]: the window starts at `start_s` and ends at `end_s`.
+#[derive(Debug, Clone, Copy, PartialEq, Serialize)]
+pub struct LoudnessPoint {
+    pub start_s: f64,
+    pub end_s: f64,
+    pub lufs: f64,
+}
+
+/// Momentary (400 ms) or short-term (3 s) loudness over time, one point per 100 ms step, ungated
+/// (BS.1770 K-weighting; the same filter and channel weights as [`measure`]). Empty when the signal
+/// is shorter than one window. A silent window reads about -300 LUFS, not `None`.
+pub fn loudness_series(pcm: &Pcm, window: SeriesWindow) -> Vec<LoudnessPoint> {
+    let ch = pcm.channels.max(1) as usize;
+    let rate = pcm.sample_rate as f64;
+    let frames = pcm.samples.len() / ch;
+    let hop = ((rate * 0.1).round() as usize).max(1);
+    let hops = frames / hop;
+    let n = window.hops();
+    if hops < n {
+        return vec![];
+    }
+    let mut hop_energy = vec![0f64; hops];
+    for (c, &w) in channel_weights(ch).iter().enumerate() {
+        let mut k = KWeighting::new(rate);
+        for i in 0..frames {
+            let y = k.process(pcm.samples[i * ch + c] as f64);
+            let h = i / hop;
+            if h < hops {
+                hop_energy[h] += w * y * y;
+            }
+        }
+    }
+    let hop_s = hop as f64 / rate;
+    (0..=hops - n)
+        .map(|s| {
+            let mean = hop_energy[s..s + n].iter().sum::<f64>() / (n * hop) as f64;
+            LoudnessPoint {
+                start_s: s as f64 * hop_s,
+                end_s: (s + n) as f64 * hop_s,
+                lufs: -0.691 + 10.0 * mean.max(1e-30).log10(),
+            }
+        })
+        .collect()
+}
+
+/// Spans of `series` whose loudness is outside `[min_lufs, max_lufs]`, merged when windows touch
+/// or overlap and kept when at least `min_s` long. Use it to find where narration drifts from a target.
+pub fn loudness_outside(
+    series: &[LoudnessPoint],
+    min_lufs: f64,
+    max_lufs: f64,
+    min_s: f64,
+) -> Vec<crate::media::Interval> {
+    let mut out: Vec<crate::media::Interval> = vec![];
+    for point in series.iter().filter(|p| p.lufs < min_lufs || p.lufs > max_lufs) {
+        match out.last_mut() {
+            Some(last) if point.start_s <= last.end_s + 1e-9 => last.end_s = last.end_s.max(point.end_s),
+            _ => out.push(crate::media::Interval {
+                start_s: point.start_s,
+                end_s: point.end_s,
+            }),
+        }
+    }
+    out.retain(|iv| iv.duration_s() + 1e-9 >= min_s);
+    out
+}

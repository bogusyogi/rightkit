index 0000000..cd73af3
--- /dev/null
+++ b/packages/qa/test/dialog.test.mjs
@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { qaDialogAnswer } from '../dist/dialog.js';
+
+test('disabled QA never reads the seam', () => {
+  const target = { get __RIGHTKIT_QA_DIALOG__() { throw new Error('must not read'); } };
+  assert.equal(qaDialogAnswer(false, target), undefined);
+});
+
+test('absent, cancellation, file, files & clear retain distinct meanings', () => {
+  const target = {};
+  assert.equal(qaDialogAnswer(true, target), undefined);
+  for (const answer of [null, 'clip.mp4', ['one.mp4', 'two.mp4'], []]) {
+    target.__RIGHTKIT_QA_DIALOG__ = answer;
+    assert.deepEqual(qaDialogAnswer(true, target), answer);
+    assert.deepEqual(qaDialogAnswer(true, target), answer, 'persistent until changed');
+  }
+  delete target.__RIGHTKIT_QA_DIALOG__;
+  assert.equal(qaDialogAnswer(true, target), undefined);
+});
+
+test('invalid injected answers fail without opening OS dialogs', () => {
+  for (const answer of [false, 1, {}, ['ok', 3]]) {
+    assert.throws(() => qaDialogAnswer(true, { __RIGHTKIT_QA_DIALOG__: answer }), TypeError);
+  }
+  const paths = ['clip.mp4'];
+  qaDialogAnswer(true, { __RIGHTKIT_QA_DIALOG__: paths }).push('other.mp4');
+  assert.deepEqual(paths, ['clip.mp4']);
+});

+//! Scriptable fake CLI: `rightkit-fake-cli [--fake-cli-script <file>] <args...>`. See `rightkit_qa::fake_cli`.
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    std::process::exit(rightkit_qa::fake_cli::run(&args));
+}

+//! Scriptable fake command-line process for app tests: fake a model CLI (Claude Code, Codex) or an editor
+//! engine from a JSON or TOML script instead of writing a bespoke fake per app.
+//!
+//! Two ways in:
+//!
+//! - The binary `rightkit-fake-cli` (`src/bin/rightkit-fake-cli.rs`): point the app's "tool path" setting at
+//!   it. The script comes from `--fake-cli-script <file>` (leading arguments, removed before matching) or
+//!   from the environment variable `RIGHTKIT_FAKE_CLI_SCRIPT`.
+//! - The library: [`run`] from your own multiplexing test binary (as PostRight's `mock-platform` does), or
+//!   [`decide`] / [`perform`] to get the [`Response`] and post-process it (for example, derive an envelope
+//!   from the input file's contents).
+//!
+//! # Script
+//!
+//! ```json
+//! {
+//!   "rules": [
+//!     { "when": { "env_eq": { "FAKE_MODE": "fail" } },
+//!       "respond": { "stderr": "boom\n", "exit": 2 } },
+//!     { "when": { "argv_first": "-p", "stdin_contains": "hello" },
+//!       "respond": { "stdout_json": { "result": "got ${stdin_bytes} bytes" } } }
+//!   ],
+//!   "default": { "stdout": "ok\n" }
+//! }
+//! ```
+//!
+//! Rules are tried in order; the first whose `when` matches (every present key must hold, an empty `when`
+//! always matches) supplies the response; otherwise `default`; otherwise exit 0 with no output.
+//!
+//! `when` keys: `argv_first` (first argument equals), `argv_prefix` (list), `argv_contains` (list, each an
+//! exact argument), `argv_absent` (list, none present), `argv_text_contains` (substring of any argument),
+//! `stdin_contains`, `stdin_equals`, `stdin_empty` (bool), `env_eq` (name to value; an unset variable never
+//! matches), `env_set` / `env_unset` (lists of names), `call` (0-based invocation number, needs `state_file`).
+//!
+//! `respond` keys, applied in this order: `expect_stdin` (`{contains|equals}`; a mismatch prints a message
+//! on stderr and exits 64 with nothing else done), `delay_ms`, `write_files` (list of `{path, content}`,
+//! parents created), `stderr`, `stdout`, `stdout_json` (a JSON value whose string leaves are templated,
+//! printed as one line), `chunks` (list of `{stream: "stdout"|"stderr", text, delay_ms}` written and flushed
+//! in order, to fake streaming output), `spawn_child` (`{heartbeat, lifetime_secs}`: start a grandchild that
+//! appends a byte to the file every 50 ms and wait until it has written the first), `hang` (`true` or
+//! seconds; default one hour), and finally exit with `exit` (default 0).
+//!
+//! Top-level keys besides `rules` and `default`: `read_stdin` (default true; false never reads stdin),
+//! `record` (path appended with one JSON line per invocation: argv, stdin, matched rule index, call;
+//! templated) and `state_file` (a counter file for `call`; `${env:NAME}` allowed).
+//!
+//! Templates (`${...}` in strings, paths and JSON leaves; `$$` is a literal `$`): `${stdin}`,
+//! `${stdin_bytes}`, `${argv:N}`, `${argv_all}`, `${arg:--flag}` (the argument after a flag),
+//! `${argv_prompt}` (`present` when the trimmed stdin text appears inside some argument, else `absent`),
+//! `${env:NAME}` (empty when unset) and `${env_present:NAME}` (`present` or `absent`). Unknown names stay
+//! literal.
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::io::{Read, Write};
+use std::path::Path;
+use std::process::{Command, Stdio};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use serde::Deserialize;
+use serde_json::Value;
+
+/// Environment variable naming the script when `--fake-cli-script` is not given.
+pub const SCRIPT_ENV: &str = "RIGHTKIT_FAKE_CLI_SCRIPT";
+/// Leading argument naming the script file.
+pub const SCRIPT_ARG: &str = "--fake-cli-script";
+const HEARTBEAT_ARG: &str = "--fake-cli-heartbeat-child";
+const HANG_DEFAULT_SECS: u64 = 3600;
+/// Exit code for a usage, script or `expect_stdin` failure of the fake itself.
+pub const FAKE_FAILURE_EXIT: i32 = 64;
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Script {
+    #[serde(default)]
+    pub rules: Vec<Rule>,
+    #[serde(default)]
+    pub default: Option<Response>,
+    #[serde(default = "yes")]
+    pub read_stdin: bool,
+    #[serde(default)]
+    pub record: Option<String>,
+    #[serde(default)]
+    pub state_file: Option<String>,
+}
+
+fn yes() -> bool {
+    true
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Rule {
+    #[serde(default)]
+    pub when: When,
+    pub respond: Response,
+}
+
+#[derive(Debug, Clone, Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct When {
+    pub argv_first: Option<String>,
+    #[serde(default)]
+    pub argv_prefix: Vec<String>,
+    #[serde(default)]
+    pub argv_contains: Vec<String>,
+    #[serde(default)]
+    pub argv_absent: Vec<String>,
+    pub argv_text_contains: Option<String>,
+    pub stdin_contains: Option<String>,
+    pub stdin_equals: Option<String>,
+    pub stdin_empty: Option<bool>,
+    #[serde(default)]
+    pub env_eq: BTreeMap<String, String>,
+    #[serde(default)]
+    pub env_set: Vec<String>,
+    #[serde(default)]
+    pub env_unset: Vec<String>,
+    pub call: Option<u64>,
+}
+
+#[derive(Debug, Clone, Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Response {
+    pub expect_stdin: Option<ExpectStdin>,
+    #[serde(default)]
+    pub delay_ms: u64,
+    #[serde(default)]
+    pub write_files: Vec<WriteFile>,
+    pub stderr: Option<String>,
+    pub stdout: Option<String>,
+    pub stdout_json: Option<Value>,
+    #[serde(default)]
+    pub chunks: Vec<Chunk>,
+    pub spawn_child: Option<SpawnChild>,
+    pub hang: Option<Hang>,
+    #[serde(default)]
+    pub exit: i32,
+}
+
+#[derive(Debug, Clone, Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ExpectStdin {
+    pub contains: Option<String>,
+    pub equals: Option<String>,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct WriteFile {
+    pub path: String,
+    #[serde(default)]
+    pub content: String,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Chunk {
+    #[serde(default = "stdout_name")]
+    pub stream: String,
+    pub text: String,
+    #[serde(default)]
+    pub delay_ms: u64,
+}
+
+fn stdout_name() -> String {
+    "stdout".into()
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SpawnChild {
+    pub heartbeat: String,
+    #[serde(default = "default_lifetime")]
+    pub lifetime_secs: u64,
+}
+
+fn default_lifetime() -> u64 {
+    120
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(untagged)]
+pub enum Hang {
+    Forever(bool),
+    Secs(u64),
+}
+
+impl Hang {
+    fn secs(&self) -> Option<u64> {
+        match self {
+            Hang::Forever(true) => Some(HANG_DEFAULT_SECS),
+            Hang::Forever(false) => None,
+            Hang::Secs(s) => Some(*s),
+        }
+    }
+}
+
+impl Script {
+    /// Parses a script file: TOML by `.toml` extension, JSON otherwise.
+    pub fn load(path: &Path) -> Result<Script, String> {
+        let text = fs::read_to_string(path).map_err(|e| format!("read {}: {e}", path.display()))?;
+        if path.extension().and_then(|e| e.to_str()) == Some("toml") {
+            Script::from_toml(&text)
+        } else {
+            Script::from_json(&text)
+        }
+    }
+
+    pub fn from_json(text: &str) -> Result<Script, String> {
+        serde_json::from_str(text).map_err(|e| format!("bad fake-cli script: {e}"))
+    }
+
+    pub fn from_toml(text: &str) -> Result<Script, String> {
+        toml::from_str(text).map_err(|e| format!("bad fake-cli script: {e}"))
+    }
+}
+
+/// What the process was started with. `env` is a lookup so tests need not touch the real environment.
+pub struct Invocation<'a> {
+    pub argv: &'a [String],
+    pub stdin: &'a str,
+    pub env: &'a dyn Fn(&str) -> Option<String>,
+    /// 0-based count of earlier invocations (from `state_file`), 0 when there is none.
+    pub call: u64,
+}
+
+fn rule_matches(when: &When, inv: &Invocation<'_>) -> bool {
+    let argv = inv.argv;
+    if let Some(first) = &when.argv_first {
+        if argv.first() != Some(first) {
+            return false;
+        }
+    }
+    if !when.argv_prefix.is_empty() && !argv.starts_with(&when.argv_prefix) {
+        return false;
+    }
+    if !when.argv_contains.iter().all(|w| argv.contains(w)) {
+        return false;
+    }
+    if when.argv_absent.iter().any(|w| argv.contains(w)) {
+        return false;
+    }
+    if let Some(t) = &when.argv_text_contains {
+        if !argv.iter().any(|a| a.contains(t.as_str())) {
+            return false;
+        }
+    }
+    if let Some(t) = &when.stdin_contains {
+        if !inv.stdin.contains(t.as_str()) {
+            return false;
+        }
+    }
+    if let Some(t) = &when.stdin_equals {
+        if inv.stdin != t {
+            return false;
+        }
+    }
+    if let Some(e) = when.stdin_empty {
+        if inv.stdin.is_empty() != e {
+            return false;
+        }
+    }
+    if !when.env_eq.iter().all(|(k, v)| (inv.env)(k).as_deref() == Some(v.as_str())) {
+        return false;
+    }
+    if !when.env_set.iter().all(|k| (inv.env)(k).is_some()) {
+        return false;
+    }
+    if when.env_unset.iter().any(|k| (inv.env)(k).is_some()) {
+        return false;
+    }
+    when.call.map_or(true, |c| c == inv.call)
+}
+
+/// The matched rule's index (`None` for the default) and its response, for an invocation.
+pub fn decide<'s>(script: &'s Script, inv: &Invocation<'_>) -> (Option<usize>, Option<&'s Response>) {
+    for (i, rule) in script.rules.iter().enumerate() {
+        if rule_matches(&rule.when, inv) {
+            return (Some(i), Some(&rule.respond));
+        }
+    }
+    (None, script.default.as_ref())
+}
+
+/// Expands `${...}` templates (see the module docs). Unknown names stay literal.
+pub fn expand(text: &str, inv: &Invocation<'_>) -> String {
+    let mut out = String::new();
+    let mut rest = text;
+    while let Some(at) = rest.find('$') {
+        out.push_str(&rest[..at]);
+        rest = &rest[at..];
+        if let Some(r) = rest.strip_prefix("$$") {
+            out.push('$');
+            rest = r;
+        } else if let Some(body) = rest.strip_prefix("${") {
+            match body.find('}').and_then(|end| resolve(&body[..end], inv).map(|v| (end, v))) {
+                Some((end, v)) => {
+                    out.push_str(&v);
+                    rest = &body[end + 1..];
+                }
+                None => {
+                    out.push_str("${");
+                    rest = body;
+                }
+            }
+        } else {
+            out.push('$');
+            rest = &rest[1..];
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+fn resolve(name: &str, inv: &Invocation<'_>) -> Option<String> {
+    Some(match name {
+        "stdin" => inv.stdin.to_string(),
+        "stdin_bytes" => inv.stdin.len().to_string(),
+        "argv_all" => inv.argv.join(" "),
+        "argv_prompt" => {
+            let t = inv.stdin.trim();
+            if !t.is_empty() && inv.argv.iter().any(|a| a.contains(t)) { "present" } else { "absent" }.into()
+        }
+        _ => {
+            if let Some(n) = name.strip_prefix("argv:") {
+                let i: usize = n.parse().ok()?;
+                inv.argv.get(i).cloned().unwrap_or_default()
+            } else if let Some(flag) = name.strip_prefix("arg:") {
+                let at = inv.argv.iter().position(|a| a == flag)?;
+                inv.argv.get(at + 1).cloned().unwrap_or_default()
+            } else if let Some(var) = name.strip_prefix("env_present:") {
+                if (inv.env)(var).is_some() { "present" } else { "absent" }.into()
+            } else if let Some(var) = name.strip_prefix("env:") {
+                (inv.env)(var).unwrap_or_default()
+            } else {
+                return None;
+            }
+        }
+    })
+}
+
+fn expand_json(value: &Value, inv: &Invocation<'_>) -> Value {
+    match value {
+        Value::String(s) => Value::String(expand(s, inv)),
+        Value::Array(a) => Value::Array(a.iter().map(|v| expand_json(v, inv)).collect()),
+        Value::Object(o) => Value::Object(o.iter().map(|(k, v)| (k.clone(), expand_json(v, inv))).collect()),
+        other => other.clone(),
+    }
+}
+
+fn emit(stream: &str, text: &str) {
+    if stream == "stderr" {
+        let mut e = std::io::stderr().lock();
+        let _ = e.write_all(text.as_bytes());
+        let _ = e.flush();
+    } else {
+        let mut o = std::io::stdout().lock();
+        let _ = o.write_all(text.as_bytes());
+        let _ = o.flush();
+    }
+}
+
+fn sleep_ms(ms: u64) {
+    if ms > 0 {
+        thread::sleep(Duration::from_millis(ms));
+    }
+}
+
+fn fake_failure(message: &str) -> i32 {
+    let _ = writeln!(std::io::stderr(), "rightkit-fake-cli: {message}");
+    FAKE_FAILURE_EXIT
+}
+
+/// Runs one invocation of the fake. `args` is the argument list after the program name, with
+/// `--fake-cli-script <file>` first if used. Returns the exit code for the caller to pass to `exit`.
+pub fn run(args: &[String]) -> i32 {
+    if args.first().map(String::as_str) == Some(HEARTBEAT_ARG) {
+        return match args.get(1) {
+            Some(path) => heartbeat(Path::new(path), args.get(2).and_then(|s| s.parse().ok()).unwrap_or(120)),
+            None => fake_failure("heartbeat child needs a file"),
+        };
+    }
+    let (script_path, argv): (Option<String>, &[String]) = if args.first().map(String::as_str) == Some(SCRIPT_ARG) {
+        match args.get(1) {
+            Some(p) => (Some(p.clone()), &args[2..]),
+            None => return fake_failure("--fake-cli-script needs a file"),
+        }
+    } else {
+        (std::env::var(SCRIPT_ENV).ok(), args)
+    };
+    let Some(script_path) = script_path else {
+        return fake_failure(&format!("no script: pass {SCRIPT_ARG} <file> or set {SCRIPT_ENV}"));
+    };
+    let script = match Script::load(Path::new(&script_path)) {
+        Ok(s) => s,
+        Err(e) => return fake_failure(&e),
+    };
+    let mut stdin = String::new();
+    if script.read_stdin {
+        let mut bytes = Vec::new();
+        let _ = std::io::stdin().read_to_end(&mut bytes);
+        stdin = String::from_utf8_lossy(&bytes).into_owned();
+    }
+    let env = |k: &str| std::env::var(k).ok();
+    let call = script.state_file.as_ref().map_or(0, |p| {
+        let bare = Invocation { argv: &[], stdin: "", env: &env, call: 0 };
+        bump_counter(&expand(p, &bare))
+    });
+    let inv = Invocation { argv, stdin: &stdin, env: &env, call };
+    let (index, response) = decide(&script, &inv);
+    if let Some(record) = &script.record {
+        let line = serde_json::json!({"argv": argv, "stdin": stdin, "rule": index, "call": call});
+        if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(expand(record, &inv)) {
+            let _ = writeln!(f, "{line}");
+        }
+    }
+    response.map_or(0, |r| perform(r, &inv))
+}
+
+fn bump_counter(path: &str) -> u64 {
+    let n = fs::read_to_string(path).ok().and_then(|s| s.trim().parse::<u64>().ok()).unwrap_or(0);
+    let _ = fs::write(path, (n + 1).to_string());
+    n
+}
+
+/// Performs a response's effects (see the module docs for the order) and returns its exit code.
+pub fn perform(r: &Response, inv: &Invocation<'_>) -> i32 {
+    if let Some(e) = &r.expect_stdin {
+        if let Some(c) = &e.contains {
+            let c = expand(c, inv);
+            if !inv.stdin.contains(&c) {
+                return fake_failure(&format!("expected stdin to contain {c:?}"));
+            }
+        }
+        if let Some(q) = &e.equals {
+            let q = expand(q, inv);
+            if inv.stdin != q {
+                return fake_failure(&format!("expected stdin to equal {q:?}"));
+            }
+        }
+    }
+    sleep_ms(r.delay_ms);
+    for f in &r.write_files {
+        let path = expand(&f.path, inv);
+        if let Some(parent) = Path::new(&path).parent() {
+            let _ = fs::create_dir_all(parent);
+        }
+        if let Err(e) = fs::write(&path, expand(&f.content, inv)) {
+            return fake_failure(&format!("write {path}: {e}"));
+        }
+    }
+    if let Some(s) = &r.stderr {
+        emit("stderr", &expand(s, inv));
+    }
+    if let Some(s) = &r.stdout {
+        emit("stdout", &expand(s, inv));
+    }
+    if let Some(v) = &r.stdout_json {
+        emit("stdout", &format!("{}\n", expand_json(v, inv)));
+    }
+    for c in &r.chunks {
+        sleep_ms(c.delay_ms);
+        emit(&c.stream, &expand(&c.text, inv));
+    }
+    if let Some(child) = &r.spawn_child {
+        spawn_child(&expand(&child.heartbeat, inv), child.lifetime_secs);
+    }
+    if let Some(secs) = r.hang.as_ref().and_then(Hang::secs) {
+        thread::sleep(Duration::from_secs(secs));
+    }
+    r.exit
+}
+
+fn spawn_child(heartbeat_file: &str, lifetime_secs: u64) {
+    let _ = fs::write(heartbeat_file, b"");
+    if let Ok(exe) = std::env::current_exe() {
+        let _ = Command::new(exe)
+            .args([HEARTBEAT_ARG, heartbeat_file, &lifetime_secs.to_string()])
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn();
+    }
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while Instant::now() < deadline {
+        if fs::metadata(heartbeat_file).map(|m| m.len() > 0).unwrap_or(false) {
+            return;
+        }
+        thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn heartbeat(path: &Path, lifetime_secs: u64) -> i32 {
+    let end = Instant::now() + Duration::from_secs(lifetime_secs);
+    while Instant::now() < end {
+        match fs::OpenOptions::new().create(true).append(true).open(path) {
+            Ok(mut f) => {
+                let _ = f.write_all(b".");
+            }
+            Err(_) => return 0,
+        }
+        thread::sleep(Duration::from_millis(50));
+    }
+    0
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn inv<'a>(argv: &'a [String], stdin: &'a str, env: &'a dyn Fn(&str) -> Option<String>) -> Invocation<'a> {
+        Invocation { argv, stdin, env, call: 0 }
+    }
+
+    fn args(a: &[&str]) -> Vec<String> {
+        a.iter().map(|s| s.to_string()).collect()
+    }
+
+    const LLM: &str = r#"{
+      "rules": [
+        {"when": {"env_eq": {"MODE": "fail"}}, "respond": {"stderr": "fake failure\n", "exit": 2}},
+        {"when": {"env_eq": {"MODE": "not-signed-in"}}, "respond": {"stderr": "Not logged in\n", "exit": 1}},
+        {"when": {"argv_first": "-p"}, "respond": {"stdout_json": {"type":"result","is_error":false,
+           "result": "DRAFT[${stdin_bytes} bytes] argv_prompt=${argv_prompt} env_probe=${env_present:PROBE}"}}}
+      ],
+      "default": {"stdout": "DRAFT[${stdin_bytes} bytes] argv_prompt=${argv_prompt} env_probe=${env_present:PROBE}\n"}
+    }"#;
+
+    #[test]
+    fn llm_style_script_picks_rules_in_order() {
+        let script = Script::from_json(LLM).unwrap();
+        let env = |k: &str| (k == "MODE").then(|| "fail".to_string());
+        let a = args(&["-p"]);
+        let (i, r) = decide(&script, &inv(&a, "hi", &env));
+        assert_eq!((i, r.unwrap().exit), (Some(0), 2));
+        let none = |_: &str| None;
+        let (i, _) = decide(&script, &inv(&a, "hi", &none));
+        assert_eq!(i, Some(2));
+        let (i, r) = decide(&script, &inv(&args(&["exec"]), "hi", &none));
+        assert_eq!(i, None);
+        assert!(r.is_some());
+    }
+
+    #[test]
+    fn templates_expand_and_escape() {
+        let a = args(&["brief", "run", "--project", "/p", "--input", "b.json"]);
+        let probe = |k: &str| (k == "PROBE").then(|| "x\"y".to_string());
+        let i = inv(&a, "say \"hi\"", &probe);
+        assert_eq!(expand("${arg:--project}/e.json ${argv:0} $$5 ${nope}", &i), "/p/e.json brief $5 ${nope}");
+        assert_eq!(expand("${stdin_bytes} ${env_present:PROBE} ${env_present:OTHER}", &i), "8 present absent");
+        let v = expand_json(&serde_json::json!({"r": "${stdin}", "n": [1, "${env:PROBE}"]}), &i);
+        assert_eq!(v.to_string(), r#"{"n":[1,"x\"y"],"r":"say \"hi\""}"#);
+        let a2 = args(&["-p", "say \"hi\""]);
+        assert_eq!(expand("${argv_prompt}", &inv(&a2, "say \"hi\"\n", &probe)), "present");
+    }
+
+    #[test]
+    fn when_keys_all_apply() {
+        let w: When = serde_json::from_str(
+            r#"{"argv_prefix":["brief","run"],"argv_contains":["--dry-run"],"argv_absent":["--x"],
+                "stdin_empty":true,"env_set":["A"],"env_unset":["B"]}"#,
+        )
+        .unwrap();
+        let a = args(&["brief", "run", "--dry-run"]);
+        let env = |k: &str| (k == "A").then(|| "1".to_string());
+        assert!(rule_matches(&w, &inv(&a, "", &env)));
+        assert!(!rule_matches(&w, &inv(&a, "data", &env)));
+        assert!(!rule_matches(&w, &inv(&args(&["brief", "run"]), "", &env)));
+    }
+
+    #[test]
+    fn toml_and_unknown_keys() {
+        let s = Script::from_toml(
+            "[[rules]]\n[rules.when]\nargv_first = \"exec\"\n[rules.respond]\nstdout = \"hi\"\nexit = 3\n",
+        )
+        .unwrap();
+        assert_eq!(s.rules[0].respond.exit, 3);
+        assert!(Script::from_json(r#"{"rulez": []}"#).is_err());
+    }
+
+    #[test]
+    fn perform_expectation_files_and_exit() {
+        let dir = std::env::temp_dir().join(format!("rk-fake-cli-{}", std::process::id()));
+        let target = dir.join("out/e.json");
+        let r: Response = serde_json::from_value(serde_json::json!({
+            "expect_stdin": {"contains": "need"},
+            "write_files": [{"path": target.to_str().unwrap(), "content": "len=${stdin_bytes}"}],
+            "exit": 7
+        }))
+        .unwrap();
+        let none = |_: &str| None;
+        assert_eq!(perform(&r, &inv(&[], "no", &none)), FAKE_FAILURE_EXIT);
+        assert!(!target.exists());
+        assert_eq!(perform(&r, &inv(&[], "need it", &none)), 7);
+        assert_eq!(fs::read_to_string(&target).unwrap(), "len=7");
+        let _ = fs::remove_file(&target);
+    }
+
+    #[test]
+    fn call_counter_selects_nth_invocation() {
+        let script = Script::from_json(
+            r#"{"rules":[{"when":{"call":0},"respond":{"exit":1}},{"when":{},"respond":{"exit":0}}]}"#,
+        )
+        .unwrap();
+        let none = |_: &str| None;
+        let mut i = inv(&[], "", &none);
+        assert_eq!(decide(&script, &i).1.unwrap().exit, 1);
+        i.call = 1;
+        assert_eq!(decide(&script, &i).1.unwrap().exit, 0);
+        let f = std::env::temp_dir().join(format!("rk-fake-cli-count-{}", std::process::id()));
+        let _ = fs::remove_file(&f);
+        assert_eq!(bump_counter(f.to_str().unwrap()), 0);
+        assert_eq!(bump_counter(f.to_str().unwrap()), 1);
+        let _ = fs::remove_file(&f);
+    }
+
+    #[test]
+    fn hang_forms() {
+        let h: Response = serde_json::from_str(r#"{"hang": true}"#).unwrap();
+        assert_eq!(h.hang.unwrap().secs(), Some(3600));
+        let h: Response = serde_json::from_str(r#"{"hang": 5}"#).unwrap();
+        assert_eq!(h.hang.unwrap().secs(), Some(5));
+    }
+}

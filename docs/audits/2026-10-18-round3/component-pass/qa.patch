+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { CRAWL_SCRIPT, addSection, compareInventories, controlCount, createInventory, crawlControls, parityMarkdown, readInventory, writeInventory, type ControlEntry } from './crawl.js';
+
+const control = (role: string, name: string, disabled = false): ControlEntry => ({
+  key: `${role}:${name}`, role, name, tag: 'button', id: null, type: null, href: null, disabled, visible: true, focusable: !disabled, box: [0, 0, 10, 10],
+});
+const inventory = (platform: string, controls: ControlEntry[]) => {
+  const inv = createInventory('demo', platform);
+  addSection(inv, { id: 'home', url: 'app://home', title: 'Home', controls });
+  return inv;
+};
+
+describe('control inventory and parity', () => {
+  it('crawls through page.evaluate with the shared script', async () => {
+    let source = '';
+    const page = { evaluate: async (code: string) => { source = code; return { url: 'app://x', title: 'X', controls: [control('button', 'Save')] }; } };
+    const section = await crawlControls(page as never, 'main');
+    expect(section.controls).toHaveLength(1);
+    expect(source.startsWith('(function () {')).toBe(true);
+    expect(CRAWL_SCRIPT).toContain('querySelectorAll(SEL)');
+    await expect(crawlControls({ evaluate: async () => null } as never, 'x')).rejects.toThrow('no controls');
+  });
+
+  it('identical inventories pass regardless of order', () => {
+    const report = compareInventories(inventory('macos', [control('button', 'Save'), control('link', 'Help')]), inventory('windows', [control('link', 'Help'), control('button', 'Save')]));
+    expect(report.pass).toBe(true);
+    expect(report.controlsCompared).toBe(2);
+  });
+
+  it('reports missing controls, state differences and escaped table cells', () => {
+    const report = compareInventories(
+      inventory('macos', [control('button', 'Save'), control('button', 'Mac only')]),
+      inventory('windows', [control('button', 'Save', true), control('button', 'Win | only')]),
+    );
+    expect(report.differences.map((d) => d.kind).sort()).toEqual(['only_in_a', 'only_in_b', 'state']);
+    const md = parityMarkdown(report);
+    expect(md).toContain('# Parity macos vs windows: FAIL');
+    expect(md).toContain('disabled: false vs true');
+    expect(md).toContain('Win \\| only');
+  });
+
+  it('matches duplicates in order, honours ignoreKeys and reports missing sections', () => {
+    const a = inventory('macos', [control('button', 'OK'), control('button', 'OK'), control('button', 'Chrome')]);
+    const b = inventory('windows', [control('button', 'OK')]);
+    addSection(b, { id: 'extra', url: '', title: '', controls: [] });
+    const report = compareInventories(a, b, { ignoreKeys: ['Chrome'] });
+    expect(report.differences).toEqual([
+      { section: 'home', key: 'button:OK #2', kind: 'only_in_a', detail: '' },
+      { section: 'extra', key: '', kind: 'section_missing_in_a', detail: '' },
+    ]);
+  });
+
+  it('round-trips through a file and refuses another schema', () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'rkqa-inv-'));
+    try {
+      const inv = inventory('macos', [control('button', 'Save')]);
+      const file = path.join(dir, 'nested', 'inv.json');
+      writeInventory(file, inv);
+      expect(readInventory(file)).toEqual(inv);
+      expect(controlCount(inv)).toBe(1);
+      fs.writeFileSync(file, JSON.stringify({ ...inv, schema: 99 }));
+      expect(() => readInventory(file)).toThrow('schema 99');
+    } finally { fs.rmSync(dir, { recursive: true, force: true }); }
+  });
+});
diff --git a/packages/qa/src/crawl.ts b/packages/qa/src/crawl.ts
new file mode 100644
index 0000000..079c19d
--- /dev/null
+++ b/packages/qa/src/crawl.ts
@@ -0,0 +1,184 @@
+// Control crawler, interaction inventory and cross-platform parity report (Orthic-Labs/rightkit#427). The same script,
+// JSON shape and comparison rules as `rightkit_qa::crawl`, so an inventory written by a Rust run on one host compares
+// with one written by a Node run on the other.
+
+import fs from 'node:fs';
+import path from 'node:path';
+import type { QaPage } from './page.js';
+
+export const INVENTORY_SCHEMA = 1;
+
+/** Function-body source of the crawl; `crawlControls` wraps it in an IIFE. Read-only. */
+export const CRAWL_SCRIPT = String.raw`var SEL = 'a[href],button,input:not([type=hidden]),select,textarea,summary,[role=button],[role=link],[role=tab],[role=menuitem],[role=menuitemcheckbox],[role=menuitemradio],[role=checkbox],[role=radio],[role=switch],[role=combobox],[role=slider],[role=option],[tabindex]:not([tabindex="-1"])';
+var ROLES = {A:'link',BUTTON:'button',SELECT:'combobox',TEXTAREA:'textbox',SUMMARY:'button'};
+var INPUT_ROLES = {checkbox:'checkbox',radio:'radio',range:'slider',button:'button',submit:'button',reset:'button',number:'spinbutton',search:'searchbox'};
+function roleOf(e) {
+  var r = e.getAttribute('role');
+  if (r) return r.trim().split(/\s+/)[0];
+  if (e.tagName === 'INPUT') return INPUT_ROLES[e.type] || 'textbox';
+  return ROLES[e.tagName] || null;
+}
+function nameOf(e) {
+  var ids = e.getAttribute('aria-labelledby');
+  var labelled = ids ? ids.split(/\s+/).map(function (i) { var n = document.getElementById(i); return n ? n.textContent : ''; }).join(' ') : '';
+  var labels = e.labels && e.labels.length ? Array.prototype.map.call(e.labels, function (l) { return l.innerText; }).join(' ') : '';
+  return (e.getAttribute('aria-label') || labelled || labels || e.innerText || e.value || e.getAttribute('title') || e.getAttribute('placeholder') || '').replace(/\s+/g, ' ').trim().slice(0, 120);
+}
+function visibleOf(e) {
+  for (var p = e; p; p = p.parentElement) {
+    var s = getComputedStyle(p);
+    if (s.display === 'none' || s.visibility === 'hidden' || s.visibility === 'collapse') return false;
+  }
+  var r = e.getBoundingClientRect();
+  return r.width > 0 && r.height > 0;
+}
+var out = [];
+Array.prototype.forEach.call(document.querySelectorAll(SEL), function (e) {
+  var r = e.getBoundingClientRect();
+  var role = roleOf(e);
+  var name = nameOf(e);
+  var disabled = !!e.disabled || e.getAttribute('aria-disabled') === 'true' || !!e.closest('fieldset[disabled]');
+  out.push({
+    key: (role || e.tagName.toLowerCase()) + ':' + name,
+    role: role, name: name, tag: e.tagName.toLowerCase(), id: e.id || null,
+    type: e.type || null, href: e.tagName === 'A' ? (e.getAttribute('href') || null) : null,
+    disabled: disabled, visible: visibleOf(e),
+    focusable: !disabled && (e.tabIndex >= 0),
+    box: [Math.round(r.left), Math.round(r.top), Math.round(r.width), Math.round(r.height)]
+  });
+});
+return {url: location.href, title: document.title, controls: out};`;
+
+export interface ControlEntry {
+  /** `<role or tag>:<accessible name>`: the identity a parity report matches on. */
+  key: string;
+  role: string | null;
+  name: string;
+  tag: string;
+  id: string | null;
+  type: string | null;
+  href: string | null;
+  disabled: boolean;
+  visible: boolean;
+  focusable: boolean;
+  /** [x, y, width, height] in viewport CSS pixels. Evidence only; never compared. */
+  box: [number, number, number, number];
+}
+
+export interface SectionInventory { id: string; url: string; title: string; controls: ControlEntry[] }
+
+export interface Inventory { schema: number; app: string; platform: string; sections: SectionInventory[] }
+
+export function createInventory(app: string, platform: string = process.platform === 'darwin' ? 'macos' : process.platform === 'win32' ? 'windows' : 'linux'): Inventory {
+  return { schema: INVENTORY_SCHEMA, app, platform, sections: [] };
+}
+
+/** Adds a section; a second section with the same id replaces the first. */
+export function addSection(inventory: Inventory, section: SectionInventory): void {
+  inventory.sections = inventory.sections.filter((existing) => existing.id !== section.id);
+  inventory.sections.push(section);
+}
+
+export function controlCount(inventory: Inventory): number {
+  return inventory.sections.reduce((total, section) => total + section.controls.length, 0);
+}
+
+/** Lists the interactive controls of the page `page` shows now. Read-only. */
+export async function crawlControls(page: Pick<QaPage, 'evaluate'>, id: string): Promise<SectionInventory> {
+  const value = await page.evaluate(`(function () {${CRAWL_SCRIPT}})()`) as { url?: string; title?: string; controls?: ControlEntry[] } | null;
+  if (!value || !Array.isArray(value.controls)) throw new Error('the crawl returned no controls');
+  return { id, url: String(value.url ?? ''), title: String(value.title ?? ''), controls: value.controls };
+}
+
+export function writeInventory(file: string, inventory: Inventory): void {
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, `${JSON.stringify(inventory, null, 2)}\n`);
+}
+
+export function parseInventory(text: string): Inventory {
+  const inventory = JSON.parse(text) as Inventory;
+  if (inventory.schema !== INVENTORY_SCHEMA) throw new Error(`inventory schema ${inventory.schema} is not supported (this package reads ${INVENTORY_SCHEMA})`);
+  return inventory;
+}
+
+export function readInventory(file: string): Inventory { return parseInventory(fs.readFileSync(file, 'utf8')); }
+
+export interface ParityDifference {
+  section: string;
+  key: string;
+  /** `only_in_a`, `only_in_b`, `state`, `section_missing_in_a` or `section_missing_in_b`. */
+  kind: string;
+  detail: string;
+}
+
+export interface ParityReport {
+  a: string;
+  b: string;
+  sectionsCompared: number;
+  controlsCompared: number;
+  differences: ParityDifference[];
+  pass: boolean;
+}
+
+export interface ParityOptions {
+  /** Controls whose key contains one of these are ignored on both sides (platform-only chrome). */
+  ignoreKeys?: string[];
+  /** Compare `focusable` too. Default true. */
+  compareFocusable?: boolean;
+}
+
+/**
+ * Compares the inventory of one platform (`a`) with another's (`b`). Sections match by id and controls by key, in
+ * order of appearance when several share a key. Differences: a control only one side lists, a section only one side
+ * crawled, and a difference in disabled, visible or (optionally) focusable. Positions, sizes and ids are not compared.
+ */
+export function compareInventories(a: Inventory, b: Inventory, options: ParityOptions = {}): ParityReport {
+  const ignoreKeys = options.ignoreKeys ?? [];
+  const compareFocusable = options.compareFocusable ?? true;
+  const ignored = (key: string): boolean => ignoreKeys.some((needle) => key.includes(needle));
+  const differences: ParityDifference[] = [];
+  let sectionsCompared = 0, controlsCompared = 0;
+  const ids = [...a.sections.map((section) => section.id)];
+  for (const section of b.sections) if (!ids.includes(section.id)) ids.push(section.id);
+  const group = (section: SectionInventory): Map<string, ControlEntry[]> => {
+    const groups = new Map<string, ControlEntry[]>();
+    for (const control of section.controls) if (!ignored(control.key)) groups.set(control.key, [...(groups.get(control.key) ?? []), control]);
+    return groups;
+  };
+  for (const id of ids) {
+    const sa = a.sections.find((section) => section.id === id), sb = b.sections.find((section) => section.id === id);
+    if (!sa || !sb) { differences.push({ section: id, key: '', kind: sa ? 'section_missing_in_b' : 'section_missing_in_a', detail: '' }); continue; }
+    sectionsCompared += 1;
+    const ga = group(sa), gb = group(sb);
+    const keys = [...new Set([...ga.keys(), ...gb.keys()])].sort();
+    for (const key of keys) {
+      const la = ga.get(key) ?? [], lb = gb.get(key) ?? [];
+      const total = Math.max(la.length, lb.length);
+      for (let i = 0; i < total; i += 1) {
+        const label = total > 1 ? `${key} #${i + 1}` : key;
+        const x = la[i], y = lb[i];
+        if (x && y) {
+          controlsCompared += 1;
+          const parts: string[] = [];
+          if (x.disabled !== y.disabled) parts.push(`disabled: ${x.disabled} vs ${y.disabled}`);
+          if (x.visible !== y.visible) parts.push(`visible: ${x.visible} vs ${y.visible}`);
+          if (compareFocusable && x.focusable !== y.focusable) parts.push(`focusable: ${x.focusable} vs ${y.focusable}`);
+          if (parts.length) differences.push({ section: id, key: label, kind: 'state', detail: parts.join('; ') });
+        } else differences.push({ section: id, key: label, kind: x ? 'only_in_a' : 'only_in_b', detail: '' });
+      }
+    }
+  }
+  return { a: a.platform, b: b.platform, sectionsCompared, controlsCompared, differences, pass: differences.length === 0 };
+}
+
+const cell = (text: string): string => text.replace(/\|/g, '\\|').replace(/\n/g, ' ');
+
+/** The report as Markdown: a verdict line and a table of differences. */
+export function parityMarkdown(report: ParityReport): string {
+  let out = `# Parity ${report.a} vs ${report.b}: ${report.pass ? 'PASS' : 'FAIL'}\n\n${report.sectionsCompared} section(s), ${report.controlsCompared} control(s) compared, ${report.differences.length} difference(s).\n`;
+  if (report.differences.length) {
+    out += '\n| Section | Control | Kind | Detail |\n|---|---|---|---|\n';
+    for (const d of report.differences) out += `| ${cell(d.section)} | ${cell(d.key)} | ${d.kind} | ${cell(d.detail)} |\n`;
+  }
+  return out;
+}

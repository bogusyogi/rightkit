+import { describe, expect, it, vi } from "vitest";
+import { createFaultInjector, createFixtureStore, loadFixtures, selectDataSource, withFaults } from "./preview.js";
+
+describe("selectDataSource", () => {
+  it("picks the engine only with mode engine and a host", () => {
+    const mock = vi.fn(() => "m");
+    const engine = vi.fn(() => "e");
+    expect(selectDataSource({ mode: "engine", hostAvailable: true, mock, engine })).toEqual({ kind: "engine", source: "e" });
+    expect(engine).toHaveBeenCalledTimes(1);
+    expect(mock).not.toHaveBeenCalled();
+  });
+  it("falls back to the mock without the host or the flag", () => {
+    const engine = vi.fn(() => "e");
+    const mock = () => "m";
+    expect(selectDataSource({ mode: "engine", hostAvailable: false, mock, engine }).kind).toBe("mock");
+    expect(selectDataSource({ mode: undefined, hostAvailable: true, mock, engine }).kind).toBe("mock");
+    expect(engine).not.toHaveBeenCalled();
+  });
+});
+
+describe("fault injection", () => {
+  class Src {
+    n = 0;
+    kind = "mock";
+    list() {
+      return [1, 2];
+    }
+    bump() {
+      this.n += 1;
+      return this.n;
+    }
+    other() {
+      return "x";
+    }
+  }
+  it("delays, fails reads and writes by class, and passes the rest through", async () => {
+    const sleep = vi.fn(async () => {});
+    const inj = createFaultInjector({ latencyMs: 50, sleep });
+    const s = withFaults(new Src(), inj, { reads: ["list"], writes: ["bump"] });
+    expect(await s.list()).toEqual([1, 2]);
+    expect(sleep).toHaveBeenCalledWith(50);
+    expect(s.kind).toBe("mock");
+    expect(s.other()).toBe("x");
+    inj.set({ failReads: true });
+    await expect(s.list()).rejects.toThrow("Injected read failure: list");
+    expect(await s.bump()).toBe(1);
+    inj.set({ failWrites: true });
+    await expect(s.bump()).rejects.toThrow("Injected write failure: bump");
+  });
+  it("fails a chosen call only, and takes per-call latency", async () => {
+    const seen: number[] = [];
+    const inj = createFaultInjector({
+      latencyMs: (c) => (c.kind === "write" ? 7 : 0),
+      sleep: async (ms) => void seen.push(ms),
+      fail: (c) => (c.method === "bump" ? new Error("boom") : undefined),
+    });
+    const s = withFaults(new Src(), inj, { reads: ["list"], writes: ["bump"] });
+    await expect(s.bump()).rejects.toThrow("boom");
+    expect(await s.list()).toEqual([1, 2]);
+    expect(seen).toEqual([7]);
+  });
+  it("classify wraps unlisted methods", async () => {
+    const inj = createFaultInjector({ failReads: true });
+    const s = withFaults(new Src(), inj, { classify: (m) => (m === "other" ? "read" : undefined) });
+    await expect(s.other()).rejects.toThrow();
+    expect(s.list()).toEqual([1, 2]);
+  });
+});
+
+describe("fixtures", () => {
+  it("hands out independent copies", () => {
+    const store = createFixtureStore({ jobs: [{ id: "a", n: 1 }] });
+    const first = store.get<{ id: string; n: number }[]>("jobs");
+    first[0]!.n = 9;
+    expect(store.get<{ n: number }[]>("jobs")[0]!.n).toBe(1);
+    expect(store.map<{ id: string }>("jobs", "id").get("a")).toBeDefined();
+    expect(() => store.get("nope")).toThrow("Unknown fixture: nope");
+  });
+  it("loads and checks required names", async () => {
+    const store = await loadFixtures(async () => ({ a: [], b: {} }), { required: ["a"] });
+    expect(store.names()).toEqual(["a", "b"]);
+    await expect(loadFixtures(async () => ({ a: [] }), { required: ["a", "b", "c"] })).rejects.toThrow("Missing fixtures: b, c");
+    await expect(loadFixtures(async () => [] as never)).rejects.toThrow("not an object");
+  });
+});
+
+describe("dev-only marker", () => {
+  it("exports the marker a release check searches for", async () => {
+    const m = await import("./preview.js");
+    expect(m.RIGHTKIT_QA_PREVIEW_MARKER).toBe("@rightkit/qa/preview:dev-only");
+  });
+});
+
+describe("production refusal", () => {
+  it("refuses a production environment and names the marker", async () => {
+    const { assertPreviewAllowed, RIGHTKIT_QA_PREVIEW_MARKER } = await import("./preview.js");
+    expect(() => assertPreviewAllowed({ nodeEnv: "production" })).toThrow(RIGHTKIT_QA_PREVIEW_MARKER);
+    expect(() => assertPreviewAllowed({ prod: true })).toThrow("development and test only");
+    expect(() => assertPreviewAllowed({ nodeEnv: "development", prod: false })).not.toThrow();
+    expect(() => assertPreviewAllowed({})).not.toThrow();
+  });
+});
diff --git a/packages/qa/src/preview.ts b/packages/qa/src/preview.ts
new file mode 100644
index 0000000..519cfe7
--- /dev/null
+++ b/packages/qa/src/preview.ts
@@ -0,0 +1,180 @@
+/**
+ * `@rightkit/qa/preview`: DEV-ONLY data API for a browser preview that runs on a fake source: the
+ * mock/engine switch, latency and failure injection, and fixture loading. Pure TypeScript; no React, no
+ * dependency.
+ *
+ * Never import this from code a release build ships. Reach it only through a dynamic import behind
+ * `import.meta.env.DEV` (or the bundler's equivalent), so the bundler drops it from release output, and
+ * fail the release build if its marker string is found in the bundle.
+ */
+
+/** Marker a release-build check can search for: present in the bundle means the preview API leaked. */
+export const RIGHTKIT_QA_PREVIEW_MARKER = "@rightkit/qa/preview:dev-only";
+
+export interface PreviewEnvironment {
+  /** process.env.NODE_ENV, where the bundler provides it. */
+  nodeEnv?: string;
+  /** import.meta.env.PROD (Vite and compatible bundlers). */
+  prod?: boolean;
+}
+
+/**
+ * Throws when `env` is a production build. The module runs this on load with the bundler's own environment, so a
+ * release bundle that still carries the preview API fails at startup instead of shipping a mock data source; the
+ * error names the marker a release check searches for. `@rightkit/qa`'s `assertNoPreviewInBundle` is the build-time half.
+ */
+export function assertPreviewAllowed(env: PreviewEnvironment): void {
+  if (env.prod === true || env.nodeEnv === "production") {
+    throw new Error(`${RIGHTKIT_QA_PREVIEW_MARKER}: the browser-preview API is development and test only and is refused in a production build; import it dynamically behind import.meta.env.DEV`);
+  }
+}
+
+assertPreviewAllowed({
+  nodeEnv: (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env?.NODE_ENV,
+  prod: (import.meta as unknown as { env?: { PROD?: boolean } }).env?.PROD,
+});
+
+
+export type DataSourceKind = "mock" | "engine";
+
+export interface SelectDataSourceOptions<T> {
+  /** The requested source, usually a build-time flag. Anything but `"engine"` selects the mock. */
+  mode: string | undefined;
+  /** True only inside the host that can reach the engine (for example the Tauri shell). */
+  hostAvailable: boolean;
+  mock: () => T;
+  engine: () => T;
+}
+
+/** The engine only when asked for and reachable; otherwise the mock. Only the chosen factory runs. */
+export function selectDataSource<T>(options: SelectDataSourceOptions<T>): { kind: DataSourceKind; source: T } {
+  const useEngine = options.mode === "engine" && options.hostAvailable;
+  return useEngine
+    ? { kind: "engine", source: options.engine() }
+    : { kind: "mock", source: options.mock() };
+}
+
+export interface FaultCall {
+  method: string;
+  kind: "read" | "write";
+  args: readonly unknown[];
+}
+
+export interface FaultOptions {
+  /** Simulated latency in ms: a number for every call, or a function of the call. Default 0. */
+  latencyMs?: number | ((call: FaultCall) => number);
+  /** Every read rejects. */
+  failReads?: boolean;
+  /** Every write rejects. */
+  failWrites?: boolean;
+  /** Return an Error to reject this call, or undefined to let it through. */
+  fail?: (call: FaultCall) => Error | undefined;
+  /** Replaceable for tests. Default: setTimeout. */
+  sleep?: (ms: number) => Promise<void>;
+}
+
+export interface FaultInjector {
+  /** Applies latency, then failure, then runs `produce`. */
+  run<T>(call: FaultCall, produce: () => T | Promise<T>): Promise<T>;
+  /** Changes options at runtime; unspecified keys stay. */
+  set(patch: FaultOptions): void;
+  readonly options: Readonly<FaultOptions>;
+}
+
+const defaultSleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
+
+export function createFaultInjector(initial: FaultOptions = {}): FaultInjector {
+  let opts: FaultOptions = { ...initial };
+  return {
+    get options() {
+      return opts;
+    },
+    set(patch) {
+      opts = { ...opts, ...patch };
+    },
+    async run(call, produce) {
+      const ms = typeof opts.latencyMs === "function" ? opts.latencyMs(call) : (opts.latencyMs ?? 0);
+      if (ms > 0) await (opts.sleep ?? defaultSleep)(ms);
+      if (call.kind === "read" && opts.failReads) throw new Error(`Injected read failure: ${call.method}`);
+      if (call.kind === "write" && opts.failWrites) throw new Error(`Injected write failure: ${call.method}`);
+      const err = opts.fail?.(call);
+      if (err) throw err;
+      return produce();
+    },
+  };
+}
+
+export interface WithFaultsOptions {
+  /** Method names that are reads. */
+  reads?: readonly string[];
+  /** Method names that are writes. */
+  writes?: readonly string[];
+  /** Classifies any other method; return undefined to leave it unwrapped. Default: unwrapped. */
+  classify?: (method: string) => "read" | "write" | undefined;
+}
+
+/**
+ * A proxy over `source` whose classified methods go through the injector. Methods that are not classified, and
+ * non-function members, pass through untouched. Wrapped methods always return a Promise.
+ */
+export function withFaults<T extends object>(source: T, injector: FaultInjector, options: WithFaultsOptions = {}): T {
+  const reads = new Set(options.reads);
+  const writes = new Set(options.writes);
+  return new Proxy(source, {
+    get(target, prop, receiver) {
+      const value = Reflect.get(target, prop, receiver);
+      if (typeof prop !== "string" || typeof value !== "function") return value;
+      const kind = reads.has(prop) ? "read" : writes.has(prop) ? "write" : options.classify?.(prop);
+      if (!kind) return value.bind(target);
+      return (...args: unknown[]) =>
+        injector.run({ method: prop, kind, args }, () => (value as (...a: unknown[]) => unknown).apply(target, args));
+    },
+  });
+}
+
+export type FixtureSet = Record<string, unknown>;
+
+export interface FixtureStore {
+  has(name: string): boolean;
+  names(): string[];
+  /** A fresh deep copy on every call, so callers may mutate it. Throws on an unknown name. */
+  get<T = unknown>(name: string): T;
+  /** A keyed Map over a copy of an array collection. */
+  map<T extends Record<string, unknown>>(name: string, key: keyof T & string): Map<string, T>;
+}
+
+const own = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+
+export function createFixtureStore(fixtures: FixtureSet): FixtureStore {
+  const get = <T>(name: string): T => {
+    if (!own(fixtures, name)) throw new Error(`Unknown fixture: ${name}`);
+    return structuredClone(fixtures[name]) as T;
+  };
+  return {
+    has: (name) => own(fixtures, name),
+    names: () => Object.keys(fixtures),
+    get,
+    map<T extends Record<string, unknown>>(name: string, key: keyof T & string) {
+      const rows = get<T[]>(name);
+      if (!Array.isArray(rows)) throw new Error(`Fixture ${name} is not an array`);
+      return new Map(rows.map((row) => [String(row[key]), row] as const));
+    },
+  };
+}
+
+export interface LoadFixturesOptions {
+  /** Names that must be present; a missing one rejects. */
+  required?: readonly string[];
+}
+
+/** Loads a fixture set from any async source (fetch, dynamic import, file read) and checks its names. */
+export async function loadFixtures(
+  loader: () => Promise<FixtureSet>,
+  options: LoadFixturesOptions = {},
+): Promise<FixtureStore> {
+  const set = await loader();
+  if (set === null || typeof set !== "object" || Array.isArray(set)) throw new Error("Fixture set is not an object");
+  const missing = (options.required ?? []).filter((n) => !own(set, n));
+  if (missing.length > 0) throw new Error(`Missing fixtures: ${missing.join(", ")}`);
+  return createFixtureStore(set);
+}
diff --git a/packages/qa/src/targets.test.ts b/packages/qa/src/targets.test.ts
new file mode 100644
index 0000000..9a4ca56
--- /dev/null
+++ b/packages/qa/src/targets.test.ts
@@ -0,0 +1,92 @@
+import { describe, expect, it } from 'vitest';
+import { QaFrameTargets } from './targets.js';
+
+/** A transport double: tests emit attach/detach events as the page's session, and script Runtime.evaluate replies. */
+function fakeTransport(evaluate: (session: string, expression: string) => any = () => ({ result: { value: null } })) {
+  const listeners = new Map<string, Set<(params: any, session?: string) => void>>();
+  const sends: Array<{ method: string; params: any; session?: string }> = [];
+  const transport = {
+    send: async (method: string, params: any = {}, session?: string) => {
+      sends.push({ method, params, session });
+      return method === 'Runtime.evaluate' ? evaluate(session!, params.expression) : {};
+    },
+    onAny: (method: string, listener: (params: any, session?: string) => void) => {
+      const set = listeners.get(method) ?? new Set(); listeners.set(method, set); set.add(listener);
+      return () => set.delete(listener);
+    },
+  };
+  const emit = (method: string, params: any, session?: string) => { for (const listener of [...(listeners.get(method) ?? [])]) listener(params, session); };
+  const count = () => [...listeners.values()].reduce((n, set) => n + set.size, 0);
+  return { transport, sends, emit, count };
+}
+const attach = (sessionId: string, targetId: string, type: string, url: string) => ({ sessionId, targetInfo: { targetId, type, url, title: `t-${targetId}` }, waitingForDebugger: false });
+
+describe('QaFrameTargets', () => {
+  it('start enables flattened auto-attach on the parent session without pausing targets', async () => {
+    const { transport, sends } = fakeTransport();
+    await new QaFrameTargets(transport, 'PARENT').start();
+    expect(sends).toEqual([{ method: 'Target.setAutoAttach', params: { autoAttach: true, waitForDebuggerOnStart: false, flatten: true }, session: 'PARENT' }]);
+  });
+
+  it('lists only iframe targets attached under its own session, and follows detach and info changes', async () => {
+    const { transport, emit } = fakeTransport();

+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { PREVIEW_BUNDLE_MARKER, PreviewInBundleError, assertNoPreviewInBundle, findPreviewInBundle } from './preview-guard.js';
+import { RIGHTKIT_QA_PREVIEW_MARKER } from './preview.js';
+
+const dirs: string[] = [];
+afterEach(() => { for (const dir of dirs.splice(0)) fs.rmSync(dir, { recursive: true, force: true }); });
+const tmp = () => { const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'rkqa-bundle-')); dirs.push(dir); return dir; };
+
+describe('preview bundle guard', () => {
+  it('uses the same marker as the preview module', () => {
+    expect(PREVIEW_BUNDLE_MARKER).toBe(RIGHTKIT_QA_PREVIEW_MARKER);
+  });
+
+  it('passes a clean bundle and fails one that carries the marker', () => {
+    const dist = tmp();
+    fs.mkdirSync(path.join(dist, 'assets'));
+    fs.writeFileSync(path.join(dist, 'index.html'), '<html></html>');
+    fs.writeFileSync(path.join(dist, 'assets', 'app.js'), 'console.log("app")');
+    expect(() => assertNoPreviewInBundle([dist])).not.toThrow();
+    fs.writeFileSync(path.join(dist, 'assets', 'leak.js'), `const m = "${PREVIEW_BUNDLE_MARKER}";`);
+    expect(findPreviewInBundle([dist])).toEqual([path.join(dist, 'assets', 'leak.js')]);
+    expect(() => assertNoPreviewInBundle([dist])).toThrow(PreviewInBundleError);
+  });
+
+  it('accepts a single file and ignores a missing path and binary files', () => {
+    const dist = tmp();
+    const file = path.join(dist, 'main.js');
+    fs.writeFileSync(file, PREVIEW_BUNDLE_MARKER);
+    fs.writeFileSync(path.join(dist, 'logo.png'), PREVIEW_BUNDLE_MARKER);
+    expect(findPreviewInBundle([file])).toEqual([file]);
+    expect(findPreviewInBundle([dist])).toEqual([file]);
+    expect(findPreviewInBundle([path.join(dist, 'missing')])).toEqual([]);
+  });
+});
diff --git a/packages/qa/src/preview-guard.ts b/packages/qa/src/preview-guard.ts
new file mode 100644
index 0000000..920d2b8
--- /dev/null
+++ b/packages/qa/src/preview-guard.ts
@@ -0,0 +1,50 @@
+// Build-time half of the "browser preview is dev-only" rule (Orthic-Labs/rightkit#383). `@rightkit/qa/preview` carries a
+// marker string and refuses to run in a production build; this check fails a release build whose output still contains
+// the marker, so a mock data source can neither be bundled nor reach a user. It reads files only and never imports the
+// preview module.
+
+import fs from 'node:fs';
+import path from 'node:path';
+
+/** The marker `@rightkit/qa/preview` carries (`RIGHTKIT_QA_PREVIEW_MARKER`). Kept literal here so this module never loads it. */
+export const PREVIEW_BUNDLE_MARKER = '@rightkit/qa/preview:dev-only';
+
+export class PreviewInBundleError extends Error {
+  readonly files: string[];
+  constructor(files: string[]) {
+    super(`the browser-preview API (@rightkit/qa/preview) is in a release bundle: ${files.join(', ')}. Import it only dynamically behind import.meta.env.DEV so the bundler drops it.`);
+    this.name = 'PreviewInBundleError';
+    this.files = files;
+  }
+}
+
+const TEXT_EXTENSIONS = new Set(['.js', '.mjs', '.cjs', '.html', '.css', '.json', '.map', '.txt']);
+
+function* walk(root: string): Generator<string> {
+  let entries: fs.Dirent[];
+  try { entries = fs.readdirSync(root, { withFileTypes: true }); } catch { return; }
+  for (const entry of entries) {
+    const full = path.join(root, entry.name);
+    if (entry.isSymbolicLink()) continue;
+    if (entry.isDirectory()) yield* walk(full);
+    else if (entry.isFile() && TEXT_EXTENSIONS.has(path.extname(entry.name).toLowerCase())) yield full;
+  }
+}
+
+/** The files under `roots` (files or directories) whose text contains the preview marker. */
+export function findPreviewInBundle(roots: readonly string[]): string[] {
+  const found: string[] = [];
+  for (const root of roots) {
+    const files = fs.existsSync(root) && fs.statSync(root).isFile() ? [root] : [...walk(root)];
+    for (const file of files) {
+      try { if (fs.readFileSync(file, 'utf8').includes(PREVIEW_BUNDLE_MARKER)) found.push(file); } catch { /* unreadable: not text we can judge */ }
+    }
+  }
+  return found;
+}
+
+/** Throws {@link PreviewInBundleError} when any file under `roots` carries the marker. Run it on the release build output. */
+export function assertNoPreviewInBundle(roots: readonly string[]): void {
+  const found = findPreviewInBundle(roots);
+  if (found.length) throw new PreviewInBundleError(found);
+}

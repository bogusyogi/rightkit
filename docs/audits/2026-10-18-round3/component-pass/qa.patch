+import { describe, expect, it } from 'vitest';
+import { createInvokeMock, invokeMockInstallScript } from './invoke-mock.js';
+
+describe('createInvokeMock', () => {
+  it('answers from handlers or plain values and logs every call', async () => {
+    const mock = createInvokeMock({
+      get_settings: { theme: 'dark' },
+      add: (args) => Number(args?.a) + Number(args?.b),
+      nothing: undefined,
+    });
+    expect(await mock.invoke('get_settings')).toEqual({ theme: 'dark' });
+    expect(await mock.invoke('add', { a: 1, b: 2 })).toBe(3);
+    expect(await mock.invoke('nothing')).toBeUndefined();
+    expect(mock.calls.map((c) => c.command)).toEqual(['get_settings', 'add', 'nothing']);
+    expect(mock.callsTo('add')[0]?.args).toEqual({ a: 1, b: 2 });
+  });
+
+  it('rejects an unknown command, unless a fallback answers', async () => {
+    const mock = createInvokeMock();
+    await expect(mock.invoke('x')).rejects.toThrow('no mock for command: x');
+    expect(mock.calls).toHaveLength(1);
+    const lenient = createInvokeMock({}, { fallback: () => null });
+    expect(await lenient.invoke('x')).toBeNull();
+  });
+
+  it('on() replaces a handler and reset() clears the log', async () => {
+    const mock = createInvokeMock({ a: 1 });
+    mock.on('a', 2);
+    expect(await mock.invoke('a')).toBe(2);
+    mock.reset();
+    expect(mock.calls).toHaveLength(0);
+  });
+
+  it('propagates a handler error', async () => {
+    const mock = createInvokeMock({ bad: () => { throw new Error('boom'); } });
+    await expect(mock.invoke('bad')).rejects.toThrow('boom');
+  });
+});
+
+describe('invokeMockInstallScript', () => {
+  it('installs window.__TAURI_INTERNALS__.invoke with recorded calls and errors', async () => {
+    const win: Record<string, unknown> = {};
+    new Function('window', invokeMockInstallScript({ ok: { v: 1 }, fail: { $error: 'nope' } }))(win);
+    const internals = win.__TAURI_INTERNALS__ as { invoke(c: string, a?: unknown): Promise<unknown> };
+    expect(await internals.invoke('ok', { x: 1 })).toEqual({ v: 1 });
+    await expect(internals.invoke('fail')).rejects.toThrow('nope');
+    await expect(internals.invoke('missing')).rejects.toThrow('no mock for command: missing');
+    expect(win.__rightkitInvokeCalls).toEqual([
+      { command: 'ok', args: { x: 1 } },
+      { command: 'fail', args: null },
+      { command: 'missing', args: null },
+    ]);
+  });
+});
diff --git a/packages/qa/src/invoke-mock.ts b/packages/qa/src/invoke-mock.ts
new file mode 100644
index 0000000..8c85ec5
--- /dev/null
+++ b/packages/qa/src/invoke-mock.ts
@@ -0,0 +1,73 @@
+// A mock of Tauri's `invoke` for UI tests run in a plain browser. Lifted from ScrapeRight's qaMock: a command table
+// answered by handlers, a call log, and a script that installs the mock on `window.__TAURI_INTERNALS__` before the app boots.
+
+export type InvokeHandler = (args: Record<string, unknown> | undefined, command: string) => unknown | Promise<unknown>;
+
+export interface InvokeCall {
+  command: string;
+  args: Record<string, unknown> | undefined;
+}
+
+export interface InvokeMock {
+  invoke<T = unknown>(command: string, args?: Record<string, unknown>): Promise<T>;
+  /** Every call in order, including those with no handler. */
+  readonly calls: ReadonlyArray<InvokeCall>;
+  callsTo(command: string): InvokeCall[];
+  /** Replace or add a handler. */
+  on(command: string, handler: InvokeHandler | unknown): void;
+  reset(): void;
+}
+
+export interface InvokeMockOptions {
+  /** Answers for commands without a handler. Default: reject with `no mock for command: <name>`. */
+  fallback?: InvokeHandler;
+}
+
+function asHandler(value: InvokeHandler | unknown): InvokeHandler {
+  return typeof value === 'function' ? (value as InvokeHandler) : () => value;
+}
+
+/** Handlers map a command to a function or to a plain value returned as is (use `undefined` for unit results). */
+export function createInvokeMock(handlers: Record<string, InvokeHandler | unknown> = {}, options: InvokeMockOptions = {}): InvokeMock {
+  const table = new Map<string, InvokeHandler>(Object.entries(handlers).map(([k, v]) => [k, asHandler(v)]));
+  const calls: InvokeCall[] = [];
+  return {
+    async invoke<T>(command: string, args?: Record<string, unknown>): Promise<T> {
+      calls.push({ command, args });
+      const handler = table.get(command) ?? options.fallback;
+      if (!handler) throw new Error(`no mock for command: ${command}`);
+      return (await handler(args, command)) as T;
+    },
+    calls,
+    callsTo: (command) => calls.filter((c) => c.command === command),
+    on: (command, handler) => { table.set(command, asHandler(handler)); },
+    reset: () => { calls.length = 0; },
+  };
+}
+
+/**
+ * Script for `Page.addScriptToEvaluateOnNewDocument` (or an inline script) that installs a JSON-serialisable command
+ * table as Tauri's invoke. Values are returned as is; a value of the form `{ "$error": "message" }` rejects. Calls are
+ * recorded on `window.__rightkitInvokeCalls`.
+ */
+export function invokeMockInstallScript(responses: Record<string, unknown>): string {
+  return `
+    (function () {
+      var responses = ${JSON.stringify(responses)};
+      var calls = window.__rightkitInvokeCalls = window.__rightkitInvokeCalls || [];
+      var internals = window.__TAURI_INTERNALS__ = window.__TAURI_INTERNALS__ || {};
+      internals.invoke = function (command, args) {
+        calls.push({ command: command, args: args === undefined ? null : args });
+        if (!Object.prototype.hasOwnProperty.call(responses, command)) {
+          return Promise.reject(new Error('no mock for command: ' + command));
+        }
+        var value = responses[command];
+        if (value && typeof value === 'object' && typeof value.$error === 'string') {
+          return Promise.reject(new Error(value.$error));
+        }
+        return Promise.resolve(value);
+      };
+      return true;
+    })();
+  `;
+}

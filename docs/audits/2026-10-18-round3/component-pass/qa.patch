+    else if (channels === 2) { data[o] = data[o + 1] = data[o + 2] = pixels[p]!; data[o + 3] = pixels[p + 1]!; }
+    else { data[o] = pixels[p]!; data[o + 1] = pixels[p + 1]!; data[o + 2] = pixels[p + 2]!; data[o + 3] = channels === 4 ? pixels[p + 3]! : 255; }

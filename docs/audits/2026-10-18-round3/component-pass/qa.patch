+++ b/packages/qa/src/targets.ts
@@ -0,0 +1,111 @@
+import type { CdpAnyListener, CdpParams } from './cdp.js';
+
+/** The part of CdpClient the observer uses; a CdpClient satisfies it. */
+export interface QaTargetTransport {
+  send(method: string, params?: CdpParams, session?: string, timeout?: number): Promise<CdpParams>;
+  onAny(method: string, listener: CdpAnyListener): () => void;
+}
+
+/** One attached iframe target: a cross-origin or out-of-process frame with its own CDP session. */
+export interface FrameTargetInfo { sessionId: string; targetId: string; type: string; url: string; title: string }
+
+/** A frame target, selected by its session id, its target id, or a predicate over the listing. */
+export type FrameTargetSelector = string | ((info: FrameTargetInfo) => boolean);
+
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+/**
+ * Cross-origin / out-of-process iframes (OOPIF) are separate CDP targets: a selector or evaluate on the
+ * parent page never reaches into them. This attaches to each child iframe target of one page (or of the browser
+ * when built without a session), keeps a live list, and evaluates inside them.
+ *
+ * Built by `page.frameTargets()`, or directly from a CdpClient. Call `start()` first and `stop()` when done.
+ * Only targets of type "iframe" are listed; workers and other targets that auto-attach reports are ignored. Attaching never pauses a target (waitForDebuggerOnStart is false).
+ */
+export class QaFrameTargets {
+  private targetsBySession = new Map<string, FrameTargetInfo>();
+  private offs: Array<() => void> = [];
+  private started = false;
+
+  constructor(private transport: QaTargetTransport, private parentSession?: string, private timeout = 30_000) {}
+
+  /** Starts auto-attach and resolves once the targets that already exist have been reported. */
+  async start(): Promise<void> {
+    if (this.started) return;
+    this.started = true;
+    const mine = (session: string | undefined) => session === this.parentSession;
+    this.offs.push(
+      this.transport.onAny('Target.attachedToTarget', (params, session) => {
+        if (!mine(session)) return;
+        const info = params.targetInfo ?? {};
+        if (info.type !== 'iframe' || typeof params.sessionId !== 'string') return;
+        this.targetsBySession.set(params.sessionId, this.describe(params.sessionId, info));
+      }),
+      this.transport.onAny('Target.detachedFromTarget', (params, session) => {
+        if (mine(session)) this.targetsBySession.delete(params.sessionId);
+      }),
+      this.transport.onAny('Target.targetInfoChanged', (params) => {
+        const info = params.targetInfo ?? {};
+        for (const [sessionId, known] of this.targetsBySession) if (known.targetId === info.targetId) this.targetsBySession.set(sessionId, this.describe(sessionId, info));
+      }),
+    );
+    try {
+      await this.transport.send('Target.setAutoAttach', { autoAttach: true, waitForDebuggerOnStart: false, flatten: true }, this.parentSession, this.timeout);
+    } catch (error) { this.release(); throw error; }
+  }
+
+  /** The iframe targets attached now, in attach order. */
+  targets(): FrameTargetInfo[] { return [...this.targetsBySession.values()]; }
+
+  /** Waits for one target to attach, or returns it at once when it already has. */
+  async waitForTarget(selector: FrameTargetSelector, options: { timeout?: number } = {}): Promise<FrameTargetInfo> {
+    const timeout = options.timeout ?? this.timeout;
+    if (!Number.isFinite(timeout) || timeout <= 0) throw new Error('timeout must be a positive finite number');
+    const deadline = Date.now() + timeout;
+    for (;;) {
+      const found = this.find(selector);
+      if (found) return found;
+      if (Date.now() >= deadline) throw new Error(`No iframe target matched within ${timeout}ms; attached: ${JSON.stringify(this.targets().map((t) => t.url))}`);
+      await sleep(25);
+    }
+  }
+
+  /**
+   * Evaluates `expression` in the selected target's main frame with Runtime.evaluate (awaits a promise, returns by
+   * value). A thrown page error becomes an Error with the page's message.
+   */
+  async evaluate<T = unknown>(selector: FrameTargetSelector, expression: string): Promise<T> {
+    if (typeof expression !== 'string' || !expression) throw new Error('evaluate needs a non-empty expression string');
+    const target = this.find(selector);
+    if (!target) throw new Error('No attached iframe target matches the selector');
+    const result = await this.transport.send('Runtime.evaluate', { expression, returnByValue: true, awaitPromise: true }, target.sessionId, this.timeout);
+    if (result.exceptionDetails) {
+      const detail = result.exceptionDetails;
+      throw new Error(detail.exception?.description ?? detail.exception?.value ?? detail.text ?? 'Evaluation failed');
+    }
+    return result.result?.value as T;
+  }
+
+  /** Stops auto-attach and drops the listing. Safe to call twice. */
+  async stop(): Promise<void> {
+    if (!this.started) return;
+    this.release();
+    this.targetsBySession.clear();
+    try { await this.transport.send('Target.setAutoAttach', { autoAttach: false, waitForDebuggerOnStart: false, flatten: true }, this.parentSession, this.timeout); }
+    catch { /* the page or socket is already gone */ }
+  }
+
+  private release() {
+    for (const off of this.offs.splice(0)) off();
+    this.started = false;
+  }
+  private find(selector: FrameTargetSelector): FrameTargetInfo | undefined {
+    const all = this.targets();
+    if (typeof selector === 'function') return all.find(selector);
+    if (typeof selector !== 'string' || !selector) throw new Error('selector must be a session id, a target id or a predicate');
+    return all.find((info) => info.sessionId === selector || info.targetId === selector);
+  }
+  private describe(sessionId: string, info: CdpParams): FrameTargetInfo {
+    return { sessionId, targetId: String(info.targetId), type: String(info.type), url: String(info.url ?? ''), title: String(info.title ?? '') };
+  }
+}

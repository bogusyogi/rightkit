diff --git a/crates/rightkit-qa/src/isolation.rs b/crates/rightkit-qa/src/isolation.rs
new file mode 100644
index 0000000..7bd88bd
--- /dev/null
+++ b/crates/rightkit-qa/src/isolation.rs
@@ -0,0 +1,248 @@
+//! Isolated native-real runs: the real app, never the user's real data.
+//!
+//! Lifted from CutRight (`engine_supervisor::qa_isolation_env`, `create_main_window`, `dialog.ts`;
+//! Orthic-Labs/rightkit#468) and ScrapeRight (`license::qa_native_real_mode`, the
+//! `RIGHTKIT_QA_NATIVE_REAL` switch). An app calls these from its QA-only code paths; every function
+//! is inert unless the launcher's environment asks for it.
+//!
+//! * `RIGHTKIT_QA_NATIVE=1` says the app runs under the QA launcher: every store (data, webview,
+//!   logs, cache) lives under `RIGHTKIT_QA_DATA_DIR`.
+//! * `RIGHTKIT_QA_NATIVE_REAL=1` is the stricter mode: the real app on deterministic Free
+//!   entitlements, no OS credential store, no browser sign-in, no cloud sync, and a window that is
+//!   never shown or focused. It implies `RIGHTKIT_QA_NATIVE`.
+use crate::util::{err, Result};
+use serde_json::Value;
+use std::path::{Path, PathBuf};
+
+pub const ENV_NATIVE: &str = "RIGHTKIT_QA_NATIVE";
+pub const ENV_NATIVE_REAL: &str = "RIGHTKIT_QA_NATIVE_REAL";
+pub const ENV_DATA_DIR: &str = "RIGHTKIT_QA_DATA_DIR";
+/// The page global the dialog seam reads (see [`dialog_answer_js`]).
+pub const DIALOG_GLOBAL: &str = "__RIGHTKIT_QA_DIALOG__";
+
+fn flag(name: &str) -> bool {
+    std::env::var(name).as_deref() == Ok("1")
+}
+
+/// `RIGHTKIT_QA_NATIVE_REAL=1`: the isolated native-real mode. Apps compile their use of this
+/// only into dev builds with the QA feature (a release build must not even read it).
+pub fn native_real_mode() -> bool {
+    flag(ENV_NATIVE_REAL)
+}
+
+/// Running under the QA launcher (`RIGHTKIT_QA_NATIVE=1`, or native-real, which implies it).
+pub fn native_qa_enabled() -> bool {
+    flag(ENV_NATIVE) || native_real_mode()
+}
+
+/// The run's isolated data directory, only inside a QA run that also named one.
+pub fn qa_data_dir() -> Option<PathBuf> {
+    if !native_qa_enabled() {
+        return None;
+    }
+    std::env::var_os(ENV_DATA_DIR)
+        .filter(|v| !v.is_empty())
+        .map(PathBuf::from)
+}
+
+/// `<qa data dir>/<sub>` in a QA run (logs, cache, playback), else `None` so the caller keeps its
+/// normal location.
+pub fn qa_subdir(sub: &str) -> Option<PathBuf> {
+    qa_data_dir().map(|d| d.join(sub))
+}
+
+/// The error text of a credential, sign-in or sync path refused in native-real mode.
+pub fn credential_bypass_error(what: &str) -> String {
+    format!("{what} disabled in qa-native-real Free mode")
+}
+
+/// Refuse `what` (an OS credential store, browser sign-in, auth import, cloud sync, a cookies path)
+/// in native-real mode; `Ok` otherwise.
+pub fn refuse_in_native_real(what: &str) -> Result<()> {
+    if native_real_mode() {
+        return err(credential_bypass_error(what));
+    }
+    Ok(())
+}
+
+/// Launch environment for a native-real run rooted at `run_root`: data, shared suite and QA
+/// switches, all inside the run root. Refuses a root that is relative, empty, a filesystem root,
+/// or the user's home directory or one of its parents, so a mistake can never aim the app at real
+/// user data. Extra app-specific keys (data, output, engine) are the caller's.
+pub fn native_real_env(run_root: &Path) -> Result<Vec<(String, String)>> {
+    refuse_unsafe_root(run_root)?;
+    let data = run_root.join("data");
+    let suite = run_root.join("suite");
+    let text = |p: &Path| p.to_string_lossy().into_owned();
+    Ok(vec![
+        (ENV_NATIVE.into(), "1".into()),
+        (ENV_NATIVE_REAL.into(), "1".into()),
+        (ENV_DATA_DIR.into(), text(&data)),
+        ("RIGHT_SUITE_DIR".into(), text(&suite)),
+        ("ORTHIC_SHARED_DIR".into(), text(&suite)),
+    ])
+}
+
+fn refuse_unsafe_root(root: &Path) -> Result<()> {
+    if root.as_os_str().is_empty() || !root.is_absolute() || root.parent().is_none() {
+        return err(format!(
+            "native-real run root '{}' must be an absolute directory below a filesystem root",
+            root.display()
+        ));
+    }
+    let home = std::env::var_os("HOME")
+        .or_else(|| std::env::var_os("USERPROFILE"))
+        .map(PathBuf::from);
+    if let Some(home) = home {
+        if home.starts_with(root) {
+            return err(format!(
+                "native-real run root '{}' is the user's home directory or one of its parents; refusing so real user data is never touched",
+                root.display()
+            ));
+        }
+    }
+    Ok(())
+}
+
+/// Environment for a child engine process in a QA run, keeping everything under the run's data
+/// directory: `HOME`, the suite directories and, on Windows, `LOCALAPPDATA`, `APPDATA` and
+/// `USERPROFILE` (Windows resolves data folders from the profile, so the profile must be the
+/// isolated home with the folders in place). Creates the directories. Empty outside a QA run.
+pub fn engine_isolation_env() -> Vec<(String, String)> {
+    match qa_data_dir() {
+        Some(data) => engine_isolation_env_for(&data),
+        None => Vec::new(),
+    }
+}
+
+/// [`engine_isolation_env`] for an explicit data directory.
+pub fn engine_isolation_env_for(data: &Path) -> Vec<(String, String)> {
+    let home = data.join("home");
+    let shared = data.join("shared");
+    let _ = std::fs::create_dir_all(&home);
+    let _ = std::fs::create_dir_all(&shared);
+    let text = |p: &Path| p.to_string_lossy().into_owned();
+    let mut env = vec![
+        ("HOME".to_string(), text(&home)),
+        ("ORTHIC_SHARED_DIR".to_string(), text(&shared)),
+        ("RIGHT_SUITE_DIR".to_string(), text(&shared)),
+    ];
+    if cfg!(windows) {
+        for (key, sub) in [("LOCALAPPDATA", "Local"), ("APPDATA", "Roaming")] {
+            let dir = home.join("AppData").join(sub);
+            let _ = std::fs::create_dir_all(&dir);
+            env.push((key.to_string(), text(&dir)));
+        }
+        env.push(("USERPROFILE".to_string(), text(&home)));
+    }
+    env
+}
+
+/// The per-run webview storage directory (`<data>/webview`), for the window builder's
+/// `data_directory`.
+pub fn webview_data_dir(data: &Path) -> PathBuf {
+    data.join("webview")
+}
+
+/// The 16-byte WKWebsiteDataStore identifier macOS keys webview storage by, derived from the run's
+/// data directory so each run has its own store and the user's app and other runs never share one.
+pub fn webview_store_id(data: &Path) -> [u8; 16] {
+    let mut id = [0u8; 16];
+    for (i, b) in data.to_string_lossy().bytes().enumerate() {
+        id[i % 16] = id[i % 16].wrapping_mul(31).wrapping_add(b);
+    }
+    id
+}
+
+/// Webview initialization script for a silent QA run: every audio and video element starts muted.
+pub const MUTE_MEDIA_SCRIPT: &str = "const play = HTMLMediaElement.prototype.play;
+HTMLMediaElement.prototype.play = function () { this.muted = true; return play.apply(this, arguments); };
+document.addEventListener('play', (e) => { if (e.target instanceof HTMLMediaElement) e.target.muted = true; }, true);";
+
+/// JS the harness evaluates in the page to make the next native dialogs (folder, files) return
+/// `answer` instead of opening an OS sheet, until changed. The app's dialog wrapper reads
+/// [`DIALOG_GLOBAL`] first (compiled into QA builds only).
+pub fn dialog_answer_js(answer: &Value) -> String {
+    format!("window.{DIALOG_GLOBAL} = {answer}; return true;")
+}
+
+/// The TypeScript dialog seam an app compiles into QA builds (guard it with the app's own QA build
+/// flag): the value the harness set, or `undefined` to open the real dialog.
+pub const DIALOG_SEAM_TS: &str = "function qaAnswer(): string | string[] | null | undefined {
+  return (window as unknown as { __RIGHTKIT_QA_DIALOG__?: string | string[] | null }).__RIGHTKIT_QA_DIALOG__;
+}";
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn pure_forms_are_stable() {
+        assert_eq!(
+            credential_bypass_error("browser sign-in"),
+            "browser sign-in disabled in qa-native-real Free mode"
+        );
+        assert_eq!(
+            dialog_answer_js(&json!("/x")),
+            "window.__RIGHTKIT_QA_DIALOG__ = \"/x\"; return true;"
+        );
+        assert!(DIALOG_SEAM_TS.contains(DIALOG_GLOBAL));
+    }
+
+    #[test]
+    fn native_real_env_stays_inside_the_run_root_and_refuses_unsafe_roots() {
+        let root = std::env::temp_dir().join("rkqa-nr-root");
+        let env = native_real_env(&root).unwrap();
+        let get = |k: &str| env.iter().find(|(n, _)| n == k).map(|(_, v)| v.clone());
+        assert_eq!(get(ENV_NATIVE).as_deref(), Some("1"));
+        assert_eq!(get(ENV_NATIVE_REAL).as_deref(), Some("1"));
+        let root_text = root.to_string_lossy().into_owned();
+        for k in [ENV_DATA_DIR, "RIGHT_SUITE_DIR", "ORTHIC_SHARED_DIR"] {
+            assert!(get(k).unwrap().starts_with(&root_text), "{k}");
+        }
+        assert!(native_real_env(Path::new("relative/dir")).is_err());
+        assert!(native_real_env(Path::new("")).is_err());
+        let anchor = std::env::temp_dir()
+            .ancestors()
+            .last()
+            .unwrap()
+            .to_path_buf();
+        assert!(native_real_env(&anchor).is_err(), "a filesystem root is refused");
+        if let Some(home) = std::env::var_os("HOME").or_else(|| std::env::var_os("USERPROFILE")) {
+            let home = PathBuf::from(home);
+            if home.is_absolute() {
+                assert!(native_real_env(&home).is_err(), "the home directory is refused");
+                if let Some(parent) = home.parent().filter(|p| p.parent().is_some()) {
+                    assert!(native_real_env(parent).is_err(), "a parent of home is refused");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn engine_env_keeps_state_under_the_data_dir() {
+        let data = std::env::temp_dir().join(format!("rkqa-iso-{}", crate::util::new_id()));
+        let env = engine_isolation_env_for(&data);
+        let get = |k: &str| env.iter().find(|(n, _)| n == k).map(|(_, v)| PathBuf::from(v));
+        assert_eq!(get("HOME").unwrap(), data.join("home"));
+        assert_eq!(get("RIGHT_SUITE_DIR").unwrap(), data.join("shared"));
+        assert_eq!(get("ORTHIC_SHARED_DIR").unwrap(), data.join("shared"));
+        assert!(data.join("home").is_dir() && data.join("shared").is_dir());
+        if cfg!(windows) {
+            assert_eq!(get("USERPROFILE").unwrap(), data.join("home"));
+            assert!(get("LOCALAPPDATA").unwrap().is_dir());
+            assert!(get("APPDATA").unwrap().is_dir());
+        }
+        let _ = std::fs::remove_dir_all(&data);
+    }
+
+    #[test]
+    fn the_webview_store_id_is_stable_per_run_and_differs_between_runs() {
+        let a = Path::new("/qa/run-a");
+        let b = Path::new("/qa/run-b");
+        assert_eq!(webview_store_id(a), webview_store_id(a));
+        assert_ne!(webview_store_id(a), webview_store_id(b));
+        assert_eq!(webview_data_dir(a), a.join("webview"));
+    }
+}
diff --git a/crates/rightkit-qa/src/legal_gate.rs b/crates/rightkit-qa/src/legal_gate.rs
new file mode 100644
index 0000000..c7e8323
--- /dev/null
+++ b/crates/rightkit-qa/src/legal_gate.rs
@@ -0,0 +1,155 @@
+//! The first-run legal gate helper for [`Control`] (Orthic-Labs/rightkit#387). Failure evidence, the
+//! page-error recorder, click-until-state and the live log path are already on `Control`
+//! (`failure_evidence`, `record_page_errors`, `click_until`, `live_log_path`); the legal gate every app
+//! shows once was still hand-rolled in each app's QA tests (ViewRight `common/mod.rs`).
+use crate::control::Control;
+use crate::util::Result;
+use serde_json::Value;
+use std::time::Duration;
+
+/// The first-run legal gate. The defaults match the RightKit legal gate component
+/// (`.rk-legal-gate`, an `individual` radio, an acknowledgement checkbox, an `Agree & continue`
+/// button).
+#[derive(Debug, Clone)]
+pub struct LegalGate {
+    /// Root element of the gate.
+    pub root: String,
+    /// Selector of the app's mounted workspace; the default `#root > *` means "the app rendered".
+    /// The gate counts as mounted when either it or this shows, and as cleared when this shows
+    /// and the gate is gone.
+    pub ready: String,
+    /// Controls to check, in order (selectors).
+    pub checks: Vec<String>,
+    /// Visible text of the accept button.
+    pub agree_label: String,
+}
+
+impl Default for LegalGate {
+    fn default() -> Self {
+        let root = ".rk-legal-gate".to_string();
+        Self {
+            ready: "#root > *".to_string(),
+            checks: vec![
+                format!("{root} input[type=\"radio\"][value=\"individual\"]"),
+                format!("{root} input[type=\"checkbox\"]"),
+            ],
+            agree_label: "Agree & continue".to_string(),
+            root,
+        }
+    }
+}
+
+fn js_str(s: &str) -> String {
+    serde_json::to_string(s).unwrap_or_else(|_| "\"\"".into())
+}
+
+/// JS function body: truthy when the gate or the workspace (`ready`) is in the page.
+pub fn gate_mounted_js(root: &str, ready: &str) -> String {
+    format!(
+        "return !!document.querySelector({}) || !!document.querySelector({});",
+        js_str(root),
+        js_str(ready)
+    )
+}
+
+/// JS function body: truthy when the workspace (`ready`) shows and the gate is gone.
+pub fn gate_done_js(root: &str, ready: &str) -> String {
+    format!(
+        "return !!document.querySelector({}) && !document.querySelector({});",
+        js_str(ready),
+        js_str(root)
+    )
+}
+
+/// JS function body: truthy when the first match of `selector` is checked.
+pub fn checked_js(selector: &str) -> String {
+    format!(
+        "var e=document.querySelector({}); return !!e && e.checked === true;",
+        js_str(selector)
+    )
+}
+
+/// JS function body: the centre `[x, y]` of the enabled button inside `root` whose trimmed text is
+/// `label`, else null.
+pub fn button_point_js(root: &str, label: &str) -> String {
+    format!(
+        "var b=Array.from(document.querySelectorAll({} + ' button')).find(function(x){{return x.textContent.trim()==={} && !x.disabled;}}); if(!b) return null; var r=b.getBoundingClientRect(); return [r.left+r.width/2, r.top+r.height/2];",
+        js_str(root),
+        js_str(label)
+    )
+}
+
+fn truthy(v: &Value) -> bool {
+    !matches!(v, Value::Null | Value::Bool(false)) && v != &Value::from(0) && v != &Value::from("")
+}
+
+impl Control {
+    /// Complete the first-run legal gate through the real UI when it shows. Returns whether a gate
+    /// was shown. Fails when the app never mounts or the gate does not clear.
+    pub fn accept_legal_gate(&self, gate: &LegalGate) -> Result<bool> {
+        self.wait_eval(
+            &gate_mounted_js(&gate.root, &gate.ready),
+            Duration::from_secs(60),
+        )?;
+        let root = js_str(&gate.root);
+        let shown = self
+            .eval(&format!("return !!document.querySelector({root})"))
+            .map(|v| truthy(&v))
+            .unwrap_or(false);
+        if !shown {
+            return Ok(false);
+        }
+        for selector in &gate.checks {
+            self.click_until(selector, &checked_js(selector), 3, Duration::from_secs(2))?;
+        }
+        let point = self.wait_eval(
+            &button_point_js(&gate.root, &gate.agree_label),
+            Duration::from_secs(10),
+        )?;
+        let x = point.get(0).and_then(Value::as_f64).unwrap_or(0.0);
+        let y = point.get(1).and_then(Value::as_f64).unwrap_or(0.0);
+        self.click(x, y, "left", 1)?;
+        self.wait_eval(
+            &gate_done_js(&gate.root, &gate.ready),
+            Duration::from_secs(30),
+        )?;
+        Ok(true)
+    }
+}
+

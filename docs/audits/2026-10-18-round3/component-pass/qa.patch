+//! The `rightkit-fake-cli` binary end to end: stdin in, stdout/stderr/exit out, hang and heartbeat child.
+use std::io::Write;
+use std::path::PathBuf;
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+fn dir(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("rk-fake-cli-it-{}-{name}", std::process::id()));
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn run(script: &std::path::Path, args: &[&str], stdin: &str, envs: &[(&str, &str)]) -> (i32, String, String) {
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_rightkit-fake-cli"));
+    cmd.arg("--fake-cli-script").arg(script).args(args);
+    for (k, v) in envs {
+        cmd.env(k, v);
+    }
+    let mut child = cmd.stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn().unwrap();
+    child.stdin.take().unwrap().write_all(stdin.as_bytes()).unwrap();
+    let out = child.wait_with_output().unwrap();
+    (
+        out.status.code().unwrap_or(-1),
+        String::from_utf8_lossy(&out.stdout).into_owned(),
+        String::from_utf8_lossy(&out.stderr).into_owned(),
+    )
+}
+
+#[test]
+fn model_cli_modes() {
+    let d = dir("llm");
+    let script = d.join("llm.json");
+    std::fs::write(
+        &script,
+        r#"{"rules":[
+          {"when":{"env_eq":{"MODE":"fail"}},"respond":{"stderr":"nope\n","exit":2}},
+          {"when":{"argv_first":"-p"},"respond":{"stdout_json":{"is_error":false,"result":"got ${stdin_bytes}"}}}],
+         "default":{"stdout":"plain ${stdin_bytes}\n"}}"#,
+    )
+    .unwrap();
+    assert_eq!(run(&script, &["-p"], "abc", &[]), (0, "{\"is_error\":false,\"result\":\"got 3\"}\n".into(), String::new()));
+    assert_eq!(run(&script, &["exec"], "abcd", &[]), (0, "plain 4\n".into(), String::new()));
+    assert_eq!(run(&script, &["-p"], "x", &[("MODE", "fail")]), (2, String::new(), "nope\n".into()));
+}
+
+#[test]
+fn stdin_expectation_and_record() {
+    let d = dir("expect");
+    let script = d.join("s.toml");
+    let record = d.join("rec.jsonl");
+    std::fs::write(
+        &script,
+        format!(
+            "record = {:?}\n[default]\nstdout = \"fine\"\n[default.expect_stdin]\ncontains = \"ping\"\n",
+            record.to_str().unwrap()
+        ),
+    )
+    .unwrap();
+    let (code, _, err) = run(&script, &["a"], "pong", &[]);
+    assert_eq!(code, 64);
+    assert!(err.contains("expected stdin"));
+    assert_eq!(run(&script, &["a"], "ping", &[]).0, 0);
+    let lines = std::fs::read_to_string(&record).unwrap();
+    assert_eq!(lines.lines().count(), 2);
+}
+
+#[test]
+fn hang_and_heartbeat_child() {
+    let d = dir("hang");
+    let beat = d.join("beat");
+    let script = d.join("s.json");
+    std::fs::write(
+        &script,
+        format!(
+            r#"{{"default":{{"spawn_child":{{"heartbeat":{:?},"lifetime_secs":5}},"hang":30}}}}"#,
+            beat.to_str().unwrap()
+        ),
+    )
+    .unwrap();
+    let mut child = Command::new(env!("CARGO_BIN_EXE_rightkit-fake-cli"))
+        .arg("--fake-cli-script")
+        .arg(&script)
+        .stdin(Stdio::null())
+        .spawn()
+        .unwrap();
+    let start = Instant::now();
+    while std::fs::metadata(&beat).map(|m| m.len() == 0).unwrap_or(true) {
+        assert!(start.elapsed() < Duration::from_secs(10), "no heartbeat");
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    assert!(child.try_wait().unwrap().is_none(), "the fake should still be hanging");
+    let _ = child.kill();
+    let _ = child.wait();
+}

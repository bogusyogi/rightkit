index 0000000..d998e12
--- /dev/null
+++ b/packages/qa/src/control-cli.ts
@@ -0,0 +1,72 @@
+#!/usr/bin/env node
+// `rightkit-qa-control`: call one method of an embedded control server from a shell (Orthic-Labs/rightkit#752).
+//
+//   rightkit-qa-control [--suite <root>] [--service <name>] [--app <label>] [--timeout <ms>] <method> [<json params>]
+//
+// The suite root and service default to RIGHTKIT_SUITE_ROOT and RIGHTKIT_CONTROL_SERVICE, which the launcher sets.
+// The JSON result is printed on stdout; an error is printed on stderr and the exit code is 1 (2 for a usage error).
+
+import { ControlClient, ControlError } from './control.js';
+
+export interface ControlCliArgs {
+  suiteRoot?: string;
+  service?: string;
+  app?: string;
+  timeoutMs?: number;
+  method: string;
+  params: unknown;
+}
+
+/** Parses the argument list; throws a usage Error with a message the CLI prints. */
+export function parseControlArgs(argv: readonly string[]): ControlCliArgs {
+  const out: Partial<ControlCliArgs> = {};
+  const positional: string[] = [];
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i];
+    const value = (): string => {
+      const next = argv[i += 1];
+      if (next === undefined) throw new Error(`${arg} needs a value`);
+      return next;
+    };
+    if (arg === '--suite') out.suiteRoot = value();
+    else if (arg === '--service') out.service = value();
+    else if (arg === '--app') out.app = value();
+    else if (arg === '--timeout') {
+      const ms = Number(value());
+      if (!Number.isFinite(ms) || ms <= 0) throw new Error('--timeout must be a positive number of milliseconds');
+      out.timeoutMs = ms;
+    } else if (arg.startsWith('--')) throw new Error(`unknown option ${arg}`);
+    else positional.push(arg);
+  }
+  const [method, rawParams, ...extra] = positional;
+  if (!method) throw new Error('missing <method>');
+  if (extra.length) throw new Error(`unexpected argument ${extra[0]}`);
+  let params: unknown = {};
+  if (rawParams !== undefined) {
+    try { params = JSON.parse(rawParams); } catch (error) { throw new Error(`params are not JSON: ${error instanceof Error ? error.message : String(error)}`); }
+  }
+  return { ...out, method, params };
+}
+
+async function main(): Promise<number> {
+  let args: ControlCliArgs;
+  try { args = parseControlArgs(process.argv.slice(2)); } catch (error) {
+    process.stderr.write(`rightkit-qa-control: ${error instanceof Error ? error.message : String(error)}\nusage: rightkit-qa-control [--suite <root>] [--service <name>] [--app <label>] [--timeout <ms>] <method> [<json params>]\n`);
+    return 2;
+  }
+  let client: ControlClient | undefined;
+  try {
+    client = await ControlClient.connect({ suiteRoot: args.suiteRoot, service: args.service, app: args.app, timeoutMs: args.timeoutMs });
+    const result = await client.call(args.method, args.params);
+    process.stdout.write(`${JSON.stringify(result)}\n`);
+    return 0;
+  } catch (error) {
+    process.stderr.write(`${error instanceof ControlError ? error.message : error instanceof Error ? error.message : String(error)}\n`);
+    return 1;
+  } finally { client?.close(); }
+}
+
+// Run only as the entry point, never when imported by a test.
+if (process.argv[1] && /control-cli\.[cm]?[jt]s$/.test(process.argv[1])) {
+  main().then((code) => { process.exitCode = code; });
+}

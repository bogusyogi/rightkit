@@ -0,0 +1,165 @@
+import { describe, expect, it } from 'vitest';
+import { QaKeyboard } from './keyboard.js';
+import { QaPage } from './page.js';
+
+/** A recording fake CDP client: logs sends, answers via `reply`, and delivers events through `emit`. */
+function fake(reply: (method: string, params: any) => any = () => ({})) {
+  const sends: Array<{ method: string; params: any }> = [];
+  const listeners = new Map<string, Set<(params: any) => void>>();
+  const client: any = {
+    timeout: 1000,
+    send: async (method: string, params: any = {}) => { sends.push({ method, params }); return reply(method, params) ?? {}; },
+    on: (method: string, listener: (params: any) => void) => {
+      const set = listeners.get(method) ?? new Set(); listeners.set(method, set); set.add(listener);
+      return () => set.delete(listener);
+    },
+    onAny: () => () => {},
+    rejectSession: () => {},
+  };
+  const page = new QaPage(client, 'T1', 'S1', () => {});
+  const emit = (method: string, params: any) => { for (const l of [...(listeners.get(method) ?? [])]) l(params); };
+  const settle = () => new Promise<void>((resolve) => setTimeout(resolve, 10));
+  return { page, sends, emit, settle, listeners };
+}
+
+describe('keyboard.tap commands', () => {
+  it('sends commands on the keyDown only', async () => {
+    const calls: any[] = [];
+    const keyboard = new QaKeyboard(async (method, params) => { calls.push({ method, params }); return {}; });
+    await keyboard.tap({ key: 'a', code: 'KeyA', modifiers: 4, commands: ['selectAll'] });
+    expect(calls).toEqual([
+      { method: 'Input.dispatchKeyEvent', params: { type: 'keyDown', key: 'a', code: 'KeyA', modifiers: 4, commands: ['selectAll'] } },
+      { method: 'Input.dispatchKeyEvent', params: { type: 'keyUp', key: 'a', code: 'KeyA', modifiers: 4 } },
+    ]);
+  });
+  it('rejects empty or malformed commands before sending', async () => {
+    const calls: any[] = [];
+    const keyboard = new QaKeyboard(async (method, params) => { calls.push({ method, params }); return {}; });
+    await expect(keyboard.tap({ key: 'a', commands: [] })).rejects.toThrow('tap commands');
+    await expect(keyboard.tap({ key: 'a', commands: [''] })).rejects.toThrow('tap commands');
+    expect(calls).toEqual([]);
+  });
+});
+
+describe('dialogs', () => {
+  it('handleDialog sends accept and promptText', async () => {
+    const { page, sends } = fake();
+    await page.handleDialog({ accept: true, promptText: 'x' });
+    await page.handleDialog({ accept: false });
+    expect(sends.map((s) => [s.method, s.params])).toEqual([
+      ['Page.handleJavaScriptDialog', { accept: true, promptText: 'x' }],
+      ['Page.handleJavaScriptDialog', { accept: false }],
+    ]);
+  });
+  it('onDialog answers by handler result, defaults to accept, dismisses on a throw, and unsubscribes', async () => {
+    const { page, sends, emit, settle } = fake();
+    const seen: any[] = [];
+    const off = page.onDialog((dialog) => {
+      seen.push(dialog);
+      if (dialog.type === 'beforeunload') return;
+      if (dialog.type === 'prompt') return { accept: true, promptText: 'yes' };
+      if (dialog.type === 'confirm') return false;
+      throw new Error('boom');
+    });
+    emit('Page.javascriptDialogOpening', { type: 'beforeunload', message: 'm', url: 'u' });
+    emit('Page.javascriptDialogOpening', { type: 'prompt', message: 'm', url: 'u', defaultPrompt: 'd' });
+    emit('Page.javascriptDialogOpening', { type: 'confirm', message: 'm', url: 'u' });
+    emit('Page.javascriptDialogOpening', { type: 'alert', message: 'm', url: 'u' });
+    await settle();
+    expect(seen.map((d) => d.type)).toEqual(['beforeunload', 'prompt', 'confirm', 'alert']);
+    expect(sends.map((s) => s.params).sort((a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b)))).toEqual([
+      { accept: false }, { accept: false }, { accept: true }, { accept: true, promptText: 'yes' },
+    ]);
+    off();
+    emit('Page.javascriptDialogOpening', { type: 'alert', message: 'm', url: 'u' });
+    await settle();
+    expect(sends).toHaveLength(4);
+  });
+  it('a failing handleJavaScriptDialog does not escape', async () => {
+    const { page, emit, settle } = fake((method) => { if (method === 'Page.handleJavaScriptDialog') throw new Error('no dialog'); });
+    page.onDialog(() => true);
+    emit('Page.javascriptDialogOpening', { type: 'alert', message: '', url: '' });
+    await settle();
+  });
+});
+
+describe('interceptRequests', () => {
+  const paused = (requestId: string, url: string) => ({ requestId, resourceType: 'Fetch', request: { url, method: 'GET', headers: { A: 'b' } } });
+  it('enables Fetch, fulfills with base64 body, continues otherwise, fails on request, and disables on stop', async () => {
+    const { page, sends, emit, settle } = fake();
+    const interception = await page.interceptRequests([{ urlPattern: '*.md', requestStage: 'Request' }], (request) => {
+      if (request.url.endsWith('a.md')) return { action: 'fulfill', status: 201, headers: { 'Content-Type': 'text/markdown' }, body: 'hi' };
+      if (request.url.endsWith('b.md')) return { action: 'fail', errorReason: 'NameNotResolved' };
+      if (request.url.endsWith('c.md')) return { action: 'continue', headers: { X: 'y' } };
+    });
+    expect(sends[0]).toEqual({ method: 'Fetch.enable', params: { patterns: [{ urlPattern: '*.md', requestStage: 'Request' }] } });
+    for (const [id, name] of [['1', 'a'], ['2', 'b'], ['3', 'c'], ['4', 'd']]) emit('Fetch.requestPaused', paused(id, `http://x/${name}.md`));
+    await settle();
+    const by = (id: string) => sends.find((s) => s.params.requestId === id)!;
+    expect(by('1')).toEqual({ method: 'Fetch.fulfillRequest', params: { requestId: '1', responseCode: 201, responseHeaders: [{ name: 'Content-Type', value: 'text/markdown' }], body: Buffer.from('hi').toString('base64') } });
+    expect(by('2')).toEqual({ method: 'Fetch.failRequest', params: { requestId: '2', errorReason: 'NameNotResolved' } });
+    expect(by('3')).toEqual({ method: 'Fetch.continueRequest', params: { requestId: '3', headers: [{ name: 'X', value: 'y' }] } });
+    expect(by('4')).toEqual({ method: 'Fetch.continueRequest', params: { requestId: '4' } });
+    await interception.stop();
+    expect(sends.at(-1)!.method).toBe('Fetch.disable');
+    const count = sends.length;
+    emit('Fetch.requestPaused', paused('5', 'http://x/e.md'));
+    await settle();
+    expect(sends).toHaveLength(count);
+  });
+  it('continues the request and records the error when the handler throws', async () => {
+    const { page, sends, emit, settle } = fake();
+    const interception = await page.interceptRequests([{ urlPattern: '*' }], () => { throw new Error('bad'); });
+    emit('Fetch.requestPaused', paused('9', 'http://x/'));
+    await settle();
+    expect(sends.at(-1)).toEqual({ method: 'Fetch.continueRequest', params: { requestId: '9' } });
+    expect(interception.errors.map((e) => e.message)).toEqual(['bad']);
+  });
+  it('refuses no patterns and unsubscribes when Fetch.enable fails', async () => {
+    const { page, listeners } = fake((method) => { if (method === 'Fetch.enable') throw new Error('nope'); });
+    await expect(page.interceptRequests([], () => {})).rejects.toThrow('at least one pattern');
+    await expect(page.interceptRequests([{ urlPattern: '*' }], () => {})).rejects.toThrow('nope');
+    expect(listeners.get('Fetch.requestPaused')?.size ?? 0).toBe(0);
+  });
+});
+
+describe('sampleMemory', () => {
+  it('reads heap usage and DOM counters, collecting garbage first on request', async () => {
+    const { page, sends } = fake((method) => {
+      if (method === 'Runtime.getHeapUsage') return { usedSize: 1000, totalSize: 4000 };
+      if (method === 'Memory.getDOMCounters') return { documents: 2, nodes: 30, jsEventListeners: 4 };
+    });
+    expect(await page.sampleMemory({ collectGarbage: true })).toEqual({ usedHeapBytes: 1000, totalHeapBytes: 4000, domNodes: 30, domDocuments: 2, jsEventListeners: 4 });
+    expect(sends.map((s) => s.method)).toEqual(['HeapProfiler.enable', 'HeapProfiler.collectGarbage', 'Runtime.getHeapUsage', 'Memory.getDOMCounters']);
+  });
+  it('gives null counters when the Memory domain fails and skips GC by default', async () => {
+    const { page, sends } = fake((method) => {
+      if (method === 'Memory.getDOMCounters') throw new Error('unsupported');
+      if (method === 'Runtime.getHeapUsage') return { usedSize: 5, totalSize: 6 };
+    });
+    expect(await page.sampleMemory()).toEqual({ usedHeapBytes: 5, totalHeapBytes: 6, domNodes: null, domDocuments: null, jsEventListeners: null });
+    expect(sends.map((s) => s.method)).toEqual(['Runtime.getHeapUsage', 'Memory.getDOMCounters']);
+  });
+  it('collectGarbage enables the profiler then collects', async () => {
+    const { page, sends } = fake();
+    await page.collectGarbage();
+    expect(sends.map((s) => s.method)).toEqual(['HeapProfiler.enable', 'HeapProfiler.collectGarbage']);
+  });
+});
+
+describe('evaluateOnNewDocument handle', () => {
+  it('returns the identifier and remove() sends the removal once', async () => {
+    const { page, sends } = fake((method) => (method === 'Page.addScriptToEvaluateOnNewDocument' ? { identifier: '7' } : {}));
+    const script = await page.evaluateOnNewDocument('window.x = 1');
+    expect(script.identifier).toBe('7');
+    expect(sends[0]).toEqual({ method: 'Page.addScriptToEvaluateOnNewDocument', params: { source: 'window.x = 1' } });
+    await script.remove(); await script.remove();
+    expect(sends.filter((s) => s.method === 'Page.removeScriptToEvaluateOnNewDocument')).toEqual([
+      { method: 'Page.removeScriptToEvaluateOnNewDocument', params: { identifier: '7' } },
+    ]);
+  });
+  it('throws when Chrome returns no identifier', async () => {
+    const { page } = fake();
+    await expect(page.evaluateOnNewDocument('1')).rejects.toThrow('no identifier');
+  });
+});

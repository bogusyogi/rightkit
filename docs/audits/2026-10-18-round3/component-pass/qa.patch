+import { describe, expect, it } from 'vitest';
+import { QaKeyboard } from './keyboard.js';
+import { QaMouse } from './mouse.js';
+
+function mouseRecorder() {
+  const calls: Array<{ method: string; params: any }> = [];
+  const mouse = new QaMouse(async (method, params) => { calls.push({ method, params }); return {}; });
+  return { calls, mouse, sent: () => calls.map((call) => call.params) };
+}
+
+describe('keyboard.insertText', () => {
+  it('sends one Input.insertText with the text and nothing else', async () => {
+    const calls: Array<{ method: string; params: any }> = [];
+    const keyboard = new QaKeyboard(async (method, params) => { calls.push({ method, params }); return {}; });
+    await keyboard.insertText('héllo 日本');
+    expect(calls).toEqual([{ method: 'Input.insertText', params: { text: 'héllo 日本' } }]);
+  });
+  it('refuses empty or non-string text without sending', async () => {
+    const calls: unknown[] = [];
+    const keyboard = new QaKeyboard(async (method) => { calls.push(method); return {}; });
+    await expect(keyboard.insertText('')).rejects.toThrow('non-empty string');
+    await expect(keyboard.insertText(undefined as any)).rejects.toThrow('non-empty string');
+    expect(calls).toEqual([]);
+  });
+});
+
+describe('mouse modifiers', () => {
+  it('click with a button and modifiers carries both on press and release', async () => {
+    const { mouse, sent } = mouseRecorder();
+    await mouse.click(3, 4, { button: 'middle', modifiers: 2 | 8 });
+    expect(sent()).toEqual([
+      { type: 'mousePressed', x: 3, y: 4, button: 'middle', buttons: 4, clickCount: 1, modifiers: 10 },
+      { type: 'mouseReleased', x: 3, y: 4, button: 'middle', buttons: 0, clickCount: 1, modifiers: 10 },
+    ]);
+  });
+  it('down, move and up carry the modifiers given to each call, and omit the field when none is given', async () => {
+    const { mouse, sent } = mouseRecorder();
+    await mouse.move(1, 1, { modifiers: 4 });
+    await mouse.down({ button: 'right', modifiers: 4 });
+    await mouse.up({ button: 'right' });
+    expect(sent()).toEqual([
+      { type: 'mouseMoved', x: 1, y: 1, button: 'none', buttons: 0, modifiers: 4 },
+      { type: 'mousePressed', x: 1, y: 1, button: 'right', buttons: 2, clickCount: 1, modifiers: 4 },
+      { type: 'mouseReleased', x: 1, y: 1, button: 'right', buttons: 0, clickCount: 1 },
+    ]);
+  });
+  it('doubleClick passes modifiers to every event', async () => {
+    const { mouse, sent } = mouseRecorder();
+    await mouse.doubleClick(2, 2, { modifiers: 1 });
+    expect(sent()).toHaveLength(4);
+    expect(sent().every((event) => event.modifiers === 1)).toBe(true);
+  });
+  it('refuses a bad mask before sending anything', async () => {
+    const { mouse, calls } = mouseRecorder();
+    await expect(mouse.click(1, 1, { modifiers: 16 })).rejects.toThrow('bit mask');
+    await expect(mouse.down({ modifiers: -1 })).rejects.toThrow('bit mask');
+    await expect(mouse.wheel({ deltaY: 5, modifiers: 1.5 })).rejects.toThrow('bit mask');
+    expect(calls).toEqual([]);
+  });
+});
+
+describe('mouse.wheel and wheelAt', () => {
+  it('wheel keeps its exact event without modifiers, and adds them when given', async () => {
+    const { mouse, sent } = mouseRecorder();
+    await mouse.wheel({ deltaY: 120 });
+    await mouse.wheel({ deltaX: -5, modifiers: 2 });
+    expect(sent()).toEqual([
+      { type: 'mouseWheel', x: 0, y: 0, deltaX: 0, deltaY: 120 },
+      { type: 'mouseWheel', x: 0, y: 0, deltaX: -5, deltaY: 0, modifiers: 2 },
+    ]);
+  });
+  it('wheelAt sends one mouseWheel at the point, tracks it, and sends no mouseMoved', async () => {
+    const { mouse, sent } = mouseRecorder();
+    await mouse.wheelAt(40, 50, { deltaX: 3, deltaY: -90, modifiers: 2 });
+    expect(sent()).toEqual([{ type: 'mouseWheel', x: 40, y: 50, deltaX: 3, deltaY: -90, modifiers: 2 }]);
+    expect(mouse.position()).toEqual({ x: 40, y: 50 });
+  });
+  it('wheelAt refuses zero deltas, non-finite input and non-finite points without sending', async () => {
+    const { mouse, calls } = mouseRecorder();
+    await expect(mouse.wheelAt(1, 1)).rejects.toThrow('non-zero');
+    await expect(mouse.wheelAt(1, 1, { deltaY: Infinity })).rejects.toThrow('finite');
+    await expect(mouse.wheelAt(NaN, 1, { deltaY: 1 })).rejects.toThrow('finite');
+    expect(calls).toEqual([]);
+    expect(mouse.position()).toEqual({ x: 0, y: 0 });
+  });
+});
diff --git a/packages/qa/src/intercept.ts b/packages/qa/src/intercept.ts
new file mode 100644
index 0000000..12da43e
--- /dev/null
+++ b/packages/qa/src/intercept.ts
@@ -0,0 +1,88 @@
+import type { CdpParams } from './cdp.js';
+
+/** The page surface the interceptor uses; QaPage satisfies it. */
+export interface QaInterceptTransport {
+  send(method: string, params?: CdpParams): Promise<CdpParams>;
+  on(method: string, listener: (params: CdpParams) => void): () => void;
+}
+
+/** One URL pattern for Fetch.enable, for example `{ urlPattern: '*.md', requestStage: 'Request' }`. */
+export interface InterceptPattern { urlPattern?: string; resourceType?: string; requestStage?: 'Request' | 'Response' }
+
+/** A paused request, as the handler sees it. */
+export interface InterceptedRequest { requestId: string; url: string; method: string; headers: Record<string, string>; resourceType?: string; postData?: string }
+
+/** The handler's answer. Omitting it, or returning undefined, continues the request unchanged. */
+export type InterceptAction =
+  | { action: 'continue'; url?: string; method?: string; headers?: Record<string, string>; postData?: string | Buffer }
+  | { action: 'fulfill'; status?: number; headers?: Record<string, string>; body?: string | Buffer }
+  | { action: 'fail'; errorReason?: string };
+
+export type InterceptHandler = (request: InterceptedRequest) => InterceptAction | void | Promise<InterceptAction | void>;
+
+const headerList = (headers: Record<string, string>) => Object.entries(headers).map(([name, value]) => ({ name, value }));
+const base64 = (data: string | Buffer) => Buffer.from(data).toString('base64');
+
+/**
+ * Fetch-domain request interception. `start()` subscribes, then enables Fetch for the patterns; each paused
+ * request goes to the handler, whose answer is sent as continueRequest, fulfillRequest or failRequest. A handler that
+ * throws, or a CDP failure while answering, continues the request so a page never hangs on the harness; the
+ * error is kept in `errors`. `stop()` disables Fetch and unsubscribes. Built by `page.interceptRequests`.
+ */
+export class QaRequestInterception {
+  private off?: () => void;
+  private started = false;
+  /** Errors raised by the handler or while answering a paused request. */
+  readonly errors: Error[] = [];
+
+  constructor(private transport: QaInterceptTransport, private patterns: InterceptPattern[], private handler: InterceptHandler) {
+    if (!Array.isArray(patterns) || !patterns.length) throw new Error('interceptRequests needs at least one pattern');
+    if (typeof handler !== 'function') throw new Error('interceptRequests needs a handler');
+  }
+
+  async start(): Promise<void> {
+    if (this.started) return;
+    this.started = true;
+    this.off = this.transport.on('Fetch.requestPaused', (event) => { void this.answer(event); });
+    try { await this.transport.send('Fetch.enable', { patterns: this.patterns }); }
+    catch (error) { this.off(); this.off = undefined; this.started = false; throw error; }
+  }
+
+  async stop(): Promise<void> {
+    if (!this.started) return;
+    this.started = false;
+    this.off?.(); this.off = undefined;
+    await this.transport.send('Fetch.disable').catch(() => {});
+  }
+
+  private async answer(event: CdpParams): Promise<void> {
+    const requestId: string = event.requestId;
+    const request = event.request ?? {};
+    let decision: InterceptAction | undefined;
+    try {
+      decision = (await this.handler({
+        requestId, url: request.url ?? '', method: request.method ?? 'GET', headers: request.headers ?? {},
+        resourceType: event.resourceType, postData: request.postData,
+      })) || undefined;
+    } catch (error) { this.errors.push(error instanceof Error ? error : new Error(String(error))); decision = undefined; }
+    try {
+      if (decision?.action === 'fulfill') {
+        await this.transport.send('Fetch.fulfillRequest', {
+          requestId, responseCode: decision.status ?? 200, responseHeaders: headerList(decision.headers ?? {}),
+          ...(decision.body !== undefined ? { body: base64(decision.body) } : {}),
+        });
+      } else if (decision?.action === 'fail') {
+        await this.transport.send('Fetch.failRequest', { requestId, errorReason: decision.errorReason ?? 'Failed' });
+      } else {
+        const next: Partial<Extract<InterceptAction, { action: 'continue' }>> = decision?.action === 'continue' ? decision : {};
+        await this.transport.send('Fetch.continueRequest', {
+          requestId,
+          ...(next.url !== undefined ? { url: next.url } : {}),
+          ...(next.method !== undefined ? { method: next.method } : {}),
+          ...(next.headers ? { headers: headerList(next.headers) } : {}),
+          ...(next.postData !== undefined ? { postData: base64(next.postData) } : {}),
+        });
+      }
+    } catch (error) { this.errors.push(error instanceof Error ? error : new Error(String(error))); }
+  }
+}

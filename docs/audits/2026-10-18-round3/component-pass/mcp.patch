+fn foreign_file_with_a_records_array_reaches_the_hook() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("mcp_trust_approvals.json");
+    let text = json!({"records": [
+        {"workspace": "/p", "serverName": "s", "contentHash": "h1", "approved": true, "decidedAt": "2026-01-01"},
+        {"workspace": "/p", "serverName": "t", "contentHash": "h2", "approved": false, "decidedAt": "2026-01-02"}
+    ]})
+    .to_string();
+    std::fs::write(&path, &text).unwrap();
+    let store = TrustStore::try_load_migrating(&path, |doc| {
+        let rows = doc.get("records")?.as_array()?;
+        rows.iter()
+            .map(|r| {
+                Some(ImportedTrust {
+                    workspace: r.get("workspace")?.as_str()?.into(),
+                    server: r.get("serverName")?.as_str()?.into(),

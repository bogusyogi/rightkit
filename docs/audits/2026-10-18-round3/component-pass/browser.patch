+//! A plain, visible browser the user drives by hand, with no DevTools connection: launch it on a
+//! dedicated profile directory and wait for the user to close it. This is the sign-in step: the
+//! user logs in to a site in a real window, closes it, and the app then reads the profile (for
+//! example with a yt-dlp `--cookies-from-browser` spec from [`crate::cookies_from_browser_spec`]).
+//!
+//! Nothing here opens a debugging port or a pipe, so the page cannot be driven or observed by this
+//! crate, and no network policy or admission hook applies: use [`crate::BrowserSession`] for
+//! automation. The process is owned (a kill-on-close job object on Windows, a process group on
+//! Unix): dropping a [`VisibleBrowser`] ends the browser's whole tree.
+
+use crate::config::{find_chrome, reject_real_browser_profile, validate_extra_args};
+use crate::error::{BrowserError, Result};
+use crate::real_session::{browser_executable, BrowserKind};
+use rightkit_child_process::{OwnedChild, OwnedCommand, ReapOutcome};
+use std::ffi::OsString;
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::time::{Duration, Instant};
+
+/// How often [`VisibleBrowser::wait`] looks at the process.
+const POLL: Duration = Duration::from_millis(250);
+/// Bound on ending a browser tree after a timeout or a [`VisibleBrowser::terminate`].
+const TERMINATE_WITHIN: Duration = Duration::from_secs(5);
+
+/// What to launch for [`VisibleBrowser::launch`] and [`launch_visible_and_wait`].
+#[derive(Clone, Debug)]
+pub struct VisibleLaunch {
+    /// Explicit browser executable. When `None`, the installed browser of `kind` is used.
+    pub executable: Option<PathBuf>,
+    /// Which installed browser to use when `executable` is `None` (default Chrome; Chromium
+    /// family only). For Chrome, [`crate::find_chrome`] is the fallback.
+    pub kind: BrowserKind,
+    /// A dedicated, absolute user-data directory, created when missing. The browser keeps its
+    /// cookies and storage there. It must not be a real browser profile, and no other browser may
+    /// be using it: Chromium hands a second launch on the same directory to the running instance
+    /// and exits at once.
+    pub profile_dir: PathBuf,
+    /// First page to open: `http(s)://` or `about:blank`. `None` opens the browser's start page.
+    pub url: Option<String>,
+    /// Extra Chrome flags (the flags that open a debugging endpoint or redirect the profile are
+    /// refused, as for a session).
+    pub extra_args: Vec<String>,
+}
+
+impl VisibleLaunch {
+    /// A visible Chrome on `profile_dir`.
+    pub fn new(profile_dir: impl Into<PathBuf>) -> Self {
+        Self {
+            executable: None,
+            kind: BrowserKind::Chrome,
+            profile_dir: profile_dir.into(),
+            url: None,
+            extra_args: Vec::new(),
+        }
+    }
+    pub fn kind(mut self, kind: BrowserKind) -> Self {
+        self.kind = kind;
+        self
+    }
+    pub fn executable(mut self, path: impl Into<PathBuf>) -> Self {
+        self.executable = Some(path.into());
+        self
+    }
+    pub fn url(mut self, url: impl Into<String>) -> Self {
+        self.url = Some(url.into());
+        self
+    }
+    pub fn arg(mut self, arg: impl Into<String>) -> Self {
+        self.extra_args.push(arg.into());
+        self
+    }
+}
+
+/// How a visible browser ended.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum VisibleOutcome {
+    /// The browser exited (the user closed it). `code` is its exit code when it reported one.
+    Exited { code: Option<i32> },
+    /// `wait` reached its timeout; the browser's process tree was terminated.
+    TimedOut,
+}
+
+/// The command-line flags for `launch`, after validation. Pure.
+pub(crate) fn visible_args(launch: &VisibleLaunch) -> Result<Vec<OsString>> {
+    validate_extra_args(&launch.extra_args)?;
+    let mut args: Vec<OsString> = vec![
+        {
+            let mut a = OsString::from("--user-data-dir=");
+            a.push(&launch.profile_dir);
+            a
+        },
+        "--no-first-run".into(),
+        "--no-default-browser-check".into(),
+    ];
+    for extra in &launch.extra_args {
+        args.push(if extra.starts_with('-') {
+            extra.into()
+        } else {
+            format!("--{extra}").into()
+        });
+    }
+    if let Some(url) = launch.url.as_deref() {
+        let ok = url == "about:blank"
+            || url::Url::parse(url)
+                .map(|u| matches!(u.scheme(), "http" | "https") && u.host_str().is_some())
+                .unwrap_or(false);
+        if !ok {
+            return Err(BrowserError::Invalid(format!(
+                "'{url}' is not an http(s) URL or about:blank"
+            )));
+        }
+        args.push(url.into());
+    }
+    Ok(args)
+}
+
+fn resolve(launch: &VisibleLaunch) -> Result<PathBuf> {
+    if let Some(path) = &launch.executable {
+        return if path.is_file() {
+            Ok(path.clone())
+        } else {
+            Err(BrowserError::Launch(format!(
+                "browser executable does not exist: {}",
+                path.display()
+            )))
+        };
+    }
+    if !matches!(
+        launch.kind,
+        BrowserKind::Chrome | BrowserKind::Edge | BrowserKind::Chromium | BrowserKind::Brave
+    ) {
+        return Err(BrowserError::Unsupported(format!(
+            "{} is not a Chromium-family browser",
+            launch.kind.name()
+        )));
+    }
+    browser_executable(launch.kind)
+        .or_else(|| (launch.kind == BrowserKind::Chrome).then(find_chrome).flatten())
+        .ok_or(BrowserError::ChromeNotFound)
+}
+
+/// A visible browser process with no DevTools connection.
+pub struct VisibleBrowser {
+    child: OwnedChild,
+    executable: PathBuf,
+    profile_dir: PathBuf,
+}
+
+impl VisibleBrowser {
+    /// Start the browser window and return at once. Dropping the value ends the browser.
+    pub fn launch(launch: &VisibleLaunch) -> Result<Self> {
+        if !launch.profile_dir.is_absolute() {
+            return Err(BrowserError::Profile(format!(
+                "profile directory must be absolute: {}",
+                launch.profile_dir.display()
+            )));
+        }
+        let args = visible_args(launch)?;
+        let executable = resolve(launch)?;
+        reject_real_browser_profile(&launch.profile_dir)?;
+        let mut cmd = OwnedCommand::new(&executable);
+        cmd.windows_visible();
+        cmd.command_mut()
+            .args(&args)
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null());
+        let child = cmd
+            .spawn()
+            .map_err(|e| BrowserError::Launch(format!("{}: {e}", executable.display())))?;
+        Ok(Self {
+            child,
+            executable,
+            profile_dir: launch.profile_dir.clone(),
+        })
+    }
+
+    /// The browser's process id.
+    pub fn pid(&self) -> u32 {
+        self.child.id()
+    }
+    /// The executable that was launched.
+    pub fn executable(&self) -> &std::path::Path {
+        &self.executable
+    }
+    /// The profile directory the browser writes to.
+    pub fn profile_dir(&self) -> &std::path::Path {
+        &self.profile_dir
+    }
+
+    /// Wait until the browser exits (the user closes it), or until `timeout` when given. On a
+    /// timeout the browser's whole process tree is terminated and
+    /// [`VisibleOutcome::TimedOut`] is returned. Dropping the future leaves the browser running
+    /// until this value is dropped.
+    pub async fn wait(&mut self, timeout: Option<Duration>) -> Result<VisibleOutcome> {
+        let started = Instant::now();
+        loop {
+            if let Some(status) = self.child.try_wait()? {
+                // The window process has exited; helpers still holding the profile (renderer,
+                // GPU, crashpad) are ended with it so the profile can be read right away.
+                let _ = self.child.terminate_tree_bounded(TERMINATE_WITHIN);
+                return Ok(VisibleOutcome::Exited {
+                    code: status.code(),
+                });
+            }
+            if timeout.is_some_and(|limit| started.elapsed() >= limit) {
+                self.terminate_tree()?;
+                return Ok(VisibleOutcome::TimedOut);
+            }
+            tokio::time::sleep(POLL).await;
+        }
+    }
+
+    /// End the browser now (its whole process tree), bounded.
+    pub fn terminate(&mut self) -> Result<()> {
+        self.terminate_tree()
+    }
+
+    fn terminate_tree(&mut self) -> Result<()> {
+        match self.child.terminate_tree_bounded(TERMINATE_WITHIN)? {
+            ReapOutcome::Exited(_) => Ok(()),
+            ReapOutcome::TimedOut => Err(BrowserError::Timeout(
+                "the browser process tree did not exit after termination".into(),
+            )),
+        }
+    }
+}
+
+/// Launch a visible browser and wait for the user to close it (or `timeout`). See the module
+/// docs; the sign-in flow is `launch_visible_and_wait(VisibleLaunch::new(dir).url(login_url), None)`
+/// followed by reading the cookies from `dir`.
+pub async fn launch_visible_and_wait(
+    launch: VisibleLaunch,
+    timeout: Option<Duration>,
+) -> Result<VisibleOutcome> {
+    let mut browser = VisibleBrowser::launch(&launch)?;
+    browser.wait(timeout).await
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn launch() -> VisibleLaunch {
+        VisibleLaunch::new(if cfg!(windows) { r"C:\rk\profile" } else { "/rk/profile" })
+    }
+
+    #[test]
+    fn args_point_at_the_profile_and_open_no_debugging_endpoint() {
+        let args = visible_args(&launch().url("https://example.com/login")).unwrap();
+        let text: Vec<String> = args.iter().map(|a| a.to_string_lossy().into_owned()).collect();
+        assert!(text[0].starts_with("--user-data-dir=") && text[0].contains("profile"));
+        assert!(text.contains(&"--no-first-run".to_string()));
+        assert_eq!(text.last().unwrap(), "https://example.com/login");
+        assert!(!text.iter().any(|a| a.contains("remote-debugging")));
+    }
+
+    #[test]
+    fn extra_flags_gain_dashes_and_managed_flags_are_refused() {
+        let args = visible_args(&launch().arg("lang=de")).unwrap();
+        assert!(args.iter().any(|a| a == "--lang=de"));
+        assert!(visible_args(&launch().arg("--remote-debugging-port=9222")).is_err());
+        assert!(visible_args(&launch().arg("user-data-dir=/x")).is_err());
+    }
+
+    #[test]
+    fn only_http_urls_and_about_blank_open() {
+        assert!(visible_args(&launch().url("about:blank")).is_ok());
+        for bad in ["file:///etc/passwd", "javascript:alert(1)", "--evil", "chrome://settings", "nonsense"] {
+            assert!(visible_args(&launch().url(bad)).is_err(), "{bad}");
+        }
+    }
+
+    #[test]
+    fn a_relative_profile_and_a_missing_executable_are_refused() {
+        assert!(matches!(
+            VisibleBrowser::launch(&VisibleLaunch::new("relative/dir")),
+            Err(BrowserError::Profile(_))
+        ));
+        let missing = launch().executable(PathBuf::from("/definitely/not/here/chrome"));
+        assert!(matches!(resolve(&missing), Err(BrowserError::Launch(_))));
+        let safari = launch().kind(BrowserKind::Safari);
+        assert!(matches!(resolve(&safari), Err(BrowserError::Unsupported(_))));
+    }
+}

@@ -0,0 +1,222 @@
+//! Netscape `cookies.txt` import and export, and the yt-dlp `--cookies-from-browser` mapping.
+//! Lifted from ScrapeRight (`commands_auth_helpers.rs`, `inapp_sign_in.rs`, `browser.rs`,
+//! `source_auth.rs`).
+
+use crate::real_session::BrowserKind;
+use serde::{Deserialize, Serialize};
+use std::path::Path;
+
+/// First line of a Netscape cookie file.
+pub const NETSCAPE_HEADER: &str = "# Netscape HTTP Cookie File";
+
+/// One cookie in the shape a Netscape file holds.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct CookieRecord {
+    /// Host, without the leading dot (`example.com`).
+    pub domain: String,
+    /// Sent to subdomains too (written as a leading dot and `TRUE`).
+    pub include_subdomains: bool,
+    pub path: String,
+    pub secure: bool,
+    pub http_only: bool,
+    /// Unix seconds; 0 is a session cookie (yt-dlp reads 0 as a session cookie).
+    pub expires: i64,
+    pub name: String,
+    pub value: String,
+}
+
+impl CookieRecord {
+    /// A field that holds a tab or line break would corrupt a Netscape file.
+    fn is_writable(&self) -> bool {
+        !self.name.is_empty()
+            && [&self.domain, &self.path, &self.name, &self.value]
+                .iter()
+                .all(|s| !s.contains(['\t', '\n', '\r']))
+    }
+
+    /// Whether the cookie's domain is `allowed` or one of its subdomains.
+    pub fn matches_domain(&self, allowed: &str) -> bool {
+        let allowed = allowed.trim_start_matches('.').to_ascii_lowercase();
+        let domain = self.domain.trim_start_matches('.').to_ascii_lowercase();
+        domain == allowed || domain.ends_with(&format!(".{allowed}"))
+    }
+}
+
+/// Write `cookies` as a Netscape file. A cookie with a tab or line break in a field is skipped, not
+/// written. HttpOnly cookies carry the `#HttpOnly_` domain prefix curl and yt-dlp use.
+pub fn to_netscape(cookies: &[CookieRecord]) -> String {
+    let mut out = String::from(NETSCAPE_HEADER);
+    out.push('\n');
+    for c in cookies.iter().filter(|c| c.is_writable()) {
+        let domain = c.domain.trim_start_matches('.');
+        let prefix = if c.http_only { "#HttpOnly_" } else { "" };
+        let dot = if c.include_subdomains { "." } else { "" };
+        out.push_str(&format!(
+            "{prefix}{dot}{domain}\t{}\t{}\t{}\t{}\t{}\t{}\n",
+            if c.include_subdomains { "TRUE" } else { "FALSE" },
+            c.path,
+            if c.secure { "TRUE" } else { "FALSE" },
+            c.expires.max(0),
+            c.name,
+            c.value,
+        ));
+    }
+    out
+}
+
+/// Read a Netscape file. Comment lines (other than `#HttpOnly_`), blank lines and lines with fewer
+/// than seven tab-separated fields are skipped.
+pub fn parse_netscape(text: &str) -> Vec<CookieRecord> {
+    let mut out = Vec::new();
+    // Not trimmed: a cookie with an empty value ends in a tab that must survive.
+    for line in text.lines() {
+        if line.trim().is_empty() {
+            continue;
+        }
+        let (line, http_only) = match line.strip_prefix("#HttpOnly_") {
+            Some(rest) => (rest, true),
+            None if line.starts_with('#') => continue,
+            None => (line, false),
+        };
+        let f: Vec<&str> = line.split('\t').collect();
+        if f.len() < 7 || f[5].trim().is_empty() {
+            continue;
+        }
+        out.push(CookieRecord {
+            domain: f[0].trim_start_matches('.').to_string(),
+            include_subdomains: f[1].eq_ignore_ascii_case("TRUE") || f[0].starts_with('.'),
+            path: if f[2].is_empty() { "/".into() } else { f[2].to_string() },
+            secure: f[3].eq_ignore_ascii_case("TRUE"),
+            http_only,
+            expires: f[4].trim().parse::<i64>().unwrap_or(0).max(0),
+            name: f[5].trim().to_string(),
+            value: f[6].to_string(),
+        });
+    }
+    out
+}
+
+/// yt-dlp `--cookies-from-browser` keyword for the browser executable at `exe`. It selects the
+/// cookie-decryption scheme (Keychain service name on macOS; DPAPI on Windows, shared by every
+/// Chromium browser). Defaults to `chrome`.
+pub fn cookie_keyword_for_executable(exe: &Path) -> &'static str {
+    let name = exe
+        .file_name()
+        .and_then(|n| n.to_str())
+        .unwrap_or("")
+        .to_ascii_lowercase();
+    if name.contains("msedge") || name.contains("microsoft edge") {
+        "edge"
+    } else if name.contains("brave") {
+        "brave"
+    } else if name.contains("chromium") {
+        "chromium"
+    } else if name.contains("vivaldi") {
+        "vivaldi"
+    } else if name.contains("opera") {
+        "opera"
+    } else if name.contains("firefox") {
+        "firefox"
+    } else if name.contains("safari") {
+        "safari"
+    } else {
+        "chrome"
+    }
+}
+
+impl BrowserKind {
+    /// yt-dlp `--cookies-from-browser` keyword, `None` for [`BrowserKind::Unknown`].
+    pub fn cookies_from_browser_keyword(self) -> Option<&'static str> {
+        match self {
+            Self::Chrome => Some("chrome"),
+            Self::Edge => Some("edge"),
+            Self::Chromium => Some("chromium"),
+            Self::Brave => Some("brave"),
+            Self::Safari => Some("safari"),
+            Self::Firefox => Some("firefox"),
+            Self::Unknown => None,
+        }
+    }
+}
+
+/// The `--cookies-from-browser` argument: `keyword`, or `keyword:<profile dir>` for a dedicated
+/// profile (yt-dlp then reads that profile's cookie store).
+pub fn cookies_from_browser_spec(keyword: &str, profile_dir: Option<&Path>) -> String {
+    match profile_dir {
+        Some(dir) => format!("{keyword}:{}", dir.display()),
+        None => keyword.to_string(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn rec(name: &str, http_only: bool, sub: bool) -> CookieRecord {
+        CookieRecord {
+            domain: "example.com".into(),
+            include_subdomains: sub,
+            path: "/".into(),
+            secure: true,
+            http_only,
+            expires: 1_893_456_000,
+            name: name.into(),
+            value: "v".into(),
+        }
+    }
+
+    #[test]
+    fn round_trips_through_a_netscape_file() {
+        let cookies = vec![rec("a", false, true), rec("b", true, false)];
+        let text = to_netscape(&cookies);
+        assert!(text.starts_with("# Netscape HTTP Cookie File\n"));
+        assert!(text.contains(".example.com\tTRUE\t/\tTRUE\t1893456000\ta\tv\n"));
+        assert!(text.contains("#HttpOnly_example.com\tFALSE\t/\tTRUE\t1893456000\tb\tv\n"));
+        assert_eq!(parse_netscape(&text), cookies);
+    }
+
+    #[test]
+    fn unwritable_cookies_are_skipped_and_session_expiry_is_zero() {
+        let mut bad = rec("x", false, true);
+        bad.value = "a\tb".into();
+        let mut session = rec("s", false, true);
+        session.expires = -5;
+        let text = to_netscape(&[bad, session]);
+        assert_eq!(text.lines().count(), 2);
+        assert!(text.contains("\t0\ts\tv"));
+    }
+
+    #[test]
+    fn parse_skips_comments_short_lines_and_blank_names() {
+        let text = "# Netscape HTTP Cookie File\n# note\n\nshort\tline\n.a.com\tTRUE\t/\tFALSE\t0\t\tv\n.a.com\tTRUE\t/\tFALSE\t0\tn\tv\n";
+        let got = parse_netscape(text);
+        assert_eq!(got.len(), 1);
+        assert_eq!((got[0].domain.as_str(), got[0].name.as_str(), got[0].expires), ("a.com", "n", 0));
+    }
+
+    #[test]
+    fn an_empty_value_survives_a_round_trip() {
+        let mut c = rec("e", false, true);
+        c.value = String::new();
+        assert_eq!(parse_netscape(&to_netscape(std::slice::from_ref(&c))), vec![c]);
+    }
+
+    #[test]
+    fn domain_matching_covers_subdomains_only() {
+        let c = rec("a", false, true);
+        assert!(c.matches_domain("example.com") && c.matches_domain(".EXAMPLE.com"));
+        assert!(!c.matches_domain("ample.com") && !c.matches_domain("sub.example.com"));
+    }
+
+    #[test]
+    fn keyword_mapping_follows_the_executable_name() {
+        assert_eq!(cookie_keyword_for_executable(Path::new("C:/x/msedge.exe")), "edge");
+        assert_eq!(cookie_keyword_for_executable(Path::new("/a/Brave Browser")), "brave");
+        assert_eq!(cookie_keyword_for_executable(Path::new("/a/chromium")), "chromium");
+        assert_eq!(cookie_keyword_for_executable(Path::new("/a/unknown")), "chrome");
+        assert_eq!(BrowserKind::Edge.cookies_from_browser_keyword(), Some("edge"));
+        assert_eq!(BrowserKind::Unknown.cookies_from_browser_keyword(), None);
+        assert_eq!(cookies_from_browser_spec("chrome", Some(Path::new("/p"))), format!("chrome:{}", Path::new("/p").display()));
+        assert_eq!(cookies_from_browser_spec("edge", None), "edge");
+    }
+}

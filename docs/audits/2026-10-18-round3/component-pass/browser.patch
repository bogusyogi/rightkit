+//! User-agent and extra request headers for a page: validation and the CDP parameters.
+//!
+//! Applied through `Emulation.setUserAgentOverride` and `Network.setExtraHTTPHeaders`, so every
+//! request of the page (navigations and subresources) carries them without a request interceptor.
+//! The network policy and the admission hook still see every request.
+
+use crate::error::{BrowserError, Result};
+use serde_json::{Map, Value};
+
+/// Headers the browser itself owns; setting them would break framing or the session's own checks.
+const RESERVED_HEADERS: &[&str] = &["host", "content-length", "transfer-encoding", "connection"];
+
+/// A user agent must be a single printable line.
+pub(crate) fn validate_user_agent(user_agent: &str) -> Result<()> {
+    if user_agent.trim().is_empty() || user_agent.chars().any(char::is_control) {
+        return Err(BrowserError::Invalid(
+            "user agent must be non-empty and hold no control characters".into(),
+        ));
+    }
+    Ok(())
+}
+
+fn is_token(name: &str) -> bool {
+    !name.is_empty()
+        && name.bytes().all(|b| {
+            b.is_ascii_alphanumeric() || b"!#$%&'*+-.^_`|~".contains(&b)
+        })
+}
+
+/// Validate `headers` and fold them into the JSON object CDP takes. Names are RFC 9110 tokens,
+/// values hold no line break or NUL, reserved framing headers are refused; a repeated name (any
+/// case) keeps its last value.
+pub(crate) fn headers_object(headers: &[(String, String)]) -> Result<Value> {
+    let mut seen: Vec<(String, String)> = Vec::new();
+    for (name, value) in headers {
+        if !is_token(name) {
+            return Err(BrowserError::Invalid(format!(
+                "'{name}' is not a valid header name"
+            )));
+        }
+        if RESERVED_HEADERS.contains(&name.to_ascii_lowercase().as_str()) {
+            return Err(BrowserError::Invalid(format!(
+                "header '{name}' is managed by the browser"
+            )));
+        }
+        if value.contains(['\r', '\n', '\0']) {
+            return Err(BrowserError::Invalid(format!(
+                "the value of header '{name}' holds a line break or NUL"
+            )));
+        }
+        match seen
+            .iter_mut()
+            .find(|(n, _)| n.eq_ignore_ascii_case(name))
+        {
+            Some(slot) => *slot = (name.clone(), value.clone()),
+            None => seen.push((name.clone(), value.clone())),
+        }
+    }
+    let mut map = Map::new();
+    for (name, value) in seen {
+        map.insert(name, Value::String(value));
+    }
+    Ok(Value::Object(map))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn h(n: &str, v: &str) -> (String, String) {
+        (n.into(), v.into())
+    }
+
+    #[test]
+    fn headers_fold_into_an_object_and_the_last_duplicate_wins() {
+        let v = headers_object(&[h("Accept-Language", "en"), h("X-Id", "1"), h("accept-language", "de")])
+            .unwrap();
+        assert_eq!(v["accept-language"], "de");
+        assert_eq!(v["X-Id"], "1");
+        assert_eq!(v.as_object().unwrap().len(), 2);
+    }
+
+    #[test]
+    fn an_empty_list_clears_the_headers() {
+        assert_eq!(headers_object(&[]).unwrap(), serde_json::json!({}));
+    }
+
+    #[test]
+    fn bad_names_values_and_reserved_headers_are_refused() {
+        for bad in [h("", "x"), h("a b", "x"), h("a:b", "x"), h("X", "a\r\nInjected: 1"), h("X", "a\0"), h("Host", "evil"), h("content-length", "0")] {
+            assert!(headers_object(&[bad.clone()]).is_err(), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn user_agent_must_be_one_printable_line() {
+        assert!(validate_user_agent("Mozilla/5.0 (X11) Chrome/155").is_ok());
+        assert!(validate_user_agent("").is_err());
+        assert!(validate_user_agent("   ").is_err());
+        assert!(validate_user_agent("a\nb").is_err());
+    }
+}

+pub struct CodexExtras {
+    /// `-c key=value` config overrides, placed before `app-server`. The key is a dotted
+    /// config path; the value is TOML text (a string needs its quotes, see [`toml_string`]).
+    /// [`mcp_server_overrides`] builds the pairs that scope an MCP server to this launch.
+    pub config_overrides: Vec<(String, String)>,

+//! On-disk session logs of Claude Code and Codex: discovery and row parsing into the
+//! vendor-neutral [`AgentEvent`] stream.
+//!
+//! Both CLIs append one JSON object per line to a log under the user's home: Claude Code in
+//! `<claude dir>/projects/<project>/<session>.jsonl`, Codex in
+//! `<codex dir>/sessions/<yyyy>/<mm>/<dd>/rollout-<time>-<session>.jsonl`. This module finds
+//! those files ([`discover_open`], [`discover_in`]) and turns their rows into events
+//! ([`LogParser`], [`read_log`], [`LogTail`]). It never writes to a log, never resumes a
+//! session and opens files read-only.
+//!
+//! Lifted and adapted from the Pulse membrane transcript adapters (`claude_events`,
+//! `codex_events`, `discover_open`), re-targeted from their transcript rows to `AgentEvent`:
+//!
+//! - Sidechain (subagent-internal) Claude rows, `isMeta` rows and injected context (CLAUDE.md
+//!   and AGENTS.md dumps, environment blocks, slash-command echoes) are not events.
+//! - Rows that are not messages (queue operations, file-history snapshots, token counts) are
+//!   not events; titles and the session id, working directory and timestamps they carry are
+//!   kept in [`SessionMeta`].
+//! - Per-row token usage is not emitted: the CLIs repeat one message's usage on each of its
+//!   rows, so summing it would count it several times.
+//!
+//! The row shapes follow the membrane fixtures and the Claude Code and Codex versions it was
+//! written against. The `custom-title` and `ai-title` Claude rows and the Codex `compacted`
+//! row are unverified against a recorded log; a missing or renamed key degrades to fewer
+//! events or no title, never an error.
+//!
+//! Sequence numbers are the 1-based position of an event among all events the file's
+//! complete lines produce. They are stable for an append-only log: reading the same prefix
+//! always yields the same numbers.
+
+use std::collections::HashSet;
+use std::fs::File;
+use std::io::{self, BufRead, BufReader, Read, Seek, SeekFrom};
+use std::path::{Path, PathBuf};
+
+use serde_json::Value;
+
+use crate::event::{AgentEvent, ParseError};
+
+/// Which vendor wrote a log.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum LogHost {
+    ClaudeCode,
+    Codex,
+}
+
+impl LogHost {
+    /// The host label used in discovery results: `claude_code` or `codex`.
+    pub fn name(self) -> &'static str {
+        match self {
+            LogHost::ClaudeCode => "claude_code",
+            LogHost::Codex => "codex",
+        }
+    }
+}
+
+/// A session log found on disk.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DiscoveredLog {
+    pub host: LogHost,
+    pub path: PathBuf,
+}
+
+/// The user's home directory from `HOME`, else `USERPROFILE`.
+pub fn home_dir() -> Option<PathBuf> {
+    ["HOME", "USERPROFILE"]
+        .iter()
+        .filter_map(|name| std::env::var_os(name))
+        .find(|value| !value.is_empty())
+        .map(PathBuf::from)
+}
+
+/// Claude Code's config directory: `CLAUDE_CONFIG_DIR`, else `~/.claude`.
+pub fn default_claude_dir() -> Option<PathBuf> {
+    std::env::var_os("CLAUDE_CONFIG_DIR")
+        .filter(|value| !value.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| home_dir().map(|home| home.join(".claude")))
+}
+
+/// Codex's home directory: `CODEX_HOME`, else `~/.codex`.
+pub fn default_codex_dir() -> Option<PathBuf> {
+    std::env::var_os("CODEX_HOME")
+        .filter(|value| !value.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| home_dir().map(|home| home.join(".codex")))
+}
+
+/// Deepest directory level searched under a log root. Symbolic links are never followed.
+const MAX_DEPTH: usize = 8;
+
+fn collect_jsonl(root: &Path, depth: usize, out: &mut Vec<PathBuf>) {
+    if depth > MAX_DEPTH {
+        return;
+    }
+    let Ok(entries) = std::fs::read_dir(root) else {
+        return;
+    };
+    let mut entries: Vec<_> = entries.flatten().collect();
+    entries.sort_by_key(|entry| entry.path());
+    for entry in entries {
+        let Ok(kind) = entry.file_type() else {
+            continue;
+        };
+        let path = entry.path();
+        if kind.is_dir() {
+            collect_jsonl(&path, depth + 1, out);
+        } else if kind.is_file() && path.extension().and_then(|ext| ext.to_str()) == Some("jsonl")
+        {
+            out.push(path);
+        }
+    }
+}
+
+/// Discover the logs under `home`: `~/.claude/projects` and `~/.codex/sessions`. Sorted by
+/// host, then path. Missing directories yield nothing.
+pub fn discover_open(home: &Path) -> Vec<DiscoveredLog> {
+    discover_in(Some(&home.join(".claude")), Some(&home.join(".codex")))
+}
+
+/// Discover the logs under explicit config directories (see [`default_claude_dir`] and
+/// [`default_codex_dir`]). Sorted by host, then path.
+pub fn discover_in(claude_dir: Option<&Path>, codex_dir: Option<&Path>) -> Vec<DiscoveredLog> {
+    let mut out = Vec::new();
+    if let Some(dir) = claude_dir {
+        let mut paths = Vec::new();
+        collect_jsonl(&dir.join("projects"), 0, &mut paths);
+        out.extend(paths.into_iter().map(|path| DiscoveredLog {
+            host: LogHost::ClaudeCode,
+            path,
+        }));
+    }
+    if let Some(dir) = codex_dir {
+        let mut paths = Vec::new();
+        collect_jsonl(&dir.join("sessions"), 0, &mut paths);
+        out.extend(paths.into_iter().map(|path| DiscoveredLog {
+            host: LogHost::Codex,
+            path,
+        }));
+    }
+    out.sort_by(|a, b| {
+        a.host
+            .name()
+            .cmp(b.host.name())
+            .then_with(|| a.path.cmp(&b.path))
+    });
+    out.dedup();
+    out
+}
+
+/// One event read from a log, with the row's timestamp when it had one.
+#[derive(Debug, Clone, PartialEq)]
+pub struct LogEntry {
+    /// The row's RFC 3339 `timestamp`, as written.
+    pub timestamp: Option<String>,
+    pub event: AgentEvent,
+}
+
+/// A [`LogEntry`] with its sequence number.
+#[derive(Debug, Clone, PartialEq)]
+pub struct SeqEntry {
+    /// 1-based, contiguous and strictly increasing across the whole file.
+    pub seq: u64,
+    pub entry: LogEntry,
+}
+
+/// What a log says about its session, gathered from every row read so far.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct SessionMeta {
+    pub session_id: Option<String>,
+    pub cwd: Option<String>,
+    /// The best title seen: a custom title, else an AI title or summary, else the first line
+    /// of the first user message (at most [`TITLE_CHARS`] characters).
+    pub title: Option<String>,
+    pub model: Option<String>,
+    /// The timestamp of the first row that had one.
+    pub started_at: Option<String>,
+    /// The timestamp of the latest row that had one.
+    pub last_timestamp: Option<String>,
+}
+
+/// Longest title taken from a user message, in characters.
+pub const TITLE_CHARS: usize = 120;
+
+/// Prefixes of user text that the CLI injected, not the user: instruction-file dumps,
+/// environment blocks, command echoes and notifications.
+const INJECTED_CONTEXT_PREFIXES: &[&str] = &[
+    "# AGENTS.md instructions",
+    "# CLAUDE.md instructions",
+    "# Context from my IDE setup:",
+    "# Files mentioned by the user",
+    "<environment_context",
+    "<in-app-browser-context",
+    "<permissions instructions",
+    "<recommended_plugins",
+    "<summary>",
+    "<command-name",
+    "<command-message",
+    "<local-command-stdout",
+    "<task-notification",
+    "<launch-selected-element",
+    "<system-reminder",
+    "[Request interrupted",
+];
+
+/// Tool names Claude Code uses for a call that spawns a subagent.
+const SUBAGENT_TOOLS: &[&str] = &["Task", "Agent"];
+
+/// Codex control envelopes stripped from user text.
+const CODEX_CONTROL_TAGS: &[&str] = &[
+    "subagent_notification",
+    "codex_internal_context",
+    "codex_delegation",
+    "turn_aborted",
+    "heartbeat",
+];
+
+fn injected_context(text: &str) -> bool {
+    let text = text.trim_start();
+    INJECTED_CONTEXT_PREFIXES
+        .iter()
+        .any(|prefix| text.starts_with(prefix))
+}
+
+/// Remove every `<tag ...>...</tag>` block (with or without attributes) from `text`. An
+/// opening tag with no closing tag is left alone.
+fn strip_tag_blocks(text: &str, tag: &str) -> String {
+    let open = format!("<{tag}");
+    let close = format!("</{tag}>");
+    let mut out = String::with_capacity(text.len());
+    let mut rest = text;
+    while let Some(start) = rest.find(&open) {
+        let after = &rest[start + open.len()..];
+        let named = after
+            .chars()
+            .next()
+            .is_some_and(|c| c == '>' || c.is_whitespace());
+        let end = if named {
+            after.find('>').and_then(|open_end| {
+                let body = &after[open_end + 1..];
+                body.find(&close).map(|at| {
+                    start + open.len() + open_end + 1 + at + close.len()
+                })
+            })
+        } else {
+            None
+        };
+        match end {
+            Some(end) => {
+                out.push_str(&rest[..start]);
+                rest = &rest[end..];
+            }
+            None => {
+                out.push_str(&rest[..start + open.len()]);
+                rest = &rest[start + open.len()..];
+            }
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+/// Remove `<image ...>` and `</image>` markers, to the closing `>` or the end of the text.
+fn strip_image_markers(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut rest = text;
+    loop {
+        let open = rest.find("<image");
+        let close = rest.find("</image");
+        let (start, name_len) = match (open, close) {
+            (Some(a), Some(b)) if b < a => (b, "</image".len()),
+            (Some(a), _) => (a, "<image".len()),
+            (None, Some(b)) => (b, "</image".len()),
+            (None, None) => break,
+        };
+        let after = &rest[start + name_len..];
+        let boundary = after
+            .chars()
+            .next()
+            .is_none_or(|c| !(c.is_alphanumeric() || c == '_'));
+        if !boundary {
+            out.push_str(&rest[..start + name_len]);
+            rest = after;
+            continue;
+        }
+        out.push_str(&rest[..start]);
+        rest = match after.find('>') {
+            Some(at) => &after[at + 1..],
+            None => "",
+        };
+    }
+    out.push_str(rest);
+    out
+}
+
+fn codex_user_text(text: &str) -> String {
+    let mut text = text.to_string();
+    for tag in CODEX_CONTROL_TAGS {
+        text = strip_tag_blocks(&text, tag);
+    }
+    strip_image_markers(&text).trim().to_string()
+}
+
+fn str_field(value: &Value, key: &str) -> Option<String> {
+    value.get(key).and_then(Value::as_str).map(str::to_string)
+}
+
+fn bool_field(value: &Value, key: &str) -> bool {
+    value.get(key).and_then(Value::as_bool).unwrap_or(false)
+}
+
+/// Text of a `tool_result` content value: a string as is, an array's `text` parts joined
+/// with newlines, null as empty, anything else as compact JSON.
+fn result_text(content: Option<&Value>) -> String {
+    match content {
+        None | Some(Value::Null) => String::new(),
+        Some(Value::String(text)) => text.clone(),
+        Some(Value::Array(items)) => items
+            .iter()
+            .filter(|item| item.get("type").and_then(Value::as_str) == Some("text"))
+            .filter_map(|item| item.get("text").and_then(Value::as_str))
+            .collect::<Vec<&str>>()
+            .join("\n"),
+        Some(other) => other.to_string(),
+    }
+}
+
+fn first_line_title(text: &str) -> Option<String> {
+    let line = text.lines().map(str::trim).find(|line| !line.is_empty())?;
+    Some(line.chars().take(TITLE_CHARS).collect())
+}
+
+/// Turns the rows of one log into events. One parser per file, rows fed in order: it keeps
+/// the open subagent calls and the [`SessionMeta`] seen so far.
+#[derive(Debug)]
+pub struct LogParser {
+    host: LogHost,
+    subagents: HashSet<String>,
+    meta: SessionMeta,
+    title_rank: u8,
+}
+
+impl LogParser {
+    pub fn new(host: LogHost) -> Self {
+        Self {
+            host,
+            subagents: HashSet::new(),
+            meta: SessionMeta::default(),
+            title_rank: 0,
+        }
+    }
+
+    pub fn host(&self) -> LogHost {
+        self.host
+    }
+
+    /// What the rows parsed so far say about the session.
+    pub fn meta(&self) -> &SessionMeta {
+        &self.meta
+    }
+
+    /// Parse one line. Blank lines and JSON that is not an object give no events. `Err` for
+    /// text that is not JSON.
+    pub fn parse_line(&mut self, line: &str) -> Result<Vec<LogEntry>, ParseError> {
+        let line = line.trim();
+        if line.is_empty() {
+            return Ok(Vec::new());
+        }
+        let row: Value =
+            serde_json::from_str(line).map_err(|error| ParseError(error.to_string()))?;
+        Ok(self.parse_row(&row))
+    }
+
+    /// Parse one already-decoded row.
+    pub fn parse_row(&mut self, row: &Value) -> Vec<LogEntry> {
+        if !row.is_object() {
+            return Vec::new();
+        }
+        self.note_meta(row);
+        let timestamp = str_field(row, "timestamp");
+        let events = match self.host {
+            LogHost::ClaudeCode => self.claude_row(row),
+            LogHost::Codex => self.codex_row(row),
+        };
+        events
+            .into_iter()
+            .map(|event| LogEntry {
+                timestamp: timestamp.clone(),
+                event,
+            })
+            .collect()
+    }
+
+    fn set_title(&mut self, rank: u8, text: &str) {
+        if rank > self.title_rank {
+            if let Some(title) = first_line_title(text) {
+                self.meta.title = Some(title);
+                self.title_rank = rank;
+            }
+        }
+    }
+
+    fn note_meta(&mut self, row: &Value) {
+        if let Some(timestamp) = str_field(row, "timestamp") {
+            if self.meta.started_at.is_none() {
+                self.meta.started_at = Some(timestamp.clone());
+            }
+            self.meta.last_timestamp = Some(timestamp);
+        }
+        match self.host {
+            LogHost::ClaudeCode => {
+                if self.meta.session_id.is_none() {
+                    self.meta.session_id = str_field(row, "sessionId");
+                }
+                if self.meta.cwd.is_none() {
+                    self.meta.cwd = str_field(row, "cwd");
+                }
+                match row.get("type").and_then(Value::as_str) {
+                    Some("custom-title") => {
+                        if let Some(title) = str_field(row, "customTitle") {
+                            self.set_title(3, &title);
+                        }
+                    }
+                    Some("ai-title") => {
+                        if let Some(title) = str_field(row, "aiTitle") {
+                            self.set_title(2, &title);
+                        }
+                    }
+                    Some("summary") => {
+                        if let Some(title) = str_field(row, "summary") {
+                            self.set_title(2, &title);
+                        }
+                    }
+                    _ => {}
+                }
+                if self.meta.model.is_none() {
+                    self.meta.model = row
+                        .get("message")
+                        .and_then(|message| str_field(message, "model"));
+                }
+            }
+            LogHost::Codex => {
+                let Some(payload) = row.get("payload") else {
+                    return;
+                };
+                match row.get("type").and_then(Value::as_str) {
+                    Some("session_meta") => {
+                        if self.meta.session_id.is_none() {
+                            self.meta.session_id = str_field(payload, "id");
+                        }
+                        if self.meta.cwd.is_none() {
+                            self.meta.cwd = str_field(payload, "cwd");
+                        }
+                    }
+                    Some("turn_context") => {
+                        if self.meta.cwd.is_none() {
+                            self.meta.cwd = str_field(payload, "cwd");
+                        }
+                        if self.meta.model.is_none() {
+                            self.meta.model = str_field(payload, "model");
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+    }
+
+    /// Whether a Claude user row's text came from somewhere other than a person typing.
+    fn claude_non_human(row: &Value) -> bool {
+        let foreign_origin = row
+            .get("origin")
+            .and_then(Value::as_object)
+            .is_some_and(|origin| origin.get("kind").and_then(Value::as_str) != Some("human"));
+        let sdk_prompt = row.get("promptSource").and_then(Value::as_str) == Some("sdk")
+            && row.get("entrypoint").and_then(Value::as_str) == Some("sdk-cli");
+        foreign_origin || sdk_prompt
+    }
+
+    fn claude_row(&mut self, row: &Value) -> Vec<AgentEvent> {
+        let row_type = row.get("type").and_then(Value::as_str).unwrap_or("");
+        if row_type != "user" && row_type != "assistant" {
+            return Vec::new();
+        }
+        if bool_field(row, "isSidechain") {
+            return Vec::new();
+        }
+        let user = row_type == "user";
+        if user && bool_field(row, "isCompactSummary") {
+            return vec![AgentEvent::Compacted];
+        }
+        if user && bool_field(row, "isMeta") {
+            return Vec::new();
+        }
+        // Tool results arrive as user rows carrying `toolUseResult`; their `tool_result`
+        // blocks are events, but such a row's text is never the user's own.
+        let person = user && !Self::claude_non_human(row) && row.get("toolUseResult").is_none();
+        let Some(content) = row
+            .get("message")
+            .filter(|message| message.is_object())
+            .and_then(|message| message.get("content"))
+        else {
+            return Vec::new();
+        };
+        let mut events = Vec::new();
+        match content {
+            Value::String(text) => self.claude_text(user, person, text, &mut events),
+            Value::Array(blocks) => {
+                for block in blocks {
+                    match block.get("type").and_then(Value::as_str) {
+                        Some("text") => {
+                            if let Some(text) = block.get("text").and_then(Value::as_str) {
+                                self.claude_text(user, person, text, &mut events);
+                            }
+                        }
+                        Some("thinking") if !user => events.push(AgentEvent::Thinking {
+                            text: str_field(block, "thinking").unwrap_or_default(),
+                            parent_tool_use_id: None,
+                        }),
+                        Some("tool_use") if !user => {
+                            let id = str_field(block, "id").unwrap_or_default();
+                            let name = str_field(block, "name").unwrap_or_default();
+                            let input = block.get("input").cloned().unwrap_or(Value::Null);
+                            if SUBAGENT_TOOLS.contains(&name.as_str()) {
+                                self.subagents.insert(id.clone());
+                                events.push(AgentEvent::SubagentStarted {
+                                    id: id.clone(),
+                                    description: input
+                                        .get("description")
+                                        .and_then(Value::as_str)
+                                        .map(str::to_string),
+                                    parent_tool_use_id: None,
+                                });
+                            }
+                            events.push(AgentEvent::ToolUse {
+                                id,
+                                name,
+                                input,
+                                parent_tool_use_id: None,
+                            });
+                        }
+                        Some("tool_result") if user => {
+                            let id = str_field(block, "tool_use_id").unwrap_or_default();
+                            let is_error = bool_field(block, "is_error");
+                            events.push(AgentEvent::ToolResultContent {
+                                id: id.clone(),
+                                is_error,
+                                content: result_text(block.get("content")),
+                                parent_tool_use_id: None,
+                            });
+                            events.push(AgentEvent::ToolResult {
+                                id: id.clone(),
+                                is_error,
+                                parent_tool_use_id: None,
+                            });
+                            if self.subagents.remove(&id) {
+                                events.push(AgentEvent::SubagentFinished { id, is_error });
+                            }
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            _ => {}
+        }
+        events
+    }
+
+    fn claude_text(&mut self, user: bool, person: bool, text: &str, events: &mut Vec<AgentEvent>) {
+        let trimmed = text.trim();
+        if trimmed.is_empty() {
+            return;
+        }
+        if !user {
+            events.push(AgentEvent::Text {
+                text: text.to_string(),
+                parent_tool_use_id: None,
+            });
+        } else if person && !injected_context(trimmed) {
+            self.set_title(1, trimmed);
+            events.push(AgentEvent::UserMessage {
+                text: trimmed.to_string(),
+            });
+        }
+    }
+
+    fn codex_row(&mut self, row: &Value) -> Vec<AgentEvent> {
+        let row_type = row.get("type").and_then(Value::as_str).unwrap_or("");
+        if row_type == "compacted" {
+            return vec![AgentEvent::Compacted];
+        }
+        if row_type != "response_item" {
+            return Vec::new();
+        }
+        let Some(payload) = row.get("payload").filter(|payload| payload.is_object()) else {
+            return Vec::new();
+        };
+        match payload.get("type").and_then(Value::as_str).unwrap_or("") {
+            "message" => self.codex_message(payload),
+            "function_call" | "custom_tool_call" => {
+                let name = str_field(payload, "name")
+                    .or_else(|| str_field(payload, "tool_name"))
+                    .unwrap_or_else(|| "unknown".to_string());
+                let arguments = payload
+                    .get("arguments")
+                    .or_else(|| payload.get("input"))
+                    .cloned()
+                    .unwrap_or(Value::Null);
+                // Codex stores arguments as a JSON string; give the host the decoded value
+                // when it decodes, else the text.
+                let input = match arguments {
+                    Value::String(text) => {
+                        serde_json::from_str(&text).unwrap_or(Value::String(text))
+                    }
+                    other => other,
+                };
+                vec![AgentEvent::ToolUse {
+                    id: str_field(payload, "call_id").unwrap_or_default(),
+                    name,
+                    input,
+                    parent_tool_use_id: None,
+                }]
+            }
+            "local_shell_call" => vec![AgentEvent::ToolUse {
+                id: str_field(payload, "call_id")
+                    .or_else(|| str_field(payload, "id"))
+                    .unwrap_or_default(),
+                name: "local_shell".to_string(),
+                input: payload.get("action").cloned().unwrap_or(Value::Null),
+                parent_tool_use_id: None,
+            }],
+            "function_call_output" | "custom_tool_call_output" => {
+                let id = str_field(payload, "call_id").unwrap_or_default();
+                let is_error = bool_field(payload, "is_error");
+                let content = match payload.get("output").or_else(|| payload.get("content")) {
+                    Some(Value::String(text)) => text.clone(),
+                    Some(Value::Null) | None => String::new(),
+                    Some(other) => other.to_string(),
+                };
+                vec![
+                    AgentEvent::ToolResultContent {
+                        id: id.clone(),
+                        is_error,
+                        content,
+                        parent_tool_use_id: None,
+                    },
+                    AgentEvent::ToolResult {
+                        id,
+                        is_error,
+                        parent_tool_use_id: None,
+                    },
+                ]
+            }
+            "reasoning" => {
+                let text = payload
+                    .get("summary")
+                    .and_then(Value::as_array)
+                    .map(|parts| {
+                        parts
+                            .iter()
+                            .filter_map(|part| {
+                                part.as_str()
+                                    .or_else(|| part.get("text").and_then(Value::as_str))
+                            })
+                            .collect::<Vec<&str>>()
+                            .join("\n")
+                    })
+                    .unwrap_or_default();
+                vec![AgentEvent::Thinking {
+                    text,
+                    parent_tool_use_id: None,
+                }]
+            }
+            _ => Vec::new(),
+        }
+    }
+
+    fn codex_message(&mut self, payload: &Value) -> Vec<AgentEvent> {
+        let role = payload.get("role").and_then(Value::as_str).unwrap_or("");
+        if role != "user" && role != "assistant" {
+            return Vec::new();
+        }
+        let text = match payload.get("content") {
+            Some(Value::String(text)) => text.clone(),
+            Some(Value::Array(blocks)) => blocks
+                .iter()
+                .filter(|block| {
+                    matches!(
+                        block.get("type").and_then(Value::as_str),
+                        Some("input_text" | "output_text" | "text")
+                    )
+                })
+                .filter_map(|block| block.get("text").and_then(Value::as_str))
+                .collect::<Vec<&str>>()
+                .join("\n"),
+            _ => return Vec::new(),
+        };
+        if role == "assistant" {
+            if text.trim().is_empty() {
+                return Vec::new();
+            }
+            return vec![AgentEvent::Text {
+                text,
+                parent_tool_use_id: None,
+            }];
+        }
+        let text = codex_user_text(&text);
+        if text.is_empty() || injected_context(&text) {
+            return Vec::new();
+        }
+        self.set_title(1, &text);
+        vec![AgentEvent::UserMessage { text }]
+    }
+}

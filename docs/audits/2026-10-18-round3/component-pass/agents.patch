+/// The environment for a Claude launch: every credential-class variable in
+/// [`BYOK_ENV_VARS`](crate::launch_env::BYOK_ENV_VARS) is removed, then the chosen account
+/// credential is set. The variable of the other kind is removed too, so exactly one
+/// credential reaches the CLI. `None` only scrubs.
+///
+/// Apply it with `SessionConfig::with_launch_env`, or [`LaunchEnv::apply`]. The token or key
+/// is held in memory only; nothing here reads or writes a file.
+pub fn launch_env(account: Option<&ClaudeAccountEnv>) -> LaunchEnv {
+    let scrubbed = LaunchEnv::new().scrub_byok();
+    match account {
+        None => scrubbed,
+        Some(ClaudeAccountEnv::OAuthToken(token)) => {
+            scrubbed.with_var(OAUTH_TOKEN_ENV, token.as_str())
+        }
+        Some(ClaudeAccountEnv::ApiKey(key)) => scrubbed
+            .scrub([OAUTH_TOKEN_ENV])
+            .with_var(concat!("ANTHROPIC", "_API_KEY"), key.as_str()),
+    }
+}

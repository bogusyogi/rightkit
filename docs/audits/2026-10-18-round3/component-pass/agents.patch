+/// [`build_args`] with the options in `extras`. Keys and values are checked before they
+/// reach the argv: a key is non-empty and made of ASCII letters, digits and `_ . -`; a value
+/// is non-empty and free of NUL bytes and newlines.
+pub fn build_args_with(extras: &CodexExtras) -> Result<Vec<String>, String> {
+    let mut args = Vec::new();
+    for (key, value) in &extras.config_overrides {
+        let key_ok = !key.is_empty()
+            && key
+                .chars()
+                .all(|c| c.is_ascii_alphanumeric() || matches!(c, '_' | '.' | '-'));
+        if !key_ok {
+            return Err("codex config override key is not a valid config path".to_string());
+        }
+        if value.is_empty() || value.contains(['\0', '\n', '\r']) {
+            return Err(format!(
+                "codex config override value for {key} must be non-empty single-line text"
+            ));
+        }
+        args.push("-c".to_string());
+        args.push(format!("{key}={value}"));
+    }
+    args.extend(build_args());
+    if extras.strict_config {
+        args.push("--strict-config".to_string());
+    }
+    Ok(args)
+}
+
+/// `text` as a TOML basic string, quoted and escaped, for a [`CodexExtras::config_overrides`]
+/// value.
+pub fn toml_string(text: &str) -> String {
+    let mut out = String::with_capacity(text.len() + 2);
+    out.push('"');
+    for c in text.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if (c as u32) < 0x20 || c as u32 == 0x7f => {
+                out.push_str(&format!("\\u{:04X}", c as u32));
+            }
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+/// Config overrides that give this launch one MCP server `name` running `command` with
+/// `args`, for [`CodexExtras::config_overrides`]. The server exists only for the launch it
+/// is passed to; nothing is written to Codex's config file. This crate only builds the
+/// argv text and speaks no MCP. The `mcp_servers.<name>.command` and `.args` keys follow
+/// Codex's documented config; they are unverified against a live run. `name` is non-empty
+/// ASCII letters, digits, `_` and `-`.
+pub fn mcp_server_overrides(
+    name: &str,
+    command: &str,
+    args: &[&str],
+) -> Result<Vec<(String, String)>, String> {
+    let name_ok = !name.is_empty()
+        && name
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, '_' | '-'));
+    if !name_ok {
+        return Err("mcp server name must be ASCII letters, digits, '_' or '-'".to_string());
+    }
+    if command.trim().is_empty() {
+        return Err("mcp server command must not be empty".to_string());
+    }
+    let list = args
+        .iter()
+        .map(|arg| toml_string(arg))
+        .collect::<Vec<String>>()
+        .join(", ");
+    Ok(vec![
+        (format!("mcp_servers.{name}.command"), toml_string(command)),
+        (format!("mcp_servers.{name}.args"), format!("[{list}]")),
+    ])
+}

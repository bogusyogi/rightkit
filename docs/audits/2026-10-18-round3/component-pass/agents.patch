+/// Adjusts the [`std::process::Command`] of a probe before it starts: confine it, set its
+/// environment or working directory, wrap its launch. Stdin, stdout and stderr are set after
+/// the customiser runs and cannot be changed by it.
+pub type CommandCustomiser<'a> = &'a dyn Fn(&mut std::process::Command);
+
+/// [`run_bounded`] with a [`CommandCustomiser`], for hosts that must sandbox or otherwise
+/// shape the vendor CLI process even for a `--version` probe. The child is still owned: the
+/// deadline terminates its whole tree, and output is capped at [`PROBE_OUTPUT_CAP`] per
+/// stream. `None` when it cannot start, times out, or cannot be waited on.
+pub fn run_bounded_with(
+    program: &Path,
+    args: &[&str],
+    timeout: Duration,
+    customise: CommandCustomiser<'_>,
+) -> Option<Output> {
+    use std::process::Stdio;
+
+    use rightkit_child_process::{CapturedOutput, NativeOutputCapture, OwnedCommand, WaitOutcome};
+
+    let mut command = std::process::Command::new(program);
+    command.args(args);
+    customise(&mut command);
+    command
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+    let mut owned = OwnedCommand::from_command(command);
+    owned.windows_hide();
+    let mut child = owned.spawn().ok()?;
+    let mut stdout = child
+        .take_stdout()
+        .map(|pipe| NativeOutputCapture::stdout(pipe, PROBE_OUTPUT_CAP))
+        .transpose()
+        .ok()?;
+    let mut stderr = child
+        .take_stderr()
+        .map(|pipe| NativeOutputCapture::stderr(pipe, PROBE_OUTPUT_CAP))
+        .transpose()
+        .ok()?;
+    let outcome = child.wait_then_kill(timeout);
+    let drain = Duration::from_secs(2);
+    let stdout: CapturedOutput = stdout
+        .as_mut()
+        .map_or_else(CapturedOutput::default, |capture| {
+            capture.finish_within(drain)
+        });
+    let stderr: CapturedOutput = stderr
+        .as_mut()
+        .map_or_else(CapturedOutput::default, |capture| {
+            capture.finish_within(drain)
+        });
+    match outcome.ok()? {
+        WaitOutcome::Exited(status) => Some(Output {
+            status,
+            stdout: stdout.bytes,
+            stderr: stderr.bytes,
+        }),
+        WaitOutcome::Terminated(_) => None,
+    }
+}

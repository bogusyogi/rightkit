+//! Environment for a vendor CLI launch: which inherited credential-class variables to remove
+//! and which account variables to set.
+//!
+//! Pure data with no I/O. A [`LaunchEnv`] is applied to a [`std::process::Command`] with
+//! [`LaunchEnv::apply`], or handed to `session::SessionConfig::with_launch_env`. Removal runs
+//! before setting, so a variable that is both scrubbed and explicitly set ends up set.
+
+use std::ffi::{OsStr, OsString};
+use std::process::Command;
+
+/// Bring-your-own-key and provider-routing variables an account-scoped launch must not
+/// inherit. Pass the list to `session::SessionConfig::scrub_byok_env` or
+/// [`LaunchEnv::scrub_byok`]. Names are spelled with `concat!` where the scope test bans the
+/// literal. `CODEX_API_KEY` and `ANTHROPIC_AUTH_TOKEN` are included as credential-class names;
+/// their exact CLI behavior is unverified.
+///
+/// The Bedrock, Vertex, AWS, Google, xAI, Cursor, OpenRouter, MiniMax and TinyFish entries
+/// follow CodeRight's `FORBIDDEN_BYOK_ENV_VARS`. CodeRight's own daemon and gateway secrets
+/// are not listed: they belong to that app, so it passes them to [`LaunchEnv::scrub`].
+pub const BYOK_ENV_VARS: &[&str] = &[
+    // Anthropic / Claude.
+    concat!("ANTHROPIC", "_API_KEY"),
+    concat!("ANTHROPIC", "_AUTH_TOKEN"),
+    "CLAUDE_CODE_USE_BEDROCK",
+    "CLAUDE_CODE_USE_VERTEX",
+    "AWS_ACCESS_KEY_ID",
+    "AWS_SECRET_ACCESS_KEY",
+    "AWS_SESSION_TOKEN",
+    "AWS_PROFILE",
+    "GOOGLE_APPLICATION_CREDENTIALS",
+    "GOOGLE_CLOUD_PROJECT",
+    // OpenAI / Codex.
+    concat!("OPENAI", "_API_KEY"),
+    concat!("CODEX", "_API_KEY"),
+    "OPENAI_BASE_URL",
+    "OPENAI_ORG_ID",
+    "OPENAI_PROJECT",
+    // Other providers.
+    "XAI_API_KEY",
+    "XAI_BASE_URL",
+    "CURSOR_API_KEY",
+    "CURSOR_API_BASE_URL",
+    "OPENROUTER_API_KEY",
+    "MINIMAX_API_KEY",
+    "TINYFISH_API_KEY",
+];
+
+/// Variables to remove from, and set on, a child's environment.
+///
+/// `Debug` prints the names of the variables to set and never their values, so a token set
+/// through it cannot reach a log.
+#[derive(Clone, Default, PartialEq, Eq)]
+pub struct LaunchEnv {
+    /// Inherited variables removed before spawn.
+    pub remove: Vec<OsString>,
+    /// Variables set after the removals.
+    pub set: Vec<(OsString, OsString)>,
+}
+
+impl std::fmt::Debug for LaunchEnv {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let names: Vec<&OsString> = self.set.iter().map(|(name, _)| name).collect();
+        f.debug_struct("LaunchEnv")
+            .field("remove", &self.remove)
+            .field("set_names", &names)
+            .finish()
+    }
+}
+
+impl LaunchEnv {
+    /// An empty environment change.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Also remove every name in [`BYOK_ENV_VARS`].
+    pub fn scrub_byok(self) -> Self {
+        self.scrub(BYOK_ENV_VARS.iter().copied())
+    }
+
+    /// Also remove the given names (a caller-supplied scrub list).
+    pub fn scrub<I, S>(mut self, names: I) -> Self
+    where
+        I: IntoIterator<Item = S>,
+        S: Into<OsString>,
+    {
+        for name in names {
+            let name = name.into();
+            if !self.remove.contains(&name) {
+                self.remove.push(name);
+            }
+        }
+        self
+    }
+
+    /// Also set `name` to `value`. A later call for the same name replaces the earlier one.
+    pub fn with_var(mut self, name: impl Into<OsString>, value: impl Into<OsString>) -> Self {
+        let name = name.into();
+        self.set.retain(|(existing, _)| existing != &name);
+        self.set.push((name, value.into()));
+        self
+    }
+
+    /// Fold `other` in: its removals are added and its variables replace same-named ones.
+    pub fn merge(mut self, other: LaunchEnv) -> Self {
+        self = self.scrub(other.remove);
+        for (name, value) in other.set {
+            self = self.with_var(name, value);
+        }
+        self
+    }
+
+    /// Whether this change removes `name`.
+    pub fn removes(&self, name: &OsStr) -> bool {
+        self.remove.iter().any(|removed| removed == name)
+    }
+
+    /// Apply to `command`: removals first, then the variables to set.
+    pub fn apply(&self, command: &mut Command) {
+        for name in &self.remove {
+            command.env_remove(name);
+        }
+        for (name, value) in &self.set {
+            command.env(name, value);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn byok_list_covers_the_cloud_and_provider_credentials() {
+        for name in [
+            "CLAUDE_CODE_USE_BEDROCK",
+            "CLAUDE_CODE_USE_VERTEX",
+            "AWS_ACCESS_KEY_ID",
+            "AWS_SECRET_ACCESS_KEY",
+            "AWS_SESSION_TOKEN",
+            "AWS_PROFILE",
+            "GOOGLE_APPLICATION_CREDENTIALS",
+            "OPENAI_BASE_URL",
+            "XAI_API_KEY",
+            "OPENROUTER_API_KEY",
+        ] {
+            assert!(BYOK_ENV_VARS.contains(&name), "{name} is not scrubbed");
+        }
+        assert!(BYOK_ENV_VARS.contains(&concat!("ANTHROPIC", "_API_KEY")));
+        assert!(BYOK_ENV_VARS.contains(&concat!("OPENAI", "_API_KEY")));
+    }
+
+    #[test]
+    fn scrub_is_deduplicated_and_accepts_a_caller_list() {
+        let env = LaunchEnv::new()
+            .scrub_byok()
+            .scrub(["APP_DAEMON_TOKEN", "AWS_PROFILE"]);
+        assert_eq!(env.remove.len(), BYOK_ENV_VARS.len() + 1);
+        assert!(env.removes(OsStr::new("APP_DAEMON_TOKEN")));
+    }
+
+    #[test]
+    fn a_later_set_replaces_an_earlier_one_and_debug_hides_values() {
+        let env = LaunchEnv::new()
+            .with_var("TOKEN_VAR", "first-secret")
+            .with_var("TOKEN_VAR", "second-secret");
+        assert_eq!(env.set.len(), 1);
+        let shown = format!("{env:?}");
+        assert!(shown.contains("TOKEN_VAR"));
+        assert!(!shown.contains("secret"));
+    }
+
+    #[test]
+    fn merge_combines_removals_and_overrides_variables() {
+        let base = LaunchEnv::new().scrub(["A"]).with_var("X", "1");
+        let other = LaunchEnv::new().scrub(["B"]).with_var("X", "2");
+        let merged = base.merge(other);
+        assert!(merged.removes(OsStr::new("A")) && merged.removes(OsStr::new("B")));
+        assert_eq!(merged.set, vec![(OsString::from("X"), OsString::from("2"))]);
+    }
+}

+
+// ---- host-launched children (spawn_with)
+
+#[test]
+fn spawn_with_runs_the_protocol_on_a_child_the_host_launched() {
+    let launched = std::sync::atomic::AtomicBool::new(false);
+    let session = Session::spawn_with(
+        config(Backend::Claude(ClaudeOptions::default()), "claude"),
+        |command| {
+            launched.store(true, std::sync::atomic::Ordering::SeqCst);
+            // The host starts the process itself; here a plain std child stands in for a
+            // confined one.
+            SpawnedChild::from_std(command.spawn()?)
+        },
+    )
+    .expect("spawn_with");
+    assert!(launched.load(std::sync::atomic::Ordering::SeqCst));
+    assert!(session.try_pid().is_some());
+    session.send_user_message("hello").unwrap();
+    let seen = collect_until(&session, |event| {
+        matches!(event, SessionEvent::Agent(AgentEvent::ApprovalRequested { .. }))
+    });
+    assert!(seen
+        .iter()
+        .any(|event| matches!(event, SessionEvent::Agent(AgentEvent::Init { .. }))));
+    session.approve("req_1", ApprovalDecision::Allow).unwrap();
+    collect_until(&session, |event| {
+        matches!(event, SessionEvent::Agent(AgentEvent::Result { .. }))
+    });
+    session.shutdown(Some(Duration::from_secs(2))).unwrap();
+}
+
+/// A handle that records how the session ended the process.
+struct Recorded {
+    child: std::process::Child,
+    ended: std::sync::Arc<std::sync::atomic::AtomicBool>,
+}
+
+impl ChildHandle for Recorded {
+    fn id(&self) -> Option<u32> {
+        Some(self.child.id())
+    }
+
+    fn try_wait(&mut self) -> std::io::Result<Option<std::process::ExitStatus>> {
+        self.child.try_wait()
+    }
+
+    fn wait_then_kill(
+        &mut self,
+        _grace: Duration,
+    ) -> std::io::Result<(std::process::ExitStatus, bool)> {
+        self.ended.store(true, std::sync::atomic::Ordering::SeqCst);
+        let _ = self.child.kill();
+        Ok((self.child.wait()?, true))
+    }
+}
+
+#[test]
+fn a_failed_startup_stops_a_host_launched_child_through_its_handle() {
+    let ended = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let flag = std::sync::Arc::clone(&ended);
+    let mut cfg = config(Backend::Codex(CodexOptions::default()), "exit");
+    cfg.startup_timeout = Duration::from_secs(10);
+    let result = Session::spawn_with(cfg, move |command| {
+        let mut child = command.spawn()?;
+        let stdin = child.stdin.take().unwrap();
+        let stdout = child.stdout.take().unwrap();
+        Ok(SpawnedChild::from_parts(
+            Box::new(Recorded { child, ended: flag }),
+            Box::new(stdin),
+            Box::new(stdout),
+            None,
+        ))
+    });
+    assert!(matches!(result, Err(SessionError::Startup(_))));
+    assert!(ended.load(std::sync::atomic::Ordering::SeqCst));
+}

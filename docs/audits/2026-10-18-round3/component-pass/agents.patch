+/// Reads a log incrementally: each [`LogTail::poll_each`] sees only the complete lines
+/// appended since the last one. The unfinished last line stays buffered until its newline
+/// arrives. Holds one parser and one partial line, so memory does not grow with the log.
+#[derive(Debug)]
+pub struct LogTail {
+    parser: LogParser,
+    offset: u64,
+    partial: Vec<u8>,
+    seq: u64,
+    skipped_rows: u64,
+}
+
+impl LogTail {
+    pub fn new(host: LogHost) -> Self {
+        Self {
+            parser: LogParser::new(host),
+            offset: 0,
+            partial: Vec::new(),
+            seq: 0,
+            skipped_rows: 0,
+        }
+    }
+
+    /// What the rows read so far say about the session.
+    pub fn meta(&self) -> &SessionMeta {
+        self.parser.meta()
+    }
+
+    /// The sequence number of the last event produced (0 before any).
+    pub fn last_seq(&self) -> u64 {
+        self.seq
+    }
+
+    /// Lines that were not JSON and were skipped.
+    pub fn skipped_rows(&self) -> u64 {
+        self.skipped_rows
+    }
+
+    /// Read what was appended to `path` since the last call and hand each event to `each`;
+    /// return `false` from `each` to stop. A tail stopped early has consumed part of a line:
+    /// drop it rather than poll again. A file shorter than what was already read (truncated or
+    /// replaced) is an `InvalidData` error: the sequence numbers no longer mean anything.
+    pub fn poll_each(
+        &mut self,
+        path: &Path,
+        mut each: impl FnMut(SeqEntry) -> bool,
+    ) -> io::Result<()> {
+        let mut file = File::open(path)?;
+        let length = file.metadata()?.len();
+        let consumed = self.offset + self.partial.len() as u64;
+        if length < consumed {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "log is shorter than what was already read",
+            ));
+        }
+        file.seek(SeekFrom::Start(consumed))?;
+        let mut reader = BufReader::new(file.take(length - consumed));
+        loop {
+            let mut chunk = Vec::new();
+            if reader.read_until(b'\n', &mut chunk)? == 0 {
+                return Ok(());
+            }
+            if !chunk.ends_with(b"\n") {
+                // The writer has not finished this line.
+                self.partial.extend_from_slice(&chunk);
+                return Ok(());
+            }
+            let mut line = std::mem::take(&mut self.partial);
+            line.extend_from_slice(&chunk);
+            self.offset += line.len() as u64;
+            let text = String::from_utf8_lossy(&line);
+            match self.parser.parse_line(&text) {
+                Ok(entries) => {
+                    for entry in entries {
+                        self.seq += 1;
+                        if !each(SeqEntry {
+                            seq: self.seq,
+                            entry,
+                        }) {
+                            return Ok(());
+                        }
+                    }
+                }
+                Err(_) => self.skipped_rows += 1,
+            }
+        }
+    }
+}
+
+/// A whole log, read to its last complete line.
+#[derive(Debug, Clone, PartialEq)]
+pub struct LogRead {
+    pub entries: Vec<SeqEntry>,
+    pub meta: SessionMeta,
+    pub skipped_rows: u64,
+}
+
+/// Read every event of the log at `path`. Reads the whole file into events; for a long log
+/// use [`LogTail::poll_each`] and keep only what is needed.
+pub fn read_log(path: &Path, host: LogHost) -> io::Result<LogRead> {
+    let mut tail = LogTail::new(host);
+    let mut entries = Vec::new();
+    tail.poll_each(path, |entry| {
+        entries.push(entry);
+        true
+    })?;
+    Ok(LogRead {
+        entries,
+        meta: tail.meta().clone(),
+        skipped_rows: tail.skipped_rows(),
+    })
+}
+
+/// Rows read by [`read_meta`] before it gives up looking for a title.
+pub const META_ROWS: usize = 200;
+/// Bytes read by [`read_meta`].
+pub const META_BYTES: u64 = 256 * 1024;
+
+/// The [`SessionMeta`] found in the head of the log at `path` (the first [`META_ROWS`] rows
+/// or [`META_BYTES`] bytes), without reading the rest. For listing many logs cheaply.
+pub fn read_meta(path: &Path, host: LogHost) -> io::Result<SessionMeta> {
+    let file = File::open(path)?;
+    let mut reader = BufReader::new(file.take(META_BYTES));
+    let mut parser = LogParser::new(host);
+    for _ in 0..META_ROWS {
+        let mut line = Vec::new();
+        if reader.read_until(b'\n', &mut line)? == 0 || !line.ends_with(b"\n") {
+            break;
+        }
+        let _ = parser.parse_line(&String::from_utf8_lossy(&line));
+        let meta = parser.meta();
+        if meta.session_id.is_some() && meta.cwd.is_some() && meta.title.is_some() {
+            break;
+        }
+    }
+    Ok(parser.meta().clone())
+}

+
+static MESSAGE_IDS: AtomicU64 = AtomicU64::new(1);
+
+/// An id that is a plain token: it becomes part of a file name, so it must not carry a path.
+fn clean_id(raw: &str) -> Option<&str> {
+    let ok = !raw.is_empty()
+        && raw.len() <= 128
+        && raw
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_');
+    ok.then_some(raw)
+}
+
+enum Target<'a> {
+    Claude(&'a str),
+    Codex(&'a str),
+}
+
+fn parse_id(id: &str) -> Option<Target<'_>> {
+    if let Some(rest) = id.strip_prefix("claude:") {
+        return clean_id(rest).map(Target::Claude);
+    }
+    id.strip_prefix("codex:")
+        .and_then(clean_id)
+        .map(Target::Codex)
+}
+
+/// One registry record of a running Claude Code chat.
+struct Registered {
+    session_id: String,
+    pid: u32,
+    cwd: String,
+    name: String,
+    status: Option<ExternalStatus>,
+    updated_ms: Option<u64>,
+}
+
+fn registered_sessions(claude_dir: &Path) -> Vec<Registered> {
+    let Ok(listing) = std::fs::read_dir(claude_dir.join("sessions")) else {
+        return Vec::new();
+    };
+    let mut out: Vec<Registered> = Vec::new();
+    for entry in listing.flatten() {
+        let path = entry.path();
+        if path.extension().and_then(|ext| ext.to_str()) != Some("json") {
+            continue;
+        }
+        let Some(value) = std::fs::read(&path)
+            .ok()
+            .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        else {
+            continue;
+        };
+        let Some(record) = registered(&value) else {
+            continue;
+        };
+        // One session id can have two files (a resumed chat's old file): keep the newest.
+        match out
+            .iter_mut()
+            .find(|known| known.session_id == record.session_id)
+        {
+            Some(known) => {
+                if record.updated_ms.unwrap_or(0) > known.updated_ms.unwrap_or(0) {
+                    *known = record;
+                }
+            }
+            None => out.push(record),
+        }
+    }
+    out
+}
+
+fn registered(value: &Value) -> Option<Registered> {
+    let pid = u32::try_from(value.get("pid")?.as_u64()?).ok()?;
+    let session_id = clean_id(value.get("sessionId")?.as_str()?)?.to_string();
+    // Chats an app drives itself (SDK and other non-interactive entrypoints) are not
+    // "started outside the app".
+    match value.get("entrypoint").and_then(Value::as_str) {
+        None | Some("cli" | "claude-desktop" | "claude-vscode") => {}
+        Some(_) => return None,
+    }
+    let text = |key: &str| value.get(key).and_then(Value::as_str).unwrap_or("");
+    Some(Registered {
+        session_id,
+        pid,
+        cwd: text("cwd").to_string(),
+        name: text("name").trim().to_string(),
+        status: ExternalStatus::from_registry(text("status")),
+        updated_ms: ["statusUpdatedAt", "updatedAt"]
+            .iter()
+            .find_map(|key| value.get(*key).and_then(Value::as_u64)),
+    })
+}
+
+fn modified_ms(path: &Path) -> Option<u64> {
+    let modified = std::fs::metadata(path).ok()?.modified().ok()?;
+    let elapsed = modified.duration_since(UNIX_EPOCH).ok()?;
+    u64::try_from(elapsed.as_millis()).ok()
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |elapsed| u64::try_from(elapsed.as_millis()).unwrap_or(u64::MAX))
+}
+
+/// `ms` since the Unix epoch as an RFC 3339 UTC timestamp, whole seconds.
+pub fn rfc3339_utc(ms: u64) -> String {
+    let seconds = ms / 1000;
+    let days = i64::try_from(seconds / 86_400).unwrap_or(0);
+    let rest = seconds % 86_400;
+    // Civil date from a day count (Howard Hinnant's days-to-civil).
+    let shifted = days + 719_468;
+    let era = shifted.div_euclid(146_097);
+    let day_of_era = shifted.rem_euclid(146_097);
+    let year_of_era =
+        (day_of_era - day_of_era / 1460 + day_of_era / 36_524 - day_of_era / 146_096) / 365;
+    let day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
+    let month_index = (5 * day_of_year + 2) / 153;
+    let day = day_of_year - (153 * month_index + 2) / 5 + 1;
+    let month = if month_index < 10 {
+        month_index + 3
+    } else {
+        month_index - 9
+    };
+    let year = year_of_era + era * 400 + i64::from(month <= 2);
+    format!(
+        "{year:04}-{month:02}-{day:02}T{:02}:{:02}:{:02}Z",
+        rest / 3600,
+        rest % 3600 / 60,
+        rest % 60
+    )
+}
+
+fn basename(path: &str) -> Option<String> {
+    Path::new(path)
+        .file_name()
+        .map(|name| name.to_string_lossy().into_owned())
+        .filter(|name| !name.is_empty())
+}
+
+/// The running processes, read once; `None` when the table cannot be read.
+fn process_snapshot() -> Option<HashSet<u32>> {
+    rightkit_child_process::process_table()
+        .ok()
+        .map(|rows| rows.into_iter().map(|row| row.pid).collect())
+}
+
+/// A liveness verdict source for one call: the configured check, or one process-table read.
+enum Liveness {
+    Check(AliveCheck),
+    Snapshot(Option<HashSet<u32>>),
+}
+
+impl Liveness {
+    fn of(config: &ExternalConfig) -> Self {
+        match &config.alive {
+            Some(check) => Liveness::Check(Arc::clone(check)),
+            None => Liveness::Snapshot(process_snapshot()),
+        }
+    }
+
+    /// `Some(running)`, or `None` when it cannot be told.
+    fn running(&self, pid: u32) -> Option<bool> {
+        match self {
+            Liveness::Check(check) => Some(check(pid)),
+            Liveness::Snapshot(Some(pids)) => Some(pids.contains(&pid)),
+            Liveness::Snapshot(None) => None,
+        }
+    }
+}
+
+impl ExternalSessions {
+    pub fn new(config: ExternalConfig) -> Self {
+        Self { config }
+    }
+
+    pub fn config(&self) -> &ExternalConfig {
+        &self.config
+    }
+
+    /// Every external session worth showing, newest first: running Claude Code chats from
+    /// the registry, then recently active chats whose process is gone (see
+    /// [`ExternalConfig::stale_window`]), then recent Codex logs. At most
+    /// [`ExternalConfig::max_sessions`].
+    pub fn list(&self) -> Vec<ExternalSession> {
+        let config = &self.config;
+        let now = now_ms();
+        let window_ms = u64::try_from(config.stale_window.as_millis()).unwrap_or(u64::MAX);
+        let recent = |ms: Option<u64>| ms.is_some_and(|ms| now.saturating_sub(ms) <= window_ms);
+        let liveness = Liveness::of(config);
+        let mut rows: Vec<(u64, ExternalSession)> = Vec::new();
+        let mut seen: HashSet<String> = HashSet::new();
+
+        if let Some(claude_dir) = &config.claude_dir {
+            for record in registered_sessions(claude_dir) {
+                let log = find_claude_log(claude_dir, &record.session_id);
+                let log_ms = log.as_deref().and_then(modified_ms);
+                let running = liveness.running(record.pid);
+                let state = match running {
+                    Some(true) => ExternalLiveness::Live,
+                    Some(false) => ExternalLiveness::Stale,
+                    None => ExternalLiveness::Unknown,
+                };
+                let updated = record.updated_ms.or(log_ms);
+                if state != ExternalLiveness::Live && !recent(updated) {
+                    continue;
+                }
+                seen.insert(format!("claude:{}", record.session_id));
+                let title = if record.name.is_empty() {
+                    basename(&record.cwd).unwrap_or_else(|| "Claude chat".to_string())
+                } else {
+                    record.name.clone()
+                };
+                let mut session = ExternalSession {
+                    id: format!("claude:{}", record.session_id),
+                    title,
+                    cwd: record.cwd.clone(),
+                    host: config.host.clone(),
+                    account: config.account.clone(),
+                    status: if state == ExternalLiveness::Live {
+                        record.status
+                    } else {
+                        None
+                    },
+                    liveness: state,
+                    input_available: false,
+                    updated_at: rfc3339_utc(updated.unwrap_or(0)),
+                };
+                session.input_available = state == ExternalLiveness::Live
+                    && config
+                        .deliverer
+                        .as_ref()
+                        .is_some_and(|deliverer| deliverer.can_deliver(&session));
+                rows.push((updated.unwrap_or(0), session));
+            }
+        }
+
+        for log in logs::discover_in(config.claude_dir.as_deref(), config.codex_dir.as_deref()) {
+            let modified = modified_ms(&log.path);
+            if !recent(modified) {
+                continue;
+            }
+            let Ok(meta) = logs::read_meta(&log.path, log.host) else {
+                continue;
+            };
+            let file_stem = log
+                .path
+                .file_stem()
+                .map(|stem| stem.to_string_lossy().into_owned())
+                .unwrap_or_default();
+            let session_id = match log.host {
+                LogHost::ClaudeCode => meta.session_id.clone().unwrap_or(file_stem),
+                LogHost::Codex => meta
+                    .session_id
+                    .clone()
+                    .or_else(|| codex_id_from_file_stem(&file_stem))
+                    .unwrap_or(file_stem),
+            };
+            let Some(session_id) = clean_id(&session_id).map(str::to_string) else {
+                continue;
+            };
+            let prefix = match log.host {
+                LogHost::ClaudeCode => "claude",
+                LogHost::Codex => "codex",
+            };
+            let id = format!("{prefix}:{session_id}");
+            if !seen.insert(id.clone()) {
+                continue;
+            }
+            let cwd = meta.cwd.clone().unwrap_or_default();
+            let title = meta
+                .title
+                .clone()
+                .or_else(|| basename(&cwd))
+                .unwrap_or_else(|| match log.host {
+                    LogHost::ClaudeCode => "Claude chat".to_string(),
+                    LogHost::Codex => "Codex chat".to_string(),
+                });
+            rows.push((
+                modified.unwrap_or(0),
+                ExternalSession {
+                    id,
+                    title,
+                    cwd,
+                    host: config.host.clone(),
+                    account: config.account.clone(),
+                    status: None,
+                    // A Claude log without a running registry entry is a finished chat; a
+                    // Codex log says nothing about a process.
+                    liveness: match log.host {
+                        LogHost::ClaudeCode => ExternalLiveness::Stale,
+                        LogHost::Codex => ExternalLiveness::Unknown,
+                    },
+                    input_available: false,
+                    updated_at: rfc3339_utc(modified.unwrap_or(0)),
+                },
+            ));
+        }
+
+        rows.sort_by(|a, b| b.0.cmp(&a.0).then_with(|| a.1.id.cmp(&b.1.id)));
+        rows.truncate(config.max_sessions);
+        rows.into_iter().map(|(_, session)| session).collect()
+    }
+
+    /// Whether `id` names a session this computer has a log or a registry entry for.
+    pub fn is_external(&self, id: &str) -> bool {
+        self.log_for(id).is_ok()
+    }
+
+    fn log_for(&self, id: &str) -> Result<(LogHost, PathBuf), ExternalError> {
+        match parse_id(id).ok_or(ExternalError::NotFound)? {
+            Target::Claude(session) => {
+                let dir = self.config.claude_dir.as_deref();
+                dir.and_then(|dir| find_claude_log(dir, session))
+                    .map(|path| (LogHost::ClaudeCode, path))
+                    .ok_or(ExternalError::NotFound)
+            }
+            Target::Codex(session) => {
+                let dir = self.config.codex_dir.as_deref();
+                dir.and_then(|dir| find_codex_log(dir, session))
+                    .map(|path| (LogHost::Codex, path))
+                    .ok_or(ExternalError::NotFound)
+            }
+        }
+    }
+
+    /// Events with `seq > after_seq` (all when `None`), oldest first, at most `limit` rows.
+    /// Reads the log, so it works whether or not the chat is running. Cost is one pass over
+    /// the log up to the last row returned.
+    pub fn history(
+        &self,
+        id: &str,
+        after_seq: Option<u64>,
+        limit: Option<usize>,
+    ) -> Result<Vec<(u64, AgentEvent)>, ExternalError> {
+        let (host, path) = self.log_for(id)?;
+        let after = after_seq.unwrap_or(0);
+        let mut rows: Vec<(u64, AgentEvent)> = Vec::new();
+        let mut tail = LogTail::new(host);
+        tail.poll_each(&path, |entry| {
+            if entry.seq <= after {
+                return true;
+            }
+            rows.push((entry.seq, entry.entry.event));
+            limit.is_none_or(|limit| rows.len() < limit)
+        })
+        .map_err(|error| match error.kind() {
+            std::io::ErrorKind::NotFound => ExternalError::NotFound,
+            _ => ExternalError::Other(error.to_string()),
+        })?;
+        if limit == Some(0) {
+            rows.clear();
+        }
+        Ok(rows)
+    }
+
+    /// Live events with `seq > after_seq`, followed as the chat's log grows. `Err(NotRunning)`
+    /// when the chat is not running; `Err(Unsupported)` for Codex, which has no registry to
+    /// prove it. The tail ends (the receiver reports a disconnect) when the chat's process
+    /// goes away, when the log is truncated or removed, or when the [`Tail`] is dropped.
+    pub fn tail(&self, id: &str, after_seq: u64) -> Result<Tail, ExternalError> {
+        let Target::Claude(session) = parse_id(id).ok_or(ExternalError::NotFound)? else {
+            // A Codex id that names nothing is NotFound, one that exists is Unsupported.
+            return match self.log_for(id) {
+                Ok(_) => Err(ExternalError::Unsupported),
+                Err(error) => Err(error),
+            };
+        };
+        let (host, path) = self.log_for(id)?;
+        let claude_dir = self.config.claude_dir.as_deref().ok_or(ExternalError::NotFound)?;
+        let record = registered_sessions(claude_dir)
+            .into_iter()
+            .find(|record| record.session_id == session)
+            .ok_or(ExternalError::NotRunning)?;
+        let liveness = Liveness::of(&self.config);
+        if liveness.running(record.pid) != Some(true) {
+            return Err(ExternalError::NotRunning);
+        }
+
+        let (sender, receiver) = channel::<(u64, AgentEvent)>();
+        let stop = Arc::new(AtomicBool::new(false));
+        let thread_stop = Arc::clone(&stop);
+        let poll = self.config.poll_interval.max(Duration::from_millis(10));
+        let liveness_interval = self.config.liveness_interval;
+        let alive = self.config.alive.clone();
+        let pid = record.pid;
+        std::thread::Builder::new()
+            .name("rightkit-agents-external-tail".into())
+            .spawn(move || {
+                let mut tail = LogTail::new(host);
+                let mut last_check = Instant::now();
+                loop {
+                    let mut open = true;
+                    let polled = tail.poll_each(&path, |entry| {
+                        if entry.seq <= after_seq {
+                            return true;
+                        }
+                        if sender.send((entry.seq, entry.entry.event)).is_err() {
+                            open = false;
+                        }
+                        open
+                    });
+                    if polled.is_err() || !open {
+                        return;
+                    }
+                    if thread_stop.load(Ordering::Relaxed) {
+                        return;
+                    }
+                    if last_check.elapsed() >= liveness_interval {
+                        last_check = Instant::now();
+                        let running = match &alive {
+                            Some(check) => Some(check(pid)),
+                            None => process_snapshot().map(|pids| pids.contains(&pid)),
+                        };
+                        if running == Some(false) {
+                            // One last read for what the chat wrote on its way out.
+                            let _ = tail.poll_each(&path, |entry| {
+                                entry.seq <= after_seq
+                                    || sender.send((entry.seq, entry.entry.event)).is_ok()
+                            });
+                            return;
+                        }
+                    }
+                    // Sleep in short slices so a dropped Tail stops the thread promptly.
+                    let wake = Instant::now() + poll;
+                    while Instant::now() < wake {
+                        if thread_stop.load(Ordering::Relaxed) {
+                            return;
+                        }
+                        std::thread::sleep(Duration::from_millis(10).min(poll));
+                    }
+                }
+            })
+            .map_err(|error| ExternalError::Other(error.to_string()))?;
+        Ok(Tail { receiver, stop })
+    }
+
+    /// Hand `text` to the running chat `id`, waiting at most `deadline`. `NotRunning` when it
+    /// is not running, `Unsupported` when no [`Deliverer`] is installed or the session is a
+    /// Codex one.
+    pub fn deliver(
+        &self,
+        id: &str,
+        text: &str,
+        deadline: Duration,
+    ) -> Result<DeliveryReceipt, ExternalError> {
+        if text.is_empty() {
+            return Err(ExternalError::Other("nothing to deliver".to_string()));
+        }
+        let session = self
+            .list()
+            .into_iter()
+            .find(|session| session.id == id)
+            .ok_or(ExternalError::NotFound)?;
+        if id.starts_with("codex:") {
+            return Err(ExternalError::Unsupported);
+        }
+        if session.liveness != ExternalLiveness::Live {
+            return Err(ExternalError::NotRunning);
+        }
+        let deliverer = self
+            .config
+            .deliverer
+            .as_ref()
+            .ok_or(ExternalError::Unsupported)?;
+        if !deliverer.can_deliver(&session) {
+            return Ok(DeliveryReceipt {
+                state: DeliveryState::Refused,
+                msg_id: format!("rk-ext-{}", MESSAGE_IDS.fetch_add(1, Ordering::Relaxed)),
+                unproven: false,
+            });
+        }
+        deliverer.deliver(&session, text, deadline)
+    }
+}
+
+/// A live follow of one session's log. Dropping it stops the polling thread.
+#[derive(Debug)]
+pub struct Tail {
+    receiver: Receiver<(u64, AgentEvent)>,
+    stop: Arc<AtomicBool>,
+}
+
+impl Tail {
+    /// Block for the next `(seq, event)`; `Err` once the tail has ended.
+    pub fn recv(&self) -> Result<(u64, AgentEvent), RecvError> {
+        self.receiver.recv()
+    }
+
+    pub fn recv_timeout(&self, timeout: Duration) -> Result<(u64, AgentEvent), RecvTimeoutError> {
+        self.receiver.recv_timeout(timeout)
+    }
+
+    pub fn try_recv(&self) -> Result<(u64, AgentEvent), TryRecvError> {
+        self.receiver.try_recv()
+    }
+
+    /// The underlying receiver, for hosts that bridge it into their own runtime. The polling
+    /// thread stops when this [`Tail`] is dropped, not when the receiver is.
+    pub fn receiver(&self) -> &Receiver<(u64, AgentEvent)> {
+        &self.receiver
+    }
+
+    /// Iterate until the tail ends.
+    pub fn iter(&self) -> impl Iterator<Item = (u64, AgentEvent)> + '_ {
+        self.receiver.iter()
+    }
+}
+
+impl Drop for Tail {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+    }
+}
+
+/// `<claude dir>/projects/<project>/<session>.jsonl`, searched one project level deep.
+fn find_claude_log(claude_dir: &Path, session: &str) -> Option<PathBuf> {
+    let file = format!("{session}.jsonl");
+    let projects = std::fs::read_dir(claude_dir.join("projects")).ok()?;
+    let mut found: Vec<PathBuf> = projects
+        .flatten()
+        .map(|project| project.path().join(&file))
+        .filter(|path| path.is_file())
+        .collect();
+    // A session resumed from another project dir can leave a copy: the newest wins.
+    found.sort_by_key(|path| std::cmp::Reverse(modified_ms(path).unwrap_or(0)));
+    found.into_iter().next()
+}
+
+/// The id at the end of a Codex rollout file name, `rollout-<time>-<id>`: the last five
+/// dash-separated groups of a UUID.
+fn codex_id_from_file_stem(stem: &str) -> Option<String> {
+    let parts: Vec<&str> = stem.split('-').collect();
+    if parts.len() < 5 {
+        return None;
+    }
+    let id = parts[parts.len() - 5..].join("-");
+    (id.len() == 36).then_some(id)
+}
+
+/// A Codex rollout under `<codex dir>/sessions` whose name ends with the session id.
+fn find_codex_log(codex_dir: &Path, session: &str) -> Option<PathBuf> {
+    let suffix = format!("-{session}.jsonl");
+    logs::discover_in(None, Some(codex_dir))
+        .into_iter()
+        .map(|log| log.path)
+        .find(|path| {
+            path.file_name()
+                .and_then(|name| name.to_str())
+                .is_some_and(|name| name.ends_with(&suffix))
+        })
+}

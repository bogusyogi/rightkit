+/// `--mcp-config` and `--strict-mcp-config` are Claude Code argv flags the caller opts into
+/// with `ClaudeExtras`. They may be spelled in `claude.rs` only, each in one place that
+/// builds the argv, with no MCP dependency (checked above) and no MCP tool name.
+#[test]
+fn mcp_flags_are_only_argv_pass_through() {
+    let mut files = Vec::new();
+    rs_files(
+        &Path::new(env!("CARGO_MANIFEST_DIR")).join("src"),
+        &mut files,
+    );
+    for file in files {
+        let source = fs::read_to_string(&file).unwrap();
+        let name = file.file_name().unwrap().to_string_lossy().into_owned();
+        if name == "claude.rs" {
+            assert!(source.contains("\"--mcp-config\".to_string()"));
+            assert!(source.contains("args.push(\"--strict-mcp-config\".into())"));
+        } else {
+            assert!(
+                !source.contains("--mcp-config") && !source.contains("--strict-mcp-config"),
+                "{} spells an MCP flag",
+                file.display()
+            );
+        }
+    }

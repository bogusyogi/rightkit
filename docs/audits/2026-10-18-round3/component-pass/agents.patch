+//! Chats that were started outside the app: Claude Code and Codex sessions already running
+//! on this computer.
+//!
+//! The app never owns, creates, resumes or controls these sessions. [`ExternalSessions`] only
+//! lists them ([`ExternalSessions::list`]), reads their history from the on-disk log
+//! ([`ExternalSessions::history`]), follows a live one as its log grows
+//! ([`ExternalSessions::tail`]), and hands text to a live one through a host-installed
+//! [`Deliverer`] ([`ExternalSessions::deliver`]). The HTTP layer, if any, stays in the host.
+//!
+//! Sources:
+//!
+//! - Live Claude Code chats: the registry files Claude Code keeps in `<claude dir>/sessions`
+//!   (one `*.json` per running chat with `pid`, `sessionId`, `cwd`, `name`, `status`,
+//!   `updatedAt`, `entrypoint`), checked against the process table. The key names follow the
+//!   Pulse roster that reads them; they are unverified against a recorded registry here.
+//! - History: the logs of [`crate::logs`], for Claude Code and Codex alike.
+//!
+//! Ids are `claude:<session id>` and `codex:<session id>`, so they never collide with an
+//! app's own session ids. `seq` values are the log sequence numbers of [`crate::logs`]:
+//! contiguous, strictly increasing and stable per session.
+//!
+//! Codex keeps no registry of open chats, so a Codex session is listed from its log with
+//! [`ExternalLiveness::Unknown`], its history is readable, and `tail` and `deliver` answer
+//! [`ExternalError::Unsupported`].
+
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::mpsc::{channel, Receiver, RecvError, RecvTimeoutError, TryRecvError};
+use std::sync::Arc;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use serde_json::Value;
+
+use crate::event::AgentEvent;
+use crate::logs::{self, LogHost, LogTail};
+
+/// Busy, idle or waiting, as the chat reports itself.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ExternalStatus {
+    Busy,
+    Idle,
+    Waiting,
+}
+
+impl ExternalStatus {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            ExternalStatus::Busy => "busy",
+            ExternalStatus::Idle => "idle",
+            ExternalStatus::Waiting => "waiting",
+        }
+    }
+
+    fn from_registry(text: &str) -> Option<Self> {
+        match text {
+            "busy" => Some(ExternalStatus::Busy),
+            "idle" => Some(ExternalStatus::Idle),
+            "waiting" => Some(ExternalStatus::Waiting),
+            _ => None,
+        }
+    }
+}
+
+/// How sure the source is that the chat process is still running.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ExternalLiveness {
+    /// The registry names a process that is running now.
+    Live,
+    /// The chat has a log but its process is gone.
+    Stale,
+    /// There is no evidence either way (Codex, or a process table that cannot be read).
+    Unknown,
+}
+
+impl ExternalLiveness {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            ExternalLiveness::Live => "live",
+            ExternalLiveness::Stale => "stale",
+            ExternalLiveness::Unknown => "unknown",
+        }
+    }
+}
+
+/// One chat found outside the app.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ExternalSession {
+    /// `claude:<session id>` or `codex:<session id>`.
+    pub id: String,
+    pub title: String,
+    /// Workspace root of the chat.
+    pub cwd: String,
+    /// This computer's name, from [`ExternalConfig::host`].
+    pub host: String,
+    pub account: Option<String>,
+    pub status: Option<ExternalStatus>,
+    pub liveness: ExternalLiveness,
+    /// Whether [`ExternalSessions::deliver`] can reach this chat now.
+    pub input_available: bool,
+    /// RFC 3339 UTC timestamp of the chat's last activity.
+    pub updated_at: String,
+}
+
+/// What became of a delivered text.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DeliveryState {
+    Delivered,
+    Queued,
+    Sent,
+    Held,
+    Refused,
+    Unsupported,
+    Unknown,
+}
+
+impl DeliveryState {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            DeliveryState::Delivered => "delivered",
+            DeliveryState::Queued => "queued",
+            DeliveryState::Sent => "sent",
+            DeliveryState::Held => "held",
+            DeliveryState::Refused => "refused",
+            DeliveryState::Unsupported => "unsupported",
+            DeliveryState::Unknown => "unknown",
+        }
+    }
+}
+
+/// The result of [`ExternalSessions::deliver`].
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DeliveryReceipt {
+    pub state: DeliveryState,
+    pub msg_id: String,
+    /// True when the deliverer could not prove the state it reports.
+    pub unproven: bool,
+}
+
+/// Why an external-session call failed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ExternalError {
+    /// No session has this id.
+    NotFound,
+    /// The session is not running.
+    NotRunning,
+    /// This session kind or operation is not supported.
+    Unsupported,
+    Other(String),
+}
+
+impl std::fmt::Display for ExternalError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            ExternalError::NotFound => f.write_str("external session not found"),
+            ExternalError::NotRunning => f.write_str("external session is not running"),
+            ExternalError::Unsupported => f.write_str("not supported for this external session"),
+            ExternalError::Other(text) => write!(f, "external session: {text}"),
+        }
+    }
+}
+
+impl std::error::Error for ExternalError {}
+
+/// Hands text to a running external chat. This crate does not know how a given Claude Code
+/// build accepts outside input, so the host installs the transport (for example the chat's
+/// own messaging socket) here. It must wait no longer than `deadline`.
+pub trait Deliverer: Send + Sync {
+    /// Whether text can be delivered to `session` right now. Defaults to `true`.
+    fn can_deliver(&self, _session: &ExternalSession) -> bool {
+        true
+    }
+
+    /// Deliver `text` to `session`. The receipt says only what the deliverer can prove;
+    /// set [`DeliveryReceipt::unproven`] otherwise.
+    fn deliver(
+        &self,
+        session: &ExternalSession,
+        text: &str,
+        deadline: Duration,
+    ) -> Result<DeliveryReceipt, ExternalError>;
+}
+
+/// A check for whether a process id is running.
+pub type AliveCheck = Arc<dyn Fn(u32) -> bool + Send + Sync>;
+
+/// Where to look and how to judge liveness.
+#[derive(Clone)]
+pub struct ExternalConfig {
+    /// Claude Code's config directory (`sessions` and `projects` live under it).
+    pub claude_dir: Option<PathBuf>,
+    /// Codex's home directory (`sessions` lives under it).
+    pub codex_dir: Option<PathBuf>,
+    /// This computer's name, copied into every [`ExternalSession::host`].
+    pub host: String,
+    /// The signed-in account label, copied into every [`ExternalSession::account`].
+    pub account: Option<String>,
+    /// Whether a pid is running. `None` reads the process table once per call.
+    pub alive: Option<AliveCheck>,
+    /// Sessions without a running process are listed only when their log changed within this
+    /// long. `Duration::ZERO` lists running chats only.
+    pub stale_window: Duration,
+    /// Most sessions one [`ExternalSessions::list`] returns, newest first.
+    pub max_sessions: usize,
+    /// How often a tail looks for appended lines.
+    pub poll_interval: Duration,
+    /// How often a tail re-checks that the chat's process is still running.
+    pub liveness_interval: Duration,
+    /// The transport for [`ExternalSessions::deliver`]. `None` makes it `Unsupported`.
+    pub deliverer: Option<Arc<dyn Deliverer>>,
+}

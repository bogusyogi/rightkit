+/// Approved budgets: sealed per-project pools, grants, idempotent reports, append-only audit.
+/// Purely additive.
+const SCHEMA_V4: &str = "
+CREATE TABLE spend_approved_budgets (
+    seq INTEGER PRIMARY KEY AUTOINCREMENT,
+    project TEXT NOT NULL,
+    currency TEXT NOT NULL,
+    limit_micro INTEGER NOT NULL CHECK (limit_micro > 0),
+    spent_micro INTEGER NOT NULL DEFAULT 0 CHECK (spent_micro >= 0),
+    created_at INTEGER NOT NULL,
+    approved_at INTEGER,
+    approved_by TEXT
+);
+CREATE INDEX spend_approved_budgets_by_project ON spend_approved_budgets (project, created_at);
+CREATE TABLE spend_approved_seals (
+    budget_seq INTEGER PRIMARY KEY REFERENCES spend_approved_budgets (seq),
+    seal TEXT NOT NULL
+);
+CREATE TABLE spend_grants (
+    seq INTEGER PRIMARY KEY AUTOINCREMENT,
+    budget_seq INTEGER NOT NULL REFERENCES spend_approved_budgets (seq),
+    amount_micro INTEGER NOT NULL CHECK (amount_micro > 0),
+    spent_micro INTEGER NOT NULL DEFAULT 0 CHECK (spent_micro >= 0),
+    issued_at INTEGER NOT NULL,
+    expires_at INTEGER NOT NULL,
+    closed_at INTEGER
+);
+CREATE INDEX spend_grants_by_budget ON spend_grants (budget_seq, closed_at, expires_at);
+CREATE TABLE spend_grant_reports (
+    report_id TEXT PRIMARY KEY,
+    grant_seq INTEGER NOT NULL REFERENCES spend_grants (seq),
+    spent_micro INTEGER NOT NULL CHECK (spent_micro >= 0),
+    reported_at INTEGER NOT NULL,
+    is_final INTEGER NOT NULL CHECK (is_final IN (0, 1))
+);
+CREATE TABLE spend_approval_audit (
+    seq INTEGER PRIMARY KEY AUTOINCREMENT,
+    at INTEGER NOT NULL,
+    action TEXT NOT NULL,
+    who TEXT NOT NULL,
+    budget_seq INTEGER,
+    grant_seq INTEGER,
+    amount_micro INTEGER,
+    report_id TEXT,
+    note TEXT
+);
+CREATE TRIGGER spend_approval_audit_no_update BEFORE UPDATE ON spend_approval_audit

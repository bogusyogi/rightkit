+        assert_eq!(code(f.ledger.issue_grant("proj", Some(0), None, &f.key).unwrap_err()), "bad_amount");
+        assert_eq!(code(f.ledger.create_approved_budget("p r", "USD", 5).unwrap_err()), "bad_project");
+        assert_eq!(code(f.ledger.create_approved_budget("p", "US", 5).unwrap_err()), "bad_currency");
+        assert_eq!(code(f.ledger.create_approved_budget("p", "USD", 0).unwrap_err()), "bad_amount");
+    }
+
+    #[test]
+    fn expiry_releases_the_unspent_part() {
+        let mut f = fx();
+        let b = approved(&mut f, 1_000);
+        let g = f.ledger.issue_grant("proj", Some(700), Some(100), &f.key).unwrap();
+        f.ledger.report_grant(&g.id, 200, "r1", false).unwrap();
+        assert_eq!(f.ledger.approved_budget_status(&b.id).unwrap().available_micro, 300);
+        f.clock.store(1_100, Ordering::SeqCst);
+        // Already free by the arithmetic, before anything is stamped.
+        assert_eq!(f.ledger.approved_budget_status(&b.id).unwrap().available_micro, 800);
+        let expiry = f.ledger.expire_grants().unwrap();
+        assert_eq!(expiry.released_micro, 500);
+        assert_eq!(expiry.expired.len(), 1);
+        assert_eq!(expiry.expired[0].closed_at, Some(1_100));
+        assert!(f.ledger.expire_grants().unwrap().expired.is_empty());
+        // An expired grant still takes the report of money already spent.
+        let late = f.ledger.report_grant(&g.id, 50, "r2", false).unwrap();
+        assert_eq!(late.grant.spent_micro, 250);
+        assert_eq!(f.ledger.approved_budget_status(&b.id).unwrap().available_micro, 750);
+        let actions: Vec<String> = f
+            .ledger
+            .approval_audit(Some(&b.id), 50)
+            .unwrap()
+            .into_iter()
+            .map(|r| r.action)
+            .collect();
+        assert_eq!(actions, ["report", "expire", "report", "issue", "approve", "create"]);
+    }
+
+    #[test]
+    fn report_is_idempotent_and_conflicts_are_refused() {
+        let mut f = fx();
+        approved(&mut f, 1_000);
+        let g = f.ledger.issue_grant("proj", Some(500), None, &f.key).unwrap();

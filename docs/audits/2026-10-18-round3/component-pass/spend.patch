+        self.run_on(conn, |conn, ctx| {
+            issue_impl(conn, ctx, Source::Project(project), amount_micro, ttl_secs, key)
+        })
+    }
+
+    /// As [`Ledger::issue_grant`], from the one budget `budget_id` (a per-budget reserve).
+    pub fn issue_grant_from(
+        &mut self,
+        budget_id: &str,
+        amount_micro: Option<i64>,
+        ttl_secs: Option<i64>,

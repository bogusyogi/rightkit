+        assert_eq!(f.ledger.approved_budget_status(&b.id).unwrap().available_micro, 900);
+        let g2 = f.ledger.issue_grant("proj", Some(100), None, &f.key).unwrap();
+        let last = f.ledger.report_grant(&g2.id, 10, "r2", true).unwrap();
+        assert!(last.grant.closed_at.is_some());
+    }
+
+    #[test]
+    fn close_grant_releases_once() {
+        let mut f = fx();
+        let b = approved(&mut f, 1_000);
+        let g = f.ledger.issue_grant("proj", Some(600), None, &f.key).unwrap();
+        let closed = f.ledger.close_grant(&g.id, Some("tool exited")).unwrap();
+        assert_eq!(closed.closed_at, Some(1_000));
+        f.clock.store(1_500, Ordering::SeqCst);
+        assert_eq!(f.ledger.close_grant(&g.id, None).unwrap().closed_at, Some(1_000));
+        assert_eq!(f.ledger.approved_budget_status(&b.id).unwrap().available_micro, 1_000);
+        let closes = f
+            .ledger
+            .approval_audit(None, 50)
+            .unwrap()
+            .into_iter()
+            .filter(|r| r.action == "close")

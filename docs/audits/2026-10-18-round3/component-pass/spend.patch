+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicI64, Ordering};
+    use std::sync::Arc;
+
+    struct Fx {
+        ledger: Ledger,
+        clock: Arc<AtomicI64>,
+        key: SealKey,
+    }
+
+    fn fx() -> Fx {
+        let clock = Arc::new(AtomicI64::new(1_000));
+        let c = Arc::clone(&clock);
+        let ledger = Ledger::attach_with_clock(Connection::open_in_memory().unwrap(), move || {
+            c.load(Ordering::SeqCst)
+        })
+        .unwrap();
+        Fx {
+            ledger,
+            clock,
+            key: SealKey::new(b"0123456789abcdef0123456789abcdef").unwrap(),
+        }
+    }
+
+    fn approved(f: &mut Fx, limit: i64) -> ApprovedBudget {
+        let b = f.ledger.create_approved_budget("proj", "usd", limit).unwrap();
+        f.ledger
+            .approve_budget(&b.id, "owner", &b.approval_bind(), &f.key)
+            .unwrap()
+    }
+
+    fn code(err: SpendError) -> &'static str {
+        match err {
+            SpendError::ApprovedBudget { code, .. } => code,
+            other => panic!("not an approved-budget refusal: {other}"),
+        }
+    }
+
+    #[test]
+    fn seal_key_needs_material_and_never_prints() {
+        assert!(SealKey::new(b"short").is_err());
+        assert_eq!(format!("{:?}", fx().key), "SealKey(..)");
+    }
+
+    #[test]
+    fn unapproved_budget_issues_nothing() {
+        let mut f = fx();
+        let b = f.ledger.create_approved_budget("proj", "usd", 1_000).unwrap();
+        assert_eq!(b.currency, "USD");
+        assert!(!b.is_approved());
+        assert_eq!(code(f.ledger.issue_grant("proj", None, None, &f.key).unwrap_err()), "not_approved");
+        assert_eq!(code(f.ledger.issue_grant("nobody", None, None, &f.key).unwrap_err()), "no_budget");
+    }
+
+    #[test]
+    fn approval_is_bound_and_idempotent() {
+        let mut f = fx();
+        let b = f.ledger.create_approved_budget("proj", "USD", 1_000).unwrap();
+        let err = f
+            .ledger
+            .approve_budget(&b.id, "owner", "deadbeef", &f.key)
+            .unwrap_err();
+        assert_eq!(code(err), "budget_changed");
+        assert!(!f.ledger.approved_budget(&b.id).unwrap().is_approved());
+        let first = f
+            .ledger
+            .approve_budget(&b.id, "owner", &b.approval_bind(), &f.key)
+            .unwrap();
+        assert_eq!(first.approved_at, Some(1_000));
+        f.clock.store(2_000, Ordering::SeqCst);
+        let again = f
+            .ledger
+            .approve_budget(&b.id, "other", &b.approval_bind(), &f.key)
+            .unwrap();
+        assert_eq!(again.approved_at, Some(1_000));
+        let log = f.ledger.approval_audit(Some(&b.id), 10).unwrap();
+        assert_eq!(
+            log.iter().map(|r| r.action.as_str()).collect::<Vec<_>>(),
+            ["approve", "create"]
+        );
+        assert_eq!(log[0].who, "owner");
+        assert!(f.ledger.verify_budget_seal(&b.id, &f.key).unwrap());
+    }
+
+    #[test]
+    fn a_raised_limit_or_wrong_key_breaks_the_seal() {
+        let mut f = fx();
+        let b = approved(&mut f, 1_000);
+        f.ledger
+            .connection()
+            .execute("UPDATE spend_approved_budgets SET limit_micro = 9000", [])
+            .unwrap();
+        assert!(!f.ledger.verify_budget_seal(&b.id, &f.key).unwrap());
+        assert_eq!(code(f.ledger.issue_grant("proj", None, None, &f.key).unwrap_err()), "seal_invalid");
+
+        let mut g = fx();
+        let b = approved(&mut g, 1_000);
+        let other = SealKey::new(b"ffffffffffffffffffffffffffffffff").unwrap();
+        assert!(!g.ledger.verify_budget_seal(&b.id, &other).unwrap());
+        g.ledger
+            .connection()
+            .execute("DELETE FROM spend_approved_seals", [])
+            .unwrap();
+        assert_eq!(code(g.ledger.issue_grant_from(&b.id, None, None, &g.key).unwrap_err()), "seal_invalid");
+    }
+
+    #[test]
+    fn issuing_reserves_so_two_callers_cannot_share_money() {
+        let mut f = fx();
+        let b = approved(&mut f, 1_000);
+        let one = f.ledger.issue_grant("proj", Some(600), None, &f.key).unwrap();
+        assert_eq!(one.amount_micro, 600);
+        assert_eq!(one.expires_at, 1_000 + GRANT_TTL_DEFAULT_SECS);
+        assert_eq!(
+            code(f.ledger.issue_grant("proj", Some(500), None, &f.key).unwrap_err()),
+            "over_budget"
+        );
+        let rest = f.ledger.issue_grant("proj", None, Some(60), &f.key).unwrap();
+        assert_eq!(rest.amount_micro, 400);
+        assert_eq!(
+            code(f.ledger.issue_grant("proj", None, None, &f.key).unwrap_err()),
+            "exhausted"
+        );
+        let status = f.ledger.approved_budget_status(&b.id).unwrap();
+        assert_eq!((status.held_micro, status.available_micro), (1_000, 0));
+    }
+
+    #[test]
+    fn ttl_and_amount_are_checked() {
+        let mut f = fx();
+        approved(&mut f, 1_000);
+        assert_eq!(code(f.ledger.issue_grant("proj", Some(1), Some(0), &f.key).unwrap_err()), "bad_ttl");
+        assert_eq!(
+            code(f.ledger.issue_grant("proj", Some(1), Some(GRANT_TTL_MAX_SECS + 1), &f.key).unwrap_err()),
+            "bad_ttl"

+        assert_eq!(code(f.ledger.report_grant(&g.id, 1, "bad id", false).unwrap_err()), "bad_report_id");
+        assert_eq!(code(f.ledger.report_grant("grt-00000099", 1, "x", false).unwrap_err()), "unknown_grant");
+    }
+
+    #[test]
+    fn overrun_is_recorded_not_refused() {

+    /// [`Ledger::issue_grant_from`] inside the caller's transaction ([`Ledger::begin`]).
+    pub fn issue_grant_from_in(
+        &self,
+        tx: &Transaction<'_>,
+        budget_id: &str,
+        amount_micro: Option<i64>,
+        ttl_secs: Option<i64>,
+        key: &SealKey,
+    ) -> Result<Grant> {
+        self.run_in(tx, |conn, ctx| {
+            issue_impl(conn, ctx, Source::Budget(budget_id), amount_micro, ttl_secs, key)
+        })
+    }
+
+    /// [`Ledger::issue_grant_from`] on a connection with an open transaction.
+    pub fn issue_grant_from_on(
+        &self,
+        conn: &Connection,
+        budget_id: &str,
+        amount_micro: Option<i64>,
+        ttl_secs: Option<i64>,
+        key: &SealKey,

+
+    /// Record actual spend against a grant, once per `report_id` (a per-budget report). The
+    /// same id with the same grant and amount returns the first result with `duplicate` set;
+    /// the same id with another grant or amount is refused `report_conflict`. `final_report`
+    /// also closes the grant, which releases what it did not spend. Spend over the grant or the
+    /// budget is recorded and flagged [`GrantReport::overrun`], never refused: the money has
+    /// gone. A grant that already expired still takes the report.
+    pub fn report_grant(
+        &mut self,
+        grant_id: &str,
+        spent_micro: i64,
+        report_id: &str,
+        final_report: bool,
+    ) -> Result<GrantReport> {
+        self.run(|conn, ctx| report_impl(conn, ctx, grant_id, spent_micro, report_id, final_report))
+    }
+
+    /// [`Ledger::report_grant`] inside the caller's transaction ([`Ledger::begin`]).
+    pub fn report_grant_in(
+        &self,
+        tx: &Transaction<'_>,
+        grant_id: &str,
+        spent_micro: i64,
+        report_id: &str,
+        final_report: bool,
+    ) -> Result<GrantReport> {
+        self.run_in(tx, |conn, ctx| {
+            report_impl(conn, ctx, grant_id, spent_micro, report_id, final_report)
+        })
+    }
+
+    /// [`Ledger::report_grant`] on a connection with an open transaction.
+    pub fn report_grant_on(
+        &self,
+        conn: &Connection,
+        grant_id: &str,
+        spent_micro: i64,
+        report_id: &str,
+        final_report: bool,
+    ) -> Result<GrantReport> {
+        self.run_on(conn, |conn, ctx| {
+            report_impl(conn, ctx, grant_id, spent_micro, report_id, final_report)
+        })
+    }
+
+    /// Close a grant now, releasing its unspent part. Closing a closed grant changes nothing.
+    pub fn close_grant(&mut self, grant_id: &str, reason: Option<&str>) -> Result<Grant> {
+        self.run(|conn, ctx| close_impl(conn, ctx, grant_id, reason))
+    }
+
+    /// [`Ledger::close_grant`] inside the caller's transaction ([`Ledger::begin`]).
+    pub fn close_grant_in(
+        &self,
+        tx: &Transaction<'_>,
+        grant_id: &str,
+        reason: Option<&str>,
+    ) -> Result<Grant> {
+        self.run_in(tx, |conn, ctx| close_impl(conn, ctx, grant_id, reason))
+    }
+
+    /// [`Ledger::close_grant`] on a connection with an open transaction.
+    pub fn close_grant_on(
+        &self,
+        conn: &Connection,
+        grant_id: &str,
+        reason: Option<&str>,
+    ) -> Result<Grant> {
+        self.run_on(conn, |conn, ctx| close_impl(conn, ctx, grant_id, reason))
+    }
+
+    /// Release on expiry: stamp every open grant whose lease has run out as closed (at its own
+    /// expiry time) and audit it. Availability does not wait for this call: an expired grant
+    /// stops holding money the moment it expires. Run it from the app's tick or before showing
+    /// the audit.
+    pub fn expire_grants(&mut self) -> Result<GrantExpiry> {
+        self.run(expire_impl)
+    }
+
+    /// [`Ledger::expire_grants`] inside the caller's transaction ([`Ledger::begin`]).
+    pub fn expire_grants_in(&self, tx: &Transaction<'_>) -> Result<GrantExpiry> {
+        self.run_in(tx, expire_impl)
+    }
+
+    /// [`Ledger::expire_grants`] on a connection with an open transaction.
+    pub fn expire_grants_on(&self, conn: &Connection) -> Result<GrantExpiry> {
+        self.run_on(conn, expire_impl)
+    }
+
+    /// One approved budget by id (`bud-00000001`); `unknown_budget` when there is none.
+    pub fn approved_budget(&self, budget_id: &str) -> Result<ApprovedBudget> {
+        find_budget(&self.conn, budget_id)
+    }
+
+    /// Every budget, oldest first, optionally only those of one project.
+    pub fn approved_budgets(&self, project: Option<&str>) -> Result<Vec<ApprovedBudget>> {
+        let mut stmt = self.conn.prepare(&format!(
+            "SELECT {BUDGET_COLUMNS} FROM spend_approved_budgets \
+             WHERE (?1 IS NULL OR project = ?1) ORDER BY created_at, seq"
+        ))?;
+        let rows = stmt.query_map([project], budget_from_row)?;
+        Ok(rows.collect::<std::result::Result<Vec<_>, _>>()?)
+    }
+
+    /// A budget with what is held and still available at this moment.
+    pub fn approved_budget_status(&self, budget_id: &str) -> Result<BudgetStatus> {
+        let budget = find_budget(&self.conn, budget_id)?;
+        let held = held_micro(&self.conn, budget_seq_of(&budget), self.now())?;
+        Ok(BudgetStatus {
+            available_micro: available_micro(&budget, held),
+            held_micro: held,
+            budget,
+        })
+    }
+
+    /// Whether the budget is approved and its stored seal verifies under `key`.
+    pub fn verify_budget_seal(&self, budget_id: &str, key: &SealKey) -> Result<bool> {
+        let budget = find_budget(&self.conn, budget_id)?;
+        seal_holds(&self.conn, key, &budget)
+    }
+
+    /// One grant by id (`grt-00000001`); `unknown_grant` when there is none.
+    pub fn grant(&self, grant_id: &str) -> Result<Grant> {
+        find_grant_seq(&self.conn, grant_seq(grant_id)?)
+    }
+
+    /// Every grant of a budget, oldest first.
+    pub fn grants(&self, budget_id: &str) -> Result<Vec<Grant>> {
+        let budget = find_budget(&self.conn, budget_id)?;
+        let mut stmt = self.conn.prepare(&format!(
+            "SELECT {GRANT_COLUMNS} FROM spend_grants WHERE budget_seq = ?1 ORDER BY seq"
+        ))?;
+        let rows = stmt.query_map([budget_seq_of(&budget)], grant_from_row)?;
+        Ok(rows.collect::<std::result::Result<Vec<_>, _>>()?)
+    }
+
+    /// The newest `limit` (1 to 1000) audit rows, newest first, optionally for one budget.
+    pub fn approval_audit(
+        &self,
+        budget_id: Option<&str>,
+        limit: i64,
+    ) -> Result<Vec<ApprovalAudit>> {
+        let budget_seq = match budget_id {
+            Some(id) => Some(budget_seq_of(&find_budget(&self.conn, id)?)),
+            None => None,
+        };
+        let mut stmt = self.conn.prepare(
+            "SELECT seq, at, action, who, budget_seq, grant_seq, amount_micro, report_id, note \
+             FROM spend_approval_audit WHERE (?1 IS NULL OR budget_seq = ?1) \
+             ORDER BY seq DESC LIMIT ?2",
+        )?;
+        let rows = stmt.query_map(params![budget_seq, limit.clamp(1, 1000)], |row| {
+            let budget: Option<i64> = row.get(4)?;
+            let grant: Option<i64> = row.get(5)?;
+            Ok(ApprovalAudit {
+                seq: row.get(0)?,
+                at: row.get(1)?,
+                action: row.get(2)?,
+                who: row.get(3)?,
+                budget_id: budget.map(|s| id_of(BUDGET_PREFIX, s)),
+                grant_id: grant.map(|s| id_of(GRANT_PREFIX, s)),
+                amount_micro: row.get(6)?,
+                report_id: row.get(7)?,
+                note: row.get(8)?,
+            })
+        })?;
+        Ok(rows.collect::<std::result::Result<Vec<_>, _>>()?)
+    }
+}

--- /dev/null
+++ b/crates/rightkit-spend/src/approved.rs
@@ -0,0 +1,1415 @@
+//! Approved budgets: an owner-approved, sealed spend pool per project that hands out short
+//! leases ([`Grant`]) and takes back reports of what was actually spent (bogusyogi/rightkit#422,
+//! #530; the model of Pulse's `core/src/budget.rs`).
+//!
+//! This is a second, coarser tier beside the allowance and reservation ledger: a tool asks the
+//! owner of the money for a [`Grant`] (a per-budget reserve), spends within it, and reports the
+//! actual spend (a per-budget report). The ledger keeps the money state; the tool only holds a
+//! grant. Money is integer micro-units, as everywhere in this crate.
+//!
+//! Rules, each held in one write transaction:
+//!
+//! * A grant is only issued from an *approved* budget, and issuing it reserves its amount:
+//!   `available = limit - spent - (unspent part of every open, unexpired grant)`. Two callers
+//!   asking at once cannot be handed the same money.
+//! * Release on expiry: a grant whose `expires_at` has passed no longer holds its unspent part,
+//!   at once (the arithmetic compares with the clock), and [`Ledger::expire_grants`] stamps it
+//!   closed and writes the audit row. [`Ledger::close_grant`] and a final report release the
+//!   unspent part early.
+//! * A report is idempotent by report id: the same id with the same grant and amount returns the
+//!   first result and changes nothing; the same id with another grant or amount is refused
+//!   (`report_conflict`).
+//! * A report is never refused for being too large: the money is gone, so it is recorded and
+//!   flagged `overrun` ([`GrantReport::overrun`]).
+//! * Every change appends a row to an audit table that the database refuses to update or delete
+//!   from; the report table is append-only the same way.
+//! * Approval is bound and sealed. [`ApprovedBudget::approval_bind`] is the one value the owner
+//!   is shown and approves; [`Ledger::approve_budget`] refuses (`budget_changed`) when the stored
+//!   budget no longer matches the bind the owner approved. An approved budget carries an
+//!   HMAC-SHA256 seal over (id, project, limit, currency, approved_at) under a [`SealKey`] the
+//!   app keeps (an OS credential store, for example); issuing refuses (`seal_invalid`) a budget
+//!   whose seal is missing or does not verify, so an edit of the database that approves a budget
+//!   or raises its limit is detected. A process that can read the key can still forge a seal.
+//!
+//! Who counts as the owner is the app's decision: it gets the owner's answer (a click in its own
+//! UI, never a terminal) and only then calls [`Ledger::approve_budget`]. The crate cannot tell.
+//!
+//! Failures that a caller branches on are [`SpendError::ApprovedBudget`] with a stable `code`:
+//! `bad_project`, `bad_currency`, `bad_amount`, `bad_ttl`, `bad_report_id`, `unknown_budget`,
+//! `unknown_grant`, `no_budget`, `not_approved`, `seal_invalid`, `budget_changed`, `exhausted`,
+//! `over_budget`, `report_conflict`.
+
+use super::*;
+use rightkit_crypto::{ct_eq, hex_encode, hmac_sha256, sha256};
+
+/// Default lease of a grant, in seconds.
+pub const GRANT_TTL_DEFAULT_SECS: i64 = 3600;
+/// Longest lease of a grant, in seconds.
+pub const GRANT_TTL_MAX_SECS: i64 = 24 * 3600;
+/// The largest amount accepted for a limit, a grant or a report (1e9 units), so sums stay far
+/// inside `i64`.
+pub const APPROVED_MAX_MICRO: i64 = 1_000_000_000 * 1_000_000;
+
+const BUDGET_PREFIX: &str = "bud";
+const GRANT_PREFIX: &str = "grt";
+const SEAL_DOMAIN: &[u8] = b"rightkit.spend.approved-budget.seal.v1";
+const BIND_DOMAIN: &[u8] = b"rightkit.spend.approved-budget.approve.v1";
+
+/// The secret that seals approved budgets (at least 16 bytes). The app keeps it outside the
+/// database. `Debug` never prints it.
+#[derive(Clone)]
+pub struct SealKey(Vec<u8>);
+
+impl SealKey {
+    /// A key from at least 16 bytes of secret material.
+    pub fn new(secret: &[u8]) -> Result<Self> {
+        if secret.len() < 16 {
+            return Err(SpendError::BadInput(
+                "seal key must be at least 16 bytes".into(),
+            ));
+        }
+        Ok(Self(secret.to_vec()))
+    }
+}
+
+impl std::fmt::Debug for SealKey {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("SealKey(..)")
+    }
+}
+
+/// A budget the owner approves for a project.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct ApprovedBudget {
+    /// `bud-` plus an 8-digit count.
+    pub id: String,
+    pub project: String,
+    /// Three upper-case letters.
+    pub currency: String,
+    pub limit_micro: i64,
+    /// Reported spend, including overruns.
+    pub spent_micro: i64,
+    pub created_at: i64,
+    /// Set when the owner's approval was recorded and sealed.
+    pub approved_at: Option<i64>,
+}
+
+impl ApprovedBudget {
+    pub fn is_approved(&self) -> bool {
+        self.approved_at.is_some()
+    }
+
+    /// The one value an approval is bound to: a hash over the id, project, currency and limit.
+    /// Show the owner these facts, ask for the answer bound to this string, and pass it back to
+    /// [`Ledger::approve_budget`]; a budget changed in between no longer matches.
+    pub fn approval_bind(&self) -> String {
+        let mut message = BIND_DOMAIN.to_vec();
+        for field in [
+            self.id.as_bytes(),
+            self.project.as_bytes(),
+            self.currency.as_bytes(),
+            self.limit_micro.to_string().as_bytes(),
+        ] {
+            length_prefixed(&mut message, field);
+        }
+        hex_encode(&sha256(&message))
+    }
+}
+
+/// A budget with what is held against it at the moment of the call.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct BudgetStatus {
+    pub budget: ApprovedBudget,
+    /// Unspent part of every open, unexpired grant.
+    pub held_micro: i64,
+    /// `limit - spent - held`, never below zero: what can still be granted.
+    pub available_micro: i64,
+}
+
+/// A lease on part of an approved budget.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct Grant {
+    /// `grt-` plus an 8-digit count.
+    pub id: String,
+    pub budget_id: String,
+    pub amount_micro: i64,
+    /// Sum of the reports recorded against the grant.
+    pub spent_micro: i64,
+    pub issued_at: i64,
+    pub expires_at: i64,
+    /// Set when the grant was closed (final report, [`Ledger::close_grant`]) or expired
+    /// ([`Ledger::expire_grants`]).
+    pub closed_at: Option<i64>,
+}
+
+impl Grant {
+    /// `amount - spent`, never below zero.
+    pub fn remaining_micro(&self) -> i64 {
+        self.amount_micro.saturating_sub(self.spent_micro).max(0)
+    }
+
+    /// Open and not yet expired at `now`: the grant still holds its unspent part.
+    pub fn holds_at(&self, now: i64) -> bool {
+        self.closed_at.is_none() && self.expires_at > now
+    }
+}
+
+/// The result of [`Ledger::report_grant`].
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct GrantReport {
+    pub report_id: String,
+    /// The report id was already recorded with the same grant and amount; nothing was added.
+    pub duplicate: bool,
+    pub grant: Grant,
+    pub budget: ApprovedBudget,
+    /// The grant's spend exceeds its amount or the budget's spend exceeds its limit. Recorded,
+    /// never refused.
+    pub overrun: bool,
+}
+
+/// What [`Ledger::expire_grants`] did.
+#[derive(Clone, Debug, PartialEq, Eq, Default)]
+#[non_exhaustive]
+pub struct GrantExpiry {
+    /// Grants stamped closed at their `expires_at`.
+    pub expired: Vec<Grant>,
+    /// Their unspent amounts, now free again.
+    pub released_micro: i64,
+}
+
+/// One row of the append-only audit of approved budgets.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct ApprovalAudit {
+    pub seq: i64,
+    /// Unix seconds.
+    pub at: i64,
+    /// `create`, `approve`, `issue`, `report`, `close` or `expire`.
+    pub action: String,
+    /// The approver for `approve`, else the ledger's actor ([`Ledger::with_actor`]).
+    pub who: String,
+    pub budget_id: Option<String>,
+    pub grant_id: Option<String>,
+    pub amount_micro: Option<i64>,
+    pub report_id: Option<String>,
+    pub note: Option<String>,
+}
+
+fn refuse(code: &'static str, message: impl Into<String>) -> SpendError {
+    SpendError::ApprovedBudget {
+        code,
+        message: message.into(),
+    }
+}
+
+fn length_prefixed(out: &mut Vec<u8>, field: &[u8]) {
+    out.extend_from_slice(&(field.len() as u64).to_be_bytes());
+    out.extend_from_slice(field);
+}
+
+fn id_of(prefix: &str, seq: i64) -> String {
+    format!("{prefix}-{seq:08}")
+}
+
+fn seq_from(prefix: &str, id: &str) -> Option<i64> {
+    id.strip_prefix(prefix)
+        .and_then(|rest| rest.strip_prefix('-'))
+        .filter(|n| !n.is_empty() && n.bytes().all(|b| b.is_ascii_digit()))
+        .and_then(|n| n.parse::<i64>().ok())
+}
+
+fn valid_project(project: &str) -> Result<()> {
+    let ok = !project.is_empty()
+        && project.len() <= 64
+        && project
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-'));
+    if ok {
+        Ok(())
+    } else {
+        Err(refuse(
+            "bad_project",
+            "a project id is 1 to 64 letters, digits, '.', '_' or '-'",
+        ))
+    }
+}
+
+fn valid_currency(currency: &str) -> Result<String> {
+    if currency.len() == 3 && currency.bytes().all(|b| b.is_ascii_alphabetic()) {
+        Ok(currency.to_ascii_uppercase())
+    } else {
+        Err(refuse(
+            "bad_currency",
+            "a currency is a 3-letter code such as USD",
+        ))
+    }
+}
+
+fn valid_report_id(id: &str) -> Result<()> {
+    if !id.is_empty() && id.len() <= 128 && id.bytes().all(|b| b.is_ascii_graphic()) {
+        Ok(())
+    } else {
+        Err(refuse(
+            "bad_report_id",
+            "a report id is 1 to 128 visible characters without spaces",
+        ))
+    }
+}
+
+fn valid_amount(what: &str, micro: i64, allow_zero: bool) -> Result<i64> {
+    if micro > APPROVED_MAX_MICRO || micro < 0 || (micro == 0 && !allow_zero) {
+        return Err(refuse(
+            "bad_amount",
+            format!("{what} must be {} to {APPROVED_MAX_MICRO} micro-units", u8::from(!allow_zero)),
+        ));
+    }
+    Ok(micro)
+}
+
+const BUDGET_COLUMNS: &str =
+    "seq, project, currency, limit_micro, spent_micro, created_at, approved_at";
+const GRANT_COLUMNS: &str =
+    "seq, budget_seq, amount_micro, spent_micro, issued_at, expires_at, closed_at";
+
+fn budget_from_row(row: &Row<'_>) -> rusqlite::Result<ApprovedBudget> {
+    let seq: i64 = row.get(0)?;
+    Ok(ApprovedBudget {
+        id: id_of(BUDGET_PREFIX, seq),
+        project: row.get(1)?,
+        currency: row.get(2)?,
+        limit_micro: row.get(3)?,
+        spent_micro: row.get(4)?,
+        created_at: row.get(5)?,
+        approved_at: row.get(6)?,
+    })
+}
+
+fn grant_from_row(row: &Row<'_>) -> rusqlite::Result<Grant> {
+    let seq: i64 = row.get(0)?;
+    let budget_seq: i64 = row.get(1)?;
+    Ok(Grant {
+        id: id_of(GRANT_PREFIX, seq),
+        budget_id: id_of(BUDGET_PREFIX, budget_seq),
+        amount_micro: row.get(2)?,
+        spent_micro: row.get(3)?,
+        issued_at: row.get(4)?,
+        expires_at: row.get(5)?,
+        closed_at: row.get(6)?,
+    })
+}
+
+fn find_budget_seq(conn: &Connection, seq: i64) -> Result<ApprovedBudget> {
+    conn.query_row(
+        &format!("SELECT {BUDGET_COLUMNS} FROM spend_approved_budgets WHERE seq = ?1"),
+        [seq],
+        budget_from_row,
+    )
+    .optional()?
+    .ok_or_else(|| refuse("unknown_budget", format!("no budget {}", id_of(BUDGET_PREFIX, seq))))
+}
+
+fn find_budget(conn: &Connection, id: &str) -> Result<ApprovedBudget> {
+    let seq = seq_from(BUDGET_PREFIX, id)
+        .ok_or_else(|| refuse("unknown_budget", format!("no budget {id}")))?;
+    find_budget_seq(conn, seq)
+}
+
+fn find_grant_seq(conn: &Connection, seq: i64) -> Result<Grant> {
+    conn.query_row(
+        &format!("SELECT {GRANT_COLUMNS} FROM spend_grants WHERE seq = ?1"),
+        [seq],
+        grant_from_row,
+    )
+    .optional()?
+    .ok_or_else(|| refuse("unknown_grant", format!("no grant {}", id_of(GRANT_PREFIX, seq))))
+}
+
+fn grant_seq(id: &str) -> Result<i64> {
+    seq_from(GRANT_PREFIX, id).ok_or_else(|| refuse("unknown_grant", format!("no grant {id}")))
+}
+
+fn budget_seq_of(budget: &ApprovedBudget) -> i64 {
+    seq_from(BUDGET_PREFIX, &budget.id).unwrap_or(0)
+}
+
+/// The unspent part of every open, unexpired grant of a budget.
+fn held_micro(conn: &Connection, budget_seq: i64, at: i64) -> Result<i64> {
+    Ok(conn.query_row(
+        "SELECT COALESCE(SUM(MAX(amount_micro - spent_micro, 0)), 0) FROM spend_grants \
+         WHERE budget_seq = ?1 AND closed_at IS NULL AND expires_at > ?2",
+        params![budget_seq, at],
+        |row| row.get(0),
+    )?)
+}
+
+fn available_micro(budget: &ApprovedBudget, held: i64) -> i64 {
+    budget
+        .limit_micro
+        .saturating_sub(budget.spent_micro)
+        .saturating_sub(held)
+        .max(0)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn audit_row(
+    conn: &Connection,
+    at: i64,
+    action: &str,
+    who: &str,
+    budget_seq: Option<i64>,
+    grant_seq: Option<i64>,
+    amount_micro: Option<i64>,
+    report_id: Option<&str>,
+    note: Option<&str>,
+) -> Result<()> {
+    conn.execute(
+        "INSERT INTO spend_approval_audit (at, action, who, budget_seq, grant_seq, amount_micro, \
+         report_id, note) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)",
+        params![at, action, who, budget_seq, grant_seq, amount_micro, report_id, note],
+    )?;
+    Ok(())
+}
+
+fn seal_message(budget: &ApprovedBudget, approved_at: i64) -> Vec<u8> {
+    let mut message = SEAL_DOMAIN.to_vec();
+    for field in [
+        budget.id.as_bytes(),
+        budget.project.as_bytes(),
+        budget.limit_micro.to_string().as_bytes(),
+        budget.currency.as_bytes(),
+        approved_at.to_string().as_bytes(),
+    ] {
+        length_prefixed(&mut message, field);
+    }
+    message
+}
+
+fn seal_tag(key: &SealKey, budget: &ApprovedBudget, approved_at: i64) -> [u8; 32] {
+    hmac_sha256(&key.0, &seal_message(budget, approved_at))
+}
+
+fn unhex(text: &str) -> Option<Vec<u8>> {
+    if !text.len().is_multiple_of(2) || !text.is_ascii() {
+        return None;
+    }
+    (0..text.len() / 2)
+        .map(|i| u8::from_str_radix(&text[2 * i..2 * i + 2], 16).ok())
+        .collect()
+}
+
+/// Whether the approved budget's stored seal verifies under `key` (constant-time compare).
+fn seal_holds(conn: &Connection, key: &SealKey, budget: &ApprovedBudget) -> Result<bool> {
+    let Some(approved_at) = budget.approved_at else {
+        return Ok(false);
+    };
+    let stored: Option<String> = conn
+        .query_row(
+            "SELECT seal FROM spend_approved_seals WHERE budget_seq = ?1",
+            [budget_seq_of(budget)],
+            |row| row.get(0),
+        )
+        .optional()?;
+    let Some(tag) = stored.as_deref().and_then(unhex) else {
+        return Ok(false);
+    };
+    Ok(ct_eq(&seal_tag(key, budget, approved_at), &tag))
+}
+
+fn create_impl(
+    conn: &Connection,
+    ctx: &Ctx,
+    project: &str,
+    currency: &str,
+    limit_micro: i64,
+) -> Result<ApprovedBudget> {
+    valid_project(project)?;
+    let currency = valid_currency(currency)?;
+    valid_amount("a budget limit", limit_micro, false)?;
+    conn.execute(
+        "INSERT INTO spend_approved_budgets (project, currency, limit_micro, created_at) \
+         VALUES (?1, ?2, ?3, ?4)",
+        params![project, currency, limit_micro, ctx.now],
+    )?;
+    let seq = conn.last_insert_rowid();
+    audit_row(
+        conn,
+        ctx.now,
+        "create",
+        &ctx.actor,
+        Some(seq),
+        None,
+        Some(limit_micro),
+        None,
+        Some(&format!("project={project} currency={currency}")),
+    )?;
+    find_budget_seq(conn, seq)
+}
+
+fn approve_impl(
+    conn: &Connection,
+    ctx: &Ctx,
+    budget_id: &str,
+    approver: &str,
+    expected_bind: &str,
+    key: &SealKey,
+) -> Result<ApprovedBudget> {
+    non_empty("approver", approver)?;
+    let budget = find_budget(conn, budget_id)?;
+    if budget.approved_at.is_none() {
+        if !ct_eq(budget.approval_bind().as_bytes(), expected_bind.as_bytes()) {
+            return Err(refuse(
+                "budget_changed",
+                "the budget is not the one the owner approved; nothing was approved",
+            ));
+        }
+        let seq = budget_seq_of(&budget);
+        let changed = conn.execute(
+            "UPDATE spend_approved_budgets SET approved_at = ?2, approved_by = ?3 \
+             WHERE seq = ?1 AND approved_at IS NULL",
+            params![seq, ctx.now, approver],
+        )?;
+        if changed == 1 {
+            conn.execute(
+                "INSERT OR REPLACE INTO spend_approved_seals (budget_seq, seal) VALUES (?1, ?2)",
+                params![seq, hex_encode(&seal_tag(key, &budget, ctx.now))],
+            )?;
+            audit_row(
+                conn,
+                ctx.now,
+                "approve",
+                approver,
+                Some(seq),
+                None,
+                Some(budget.limit_micro),
+                None,
+                None,
+            )?;
+        }
+    }
+    find_budget(conn, budget_id)
+}
+
+/// Where a grant may come from.
+enum Source<'a> {
+    /// The first approved, sealed budget of the project that can cover the amount.
+    Project(&'a str),
+    /// One named budget.
+    Budget(&'a str),
+}
+
+fn issue_impl(
+    conn: &Connection,
+    ctx: &Ctx,
+    source: Source<'_>,
+    amount_micro: Option<i64>,
+    ttl_secs: Option<i64>,
+    key: &SealKey,
+) -> Result<Grant> {
+    let wanted = amount_micro
+        .map(|a| valid_amount("a grant amount", a, false))
+        .transpose()?;
+    let ttl = ttl_secs.unwrap_or(GRANT_TTL_DEFAULT_SECS);
+    if !(1..=GRANT_TTL_MAX_SECS).contains(&ttl) {
+        return Err(refuse(
+            "bad_ttl",
+            format!("a grant lasts 1 to {GRANT_TTL_MAX_SECS} seconds"),
+        ));
+    }
+    let (label, budgets): (String, Vec<ApprovedBudget>) = match source {
+        Source::Project(project) => {
+            valid_project(project)?;
+            let mut stmt = conn.prepare(&format!(
+                "SELECT {BUDGET_COLUMNS} FROM spend_approved_budgets WHERE project = ?1 \
+                 ORDER BY created_at, seq"
+            ))?;
+            let rows = stmt
+                .query_map([project], budget_from_row)?
+                .collect::<std::result::Result<Vec<_>, _>>()?;
+            if rows.is_empty() {
+                return Err(refuse(
+                    "no_budget",
+                    format!("project {project} has no budget; create one"),
+                ));
+            }
+            (format!("project {project}"), rows)
+        }
+        Source::Budget(id) => (format!("budget {id}"), vec![find_budget(conn, id)?]),
+    };
+    let approved: Vec<&ApprovedBudget> = budgets.iter().filter(|b| b.is_approved()).collect();
+    if approved.is_empty() {
+        return Err(refuse(
+            "not_approved",
+            format!("{label} has no approved budget; the owner must approve one"),
+        ));
+    }
+    // A budget whose seal is missing or wrong was approved or changed outside the ledger: it
+    // never issues.
+    let mut sealed: Vec<&ApprovedBudget> = Vec::new();
+    let mut broken: Vec<&str> = Vec::new();
+    for budget in approved {
+        if seal_holds(conn, key, budget)? {
+            sealed.push(budget);
+        } else {
+            broken.push(&budget.id);
+        }
+    }
+    if sealed.is_empty() {
+        return Err(refuse(
+            "seal_invalid",
+            format!(
+                "budget {} failed its seal: the database was changed outside the ledger, so \
+                 nothing is issued; create and approve a new budget",
+                broken.join(", ")
+            ),
+        ));
+    }
+    let mut chosen: Option<(&ApprovedBudget, i64)> = None;
+    let mut most = 0;
+    for budget in sealed {
+        let free = available_micro(budget, held_micro(conn, budget_seq_of(budget), ctx.now)?);
+        most = most.max(free);
+        let fits = match wanted {
+            Some(w) => free >= w,
+            None => free > 0,
+        };
+        if fits {
+            chosen = Some((budget, wanted.unwrap_or(free)));
+            break;
+        }
+    }
+    let Some((budget, granted)) = chosen else {
+        return Err(if most == 0 {
+            refuse("exhausted", format!("{label} has no allowance left to issue"))
+        } else {
+            refuse(
+                "over_budget",
+                format!("{label} has only {most} micro-units available"),
+            )
+        });
+    };
+    let expires = ctx.now.saturating_add(ttl);
+    let budget_seq = budget_seq_of(budget);
+    conn.execute(
+        "INSERT INTO spend_grants (budget_seq, amount_micro, issued_at, expires_at) \
+         VALUES (?1, ?2, ?3, ?4)",
+        params![budget_seq, granted, ctx.now, expires],
+    )?;
+    let seq = conn.last_insert_rowid();
+    audit_row(
+        conn,
+        ctx.now,
+        "issue",
+        &ctx.actor,
+        Some(budget_seq),
+        Some(seq),
+        Some(granted),
+        None,
+        Some(&format!("expires_at={expires}")),
+    )?;
+    find_grant_seq(conn, seq)
+}
+
+fn close_row(conn: &Connection, seq: i64, at: i64) -> Result<bool> {
+    Ok(conn.execute(
+        "UPDATE spend_grants SET closed_at = ?2 WHERE seq = ?1 AND closed_at IS NULL",
+        params![seq, at],
+    )? == 1)
+}
+
+fn report_impl(
+    conn: &Connection,
+    ctx: &Ctx,
+    grant_id: &str,
+    spent_micro: i64,
+    report_id: &str,
+    final_report: bool,
+) -> Result<GrantReport> {
+    valid_amount("a reported spend", spent_micro, true)?;
+    valid_report_id(report_id)?;
+    let seq = grant_seq(grant_id)?;
+    let previous: Option<(i64, i64)> = conn
+        .query_row(
+            "SELECT grant_seq, spent_micro FROM spend_grant_reports WHERE report_id = ?1",
+            [report_id],
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .optional()?;
+    let duplicate = match previous {
+        Some((prior_grant, prior_spent)) => {
+            if prior_grant != seq || prior_spent != spent_micro {
+                return Err(refuse(
+                    "report_conflict",
+                    format!(
+                        "report {report_id} was already recorded for grant {} with spend {prior_spent}",
+                        id_of(GRANT_PREFIX, prior_grant)
+                    ),
+                ));
+            }
+            true
+        }
+        None => false,
+    };
+    let grant = find_grant_seq(conn, seq)?;
+    let budget_seq = seq_from(BUDGET_PREFIX, &grant.budget_id).unwrap_or(0);
+    let budget = find_budget_seq(conn, budget_seq)?;
+    if !duplicate {
+        let new_grant_spent = grant
+            .spent_micro
+            .checked_add(spent_micro)
+            .ok_or(SpendError::Overflow)?;
+        let new_budget_spent = budget
+            .spent_micro
+            .checked_add(spent_micro)
+            .ok_or(SpendError::Overflow)?;
+        conn.execute(
+            "INSERT INTO spend_grant_reports (report_id, grant_seq, spent_micro, reported_at, \
+             is_final) VALUES (?1, ?2, ?3, ?4, ?5)",
+            params![report_id, seq, spent_micro, ctx.now, i64::from(final_report)],
+        )?;
+        conn.execute(
+            "UPDATE spend_grants SET spent_micro = ?2 WHERE seq = ?1",
+            params![seq, new_grant_spent],
+        )?;
+        conn.execute(
+            "UPDATE spend_approved_budgets SET spent_micro = ?2 WHERE seq = ?1",
+            params![budget_seq, new_budget_spent],
+        )?;
+        if final_report {
+            close_row(conn, seq, ctx.now)?;
+        }
+        let overrun = new_grant_spent > grant.amount_micro || new_budget_spent > budget.limit_micro;
+        audit_row(
+            conn,
+            ctx.now,
+            "report",
+            &ctx.actor,
+            Some(budget_seq),
+            Some(seq),
+            Some(spent_micro),
+            Some(report_id),
+            Some(&format!(
+                "grant_spent={new_grant_spent} budget_spent={new_budget_spent} final={final_report} overrun={overrun}"
+            )),
+        )?;
+    } else if final_report && grant.closed_at.is_none() {
+        // A repeat of a report recorded without `final_report` still closes the grant when this
+        // one asks for it: spend is not counted twice, the release is.
+        close_row(conn, seq, ctx.now)?;
+        audit_row(
+            conn,
+            ctx.now,
+            "close",
+            &ctx.actor,
+            Some(budget_seq),
+            Some(seq),
+            None,
+            Some(report_id),
+            Some("duplicate final report"),
+        )?;
+    }
+    let grant = find_grant_seq(conn, seq)?;
+    let budget = find_budget_seq(conn, budget_seq)?;
+    let overrun = grant.spent_micro > grant.amount_micro || budget.spent_micro > budget.limit_micro;
+    Ok(GrantReport {
+        report_id: report_id.to_owned(),
+        duplicate,
+        grant,
+        budget,
+        overrun,
+    })
+}
+
+fn close_impl(conn: &Connection, ctx: &Ctx, grant_id: &str, reason: Option<&str>) -> Result<Grant> {
+    let seq = grant_seq(grant_id)?;
+    let grant = find_grant_seq(conn, seq)?;
+    if grant.closed_at.is_none() && close_row(conn, seq, ctx.now)? {
+        audit_row(
+            conn,
+            ctx.now,
+            "close",
+            &ctx.actor,
+            seq_from(BUDGET_PREFIX, &grant.budget_id),
+            Some(seq),
+            Some(grant.remaining_micro()),
+            None,
+            reason,
+        )?;
+    }
+    find_grant_seq(conn, seq)
+}
+
+fn expire_impl(conn: &Connection, ctx: &Ctx) -> Result<GrantExpiry> {
+    let due: Vec<Grant> = {
+        let mut stmt = conn.prepare(&format!(
+            "SELECT {GRANT_COLUMNS} FROM spend_grants WHERE closed_at IS NULL AND expires_at <= ?1 \
+             ORDER BY seq"
+        ))?;
+        let rows = stmt
+            .query_map([ctx.now], grant_from_row)?
+            .collect::<std::result::Result<Vec<_>, _>>()?;
+        rows
+    };
+    let mut out = GrantExpiry::default();
+    for grant in due {
+        let seq = grant_seq(&grant.id)?;
+        // Stamped at its own expiry, not now: that is when it stopped holding money.
+        if close_row(conn, seq, grant.expires_at)? {
+            let released = grant.remaining_micro();
+            audit_row(
+                conn,
+                ctx.now,
+                "expire",
+                &ctx.actor,
+                seq_from(BUDGET_PREFIX, &grant.budget_id),
+                Some(seq),
+                Some(released),
+                None,
+                None,
+            )?;
+            out.released_micro = out
+                .released_micro
+                .checked_add(released)
+                .ok_or(SpendError::Overflow)?;
+            out.expired.push(find_grant_seq(conn, seq)?);
+        }
+    }
+    Ok(out)
+}
+
+impl Ledger {
+    /// A new budget for `project`, not yet approved: nothing can be issued from it. `currency`
+    /// is a 3-letter code (stored upper-case); `limit_micro` is above zero and at most
+    /// [`APPROVED_MAX_MICRO`].
+    pub fn create_approved_budget(
+        &mut self,
+        project: &str,
+        currency: &str,
+        limit_micro: i64,
+    ) -> Result<ApprovedBudget> {
+        self.run(|conn, ctx| create_impl(conn, ctx, project, currency, limit_micro))
+    }
+
+    /// [`Ledger::create_approved_budget`] inside the caller's transaction ([`Ledger::begin`]).
+    pub fn create_approved_budget_in(
+        &self,
+        tx: &Transaction<'_>,
+        project: &str,
+        currency: &str,
+        limit_micro: i64,
+    ) -> Result<ApprovedBudget> {
+        self.run_in(tx, |conn, ctx| {
+            create_impl(conn, ctx, project, currency, limit_micro)
+        })
+    }
+
+    /// [`Ledger::create_approved_budget`] on a connection with an open transaction.
+    pub fn create_approved_budget_on(
+        &self,
+        conn: &Connection,
+        project: &str,
+        currency: &str,
+        limit_micro: i64,
+    ) -> Result<ApprovedBudget> {
+        self.run_on(conn, |conn, ctx| {
+            create_impl(conn, ctx, project, currency, limit_micro)
+        })
+    }
+
+    /// Record the owner's approval of a budget and seal it. Call it only once the owner has
+    /// answered an approval bound to `expected_bind` ([`ApprovedBudget::approval_bind`]); a
+    /// budget that no longer matches is refused `budget_changed` and nothing is approved.
+    /// `approver` is recorded in the audit. Approving an approved budget changes and records
+    /// nothing.
+    pub fn approve_budget(
+        &mut self,
+        budget_id: &str,
+        approver: &str,
+        expected_bind: &str,
+        key: &SealKey,
+    ) -> Result<ApprovedBudget> {
+        self.run(|conn, ctx| approve_impl(conn, ctx, budget_id, approver, expected_bind, key))
+    }
+
+    /// [`Ledger::approve_budget`] inside the caller's transaction ([`Ledger::begin`]).
+    pub fn approve_budget_in(
+        &self,
+        tx: &Transaction<'_>,
+        budget_id: &str,
+        approver: &str,
+        expected_bind: &str,
+        key: &SealKey,
+    ) -> Result<ApprovedBudget> {
+        self.run_in(tx, |conn, ctx| {
+            approve_impl(conn, ctx, budget_id, approver, expected_bind, key)
+        })
+    }
+
+    /// [`Ledger::approve_budget`] on a connection with an open transaction.
+    pub fn approve_budget_on(
+        &self,
+        conn: &Connection,
+        budget_id: &str,
+        approver: &str,
+        expected_bind: &str,
+        key: &SealKey,
+    ) -> Result<ApprovedBudget> {
+        self.run_on(conn, |conn, ctx| {
+            approve_impl(conn, ctx, budget_id, approver, expected_bind, key)
+        })
+    }
+
+    /// Issue a grant for `project` from its first approved, sealed budget that can cover it, and
+    /// reserve the amount. `amount_micro` of `None` asks for everything available in that
+    /// budget. `ttl_secs` (default [`GRANT_TTL_DEFAULT_SECS`], at most [`GRANT_TTL_MAX_SECS`])
+    /// is how long the grant holds its unspent part. Refusals: `no_budget`, `not_approved`,
+    /// `seal_invalid`, `exhausted`, `over_budget`.
+    pub fn issue_grant(
+        &mut self,
+        project: &str,
+        amount_micro: Option<i64>,
+        ttl_secs: Option<i64>,
+        key: &SealKey,
+    ) -> Result<Grant> {
+        self.run(|conn, ctx| {
+            issue_impl(conn, ctx, Source::Project(project), amount_micro, ttl_secs, key)
+        })
+    }
+
+    /// [`Ledger::issue_grant`] inside the caller's transaction ([`Ledger::begin`]).
+    pub fn issue_grant_in(
+        &self,
+        tx: &Transaction<'_>,
+        project: &str,
+        amount_micro: Option<i64>,
+        ttl_secs: Option<i64>,
+        key: &SealKey,
+    ) -> Result<Grant> {
+        self.run_in(tx, |conn, ctx| {
+            issue_impl(conn, ctx, Source::Project(project), amount_micro, ttl_secs, key)
+        })
+    }
+
+    /// [`Ledger::issue_grant`] on a connection with an open transaction.
+    pub fn issue_grant_on(
+        &self,
+        conn: &Connection,
+        project: &str,
+        amount_micro: Option<i64>,
+        ttl_secs: Option<i64>,
+        key: &SealKey,

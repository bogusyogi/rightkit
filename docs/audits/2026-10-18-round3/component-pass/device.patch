+/// A [`SecureStore`] over one account of a [`rightkit_credentials::Store`] (OS keychain,
+/// Credential Manager, Secret Service or Android Keystore). Secrets are never written to files.
+///
+/// [`CredentialStore::strings`] stores the value as-is (a device id); [`CredentialStore::with_codec`]
+/// stores any `T` through the caller's text encoding (for example a license record as JSON).
+/// `set_if_absent` uses the store's native create-only write, so device-id creation stays atomic
+/// across processes. An empty encoded value is refused (delete instead).
+#[cfg(feature = "credentials")]
+pub struct CredentialStore<T> {
+    store: rightkit_credentials::Store,
+    account: String,
+    encode: fn(&T) -> Result<String, String>,
+    decode: fn(&str) -> Result<T, String>,
+}
+
+#[cfg(feature = "credentials")]
+impl CredentialStore<String> {
+    /// Stores the string itself under `account`.
+    pub fn strings(store: rightkit_credentials::Store, account: impl Into<String>) -> Self {
+        Self::with_codec(store, account, |v| Ok(v.clone()), |s| Ok(s.to_owned()))
+    }
+}
+
+#[cfg(feature = "credentials")]
+impl<T> CredentialStore<T> {
+    /// Stores `T` under `account` as the text produced by `encode`; `decode` must invert it.
+    pub fn with_codec(
+        store: rightkit_credentials::Store,
+        account: impl Into<String>,
+        encode: fn(&T) -> Result<String, String>,
+        decode: fn(&str) -> Result<T, String>,
+    ) -> Self {
+        Self {
+            store,
+            account: account.into(),
+            encode,
+            decode,
+        }
+    }
+}
+
+#[cfg(feature = "credentials")]
+impl<T> SecureStore<T> for CredentialStore<T> {
+    fn get(&self) -> Result<Option<T>, String> {
+        match self.store.get(&self.account).map_err(|e| e.to_string())? {
+            None => Ok(None),
+            Some(secret) => {
+                let text = secret.expose_str().map_err(|e| e.to_string())?;
+                (self.decode)(text).map(Some)
+            }
+        }
+    }
+
+    fn set(&self, value: &T) -> Result<(), String> {
+        let text = (self.encode)(value)?;
+        self.store
+            .set(
+                &self.account,
+                &rightkit_credentials::Secret::from_string(text),
+            )
+            .map_err(|e| e.to_string())
+    }
+
+    fn delete(&self) -> Result<(), String> {
+        self.store
+            .delete(&self.account)
+            .map(|_| ())
+            .map_err(|e| e.to_string())
+    }
+
+    fn set_if_absent(&self, value: &T) -> Result<bool, String> {
+        let text = (self.encode)(value)?;
+        self.store
+            .add_if_absent(
+                &self.account,
+                &rightkit_credentials::Secret::from_string(text),
+            )
+            .map_err(|e| e.to_string())
+    }
+}

+    #[test]
+    fn revoked_id_is_denied_and_default_list_changes_nothing() {
+        let licenses = LicenseStore;
+        let devices = DeviceService::new(TestStore(Mutex::new(Some("dev-1".into()))));
+        let open = AuthorizationService::new(&licenses, &devices, &PUBKEY, "heardright");
+        assert!(open.authorize(LicenseRequirement::pro()).is_ok());
+
+        let revoked = AuthorizationService::new(&licenses, &devices, &PUBKEY, "heardright")
+            .with_revoked_ids(RevokedIds::new().with("lic_1"));
+        assert_eq!(
+            revoked.authorize(LicenseRequirement::pro()).unwrap_err(),
+            AuthorizationError::Denied(AuthorizationDenial::Revoked {
+                id: "lic_1".into()
+            })
+        );
+        // Revocation outranks expiry.
+        assert!(matches!(
+            revoked
+                .authorize_with_clock(LicenseRequirement::pro(), || Ok(10_000_000_000))
+                .unwrap_err(),
+            AuthorizationError::Denied(AuthorizationDenial::Revoked { .. })
+        ));
+
+        let other = AuthorizationService::new(&licenses, &devices, &PUBKEY, "heardright")
+            .with_revoked_ids(RevokedIds::new().with("lic_other"));
+        assert!(other.authorize(LicenseRequirement::pro()).is_ok());
+    }

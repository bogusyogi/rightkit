+/// Overwrites every string in `value` (object values and array items, recursively) with zeros
+/// and empties it. Object keys and numbers cannot be reached through `serde_json::Value` and are
+/// left; a request's secrets travel as string values.
+fn zeroize_value(value: &mut Value) {
+    match value {
+        Value::String(s) => s.zeroize(),
+        Value::Array(items) => items.iter_mut().for_each(zeroize_value),
+        Value::Object(map) => map.values_mut().for_each(zeroize_value),
+        _ => {}
+    }
+}
+
+/// A `Write` that only counts bytes.
+struct CountingWriter(usize);
+impl Write for CountingWriter {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0 += buf.len();
+        Ok(buf.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+/// Encodes one request frame as a JSON line into a buffer that is wiped on drop. The size is
+/// measured first and the buffer allocated exactly, so no grown-and-abandoned copy of the bytes is
+/// left behind, and the bytes are wiped on every path (limit exceeded included).
+fn encode_request_zeroizing(
+    frame: &Value,
+    limit: usize,
+) -> Result<Zeroizing<Vec<u8>>, FrameError> {
+    let mut count = CountingWriter(0);
+    serde_json::to_writer(&mut count, frame)?;
+    if count.0 > limit {
+        return Err(FrameError::TooLarge { limit });
+    }
+    let mut buf = Zeroizing::new(Vec::with_capacity(count.0 + 1));
+    serde_json::to_writer(&mut *buf, frame)?;
+    if buf.contains(&b'\n') {
+        return Err(FrameError::EmbeddedNewline);
+    }
+    buf.push(b'\n');
+    Ok(buf)
+}

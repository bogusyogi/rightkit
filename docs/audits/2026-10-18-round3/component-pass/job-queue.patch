+#[cfg(test)]
+mod request_wipe_tests {
+    use super::*;
+
+    #[test]
+    fn zeroize_value_wipes_nested_strings_and_keeps_the_shape() {
+        let mut v = json!({"a": "secret", "b": ["tok", {"c": "key"}], "n": 7, "t": true});
+        zeroize_value(&mut v);
+        assert_eq!(v["a"], "");
+        assert_eq!(v["b"][0], "");
+        assert_eq!(v["b"][1]["c"], "");
+        assert_eq!(v["n"], 7);
+        assert_eq!(v["t"], true);
+    }
+
+    #[test]
+    fn a_request_encodes_to_exactly_one_line_in_an_exact_buffer() {
+        let frame = json!({"type": "request", "id": 3, "method": "m", "params": {"k": "v\nw"}});
+        let bytes = encode_request_zeroizing(&frame, 1024).unwrap();
+        assert_eq!(bytes.last(), Some(&b'\n'));
+        assert_eq!(bytes.iter().filter(|b| **b == b'\n').count(), 1);
+        assert_eq!(bytes.len(), bytes.capacity());
+        let back: Value = serde_json::from_slice(&bytes).unwrap();
+        assert_eq!(back, frame);
+    }
+
+    #[test]
+    fn an_oversized_request_is_refused_before_any_bytes_are_kept() {
+        let frame = json!({"type": "request", "id": 1, "method": "m", "params": "x".repeat(100)});
+        assert!(matches!(
+            encode_request_zeroizing(&frame, 50),
+            Err(FrameError::TooLarge { limit: 50 })
+        ));
+    }
+
+    #[test]
+    fn an_error_reply_keeps_its_details() {
+        let map: PendingMap = Arc::default();
+        let subs: Subscribers = Arc::default();
+        let (tx, rx) = channel();
+        map.lock().unwrap().insert(
+            9,
+            Pending {
+                tx,
+                wants_events: false,
+            },
+        );
+        dispatch(
+            &map,
+            &subs,
+            &json!({"type":"response","id":9,"ok":false,
+                "error":{"code":"needs_auth","message":"sign in","details":{"platform":"x"}}}),
+            "engine_error",
+        );
+        match rx.recv().unwrap() {
+            Msg::Done(Err(e)) => {
+                assert_eq!(e.code, "needs_auth");
+                assert_eq!(e.details().unwrap()["platform"], "x");
+            }
+            _ => panic!("expected an error reply"),
+        }
+    }
+}

+    /// In-process FIFO of the callers waiting in [`JobLocks::acquire_cancellable`], per job id.
+    /// Shared by clones of this value.
+    waiters: Arc<Mutex<HashMap<String, VecDeque<u64>>>>,
+    next_ticket: Arc<AtomicU64>,
 }
 
+/// How a wait for a job lock ended ([`JobLocks::acquire_cancellable`]).
+#[non_exhaustive]
+pub enum LockWait {
+    /// The lock is held by the caller.
+    Acquired(JobLock),
+    /// The timeout ran out while another holder (or a caller queued ahead) kept the lock.
+    TimedOut,
+    /// The caller's `cancel` check returned `true` before the lock was taken.
+    Cancelled,
+}
+
+/// A place in a job's wait queue; leaves the queue when dropped.
+struct WaitSlot<'a> {
+    waiters: &'a Mutex<HashMap<String, VecDeque<u64>>>,
+    job_id: &'a str,
+    ticket: u64,
+}
+
+impl<'a> WaitSlot<'a> {
+    fn join(
+        waiters: &'a Mutex<HashMap<String, VecDeque<u64>>>,
+        job_id: &'a str,
+        ticket: u64,
+    ) -> Self {
+        waiters
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .entry(job_id.to_string())
+            .or_default()
+            .push_back(ticket);
+        Self {
+            waiters,
+            job_id,
+            ticket,
+        }
+    }
+
+    fn is_head(&self) -> bool {
+        self.waiters
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .get(self.job_id)
+            .and_then(|q| q.front())
+            == Some(&self.ticket)
+    }
+}
+
+impl Drop for WaitSlot<'_> {
+    fn drop(&mut self) {
+        let mut map = self.waiters.lock().unwrap_or_else(|e| e.into_inner());
+        if let Some(q) = map.get_mut(self.job_id) {
+            q.retain(|t| *t != self.ticket);
+            if q.is_empty() {
+                map.remove(self.job_id);
+            }
+        }
+    }
+}
+
+/// Longest the lock wait blocks inside the file lock before it re-checks `cancel`.
+const LOCK_WAIT_SLICE: Duration = Duration::from_millis(100);
+/// Pause of a queued (not first) waiter between turns.
+const LOCK_QUEUE_PAUSE: Duration = Duration::from_millis(10);
+
 impl JobLocks {
     pub fn new(dir: impl Into<PathBuf>) -> Self {
-        Self { dir: dir.into() }
+        Self {
+            dir: dir.into(),
+            waiters: Arc::new(Mutex::new(HashMap::new())),
+            next_ticket: Arc::new(AtomicU64::new(0)),
+        }
+    }
+
+    /// The directory the `<job_id>.lock` files live in.
+    pub fn dir(&self) -> &Path {
+        &self.dir
+    }
+
+    /// The path of the lock file of `job_id` (`<dir>/<job_id>.lock`), so a caller can hand it to
+    /// another lock primitive or show it. `bad_input` for an empty id or one containing `/`, `\`
+    /// or `.`. The file may not exist yet; taking the lock creates it.
+    pub fn lock_path(&self, job_id: &str) -> JobResult<PathBuf> {
+        self.path(job_id)
+    }
+
+    /// Waits up to `timeout` for the lock of `job_id`: `Ok(Some(lock))` once held, `Ok(None)`
+    /// when the timeout ran out first (`Duration::ZERO` tries once). Callers of this method and
+    /// of [`JobLocks::acquire_cancellable`] in this process are served in arrival order. Use it
+    /// instead of polling [`JobLocks::try_lock`] in a sleep loop.
+    pub fn acquire(&self, job_id: &str, timeout: Duration) -> JobResult<Option<JobLock>> {
+        Ok(match self.acquire_cancellable(job_id, timeout, || false)? {
+            LockWait::Acquired(lock) => Some(lock),
+            _ => None,
+        })
+    }
+
+    /// As [`JobLocks::acquire`], and `cancel` is checked about every 100 ms (and before each
+    /// attempt) so a caller that was cancelled or is shutting down stops waiting without taking
+    /// the lock. Waiters for one job id in this process queue in arrival order, so a late caller
+    /// does not overtake an earlier one; a [`JobLocks::try_lock`] caller is not queued and may
+    /// take a free lock first. A waiter that times out, is cancelled or returns an error leaves
+    /// the queue at once. Across processes the order is the operating system's.
+    pub fn acquire_cancellable(
+        &self,
+        job_id: &str,
+        timeout: Duration,
+        cancel: impl Fn() -> bool,
+    ) -> JobResult<LockWait> {
+        let path = self.path(job_id)?;
+        std::fs::create_dir_all(&self.dir)?;
+        let deadline = Instant::now().checked_add(timeout);
+        let ticket = self.next_ticket.fetch_add(1, Ordering::Relaxed);
+        let slot = WaitSlot::join(&self.waiters, job_id, ticket);
+        loop {
+            if cancel() {
+                return Ok(LockWait::Cancelled);
+            }
+            let remaining = deadline.map(|d| d.saturating_duration_since(Instant::now()));
+            if slot.is_head() {
+                let slice = remaining.map_or(LOCK_WAIT_SLICE, |r| r.min(LOCK_WAIT_SLICE));
+                match FileLock::acquire(&path, &LockOptions::wait(slice)) {
+                    Ok(lock) => return Ok(LockWait::Acquired(JobLock { _lock: lock })),
+                    Err(FsError::Locked { .. } | FsError::LockTimeout { .. }) => {}
+                    Err(error) => return Err(lock_error(error)),
+                }
+            } else {
+                std::thread::sleep(remaining.map_or(LOCK_QUEUE_PAUSE, |r| r.min(LOCK_QUEUE_PAUSE)));
+            }
+            if deadline.is_some_and(|d| Instant::now() >= d) {
+                return Ok(LockWait::TimedOut);
+            }
+        }
     }
 
     fn path(&self, job_id: &str) -> JobResult<PathBuf> {

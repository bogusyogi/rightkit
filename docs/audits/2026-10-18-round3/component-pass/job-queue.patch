+#[test]
+fn acquire_waits_for_the_holder_and_times_out_when_it_stays() {
+    use std::time::{Duration, Instant};
+
+    let dir = tempfile::tempdir().unwrap();
+    let locks = JobLocks::new(dir.path().join("locks"));
+    assert!(locks
+        .lock_path("job-2")
+        .unwrap()
+        .ends_with("job-2.lock"));
+    assert!(locks.lock_path("../x").is_err());
+
+    // Free lock: taken at once, even with a zero timeout.
+    let held = locks.acquire("job-2", Duration::ZERO).unwrap().unwrap();
+    // Held: a short wait times out.
+    let started = Instant::now();
+    assert!(locks
+        .acquire("job-2", Duration::from_millis(150))
+        .unwrap()
+        .is_none());
+    assert!(started.elapsed() >= Duration::from_millis(140));
+
+    // A waiter takes the lock soon after the holder lets go.
+    let waiter = {
+        let locks = locks.clone();
+        std::thread::spawn(move || locks.acquire("job-2", Duration::from_secs(10)).unwrap().is_some())
+    };
+    std::thread::sleep(Duration::from_millis(200));
+    drop(held);
+    assert!(waiter.join().unwrap());
+}
+
+#[test]
+fn acquire_cancellable_stops_when_cancelled_and_leaves_the_queue() {
+    use rightkit_job_queue::LockWait;
+    use std::time::Duration;
+
+    let dir = tempfile::tempdir().unwrap();
+    let locks = JobLocks::new(dir.path().join("locks"));
+    let held = locks.try_lock("job-3").unwrap().unwrap();
+
+    let cancel = Arc::new(AtomicBool::new(false));
+    let waiter = {
+        let (locks, cancel) = (locks.clone(), cancel.clone());
+        std::thread::spawn(move || {
+            matches!(
+                locks
+                    .acquire_cancellable("job-3", Duration::from_secs(30), || {
+                        cancel.load(Ordering::SeqCst)
+                    })
+                    .unwrap(),
+                LockWait::Cancelled
+            )
+        })
+    };
+    std::thread::sleep(Duration::from_millis(150));
+    cancel.store(true, Ordering::SeqCst);
+    assert!(waiter.join().unwrap(), "a cancelled wait reports Cancelled");
+
+    // The cancelled waiter left the queue: the next caller is not held up behind it.
+    drop(held);
+    assert!(matches!(
+        locks
+            .acquire_cancellable("job-3", Duration::ZERO, || false)
+            .unwrap(),
+        LockWait::Acquired(_)
+    ));
+}
+
+#[test]
+fn earlier_waiters_are_served_first() {
+    use std::sync::Mutex;
+    use std::time::Duration;
+
+    let dir = tempfile::tempdir().unwrap();
+    let locks = JobLocks::new(dir.path().join("locks"));
+    let held = locks.try_lock("job-4").unwrap().unwrap();
+    let order = Arc::new(Mutex::new(Vec::new()));
+    let mut handles = Vec::new();
+    for n in 0..3 {
+        let (locks, order) = (locks.clone(), order.clone());
+        handles.push(std::thread::spawn(move || {
+            let lock = locks.acquire("job-4", Duration::from_secs(20)).unwrap().unwrap();
+            order.lock().unwrap().push(n);
+            drop(lock);
+        }));
+        std::thread::sleep(Duration::from_millis(200));
+    }
+    drop(held);
+    for h in handles {
+        h.join().unwrap();
+    }
+    assert_eq!(*order.lock().unwrap(), vec![0, 1, 2]);
+}

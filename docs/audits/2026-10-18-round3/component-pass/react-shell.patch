diff --git a/packages/react-shell/src/react/anchored-menu.tsx b/packages/react-shell/src/react/anchored-menu.tsx
new file mode 100644
index 0000000..de36d18
--- /dev/null
+++ b/packages/react-shell/src/react/anchored-menu.tsx
@@ -0,0 +1,256 @@
+import { useCallback, useEffect, useLayoutEffect, useRef, useState, type KeyboardEvent as ReactKeyboardEvent, type ReactNode, type RefObject } from "react";
+import { createPortal } from "react-dom";
+import { useDismiss } from "@rightkit/platform-ui/headless";
+import { Kbd } from "@rightkit/platform-ui/react";
+import { floatingPanelStyle, type FloatingPanelStyle } from "../geometry.js";
+import { anchorPoint, type MenuItem, type MenuPlacement } from "./contextmenu.js";
+import { useShellOptional } from "./provider.js";
+import type { SlotClasses } from "./slots.js";
+import { cx } from "./ui.js";
+
+export interface UseAnchoredMenuOptions {
+  /** Rows that cannot take focus (disabled). Arrows, Home and End skip them. */
+  isDisabled?: (index: number) => boolean;
+  /** Called when the menu opens or closes. */
+  onOpenChange?: (open: boolean) => void;
+}
+
+export interface AnchoredMenuState<Trigger extends HTMLElement = HTMLButtonElement, Root extends HTMLElement = HTMLDivElement> {
+  open: boolean;
+  /** Index of the focused row, or -1. */
+  focusIndex: number;
+  /** Put on the element that holds the rows (it is also the outside-press container). */
+  rootRef: RefObject<Root | null>;
+  /** Put on the trigger button. Presses on it never count as outside presses, and focus returns to it on close. */
+  triggerRef: RefObject<Trigger | null>;
+  /** `itemRefs.current[i] = element` for each row, so focus can follow `focusIndex`. */
+  itemRefs: { current: Array<HTMLElement | null> };
+  /** Open with focus on the first enabled row (default), the last, or a given index. */
+  openMenu: (at?: "first" | "last" | number) => void;
+  /** Close; focus returns to the trigger unless `restoreFocus` is false. */
+  closeMenu: (restoreFocus?: boolean) => void;
+  /** Spread-ready `onKeyDown` for the trigger: ArrowDown opens on the first row, ArrowUp on the last, Escape closes. */
+  handleTriggerKeyDown: (event: ReactKeyboardEvent<Element>) => void;
+  /** `onKeyDown` for the menu: arrows, Home, End move; Tab and Escape close with focus restored. */
+  handleMenuKeyDown: (event: ReactKeyboardEvent<Element>) => void;
+}
+
+/**
+ * Behaviour of a button-triggered dropdown with roving focus (the counterpart of `ContextMenu`, which is positioned by
+ * x/y and keeps focus on the menu). The hook renders nothing: use it with your own markup, or use `AnchoredMenu`.
+ * ArrowDown or ArrowUp on the trigger opens the menu on the first or last row; inside, arrows, Home and End move
+ * (wrapping), Tab and Escape close, an outside press, a resize or a scroll outside closes, and focus returns to the
+ * trigger. Set `aria-haspopup="menu"` and `aria-expanded={open}` on the trigger.
+ */
+export function useAnchoredMenu<Trigger extends HTMLElement = HTMLButtonElement, Root extends HTMLElement = HTMLDivElement>(itemCount: number, options: UseAnchoredMenuOptions = {}): AnchoredMenuState<Trigger, Root> {
+  const [open, setOpen] = useState(false);
+  const [focusIndex, setFocusIndex] = useState(-1);
+  const rootRef = useRef<Root | null>(null);
+  const triggerRef = useRef<Trigger | null>(null);
+  const itemRefs = useRef<Array<HTMLElement | null>>([]);
+  const optionsRef = useRef(options);
+  optionsRef.current = options;
+  const countRef = useRef(itemCount);
+  countRef.current = itemCount;
+
+  const enabledIndexes = useCallback(() => {
+    const out: number[] = [];
+    for (let i = 0; i < countRef.current; i++) if (!optionsRef.current.isDisabled?.(i)) out.push(i);
+    return out;
+  }, []);
+
+  const openRef = useRef(false);
+
+  const closeMenu = useCallback((restoreFocus = true) => {
+    if (openRef.current) {
+      openRef.current = false;
+      setOpen(false);
+      optionsRef.current.onOpenChange?.(false);
+    }
+    setFocusIndex(-1);
+    if (restoreFocus) triggerRef.current?.focus?.({ preventScroll: true });
+  }, []);
+
+  const openMenu = useCallback(
+    (at: "first" | "last" | number = "first") => {
+      const idx = enabledIndexes();
+      const target = typeof at === "number" ? at : at === "last" ? idx[idx.length - 1] ?? -1 : idx[0] ?? -1;
+      setFocusIndex(target);
+      if (!openRef.current) {
+        openRef.current = true;
+        setOpen(true);
+        optionsRef.current.onOpenChange?.(true);
+      }
+    },
+    [enabledIndexes],
+  );
+
+  useDismiss(() => closeMenu(false), { enabled: open, escape: false, container: rootRef, ignore: [triggerRef], onResize: true, onScroll: true });
+
+  // Move DOM focus with the roving index.
+  useEffect(() => {
+    if (open && focusIndex >= 0) itemRefs.current[focusIndex]?.focus({ preventScroll: true });
+  }, [open, focusIndex]);
+
+  const move = (to: (idx: number[], at: number) => number | undefined) => {
+    const idx = enabledIndexes();
+    if (!idx.length) return;
+    const next = to(idx, idx.indexOf(focusIndex));
+    if (next !== undefined) setFocusIndex(next);
+  };
+
+  const handleTriggerKeyDown = (event: ReactKeyboardEvent<Element>) => {
+    if (event.nativeEvent.isComposing) return;
+    if (event.key === "ArrowDown") {
+      event.preventDefault();
+      openMenu("first");
+    } else if (event.key === "ArrowUp") {
+      event.preventDefault();
+      openMenu("last");
+    } else if (event.key === "Escape" && open) {
+      event.preventDefault();
+      event.stopPropagation();
+      closeMenu();
+    }
+  };
+
+  const handleMenuKeyDown = (event: ReactKeyboardEvent<Element>) => {
+    if (event.nativeEvent.isComposing) return;
+    switch (event.key) {
+      case "ArrowDown":
+        event.preventDefault();
+        move((idx, at) => idx[(at + 1) % idx.length]);
+        break;
+      case "ArrowUp":
+        event.preventDefault();
+        move((idx, at) => idx[at <= 0 ? idx.length - 1 : at - 1]);
+        break;
+      case "Home":
+        event.preventDefault();
+        move((idx) => idx[0]);
+        break;
+      case "End":
+        event.preventDefault();
+        move((idx) => idx[idx.length - 1]);
+        break;
+      case "Escape":
+        event.preventDefault();
+        event.stopPropagation();
+        closeMenu();
+        break;
+      case "Tab":
+        // Tab leaves the menu: close and let focus continue from the trigger.
+        closeMenu();
+        break;
+      default:
+        break;
+    }
+  };
+
+  return { open, focusIndex, rootRef, triggerRef, itemRefs, openMenu, closeMenu, handleTriggerKeyDown, handleMenuKeyDown };
+}
+
+/** Props to spread on the trigger element of an `AnchoredMenu`. */
+export interface AnchoredMenuTriggerProps {
+  ref: RefObject<HTMLButtonElement | null>;
+  "aria-haspopup": "menu";
+  "aria-expanded": boolean;
+  "aria-controls": string | undefined;
+  onClick: () => void;
+  onKeyDown: (event: ReactKeyboardEvent<Element>) => void;
+}
+
+export interface AnchoredMenuProps {
+  /** Accessible name of the menu. */
+  label: string;
+  items: readonly MenuItem[];
+  /** Renders the trigger; spread `props` on a button and use `state.open` for a pressed look. */
+  trigger: (props: AnchoredMenuTriggerProps, state: { open: boolean }) => ReactNode;
+  /** Side of the trigger the menu opens on. Default `bottom-start`. */
+  placement?: MenuPlacement;
+  /** Menu width in px. Default 200. */
+  width?: number;
+  className?: string;
+  /** Extra classes per region: `root` (menu), `item`, `separator`, `label`, `lead`. */
+  slots?: SlotClasses<"root" | "item" | "separator" | "label" | "lead">;
+  /** Called when the menu opens or closes. */
+  onOpenChange?: (open: boolean) => void;
+}
+
+/**
+ * Button-triggered dropdown menu: `useAnchoredMenu` plus the shell's menu markup, positioned from the trigger and
+ * flipped when it would overflow. Rows are `button[role=menuitem]`, one Tab stop at a time (roving focus); a chosen
+ * item's `run` fires after the menu closes and focus has returned to the trigger.
+ */
+export function AnchoredMenu({ label, items, trigger, placement = "bottom-start", width = 200, className, slots, onOpenChange }: AnchoredMenuProps) {

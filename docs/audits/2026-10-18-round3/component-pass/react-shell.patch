+  return (
+    <>
+      {trigger(triggerProps, { open: menu.open })}
+      {menu.open
+        ? createPortal(
+            <div
+              ref={menu.rootRef}
+              id={menuId}
+              role="menu"
+              aria-label={label}
+              className={cx("rk-menu", className, slots?.root)}
+              style={pos ?? { visibility: "hidden" }}
+              onKeyDown={menu.handleMenuKeyDown}
+            >
+              {items.map((item, i) => (
+                <div key={item.id}>
+                  {item.separatorBefore ? <div className={cx("rk-menu__sep", slots?.separator)} role="separator" /> : null}
+                  <button
+                    type="button"
+                    ref={(el) => {
+                      menu.itemRefs.current[i] = el;
+                    }}
+                    role={item.checked === undefined ? "menuitem" : "menuitemcheckbox"}
+                    aria-checked={item.checked}
+                    disabled={item.disabled}
+                    tabIndex={i === menu.focusIndex ? 0 : -1}
+                    className={cx("rk-menu__item", i === menu.focusIndex && "is-active", item.danger && "is-danger", item.disabled && "is-disabled", slots?.item)}
+                    onClick={() => {
+                      if (item.disabled) return;
+                      menu.closeMenu();
+                      item.run?.();
+                    }}
+                  >
+                    <span className={cx("rk-menu__lead", slots?.lead)} aria-hidden="true">{item.checked ? "✓" : item.icon}</span>
+                    <span className={cx("rk-menu__label", slots?.label)}>{item.label}</span>
+                    {item.shortcut ? <Kbd chord={item.shortcut} gap={1} platform={shellPlatform} /> : null}
+                  </button>
+                </div>
+              ))}
+            </div>,
+            document.body,
+          )
+        : null}
+    </>
+  );
+}

diff --git a/packages/react-shell/src/react/round2-gaps.test.tsx b/packages/react-shell/src/react/round2-gaps.test.tsx
new file mode 100644
index 0000000..a0741f9
--- /dev/null
+++ b/packages/react-shell/src/react/round2-gaps.test.tsx
@@ -0,0 +1,124 @@
+// Markup-level checks for the 0.7.1 additions (Table, Textarea, Select attributes, ModalShell width, controlled
+// PromptDialog, DialogAction title, registry-less ShortcutHelp, AnchoredMenu, provider-less useShortcuts).
+import { describe, expect, it } from "vitest";
+import { renderToStaticMarkup } from "react-dom/server";
+import { AnchoredMenu } from "./anchored-menu.js";
+import { ActionDialog, ModalShell, PromptDialog } from "./overlays.js";
+import { ShortcutHelp } from "./palette.js";
+import { useShortcuts } from "./provider.js";
+import { Select, Table, Textarea } from "./ui.js";
+
+const noop = () => undefined;
+
+describe("Table", () => {
+  const columns = [
+    { id: "name", header: "Name", cell: (r: { name: string; n: number }) => r.name },
+    { id: "n", header: "Count", align: "end" as const, width: 80, cell: (r: { name: string; n: number }) => r.n },
+  ];
+  const rows = [{ name: "a", n: 1 }, { name: "b", n: 2 }];
+  it("renders a labelled table with column-scoped headers and aligned cells", () => {
+    const html = renderToStaticMarkup(<Table label="Items" columns={columns} rows={rows} rowKey={(r) => r.name} caption="Cap" />);
+    expect(html).toContain('<table aria-label="Items" class="rk-table">');
+    expect(html).toContain("<caption>Cap</caption>");
+    expect(html).toContain('<th scope="col">Name</th>');
+    expect(html).toContain('<th scope="col" class="is-end" style="width:80px">Count</th>');
+    expect(html).toContain('<td class="is-end">2</td>');
+  });
+  it("marks dense, striped, interactive and selected rows", () => {
+    const html = renderToStaticMarkup(<Table label="Items" dense striped columns={columns} rows={rows} rowKey={(r) => r.name} onRowClick={noop} selectedKey="b" />);
+    expect(html).toContain("rk-table rk-table--dense rk-table--striped");
+    expect(html).toContain('class="rk-table__row rk-table__row--interactive is-selected" aria-current="true" tabindex="0"');
+  });
+  it("shows the empty content in one full-width cell", () => {
+    const html = renderToStaticMarkup(<Table label="Items" columns={columns} rows={[]} rowKey={(r) => r.name} empty="Nothing here" />);
+    expect(html).toContain('colspan="2"');
+    expect(html).toContain("Nothing here");
+  });
+});
+
+describe("Textarea and Select", () => {
+  it("Textarea takes native attributes and the shell class", () => {
+    const html = renderToStaticMarkup(<Textarea className="x" placeholder="Notes" rows={5} aria-invalid />);
+    expect(html).toContain('class="rk-textarea x"');
+    expect(html).toContain('rows="5"');
+    expect(html).toContain('placeholder="Notes"');
+  });
+  it("Select forwards id, name and aria-describedby", () => {
+    const html = renderToStaticMarkup(<Select label="Mode" id="m" name="mode" aria-describedby="m-note" value="a" options={[{ value: "a", label: "A" }]} onChange={noop} />);
+    expect(html).toContain('id="m"');
+    expect(html).toContain('name="mode"');
+    expect(html).toContain('aria-describedby="m-note"');
+  });
+});
+
+describe("ModalShell width", () => {
+  it("defaults to 440px, takes a CSS length, and `false` writes no inline width", () => {
+    expect(renderToStaticMarkup(<ModalShell label="x" onClose={noop}>b</ModalShell>)).toContain('style="width:440px"');
+    expect(renderToStaticMarkup(<ModalShell label="x" width="min(560px, 100%)" onClose={noop}>b</ModalShell>)).toContain("width:min(560px, 100%)");
+    const css = renderToStaticMarkup(<ModalShell label="x" width={false} onClose={noop}>b</ModalShell>);
+    expect(css).not.toContain("width:");
+    expect(css).not.toContain("style=");
+  });
+});
+
+describe("PromptDialog", () => {
+  it("controlled value is shown instead of initialValue", () => {
+    const html = renderToStaticMarkup(<PromptDialog title="Rename" label="Name" initialValue="old" value="typed" onChange={noop} onSubmit={noop} onCancel={noop} />);
+    expect(html).toContain('value="typed"');
+    expect(html).not.toContain('value="old"');
+  });
+  it("requireValue disables confirm while the value is blank", () => {
+    const blank = renderToStaticMarkup(<PromptDialog title="T" label="L" value="  " onChange={noop} requireValue onSubmit={noop} onCancel={noop} />);
+    expect(blank).toMatch(/<button[^>]*type="submit"[^>]*disabled/);
+    const filled = renderToStaticMarkup(<PromptDialog title="T" label="L" value="x" onChange={noop} requireValue onSubmit={noop} onCancel={noop} />);
+    expect(filled).not.toMatch(/<button[^>]*type="submit"[^>]*disabled/);
+  });
+});
+
+describe("DialogAction title", () => {
+  it("is the button tooltip", () => {
+    const html = renderToStaticMarkup(<ActionDialog title="Save?" onClose={noop} actions={[{ label: "Save", title: "Save notes.txt", onClick: noop }]} />);
+    expect(html).toContain('title="Save notes.txt"');
+  });
+});
+
+describe("ShortcutHelp without a registry", () => {
+  it("lists a plain {label, chord} array, grouped in first-seen order", () => {
+    const html = renderToStaticMarkup(
+      <ShortcutHelp
+        onClose={noop}
+        platform="windows"
+        shortcuts={[
+          { label: "Open", chord: "mod+o" },
+          { label: "Find", chord: "mod+f", group: "Search" },
+          { label: "Save", chord: "mod+s" },
+        ]}
+      />,
+    );
+    expect(html.indexOf("<h3>General</h3>")).toBeGreaterThan(-1);
+    expect(html.indexOf("<h3>General</h3>")).toBeLessThan(html.indexOf("<h3>Search</h3>"));
+    expect(html).toContain("<span>Open</span>");
+    expect(html).toContain("<span>Save</span>");
+  });
+});
+
+describe("AnchoredMenu", () => {
+  it("renders only the trigger while closed, with menu button semantics", () => {
+    const html = renderToStaticMarkup(
+      <AnchoredMenu label="Actions" items={[{ id: "a", label: "A" }]} trigger={(props, { open }) => <button type="button" aria-haspopup={props["aria-haspopup"]} aria-expanded={props["aria-expanded"]} data-open={open}>More</button>} />,
+    );
+    expect(html).toContain('aria-haspopup="menu"');
+    expect(html).toContain('aria-expanded="false"');
+    expect(html).not.toContain('role="menu"');
+  });
+});
+
+describe("useShortcuts without a provider", () => {
+  it("renders without a ShellProvider (registration happens in effects)", () => {
+    function Probe() {
+      useShortcuts([{ id: "probe", chord: "mod+j", label: "Probe", run: noop }]);
+      return <span>ok</span>;
+    }
+    expect(renderToStaticMarkup(<Probe />)).toBe("<span>ok</span>");
+  });
+});

@@ -0,0 +1,40 @@
+#![cfg(feature = "pdfium")]
+
+//! Live PDFium check. Ignored: it needs a PDFium dynamic library. Run with
+//! `RIGHTKIT_PDFIUM_LIBRARY=<absolute path to pdfium.dll / libpdfium.dylib / libpdfium.so>`
+//! and `--ignored`. One engine per process, so this file holds a single test.
+
+use std::path::{Path, PathBuf};
+
+use rightkit_pdf::pdfium::{PdfiumEngine, PdfiumError};
+
+#[test]
+#[ignore = "needs a PDFium library; set RIGHTKIT_PDFIUM_LIBRARY"]
+fn text_and_render_through_a_real_pdfium() {
+    let library = PathBuf::from(
+        std::env::var("RIGHTKIT_PDFIUM_LIBRARY").expect("RIGHTKIT_PDFIUM_LIBRARY is not set"),
+    );
+    let engine = PdfiumEngine::load(&library).expect("load pdfium");
+    assert!(matches!(
+        PdfiumEngine::load(&library),
+        Err(PdfiumError::AlreadyLoaded)
+    ));
+    let bytes = std::fs::read(
+        Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/memo.pdf"),
+    )
+    .unwrap();
+    let pages = engine.text_by_pages(&bytes, None).unwrap();
+    assert_eq!(pages.len(), engine.page_count(&bytes, None).unwrap());
+    assert!(!pages[0].trim().is_empty());
+    assert_eq!(engine.page_text(&bytes, 0, None).unwrap(), pages[0]);
+    let image = engine.render_page(&bytes, 0, 72.0, None).unwrap();
+    assert!(image.width > 0 && image.height > 0);
+    assert_eq!(
+        image.rgba.len(),
+        image.width as usize * image.height as usize * 4
+    );
+    assert!(matches!(
+        engine.page_text(&bytes, pages.len(), None),
+        Err(PdfiumError::PageOutOfRange { .. })
+    ));
+}

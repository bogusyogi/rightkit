+#[test]
+fn oid_only_inventory_keys_clean_files_by_oid_without_reading_bodies() {
+    use crate::inventory::{git_listed_inventory_with, CleanBodies};
+    let dir = inventory_repo("oid-only");
+    fs::write(dir.join("clean.txt"), "clean body\n").unwrap();
+    let git = |args: &[&str]| {
+        let status = std::process::Command::new("git")
+            .args(["-c", "user.name=t", "-c", "user.email=t@example.invalid"])
+            .args(args)
+            .current_dir(&dir)
+            .status()
+            .unwrap();
+        assert!(status.success());
+    };
+    git(&["add", "clean.txt"]);
+    fs::write(dir.join("fresh.txt"), "untracked body\n").unwrap();
+
+    let read = git_listed_inventory_with(&dir, &|_| true, &[], &|_| 1 << 20, &dir, CleanBodies::Read);
+    let lazy =
+        git_listed_inventory_with(&dir, &|_| true, &[], &|_| 1 << 20, &dir, CleanBodies::OidOnly);
+    let find = |inv: &crate::inventory::Inventory, rel: &str| {
+        inv.files.iter().find(|f| f.rel == rel).cloned().unwrap()
+    };
+    let (clean_read, clean_lazy) = (find(&read, "clean.txt"), find(&lazy, "clean.txt"));
+    assert!(clean_read.bytes.is_some());
+    assert!(clean_lazy.bytes.is_none(), "no clean body is read");
+    assert_eq!(clean_lazy.digest, clean_read.digest);
+    assert_eq!(clean_lazy.cache_key, clean_read.cache_key);
+    assert_eq!(clean_lazy.size, clean_read.size);
+    // Untracked inputs are still read and hashed.
+    assert!(find(&lazy, "fresh.txt").bytes.is_some());
+    assert_eq!(find(&lazy, "fresh.txt").digest, find(&read, "fresh.txt").digest);
+    assert_eq!(lazy.coverage.len(), read.coverage.len());
+
+    // The size limit is still enforced without the body.
+    let tiny = git_listed_inventory_with(&dir, &|_| true, &[], &|_| 4, &dir, CleanBodies::OidOnly);
+    assert!(tiny
+        .coverage
+        .iter()
+        .any(|c| c.path == "clean.txt" && c.reason == "file-over-size-limit"));
+    fs::remove_dir_all(&dir).ok();
+}

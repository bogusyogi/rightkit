+//! `exchange_code_with_verifier` (a caller-held PKCE verifier and pasted code) and
+//! `refresh_token` (bare refresh token), against an in-process mock authorization server.
+
+use rightkit_http::testing::{loopback_config, MockResponse, MockServer};
+use rightkit_http::{Client, ClientConfig, RetryPolicy, Secret};
+use rightkit_oauth::{pkce, OAuthClient, OAuthConfig, OAuthError};
+use serde_json::json;
+
+fn client() -> Client {
+    Client::new(ClientConfig {
+        retry: RetryPolicy::none(),
+        ..loopback_config()
+    })
+}
+
+fn oauth(server: &MockServer) -> OAuthClient {
+    OAuthClient::new(
+        OAuthConfig::new(
+            "desktop-client",
+            server.url("/authorize"),
+            server.url("/token"),
+        ),
+        client(),
+    )
+    .unwrap()
+    .with_token_param("resource", "https://mcp.example/api")
+    .unwrap()
+}
+
+#[test]
+fn a_caller_held_verifier_and_pasted_code_exchange_without_an_authorization_request() {
+    let verifier = pkce::Pkce::generate().unwrap().verifier.expose().to_string();
+    let sent = verifier.clone();
+    let server = MockServer::start(move |request, _| {
+        let form = request.form();
+        let get = |name: &str| {
+            form.iter()
+                .find(|(k, _)| k == name)
+                .map(|(_, v)| v.clone())
+                .unwrap_or_default()
+        };
+        assert_eq!(get("grant_type"), "authorization_code");
+        assert_eq!(get("code"), "pasted-code");
+        assert_eq!(get("redirect_uri"), "http://localhost:1455/auth/callback");
+        assert_eq!(get("code_verifier"), sent);
+        assert_eq!(get("resource"), "https://mcp.example/api");
+        MockResponse::json(
+            200,
+            &json!({"access_token": "a1", "refresh_token": "r1", "expires_in": 60}),
+        )
+    });
+    let tokens = oauth(&server)
+        .exchange_code_with_verifier(
+            "pasted-code",
+            &Secret::new(verifier),
+            "http://localhost:1455/auth/callback",
+        )
+        .unwrap();
+    assert_eq!(tokens.access_token(), "a1");
+    assert_eq!(tokens.refresh_token.unwrap().expose(), "r1");
+}
+
+#[test]
+fn bad_inputs_are_refused_before_anything_is_sent() {
+    let server = MockServer::start(|_, _| MockResponse::json(200, &json!({"access_token": "x"})));
+    let client = oauth(&server);
+    let good = Secret::new(pkce::Pkce::generate().unwrap().verifier.expose().to_string());
+    let redirect = "http://localhost:1455/auth/callback";
+    for (code, verifier, uri) in [
+        ("", &good, redirect),
+        ("c", &Secret::new("short"), redirect),
+        ("c", &good, ""),
+        ("c", &good, "http://localhost:1455/a b"),
+    ] {
+        let e = client
+            .exchange_code_with_verifier(code, verifier, uri)
+            .unwrap_err();
+        assert!(matches!(e, OAuthError::InvalidConfig(_)), "{e}");
+    }
+    assert_eq!(server.request_count(), 0);
+}
+
+#[test]
+fn refresh_token_works_from_a_bare_token_and_keeps_it_when_not_rotated() {
+    let server = MockServer::start(|request, _| {
+        let form = request.form();
+        assert!(form
+            .iter()
+            .any(|(k, v)| k == "refresh_token" && v == "bare-refresh"));
+        assert!(form.iter().any(|(k, v)| k == "grant_type" && v == "refresh_token"));
+        MockResponse::json(200, &json!({"access_token": "a2", "expires_in": 60}))
+    });
+    let tokens = oauth(&server)
+        .refresh_token(&Secret::new("bare-refresh"))
+        .unwrap();
+    assert_eq!(tokens.access_token(), "a2");
+    assert_eq!(tokens.refresh_token.unwrap().expose(), "bare-refresh");
+}
+
+#[test]
+fn a_dead_bare_refresh_token_needs_reauth_and_an_empty_one_sends_nothing() {
+    let server = MockServer::start(|_, _| MockResponse::json(400, &json!({"error": "invalid_grant"})));
+    let client = oauth(&server);
+    assert!(matches!(
+        client.refresh_token(&Secret::new("gone")).unwrap_err(),

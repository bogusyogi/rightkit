+#[test]
+fn post_json_with_rejects_a_body_before_acknowledging_it() {
+    let state = pkce::generate_state().unwrap();
+    let l = listener(&state);
+    let port = l.port();
+    let waiter = thread::spawn(move || {
+        l.wait_post_json_with(Duration::from_secs(10), None, ORIGIN, |body| {
+            if body.get("apiKey").and_then(Value::as_str).is_some() {
+                Ok(())
+            } else {
+                Err("apiKey is required")
+            }
+        })
+    });
+    // Right state, missing field: answered 400 with the validator's text, wait continues.
+    let missing = post(
+        port,
+        "/callback",
+        Some(ORIGIN),
+        &json!({"state": state}).to_string(),
+    );
+    assert_eq!(status(&missing), "HTTP/1.1 400 Bad Request");
+    assert!(missing.contains("apiKey is required"));
+    assert!(!lower(&missing).contains("\"ok\":true"));
+    // A wrong state never reaches the validator and is also refused.
+    let wrong = post(
+        port,
+        "/callback",
+        Some(ORIGIN),
+        &json!({"state": "other", "apiKey": "k"}).to_string(),
+    );
+    assert_eq!(status(&wrong), "HTTP/1.1 400 Bad Request");
+    // A complete body ends the flow.
+    let good = post(
+        port,
+        "/callback",
+        Some(ORIGIN),
+        &json!({"state": state, "apiKey": "k"}).to_string(),
+    );
+    assert_eq!(status(&good), "HTTP/1.1 200 OK");
+    let value = waiter.join().unwrap().unwrap();
+    assert_eq!(value["apiKey"], "k");
+}

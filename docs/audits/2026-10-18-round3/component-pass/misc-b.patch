+//! Async twins over `rightkit_http::AsyncClient` (feature `async`), against the in-process
+//! mock server.
+#![cfg(feature = "async")]
+
+use rightkit_http::testing::{loopback_config, MockResponse, MockServer};
+use rightkit_http::{AsyncClient, Client, Secret};
+use rightkit_oauth::gateway::GatewayExchange;
+use rightkit_oauth::{pkce, OAuthClient, OAuthConfig, OAuthError};
+use serde_json::json;
+
+fn verifier() -> String {
+    pkce::Pkce::generate().unwrap().verifier.expose().to_string()
+}
+
+#[tokio::test]
+async fn token_calls_run_on_the_async_client() {
+    let server = MockServer::start(|request, _| {
+        let form = request.form();
+        let grant = form
+            .iter()
+            .find(|(k, _)| k == "grant_type")
+            .map(|(_, v)| v.as_str())
+            .unwrap_or("");
+        match grant {
+            "authorization_code" => MockResponse::json(
+                200,
+                &json!({"access_token": "a1", "refresh_token": "r1", "expires_in": 60}),
+            ),
+            _ => MockResponse::json(400, &json!({"error": "invalid_grant"})),
+        }
+    });
+    let oauth = OAuthClient::new(
+        OAuthConfig::new("cid", server.url("/authorize"), server.url("/token")),
+        Client::new(loopback_config()),
+    )
+    .unwrap();
+    let http = AsyncClient::new(loopback_config()).unwrap();
+    let tokens = oauth
+        .exchange_code_with_verifier_async(
+            &http,
+            "code",
+            &Secret::new(verifier()),
+            "http://localhost:1455/auth/callback",
+        )
+        .await
+        .unwrap();
+    assert_eq!(tokens.access_token(), "a1");
+    let dead = oauth.refresh_async(&http, &tokens).await.unwrap_err();
+    assert!(matches!(dead, OAuthError::NeedsReauth));
+}
+
+#[tokio::test]
+async fn gateway_exchange_and_refresh_run_on_the_async_client() {
+    let server = MockServer::start(|request, _| {
+        if request.path() == "/refresh" {
+            MockResponse::json(
+                200,
+                &json!({"access_token": "a2", "provider": "p", "user_id": "u"}),
+            )
+        } else {
+            MockResponse::json(
+                200,
+                &json!({"access_token": "a1", "refresh_token": "r1", "expires_at": 5}),
+            )
+        }
+    });
+    let gateway = GatewayExchange::new(server.url("/exchange"))
+        .unwrap()
+        .with_refresh_endpoint(server.url("/refresh"))
+        .unwrap();
+    let http = AsyncClient::new(loopback_config()).unwrap();
+    let first = gateway
+        .exchange_tokens_async(&http, "code", &verifier(), None)
+        .await
+        .unwrap();
+    assert_eq!(first.extra["expires_at"], 5);
+    let second = gateway
+        .refresh_async(&http, &Secret::new("r1"), &[("provider", "p")], None)
+        .await
+        .unwrap();
+    assert_eq!(second.extra["user_id"], "u");
+    assert_eq!(second.token_set.refresh_token.unwrap().expose(), "r1");
+}

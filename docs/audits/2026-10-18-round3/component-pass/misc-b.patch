@@ -0,0 +1,344 @@
+//! PDFium binding: per-page text and page rendering through a runtime-loaded PDFium library.
+//! Feature `pdfium` (off by default).
+//!
+//! The crate links no PDFium. [`PdfiumEngine::load`] opens a PDFium dynamic library the host
+//! already holds at an absolute path (`pdfium.dll`, `libpdfium.dylib`, `libpdfium.so`), the
+//! build `rightkit-ffmpeg`'s native catalog pins (`pdfium`, currently chromium/8021 from
+//! bblanchon/pdfium-binaries). [`PdfiumEngine::load_verified`] first checks the file's SHA-256.
+//! Provisioning and the catalog's own verification stay with the caller; this module never
+//! downloads anything.
+//!
+//! Unlike the pure-Rust [`crate::extract`] and [`crate::raster`] paths, PDFium draws text,
+//! vector graphics and every image type, and extracts text in PDFium's reading order. Use it
+//! where the pure-Rust paths report limitations.
+//!
+//! **One engine per process.** PDFium keeps process-global state. A second
+//! [`PdfiumEngine::load`] in the same process returns [`PdfiumError::AlreadyLoaded`] instead of
+//! panicking. Keep the engine for the process lifetime and pass it by reference.
+//!
+//! **Trust.** PDFium parses untrusted bytes in-process. It is native code: a defect in it can
+//! crash the host. Run it where a crash is acceptable, and keep the library current.
+
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use pdfium_render::prelude::{PdfRenderConfig, Pdfium, PdfiumError as NativeError};
+use sha2::{Digest, Sha256};
+
+/// Most pixels one rendered page may have (checked before PDFium allocates anything).
+pub const MAX_PIXELS: u64 = 60_000_000;
+/// Resolution limits for [`PdfiumEngine::render_page`].
+pub const DPI_RANGE: std::ops::RangeInclusive<f32> = 1.0..=1200.0;
+
+static LOADED: AtomicBool = AtomicBool::new(false);
+
+/// Failures of the PDFium binding. Native messages are carried as text so this type does not
+/// expose `pdfium-render`.
+#[derive(Debug, thiserror::Error)]
+pub enum PdfiumError {
+    /// The library path is not absolute, so the loader's search path could pick a planted file.
+    #[error("pdfium library path must be absolute: {0}")]
+    RelativePath(String),
+    /// The library file could not be read for the digest check.
+    #[error("pdfium library unreadable: {0}")]
+    Unreadable(String),
+    /// The library's SHA-256 is not the expected one; nothing was loaded.
+    #[error("pdfium library digest mismatch (expected {expected}, found {found})")]
+    DigestMismatch { expected: String, found: String },
+    /// The expected digest is not 64 lowercase or uppercase hex characters.
+    #[error("expected sha256 must be 64 hex characters")]
+    BadDigest,
+    /// An engine was already loaded in this process.
+    #[error("a PDFium library is already loaded in this process")]
+    AlreadyLoaded,
+    /// The library could not be opened or lacks the expected entry points.
+    #[error("pdfium load failed: {0}")]
+    Load(String),
+    /// PDFium refused the document (corrupt, password needed or wrong).
+    #[error("pdfium could not open the document: {0}")]
+    Open(String),
+    /// A page index past the end of the document.
+    #[error("page index {index} out of range (document has {count} pages)")]
+    PageOutOfRange { index: usize, count: usize },
+    /// A resolution outside [`DPI_RANGE`] or not finite.
+    #[error("dpi must be within 1..=1200")]
+    BadDpi,
+    /// The rendered page would exceed [`MAX_PIXELS`].
+    #[error("page would render to {pixels} pixels, over the {max} limit")]
+    TooLarge { pixels: u64, max: u64 },
+    /// PDFium failed to read a page's text or draw it.
+    #[error("pdfium page operation failed: {0}")]
+    Page(String),
+}
+
+/// One rendered page: 8-bit RGBA, row-major, `width * height * 4` bytes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PdfiumPageImage {
+    pub width: u32,
+    pub height: u32,
+    pub rgba: Vec<u8>,
+}
+
+/// A loaded PDFium library.
+pub struct PdfiumEngine {
+    pdfium: Pdfium,
+}
+
+impl std::fmt::Debug for PdfiumEngine {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("PdfiumEngine")
+    }
+}
+
+impl PdfiumEngine {
+    /// Load the PDFium library at `library`, an absolute path to the dynamic library file.
+    /// The file is not verified here; use [`Self::load_verified`] or verify it against the
+    /// native catalog first.
+    pub fn load(library: &Path) -> Result<Self, PdfiumError> {
+        require_absolute(library)?;
+        if LOADED
+            .compare_exchange(false, true, Ordering::SeqCst, Ordering::SeqCst)
+            .is_err()
+        {
+            return Err(PdfiumError::AlreadyLoaded);
+        }
+        match Pdfium::bind_to_library(library) {
+            Ok(bindings) => Ok(Self {
+                pdfium: Pdfium::new(bindings),
+            }),
+            Err(error) => {
+                // Nothing was initialised; allow another attempt.
+                LOADED.store(false, Ordering::SeqCst);
+                Err(PdfiumError::Load(error.to_string()))
+            }
+        }
+    }
+
+    /// [`Self::load`] after checking the file's SHA-256 against `expected_sha256` (64 hex
+    /// characters, the catalog's file digest). The file is read once for the hash and opened
+    /// again by the loader, so a file replaced in between is not detected: keep the directory
+    /// private to the app.
+    pub fn load_verified(library: &Path, expected_sha256: &str) -> Result<Self, PdfiumError> {
+        require_absolute(library)?;
+        let expected = normalize_digest(expected_sha256)?;
+        let bytes =
+            std::fs::read(library).map_err(|error| PdfiumError::Unreadable(error.to_string()))?;
+        let digest: [u8; 32] = Sha256::digest(&bytes).into();
+        let found = hex(&digest);
+        if found != expected {
+            return Err(PdfiumError::DigestMismatch { expected, found });
+        }
+        drop(bytes);
+        Self::load(library)
+    }
+
+    /// Number of pages. `password` unlocks an encrypted document.
+    pub fn page_count(&self, bytes: &[u8], password: Option<&str>) -> Result<usize, PdfiumError> {
+        let document = self.open(bytes, password)?;
+        Ok(page_total(document.pages().len()))
+    }
+
+    /// Text of one page (0-based index) in PDFium's reading order. A page with no text layer
+    /// (a scan) gives an empty string.
+    pub fn page_text(
+        &self,
+        bytes: &[u8],
+        index: usize,
+        password: Option<&str>,
+    ) -> Result<String, PdfiumError> {
+        let document = self.open(bytes, password)?;
+        let count = page_total(document.pages().len());
+        let page = document
+            .pages()
+            .get(checked_index(index, count)?)
+            .map_err(page_error)?;
+        let text = page.text().map_err(page_error)?;
+        Ok(text.all())
+    }
+
+    /// Text of every page in page order (index 0 is page 1), like
+    /// [`crate::extract::extract_text_by_pages`] but through PDFium.
+    pub fn text_by_pages(
+        &self,
+        bytes: &[u8],
+        password: Option<&str>,
+    ) -> Result<Vec<String>, PdfiumError> {
+        let document = self.open(bytes, password)?;
+        let mut out = Vec::new();
+        for page in document.pages().iter() {
+            out.push(page.text().map_err(page_error)?.all());
+        }
+        Ok(out)
+    }
+
+    /// Render one page (0-based index) at `dpi` (1..=1200) to RGBA on a white background.
+    /// Refuses a page whose output would exceed [`MAX_PIXELS`] before PDFium allocates.
+    pub fn render_page(
+        &self,
+        bytes: &[u8],
+        index: usize,
+        dpi: f32,
+        password: Option<&str>,
+    ) -> Result<PdfiumPageImage, PdfiumError> {
+        check_dpi(dpi)?;
+        let document = self.open(bytes, password)?;
+        let count = page_total(document.pages().len());
+        let page = document
+            .pages()
+            .get(checked_index(index, count)?)
+            .map_err(page_error)?;
+        let scale = dpi / 72.0;
+        let (w, h) = pixel_size(page.width().value, page.height().value, scale)?;
+        let bitmap = page
+            .render_with_config(&PdfRenderConfig::new().scale_page_by_factor(scale))
+            .map_err(page_error)?;
+        let (width, height) = (bitmap.width().max(0) as u32, bitmap.height().max(0) as u32);
+        let rgba = bitmap.as_rgba_bytes();
+        if rgba.len() as u64 != u64::from(width) * u64::from(height) * 4 {
+            return Err(PdfiumError::Page(format!(
+                "unexpected bitmap size {}x{} for {} bytes (expected about {w}x{h})",
+                width,
+                height,
+                rgba.len()
+            )));
+        }
+        Ok(PdfiumPageImage {
+            width,
+            height,
+            rgba,
+        })
+    }
+
+    fn open<'a>(
+        &'a self,
+        bytes: &'a [u8],
+        password: Option<&str>,
+    ) -> Result<pdfium_render::prelude::PdfDocument<'a>, PdfiumError> {
+        self.pdfium
+            .load_pdf_from_byte_slice(bytes, password)
+            .map_err(|error: NativeError| PdfiumError::Open(error.to_string()))
+    }
+}
+
+fn page_error(error: NativeError) -> PdfiumError {
+    PdfiumError::Page(error.to_string())
+}
+
+fn page_total(raw: i32) -> usize {
+    usize::try_from(raw).unwrap_or(0)
+}
+
+fn checked_index(index: usize, count: usize) -> Result<i32, PdfiumError> {
+    if index >= count {
+        return Err(PdfiumError::PageOutOfRange { index, count });
+    }
+    i32::try_from(index).map_err(|_| PdfiumError::PageOutOfRange { index, count })
+}
+
+fn check_dpi(dpi: f32) -> Result<(), PdfiumError> {
+    if dpi.is_finite() && DPI_RANGE.contains(&dpi) {
+        Ok(())
+    } else {
+        Err(PdfiumError::BadDpi)
+    }
+}
+
+/// Output size in pixels for a page of `width_pt` x `height_pt` points at `scale`, refused over
+/// [`MAX_PIXELS`].
+fn pixel_size(width_pt: f32, height_pt: f32, scale: f32) -> Result<(u32, u32), PdfiumError> {
+    let w = (f64::from(width_pt) * f64::from(scale)).ceil().max(1.0);
+    let h = (f64::from(height_pt) * f64::from(scale)).ceil().max(1.0);
+    let pixels = if w.is_finite() && h.is_finite() {
+        (w * h) as u64
+    } else {
+        u64::MAX
+    };
+    if pixels > MAX_PIXELS || w > f64::from(i32::MAX) || h > f64::from(i32::MAX) {
+        return Err(PdfiumError::TooLarge {
+            pixels,
+            max: MAX_PIXELS,
+        });
+    }
+    Ok((w as u32, h as u32))
+}
+
+fn require_absolute(path: &Path) -> Result<(), PdfiumError> {
+    if path.is_absolute() {
+        Ok(())
+    } else {
+        Err(PdfiumError::RelativePath(path.display().to_string()))
+    }
+}
+
+fn normalize_digest(value: &str) -> Result<String, PdfiumError> {
+    if value.len() == 64 && value.bytes().all(|b| b.is_ascii_hexdigit()) {
+        Ok(value.to_ascii_lowercase())
+    } else {
+        Err(PdfiumError::BadDigest)
+    }
+}
+
+fn hex(bytes: &[u8]) -> String {
+    use std::fmt::Write;
+    bytes.iter().fold(String::with_capacity(64), |mut out, b| {
+        let _ = write!(out, "{b:02x}");
+        out
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_relative_library_path_is_refused_before_anything_loads() {
+        let error = PdfiumEngine::load(Path::new("pdfium.dll")).unwrap_err();
+        assert!(matches!(error, PdfiumError::RelativePath(_)));
+        // The refusal did not consume the one-engine slot.
+        assert!(!LOADED.load(Ordering::SeqCst));
+    }
+
+    #[test]
+    fn the_digest_is_checked_before_the_loader_runs() {
+        let dir = std::env::temp_dir().join(format!("rk-pdfium-digest-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let file = dir.join("not-a-library.bin");
+        std::fs::write(&file, b"not pdfium").unwrap();
+        let wrong = "0".repeat(64);
+        let error = PdfiumEngine::load_verified(&file, &wrong).unwrap_err();
+        assert!(matches!(error, PdfiumError::DigestMismatch { .. }), "{error}");
+        assert!(matches!(
+            PdfiumEngine::load_verified(&file, "xyz").unwrap_err(),
+            PdfiumError::BadDigest
+        ));
+        // A matching digest on a file that is not a library fails in the loader, not before.
+        let digest: [u8; 32] = Sha256::digest(b"not pdfium").into();
+        let right = hex(&digest);
+        let error = PdfiumEngine::load_verified(&file, &right.to_ascii_uppercase()).unwrap_err();
+        assert!(matches!(error, PdfiumError::Load(_)), "{error}");
+        assert!(!LOADED.load(Ordering::SeqCst), "a failed load frees the slot");
+        std::fs::remove_dir_all(&dir).ok();
+    }
+
+    #[test]
+    fn dpi_and_page_index_limits() {
+        for bad in [0.0, 0.5, 1201.0, f32::NAN, f32::INFINITY] {
+            assert!(matches!(check_dpi(bad), Err(PdfiumError::BadDpi)), "{bad}");
+        }
+        assert!(check_dpi(300.0).is_ok());
+        assert_eq!(checked_index(2, 3).unwrap(), 2);
+        assert!(matches!(
+            checked_index(3, 3),
+            Err(PdfiumError::PageOutOfRange { index: 3, count: 3 })
+        ));
+    }
+
+    #[test]
+    fn pixel_size_is_computed_and_capped_before_rendering() {
+        // US Letter at 300 dpi.
+        assert_eq!(pixel_size(612.0, 792.0, 300.0 / 72.0).unwrap(), (2550, 3300));
+        // A 200 inch page at 1200 dpi is refused, not allocated.
+        let error = pixel_size(14_400.0, 14_400.0, 1200.0 / 72.0).unwrap_err();
+        assert!(matches!(error, PdfiumError::TooLarge { .. }));
+    }
+}

+
+impl std::error::Error for DeveloperOverrideIgnored {}
+
+/// Like [`developer_override_candidate`] but never silent: without the `dev-overrides`
+/// feature, a set non-empty variable is reported as `Err(DeveloperOverrideIgnored)` so an app
+/// can tell the user why its override had no effect. Unset or empty values are `Ok(None)`.
+pub fn developer_override_candidate_checked(
+    env_name: &str,
+) -> Result<Option<RuntimeCandidate>, DeveloperOverrideIgnored> {
+    checked_override(
+        cfg!(feature = "dev-overrides"),
+        env_name,
+        nonempty_env_path(env_name),
+    )
+}
+
+fn checked_override(
+    enabled: bool,
+    env_name: &str,
+    value: Option<PathBuf>,
+) -> Result<Option<RuntimeCandidate>, DeveloperOverrideIgnored> {
+    match (enabled, value) {
+        (true, Some(path)) => Ok(Some(RuntimeCandidate::new(path, CandidateSource::Explicit))),
+        (false, Some(_)) => Err(DeveloperOverrideIgnored {
+            env_name: env_name.to_owned(),
+        }),
+        (_, None) => Ok(None),
+    }

+pub(crate) fn normalize_insecure_host(host: &str) -> Result<String, OAuthError> {
+    let invalid = || {
+        OAuthError::InvalidConfig(
+            "insecure host must be an exact hostname, IPv4 address or [IPv6] address with no scheme, port, path or wildcard"

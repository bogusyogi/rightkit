+/// Why a checked UIA property read failed (see [`El::try_pid`]): the element is gone, or UIA
+/// returned some other error.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum UiaError {
+    /// `UIA_E_ELEMENTNOTAVAILABLE`: the element no longer exists (its window or control closed).
+    ElementNotAvailable,
+    /// `UIA_E_ELEMENTNOTENABLED`: the element exists but is disabled.
+    ElementNotEnabled,
+    /// Any other failure; carries the raw `HRESULT`.
+    Failed(i32),
+}
+
+impl UiaError {
+    /// Map a raw `HRESULT` to the variant it names.
+    pub fn from_hresult(code: i32) -> UiaError {
+        match code as u32 {
+            0x8004_0201 => UiaError::ElementNotAvailable,
+            0x8004_0200 => UiaError::ElementNotEnabled,
+            _ => UiaError::Failed(code),
+        }
+    }
+}
+
+impl std::fmt::Display for UiaError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            UiaError::ElementNotAvailable => f.write_str("UIA element not available"),
+            UiaError::ElementNotEnabled => f.write_str("UIA element not enabled"),
+            UiaError::Failed(c) => write!(f, "UIA call failed (HRESULT {:#010x})", *c as u32),
+        }
+    }
+}
+
+impl std::error::Error for UiaError {}
+
+fn uia_err(e: windows::core::Error) -> UiaError {
+    UiaError::from_hresult(e.code().0)
+}

+++ b/crates/rightkit-automation/src/win/ime.rs
@@ -0,0 +1,174 @@
+//! IME composition and candidate-window probes (window-targeted, no global `SendInput`).
+//!
+//! * [`compose`], [`commit`] and [`cancel`] drive the input method context of a window with the
+//!   IMM32 API (`ImmSetCompositionStringW`, `ImmNotifyIME`). The Windows input-method API only
+//!   serves windows of the **calling process**: a window of another process has no input context
+//!   this process can reach, and these functions then return `Error::Unsupported`. They are for
+//!   tests and drivers that run inside (or host) the app under test. Applications that use only
+//!   the newer Text Services Framework without the IMM compatibility layer may ignore them.
+//! * [`candidate_rect`] finds the on-screen rectangle of the IME candidate list window by
+//!   scanning top-level windows, which works across processes.
+//!
+//! Win32 offers no setter for the caret position inside a composition string, so `compose` takes
+//! no cursor argument: the IME places the cursor at the end of the text it was given.
+
+use super::sys;
+use crate::model::*;
+use windows::Win32::Foundation::HWND;
+use windows::Win32::System::Threading::GetCurrentProcessId;
+use windows::Win32::UI::Input::Ime::*;
+use windows::Win32::UI::WindowsAndMessaging::{
+    GetClassNameW, GetWindowThreadProcessId, IsWindow, IsWindowVisible,
+};
+
+fn handle(hwnd: u64) -> HWND {
+    HWND(hwnd as isize as *mut _)
+}
+
+/// Releases an input context obtained from `ImmGetContext` when dropped.
+struct Context {
+    hwnd: HWND,
+    himc: HIMC,
+}
+
+impl Context {
+    fn of(hwnd: u64) -> Result<Context> {
+        if hwnd == 0 || !unsafe { IsWindow(Some(handle(hwnd))) }.as_bool() {
+            return Err(Error::NotFound(format!("IME window {hwnd}")));
+        }
+        let h = handle(hwnd);
+        let mut pid = 0u32;
+        unsafe { GetWindowThreadProcessId(h, Some(&mut pid)) };
+        if pid != unsafe { GetCurrentProcessId() } {
+            return Err(Error::Unsupported(
+                "IME input context is only reachable for windows of the calling process",
+            ));
+        }
+        let himc = unsafe { ImmGetContext(h) };
+        if himc.is_invalid() {
+            return Err(Error::Unsupported("window has no IME input context"));
+        }
+        Ok(Context { hwnd: h, himc })
+    }
+}
+
+impl Drop for Context {
+    fn drop(&mut self) {
+        let _ = unsafe { ImmReleaseContext(self.hwnd, self.himc) };
+    }
+}
+
+/// Set the composition (pre-edit) string of the window `hwnd` to `text`, as the user would see
+/// while typing with an IME. The IME must be open on the window. Returns
+/// `Error::Platform` when the IME refuses the string, `Error::Unsupported` for a window of
+/// another process, `Error::Invalid` for an empty `text` (use [`cancel`] to clear).
+pub fn compose(hwnd: u64, text: &str) -> Result<()> {
+    if text.is_empty() {
+        return Err(Error::Invalid("empty composition string".into()));
+    }
+    let ctx = Context::of(hwnd)?;
+    let units: Vec<u16> = text.encode_utf16().collect();
+    let bytes = (units.len() * 2) as u32;
+    let ok = unsafe {
+        ImmSetCompositionStringW(
+            ctx.himc,
+            SCS_SETSTR,
+            Some(units.as_ptr() as *const core::ffi::c_void),
+            bytes,
+            None,
+            0,
+        )
+    };
+    if ok.as_bool() {
+        Ok(())
+    } else {
+        Err(Error::Platform(0, "ImmSetCompositionStringW"))
+    }
+}
+
+/// Commit the current composition of `hwnd` (`CPS_COMPLETE`): the composition string is inserted
+/// into the text field as final text.
+pub fn commit(hwnd: u64) -> Result<()> {
+    notify(hwnd, CPS_COMPLETE)
+}
+
+/// Cancel the current composition of `hwnd` (`CPS_CANCEL`): the composition string is discarded.
+pub fn cancel(hwnd: u64) -> Result<()> {
+    notify(hwnd, CPS_CANCEL)
+}
+
+fn notify(hwnd: u64, index: NOTIFY_IME_INDEX) -> Result<()> {
+    let ctx = Context::of(hwnd)?;
+    let ok = unsafe { ImmNotifyIME(ctx.himc, NI_COMPOSITIONSTR, index, 0) };
+    if ok.as_bool() {
+        Ok(())
+    } else {
+        Err(Error::Platform(0, "ImmNotifyIME"))
+    }
+}
+
+/// Whether a window class name is an IME candidate list window. Heuristic: the class contains
+/// `CandidateWindow` or `CandidateUI` (the Microsoft IME hosts use
+/// `Microsoft.IME.UIManager.CandidateWindow.Host`; legacy IMEs use `...CandidateUI...` names).
+pub(crate) fn is_candidate_class(class: &str) -> bool {
+    let lower = class.to_ascii_lowercase();
+    lower.contains("candidatewindow") || lower.contains("candidateui")
+}
+
+/// The screen rectangle (physical pixels) of the visible IME candidate list window, or `None`
+/// when no candidate window is showing or its class is not recognised. `hwnd` is the window being
+/// typed into; a dead window gives `None`. Scans top-level windows of every process, so it
+/// works for any app. Heuristic by window class (see `is_candidate_class`): an input method with
+/// an unrecognised candidate window class is not found.
+pub fn candidate_rect(hwnd: u64) -> Option<Rect> {
+    if hwnd == 0 || !unsafe { IsWindow(Some(handle(hwnd))) }.as_bool() {
+        return None;
+    }
+    for h in sys::all_top_level() {
+        if !unsafe { IsWindowVisible(h) }.as_bool() {
+            continue;
+        }
+        let mut buf = [0u16; 256];
+        let n = unsafe { GetClassNameW(h, &mut buf) };
+        if n <= 0 {
+            continue;
+        }
+        let class = String::from_utf16_lossy(&buf[..n as usize]);
+        if is_candidate_class(&class) {
+            if let Some(r) = sys::window_rect(h) {
+                return Some(r);
+            }
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn candidate_class_names_are_recognised() {
+        assert!(is_candidate_class(
+            "Microsoft.IME.UIManager.CandidateWindow.Host"
+        ));
+        assert!(is_candidate_class("CandidateUI"));
+        assert!(is_candidate_class("MSCTFIME CandidateUI Window"));
+        assert!(!is_candidate_class("IME"));
+        assert!(!is_candidate_class("Chrome_WidgetWin_1"));
+        assert!(!is_candidate_class(""));
+    }
+
+    #[test]
+    fn dead_windows_are_refused_without_touching_imm() {
+        assert!(matches!(compose(0, "x"), Err(Error::NotFound(_))));
+        assert!(matches!(commit(0), Err(Error::NotFound(_))));
+        assert!(matches!(cancel(0), Err(Error::NotFound(_))));
+        assert_eq!(candidate_rect(0), None);
+    }
+
+    #[test]
+    fn empty_composition_is_invalid() {
+        assert!(matches!(compose(0, ""), Err(Error::Invalid(_))));
+    }
+}

+    /// with a pid of 0 (no owning process); `Err(UiaError::ElementNotAvailable)` means the element
+    /// is gone.
+    pub fn try_pid(&self) -> std::result::Result<Option<u32>, UiaError> {
+        let p = unsafe { self.0.CurrentProcessId() }.map_err(uia_err)?;
+        Ok(u32::try_from(p).ok().filter(|p| *p != 0))
+    }
+
+    /// The element's own native window handle: `Ok(None)` when the element has none (a lightweight
+    /// control), `Err` when UIA could not answer (for example [`UiaError::ElementNotAvailable`]).
+    pub fn try_native_hwnd(&self) -> std::result::Result<Option<isize>, UiaError> {
+        let h = unsafe { self.0.CurrentNativeWindowHandle() }.map_err(uia_err)?;
+        Ok((!h.0.is_null()).then_some(h.0 as isize))
+    }
+
+    /// The UIA control type id (`UIA_*ControlTypeId`, 50000 and up), or the reason it could not be
+    /// read. Cheaper than [`read_node`], which reads every property.
+    pub fn try_control_type(&self) -> std::result::Result<i32, UiaError> {
+        unsafe { self.0.CurrentControlType() }
+            .map(|c| c.0)
+            .map_err(uia_err)
+    }
+
+    /// [`Self::try_control_type`] as an `Option`.
+    pub fn control_type(&self) -> Option<i32> {
+        self.try_control_type().ok()
+    }
+
+    /// The control type name without the `UIA_` prefix (`"Edit"`, `"Document"`, `"Hyperlink"`), or
+    /// `None` when the type cannot be read. Unknown ids give `"Unknown"`.
+    pub fn control_type_name(&self) -> Option<&'static str> {
+        self.control_type().map(control_name)
+    }
+
+    /// The UIA `FrameworkId` (`"Win32"`, `"WPF"`, `"XAML"`, `"Chrome"`, ...). `None` when the
+    /// provider reports none or it cannot be read.
+    pub fn framework_id(&self) -> Option<String> {
+        s(unsafe { self.0.CurrentFrameworkId() })
+    }
+
+    /// Whether the element supports `TextEditPattern` (what Chromium contenteditable composers
+    /// expose). `Some(false)` is a positive answer; `None` when UIA cannot answer.
+    pub fn supports_text_edit(&self) -> Option<bool> {
+        let v = unsafe {
+            self.0
+                .GetCurrentPropertyValue(UIA_IsTextEditPatternAvailablePropertyId)
+        }
+        .ok()?;
+        // SAFETY: `vt` selects the active union member; a boolean property is VT_BOOL.
+        let inner = unsafe { &*v.Anonymous.Anonymous };
+        (inner.vt == VT_BOOL).then(|| unsafe { inner.Anonymous.boolVal }.0 != 0)
+    }
+}

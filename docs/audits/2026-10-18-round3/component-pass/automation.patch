index 0000000..f6c0ded
--- /dev/null
+++ b/crates/rightkit-automation/src/win/clipboard.rs
@@ -0,0 +1,501 @@
+//! Clipboard change listener and raw per-format reads.
+//!
+//! [`ClipboardListener`] runs a hidden message-only window on its own thread and registers it
+//! with `AddClipboardFormatListener`, so the caller is told the moment the clipboard changes
+//! instead of polling the sequence number (`WinPlatform::clip_change`). [`read_raw`] returns the
+//! bytes of every (or selected) clipboard format, not just Unicode text, with explicit size
+//! limits so a huge image or file list cannot exhaust memory.
+//!
+//! Neither function applies a policy: clipboard content can hold secrets, so the caller decides
+//! what may be read, kept or logged. Reading never changes the clipboard.
+//!
+//! Limits to know:
+//! * Formats that hold a GDI handle (`CF_BITMAP`, `CF_PALETTE`, `CF_METAFILEPICT`,
+//!   `CF_ENHMETAFILE`) are reported as [`FormatData::Handle`] with no bytes. Read the
+//!   `CF_DIB` / `CF_DIBV5` rendering of an image instead; Windows synthesises it.
+//! * A format advertised by delayed rendering is rendered by its owner when read. An unresponsive
+//!   owner can block [`read_raw`]; do not call it on a thread that must not stall.
+//! * Byte lengths are the size of the global memory block, which can exceed the logical payload
+//!   by a few bytes; text formats are NUL terminated.
+
+use crate::model::*;
+use std::sync::mpsc;
+use std::thread::JoinHandle;
+use windows::core::PCWSTR;
+use windows::Win32::Foundation::{HGLOBAL, HINSTANCE, HWND, LPARAM, LRESULT, WPARAM};
+use windows::Win32::System::DataExchange::*;
+use windows::Win32::System::LibraryLoader::GetModuleHandleW;
+use windows::Win32::System::Memory::{GlobalLock, GlobalSize, GlobalUnlock};
+use windows::Win32::UI::WindowsAndMessaging::*;
+
+/// One clipboard format: its id and a name (a standard `CF_*` name, the registered name, or
+/// `CF_<id>` when neither is known).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ClipboardFormat {
+    pub id: u32,
+    pub name: String,
+}
+
+/// What reading one format produced.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum FormatData {
+    /// The bytes of the format's global memory block.
+    Bytes(Vec<u8>),
+    /// The block is larger than the per-format limit; `size` is its size in bytes. Nothing read.
+    TooLarge { size: usize },
+    /// A GDI-handle format that has no byte payload (see the module docs).
+    Handle,
+    /// The format was advertised but its data could not be fetched or locked.
+    Unreadable,
+}
+
+/// One format and what reading it produced.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ClipboardData {
+    pub format: ClipboardFormat,
+    pub data: FormatData,
+}
+
+/// A raw read of the clipboard: the sequence number it was read at and every format asked for.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RawClipboard {
+    /// `GetClipboardSequenceNumber` at read time. If it differs from the number seen by the
+    /// listener, the clipboard changed again before the read finished.
+    pub sequence: u32,
+    pub items: Vec<ClipboardData>,
+}
+
+impl RawClipboard {
+    /// The bytes of format `id`, if it was read.
+    pub fn bytes(&self, id: u32) -> Option<&[u8]> {
+        self.items.iter().find_map(|i| match &i.data {
+            FormatData::Bytes(b) if i.format.id == id => Some(b.as_slice()),
+            _ => None,
+        })
+    }
+}
+
+/// Limits for [`read_raw`].
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReadLimits {
+    /// Largest single format to read, in bytes. Larger ones come back as
+    /// [`FormatData::TooLarge`].
+    pub max_format_bytes: usize,
+    /// Total bytes to read across all formats; once reached, later formats come back as
+    /// [`FormatData::TooLarge`].
+    pub max_total_bytes: usize,
+    /// Read only these format ids (in clipboard order). `None` reads every format.
+    pub only: Option<Vec<u32>>,
+}
+
+impl Default for ReadLimits {
+    /// 16 MiB per format, 64 MiB in total, every format.
+    fn default() -> Self {
+        ReadLimits {
+            max_format_bytes: 16 * 1024 * 1024,
+            max_total_bytes: 64 * 1024 * 1024,
+            only: None,
+        }
+    }
+}
+
+/// Standard format ids.
+pub mod cf {
+    pub const TEXT: u32 = 1;
+    pub const BITMAP: u32 = 2;
+    pub const METAFILEPICT: u32 = 3;
+    pub const SYLK: u32 = 4;
+    pub const DIF: u32 = 5;
+    pub const TIFF: u32 = 6;
+    pub const OEMTEXT: u32 = 7;
+    pub const DIB: u32 = 8;
+    pub const PALETTE: u32 = 9;
+    pub const PENDATA: u32 = 10;
+    pub const RIFF: u32 = 11;
+    pub const WAVE: u32 = 12;
+    pub const UNICODETEXT: u32 = 13;
+    pub const ENHMETAFILE: u32 = 14;
+    pub const HDROP: u32 = 15;
+    pub const LOCALE: u32 = 16;
+    pub const DIBV5: u32 = 17;
+}
+
+/// The name of a predefined clipboard format id, or `None` for a registered or private id.
+pub fn standard_format_name(id: u32) -> Option<&'static str> {
+    Some(match id {
+        cf::TEXT => "CF_TEXT",
+        cf::BITMAP => "CF_BITMAP",
+        cf::METAFILEPICT => "CF_METAFILEPICT",
+        cf::SYLK => "CF_SYLK",
+        cf::DIF => "CF_DIF",
+        cf::TIFF => "CF_TIFF",
+        cf::OEMTEXT => "CF_OEMTEXT",
+        cf::DIB => "CF_DIB",
+        cf::PALETTE => "CF_PALETTE",
+        cf::PENDATA => "CF_PENDATA",
+        cf::RIFF => "CF_RIFF",
+        cf::WAVE => "CF_WAVE",
+        cf::UNICODETEXT => "CF_UNICODETEXT",
+        cf::ENHMETAFILE => "CF_ENHMETAFILE",
+        cf::HDROP => "CF_HDROP",
+        cf::LOCALE => "CF_LOCALE",
+        cf::DIBV5 => "CF_DIBV5",
+        0x0080 => "CF_OWNERDISPLAY",
+        0x0081 => "CF_DSPTEXT",
+        0x0082 => "CF_DSPBITMAP",
+        0x0083 => "CF_DSPMETAFILEPICT",
+        0x008E => "CF_DSPENHMETAFILE",
+        _ => return None,
+    })
+}
+
+/// Whether the format's clipboard handle is a GDI object, not global memory.
+pub fn is_handle_format(id: u32) -> bool {
+    matches!(
+        id,
+        cf::BITMAP | cf::METAFILEPICT | cf::PALETTE | cf::ENHMETAFILE | 0x0082 | 0x0083 | 0x008E
+    )
+}
+
+fn format_name(id: u32) -> String {
+    if let Some(n) = standard_format_name(id) {
+        return n.to_string();
+    }
+    let mut buf = [0u16; 256];
+    let n = unsafe { GetClipboardFormatNameW(id, &mut buf) };
+    if n > 0 {
+        return String::from_utf16_lossy(&buf[..n as usize]);
+    }
+    format!("CF_{id}")
+}
+
+struct Open;
+
+impl Open {
+    fn new() -> Result<Open> {
+        // The clipboard can be held briefly by another process: retry a few times.
+        for _ in 0..20 {
+            if unsafe { OpenClipboard(None) }.is_ok() {
+                return Ok(Open);
+            }
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        }
+        Err(Error::Platform(0, "OpenClipboard (clipboard busy)"))
+    }
+}
+
+impl Drop for Open {
+    fn drop(&mut self) {
+        let _ = unsafe { CloseClipboard() };
+    }
+}
+
+fn enumerate_open() -> Vec<ClipboardFormat> {
+    let mut out = vec![];
+    let mut f = 0u32;
+    loop {
+        f = unsafe { EnumClipboardFormats(f) };
+        if f == 0 {
+            break;
+        }
+        out.push(ClipboardFormat {
+            id: f,
+            name: format_name(f),
+        });
+    }
+    out
+}
+
+/// The formats currently on the clipboard, in clipboard order (the owner's priority order).
+pub fn list_formats() -> Result<Vec<ClipboardFormat>> {
+    let _open = Open::new()?;
+    Ok(enumerate_open())
+}
+
+/// Decide what to do with a block of `size` bytes given the limits and the bytes already read.
+/// Pure, so the limit rules are unit tested.
+pub(crate) fn admit(size: usize, read_so_far: usize, limits: &ReadLimits) -> bool {
+    size <= limits.max_format_bytes && read_so_far.saturating_add(size) <= limits.max_total_bytes
+}
+
+fn read_one(id: u32, read_so_far: usize, limits: &ReadLimits) -> FormatData {
+    if is_handle_format(id) {
+        return FormatData::Handle;
+    }
+    unsafe {
+        let Ok(h) = GetClipboardData(id) else {
+            return FormatData::Unreadable;
+        };
+        let g = HGLOBAL(h.0);
+        let size = GlobalSize(g);
+        if !admit(size, read_so_far, limits) {
+            return FormatData::TooLarge { size };
+        }
+        let p = GlobalLock(g) as *const u8;
+        if p.is_null() {
+            return FormatData::Unreadable;
+        }
+        let bytes = std::slice::from_raw_parts(p, size).to_vec();
+        let _ = GlobalUnlock(g);
+        FormatData::Bytes(bytes)
+    }
+}
+
+/// Read the clipboard's formats as raw bytes (see the module docs for limits). An empty
+/// clipboard gives an empty `items`. Fails only when the clipboard cannot be opened.
+pub fn read_raw(limits: &ReadLimits) -> Result<RawClipboard> {
+    let _open = Open::new()?;
+    let sequence = unsafe { GetClipboardSequenceNumber() };
+    let mut items = vec![];
+    let mut read = 0usize;
+    for format in enumerate_open() {
+        if let Some(only) = &limits.only {
+            if !only.contains(&format.id) {
+                continue;
+            }
+        }
+        let data = read_one(format.id, read, limits);
+        if let FormatData::Bytes(b) = &data {
+            read += b.len();
+        }
+        items.push(ClipboardData { format, data });
+    }
+    Ok(RawClipboard { sequence, items })
+}
+
+/// One clipboard change reported by [`ClipboardListener`].
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ClipboardChange {
+    /// `GetClipboardSequenceNumber` when the change was seen.
+    pub sequence: u32,
+    /// The formats on the clipboard, best effort: empty when the clipboard was busy. Use
+    /// [`read_raw`] to get the bytes.
+    pub formats: Vec<ClipboardFormat>,
+}
+
+type Callback = Box<dyn FnMut(ClipboardChange) + Send>;
+
+thread_local! {
+    static CALLBACK: std::cell::RefCell<Option<Callback>> = const { std::cell::RefCell::new(None) };
+}
+
+const CLASS_NAME: &str = "RightKitClipboardListener";
+
+fn wide(s: &str) -> Vec<u16> {
+    s.encode_utf16().chain(std::iter::once(0)).collect()
+}
+
+unsafe extern "system" fn wndproc(hwnd: HWND, msg: u32, wp: WPARAM, lp: LPARAM) -> LRESULT {
+    match msg {
+        WM_CLIPBOARDUPDATE => {
+            let sequence = unsafe { GetClipboardSequenceNumber() };
+            let formats = list_formats().unwrap_or_default();
+            // Take the callback out while it runs so a re-entrant message cannot alias it.
+            if let Some(mut cb) = CALLBACK.with(|c| c.borrow_mut().take()) {
+                let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    cb(ClipboardChange { sequence, formats })
+                }));
+                CALLBACK.with(|c| *c.borrow_mut() = Some(cb));
+            }
+            LRESULT(0)
+        }
+        WM_DESTROY => {
+            let _ = unsafe { RemoveClipboardFormatListener(hwnd) };
+            unsafe { PostQuitMessage(0) };
+            LRESULT(0)
+        }
+        _ => unsafe { DefWindowProcW(hwnd, msg, wp, lp) },
+    }
+}
+
+/// A running clipboard change listener. Dropping it (or calling [`Self::stop`]) removes the
+/// listener and joins the thread. The callback runs on the listener's own thread, one change at a
+/// time; keep it short, and do the slow work (reading, hashing, storing) elsewhere.
+pub struct ClipboardListener {
+    hwnd: isize,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl ClipboardListener {
+    /// Start listening. `on_change` is called once per `WM_CLIPBOARDUPDATE`, which Windows sends
+    /// for every clipboard change including ones this process makes itself. A panic in the
+    /// callback is caught and ignored. Errors with `Error::Platform` when the window or the
+    /// listener registration fails.
+    pub fn start<F>(on_change: F) -> Result<ClipboardListener>
+    where
+        F: FnMut(ClipboardChange) + Send + 'static,
+    {
+        let (tx, rx) = mpsc::channel::<std::result::Result<isize, Error>>();
+        let thread = std::thread::Builder::new()
+            .name("rightkit-clipboard-listener".into())
+            .spawn(move || run(Box::new(on_change), tx))
+            .map_err(|_| Error::Platform(0, "spawn clipboard listener thread"))?;
+        match rx.recv() {
+            Ok(Ok(hwnd)) => Ok(ClipboardListener {
+                hwnd,
+                thread: Some(thread),
+            }),
+            Ok(Err(e)) => {
+                let _ = thread.join();
+                Err(e)
+            }
+            Err(_) => {
+                let _ = thread.join();
+                Err(Error::Platform(0, "clipboard listener thread exited"))
+            }
+        }
+    }
+
+    /// Stop listening and wait for the thread to end.
+    pub fn stop(mut self) {
+        self.shutdown();
+    }
+
+    fn shutdown(&mut self) {
+        if let Some(t) = self.thread.take() {
+            // WM_CLOSE -> DefWindowProc -> DestroyWindow -> WM_DESTROY (listener removed, quit).
+            let _ = unsafe {
+                PostMessageW(
+                    Some(HWND(self.hwnd as *mut _)),
+                    WM_CLOSE,
+                    WPARAM(0),
+                    LPARAM(0),
+                )
+            };
+            let _ = t.join();
+        }
+    }
+}
+
+impl Drop for ClipboardListener {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+fn run(cb: Callback, ready: mpsc::Sender<std::result::Result<isize, Error>>) {
+    unsafe {
+        let hmodule = GetModuleHandleW(PCWSTR::null()).ok();
+        let hinstance = hmodule.map(|m| HINSTANCE(m.0)).unwrap_or_default();
+        let class = wide(CLASS_NAME);
+        let wc = WNDCLASSW {
+            lpfnWndProc: Some(wndproc),
+            hInstance: hinstance,
+            lpszClassName: PCWSTR(class.as_ptr()),
+            ..Default::default()
+        };
+        // Fails with ERROR_CLASS_ALREADY_EXISTS on a second listener; the class is then usable.
+        RegisterClassW(&wc);
+        let hwnd = match CreateWindowExW(
+            WINDOW_EX_STYLE::default(),
+            PCWSTR(class.as_ptr()),
+            PCWSTR::null(),
+            WINDOW_STYLE::default(),
+            0,
+            0,
+            0,
+            0,
+            Some(HWND_MESSAGE),
+            None,
+            Some(hinstance),
+            None,
+        ) {
+            Ok(h) => h,
+            Err(e) => {
+                let _ = ready.send(Err(Error::Platform(
+                    i64::from(e.code().0),
+                    "CreateWindowEx (clipboard listener)",
+                )));
+                return;
+            }
+        };
+        CALLBACK.with(|c| *c.borrow_mut() = Some(cb));
+        if let Err(e) = AddClipboardFormatListener(hwnd) {
+            let _ = DestroyWindow(hwnd);
+            let _ = ready.send(Err(Error::Platform(
+                i64::from(e.code().0),
+                "AddClipboardFormatListener",
+            )));
+            return;
+        }
+        let _ = ready.send(Ok(hwnd.0 as isize));
+        let mut msg = MSG::default();
+        while GetMessageW(&mut msg, None, 0, 0).0 > 0 {
+            let _ = TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+        CALLBACK.with(|c| *c.borrow_mut() = None);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn standard_names_cover_the_predefined_formats() {
+        assert_eq!(standard_format_name(cf::UNICODETEXT), Some("CF_UNICODETEXT"));
+        assert_eq!(standard_format_name(cf::HDROP), Some("CF_HDROP"));
+        assert_eq!(standard_format_name(cf::DIBV5), Some("CF_DIBV5"));
+        assert_eq!(standard_format_name(0xC0FE), None);
+        assert_eq!(standard_format_name(0), None);
+    }
+
+    #[test]
+    fn handle_formats_are_not_read_as_bytes() {
+        for id in [cf::BITMAP, cf::PALETTE, cf::METAFILEPICT, cf::ENHMETAFILE] {
+            assert!(is_handle_format(id), "{id}");
+        }
+        for id in [cf::TEXT, cf::UNICODETEXT, cf::DIB, cf::HDROP, 0xC123] {
+            assert!(!is_handle_format(id), "{id}");
+        }
+    }
+
+    #[test]
+    fn limits_apply_per_format_and_in_total() {
+        let l = ReadLimits {
+            max_format_bytes: 100,
+            max_total_bytes: 150,
+            only: None,
+        };
+        assert!(admit(100, 0, &l));
+        assert!(!admit(101, 0, &l));
+        assert!(admit(50, 100, &l));
+        assert!(!admit(51, 100, &l));
+        assert!(admit(0, 150, &l));
+    }
+
+    #[test]
+    fn default_limits_are_bounded() {
+        let l = ReadLimits::default();
+        assert_eq!(l.max_format_bytes, 16 * 1024 * 1024);
+        assert_eq!(l.max_total_bytes, 64 * 1024 * 1024);
+        assert!(l.only.is_none());
+    }
+
+    #[test]
+    fn raw_clipboard_bytes_finds_only_read_formats() {
+        let raw = RawClipboard {
+            sequence: 7,
+            items: vec![
+                ClipboardData {
+                    format: ClipboardFormat {
+                        id: cf::UNICODETEXT,
+                        name: "CF_UNICODETEXT".into(),
+                    },
+                    data: FormatData::Bytes(vec![104, 0, 0, 0]),
+                },
+                ClipboardData {
+                    format: ClipboardFormat {
+                        id: cf::DIB,
+                        name: "CF_DIB".into(),
+                    },
+                    data: FormatData::TooLarge { size: 99 },
+                },
+            ],
+        };
+        assert_eq!(raw.bytes(cf::UNICODETEXT), Some(&[104u8, 0, 0, 0][..]));
+        assert_eq!(raw.bytes(cf::DIB), None);
+        assert_eq!(raw.bytes(cf::HDROP), None);
+    }
+}

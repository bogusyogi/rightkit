index 0000000..eabc721
--- /dev/null
+++ b/crates/rightkit-automation/src/win/dropfiles.rs
@@ -0,0 +1,201 @@
+//! Window-targeted file drop: hand a list of files to a window that accepts `WM_DROPFILES`, as
+//! if the user had dropped them from Explorer (tier 3: a posted message, no cursor, focus or
+//! `SendInput`).
+//!
+//! Only windows that opted in with `DragAcceptFiles` (extended style `WS_EX_ACCEPTFILES`) take
+//! this path; [`accepts_files`] tells. Windows that take drops through OLE (`IDropTarget`:
+//! browsers, Electron, WPF, most modern UI) do not receive `WM_DROPFILES` and are refused with
+//! `Error::Unsupported`. A target running at a higher integrity level ignores the message unless
+//! it allowed it with `ChangeWindowMessageFilterEx` (UIPI), and the post then reports success
+//! while nothing happens.
+//!
+//! Memory: the `DROPFILES` block is allocated here and ownership passes to the target, which
+//! frees it with `DragFinish`. It is freed here when the post fails.
+
+use crate::model::*;
+use windows::Win32::Foundation::{GlobalFree, HGLOBAL, HWND, LPARAM, WPARAM};
+use windows::Win32::System::Memory::{GlobalAlloc, GlobalLock, GlobalUnlock, GMEM_MOVEABLE};
+use windows::Win32::UI::WindowsAndMessaging::{
+    GetWindowLongW, IsWindow, PostMessageW, GWL_EXSTYLE, WM_DROPFILES, WS_EX_ACCEPTFILES,
+};
+
+/// Most files one drop may carry; a larger list is refused.
+pub const MAX_DROP_FILES: usize = 4096;
+
+/// Size of the `DROPFILES` header (`pFiles`, `pt.x`, `pt.y`, `fNC`, `fWide`).
+const HEADER: usize = 20;
+
+fn handle(hwnd: u64) -> HWND {
+    HWND(hwnd as isize as *mut _)
+}
+
+/// Whether the window `hwnd` exists and accepts `WM_DROPFILES` (`WS_EX_ACCEPTFILES`).
+pub fn accepts_files(hwnd: u64) -> bool {
+    if hwnd == 0 {
+        return false;
+    }
+    let h = handle(hwnd);
+    unsafe {
+        IsWindow(Some(h)).as_bool()
+            && (GetWindowLongW(h, GWL_EXSTYLE) as u32 & WS_EX_ACCEPTFILES.0) != 0
+    }
+}
+
+/// Build the `DROPFILES` block for `paths`: header, then each path as a NUL-terminated UTF-16
+/// string, then a final NUL. `(x, y)` is the drop point in the target's client coordinates, or
+/// screen coordinates when `non_client` is true (`fNC`).
+pub(crate) fn build_dropfiles(paths: &[String], x: i32, y: i32, non_client: bool) -> Vec<u8> {
+    let body: usize = paths.iter().map(|p| p.len() * 2 + 2).sum();
+    let mut out = Vec::with_capacity(HEADER + body + 2);
+    out.extend_from_slice(&(HEADER as u32).to_le_bytes());
+    out.extend_from_slice(&x.to_le_bytes());
+    out.extend_from_slice(&y.to_le_bytes());
+    out.extend_from_slice(&i32::from(non_client).to_le_bytes());
+    out.extend_from_slice(&1i32.to_le_bytes()); // fWide: UTF-16 paths
+    for p in paths {
+        for u in p.encode_utf16() {
+            out.extend_from_slice(&u.to_le_bytes());
+        }
+        out.extend_from_slice(&0u16.to_le_bytes());
+    }
+    out.extend_from_slice(&0u16.to_le_bytes());
+    out
+}
+
+/// Validate the paths a drop may carry: at least one, at most [`MAX_DROP_FILES`], absolute, valid
+/// Unicode, no embedded NUL. Returns them as strings in order.
+pub(crate) fn check_paths(paths: &[&std::path::Path]) -> Result<Vec<String>> {
+    if paths.is_empty() {
+        return Err(Error::Invalid("no files to drop".into()));
+    }
+    if paths.len() > MAX_DROP_FILES {
+        return Err(Error::Invalid(format!(
+            "more than {MAX_DROP_FILES} files in one drop"
+        )));
+    }
+    let mut out = Vec::with_capacity(paths.len());
+    for p in paths {
+        if !p.is_absolute() {
+            return Err(Error::Invalid(format!(
+                "drop path must be absolute: {}",
+                p.display()
+            )));
+        }
+        let s = p
+            .to_str()
+            .ok_or_else(|| Error::Invalid("drop path is not valid Unicode".into()))?;
+        if s.contains('\0') {
+            return Err(Error::Invalid("drop path contains NUL".into()));
+        }
+        out.push(s.to_string());
+    }
+    Ok(out)
+}
+
+/// Post `WM_DROPFILES` for `paths` to the window `hwnd`, dropped at `(x, y)` in its client
+/// coordinates. Every path must be absolute; the files are not checked for existence. Errors with
+/// `Error::NotFound` for a dead window, `Error::Unsupported` when the window does not accept
+/// `WM_DROPFILES` (see [`accepts_files`]), `Error::Invalid` for a bad list. Returns once the
+/// message is queued; the target handles it on its own thread.
+pub fn drop_files(hwnd: u64, paths: &[&std::path::Path], x: i32, y: i32) -> Result<()> {
+    let list = check_paths(paths)?;
+    if hwnd == 0 || !unsafe { IsWindow(Some(handle(hwnd))) }.as_bool() {
+        return Err(Error::NotFound(format!("drop target window {hwnd}")));
+    }
+    if !accepts_files(hwnd) {
+        return Err(Error::Unsupported(
+            "window does not accept WM_DROPFILES (no WS_EX_ACCEPTFILES)",
+        ));
+    }
+    let bytes = build_dropfiles(&list, x, y, false);
+    unsafe {
+        let g: HGLOBAL = GlobalAlloc(GMEM_MOVEABLE, bytes.len())
+            .map_err(|e| Error::Platform(i64::from(e.code().0), "GlobalAlloc"))?;
+        let p = GlobalLock(g) as *mut u8;
+        if p.is_null() {
+            let _ = GlobalFree(Some(g));
+            return Err(Error::Platform(0, "GlobalLock"));
+        }
+        std::ptr::copy_nonoverlapping(bytes.as_ptr(), p, bytes.len());
+        let _ = GlobalUnlock(g);
+        if let Err(e) = PostMessageW(
+            Some(handle(hwnd)),
+            WM_DROPFILES,
+            WPARAM(g.0 as usize),
+            LPARAM(0),
+        ) {
+            let _ = GlobalFree(Some(g));
+            return Err(Error::Platform(
+                i64::from(e.code().0),
+                "PostMessage(WM_DROPFILES)",
+            ));
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::Path;
+
+    fn u32_at(b: &[u8], i: usize) -> u32 {
+        u32::from_le_bytes([b[i], b[i + 1], b[i + 2], b[i + 3]])
+    }
+
+    fn units(b: &[u8]) -> Vec<u16> {
+        b[20..]
+            .chunks_exact(2)
+            .map(|c| u16::from_le_bytes([c[0], c[1]]))
+            .collect()
+    }
+
+    #[test]
+    fn header_and_double_nul_list_match_the_dropfiles_layout() {
+        let b = build_dropfiles(&["C:\\a.txt".into(), "C:\\b".into()], 5, -7, false);
+        assert_eq!(u32_at(&b, 0), 20);
+        assert_eq!(u32_at(&b, 4) as i32, 5);
+        assert_eq!(u32_at(&b, 8) as i32, -7);
+        assert_eq!(u32_at(&b, 12), 0); // fNC
+        assert_eq!(u32_at(&b, 16), 1); // fWide
+        let expect: Vec<u16> = "C:\\a.txt\0C:\\b\0\0".encode_utf16().collect();
+        assert_eq!(units(&b), expect);
+    }
+
+    #[test]
+    fn non_client_flag_is_written() {
+        let b = build_dropfiles(&["C:\\a".into()], 0, 0, true);
+        assert_eq!(u32_at(&b, 12), 1);
+    }
+
+    #[test]
+    fn non_bmp_paths_are_encoded_as_surrogate_pairs() {
+        let b = build_dropfiles(&["C:\\\u{1F600}".into()], 0, 0, false);
+        let u = units(&b);
+        assert!(u.contains(&0xD83D) && u.contains(&0xDE00));
+    }
+
+    #[test]
+    fn path_list_rules() {
+        assert!(matches!(check_paths(&[]), Err(Error::Invalid(_))));
+        assert!(matches!(
+            check_paths(&[Path::new("relative.txt")]),
+            Err(Error::Invalid(_))
+        ));
+        assert!(matches!(
+            check_paths(&[Path::new("C:\\ok.txt"), Path::new("C:\\a\0b")]),
+            Err(Error::Invalid(_))
+        ));
+        let ok = check_paths(&[Path::new("C:\\one"), Path::new("C:\\two")]).unwrap();
+        assert_eq!(ok, vec!["C:\\one".to_string(), "C:\\two".to_string()]);
+    }
+
+    #[test]
+    fn dead_window_is_refused_without_allocating() {
+        assert!(matches!(
+            drop_files(0, &[Path::new("C:\\a")], 0, 0),
+            Err(Error::NotFound(_))
+        ));
+        assert!(!accepts_files(0));
+    }
+}

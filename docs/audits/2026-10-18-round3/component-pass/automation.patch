+fn region_via_cg(region: Rect, path: &Path) -> Option<(usize, usize)> {
+    unsafe {
+        let sym = dlsym(RTLD_DEFAULT, c"CGWindowListCreateImage".as_ptr());
+        if sym.is_null() {
+            return None;
+        }
+        let f: CreateImage = std::mem::transmute(sym);
+        let rect = CGRect {
+            origin: CGPoint {
+                x: region.x,
+                y: region.y,
+            },
+            size: CGSize {
+                w: region.w,
+                h: region.h,
+            },
+        };
+        // kCGWindowListOptionOnScreenOnly (1), kCGNullWindowID (0): everything on screen in
+        // `rect`, composited as the user sees it; BoundsIgnoreFraming|BestResolution.
+        let img = Cf::new(f(rect, 1, 0, 1 | 8))?;
+        write_png(&img, path)
+    }
+}
+
+/// Capture a rectangle of the screen as a PNG at `path`. `region` is in global display points
+/// with a top-left origin (the space `ax::El::frame` and window bounds use). Needs Screen
+/// Recording permission. The file is whatever is on screen in the rectangle, from every app and
+/// without redaction: the caller owns the policy for what may be captured. Returns the pixel
+/// size written (Retina captures are larger than `region`).
+pub fn capture_region_png(region: Rect, path: &Path) -> Result<(u32, u32)> {
+    if !(region.w > 0.0 && region.h > 0.0) || !region.x.is_finite() || !region.y.is_finite() {
+        return Err(Error::Invalid("empty or non-finite capture region".into()));
+    }
+    if unsafe { CGPreflightScreenCaptureAccess() } == 0 {
+        return Err(Error::PermissionDenied("Screen Recording"));
+    }
+    match region_via_cg(region, path) {
+        Some((w, h)) if path.exists() => Ok((w as u32, h as u32)),
+        _ => Err(Error::Unsupported("screen region capture failed")),
+    }
+}

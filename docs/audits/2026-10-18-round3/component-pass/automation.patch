+//! Screen-region capture: copy a rectangle of the desktop (every app composited, as the user
+//! sees it) with `BitBlt` from the screen device context.
+//!
+//! This is the counterpart of the per-window `PrintWindow` capture the engine uses. It captures
+//! whatever is on screen in the rectangle, from every application, with no redaction and no
+//! policy check: the caller owns the decision about what may be captured (use
+//! [`crate::capture_safety`] and [`crate::redact`] first when the region can hold secrets).
+//!
+//! Coordinates are physical pixels on the virtual desktop (negative values are monitors left of
+//! or above the primary). They are only physical pixels when the process is per-monitor-v2 DPI
+//! aware, which [`super::WinPlatform::new`] sets; with [`super::WinPlatform::new_minimal`] the
+//! caller must have done it, or the rectangle is in scaled coordinates.
+
+use crate::model::*;
+use windows::Win32::Graphics::Gdi::*;
+use windows::Win32::UI::WindowsAndMessaging::{
+    GetSystemMetrics, SM_CXVIRTUALSCREEN, SM_CYVIRTUALSCREEN, SM_XVIRTUALSCREEN, SM_YVIRTUALSCREEN,
+};
+
+/// A captured screen region.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RegionImage {
+    /// Left edge on the virtual desktop of the pixels actually captured (the requested region
+    /// clipped to the desktop).
+    pub x: i32,
+    /// Top edge, as `x`.
+    pub y: i32,
+    pub width: u32,
+    pub height: u32,
+    /// `width * height * 4` bytes, row-major, top row first, RGBA with alpha forced to 255.
+    pub rgba: Vec<u8>,
+}
+
+/// The virtual desktop: the bounding rectangle of every monitor, in physical pixels.
+pub fn virtual_screen() -> Rect {
+    unsafe {
+        Rect {
+            x: f64::from(GetSystemMetrics(SM_XVIRTUALSCREEN)),
+            y: f64::from(GetSystemMetrics(SM_YVIRTUALSCREEN)),
+            w: f64::from(GetSystemMetrics(SM_CXVIRTUALSCREEN)),
+            h: f64::from(GetSystemMetrics(SM_CYVIRTUALSCREEN)),
+        }
+    }
+}
+
+/// Intersect `region` with `bounds` and return `(x, y, width, height)` in whole pixels, or
+/// `None` when the rectangles do not overlap or `region` is empty or not finite.
+pub(crate) fn clip_region(region: Rect, bounds: Rect) -> Option<(i32, i32, u32, u32)> {
+    let finite = [region.x, region.y, region.w, region.h]
+        .iter()
+        .all(|v| v.is_finite());
+    if !finite || region.w < 1.0 || region.h < 1.0 {
+        return None;
+    }
+    let left = region.x.round().max(bounds.x.round());
+    let top = region.y.round().max(bounds.y.round());
+    let right = (region.x + region.w)
+        .round()
+        .min((bounds.x + bounds.w).round());
+    let bottom = (region.y + region.h)
+        .round()
+        .min((bounds.y + bounds.h).round());
+    if right <= left || bottom <= top {
+        return None;
+    }
+    Some((
+        left as i32,
+        top as i32,
+        (right - left) as u32,
+        (bottom - top) as u32,
+    ))
+}
+
+/// Swap BGRA (GDI order) to RGBA in place and force alpha to 255.
+pub(crate) fn bgra_to_rgba(px: &mut [u8]) {
+    for p in px.chunks_exact_mut(4) {
+        p.swap(0, 2);
+        p[3] = 255;
+    }
+}
+
+/// Capture `region` (physical pixels, virtual-desktop coordinates). The part of the region
+/// outside the desktop is dropped; see [`RegionImage::x`] for what was captured. Errors with
+/// `Error::Invalid` for an empty region or one entirely off the desktop, and `Error::Platform`
+/// when GDI refuses (for example on a locked or secure desktop).
+pub fn capture_region(region: Rect) -> Result<RegionImage> {
+    if !region.x.is_finite() || !region.y.is_finite() || region.w < 1.0 || region.h < 1.0 {
+        return Err(Error::Invalid("empty or non-finite capture region".into()));
+    }
+    let (x, y, w, h) = clip_region(region, virtual_screen())
+        .ok_or_else(|| Error::Invalid("capture region is outside the desktop".into()))?;
+    let (wi, hi) = (w as i32, h as i32);
+    unsafe {
+        let screen = GetDC(None);
+        if screen.is_invalid() {
+            return Err(Error::Platform(0, "GetDC"));
+        }
+        let mem = CreateCompatibleDC(Some(screen));
+        let bmp = CreateCompatibleBitmap(screen, wi, hi);
+        let old = SelectObject(mem, bmp.into());
+        // CAPTUREBLT includes layered (transparent, topmost) windows in the copy.
+        let blt = BitBlt(mem, 0, 0, wi, hi, Some(screen), x, y, SRCCOPY | CAPTUREBLT);
+        let mut bmi: BITMAPINFO = std::mem::zeroed();
+        bmi.bmiHeader = BITMAPINFOHEADER {
+            biSize: std::mem::size_of::<BITMAPINFOHEADER>() as u32,
+            biWidth: wi,
+            biHeight: -hi,
+            biPlanes: 1,
+            biBitCount: 32,
+            biCompression: BI_RGB.0,
+            ..Default::default()
+        };
+        let mut px = vec![0u8; (w as usize) * (h as usize) * 4];
+        let rows = GetDIBits(
+            mem,
+            bmp,
+            0,
+            h,
+            Some(px.as_mut_ptr() as *mut _),
+            &mut bmi,
+            DIB_RGB_COLORS,
+        );
+        SelectObject(mem, old);
+        let _ = DeleteObject(bmp.into());
+        let _ = DeleteDC(mem);
+        ReleaseDC(None, screen);
+        if let Err(e) = blt {
+            return Err(Error::Platform(i64::from(e.code().0), "BitBlt"));
+        }
+        if rows == 0 {
+            return Err(Error::Platform(0, "GetDIBits"));
+        }
+        bgra_to_rgba(&mut px);
+        Ok(RegionImage {
+            x,
+            y,
+            width: w,
+            height: h,
+            rgba: px,
+        })
+    }
+}
+
+/// [`capture_region`] written as a PNG at `path`. Returns what was captured (pixels included).
+pub fn capture_region_png(region: Rect, path: &std::path::Path) -> Result<RegionImage> {
+    let img = capture_region(region)?;
+    let png = crate::png::encode_rgba(img.width, img.height, &img.rgba)
+        .ok_or(Error::Unsupported("png encode"))?;
+    std::fs::write(path, png).map_err(|_| Error::Platform(0, "write png"))?;
+    Ok(img)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn r(x: f64, y: f64, w: f64, h: f64) -> Rect {
+        Rect { x, y, w, h }
+    }
+
+    #[test]
+    fn region_inside_the_desktop_is_unchanged() {
+        let desk = r(0.0, 0.0, 1920.0, 1080.0);
+        assert_eq!(
+            clip_region(r(10.0, 20.0, 300.0, 200.0), desk),
+            Some((10, 20, 300, 200))
+        );
+    }
+
+    #[test]
+    fn region_is_clipped_to_the_desktop_including_negative_origin() {
+        let desk = r(-1920.0, 0.0, 3840.0, 1080.0);
+        assert_eq!(
+            clip_region(r(-2000.0, -50.0, 200.0, 100.0), desk),
+            Some((-1920, 0, 120, 50))
+        );
+        assert_eq!(
+            clip_region(r(1900.0, 1000.0, 500.0, 500.0), desk),
+            Some((1900, 1000, 20, 80))
+        );
+    }
+
+    #[test]
+    fn off_desktop_empty_or_non_finite_regions_clip_to_none() {
+        let desk = r(0.0, 0.0, 100.0, 100.0);
+        assert_eq!(clip_region(r(200.0, 0.0, 10.0, 10.0), desk), None);
+        assert_eq!(clip_region(r(0.0, 0.0, 0.0, 10.0), desk), None);
+        assert_eq!(clip_region(r(0.0, 0.0, 10.0, 0.5), desk), None);
+        assert_eq!(clip_region(r(f64::NAN, 0.0, 10.0, 10.0), desk), None);
+        assert_eq!(clip_region(r(0.0, 0.0, f64::INFINITY, 10.0), desk), None);
+    }
+
+    #[test]
+    fn bgra_becomes_opaque_rgba() {
+        let mut px = [1u8, 2, 3, 0, 10, 20, 30, 7];
+        bgra_to_rgba(&mut px);
+        assert_eq!(px, [3, 2, 1, 255, 30, 20, 10, 255]);
+    }
+
+    #[test]
+    fn empty_region_is_refused_without_touching_gdi() {
+        assert!(matches!(
+            capture_region(r(0.0, 0.0, 0.0, 0.0)),
+            Err(Error::Invalid(_))
+        ));
+        assert!(matches!(
+            capture_region(r(f64::NAN, 0.0, 10.0, 10.0)),
+            Err(Error::Invalid(_))
+        ));
+    }
+}

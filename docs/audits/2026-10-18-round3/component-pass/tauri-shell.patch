diff --git a/crates/rightkit-tauri-shell/src/webview2_env.rs b/crates/rightkit-tauri-shell/src/webview2_env.rs
new file mode 100644
index 0000000..5ddde9e
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/webview2_env.rs
@@ -0,0 +1,291 @@
+//! WebView2 environment variables a Windows app sets before its first webview exists
+//! (Orthic-Labs/rightkit#386, part B).
+//!
+//! Donor: ViewRight `lib.rs` `configure_webview2_profile`. WebView2 reads both variables once, while
+//! the first controller is created, so [`configure`] must run at the very start of `main`, before
+//! Tauri spawns threads.
+//!
+//! * `WEBVIEW2_DEFAULT_BACKGROUND_COLOR`: the colour the webview paints before the page does, so a
+//!   window never flashes white. Set only when the process environment has no non-blank value.
+//! * `WEBVIEW2_USER_DATA_FOLDER`: `<local app data>/<app name>/webview2`, created if missing. A value
+//!   already in the environment (a QA or test run) wins untouched. The folder is registered with
+//!   [`crate::devtools::register_user_data_dir`] so the DevTools port-file tripwire scans it.
+//!
+//! The decision is a pure function ([`plan`]) over an environment lookup; [`configure`] applies it.
+//! Off Windows these variables mean nothing and [`configure`] does nothing.
+
+use std::path::{Path, PathBuf};
+
+use crate::ShellError;
+
+pub const BACKGROUND_COLOR_VAR: &str = "WEBVIEW2_DEFAULT_BACKGROUND_COLOR";
+pub const USER_DATA_FOLDER_VAR: &str = "WEBVIEW2_USER_DATA_FOLDER";
+
+/// What to set up.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Webview2Env {
+    app_name: String,
+    background_argb: Option<String>,
+    data_base: Option<PathBuf>,
+}
+
+impl Webview2Env {
+    /// `app_name` is the folder name under the local app data directory; it must be a single path
+    /// component (no separators, no `..`).
+    pub fn new(app_name: &str) -> Result<Self, ShellError> {
+        let name = app_name.trim();
+        let bad = name.is_empty()
+            || name == "."
+            || name == ".."
+            || name.contains(['/', '\\', ':', '\0']);
+        if bad {
+            return Err(ShellError::Invalid(format!(
+                "{app_name:?} is not a folder name"
+            )));
+        }
+        Ok(Self {
+            app_name: name.to_owned(),
+            background_argb: None,
+            data_base: None,
+        })
+    }
+
+    /// Default webview background as eight hex digits `AARRGGBB` (ViewRight: `FFF7F3EC`).
+    pub fn background(mut self, argb: &str) -> Result<Self, ShellError> {
+        if argb.len() != 8 || !argb.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(ShellError::Invalid(format!(
+                "{argb:?} is not an AARRGGBB colour"
+            )));
+        }
+        self.background_argb = Some(argb.to_ascii_uppercase());
+        Ok(self)
+    }
+
+    /// Put `<app name>/webview2` under `base` instead of the local app data directory.
+    pub fn data_base(mut self, base: impl Into<PathBuf>) -> Self {
+        self.data_base = Some(base.into());
+        self
+    }
+}
+
+/// What [`plan`] decided.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct EnvPlan {
+    /// The background colour variable to set.
+    pub background: Option<String>,
+    /// The user-data folder variable to set (the folder is created first).
+    pub user_data_folder: Option<PathBuf>,
+    /// The folder in effect once the plan is applied: the preset one, ours, or `None`.
+    pub effective_folder: Option<PathBuf>,
+}
+
+fn non_blank(value: Option<String>) -> Option<String> {
+    value.filter(|v| !v.trim().is_empty())
+}
+
+/// Decide from the current environment (`env`) and the local app data directory (`local_data`,
+/// `%LOCALAPPDATA%` on Windows; `.` is used when it is unknown, as ViewRight did). Pure.
+pub fn plan(
+    options: &Webview2Env,
+    env: impl Fn(&str) -> Option<String>,
+    local_data: Option<PathBuf>,
+) -> EnvPlan {
+    let background = match (&options.background_argb, non_blank(env(BACKGROUND_COLOR_VAR))) {
+        (Some(argb), None) => Some(argb.clone()),
+        _ => None,
+    };
+    if let Some(preset) = non_blank(env(USER_DATA_FOLDER_VAR)) {
+        return EnvPlan {
+            background,
+            user_data_folder: None,
+            effective_folder: Some(PathBuf::from(preset)),
+        };
+    }
+    let base = options
+        .data_base
+        .clone()
+        .or(local_data)
+        .unwrap_or_else(|| PathBuf::from("."));
+    let folder = base.join(&options.app_name).join("webview2");
+    EnvPlan {
+        background,
+        user_data_folder: Some(folder.clone()),
+        effective_folder: Some(folder),
+    }
+}
+
+/// What applying a plan did.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct EnvOutcome {
+    pub background_set: bool,
+    /// The folder variable now names this folder (set by us or already present).
+    pub user_data_folder: Option<PathBuf>,
+    /// The folder could not be created, so the variable was left alone (WebView2 then uses its
+    /// default next to the executable).
+    pub folder_error: Option<String>,
+}
+
+impl EnvPlan {
+    /// Create the folder and call `set` for each variable. The folder variable is set only after the
+    /// folder exists.
+    pub fn apply_with(&self, mut set: impl FnMut(&str, &str)) -> EnvOutcome {
+        let mut outcome = EnvOutcome::default();
+        if let Some(argb) = &self.background {
+            set(BACKGROUND_COLOR_VAR, argb);
+            outcome.background_set = true;
+        }
+        match &self.user_data_folder {
+            Some(folder) => match std::fs::create_dir_all(folder) {
+                Ok(()) => {
+                    set(USER_DATA_FOLDER_VAR, &folder.to_string_lossy());
+                    outcome.user_data_folder = Some(folder.clone());
+                }
+                Err(e) => outcome.folder_error = Some(format!("{}: {e}", folder.display())),
+            },
+            None => outcome.user_data_folder = self.effective_folder.clone(),
+        }
+        outcome
+    }
+}
+
+#[cfg(windows)]
+fn local_app_data() -> Option<PathBuf> {
+    non_blank(std::env::var("LOCALAPPDATA").ok()).map(PathBuf::from)
+}
+
+/// Apply `options` to this process (Windows). Call first thing in `main`, before any thread starts:
+/// changing the environment while another thread reads it is a data race. Registers the user-data
+/// folder with the DevTools tripwire. A no-op returning the default outcome off Windows.
+pub fn configure(options: &Webview2Env) -> EnvOutcome {
+    #[cfg(windows)]
+    {
+        let plan = plan(options, |name| std::env::var(name).ok(), local_app_data());
+        let outcome = plan.apply_with(|name, value| std::env::set_var(name, value));
+        if let Some(folder) = &outcome.user_data_folder {
+            crate::devtools::register_user_data_dir(folder.clone());
+        }
+        outcome
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = options;
+        EnvOutcome::default()
+    }
+}
+
+/// The folder WebView2 will use according to `env` alone, for display and tests.
+pub fn folder_in(env: impl Fn(&str) -> Option<String>) -> Option<PathBuf> {
+    non_blank(env(USER_DATA_FOLDER_VAR)).map(|v| Path::new(&v).to_path_buf())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::HashMap;
+
+    fn env(pairs: &[(&str, &str)]) -> impl Fn(&str) -> Option<String> {
+        let map: HashMap<String, String> = pairs
+            .iter()
+            .map(|(k, v)| ((*k).to_owned(), (*v).to_owned()))
+            .collect();
+        move |name| map.get(name).cloned()
+    }
+
+    fn options() -> Webview2Env {
+        Webview2Env::new("ViewRight")
+            .unwrap()
+            .background("fff7f3ec")
+            .unwrap()
+    }
+
+    #[test]
+    fn empty_environment_gets_both_variables() {
+        let plan = plan(&options(), env(&[]), Some(PathBuf::from("C:/Users/a/AppData/Local")));
+        assert_eq!(plan.background.as_deref(), Some("FFF7F3EC"));
+        let folder = PathBuf::from("C:/Users/a/AppData/Local")
+            .join("ViewRight")
+            .join("webview2");
+        assert_eq!(plan.user_data_folder, Some(folder.clone()));
+        assert_eq!(plan.effective_folder, Some(folder));
+    }
+
+    #[test]
+    fn blank_values_count_as_unset_and_real_values_win() {
+        let blank = plan(
+            &options(),
+            env(&[(BACKGROUND_COLOR_VAR, "  "), (USER_DATA_FOLDER_VAR, "")]),
+            None,
+        );
+        assert!(blank.background.is_some());
+        assert_eq!(
+            blank.user_data_folder,
+            Some(PathBuf::from(".").join("ViewRight").join("webview2"))
+        );
+        let preset = plan(
+            &options(),
+            env(&[
+                (BACKGROUND_COLOR_VAR, "FF000000"),
+                (USER_DATA_FOLDER_VAR, "D:/qa/profile"),
+            ]),
+            Some(PathBuf::from("C:/x")),
+        );
+        assert_eq!(preset.background, None);
+        assert_eq!(preset.user_data_folder, None);
+        assert_eq!(preset.effective_folder, Some(PathBuf::from("D:/qa/profile")));
+    }
+
+    #[test]
+    fn no_background_option_sets_no_background() {
+        let plain = Webview2Env::new("A").unwrap();
+        assert_eq!(plan(&plain, env(&[]), None).background, None);
+    }
+
+    #[test]
+    fn names_and_colours_are_validated() {
+        for bad in ["", " ", ".", "..", "a/b", "a\\b", "C:x"] {
+            assert!(Webview2Env::new(bad).is_err(), "{bad:?}");
+        }
+        for bad in ["", "FFF", "GGGGGGGG", "#FFF7F3EC", "FFF7F3ECFF"] {
+            assert!(Webview2Env::new("A").unwrap().background(bad).is_err(), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn apply_creates_the_folder_before_setting_the_variable() {
+        let dir = tempfile::tempdir().unwrap();
+        let options = options().data_base(dir.path());
+        let plan = plan(&options, env(&[]), None);
+        let mut set = Vec::new();
+        let outcome = plan.apply_with(|k, v| set.push((k.to_owned(), v.to_owned())));
+        let folder = dir.path().join("ViewRight").join("webview2");
+        assert!(folder.is_dir());
+        assert!(outcome.background_set && outcome.folder_error.is_none());
+        assert_eq!(outcome.user_data_folder, Some(folder.clone()));
+        assert!(set.contains(&(BACKGROUND_COLOR_VAR.into(), "FFF7F3EC".into())));
+        assert!(set.contains(&(USER_DATA_FOLDER_VAR.into(), folder.to_string_lossy().into_owned())));
+    }
+
+    #[test]
+    fn an_uncreatable_folder_leaves_the_variable_alone() {
+        let dir = tempfile::tempdir().unwrap();
+        let blocker = dir.path().join("file");
+        std::fs::write(&blocker, b"x").unwrap();
+        // A file where the base directory should be: create_dir_all fails.
+        let plan = plan(&options().data_base(&blocker), env(&[]), None);
+        let mut set = Vec::new();
+        let outcome = plan.apply_with(|k, _| set.push(k.to_owned()));
+        assert!(outcome.folder_error.is_some());
+        assert_eq!(outcome.user_data_folder, None);
+        assert!(!set.iter().any(|k| k == USER_DATA_FOLDER_VAR));
+    }
+
+    #[test]
+    fn a_preset_folder_is_reported_but_not_touched() {
+        let plan = plan(&options(), env(&[(USER_DATA_FOLDER_VAR, "D:/qa")]), None);
+        let mut set = Vec::new();
+        let outcome = plan.apply_with(|k, _| set.push(k.to_owned()));
+        assert_eq!(outcome.user_data_folder, Some(PathBuf::from("D:/qa")));
+        assert!(!set.iter().any(|k| k == USER_DATA_FOLDER_VAR));
+        assert_eq!(folder_in(env(&[(USER_DATA_FOLDER_VAR, " ")])), None);
+    }
+}
diff --git a/crates/rightkit-tauri-shell/src/webview2_menu.rs b/crates/rightkit-tauri-shell/src/webview2_menu.rs
new file mode 100644
index 0000000..a09575a
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/webview2_menu.rs
@@ -0,0 +1,646 @@
+//! WebView2 native context-menu grafting, browser-accelerator switch and new-window routing
+//! (Orthic-Labs/rightkit#386, part B).
+//!
+//! Donor: ViewRight `context_menu.rs`. An app that shows web content inside its window (document
+//! previews, a live URL preview) wants the engine's own menu, with its "Inspect" item where the
+//! DevTools policy allows it, plus a few app items ("View source", "Open link in a tab") and without
+//! the items that would open a detached engine window. This module owns that mechanism; the app
+//! owns the labels and what each item does.
+//!
+//! * [`ContextMenuConfig`] / [`install_context_menu`]: classify the frame that was right-clicked
+//!   ([`FrameKind`]), tidy the menu (drop named items, drop empty submenus) and append app items.
+//!   The decision is a plain function ([`ContextMenuConfig::plan`]) so it is tested without a GUI.
+//! * [`disable_browser_accelerator_keys`]: turns the engine's built-in accelerator keys off for the
+//!   whole webview (reload, print, find, ...). The keydown still reaches the page. This is
+//!   all-or-nothing; the shell's own hardening (`Hardening::block_reload` and friends) stops single
+//!   keys and keeps print and find, so prefer that unless the app owns every browser key itself.
+//! * [`route_new_windows`]: answers `NewWindowRequested` (target=_blank, middle click) so the engine
+//!   never opens a detached window; the app decides which URLs it takes.
+//!
+//! Handlers are added next to the shell's own `ContextMenuRequested` handler (the DevTools and
+//! hardening layers), not instead of it: WebView2 runs every registered handler in registration
+//! order. Install this after the shell has set the webview up (for example from
+//! `RunEvent::WebviewReady` or after the window is built), so the shell has already removed the
+//! "Inspect" item where the policy denies it and a handled event is not undone here.
+//!
+//! Not compiled on this macOS host for Windows; the Windows code mirrors ViewRight's shipped
+//! `context_menu.rs` and needs a run against a live WebView2 (right-click on a link in a preview
+//! frame, on a page, `target=_blank` link).
+
+use std::sync::Arc;
+
+use tauri::{Runtime, WebviewWindow};
+
+use crate::ShellError;
+
+/// What kind of frame a context-menu request came from.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum FrameKind {
+    /// The app's own editable preview of a local document (a custom-scheme origin or `about:srcdoc`).
+    Editable,
+    /// A served web page (http or https) shown by the app.
+    Web,
+    /// Anything else, including the app's own UI: the menu is left exactly as the shell made it.
+    Other,
+}
+
+/// Engine item names ViewRight drops from preview menus: they open a detached engine window.
+pub const LINK_NEW_WINDOW_ITEM_NAMES: [&str; 3] = [
+    "openLinkInNewWindow",
+    "openLinkInNewTab",
+    "openLinkInNewBackgroundTab",
+];
+
+/// The frame URI WebView2 reports for an `srcdoc` iframe.
+pub const SRCDOC_FRAME: &str = "about:srcdoc";
+
+/// True for an `http://` or `https://` URL (after trimming).
+pub fn is_http_url(url: &str) -> bool {
+    let url = url.trim();
+    url.starts_with("http://") || url.starts_with("https://")
+}
+
+/// Classify `frame_uri`. `editable_prefixes` are the URI prefixes of the app's own preview origins
+/// (on WebView2 a custom scheme is an `http://<scheme>.localhost/` URL; elsewhere `<scheme>://`).
+/// `about:srcdoc` and every prefix match are [`FrameKind::Editable`]. The editable test runs BEFORE
+/// the http(s) test, because the WebView2 form of a preview origin is an `http://` URL that would
+/// otherwise pass for a live web page.
+pub fn classify_frame(frame_uri: &str, editable_prefixes: &[&str]) -> FrameKind {
+    if frame_uri == SRCDOC_FRAME || editable_prefixes.iter().any(|p| frame_uri.starts_with(p)) {
+        FrameKind::Editable
+    } else if frame_uri.starts_with("http://") || frame_uri.starts_with("https://") {
+        FrameKind::Web
+    } else {
+        FrameKind::Other
+    }
+}
+
+/// What the menu was opened on.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MenuContext {
+    /// URI of the frame that was right-clicked (empty when WebView2 gave none).
+    pub frame_uri: String,
+    /// URI of the link under the pointer (empty when the target is not a link). For `srcdoc` this
+    /// resolves a relative href against `about:srcdoc` and is unreliable: use it only as a yes/no.
+    pub link_uri: String,
+    /// The frame's classification.
+    pub kind: FrameKind,
+}
+
+impl MenuContext {
+    pub fn on_link(&self) -> bool {
+        !self.link_uri.trim().is_empty()
+    }
+}
+
+/// When an app item is offered.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ItemWhen {
+    Always,
+    OnLink,
+}
+
+type Classifier = Arc<dyn Fn(&str) -> FrameKind + Send + Sync>;
+type Action = Arc<dyn Fn(&MenuContext) + Send + Sync>;
+
+/// One app item appended to the engine menu.
+#[derive(Clone)]
+pub struct CustomItem {
+    label: String,
+    when: ItemWhen,
+    frames: Vec<FrameKind>,
+    action: Action,
+}
+
+impl CustomItem {
+    /// An item shown on every classified frame ([`FrameKind::Editable`] and [`FrameKind::Web`]).
+    /// `action` runs when the user picks it, on the WebView2 thread; keep it short (emit an event).
+    pub fn new(label: &str, action: impl Fn(&MenuContext) + Send + Sync + 'static) -> Self {
+        Self {
+            label: label.to_owned(),
+            when: ItemWhen::Always,
+            frames: vec![FrameKind::Editable, FrameKind::Web],
+            action: Arc::new(action),
+        }
+    }
+
+    /// Offer the item only when the target is a link.
+    pub fn on_link(mut self) -> Self {
+        self.when = ItemWhen::OnLink;
+        self
+    }
+
+    /// Offer the item only on these frame kinds. [`FrameKind::Other`] is never touched, whatever is
+    /// listed here.
+    pub fn frames(mut self, frames: &[FrameKind]) -> Self {
+        self.frames = frames.to_vec();
+        self
+    }
+
+    pub fn label(&self) -> &str {
+        &self.label
+    }
+}
+
+impl std::fmt::Debug for CustomItem {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("CustomItem")
+            .field("label", &self.label)
+            .field("when", &self.when)
+            .field("frames", &self.frames)
+            .finish_non_exhaustive()
+    }
+}
+
+/// How the menu of one webview is changed.
+#[derive(Clone)]
+pub struct ContextMenuConfig {
+    classifier: Classifier,
+    remove_names: Vec<String>,
+    remove_empty_submenus: bool,
+    items: Vec<CustomItem>,
+}
+
+/// The decision for one context-menu request.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MenuPlan {
+    /// False: leave the menu alone (the frame is [`FrameKind::Other`]).
+    pub touch: bool,
+    /// Engine items (by WebView2 item name) to remove.
+    pub remove_names: Vec<String>,
+    /// Remove submenus that have no children (for example an empty "More tools").
+    pub remove_empty_submenus: bool,
+    /// Indices into the config's items to append, in order.
+    pub items: Vec<usize>,
+}
+
+impl ContextMenuConfig {
+    /// `classifier` maps a frame URI to its kind; [`classify_frame`] is the usual body.
+    pub fn new(classifier: impl Fn(&str) -> FrameKind + Send + Sync + 'static) -> Self {
+        Self {
+            classifier: Arc::new(classifier),
+            remove_names: Vec::new(),
+            remove_empty_submenus: true,
+            items: Vec::new(),
+        }
+    }
+
+    /// Engine items to drop, by WebView2 item name (see [`LINK_NEW_WINDOW_ITEM_NAMES`]).
+    pub fn remove_items(mut self, names: &[&str]) -> Self {
+        self.remove_names = names.iter().map(|n| (*n).to_owned()).collect();
+        self
+    }
+
+    /// Keep empty submenus (they are removed by default).
+    pub fn keep_empty_submenus(mut self) -> Self {
+        self.remove_empty_submenus = false;
+        self
+    }
+
+    /// Append an app item (items appear in the order they were added).
+    pub fn item(mut self, item: CustomItem) -> Self {
+        self.items.push(item);
+        self
+    }
+
+    /// Classify `frame_uri` with the configured classifier.
+    pub fn classify(&self, frame_uri: &str) -> FrameKind {
+        (self.classifier)(frame_uri)
+    }
+
+    /// The decision for a request. Pure.
+    pub fn plan(&self, context: &MenuContext) -> MenuPlan {
+        if context.kind == FrameKind::Other {
+            return MenuPlan {
+                touch: false,
+                remove_names: Vec::new(),
+                remove_empty_submenus: false,
+                items: Vec::new(),
+            };
+        }
+        let items = self
+            .items
+            .iter()
+            .enumerate()
+            .filter(|(_, item)| {
+                item.frames.contains(&context.kind)
+                    && (item.when == ItemWhen::Always || context.on_link())
+            })
+            .map(|(index, _)| index)
+            .collect();
+        MenuPlan {
+            touch: true,
+            remove_names: self.remove_names.clone(),
+            remove_empty_submenus: self.remove_empty_submenus,
+            items,
+        }
+    }
+}
+
+/// Wrap a URL callback as a [`route_new_windows`] router: an http(s) URL is handed to `on_url` and
+/// reported handled; any other URL is left to WebView2 (and so to the shell's navigation policy).
+pub fn http_router(
+    on_url: impl Fn(&str) + Send + Sync + 'static,
+) -> impl Fn(&str) -> bool + Send + Sync + 'static {
+    move |url| {
+        if is_http_url(url) {
+            on_url(url.trim());
+            true
+        } else {
+            false
+        }
+    }
+}
+
+/// Install the context-menu handler on `window`'s webview. A no-op off Windows (the WKWebView menu
+/// is the platform's own). `Err` only when the webview cannot be reached; failures inside WebView2
+/// (a runtime older than `ICoreWebView2_11`, a menu item that cannot be added) leave the engine
+/// menu unchanged, never half-edited by an abort.
+pub fn install_context_menu<R: Runtime>(
+    window: &WebviewWindow<R>,
+    config: ContextMenuConfig,
+) -> Result<(), ShellError> {
+    #[cfg(windows)]
+    {
+        windows_impl::install_context_menu(window, config)
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = (window, config);
+        Ok(())
+    }
+}
+
+/// Turn WebView2's built-in browser accelerator keys off for `window`'s webview (Windows; a no-op
+/// elsewhere). See the module doc: this is all-or-nothing and the page still receives the keydown.
+pub fn disable_browser_accelerator_keys<R: Runtime>(
+    window: &WebviewWindow<R>,
+) -> Result<(), ShellError> {
+    #[cfg(windows)]
+    {
+        windows_impl::disable_browser_accelerator_keys(window)
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = window;
+        Ok(())
+    }
+}
+
+/// Answer `NewWindowRequested` for `window`'s webview (Windows; a no-op elsewhere). `router`
+/// receives the requested URI; returning `true` marks the request handled so the engine opens no
+/// window of its own, `false` leaves the engine default.
+pub fn route_new_windows<R: Runtime>(
+    window: &WebviewWindow<R>,
+    router: impl Fn(&str) -> bool + Send + Sync + 'static,
+) -> Result<(), ShellError> {
+    #[cfg(windows)]
+    {
+        windows_impl::route_new_windows(window, Arc::new(router))
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = (window, router);
+        Ok(())
+    }
+}
+
+#[cfg(windows)]
+mod windows_impl {
+    use super::*;
+    use crate::winapi::webview2_com::Microsoft::Web::WebView2::Win32::{
+        ICoreWebView2ContextMenuItem, ICoreWebView2ContextMenuItemCollection,
+        ICoreWebView2Environment9, ICoreWebView2Settings3, ICoreWebView2_11, ICoreWebView2_2,
+        COREWEBVIEW2_CONTEXT_MENU_ITEM_KIND, COREWEBVIEW2_CONTEXT_MENU_ITEM_KIND_COMMAND,
+        COREWEBVIEW2_CONTEXT_MENU_ITEM_KIND_SUBMENU,
+    };
+    use crate::winapi::webview2_com::{
+        ContextMenuRequestedEventHandler, CustomItemSelectedEventHandler,
+        NewWindowRequestedEventHandler,
+    };
+    use crate::winapi::windows::core::{IUnknown, Interface, HSTRING, PWSTR};
+    use crate::winapi::windows::Win32::System::Com::IStream;
+
+    #[link(name = "ole32")]
+    unsafe extern "system" {
+        fn CoTaskMemFree(block: *const core::ffi::c_void);
+    }
+
+    /// Copy a CoTaskMem string WebView2 returned and free it. A null pointer is the empty string.
+    unsafe fn take_string(text: PWSTR) -> String {
+        if text.is_null() {
+            return String::new();
+        }
+        let out = text.to_string().unwrap_or_default();
+        // SAFETY: WebView2 allocates out-parameter strings with CoTaskMemAlloc.
+        unsafe { CoTaskMemFree(text.0 as *const core::ffi::c_void) };
+        out
+    }
+
+    pub fn install_context_menu<R: Runtime>(
+        window: &WebviewWindow<R>,
+        config: ContextMenuConfig,
+    ) -> Result<(), ShellError> {
+        let config = Arc::new(config);
+        window
+            .with_webview(move |webview| unsafe {
+                let Ok(core) = webview.controller().CoreWebView2() else {
+                    return;
+                };
+                // ContextMenuRequested needs a runtime with ICoreWebView2_11: skip silently on older ones.
+                let Ok(wv11) = core.cast::<ICoreWebView2_11>() else {
+                    return;
+                };
+                let handler =
+                    ContextMenuRequestedEventHandler::create(Box::new(move |sender, args| {
+                        let (Some(core), Some(args)) = (sender, args) else {
+                            return Ok(());
+                        };
+                        let target = args.ContextMenuTarget()?;
+                        let mut frame = PWSTR::null();
+                        target.FrameUri(&mut frame)?;
+                        let frame_uri = take_string(frame);
+                        let mut link = PWSTR::null();
+                        let _ = target.LinkUri(&mut link);
+                        let context = MenuContext {
+                            kind: config.classify(&frame_uri),
+                            frame_uri,
+                            link_uri: take_string(link),
+                        };
+                        let plan = config.plan(&context);
+                        if !plan.touch {
+                            return Ok(());
+                        }
+                        let items = args.MenuItems()?;
+                        if plan.remove_empty_submenus {
+                            remove_where(&items, |item| {
+                                let mut kind = COREWEBVIEW2_CONTEXT_MENU_ITEM_KIND(0);
+                                if !(item.Kind(&mut kind).is_ok()
+                                    && kind == COREWEBVIEW2_CONTEXT_MENU_ITEM_KIND_SUBMENU)
+                                {
+                                    return false;
+                                }
+                                let Ok(children) = item.Children() else {
+                                    return false;
+                                };
+                                let mut count: u32 = 0;
+                                children.Count(&mut count).is_ok() && count == 0
+                            })?;
+                        }
+                        if !plan.remove_names.is_empty() {
+                            remove_where(&items, |item| {
+                                let mut name = PWSTR::null();
+                                if item.Name(&mut name).is_err() {
+                                    return false;
+                                }
+                                let name = take_string(name);
+                                plan.remove_names.iter().any(|n| *n == name)
+                            })?;
+                        }
+                        if plan.items.is_empty() {
+                            return Ok(());
+                        }
+                        let env: ICoreWebView2Environment9 =
+                            core.cast::<ICoreWebView2_2>()?.Environment()?.cast()?;
+                        for index in plan.items {
+                            let Some(item) = config.items.get(index) else {
+                                continue;
+                            };
+                            let action = item.action.clone();
+                            let context = context.clone();
+                            append_command(&env, &items, &item.label, move |_item, _args| {
+                                action(&context);
+                                Ok(())
+                            })?;
+                        }
+                        Ok(())
+                    }));
+                let mut token: i64 = 0;
+                // The token is not kept: the handler lives as long as the webview, and WebView2
+                // holds a COM reference to it.
+                let _ = wv11.add_ContextMenuRequested(&handler, &mut token);
+            })
+            .map_err(|e| ShellError::Other(format!("webview unavailable: {e}")))
+    }
+
+    unsafe fn append_command(
+        env: &ICoreWebView2Environment9,
+        items: &ICoreWebView2ContextMenuItemCollection,
+        label: &str,
+        on_select: impl FnMut(
+                Option<ICoreWebView2ContextMenuItem>,
+                Option<IUnknown>,
+            ) -> crate::winapi::windows::core::Result<()>
+            + 'static,
+    ) -> crate::winapi::windows::core::Result<()> {
+        let label = HSTRING::from(label);
+        // SAFETY: live WebView2 objects used on the thread that delivered the event.
+        unsafe {
+            let item = env.CreateContextMenuItem(
+                &label,
+                None::<&IStream>,
+                COREWEBVIEW2_CONTEXT_MENU_ITEM_KIND_COMMAND,
+            )?;
+            let mut token: i64 = 0;
+            item.add_CustomItemSelected(
+                &CustomItemSelectedEventHandler::create(Box::new(on_select)),
+                &mut token,
+            )?;
+            let mut count: u32 = 0;
+            items.Count(&mut count)?;
+            items.InsertValueAtIndex(count, &item)?;
+        }
+        Ok(())
+    }
+
+    /// Remove every item `pred` accepts, scanning from the end. Entries that cannot be read are
+    /// skipped and a failed removal is ignored: tidying is best effort.
+    unsafe fn remove_where(
+        items: &ICoreWebView2ContextMenuItemCollection,
+        pred: impl Fn(&ICoreWebView2ContextMenuItem) -> bool,
+    ) -> crate::winapi::windows::core::Result<()> {
+        // SAFETY: as in `append_command`.
+        unsafe {
+            let mut count: u32 = 0;
+            items.Count(&mut count)?;
+            let mut i = count;
+            while i > 0 {
+                i -= 1;
+                let Ok(item) = items.GetValueAtIndex(i) else {
+                    continue;
+                };
+                if pred(&item) {
+                    let _ = items.RemoveValueAtIndex(i);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    pub fn disable_browser_accelerator_keys<R: Runtime>(
+        window: &WebviewWindow<R>,
+    ) -> Result<(), ShellError> {
+        window
+            .with_webview(|webview| unsafe {
+                let Ok(core) = webview.controller().CoreWebView2() else {
+                    return;
+                };
+                let Ok(settings) = core.Settings() else {
+                    return;
+                };
+                if let Ok(settings3) = settings.cast::<ICoreWebView2Settings3>() {
+                    let _ = settings3.SetAreBrowserAcceleratorKeysEnabled(false);
+                }
+            })
+            .map_err(|e| ShellError::Other(format!("webview unavailable: {e}")))
+    }
+
+    pub fn route_new_windows<R: Runtime>(
+        window: &WebviewWindow<R>,
+        router: Arc<dyn Fn(&str) -> bool + Send + Sync>,
+    ) -> Result<(), ShellError> {
+        window
+            .with_webview(move |webview| unsafe {
+                let Ok(core) = webview.controller().CoreWebView2() else {
+                    return;
+                };
+                let handler =
+                    NewWindowRequestedEventHandler::create(Box::new(move |_sender, args| {
+                        let Some(args) = args else { return Ok(()) };
+                        let mut uri = PWSTR::null();
+                        args.Uri(&mut uri)?;
+                        if router(&take_string(uri)) {
+                            args.SetHandled(true)?;
+                        }
+                        Ok(())
+                    }));
+                let mut token: i64 = 0;
+                let _ = core.add_NewWindowRequested(&handler, &mut token);
+            })
+            .map_err(|e| ShellError::Other(format!("webview unavailable: {e}")))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    const PREVIEW: [&str; 2] = [
+        "http://viewright-preview.localhost/",
+        "viewright-preview://",
+    ];
+
+    fn config() -> ContextMenuConfig {
+        ContextMenuConfig::new(|frame| classify_frame(frame, &PREVIEW))
+            .remove_items(&LINK_NEW_WINDOW_ITEM_NAMES)
+            .item(CustomItem::new("Open link in tab", |_| {}).on_link())
+            .item(CustomItem::new("View source", |_| {}).frames(&[FrameKind::Editable]))
+    }
+
+    fn context(config: &ContextMenuConfig, frame: &str, link: &str) -> MenuContext {
+        MenuContext {
+            frame_uri: frame.into(),
+            link_uri: link.into(),
+            kind: config.classify(frame),
+        }
+    }
+
+    #[test]
+    fn frames_classify_with_editable_origins_before_http() {
+        assert_eq!(classify_frame("about:srcdoc", &PREVIEW), FrameKind::Editable);
+        assert_eq!(
+            classify_frame("http://viewright-preview.localhost/abc", &PREVIEW),
+            FrameKind::Editable
+        );
+        assert_eq!(
+            classify_frame("viewright-preview://localhost/abc", &PREVIEW),
+            FrameKind::Editable
+        );
+        assert_eq!(
+            classify_frame("https://example.com/", &PREVIEW),
+            FrameKind::Web
+        );
+        assert_eq!(
+            classify_frame("http://tauri.localhost/index.html", &PREVIEW),
+            FrameKind::Web
+        );
+        assert_eq!(classify_frame("", &PREVIEW), FrameKind::Other);
+        assert_eq!(classify_frame("data:text/html,x", &PREVIEW), FrameKind::Other);
+        assert_eq!(classify_frame("about:blank", &PREVIEW), FrameKind::Other);
+    }
+
+    #[test]
+    fn app_frames_are_never_touched() {
+        let config = config();
+        let plan = config.plan(&context(&config, "", ""));
+        assert!(!plan.touch);
+        assert!(plan.items.is_empty() && plan.remove_names.is_empty());
+        let plan = config.plan(&context(&config, "tauri://localhost/", "https://a"));
+        assert!(!plan.touch && plan.items.is_empty());
+    }
+
+    #[test]
+    fn items_follow_frame_kind_and_link_target() {
+        let config = config();
+        // Editable preview, no link: only "View source".
+        let plan = config.plan(&context(&config, "about:srcdoc", ""));
+        assert!(plan.touch);
+        assert_eq!(plan.items, vec![1]);
+        // Editable preview on a link: both, in registration order.
+        let plan = config.plan(&context(&config, "about:srcdoc", "about:srcdoc#x"));
+        assert_eq!(plan.items, vec![0, 1]);
+        // Web page on a link: link item only, never "View source".
+        let plan = config.plan(&context(&config, "https://example.com/", "https://a/"));
+        assert_eq!(plan.items, vec![0]);
+        // Web page, no link: nothing appended, but the menu is still tidied.
+        let plan = config.plan(&context(&config, "https://example.com/", "  "));
+        assert!(plan.touch && plan.items.is_empty());
+        assert_eq!(plan.remove_names, LINK_NEW_WINDOW_ITEM_NAMES);
+        assert!(plan.remove_empty_submenus);
+        let kept = ContextMenuConfig::new(|_| FrameKind::Web).keep_empty_submenus();
+        assert!(!kept.plan(&context(&kept, "https://x/", "")).remove_empty_submenus);
+    }
+
+    #[test]
+    fn other_is_never_listed_as_an_item_frame() {
+        let config = ContextMenuConfig::new(|_| FrameKind::Other)
+            .item(CustomItem::new("x", |_| {}).frames(&[FrameKind::Other]));
+        let plan = config.plan(&context(&config, "tauri://localhost/", ""));
+        assert!(!plan.touch && plan.items.is_empty());
+    }
+
+    #[test]
+    fn http_router_takes_only_http_urls() {
+        let seen = Arc::new(AtomicUsize::new(0));
+        let counter = seen.clone();
+        let router = http_router(move |url| {
+            assert!(url.starts_with("http"));
+            counter.fetch_add(1, Ordering::SeqCst);
+        });
+        assert!(router("https://example.com/a"));
+        assert!(router("  http://example.com "));
+        assert!(!router("mailto:a@b.c"));
+        assert!(!router("file:///etc/passwd"));
+        assert!(!router("javascript:alert(1)"));
+        assert!(!router(""));
+        assert_eq!(seen.load(Ordering::SeqCst), 2);
+    }
+
+    #[test]
+    fn item_action_receives_the_menu_context() {
+        let seen = Arc::new(std::sync::Mutex::new(String::new()));
+        let sink = seen.clone();
+        let item = CustomItem::new("Open", move |ctx| {
+            *sink.lock().unwrap() = ctx.link_uri.clone();
+        });
+        let ctx = MenuContext {
+            frame_uri: "about:srcdoc".into(),
+            link_uri: "https://a/".into(),
+            kind: FrameKind::Editable,
+        };
+        (item.action)(&ctx);
+        assert_eq!(*seen.lock().unwrap(), "https://a/");
+        assert_eq!(item.label(), "Open");
+    }
+}

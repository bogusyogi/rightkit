+#![cfg(feature = "tauri")]
+//! Open-path queue and argv filter (Orthic-Labs/rightkit#386).
+
+use std::path::PathBuf;
+
+use rightkit_tauri_shell::open_paths::{
+    file_paths_from_args, file_paths_from_argv, is_path_arg, PendingOpenPaths, MAX_QUEUED,
+};
+
+fn p(s: &str) -> PathBuf {
+    PathBuf::from(s)
+}
+
+#[test]
+fn filter_keeps_paths_and_drops_flags_urls_and_junk() {
+    let kept = file_paths_from_args([
+        "-psn_0_12345",
+        "--background",
+        "/tmp/a.md",
+        "C:\\docs\\b.docx",
+        "https://example.com/x",
+        "myapp://open/1",
+        "",
+        "   ",
+        "bad\0path",
+        "rel/c.txt",
+    ]);
+    assert_eq!(
+        kept,
+        [p("/tmp/a.md"), p("C:\\docs\\b.docx"), p("rel/c.txt")]
+    );
+    assert!(is_path_arg("a b.txt"));
+    assert!(!is_path_arg("-x"));
+}
+
+#[cfg(unix)]
+#[test]
+fn second_launch_argv_skips_the_program_and_resolves_against_its_cwd() {
+    let argv: Vec<String> = ["/Apps/app", "--flag", "doc.md", "/abs/x.md", "mailto:a@b.c"]
+        .iter()
+        .map(|s| s.to_string())
+        .collect();
+    assert_eq!(
+        file_paths_from_argv(&argv, "/work"),
+        [p("/work/doc.md"), p("/abs/x.md")]
+    );
+    // No usable cwd: relative paths stay as given.
+    assert_eq!(
+        file_paths_from_argv(&argv, ""),
+        [p("doc.md"), p("/abs/x.md")]
+    );
+}
+
+#[test]
+fn paths_wait_for_the_renderer_then_deliver_live() {
+    let q = PendingOpenPaths::from_args(["/launch/one.md", "--x"]);
+    assert_eq!(q.pending(), 1);
+    assert!(!q.is_ready());
+    // Not ready: queued, nothing delivered now.
+    assert!(q.queue_or_take(vec![p("/two.md")]).unwrap().is_empty());
+    assert_eq!(q.pending(), 2);
+    assert_eq!(
+        q.mark_ready_and_drain().unwrap(),
+        [p("/launch/one.md"), p("/two.md")]
+    );
+    assert!(q.is_ready());
+    assert_eq!(q.pending(), 0);
+    // Ready: handed straight back, never queued; a second drain is empty.
+    assert_eq!(
+        q.queue_or_take(vec![p("/three.md")]).unwrap(),
+        [p("/three.md")]
+    );
+    assert_eq!(q.pending(), 0);
+    assert!(q.mark_ready_and_drain().unwrap().is_empty());
+}
+
+#[test]
+fn the_queue_is_bounded() {
+    let q = PendingOpenPaths::new();
+    let many: Vec<PathBuf> = (0..MAX_QUEUED + 50).map(|i| p(&format!("/f{i}"))).collect();
+    assert!(q.queue_or_take(many).unwrap().is_empty());
+    assert_eq!(q.pending(), MAX_QUEUED);
+    assert!(q.queue_or_take(vec![p("/extra")]).unwrap().is_empty());
+    assert_eq!(q.pending(), MAX_QUEUED);
+    let first = q.mark_ready_and_drain().unwrap();
+    assert_eq!(first[0], p("/f0"));
+    assert_eq!(first.len(), MAX_QUEUED);
+}

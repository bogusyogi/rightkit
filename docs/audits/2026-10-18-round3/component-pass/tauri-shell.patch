diff --git a/crates/rightkit-tauri-shell/src/engine_stream.rs b/crates/rightkit-tauri-shell/src/engine_stream.rs
new file mode 100644
index 0000000..f6b3b04
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/engine_stream.rs
@@ -0,0 +1,322 @@
+//! Snapshot-atomic engine event stream: the fan-out hub, the opt-in progress coalescer and the
+//! forwarder thread behind `rk_shell_engine_subscribe`. Plain Rust, so it is unit-tested without
+//! Tauri or a sidecar.
+//!
+//! Donor: ScrapeRight `commands_stream.rs` (receivers attach before the snapshot is taken;
+//! progress events coalesce to about 10 Hz; a newer subscription replaces an older one). The
+//! allowlist, per-method deadlines, request tags and restart policy are `engine::EnginePolicy`.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::mpsc::{self, Receiver, RecvTimeoutError, Sender};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use serde_json::Value;
+
+/// Fan-out of engine events to stream subscribers. A new subscription replaces the previous one
+/// (a reloaded page), so a stale forwarder ends instead of leaking.
+#[derive(Default)]
+pub struct EventHub {
+    subs: Mutex<Vec<(u64, Sender<Value>)>>,
+    next: AtomicU64,
+}
+
+impl EventHub {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Attach a receiver. Every event published from now on is queued for it, so a snapshot taken
+    /// after this call cannot miss one.
+    pub fn subscribe_exclusive(&self) -> Receiver<Value> {
+        let (tx, rx) = mpsc::channel();
+        let id = self.next.fetch_add(1, Ordering::SeqCst);
+        let mut subs = self.subs.lock().unwrap_or_else(|e| e.into_inner());
+        subs.clear();
+        subs.push((id, tx));
+        rx
+    }
+
+    pub fn publish(&self, event: &Value) {
+        let mut subs = self.subs.lock().unwrap_or_else(|e| e.into_inner());
+        subs.retain(|(_, tx)| tx.send(event.clone()).is_ok());
+    }
+
+    pub fn subscribers(&self) -> usize {
+        self.subs.lock().unwrap_or_else(|e| e.into_inner()).len()
+    }
+}
+
+/// What to do with one event under coalescing.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Delivery {
+    /// Hold it; a later event for the same key replaces it, and it is sent at the next flush.
+    Coalesce,
+    /// Send now and drop whatever was held for the key.
+    Now,
+    /// Send now, drop what was held, and forget the key (a terminal event).
+    NowAndForget,
+}
+
+pub type KeyFn = Arc<dyn Fn(&Value) -> Option<String> + Send + Sync>;
+/// `(event, last event seen for the key)`.
+pub type RuleFn = Arc<dyn Fn(&Value, Option<&Value>) -> Delivery + Send + Sync>;
+
+/// Opt-in progress coalescing for the engine stream.
+#[derive(Clone)]
+pub struct StreamCoalesce {
+    /// The key an event coalesces under (a job id). `None` sends the event untouched.
+    pub key: KeyFn,
+    /// Whether an event is held or sent.
+    pub rule: RuleFn,
+    /// Longest a held event waits.
+    pub interval: Duration,
+}
+
+impl StreamCoalesce {
+    pub fn new(
+        key: impl Fn(&Value) -> Option<String> + Send + Sync + 'static,
+        rule: impl Fn(&Value, Option<&Value>) -> Delivery + Send + Sync + 'static,
+    ) -> Self {
+        Self {
+            key: Arc::new(key),
+            rule: Arc::new(rule),
+            interval: Duration::from_millis(100),
+        }
+    }
+
+    pub fn interval(mut self, interval: Duration) -> Self {
+        self.interval = interval;
+        self
+    }
+}
+
+/// Holds the latest event per key between flushes.
+pub struct Coalescer {
+    cfg: StreamCoalesce,
+    pending: HashMap<String, Value>,
+    last: HashMap<String, Value>,
+}
+
+impl Coalescer {
+    pub fn new(cfg: StreamCoalesce) -> Self {
+        Self {
+            cfg,
+            pending: HashMap::new(),
+            last: HashMap::new(),
+        }
+    }
+
+    /// The event to send now, or `None` when it was held for [`Coalescer::flush`].
+    pub fn push(&mut self, event: Value) -> Option<Value> {
+        let Some(key) = (self.cfg.key)(&event) else {
+            return Some(event);
+        };
+        let delivery = (self.cfg.rule)(&event, self.last.get(&key));
+        match delivery {
+            Delivery::Coalesce => {
+                self.last.insert(key.clone(), event.clone());
+                self.pending.insert(key, event);
+                None
+            }
+            Delivery::Now => {
+                self.pending.remove(&key);
+                self.last.insert(key, event.clone());
+                Some(event)
+            }
+            Delivery::NowAndForget => {
+                self.pending.remove(&key);
+                self.last.remove(&key);
+                Some(event)
+            }
+        }
+    }
+
+    /// The latest held event per key.
+    pub fn flush(&mut self) -> Vec<Value> {
+        self.pending.drain().map(|(_, v)| v).collect()
+    }
+}
+
+/// Drain `rx` into `send` until the hub drops it (a newer subscription) or `send` returns false
+/// (the webview went away). Held events are flushed every `interval`, and before returning.
+pub fn run_forwarder(
+    rx: Receiver<Value>,
+    coalesce: Option<StreamCoalesce>,
+    mut send: impl FnMut(Value) -> bool,
+) {
+    let interval = coalesce
+        .as_ref()
+        .map(|c| c.interval)
+        .unwrap_or(Duration::from_millis(100));
+    let mut co = coalesce.map(Coalescer::new);
+    let mut last_flush = Instant::now();
+    loop {
+        match rx.recv_timeout(interval) {
+            Ok(event) => {
+                let out = match co.as_mut() {
+                    Some(c) => c.push(event),
+                    None => Some(event),
+                };
+                if let Some(out) = out {
+                    if !send(out) {
+                        return;
+                    }
+                }
+            }
+            Err(RecvTimeoutError::Timeout) => {}
+            Err(RecvTimeoutError::Disconnected) => {
+                if let Some(c) = co.as_mut() {
+                    for e in c.flush() {
+                        if !send(e) {
+                            return;
+                        }
+                    }
+                }
+                return;
+            }
+        }
+        if let Some(c) = co.as_mut() {
+            if last_flush.elapsed() >= interval {
+                for e in c.flush() {
+                    if !send(e) {
+                        return;
+                    }
+                }
+                last_flush = Instant::now();
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn events_published_after_subscribe_are_queued_before_any_snapshot() {
+        let hub = EventHub::new();
+        let rx = hub.subscribe_exclusive();
+        hub.publish(&json!({"n": 1}));
+        // The snapshot would be taken here; the event above is already queued.
+        hub.publish(&json!({"n": 2}));
+        assert_eq!(rx.try_recv().unwrap()["n"], 1);
+        assert_eq!(rx.try_recv().unwrap()["n"], 2);
+    }
+
+    #[test]
+    fn a_new_subscription_replaces_the_old_one() {
+        let hub = EventHub::new();
+        let old = hub.subscribe_exclusive();
+        let new = hub.subscribe_exclusive();
+        assert_eq!(hub.subscribers(), 1);
+        hub.publish(&json!(1));
+        assert!(matches!(old.try_recv(), Err(mpsc::TryRecvError::Disconnected)));
+        assert_eq!(new.try_recv().unwrap(), json!(1));
+    }
+
+    #[test]
+    fn a_dropped_receiver_is_pruned() {
+        let hub = EventHub::new();
+        drop(hub.subscribe_exclusive());
+        hub.publish(&json!(1));
+        assert_eq!(hub.subscribers(), 0);
+    }
+
+    fn progress_rule() -> StreamCoalesce {
+        StreamCoalesce::new(
+            |v| v["id"].as_str().map(str::to_owned),
+            |v, last| {
+                let stage = v["stage"].as_str();
+                if matches!(stage, Some("done" | "error")) {
+                    Delivery::NowAndForget
+                } else if last.map(|l| l["stage"].as_str()) != Some(stage) {
+                    Delivery::Now
+                } else {
+                    Delivery::Coalesce
+                }
+            },
+        )
+    }
+
+    fn ev(id: &str, stage: &str, pct: u64) -> Value {
+        json!({"id": id, "stage": stage, "pct": pct})
+    }
+
+    #[test]
+    fn same_stage_progress_collapses_to_the_latest() {
+        let mut c = Coalescer::new(progress_rule());
+        assert!(c.push(ev("a", "dl", 1)).is_some());
+        assert!(c.push(ev("a", "dl", 2)).is_none());
+        assert!(c.push(ev("a", "dl", 3)).is_none());
+        let flushed = c.flush();
+        assert_eq!(flushed.len(), 1);
+        assert_eq!(flushed[0]["pct"], 3);
+        assert!(c.flush().is_empty());
+    }
+
+    #[test]
+    fn a_stage_change_or_terminal_event_is_sent_and_supersedes_held_progress() {
+        let mut c = Coalescer::new(progress_rule());
+        c.push(ev("a", "dl", 10));
+        assert!(c.push(ev("a", "dl", 50)).is_none());
+        assert!(c.push(ev("a", "asr", 0)).is_some());
+        assert!(c.flush().is_empty());
+        assert!(c.push(ev("a", "asr", 5)).is_none());
+        assert!(c.push(ev("a", "done", 100)).is_some());
+        assert!(c.flush().is_empty());
+        // After a terminal event the same id starts over as a stage change.
+        assert!(c.push(ev("a", "dl", 1)).is_some());
+    }
+
+    #[test]
+    fn keys_coalesce_independently_and_unkeyed_events_pass() {
+        let mut c = Coalescer::new(progress_rule());
+        c.push(ev("a", "dl", 1));
+        c.push(ev("b", "dl", 1));
+        c.push(ev("a", "dl", 2));
+        c.push(ev("b", "dl", 2));
+        let mut f = c.flush();
+        f.sort_by_key(|v| v["id"].as_str().unwrap().to_owned());
+        assert_eq!(f.iter().map(|v| v["pct"].as_u64().unwrap()).collect::<Vec<_>>(), vec![2, 2]);
+        assert_eq!(c.push(json!({"call": "$lifecycle"})), Some(json!({"call": "$lifecycle"})));
+    }
+
+    #[test]
+    fn forwarder_flushes_held_events_on_interval_and_on_close() {
+        let (tx, rx) = mpsc::channel();
+        let out = Arc::new(Mutex::new(Vec::<Value>::new()));
+        let sink = out.clone();
+        let cfg = progress_rule().interval(Duration::from_millis(20));
+        let h = std::thread::spawn(move || {
+            run_forwarder(rx, Some(cfg), move |v| {
+                sink.lock().unwrap().push(v);
+                true
+            })
+        });
+        tx.send(ev("a", "dl", 1)).unwrap();
+        tx.send(ev("a", "dl", 2)).unwrap();
+        tx.send(ev("a", "dl", 3)).unwrap();
+        std::thread::sleep(Duration::from_millis(120));
+        drop(tx);
+        h.join().unwrap();
+        let got = out.lock().unwrap().clone();
+        assert_eq!(got.first().unwrap()["pct"], 1);
+        assert_eq!(got.last().unwrap()["pct"], 3);
+        assert!(got.len() <= 3);
+    }
+
+    #[test]
+    fn forwarder_stops_when_the_sink_refuses() {
+        let (tx, rx) = mpsc::channel();
+        tx.send(json!(1)).unwrap();
+        let mut n = 0;
+        run_forwarder(rx, None, |_| {
+            n += 1;
+            false
+        });
+        assert_eq!(n, 1);
+    }
+}

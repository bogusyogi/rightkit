+test('settings.importLocalStorage moves missing keys once and honours remove and overwrite', async () => {
+  const store = new Map([['theme', '"dark"'], ['count', '3'], ['plain', 'hello'], ['have', '"mine"']]);
+  const storage = { getItem: (k) => (store.has(k) ? store.get(k) : null), removeItem: (k) => store.delete(k) };
+  const patches = [];
+  const host = fakeHost({
+    handlers: {
+      rk_shell_engine_call: ({ method, params }) => {
+        if (method === 'rightkit.settings.get') return { values: { have: 'host' }, revision: 4 };
+        patches.push(params);
+        return { values: {}, revision: 5 };
+      },
+    },
+  });
+  const shell = createShell(host.transport);
+  const result = await shell.settings.importLocalStorage({
+    keys: ['theme', 'count', 'plain', 'have', 'absent'],
+    storage,
+    remove: true,
+  });
+  assert.deepEqual(result.imported, ['theme', 'count', 'plain']);
+  assert.deepEqual(result.skipped, ['have', 'absent']);
+  assert.deepEqual(patches, [{ patch: { theme: 'dark', count: 3, plain: 'hello' }, expectedRevision: 4 }]);
+  assert.deepEqual([...store.keys()], ['have'], 'imported keys were removed, the skipped one stays');
+  const again = await shell.settings.importLocalStorage({ keys: { have: 'renamed' }, storage, overwrite: true });
+  assert.deepEqual(again.imported, ['renamed']);
+  const nothing = await shell.settings.importLocalStorage({ keys: ['absent'], storage });
+  assert.deepEqual(nothing, { imported: [], skipped: ['absent'] });
+  assert.equal(patches.length, 2, 'no patch is sent when nothing is imported');
+});

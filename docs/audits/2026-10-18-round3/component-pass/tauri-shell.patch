diff --git a/crates/rightkit-tauri-shell/src/open_paths.rs b/crates/rightkit-tauri-shell/src/open_paths.rs
new file mode 100644
index 0000000..c152b63
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/open_paths.rs
@@ -0,0 +1,159 @@
+//! File paths the OS hands the app at launch or from a second launch, with a queue that waits for
+//! the renderer.
+//!
+//! Donor: ViewRight's `PendingOpenPaths` (`commands/dialogs.rs`) and its second-instance path
+//! filter. A path on the command line (`app.exe C:\docs\a.docx`, `app /tmp/a.md`) is queued until
+//! the renderer calls `rk_shell_open_paths_ready`, which returns everything queued and switches to
+//! live delivery: later paths (a second launch) are emitted as `rightkit-shell://open-paths`.
+//!
+//! The filter keeps path-shaped arguments only: flags (`-psn_...`, `--background`), URLs (those go
+//! through [`crate::open_url`] and deep links), empty or control-character arguments are dropped.
+//! It does not check that a path exists and grants nothing: the app routes every path through the
+//! path broker (`rk_shell_path_require`) before reading it.
+
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+
+use tauri::{AppHandle, Emitter, Manager, Wry};
+
+use crate::{ShellState, EVENT_OPEN_PATHS};
+
+/// Most paths held while waiting for the renderer; the oldest are kept, extra ones are dropped.
+pub const MAX_QUEUED: usize = 256;
+const MAX_PATH_LEN: usize = 32_768;
+
+/// True when `arg` can be a file path argument.
+pub fn is_path_arg(arg: &str) -> bool {
+    let a = arg.trim();
+    !a.is_empty()
+        && a.len() <= MAX_PATH_LEN
+        && !a.starts_with('-')
+        && !a.chars().any(char::is_control)
+        && !crate::open_url::is_url(a)
+}
+
+/// The path-shaped entries of `args` (the program name is the caller's to skip).
+pub fn file_paths_from_args<I, S>(args: I) -> Vec<PathBuf>
+where
+    I: IntoIterator<Item = S>,
+    S: Into<std::ffi::OsString>,
+{
+    args.into_iter()
+        .map(Into::into)
+        .filter(|a: &std::ffi::OsString| is_path_arg(&a.to_string_lossy()))
+        .map(PathBuf::from)
+        .collect()
+}
+
+/// The paths on a forwarded second-launch `argv` (program name skipped). A relative path is joined
+/// onto the second launch's `cwd`, because the primary's own working directory is unrelated.
+pub fn file_paths_from_argv(argv: &[String], cwd: &str) -> Vec<PathBuf> {
+    let base = Path::new(cwd);
+    file_paths_from_args(argv.iter().skip(1).map(String::as_str))
+        .into_iter()
+        .map(|p| {
+            if p.is_absolute() || !base.is_absolute() {
+                p
+            } else {
+                base.join(p)
+            }
+        })
+        .collect()
+}
+
+#[derive(Default)]
+struct State {
+    paths: Vec<PathBuf>,
+    renderer_ready: bool,
+}
+
+/// Paths queued until the renderer is ready.
+#[derive(Default)]
+pub struct PendingOpenPaths(Mutex<State>);
+
+impl PendingOpenPaths {
+    /// Empty queue.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Seed from this process's own command line.
+    pub fn from_env() -> Self {
+        Self::from_args(std::env::args_os().skip(1))
+    }
+
+    /// Seed from `args` (program name already skipped), filtered by [`is_path_arg`].
+    pub fn from_args<I, S>(args: I) -> Self
+    where
+        I: IntoIterator<Item = S>,
+        S: Into<std::ffi::OsString>,
+    {
+        let mut paths = file_paths_from_args(args);
+        paths.truncate(MAX_QUEUED);
+        Self(Mutex::new(State {
+            paths,
+            renderer_ready: false,
+        }))
+    }
+
+    /// The renderer listens: take everything queued and deliver later paths live.
+    pub fn mark_ready_and_drain(&self) -> Result<Vec<PathBuf>, String> {
+        let mut state = self
+            .0
+            .lock()
+            .map_err(|_| "pending open path lock poisoned".to_string())?;
+        state.renderer_ready = true;
+        Ok(state.paths.drain(..).collect())
+    }
+
+    /// Ready: hand `paths` back to deliver now. Not ready: queue them and return nothing.
+    pub fn queue_or_take(&self, paths: Vec<PathBuf>) -> Result<Vec<PathBuf>, String> {
+        let mut state = self
+            .0
+            .lock()
+            .map_err(|_| "pending open path lock poisoned".to_string())?;
+        if state.renderer_ready {
+            Ok(paths)
+        } else {
+            let room = MAX_QUEUED.saturating_sub(state.paths.len());
+            state.paths.extend(paths.into_iter().take(room));
+            Ok(Vec::new())
+        }
+    }
+
+    /// Number of paths waiting for the renderer.
+    pub fn pending(&self) -> usize {
+        self.0.lock().map(|s| s.paths.len()).unwrap_or(0)
+    }
+
+    /// True once `mark_ready_and_drain` ran.
+    pub fn is_ready(&self) -> bool {
+        self.0.lock().map(|s| s.renderer_ready).unwrap_or(false)
+    }
+}
+
+/// Queue or emit `paths` (see [`PendingOpenPaths::queue_or_take`]). An app calls this for paths it
+/// learns of itself, such as macOS `RunEvent::Opened` file URLs it converted.
+pub fn deliver(app: &AppHandle<Wry>, paths: Vec<PathBuf>) {
+    if paths.is_empty() {
+        return;
+    }
+    let Some(state) = app.try_state::<ShellState>() else {
+        return;
+    };
+    if let Ok(now) = state.open_paths.queue_or_take(paths) {
+        if !now.is_empty() {
+            let list: Vec<String> = now
+                .iter()
+                .map(|p| p.to_string_lossy().into_owned())
+                .collect();
+            let _ = app.emit(EVENT_OPEN_PATHS, serde_json::json!({ "paths": list }));
+        }
+    }
+}
+
+/// Deliver the file paths on a forwarded second launch's `argv`. The shell calls this for every
+/// second launch, including when the app replaces the default behaviour with `on_second_instance`.
+pub fn deliver_argv(app: &AppHandle<Wry>, argv: &[String], cwd: &str) {
+    deliver(app, file_paths_from_argv(argv, cwd));
+}

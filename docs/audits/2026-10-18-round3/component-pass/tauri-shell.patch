+#![cfg(feature = "tauri")]
+//! Public-API checks for `associations`: validation, selection and the JSON wire shape the
+//! renderer bridge sends. The OS calls are exercised on a Mac and on Windows.
+
+use rightkit_tauri_shell::associations::{select_groups, validate_spec, AssociationSpec};
+
+fn spec_from(json: &str) -> AssociationSpec {
+    serde_json::from_str(json).expect("spec json")
+}
+
+#[test]
+fn a_renderer_spec_validates_and_normalises() {
+    let spec = spec_from(
+        r#"{"bundleId":"app.example","groups":[
+            {"id":"md","extensions":[".MD","markdown"],"utis":["net.daringfireball.markdown"],"windowsProgId":"Example Markdown"},
+            {"id":"pdf","extensions":["pdf"]}]}"#,
+    );
+    let spec = validate_spec(&spec).unwrap();
+    assert_eq!(spec.groups[0].extensions, ["md", "markdown"]);
+    assert_eq!(spec.groups[1].windows_prog_id, None);
+    let ids = vec!["pdf".to_owned()];
+    let picked = select_groups(&spec, Some(&ids)).unwrap();
+    assert_eq!(picked.len(), 1);
+    assert_eq!(picked[0].id, "pdf");
+}
+
+#[test]
+fn hostile_input_is_refused_before_any_os_call() {
+    for json in [
+        r#"{"bundleId":"","groups":[{"id":"a","extensions":["md"]}]}"#,
+        r#"{"bundleId":"app.example","groups":[]}"#,
+        r#"{"bundleId":"app.example","groups":[{"id":"a","extensions":["../etc"]}]}"#,
+        r#"{"bundleId":"app.example","groups":[{"id":"a","utis":["x y"]}]}"#,
+        r#"{"bundleId":"app.example","groups":[{"id":"a"}]}"#,
+    ] {
+        assert!(validate_spec(&spec_from(json)).is_err(), "{json}");
+    }
+}

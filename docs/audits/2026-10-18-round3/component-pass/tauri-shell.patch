new file mode 100644
index 0000000..337d823
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/consent.rs
@@ -0,0 +1,718 @@
+//! Native consent for an external protocol or a host enrollment, with per-origin remembered grants
+//! (Orthic-Labs/rightkit#640). Donor: CodeRight `consent_dialog.rs`.
+//!
+//! A page asks the shell to open something outside the web (a `mailto:`-style protocol handler) or
+//! to enroll a hosting origin. The answer comes from the person through an OS dialog the page
+//! cannot draw, script, restyle or click, so it cannot be spoofed: three choices, [`ConsentChoice`]
+//! `Deny`, `AllowOnce` and `AlwaysAllow`.
+//!
+//! Rules, all decided by pure functions so they are unit-tested:
+//!
+//! * A grant is remembered only for the **pinned** origin, and only when the page the person is
+//!   looking at (the visible top-level origin) *is* the pinned origin ([`consent_surface`]). A page
+//!   reached by a foreign redirect gets `Deny` / `AllowOnce` only: the dialog does not offer
+//!   "Always allow", and an earlier grant is not consulted for it.
+//! * Grants are per origin lists in the app's settings document (`allowedHostingOrigins`, a
+//!   per-origin protocol list). [`GrantStore`] is the app's persistence; [`grants_in`] and
+//!   [`add_grant`] are the helpers for a JSON settings value. A malformed grant (not an array, a
+//!   non-string entry) reads as no grant, never as a wildcard; a duplicate is not added twice.
+//! * Fail closed: no dialog available, a QA run that must stay hidden, or any error means `Deny`;
+//!   a store that cannot save an "Always allow" degrades it to `AllowOnce`.
+//!
+//! [`decide`] is the whole policy over an `ask` closure; [`confirm`] is [`decide`] with the native
+//! dialog. Nothing here needs Tauri.
+
+use std::fmt::Display;
+
+use serde_json::{json, Value};
+
+use crate::ShellError;
+
+/// What the person chose.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ConsentChoice {
+    /// Refuse this time and remember nothing.
+    Deny,
+    /// Allow this one request.
+    AllowOnce,
+    /// Allow now and remember it for the pinned origin.
+    AlwaysAllow,
+}
+
+impl ConsentChoice {
+    /// Whether the request may go ahead.
+    pub fn allowed(self) -> bool {
+        self != ConsentChoice::Deny
+    }
+}
+
+/// Relation of the page the person sees to the origin the app pinned.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ConsentSurface {
+    /// The visible top-level origin is the pinned origin: grants apply and can be created.
+    Pinned,
+    /// A different origin (a foreign redirect, a popup): allow-once only.
+    Foreign,
+    /// Pinned or current origin missing or unparsable: treated like `Foreign`.
+    Unknown,
+}
+
+impl ConsentSurface {
+    /// Whether "Always allow" may be offered and grants consulted.
+    pub fn can_remember(self) -> bool {
+        self == ConsentSurface::Pinned
+    }
+}
+
+/// `scheme://host[:port]` of a URL, lower-cased, default ports (80, 443) dropped, credentials and
+/// path removed. `None` when there is no scheme, no host, or the scheme is not `http` / `https`.
+pub fn origin_of(url: &str) -> Option<String> {
+    let url = url.trim();
+    let (scheme, rest) = url.split_once("://")?;
+    let scheme = scheme.to_ascii_lowercase();
+    if scheme != "http" && scheme != "https" {
+        return None;
+    }
+    let authority = rest.split(['/', '?', '#']).next()?;
+    let host_port = authority.rsplit('@').next()?;
+    if host_port.is_empty() || host_port.chars().any(|c| c.is_control() || c.is_whitespace()) {
+        return None;
+    }
+    let (host, port) = if let Some(stripped) = host_port.strip_prefix('[') {
+        // IPv6 literal: [::1]:8080
+        let (h, after) = stripped.split_once(']')?;
+        (format!("[{h}]"), after.strip_prefix(':').map(str::to_owned))
+    } else {
+        match host_port.rsplit_once(':') {
+            Some((h, p)) => (h.to_owned(), Some(p.to_owned())),
+            None => (host_port.to_owned(), None),
+        }
+    };
+    if host.is_empty() || host == "[]" {
+        return None;
+    }
+    let port = match port {
+        Some(p) if p.is_empty() => None,
+        Some(p) => {
+            let n: u16 = p.parse().ok()?;
+            let default = if scheme == "https" { 443 } else { 80 };
+            (n != default).then_some(n)
+        }
+        None => None,
+    };
+    let host = host.to_ascii_lowercase();
+    Some(match port {
+        Some(p) => format!("{scheme}://{host}:{p}"),
+        None => format!("{scheme}://{host}"),
+    })
+}
+
+/// How the visible page relates to the pinned origin. Both are URLs or origins; they are compared
+/// as origins ([`origin_of`]), never as strings.
+pub fn consent_surface(pinned: Option<&str>, current: Option<&str>) -> ConsentSurface {
+    match (pinned.and_then(origin_of), current.and_then(origin_of)) {
+        (Some(p), Some(c)) if p == c => ConsentSurface::Pinned,
+        (Some(_), Some(_)) => ConsentSurface::Foreign,
+        _ => ConsentSurface::Unknown,
+    }
+}
+
+/// What the page asks for.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ConsentKind {
+    /// Open a non-web protocol (`zoommtg`, `slack`, ...). The scheme alone, lower-case.
+    ExternalProtocol { scheme: String },
+    /// Enroll a hosting origin (the origin that will serve the app's content).
+    HostEnrollment { host_origin: String },
+}
+
+impl ConsentKind {
+    /// The grant list this kind is remembered in, for one pinned origin: a stable field name and
+    /// the entry. A protocol is remembered per scheme; an enrollment per origin.
+    pub fn grant_key(&self) -> Option<(&'static str, String)> {
+        match self {
+            ConsentKind::ExternalProtocol { scheme } => {
+                valid_scheme(scheme).then(|| (FIELD_PROTOCOLS, scheme.to_ascii_lowercase()))
+            }
+            ConsentKind::HostEnrollment { host_origin } => {
+                origin_of(host_origin).map(|o| (FIELD_HOSTING_ORIGINS, o))
+            }
+        }
+    }
+}
+
+/// Settings field holding the per-origin external-protocol grants.
+pub const FIELD_PROTOCOLS: &str = "allowedProtocolsByOrigin";
+/// Settings field holding the per-origin hosting-origin grants.
+pub const FIELD_HOSTING_ORIGINS: &str = "allowedHostingOrigins";
+
+/// RFC 3986 scheme: a letter, then letters, digits, `+`, `-`, `.`; at most 32 characters; and
+/// never a web or script scheme.
+pub fn valid_scheme(scheme: &str) -> bool {
+    let s = scheme.to_ascii_lowercase();
+    let mut chars = s.chars();
+    let ok = chars.next().is_some_and(|c| c.is_ascii_lowercase())
+        && s.len() <= 32
+        && chars.all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || matches!(c, '+' | '-' | '.'));
+    ok && !matches!(s.as_str(), "http" | "https" | "javascript" | "data" | "blob" | "file" | "about")
+}
+
+/// The app's grant persistence (typically its `settings.json`). Both methods address one
+/// `(pinned origin, field, entry)` triple.
+pub trait GrantStore {
+    /// Whether `entry` is granted in `field` for `origin`. A store that cannot read answers
+    /// `false` (fail closed).
+    fn is_granted(&self, origin: &str, field: &str, entry: &str) -> bool;
+    /// Remember it. Must not add a duplicate. An error degrades "Always allow" to "Allow once".
+    fn grant(&self, origin: &str, field: &str, entry: &str) -> Result<(), ShellError>;
+}
+
+/// The entries of `field` for `origin` in a settings value shaped `{ field: { origin: [entry...] } }`.
+/// Anything malformed (a missing key, a non-object, a non-array, a non-string entry) yields no
+/// entries for that part: a bad grant never widens access.
+pub fn grants_in(settings: &Value, field: &str, origin: &str) -> Vec<String> {
+    settings
+        .get(field)
+        .and_then(Value::as_object)
+        .and_then(|per_origin| per_origin.get(origin))
+        .and_then(Value::as_array)
+        .map(|list| {
+            list.iter()
+                .filter_map(Value::as_str)
+                .map(str::to_owned)
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// Add `entry` to `field` for `origin` in `settings`, creating the object and list as needed and
+/// replacing a malformed one. Returns `true` when it was added, `false` when it was already there.
+pub fn add_grant(settings: &mut Value, field: &str, origin: &str, entry: &str) -> bool {
+    if grants_in(settings, field, origin).iter().any(|e| e == entry) {
+        return false;
+    }
+    if !settings.is_object() {
+        *settings = json!({});
+    }
+    let root = settings.as_object_mut().expect("object just ensured");
+    let per_origin = root
+        .entry(field.to_owned())
+        .or_insert_with(|| json!({}));
+    if !per_origin.is_object() {
+        *per_origin = json!({});
+    }
+    let per_origin = per_origin.as_object_mut().expect("object just ensured");
+    let list = per_origin
+        .entry(origin.to_owned())
+        .or_insert_with(|| json!([]));
+    if !list.is_array() {
+        *list = json!([]);
+    }
+    list.as_array_mut()
+        .expect("array just ensured")
+        .push(Value::String(entry.to_owned()));
+    true
+}
+
+/// One consent question.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ConsentRequest {
+    pub kind: ConsentKind,
+    /// The origin the app pinned (where its content is served from).
+    pub pinned_origin: Option<String>,
+    /// URL of the visible top-level page asking.
+    pub current_url: Option<String>,
+    /// Shown in the dialog title.
+    pub app_name: String,
+}
+
+/// What the dialog says. Built by [`prompt_for`] from sanitized parts only.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Prompt {
+    pub title: String,
+    pub body: String,
+    /// Whether "Always allow" is offered.
+    pub offer_always: bool,
+}
+
+fn clean(text: &str, max: usize) -> String {
+    let t: String = text.chars().filter(|c| !c.is_control()).collect();
+    let t = t.trim();
+    if t.chars().count() <= max {
+        t.to_owned()
+    } else {
+        let mut cut: String = t.chars().take(max - 1).collect();
+        cut.push('\u{2026}');
+        cut
+    }
+}
+
+/// The dialog text for `request` on `surface`. Only the app name, the scheme or origin, and the
+/// visible origin appear, each cleaned and cut; page-supplied free text never does.
+pub fn prompt_for(request: &ConsentRequest, surface: ConsentSurface) -> Prompt {
+    let app = clean(&request.app_name, 60);
+    let app = if app.is_empty() { "This app".to_owned() } else { app };
+    let from = request
+        .current_url
+        .as_deref()
+        .and_then(origin_of)
+        .map(|o| clean(&o, 120))
+        .unwrap_or_else(|| "an unknown page".to_owned());
+    let what = match &request.kind {
+        ConsentKind::ExternalProtocol { scheme } => {
+            format!("open a link with the {} protocol in another application", clean(scheme, 40))
+        }
+        ConsentKind::HostEnrollment { host_origin } => format!(
+            "use {} as a place that serves this app's content",
+            clean(&origin_of(host_origin).unwrap_or_else(|| host_origin.clone()), 120)
+        ),
+    };
+    let mut body = format!("The page at {from} wants to {what}.");
+    if !surface.can_remember() {
+        body.push_str("\n\nThis page is not the app's own page, so the choice is for this time only.");
+    }
+    Prompt {
+        title: format!("{app}: permission needed"),
+        body,
+        offer_always: surface.can_remember(),
+    }
+}
+
+/// The whole policy. `ask` shows the prompt and returns the person's choice; it is not called when
+/// an existing grant applies (the answer is then `AlwaysAllow`). A refused kind (invalid scheme or origin) is `Deny` without asking.
+pub fn decide(
+    store: &dyn GrantStore,
+    request: &ConsentRequest,
+    ask: impl FnOnce(&Prompt) -> ConsentChoice,
+) -> ConsentChoice {
+    let Some((field, entry)) = request.kind.grant_key() else {
+        return ConsentChoice::Deny;
+    };
+    let surface = consent_surface(request.pinned_origin.as_deref(), request.current_url.as_deref());
+    let pinned = request.pinned_origin.as_deref().and_then(origin_of);
+    if surface.can_remember() {
+        if let Some(p) = &pinned {
+            if store.is_granted(p, field, &entry) {
+                return ConsentChoice::AlwaysAllow;
+            }
+        }
+    }
+    let prompt = prompt_for(request, surface);
+    let choice = ask(&prompt);
+    match choice {
+        // A foreign page can never create a grant, even if a dialog implementation returned one.
+        ConsentChoice::AlwaysAllow if !surface.can_remember() => ConsentChoice::AllowOnce,
+        ConsentChoice::AlwaysAllow => match pinned {
+            Some(p) => match store.grant(&p, field, &entry) {
+                Ok(()) => ConsentChoice::AlwaysAllow,
+                Err(_) => ConsentChoice::AllowOnce,
+            },
+            None => ConsentChoice::AllowOnce,
+        },
+        other => other,
+    }
+}
+
+/// [`decide`] with the native OS dialog. `Deny` when no dialog can be shown.
+pub fn confirm(store: &dyn GrantStore, request: &ConsentRequest) -> ConsentChoice {
+    decide(store, request, native_prompt)
+}
+
+/// Show `prompt` natively. `Deny` for anything but an explicit allow, a hidden QA run, or a dialog
+/// that cannot be shown.
+pub fn native_prompt(prompt: &Prompt) -> ConsentChoice {
+    if !crate::startup_error::dialog_allowed() {
+        return ConsentChoice::Deny;
+    }
+    platform_prompt(prompt)
+}
+
+/// AppleScript for the macOS dialog; the answer is `button returned:<label>`.
+pub fn applescript_for(prompt: &Prompt) -> String {
+    let buttons = if prompt.offer_always {
+        "{\"Deny\", \"Allow once\", \"Always allow\"}"
+    } else {
+        "{\"Deny\", \"Allow once\"}"
+    };
+    format!(
+        "display dialog \"{}\" with title \"{}\" buttons {} default button \"Deny\" cancel button \"Deny\" with icon caution",
+        crate::startup_error::applescript_escape(&prompt.body),
+        crate::startup_error::applescript_escape(&prompt.title),
+        buttons
+    )
+}
+
+/// Map the text `osascript` / `zenity` printed to a choice. Anything unrecognised is `Deny`.
+pub fn parse_choice(output: &str) -> ConsentChoice {
+    let t = output.trim();
+    let label = t.strip_prefix("button returned:").unwrap_or(t);
+    let label = label.split(',').next().unwrap_or("").trim();
+    match label {
+        "Allow once" => ConsentChoice::AllowOnce,
+        "Always allow" => ConsentChoice::AlwaysAllow,
+        _ => ConsentChoice::Deny,
+    }
+}
+
+/// Map a Windows `MessageBoxW` result to a choice. With three buttons `IDYES` is "Always allow",
+/// `IDNO` is "Allow once"; with two, `IDOK` is "Allow once". Everything else is `Deny`.
+pub fn choice_from_message_box(result: i32, offer_always: bool) -> ConsentChoice {
+    const IDOK: i32 = 1;
+    const IDYES: i32 = 6;
+    const IDNO: i32 = 7;
+    match (offer_always, result) {
+        (true, IDYES) => ConsentChoice::AlwaysAllow,
+        (true, IDNO) => ConsentChoice::AllowOnce,
+        (false, IDOK) => ConsentChoice::AllowOnce,
+        _ => ConsentChoice::Deny,
+    }
+}
+
+#[cfg(windows)]
+fn platform_prompt(prompt: &Prompt) -> ConsentChoice {
+    #[link(name = "user32")]
+    extern "system" {
+        fn MessageBoxW(
+            hwnd: *mut std::ffi::c_void,
+            text: *const u16,
+            caption: *const u16,
+            kind: u32,
+        ) -> i32;
+    }
+    const MB_OKCANCEL: u32 = 0x1;
+    const MB_YESNOCANCEL: u32 = 0x3;
+    const MB_ICONWARNING: u32 = 0x30;
+    const MB_DEFBUTTON3: u32 = 0x200;
+    const MB_DEFBUTTON2: u32 = 0x100;
+    const MB_SETFOREGROUND: u32 = 0x0001_0000;
+    const MB_TOPMOST: u32 = 0x0004_0000;
+    let (body, kind) = if prompt.offer_always {
+        (
+            format!(
+                "{}\n\nYes: Always allow\nNo: Allow once\nCancel: Deny",
+                prompt.body
+            ),
+            MB_YESNOCANCEL | MB_DEFBUTTON3,
+        )
+    } else {
+        (
+            format!("{}\n\nOK: Allow once\nCancel: Deny", prompt.body),
+            MB_OKCANCEL | MB_DEFBUTTON2,
+        )
+    };
+    let wide = |s: &str| -> Vec<u16> { s.encode_utf16().chain(std::iter::once(0)).collect() };
+    let (text, caption) = (wide(&body), wide(&prompt.title));
+    // SAFETY: both buffers are NUL-terminated UTF-16 that outlive the call; a null owner window
+    // makes the box application-modal.
+    let result = unsafe {
+        MessageBoxW(
+            std::ptr::null_mut(),
+            text.as_ptr(),
+            caption.as_ptr(),
+            kind | MB_ICONWARNING | MB_SETFOREGROUND | MB_TOPMOST,
+        )
+    };
+    choice_from_message_box(result, prompt.offer_always)
+}
+
+#[cfg(target_os = "macos")]
+fn platform_prompt(prompt: &Prompt) -> ConsentChoice {
+    let out = std::process::Command::new("/usr/bin/osascript")
+        .arg("-e")
+        .arg(applescript_for(prompt))
+        .stdin(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .output();
+    match out {
+        Ok(o) if o.status.success() => parse_choice(&String::from_utf8_lossy(&o.stdout)),
+        _ => ConsentChoice::Deny,
+    }
+}
+
+#[cfg(all(unix, not(target_os = "macos")))]
+fn platform_prompt(prompt: &Prompt) -> ConsentChoice {
+    use std::process::{Command, Stdio};
+    let mut cmd = Command::new("zenity");
+    cmd.args([
+        "--question",
+        "--title",
+        &prompt.title,
+        "--text",
+        &prompt.body,
+        "--ok-label",
+        "Allow once",
+        "--cancel-label",
+        "Deny",
+    ]);
+    if prompt.offer_always {
+        cmd.args(["--extra-button", "Always allow"]);
+    }
+    let Ok(out) = cmd
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+    else {
+        return ConsentChoice::Deny;
+    };
+    // OK exits 0 with no output; the extra button prints its label and exits 1; Cancel prints nothing.
+    let printed = String::from_utf8_lossy(&out.stdout);
+    if printed.trim() == "Always allow" && prompt.offer_always {
+        ConsentChoice::AlwaysAllow
+    } else if out.status.success() {
+        ConsentChoice::AllowOnce
+    } else {
+        ConsentChoice::Deny
+    }
+}
+
+#[cfg(not(any(windows, unix)))]
+fn platform_prompt(_prompt: &Prompt) -> ConsentChoice {
+    ConsentChoice::Deny
+}
+
+impl Display for ConsentChoice {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            ConsentChoice::Deny => "deny",
+            ConsentChoice::AllowOnce => "allow-once",
+            ConsentChoice::AlwaysAllow => "always-allow",
+        })
+    }
+}

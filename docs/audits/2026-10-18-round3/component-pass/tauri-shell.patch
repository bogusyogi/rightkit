--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/dragdrop.rs
@@ -0,0 +1,135 @@
+//! Webview drag-drop: the native phases (enter, over, drop, leave) as one shell event, with the
+//! dropped files granted in the [`PathBroker`] before the page sees them. Donor: ScrapeRight
+//! `App.tsx` / `dropOverlay.ts` (page-side `onDragDropEvent`), moved native so the page never gets
+//! an ungranted path.
+//!
+//! Opt in with `ShellBuilder::drop_events(true)`. The shell then emits [`EVENT_DROP`] to the window
+//! the drag is over:
+//! `{phase: "enter"|"over"|"drop"|"leave", label, x, y, paths?, rejected?}`. Only `drop` carries
+//! paths, and each is already granted: `paths` are display paths the page may hand to broker-checked
+//! commands; `rejected` is `[{path, reason}]` for anything that could not be granted (a folder, a
+//! missing file). `x`/`y` are physical pixels in the window. Native drag handling stays on (Tauri's
+//! default), which on Windows is why the HTML5 `dragenter`/`dragleave` events do not fire; the page
+//! drives its overlay from these phases ([`overlay_visible`] is the rule).
+
+use std::path::PathBuf;
+
+use serde_json::{json, Value};
+
+use crate::broker::{path_to_string, PathBroker};
+
+pub const EVENT_DROP: &str = "rightkit-shell://drop";
+
+/// The native phases.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Phase {
+    Enter,
+    Over,
+    Drop,
+    Leave,
+}
+
+impl Phase {
+    pub fn name(self) -> &'static str {
+        match self {
+            Phase::Enter => "enter",
+            Phase::Over => "over",
+            Phase::Drop => "drop",
+            Phase::Leave => "leave",
+        }
+    }
+}
+
+/// Whether the drop overlay is shown after `phase`: `enter` and `over` show it; `leave` and `drop`
+/// hide it.
+pub fn overlay_visible(phase: Phase) -> bool {
+    matches!(phase, Phase::Enter | Phase::Over)
+}
+
+/// Grant each dropped path. Returns the display paths granted and the `{path, reason}` of the rest.
+pub fn grant_dropped(broker: &PathBroker, paths: &[PathBuf]) -> (Vec<String>, Vec<Value>) {
+    let mut granted = Vec::new();
+    let mut rejected = Vec::new();
+    for p in paths {
+        if p.is_dir() {
+            rejected.push(json!({"path": path_to_string(p), "reason": "folders are not accepted"}));
+            continue;
+        }
+        match broker.grant_file(p) {
+            Ok(display) => granted.push(display),
+            Err(e) => rejected.push(json!({"path": path_to_string(p), "reason": e.message()})),
+        }
+    }
+    (granted, rejected)
+}
+
+/// The event payload for one phase. Grants only on `Drop`.
+pub fn payload(
+    broker: &PathBroker,
+    phase: Phase,
+    label: &str,
+    position: (f64, f64),
+    paths: &[PathBuf],
+) -> Value {
+    let mut v = json!({"phase": phase.name(), "label": label, "x": position.0, "y": position.1});
+    if phase == Phase::Drop {
+        let (granted, rejected) = grant_dropped(broker, paths);
+        v["paths"] = json!(granted);
+        v["rejected"] = Value::Array(rejected);
+    }
+    v
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn overlay_follows_the_native_phases() {
+        assert!(overlay_visible(Phase::Enter));
+        assert!(overlay_visible(Phase::Over));
+        assert!(!overlay_visible(Phase::Leave));
+        assert!(!overlay_visible(Phase::Drop));
+    }
+
+    #[test]
+    fn a_drop_grants_files_and_rejects_folders_and_missing_paths() {
+        let dir = tempfile::tempdir().unwrap();
+        let file = dir.path().join("a.png");
+        std::fs::write(&file, b"x").unwrap();
+        let folder = dir.path().join("sub");
+        std::fs::create_dir(&folder).unwrap();
+        let missing = dir.path().join("gone.png");
+        let broker = PathBroker::new();
+        let v = payload(
+            &broker,
+            Phase::Drop,
+            "main",
+            (10.0, 20.0),
+            &[file.clone(), folder, missing],
+        );
+        assert_eq!(v["phase"], "drop");
+        assert_eq!(v["label"], "main");
+        assert_eq!(v["x"], 10.0);
+        let paths = v["paths"].as_array().unwrap();
+        assert_eq!(paths.len(), 1);
+        let granted = paths[0].as_str().unwrap();
+        // The grant is real: the broker accepts the path it just handed out.
+        assert!(broker.require_file(granted).is_ok());
+        assert_eq!(v["rejected"].as_array().unwrap().len(), 2);
+    }
+
+    #[test]
+    fn only_a_drop_grants_and_only_a_drop_carries_paths() {
+        let dir = tempfile::tempdir().unwrap();
+        let file = dir.path().join("a.png");
+        std::fs::write(&file, b"x").unwrap();
+        let broker = PathBroker::new();
+        for phase in [Phase::Enter, Phase::Over, Phase::Leave] {
+            let v = payload(&broker, phase, "main", (0.0, 0.0), &[file.clone()]);
+            assert!(v.get("paths").is_none(), "{phase:?}");
+            assert_eq!(v["phase"], phase.name());
+        }
+        assert!(broker.require_file(&path_to_string(&file)).is_err());
+    }
+}

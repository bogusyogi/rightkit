@@ -0,0 +1,313 @@
+//! Plain-Rust native pickers for a folder and for an application, with no Tauri window or plugin
+//! (Orthic-Labs/rightkit#414). Donor: Pulse `engine/src/files.rs` (`choose folder` / `choose
+//! application` through `osascript` and PowerShell).
+//!
+//! * [`pick_folder`] returns the chosen directory.
+//! * [`pick_app`] returns the chosen application: a `.app` bundle on macOS, an `.exe` on Windows,
+//!   an executable or `.desktop` file on Linux.
+//!
+//! Both block until the person answers, so call them from a worker thread, never the UI thread.
+//! `Ok(None)` means the person cancelled. The prompt and start folder reach the OS dialog as data
+//! (environment variables for PowerShell, an escaped string literal for AppleScript, separate argv
+//! elements for zenity and kdialog), never spliced into a shell command line. A dialog that cannot
+//! be shown at all (no `osascript`, no PowerShell, no zenity or kdialog) is an error, not a cancel.
+//!
+//! For a pick that must also grant the path to a webview, use the `dialog` feature's
+//! `rk_shell_pick_files` / `rk_shell_pick_folder`, which run inside a Tauri app and go through the
+//! path broker.
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+use crate::ShellError;
+
+/// What to pick.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PickKind {
+    Folder,
+    App,
+}
+
+/// Longest prompt shown, in characters.
+pub const MAX_PROMPT_CHARS: usize = 200;
+
+/// Clean a prompt: control characters removed, trimmed, cut to [`MAX_PROMPT_CHARS`]. A blank prompt
+/// becomes `default`.
+pub fn clean_prompt(prompt: &str, default: &str) -> String {
+    let cleaned: String = prompt.chars().filter(|c| !c.is_control()).collect();
+    let cleaned = cleaned.trim();
+    let cleaned = if cleaned.is_empty() { default } else { cleaned };
+    cleaned.chars().take(MAX_PROMPT_CHARS).collect()
+}
+
+/// `text` as the inside of an AppleScript double-quoted string literal.
+pub fn applescript_quote(text: &str) -> String {
+    let mut out = String::with_capacity(text.len() + 4);
+    for c in text.chars() {
+        match c {
+            '\\' => out.push_str("\\\\"),
+            '"' => out.push_str("\\\""),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+/// The AppleScript for the macOS pickers. `initial` (an existing directory) sets the start folder;
+/// the result is the POSIX path on one line.
+pub fn applescript_for(kind: PickKind, prompt: &str, initial: Option<&Path>) -> String {
+    let prompt = applescript_quote(&clean_prompt(
+        prompt,
+        match kind {
+            PickKind::Folder => "Choose a folder",
+            PickKind::App => "Choose an application",
+        },
+    ));
+    let location = initial
+        .filter(|p| p.is_dir())
+        .map(|p| {
+            format!(
+                " default location POSIX file \"{}\"",
+                applescript_quote(&p.to_string_lossy())
+            )
+        })
+        .unwrap_or_default();
+    match kind {
+        PickKind::Folder => format!(
+            "POSIX path of (choose folder with prompt \"{prompt}\"{location})"
+        ),
+        PickKind::App => format!(
+            "POSIX path of (choose file of type {{\"com.apple.application-bundle\"}} with prompt \"{prompt}\"{location})"
+        ),
+    }
+}
+
+/// The PowerShell script for the Windows pickers. Prompt and start folder are read from the
+/// `RK_PICK_PROMPT` and `RK_PICK_INITIAL` environment variables, never spliced in.
+pub fn powershell_for(kind: PickKind) -> &'static str {
+    match kind {
+        PickKind::Folder => {
+            "Add-Type -AssemblyName System.Windows.Forms; \
+             [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; \
+             $d = New-Object System.Windows.Forms.FolderBrowserDialog; \
+             $d.Description = $env:RK_PICK_PROMPT; \
+             if ($env:RK_PICK_INITIAL -and (Test-Path -LiteralPath $env:RK_PICK_INITIAL -PathType Container)) { $d.SelectedPath = $env:RK_PICK_INITIAL }; \
+             if ($d.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) { [Console]::Out.Write($d.SelectedPath) }"
+        }
+        PickKind::App => {
+            "Add-Type -AssemblyName System.Windows.Forms; \
+             [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; \
+             $d = New-Object System.Windows.Forms.OpenFileDialog; \
+             $d.Title = $env:RK_PICK_PROMPT; \
+             $d.Filter = 'Applications (*.exe)|*.exe'; \
+             $d.CheckFileExists = $true; \
+             if ($env:RK_PICK_INITIAL -and (Test-Path -LiteralPath $env:RK_PICK_INITIAL -PathType Container)) { $d.InitialDirectory = $env:RK_PICK_INITIAL }; \
+             if ($d.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) { [Console]::Out.Write($d.FileName) }"
+        }
+    }
+}
+
+/// The path a picker printed: one line, line ending removed; an empty answer is a cancel. A
+/// macOS folder comes with a trailing `/`, which is dropped (except for the root).
+pub fn parse_pick_output(stdout: &[u8]) -> Option<PathBuf> {
+    let text = String::from_utf8_lossy(stdout);
+    let line = text.lines().next()?.trim_end_matches(['\r', '\n']);
+    let line = line.trim();
+    if line.is_empty() {
+        return None;
+    }
+    let trimmed = if line.len() > 1 {
+        line.trim_end_matches(['/', '\\'])
+    } else {
+        line
+    };
+    // Windows drive roots keep their separator (`C:\`).
+    let path = if trimmed.len() == 2 && trimmed.ends_with(':') {
+        line.to_owned()
+    } else if trimmed.is_empty() {
+        line.to_owned()
+    } else {
+        trimmed.to_owned()
+    };
+    Some(PathBuf::from(path))
+}
+
+/// Whether a failed dialog process means "the person cancelled". `osascript` exits 1 with
+/// `User canceled.` on stderr; zenity exits 1 and kdialog exits 1 with no output.
+pub fn is_cancel(exit_code: Option<i32>, stderr: &str) -> bool {
+    exit_code == Some(1) && (stderr.trim().is_empty() || stderr.contains("User canceled"))
+}
+
+fn run(mut cmd: Command) -> Result<Option<PathBuf>, ShellError> {
+    let out = cmd
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .output()
+        .map_err(|e| ShellError::Unsupported(format!("cannot show a picker: {e}")))?;
+    if out.status.success() {
+        return Ok(parse_pick_output(&out.stdout));
+    }
+    let stderr = String::from_utf8_lossy(&out.stderr);
+    if is_cancel(out.status.code(), &stderr) {
+        return Ok(None);
+    }
+    Err(ShellError::Other(format!(
+        "the picker failed ({}): {}",
+        out.status
+            .code()
+            .map_or_else(|| "signal".to_owned(), |c| c.to_string()),
+        stderr.trim()
+    )))
+}
+
+fn pick(kind: PickKind, prompt: &str, initial: Option<&Path>) -> Result<Option<PathBuf>, ShellError> {
+    #[cfg(target_os = "macos")]
+    {
+        let mut cmd = Command::new("/usr/bin/osascript");
+        cmd.arg("-e").arg(applescript_for(kind, prompt, initial));
+        run(cmd)
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+        let default = match kind {
+            PickKind::Folder => "Choose a folder",
+            PickKind::App => "Choose an application",
+        };
+        let mut cmd = Command::new("powershell.exe");
+        cmd.args(["-NoProfile", "-NonInteractive", "-STA", "-Command", powershell_for(kind)])
+            .env("RK_PICK_PROMPT", clean_prompt(prompt, default))
+            .env(
+                "RK_PICK_INITIAL",
+                initial
+                    .filter(|p| p.is_dir())
+                    .map(|p| p.to_string_lossy().into_owned())
+                    .unwrap_or_default(),
+            )
+            .creation_flags(CREATE_NO_WINDOW);
+        run(cmd)
+    }
+    #[cfg(all(unix, not(target_os = "macos")))]
+    {
+        let default = match kind {
+            PickKind::Folder => "Choose a folder",
+            PickKind::App => "Choose an application",
+        };
+        let title = clean_prompt(prompt, default);
+        let start = initial
+            .filter(|p| p.is_dir())
+            .map(|p| {
+                let mut s = p.to_string_lossy().into_owned();
+                if !s.ends_with('/') {
+                    s.push('/');
+                }
+                s
+            });
+        let mut zenity = Command::new("zenity");
+        zenity.args(["--file-selection", "--title", &title]);
+        if kind == PickKind::Folder {
+            zenity.arg("--directory");
+        }
+        if let Some(s) = &start {
+            zenity.arg("--filename").arg(s);
+        }
+        match run(zenity) {
+            Err(ShellError::Unsupported(_)) => {}
+            other => return other,
+        }
+        let mut kdialog = Command::new("kdialog");
+        kdialog.args(["--title", &title]);
+        kdialog.arg(if kind == PickKind::Folder {
+            "--getexistingdirectory"
+        } else {
+            "--getopenfilename"
+        });
+        kdialog.arg(start.as_deref().unwrap_or("."));
+        run(kdialog)
+    }
+    #[cfg(not(any(unix, windows)))]
+    {
+        let _ = (kind, prompt, initial);
+        Err(ShellError::Unsupported(
+            "native pickers are not available on this platform".into(),
+        ))
+    }
+}
+
+/// Ask the person to choose a folder. `prompt` is the dialog's message or title; `initial` is the
+/// folder it opens in when that directory exists. `Ok(None)`: cancelled.
+pub fn pick_folder(prompt: &str, initial: Option<&Path>) -> Result<Option<PathBuf>, ShellError> {
+    pick(PickKind::Folder, prompt, initial)
+}
+
+/// Ask the person to choose an application (`.app`, `.exe`, or an executable on Linux).
+/// `Ok(None)`: cancelled.
+pub fn pick_app(prompt: &str, initial: Option<&Path>) -> Result<Option<PathBuf>, ShellError> {
+    pick(PickKind::App, prompt, initial)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn prompt_is_cleaned_defaulted_and_cut() {
+        assert_eq!(clean_prompt("  Pick\u{0}\n it ", "d"), "Pick it");
+        assert_eq!(clean_prompt(" \n", "Choose a folder"), "Choose a folder");
+        assert_eq!(clean_prompt(&"x".repeat(500), "d").chars().count(), MAX_PROMPT_CHARS);
+    }
+
+    #[test]
+    fn applescript_quote_escapes_quote_and_backslash() {
+        assert_eq!(applescript_quote(r#"a"b\c"#), r#"a\"b\\c"#);
+    }
+
+    #[test]
+    fn applescript_folder_and_app_scripts() {
+        let dir = std::env::temp_dir();
+        let folder = applescript_for(PickKind::Folder, "Where \"to\"?", Some(&dir));
+        assert!(folder.starts_with("POSIX path of (choose folder with prompt \"Where \\\"to\\\"?\""));
+        assert!(folder.contains(" default location POSIX file \""));
+        let app = applescript_for(PickKind::App, "", None);
+        assert_eq!(
+            app,
+            "POSIX path of (choose file of type {\"com.apple.application-bundle\"} with prompt \"Choose an application\")"
+        );
+        // A start folder that does not exist is ignored rather than failing the dialog.
+        let missing = applescript_for(PickKind::Folder, "p", Some(Path::new("/definitely/not/here")));
+        assert!(!missing.contains("default location"));
+    }
+
+    #[test]
+    fn powershell_scripts_read_data_from_the_environment() {
+        for kind in [PickKind::Folder, PickKind::App] {
+            let s = powershell_for(kind);
+            assert!(s.contains("$env:RK_PICK_PROMPT") && s.contains("$env:RK_PICK_INITIAL"));
+            assert!(s.contains("ShowDialog()"));
+        }
+        assert!(powershell_for(PickKind::App).contains("*.exe"));
+    }
+
+    #[test]
+    fn output_is_one_trimmed_path_and_empty_is_a_cancel() {
+        assert_eq!(parse_pick_output(b""), None);
+        assert_eq!(parse_pick_output(b"\n"), None);
+        assert_eq!(parse_pick_output(b"/Applications/Foo.app/\n"), Some("/Applications/Foo.app".into()));
+        assert_eq!(parse_pick_output(b"/Users/me/dir\r\n"), Some("/Users/me/dir".into()));
+        assert_eq!(parse_pick_output(b"/"), Some("/".into()));
+        assert_eq!(parse_pick_output(b"C:\\Tools\\App.exe"), Some("C:\\Tools\\App.exe".into()));
+        assert_eq!(parse_pick_output(b"C:\\"), Some("C:\\".into()));
+        assert_eq!(parse_pick_output(b"/a\n/b\n"), Some("/a".into()));
+    }
+
+    #[test]
+    fn cancel_is_exit_one_with_no_error_text_or_the_osascript_message() {
+        assert!(is_cancel(Some(1), ""));
+        assert!(is_cancel(Some(1), "execution error: User canceled. (-128)"));
+        assert!(!is_cancel(Some(1), "syntax error"));
+        assert!(!is_cancel(Some(2), ""));
+        assert!(!is_cancel(None, ""));
+    }
+}

+/// Largest logical dimension a window command accepts.
+const MAX_DIM: f64 = 16_384.0;
+
+/// A parameterised window command (`rk_shell_window` with `width` / `height` / `value`).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum WindowOp {
+    /// Logical inner size.
+    Resize {
+        width: f64,
+        height: f64,
+    },
+    Center,
+    SetResizable(bool),
+    SetMaximizable(bool),
+    /// Enter (`true`) or leave (`false`) fullscreen. The `fullscreen` window action only toggles.
+    SetFullscreen(bool),
+    /// Close without a close-requested round trip (the app's own close handlers do not run).
+    Destroy,
+}
+
+/// Parse the parameterised actions; `Ok(None)` when `action` is one of the plain actions.
+pub fn parse_window_op(
+    action: &str,
+    width: Option<f64>,
+    height: Option<f64>,
+    value: Option<bool>,
+) -> Result<Option<WindowOp>, String> {
+    let flag =
+        |what: &str| value.ok_or_else(|| format!("window action {what} needs a boolean value"));
+    Ok(Some(match action {
+        "resize" => {
+            let ok = |v: Option<f64>| v.filter(|v| v.is_finite() && *v > 0.0 && *v <= MAX_DIM);
+            match (ok(width), ok(height)) {
+                (Some(width), Some(height)) => WindowOp::Resize { width, height },
+                _ => {
+                    return Err(format!(
+                        "window action resize needs a width and height in 1..={MAX_DIM}"
+                    ))
+                }
+            }
+        }
+        "center" => WindowOp::Center,
+        "set-resizable" => WindowOp::SetResizable(flag("set-resizable")?),
+        "set-maximizable" => WindowOp::SetMaximizable(flag("set-maximizable")?),
+        "set-fullscreen" => WindowOp::SetFullscreen(flag("set-fullscreen")?),
+        "destroy" => WindowOp::Destroy,
+        _ => return Ok(None),
+    }))
+}
+
+/// Apply a parsed [`WindowOp`] to `window`.
+pub fn apply_window_op(window: &WebviewWindow<Wry>, op: WindowOp) -> Result<(), String> {
+    match op {
+        WindowOp::Resize { width, height } => window
+            .set_size(tauri::LogicalSize::new(width, height))
+            .map_err(|e| e.to_string()),
+        WindowOp::Center => window.center().map_err(|e| e.to_string()),
+        WindowOp::SetResizable(on) => window.set_resizable(on).map_err(|e| e.to_string()),
+        WindowOp::SetMaximizable(on) => window.set_maximizable(on).map_err(|e| e.to_string()),
+        WindowOp::SetFullscreen(on) => window.set_fullscreen(on).map_err(|e| e.to_string()),
+        WindowOp::Destroy => window.destroy().map_err(|e| e.to_string()),
+    }
 }
 

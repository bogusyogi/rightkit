index 0000000..826d758
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/preview.rs
@@ -0,0 +1,383 @@
+//! In-memory preview documents served from their own custom scheme (Orthic-Labs/rightkit#386,
+//! part B).
+//!
+//! Donor: ViewRight `preview_protocol.rs` (`viewright-preview://`). A `srcdoc` iframe inherits the
+//! embedding window's CSP, so previewing content that needs `'unsafe-eval'` (compiled MDX) or remote
+//! `http(s)` scripts (interactive HTML) would force the MAIN window to allow both. Serving each
+//! preview from its own scheme gives it its own response CSP and keeps the main window strict.
+//!
+//! # Security model (unchanged from the donor)
+//!
+//! * Content is registered by the parent webview under an unguessable one-time token (256 random
+//!   bits, hex) and is served ONLY by that token. Never by file path; nothing here touches disk.
+//! * The parent revokes the token when the frame unmounts or its document closes. A revoked or
+//!   unknown token answers 404 and never becomes valid again (tokens are never reused).
+//! * Each response carries a `Content-Security-Policy` chosen by the registered [`PreviewKind`],
+//!   not by the content, so a document cannot widen its own policy.
+//! * The iframe keeps `sandbox="allow-scripts"` (never `allow-same-origin`), so the document runs in
+//!   an opaque origin and cannot reach the app, IPC, or the parent DOM.
+//! * Registration is bounded in per-document size, total size and entry count.
+//!
+//! The crate owns the store, the token rules and the response; the app owns the scheme name, the
+//! commands that register and revoke (they belong in the app's own ACL manifest) and the iframe:
+//!
+//! ```ignore
+//! let store = PreviewStore::new("viewright-site")?;          // scheme the previews may load subresources from
+//! builder.manage(store)
+//!     .register_uri_scheme_protocol("viewright-preview", |ctx, request| {
+//!         serve_preview_request(&ctx.app_handle().state::<PreviewStore>(), &request)
+//!     });
+//! // commands: store.register(kind, html) -> token, store.revoke(&token)
+//! // iframe src: preview_url("viewright-preview", &token)
+//! ```
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use serde::Deserialize;
+use tauri::http::{header, Method, Request, Response, StatusCode};
+
+use crate::ShellError;
+
+/// Largest single registered document.
+pub const MAX_PREVIEW_BYTES: usize = 64 * 1024 * 1024;
+/// Largest sum of all live registered documents.
+pub const MAX_TOTAL_BYTES: usize = 256 * 1024 * 1024;
+/// Most live registrations at once.
+pub const MAX_PREVIEWS: usize = 64;
+
+const TOKEN_BYTES: usize = 32;
+/// Length of a token in hex digits.
+pub const TOKEN_HEX_LEN: usize = TOKEN_BYTES * 2;
+
+/// MDX runs compiler-produced local code with `new Function`, so `'unsafe-eval'` is needed, but only
+/// inside this opaque-origin document: no network, no forms, no base override, data: assets only.
+pub const MDX_CSP: &str = "default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' blob:; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'";
+
+/// Interactive HTML behaves like a browser tab for CDN-driven pages: http(s) scripts, styles and
+/// fonts load. The site scheme (`{site}:`) is granted for SUBRESOURCES only and `connect-src` omits
+/// it, so a page may display files from its granted root but cannot read their bytes back. With the
+/// scheme `viewright-site` this is, byte for byte, the policy ViewRight shipped.
+pub const INTERACTIVE_CSP_TEMPLATE: &str = "default-src 'none'; script-src 'unsafe-inline' {site}: blob: http: https:; style-src 'unsafe-inline' {site}: http: https:; img-src {site}: data: blob: http: https:; font-src {site}: data: http: https:; media-src {site}: data: blob: http: https:; connect-src http: https:; base-uri {site}:; form-action 'none'";
+
+/// Served for unknown tokens and non-GET requests: nothing may load.
+pub const DENY_CSP: &str = "default-src 'none'";
+
+/// The interactive-HTML policy for `site_scheme` (a validated scheme name, no colon).
+pub fn interactive_csp(site_scheme: &str) -> String {
+    INTERACTIVE_CSP_TEMPLATE.replace("{site}", site_scheme)
+}
+
+/// Which narrowly scoped policy a registered document is served under.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum PreviewKind {
+    Mdx,
+    Interactive,
+}
+
+struct Entry {
+    kind: PreviewKind,
+    html: Arc<[u8]>,
+}
+
+/// In-memory, token-keyed preview documents. Keep it as managed Tauri state.
+pub struct PreviewStore {
+    interactive_csp: String,
+    inner: Mutex<HashMap<String, Entry>>,
+}
+
+fn new_token() -> Result<String, String> {
+    let mut bytes = [0u8; TOKEN_BYTES];
+    crate::broker::fill_entropy(&mut bytes)
+        .map_err(|e| format!("could not generate preview token: {e}"))?;
+    let mut token = String::with_capacity(TOKEN_HEX_LEN);
+    for byte in bytes {
+        token.push_str(&format!("{byte:02x}"));
+    }
+    Ok(token)
+}
+
+impl PreviewStore {
+    /// A store whose interactive previews may load subresources from `site_scheme` (the app's
+    /// site-root scheme, see [`crate::site`]). The scheme is validated as an internal scheme.
+    pub fn new(site_scheme: &str) -> Result<Self, ShellError> {
+        let scheme = crate::nav::validate_internal_scheme(site_scheme).map_err(ShellError::Invalid)?;
+        Ok(Self {
+            interactive_csp: interactive_csp(&scheme),
+            inner: Mutex::new(HashMap::new()),
+        })
+    }
+
+    /// The policy `kind` is served under by this store.
+    pub fn csp(&self, kind: PreviewKind) -> &str {
+        match kind {
+            PreviewKind::Mdx => MDX_CSP,
+            PreviewKind::Interactive => &self.interactive_csp,
+        }
+    }
+
+    /// Register `html` and return its one-time token. Bounded by [`MAX_PREVIEW_BYTES`],
+    /// [`MAX_TOTAL_BYTES`] and [`MAX_PREVIEWS`].
+    pub fn register(&self, kind: PreviewKind, html: String) -> Result<String, String> {
+        if html.len() > MAX_PREVIEW_BYTES {
+            return Err("preview document is too large".into());
+        }
+        let token = new_token()?;
+        let mut map = self.inner.lock().map_err(|_| "preview store poisoned")?;
+        if map.len() >= MAX_PREVIEWS {
+            return Err("too many open previews".into());
+        }
+        let total: usize = map.values().map(|e| e.html.len()).sum();
+        if total + html.len() > MAX_TOTAL_BYTES {
+            return Err("preview memory budget exceeded".into());
+        }
+        map.insert(
+            token.clone(),
+            Entry {
+                kind,
+                html: Arc::from(html.into_bytes()),
+            },
+        );
+        Ok(token)
+    }
+
+    /// Drop a registration. Unknown tokens are ignored.
+    pub fn revoke(&self, token: &str) {
+        if let Ok(mut map) = self.inner.lock() {
+            map.remove(token);
+        }
+    }
+
+    /// Number of live registrations.
+    pub fn len(&self) -> usize {
+        self.inner.lock().map(|m| m.len()).unwrap_or(0)
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    fn lookup(&self, token: &str) -> Option<(PreviewKind, Arc<[u8]>)> {
+        let map = self.inner.lock().ok()?;
+        map.get(token).map(|e| (e.kind, e.html.clone()))
+    }
+}
+
+/// The URL an iframe loads for `token`, per platform convention (WebView2 maps a custom scheme to
+/// `http://<scheme>.localhost/`).
+pub fn preview_url(scheme: &str, token: &str) -> String {
+    if cfg!(windows) {
+        format!("http://{scheme}.localhost/{token}")
+    } else {
+        format!("{scheme}://localhost/{token}")
+    }
+}
+
+fn deny(status: StatusCode) -> Response<Vec<u8>> {
+    base_response(status, DENY_CSP, Vec::new())
+}
+
+fn base_response(status: StatusCode, csp: &str, body: Vec<u8>) -> Response<Vec<u8>> {
+    Response::builder()
+        .status(status)
+        .header(header::CONTENT_TYPE, "text/html; charset=utf-8")
+        .header(header::CONTENT_SECURITY_POLICY, csp)
+        .header(header::CACHE_CONTROL, "no-store")
+        .header(header::X_CONTENT_TYPE_OPTIONS, "nosniff")
+        .header(header::REFERRER_POLICY, "no-referrer")
+        .body(body)
+        .unwrap_or_else(|_| Response::new(Vec::new()))
+}
+
+/// Serve a `<scheme>://localhost/<token>` request (`http://<scheme>.localhost/<token>` on Windows).
+/// Only the exact token path resolves; every other path is 404, every non-GET/HEAD is 405.
+pub fn serve_preview_request(
+    store: &PreviewStore,
+    request: &Request<Vec<u8>>,
+) -> Response<Vec<u8>> {
+    if request.method() != Method::GET && request.method() != Method::HEAD {
+        return deny(StatusCode::METHOD_NOT_ALLOWED);
+    }
+    let path = request.uri().path();
+    let token = path.strip_prefix('/').unwrap_or(path);
+    let token = token.strip_suffix('/').unwrap_or(token);
+    if token.len() != TOKEN_HEX_LEN || !token.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return deny(StatusCode::NOT_FOUND);
+    }
+    let Some((kind, html)) = store.lookup(token) else {
+        return deny(StatusCode::NOT_FOUND);
+    };
+    let body = if request.method() == Method::HEAD {
+        Vec::new()
+    } else {
+        html.to_vec()
+    };
+    base_response(StatusCode::OK, store.csp(kind), body)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// ViewRight's shipped policy, copied verbatim from `preview_protocol.rs`.
+    const VIEWRIGHT_INTERACTIVE_CSP: &str = "default-src 'none'; script-src 'unsafe-inline' viewright-site: blob: http: https:; style-src 'unsafe-inline' viewright-site: http: https:; img-src viewright-site: data: blob: http: https:; font-src viewright-site: data: http: https:; media-src viewright-site: data: blob: http: https:; connect-src http: https:; base-uri viewright-site:; form-action 'none'";
+
+    fn get(uri: &str) -> Request<Vec<u8>> {
+        Request::builder().uri(uri).body(Vec::new()).unwrap()
+    }
+
+    fn csp_of(response: &Response<Vec<u8>>) -> String {
+        response
+            .headers()
+            .get(header::CONTENT_SECURITY_POLICY)
+            .unwrap()
+            .to_str()
+            .unwrap()
+            .to_string()
+    }
+
+    fn store() -> PreviewStore {
+        PreviewStore::new("viewright-site").unwrap()
+    }
+
+    #[test]
+    fn interactive_policy_is_byte_identical_to_the_shipped_one() {
+        assert_eq!(interactive_csp("viewright-site"), VIEWRIGHT_INTERACTIVE_CSP);
+        assert_eq!(store().csp(PreviewKind::Interactive), VIEWRIGHT_INTERACTIVE_CSP);
+        assert_eq!(
+            MDX_CSP,
+            "default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' blob:; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'"
+        );
+        assert!(!MDX_CSP.contains("http:") && !MDX_CSP.contains("https:"));
+        assert!(!VIEWRIGHT_INTERACTIVE_CSP.contains("'unsafe-eval'"));
+        assert!(!VIEWRIGHT_INTERACTIVE_CSP.contains("connect-src viewright-site"));
+        // Another app's scheme lands in every subresource position and nowhere else.
+        let other = interactive_csp("pulse-site");
+        assert_eq!(other.matches("pulse-site:").count(), 6);
+        assert!(!other.contains("{site}") && !other.contains("viewright"));
+    }
+
+    #[test]
+    fn site_scheme_is_validated() {
+        for bad in ["", "9site", "has space", "http", "javascript", "a/b"] {
+            assert!(PreviewStore::new(bad).is_err(), "{bad:?}");
+        }
+        assert!(PreviewStore::new("My-Site").is_ok());
+    }
+
+    /// A revoked token is never revived, only the exact token path resolves, non-GET is refused,
+    /// per-kind CSP headers, registration bounds.
+    #[test]
+    fn preview_protocol_serves_only_live_exact_tokens_with_kind_csp() {
+        let store = store();
+        let mdx = store
+            .register(PreviewKind::Mdx, "<p>hi</p>".into())
+            .unwrap();
+        let html = store
+            .register(PreviewKind::Interactive, "h".into())
+            .unwrap();
+        assert_eq!(mdx.len(), TOKEN_HEX_LEN);
+        assert!(mdx.bytes().all(|b| b.is_ascii_hexdigit()));
+        assert_ne!(mdx, html);
+
+        let ok = serve_preview_request(
+            &store,
+            &get(&format!("viewright-preview://localhost/{mdx}")),
+        );
+        assert_eq!(ok.status(), StatusCode::OK);
+        assert_eq!(ok.body(), b"<p>hi</p>");
+        assert_eq!(csp_of(&ok), MDX_CSP);
+        assert_eq!(ok.headers().get(header::CACHE_CONTROL).unwrap(), "no-store");
+        assert_eq!(
+            ok.headers().get(header::X_CONTENT_TYPE_OPTIONS).unwrap(),
+            "nosniff"
+        );
+        assert_eq!(
+            ok.headers().get(header::REFERRER_POLICY).unwrap(),
+            "no-referrer"
+        );
+        let html_resp = serve_preview_request(
+            &store,
+            &get(&format!("http://viewright-preview.localhost/{html}")),
+        );
+        assert_eq!(csp_of(&html_resp), VIEWRIGHT_INTERACTIVE_CSP);
+
+        // HEAD answers headers only.
+        let head = Request::builder()
+            .method(Method::HEAD)
+            .uri(format!("viewright-preview://localhost/{mdx}"))
+            .body(Vec::new())
+            .unwrap();
+        let head = serve_preview_request(&store, &head);
+        assert_eq!(head.status(), StatusCode::OK);
+        assert!(head.body().is_empty());
+
+        // Only the exact token path resolves (a trailing slash is tolerated, as in the donor).
+        for uri in [
+            "viewright-preview://localhost/".to_string(),
+            "viewright-preview://localhost/not-a-token".to_string(),
+            format!("viewright-preview://localhost/{mdx}/extra"),
+            format!("viewright-preview://localhost/../{mdx}"),
+            format!("viewright-preview://localhost/{}", mdx.to_uppercase() + "0"),
+        ] {
+            assert_eq!(
+                serve_preview_request(&store, &get(&uri)).status(),
+                StatusCode::NOT_FOUND,
+                "{uri}"
+            );
+        }
+        assert_eq!(
+            serve_preview_request(&store, &get(&format!("viewright-preview://localhost/{mdx}/")))
+                .status(),
+            StatusCode::OK
+        );
+
+        // Non-GET is refused.
+        let post = Request::builder()
+            .method(Method::POST)
+            .uri(format!("viewright-preview://localhost/{mdx}"))
+            .body(Vec::new())
+            .unwrap();
+        let refused = serve_preview_request(&store, &post);
+        assert_eq!(refused.status(), StatusCode::METHOD_NOT_ALLOWED);
+        assert_eq!(csp_of(&refused), DENY_CSP);
+
+        // Revoked tokens deny with the deny CSP and are never reused.
+        store.revoke(&mdx);
+        let gone = serve_preview_request(
+            &store,
+            &get(&format!("viewright-preview://localhost/{mdx}")),
+        );
+        assert_eq!(gone.status(), StatusCode::NOT_FOUND);
+        assert!(gone.body().is_empty());
+        assert_eq!(csp_of(&gone), DENY_CSP);
+        let again = store.register(PreviewKind::Mdx, "b".into()).unwrap();
+        assert_ne!(again, mdx);
+        store.revoke("never-registered");
+        assert_eq!(store.len(), 2);
+    }
+
+    #[test]
+    fn registration_is_bounded() {
+        let bounded = store();
+        assert!(bounded
+            .register(PreviewKind::Mdx, "x".repeat(MAX_PREVIEW_BYTES + 1))
+            .is_err());
+        assert!(bounded.is_empty());
+        for _ in 0..MAX_PREVIEWS {
+            bounded.register(PreviewKind::Mdx, "x".into()).unwrap();
+        }
+        assert!(bounded.register(PreviewKind::Mdx, "x".into()).is_err());
+    }
+
+    #[test]
+    fn preview_urls_follow_the_platform_convention() {
+        let url = preview_url("viewright-preview", "abc");
+        if cfg!(windows) {
+            assert_eq!(url, "http://viewright-preview.localhost/abc");
+        } else {
+            assert_eq!(url, "viewright-preview://localhost/abc");
+        }
+    }
+}
diff --git a/crates/rightkit-tauri-shell/src/print.rs b/crates/rightkit-tauri-shell/src/print.rs
new file mode 100644
index 0000000..9cdc153
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/print.rs
@@ -0,0 +1,91 @@
+//! Printing the current webview (Orthic-Labs/rightkit#386, part B).
+//!
+//! Donor: ViewRight `commands/print.rs`. On Windows the system print dialog cannot preview
+//! WebView2 content, so the default is WebView2's own in-app print preview
+//! (`ICoreWebView2_16::ShowPrintUI` with the browser kind). Print CSS in the page owns header
+//! suppression and page layout. Elsewhere the webview's own print is used (WKWebView shows the
+//! system print panel).
+
+use tauri::{Runtime, WebviewWindow};
+
+use crate::ShellError;
+
+/// Which print UI to show on Windows. Other platforms always use the system panel.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum PrintUi {
+    /// WebView2's in-app print preview (the default).
+    #[default]
+    Browser,
+    /// The Windows system print dialog (no preview of WebView2 content).
+    System,
+}
+
+impl PrintUi {
+    /// The `COREWEBVIEW2_PRINT_DIALOG_KIND` value: browser is 0, system is 1.
+    pub fn webview2_kind(self) -> i32 {
+        match self {
+            PrintUi::Browser => 0,
+            PrintUi::System => 1,
+        }
+    }
+}
+
+/// Show the print UI for `window`'s webview. On Windows the call is dispatched to the webview's
+/// thread and its outcome is not returned (`Err` means the webview could not be reached); a
+/// failure inside WebView2 is written to stderr as `rightkit-tauri-shell: print UI failed: ...`.
+/// Use [`show_print_ui_with`] to receive it.
+pub fn show_print_ui<R: Runtime>(window: &WebviewWindow<R>, ui: PrintUi) -> Result<(), ShellError> {
+    show_print_ui_with(window, ui, |error| {
+        eprintln!("rightkit-tauri-shell: print UI failed: {error}")
+    })
+}
+
+/// Like [`show_print_ui`], with `on_error` called (on the webview's thread) when WebView2 refuses.
+pub fn show_print_ui_with<R: Runtime>(
+    window: &WebviewWindow<R>,
+    ui: PrintUi,
+    on_error: impl FnOnce(String) + Send + 'static,
+) -> Result<(), ShellError> {
+    #[cfg(windows)]
+    {
+        use crate::winapi::webview2_com::Microsoft::Web::WebView2::Win32::{
+            ICoreWebView2_16, COREWEBVIEW2_PRINT_DIALOG_KIND,
+        };
+        use crate::winapi::windows::core::Interface;
+
+        let kind = COREWEBVIEW2_PRINT_DIALOG_KIND(ui.webview2_kind());
+        window
+            .with_webview(move |webview| {
+                // SAFETY: Tauri hands over the live controller; used only inside this call.
+                let result = unsafe {
+                    webview.controller().CoreWebView2().and_then(|core| {
+                        let printable: ICoreWebView2_16 = core.cast()?;
+                        printable.ShowPrintUI(kind)
+                    })
+                };
+                if let Err(error) = result {
+                    on_error(format!("{error:?}"));
+                }
+            })
+            .map_err(|e| ShellError::Other(format!("webview unavailable: {e}")))
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = (ui, on_error);
+        window
+            .print()
+            .map_err(|e| ShellError::Other(format!("print failed: {e}")))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn print_ui_maps_to_webview2_dialog_kinds() {
+        assert_eq!(PrintUi::default(), PrintUi::Browser);
+        assert_eq!(PrintUi::Browser.webview2_kind(), 0);
+        assert_eq!(PrintUi::System.webview2_kind(), 1);
+    }
+}

+++ b/crates/rightkit-tauri-shell/src/dialog.rs
@@ -0,0 +1,238 @@
+//! Native file dialogs that grant what the person picks. Donor: ScrapeRight (`open`/`save` from
+//! `@tauri-apps/plugin-dialog` in the page, then the app granting the result); here the dialog runs
+//! in Rust and the returned paths are already granted in the [`crate::broker::PathBroker`], so the
+//! page never holds a path the broker has not seen.
+//!
+//! Needs the `dialog` feature (it pulls `tauri-plugin-dialog`) and the app to register
+//! `tauri_plugin_dialog::init()` itself; without either, the commands answer `unsupported`.
+//!
+//! * `rk_shell_pick_files(options)` returns the granted display paths (empty when cancelled).
+//! * `rk_shell_pick_folder(options)` returns the chosen folder as a display path or `null`. A folder is
+//!   not a file grant; the app decides what it means.
+//! * `rk_shell_save_dialog(options)` returns the chosen destination as a granted write target, or `null`.
+//!
+//! An app that must also refuse certain destinations (ScrapeRight keeps Save As out of its own
+//! app-data folder) checks the returned path before writing.
+
+use serde::Deserialize;
+#[cfg(feature = "dialog")]
+use tauri::{Manager, WebviewWindow, Wry};
+
+#[cfg(feature = "dialog")]
+use crate::commands::require;
+#[cfg(feature = "dialog")]
+use crate::error::ShellError;
+#[cfg(feature = "dialog")]
+use crate::Module;
+
+#[derive(Debug, Clone, Default, Deserialize, PartialEq)]
+#[serde(rename_all = "camelCase")]
+pub struct Filter {
+    pub name: String,
+    pub extensions: Vec<String>,
+}
+
+#[derive(Debug, Clone, Default, Deserialize, PartialEq)]
+#[serde(rename_all = "camelCase")]
+pub struct DialogOptions {
+    pub title: Option<String>,
+    /// Allow several files (`rk_shell_pick_files` only). Default false: one file.
+    #[serde(default)]
+    pub multiple: bool,
+    #[serde(default)]
+    pub filters: Vec<Filter>,
+    /// Folder the dialog opens in.
+    pub default_path: Option<String>,
+    /// Suggested file name (`rk_shell_save_dialog`).
+    pub file_name: Option<String>,
+}
+
+/// Clean the filters: extensions lose a leading `*.` or `.`, are lower-cased and de-duplicated;
+/// empty names and extension-less filters are dropped. `*` alone (any file) is kept.
+pub fn normalize_filters(filters: &[Filter]) -> Vec<Filter> {
+    filters
+        .iter()
+        .filter_map(|f| {
+            let mut exts: Vec<String> = Vec::new();
+            for e in &f.extensions {
+                let e = e.trim().trim_start_matches("*.").trim_start_matches('.');
+                let e = e.to_ascii_lowercase();
+                if !e.is_empty() && !exts.contains(&e) {
+                    exts.push(e);
+                }
+            }
+            (!f.name.trim().is_empty() && !exts.is_empty()).then(|| Filter {
+                name: f.name.trim().to_owned(),
+                extensions: exts,
+            })
+        })
+        .collect()
+}
+
+#[cfg(feature = "dialog")]
+fn dialog_of(
+    app: &tauri::AppHandle<Wry>,
+    window: &WebviewWindow<Wry>,
+    o: &DialogOptions,
+) -> Result<tauri_plugin_dialog::FileDialogBuilder<Wry>, ShellError> {
+    use tauri_plugin_dialog::DialogExt;
+    if app.try_state::<tauri_plugin_dialog::Dialog<Wry>>().is_none() {
+        return Err(ShellError::Unsupported(
+            "register tauri_plugin_dialog::init() to use the shell file dialogs".into(),
+        ));
+    }
+    let mut b = app.dialog().file().set_parent(window);
+    if let Some(t) = &o.title {
+        b = b.set_title(t.clone());
+    }
+    if let Some(d) = &o.default_path {
+        b = b.set_directory(d);
+    }
+    if let Some(n) = &o.file_name {
+        b = b.set_file_name(n.clone());
+    }
+    for f in normalize_filters(&o.filters) {
+        let exts: Vec<&str> = f.extensions.iter().map(String::as_str).collect();
+        b = b.add_filter(f.name.clone(), &exts);
+    }
+    Ok(b)
+}
+
+#[cfg(feature = "dialog")]
+fn path_of(p: tauri_plugin_dialog::FilePath) -> Result<std::path::PathBuf, ShellError> {
+    p.into_path()
+        .map_err(|e| ShellError::Other(format!("the chosen location is not a path: {e}")))
+}
+
+#[tauri::command]
+pub async fn rk_shell_pick_files(
+    options: Option<DialogOptions>,
+    window: tauri::WebviewWindow<tauri::Wry>,
+    state: tauri::State<'_, crate::ShellState>,
+) -> Result<Vec<String>, crate::error::ShellError> {
+    #[cfg(feature = "dialog")]
+    {
+        require(&state, Module::Broker)?;
+        let o = options.unwrap_or_default();
+        let app = window.app_handle().clone();
+        let broker = state.broker.clone();
+        tauri::async_runtime::spawn_blocking(move || {
+            let b = dialog_of(&app, &window, &o)?;
+            let chosen = if o.multiple {
+                b.blocking_pick_files().unwrap_or_default()
+            } else {
+                b.blocking_pick_file().into_iter().collect()
+            };
+            chosen
+                .into_iter()
+                .map(|p| broker.grant_file(path_of(p)?))
+                .collect()
+        })
+        .await
+        .map_err(|e| ShellError::Other(e.to_string()))?
+    }
+    #[cfg(not(feature = "dialog"))]
+    {
+        let _ = (options, window, state);
+        Err(crate::error::ShellError::Unsupported(
+            "the `dialog` feature is not enabled".into(),
+        ))
+    }
+}
+
+#[tauri::command]
+pub async fn rk_shell_pick_folder(
+    options: Option<DialogOptions>,
+    window: tauri::WebviewWindow<tauri::Wry>,
+    state: tauri::State<'_, crate::ShellState>,
+) -> Result<Option<String>, crate::error::ShellError> {
+    #[cfg(feature = "dialog")]
+    {
+        let o = options.unwrap_or_default();
+        let app = window.app_handle().clone();
+        let _ = &state;
+        tauri::async_runtime::spawn_blocking(move || {
+            let b = dialog_of(&app, &window, &o)?;
+            b.blocking_pick_folder()
+                .map(|p| path_of(p).map(|p| crate::broker::path_to_string(&p)))
+                .transpose()
+        })
+        .await
+        .map_err(|e| ShellError::Other(e.to_string()))?
+    }
+    #[cfg(not(feature = "dialog"))]
+    {
+        let _ = (options, window, state);
+        Err(crate::error::ShellError::Unsupported(
+            "the `dialog` feature is not enabled".into(),
+        ))
+    }
+}
+
+#[tauri::command]
+pub async fn rk_shell_save_dialog(
+    options: Option<DialogOptions>,
+    window: tauri::WebviewWindow<tauri::Wry>,
+    state: tauri::State<'_, crate::ShellState>,
+) -> Result<Option<String>, crate::error::ShellError> {
+    #[cfg(feature = "dialog")]
+    {
+        require(&state, Module::Broker)?;
+        let o = options.unwrap_or_default();
+        let app = window.app_handle().clone();
+        let broker = state.broker.clone();
+        tauri::async_runtime::spawn_blocking(move || {
+            let b = dialog_of(&app, &window, &o)?;
+            b.blocking_save_file()
+                .map(|p| broker.grant_save_target(path_of(p)?))
+                .transpose()
+        })
+        .await
+        .map_err(|e| ShellError::Other(e.to_string()))?
+    }
+    #[cfg(not(feature = "dialog"))]
+    {
+        let _ = (options, window, state);
+        Err(crate::error::ShellError::Unsupported(
+            "the `dialog` feature is not enabled".into(),
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn f(name: &str, exts: &[&str]) -> Filter {
+        Filter {
+            name: name.into(),
+            extensions: exts.iter().map(|s| s.to_string()).collect(),
+        }
+    }
+
+    #[test]
+    fn extensions_are_cleaned_lowercased_and_deduplicated() {
+        let out = normalize_filters(&[f("Images", &["PNG", "*.jpg", ".JPG", " webp ", ""])]);
+        assert_eq!(out, vec![f("Images", &["png", "jpg", "webp"])]);
+    }
+
+    #[test]
+    fn empty_names_and_empty_extension_lists_are_dropped() {
+        let out = normalize_filters(&[f("", &["png"]), f("Nothing", &["", "."]), f("Any", &["*"])]);
+        assert_eq!(out, vec![f("Any", &["*"])]);
+    }
+
+    #[test]
+    fn options_deserialize_from_the_page_shape() {
+        let o: DialogOptions = serde_json::from_str(
+            r#"{"title":"Pick","multiple":true,"filters":[{"name":"Media","extensions":["mp4"]}],"defaultPath":"/tmp","fileName":"a.txt"}"#,
+        )
+        .unwrap();
+        assert!(o.multiple);
+        assert_eq!(o.default_path.as_deref(), Some("/tmp"));
+        assert_eq!(o.file_name.as_deref(), Some("a.txt"));
+        assert_eq!(o.filters[0].extensions, vec!["mp4"]);
+        let empty: DialogOptions = serde_json::from_str("{}").unwrap();
+        assert!(!empty.multiple && empty.filters.is_empty());
+    }
+}

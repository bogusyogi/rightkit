+#![cfg(feature = "tauri")]
+//! Menu entries (Orthic-Labs/rightkit#386): check items, nested submenus, id validation and the
+//! runtime-state checks, all without a native menu.
+
+use rightkit_tauri_shell::menu::{
+    check_state, entry_ids, validate, MenuEntry, MenuGroup, MenuItemState, MenuSpec,
+    MAX_SUBMENU_DEPTH,
+};
+
+fn spec(entries: Vec<MenuEntry>) -> MenuSpec {
+    MenuSpec {
+        app_name: "App".into(),
+        groups: vec![MenuGroup {
+            label: "View".into(),
+            entries,
+        }],
+        ..Default::default()
+    }
+}
+
+#[test]
+fn check_and_submenu_round_trip_through_json() {
+    let entries: Vec<MenuEntry> = serde_json::from_str(
+        r#"[{"kind":"check","id":"v.wrap","label":"Word Wrap","checked":true},
+            {"kind":"submenu","label":"Zoom","entries":[{"kind":"item","id":"z.in","label":"In"},{"kind":"separator"},{"kind":"check","id":"z.fit","label":"Fit"}]}]"#,
+    )
+    .unwrap();
+    assert_eq!(
+        entries[0],
+        MenuEntry::Check {
+            id: "v.wrap".into(),
+            label: "Word Wrap".into(),
+            accelerator: None,
+            enabled: true,
+            checked: true,
+        }
+    );
+    let again: Vec<MenuEntry> =
+        serde_json::from_str(&serde_json::to_string(&entries).unwrap()).unwrap();
+    assert_eq!(again, entries);
+    // Defaults: enabled, unchecked.
+    let c: MenuEntry = serde_json::from_str(r#"{"kind":"check","id":"a","label":"A"}"#).unwrap();
+    assert_eq!(c, MenuEntry::check("a", "A", false));
+}
+
+#[test]
+fn entry_ids_walk_nested_submenus_in_order() {
+    let entries = vec![
+        MenuEntry::item("a", "A"),
+        MenuEntry::submenu(
+            "Sub",
+            vec![
+                MenuEntry::check("b", "B", false),
+                MenuEntry::Separator,
+                MenuEntry::submenu("Deeper", vec![MenuEntry::item("c", "C")]),
+            ],
+        ),
+        MenuEntry::item("d", "D"),
+    ];
+    assert_eq!(entry_ids(&entries), ["a", "b", "c", "d"]);
+}
+
+#[test]
+fn duplicate_and_empty_ids_are_refused_across_groups_help_and_settings() {
+    assert!(validate(&spec(vec![
+        MenuEntry::item("a", "A"),
+        MenuEntry::check("b", "B", true)
+    ]))
+    .is_ok());
+    let dup = validate(&spec(vec![
+        MenuEntry::item("a", "A"),
+        MenuEntry::submenu("S", vec![MenuEntry::check("a", "A2", false)]),
+    ]));
+    assert!(dup.unwrap_err().contains("duplicate menu item id a"));
+    assert!(validate(&spec(vec![MenuEntry::item(" ", "x")]))
+        .unwrap_err()
+        .contains("empty id"));
+    let mut s = spec(vec![MenuEntry::item("a", "A")]);
+    s.help = vec![MenuEntry::item("a", "Help A")];
+    assert!(validate(&s).is_err());
+    let mut s = spec(vec![MenuEntry::item("settings", "A")]);
+    s.settings = Some(("settings".into(), "CmdOrCtrl+,".into()));
+    assert!(validate(&s).is_err());
+}
+
+#[test]
+fn submenu_nesting_is_bounded() {
+    let mut e = vec![MenuEntry::item("leaf", "Leaf")];
+    // A group's entries are depth 1; each wrapped Submenu adds one level.
+    for i in 0..MAX_SUBMENU_DEPTH {
+        e = vec![MenuEntry::submenu(&format!("s{i}"), e)];
+    }
+    assert!(
+        validate(&spec(e.clone())).is_ok(),
+        "{MAX_SUBMENU_DEPTH} levels are allowed"
+    );
+    let too_deep = vec![MenuEntry::submenu("outer", e)];
+    assert!(validate(&spec(too_deep))
+        .unwrap_err()
+        .contains("nest deeper"));
+}
+
+#[test]
+fn state_updates_need_a_known_id_and_checked_needs_a_check_item() {
+    let is_item = |id: &str| id == "plain";
+    let is_check = |id: &str| id == "tick";
+    let up = |id: &str, enabled: Option<bool>, checked: Option<bool>| MenuItemState {
+        id: id.into(),
+        enabled,
+        checked,
+    };
+    assert!(check_state(&up("plain", Some(false), None), is_item, is_check).is_ok());
+    assert!(check_state(&up("tick", Some(true), Some(true)), is_item, is_check).is_ok());
+    assert!(
+        check_state(&up("missing", Some(true), None), is_item, is_check)
+            .unwrap_err()
+            .contains("no menu item missing")
+    );
+    assert!(
+        check_state(&up("plain", None, Some(true)), is_item, is_check)
+            .unwrap_err()
+            .contains("not a check item")
+    );
+    let parsed: Vec<MenuItemState> =
+        serde_json::from_str(r#"[{"id":"tick","checked":true},{"id":"plain","enabled":false}]"#)
+            .unwrap();
+    assert_eq!(parsed[0], up("tick", None, Some(true)));
+    assert_eq!(parsed[1], up("plain", Some(false), None));
+}
diff --git a/crates/rightkit-tauri-shell/tests/menu_layout.rs b/crates/rightkit-tauri-shell/tests/menu_layout.rs
new file mode 100644
index 0000000..b97a377
--- /dev/null
+++ b/crates/rightkit-tauri-shell/tests/menu_layout.rs
@@ -0,0 +1,232 @@
+#![cfg(feature = "tauri")]
+//! Pure menu layout (Orthic-Labs/rightkit#386 follow-up): HIG order, extension points and
+//! app-routed overrides, with no native menu. The default spec must plan exactly the menus earlier
+//! versions built.
+
+use rightkit_tauri_shell::menu::{
+    plan, validate, MenuEntry, MenuGroup, MenuOverride, MenuPlan, MenuSpec, Native as N,
+    OverrideRole, PlanItem,
+};
+
+fn titles(p: &[MenuPlan]) -> Vec<&str> {
+    p.iter().map(|m| m.title.as_str()).collect()
+}
+fn n(x: N) -> PlanItem {
+    PlanItem::Native(x)
+}
+fn base() -> MenuSpec {
+    MenuSpec {
+        app_name: "App".into(),
+        ..Default::default()
+    }
+}
+
+#[test]
+fn default_spec_plans_exactly_the_legacy_menus() {
+    let mut spec = base();
+    spec.settings = Some(("settings".into(), "CmdOrCtrl+,".into()));
+    spec.groups = vec![MenuGroup {
+        label: "Tools".into(),
+        entries: vec![MenuEntry::item("t", "T")],
+    }];
+    spec.help = vec![MenuEntry::item("h", "H")];
+    let edit = vec![
+        n(N::Undo),
+        n(N::Redo),
+        n(N::Separator),
+        n(N::Cut),
+        n(N::Copy),
+        n(N::Paste),
+        n(N::SelectAll),
+    ];
+    let window = vec![
+        n(N::Minimize),
+        n(N::Maximize),
+        n(N::Separator),
+        n(N::CloseWindow),
+    ];
+    let mac = plan(&spec, true);
+    assert_eq!(
+        titles(&mac),
+        ["App", "Edit", "View", "Tools", "Window", "Help"]
+    );
+    assert_eq!(
+        mac[0].items,
+        vec![
+            n(N::About),
+            n(N::Separator),
+            PlanItem::Entry(MenuEntry::accel(
+                "settings",
+                "Settings\u{2026}",
+                "CmdOrCtrl+,"
+            )),
+            n(N::Separator),
+            n(N::Services),
+            n(N::Separator),
+            n(N::Hide),
+            n(N::HideOthers),
+            n(N::ShowAll),
+            n(N::Separator),
+            n(N::Quit("Quit App".into())),
+        ]
+    );
+    assert_eq!(mac[1].items, edit);
+    assert_eq!(mac[2].items, vec![n(N::Fullscreen)]);
+    assert_eq!(mac[4].items, window);
+    assert_eq!(
+        mac[5].items,
+        vec![PlanItem::Entry(MenuEntry::item("h", "H"))]
+    );
+
+    let other = plan(&spec, false);
+    assert_eq!(titles(&other), ["File", "Edit", "Tools", "Window", "Help"]);
+    assert_eq!(
+        other[0].items,
+        vec![
+            PlanItem::Entry(MenuEntry::accel(
+                "settings",
+                "Settings\u{2026}",
+                "CmdOrCtrl+,"
+            )),
+            n(N::Separator),
+            n(N::CloseWindow),
+            n(N::Quit("Exit App".into())),
+        ]
+    );
+    assert_eq!(other[1].items, edit);
+}
+
+#[test]
+fn file_slot_follows_hig_order_and_custom_menus_sit_after_view() {
+    let mut spec = base();
+    spec.file = Some(vec![MenuEntry::item("new", "New")]);
+    spec.groups = vec![MenuGroup {
+        label: "Format".into(),
+        entries: vec![],
+    }];
+    assert_eq!(
+        titles(&plan(&spec, true)),
+        ["App", "File", "Edit", "View", "Format", "Window", "Help"]
+    );
+    // Elsewhere the entries join the standard File menu before Close/Exit.
+    let o = plan(&spec, false);
+    assert_eq!(
+        o[0].items,
+        vec![
+            PlanItem::Entry(MenuEntry::item("new", "New")),
+            n(N::Separator),
+            n(N::CloseWindow),
+            n(N::Quit("Exit App".into())),
+        ]
+    );
+}
+
+#[test]
+fn edit_view_window_and_app_extension_points() {
+    let mut spec = base();
+    spec.edit_extra = vec![MenuEntry::submenu(
+        "Find",
+        vec![MenuEntry::item("f", "Find")],
+    )];
+    spec.view_entries = vec![MenuEntry::item("v", "V")];
+    spec.view_fullscreen = Some(false);
+    spec.window_compact = true;
+    spec.window_entries = vec![MenuEntry::Separator, MenuEntry::item("w", "W")];
+    spec.app_compact = true;
+    spec.settings = Some(("s".into(), "CmdOrCtrl+,".into()));
+    let p = plan(&spec, true);
+    assert_eq!(
+        p[0].items[0],
+        PlanItem::Entry(MenuEntry::accel("s", "Settings\u{2026}", "CmdOrCtrl+,"))
+    );
+    assert_eq!(p[0].items[1], n(N::Separator));
+    assert_eq!(p[0].items[2], n(N::Hide));
+    assert!(!p[0].items.contains(&n(N::About)) && !p[0].items.contains(&n(N::Services)));
+    let edit = &p[1].items;
+    assert_eq!(edit[edit.len() - 2], n(N::Separator));
+    assert!(
+        matches!(&edit[edit.len() - 1], PlanItem::Entry(MenuEntry::Submenu { label, .. }) if label == "Find")
+    );
+    assert_eq!(p[2].items, vec![PlanItem::Entry(MenuEntry::item("v", "V"))]);
+    assert_eq!(
+        p[3].items,
+        vec![
+            n(N::Minimize),
+            PlanItem::Entry(MenuEntry::Separator),
+            PlanItem::Entry(MenuEntry::item("w", "W"))
+        ]
+    );
+    // View appears off macOS only when it has entries.
+    assert!(!titles(&plan(&base(), false)).contains(&"View"));
+    assert!(titles(&plan(&spec, false)).contains(&"View"));
+}
+
+fn ov(role: OverrideRole, id: &str) -> MenuOverride {
+    MenuOverride {
+        role,
+        id: id.into(),
+        label: None,
+        accelerator: None,
+    }
+}
+
+#[test]
+fn overrides_keep_native_accelerators_and_labels_by_default() {
+    let mut spec = base();
+    spec.overrides = vec![
+        ov(OverrideRole::Undo, "editor-undo"),
+        ov(OverrideRole::Redo, "editor-redo"),
+        ov(OverrideRole::Quit, "application-quit"),
+    ];
+    let p = plan(&spec, true);
+    let item =
+        |id: &str, label: &str, accel: &str| PlanItem::Entry(MenuEntry::accel(id, label, accel));
+    assert_eq!(p[1].items[0], item("editor-undo", "Undo", "CmdOrCtrl+Z"));
+    assert_eq!(
+        p[1].items[1],
+        item("editor-redo", "Redo", "CmdOrCtrl+Shift+Z")
+    );
+    assert_eq!(
+        p[0].items.last().unwrap(),
+        &item("application-quit", "Quit App", "CmdOrCtrl+Q")
+    );
+    // The native verbs are gone; Cut/Copy/Paste stay native.
+    assert!(!p[1].items.contains(&n(N::Undo)) && p[1].items.contains(&n(N::Cut)));
+    // An explicit label/accelerator wins.
+    spec.overrides[2] = MenuOverride {
+        label: Some("Quit Now".into()),
+        accelerator: Some("CmdOrCtrl+Alt+Q".into()),
+        ..ov(OverrideRole::Quit, "q")
+    };
+    assert_eq!(
+        plan(&spec, true)[0].items.last().unwrap(),
+        &item("q", "Quit Now", "CmdOrCtrl+Alt+Q")
+    );
+}
+
+#[test]
+fn validate_covers_new_entry_sets_and_overrides() {
+    let mut spec = base();
+    spec.overrides = vec![ov(OverrideRole::Undo, "x"), ov(OverrideRole::Redo, "x")];
+    assert!(validate(&spec)
+        .unwrap_err()
+        .contains("duplicate menu item id x"));
+    spec.overrides = vec![ov(OverrideRole::Undo, "a"), ov(OverrideRole::Undo, "b")];
+    assert!(validate(&spec).unwrap_err().contains("given twice"));
+    spec.overrides = vec![ov(OverrideRole::Undo, "u")];
+    spec.edit_extra = vec![MenuEntry::item("u", "dup")];
+    assert!(validate(&spec).is_err());
+    spec.edit_extra = vec![MenuEntry::item("e", "E")];
+    spec.file = Some(vec![MenuEntry::item("e", "E2")]);
+    assert!(validate(&spec).is_err());
+}
+
+#[test]
+fn empty_help_is_built_by_default_and_omitted_on_request() {
+    let mut spec = base();
+    assert_eq!(titles(&plan(&spec, true)).last(), Some(&"Help"));
+    spec.omit_empty_help = true;
+    assert_eq!(titles(&plan(&spec, true)).last(), Some(&"Window"));
+    spec.help = vec![MenuEntry::item("h", "H")];
+    assert_eq!(titles(&plan(&spec, true)).last(), Some(&"Help"));
+}

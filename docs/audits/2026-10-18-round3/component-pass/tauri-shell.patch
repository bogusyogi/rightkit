@@ -0,0 +1,217 @@
+//! Native fatal-startup error dialog (Orthic-Labs/rightkit#498).
+//!
+//! Donor: MailRight `startup_error.rs`. A GUI app whose Tauri builder or setup fails before any
+//! window exists has no console on Windows and no terminal on a double-clicked Mac app, so the
+//! error would vanish and the app would just not open. [`show`] puts the message in an OS dialog
+//! that needs no webview and no Tauri runtime:
+//!
+//! * Windows: `MessageBoxW` (OK button, error icon, topmost).
+//! * macOS: `osascript` `display dialog` (stop icon, OK button).
+//! * Linux and other Unix: `zenity --error`, else `kdialog --error`; with neither installed the
+//!   message goes to stderr only.
+//!
+//! The message is always written to stderr as well. In a QA run that must stay invisible
+//! (`RIGHTKIT_QA_HIDDEN=1`) no dialog is shown, because a modal dialog would hang an unattended
+//! harness; stderr still gets the text.
+//!
+//! ```ignore
+//! if let Err(e) = tauri::Builder::default().plugin(plugin).run(tauri::generate_context!()) {
+//!     rightkit_tauri_shell::startup_error::show_and_exit("MyApp", &e);
+//! }
+//! ```
+
+use std::fmt::Display;
+
+/// Longest message handed to an OS dialog, in characters. Longer text is cut with an ellipsis so a
+/// huge error chain cannot make a dialog taller than the screen.
+pub const MAX_MESSAGE_CHARS: usize = 1200;
+
+/// The dialog title: `"<app> could not start"`; just `"Could not start"` for a blank app name.
+pub fn title_for(app_name: &str) -> String {
+    let app = app_name.trim();
+    if app.is_empty() {
+        "Could not start".to_owned()
+    } else {
+        format!("{app} could not start")
+    }
+}
+
+/// The dialog body for `error`: control characters other than newline and tab removed, trimmed,
+/// cut to [`MAX_MESSAGE_CHARS`] characters.
+pub fn body_for(error: &dyn Display) -> String {
+    let cleaned: String = error
+        .to_string()
+        .chars()
+        .filter(|c| !c.is_control() || matches!(c, '\n' | '\t'))
+        .collect();
+    let cleaned = cleaned.trim();
+    let body = if cleaned.is_empty() {
+        "An unknown error stopped the app from starting."
+    } else {
+        cleaned
+    };
+    if body.chars().count() <= MAX_MESSAGE_CHARS {
+        return body.to_owned();
+    }
+    let mut cut: String = body.chars().take(MAX_MESSAGE_CHARS - 1).collect();
+    cut.push('\u{2026}');
+    cut
+}
+
+/// `text` as the inside of an AppleScript double-quoted string literal: backslash and double quote
+/// escaped, newlines as `\n`, tabs as `\t`.
+pub fn applescript_escape(text: &str) -> String {
+    let mut out = String::with_capacity(text.len() + 8);
+    for c in text.chars() {
+        match c {
+            '\\' => out.push_str("\\\\"),
+            '"' => out.push_str("\\\""),
+            '\n' => out.push_str("\\n"),
+            '\r' => {}
+            '\t' => out.push_str("\\t"),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+/// The one-line AppleScript `osascript -e` runs for the macOS dialog.
+pub fn applescript_for(title: &str, body: &str) -> String {
+    format!(
+        "display dialog \"{}\" with title \"{}\" buttons {{\"OK\"}} default button \"OK\" with icon stop",
+        applescript_escape(body),
+        applescript_escape(title)
+    )
+}
+
+/// Whether a dialog may be shown now: not in a QA run that must stay hidden.
+pub fn dialog_allowed() -> bool {
+    std::env::var_os("RIGHTKIT_QA_HIDDEN").as_deref() != Some(std::ffi::OsStr::new("1"))
+}
+
+/// Show `error` in a native dialog titled for `app_name` and write it to stderr. Returns once the
+/// person dismisses the dialog. Never panics; a dialog that cannot be shown leaves the stderr line.
+pub fn show(app_name: &str, error: &dyn Display) {
+    let title = title_for(app_name);
+    let body = body_for(error);
+    eprintln!("{title}: {body}");
+    if dialog_allowed() {
+        platform_dialog(&title, &body);
+    }
+}
+
+/// [`show`], then exit the process with status 1.
+pub fn show_and_exit(app_name: &str, error: &dyn Display) -> ! {
+    show(app_name, error);
+    std::process::exit(1)
+}
+
+#[cfg(windows)]
+fn platform_dialog(title: &str, body: &str) {
+    #[link(name = "user32")]
+    extern "system" {
+        fn MessageBoxW(hwnd: *mut std::ffi::c_void, text: *const u16, caption: *const u16, kind: u32) -> i32;
+    }
+    const MB_OK: u32 = 0x0000_0000;
+    const MB_ICONERROR: u32 = 0x0000_0010;
+    const MB_SETFOREGROUND: u32 = 0x0001_0000;
+    const MB_TOPMOST: u32 = 0x0004_0000;
+    let wide = |s: &str| -> Vec<u16> { s.encode_utf16().chain(std::iter::once(0)).collect() };
+    let (text, caption) = (wide(body), wide(title));
+    // SAFETY: both buffers are NUL-terminated UTF-16 that outlive the call; a null owner window is
+    // allowed and makes the box application-modal.
+    unsafe {
+        MessageBoxW(
+            std::ptr::null_mut(),
+            text.as_ptr(),
+            caption.as_ptr(),
+            MB_OK | MB_ICONERROR | MB_SETFOREGROUND | MB_TOPMOST,
+        );
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn platform_dialog(title: &str, body: &str) {
+    let _ = std::process::Command::new("/usr/bin/osascript")
+        .arg("-e")
+        .arg(applescript_for(title, body))
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .status();
+}
+
+#[cfg(all(unix, not(target_os = "macos")))]
+fn platform_dialog(title: &str, body: &str) {
+    use std::process::{Command, Stdio};
+    let quiet = |c: &mut Command| {
+        c.stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .status()
+            .is_ok()
+    };
+    if quiet(Command::new("zenity").args(["--error", "--title", title, "--text", body])) {
+        return;
+    }
+    let _ = quiet(Command::new("kdialog").args(["--title", title, "--error", body]));
+}
+
+#[cfg(not(any(windows, unix)))]
+fn platform_dialog(_title: &str, _body: &str) {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn title_names_the_app_or_falls_back() {
+        assert_eq!(title_for("MailRight"), "MailRight could not start");
+        assert_eq!(title_for("  MailRight "), "MailRight could not start");
+        assert_eq!(title_for("   "), "Could not start");
+    }
+
+    #[test]
+    fn body_strips_control_characters_but_keeps_lines_and_tabs() {
+        assert_eq!(body_for(&"a\u{0}b\u{7}c\r\nd\te"), "abc\nd\te");
+        assert_eq!(
+            body_for(&"  \n "),
+            "An unknown error stopped the app from starting."
+        );
+    }
+
+    #[test]
+    fn body_is_cut_at_the_limit_with_an_ellipsis() {
+        let long = "x".repeat(MAX_MESSAGE_CHARS + 50);
+        let body = body_for(&long);
+        assert_eq!(body.chars().count(), MAX_MESSAGE_CHARS);
+        assert!(body.ends_with('\u{2026}'));
+        let exact = "y".repeat(MAX_MESSAGE_CHARS);
+        assert_eq!(body_for(&exact), exact);
+    }
+
+    #[test]
+    fn body_counts_characters_not_bytes() {
+        let wide = "\u{e9}".repeat(MAX_MESSAGE_CHARS);
+        assert_eq!(body_for(&wide), wide);
+    }
+
+    #[test]
+    fn applescript_escapes_quotes_backslashes_and_newlines() {
+        assert_eq!(
+            applescript_escape("say \"hi\" \\ there\nnext\tline\r"),
+            "say \\\"hi\\\" \\\\ there\\nnext\\tline"
+        );
+    }
+
+    #[test]
+    fn applescript_line_has_title_body_and_a_stop_icon() {
+        let s = applescript_for("App could not start", "bad \"thing\"");
+        assert_eq!(
+            s,
+            "display dialog \"bad \\\"thing\\\"\" with title \"App could not start\" buttons {\"OK\"} default button \"OK\" with icon stop"
+        );
+        // A quote in the message cannot end the literal early: every inner quote is escaped.
+        assert!(!applescript_escape("\"; do shell script \"x").contains("\"; do"));
+    }
+}
diff --git a/crates/rightkit-tauri-shell/src/surface.rs b/crates/rightkit-tauri-shell/src/surface.rs
new file mode 100644
index 0000000..5360f42
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/surface.rs
@@ -0,0 +1,99 @@
+//! Named-surface window sizing. The window is created hidden; the frontend names the surface it is
+//! about to show (`legal`, `onboarding`, `app`), Rust sizes and centres the window, then shows it,
+//! so nothing visibly resizes after it appears. Donor: ScrapeRight `window_surface.rs`.
+//!
+//! ```ignore
+//! Shell::builder("myapp")
+//!     .surface("legal", 960.0, 640.0)
+//!     .surface("onboarding", 960.0, 640.0)
+//!     .surface("app", 1200.0, 760.0)
+//! ```
+//! The page calls `rk_shell_set_surface` with the name. Showing goes through the same reveal guard
+//! as `rk_shell_window` `show`, so a never-show (QA hidden) run stays hidden.
+
+use std::collections::BTreeMap;
+
+/// Largest side a surface may declare, logical pixels.
+const MAX_SIDE: f64 = 16_384.0;
+/// A window already within this many logical pixels of the target is left where it is.
+const SAME_TOLERANCE: f64 = 2.0;
+
+/// The surfaces an app registered.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct Surfaces(BTreeMap<String, (f64, f64)>);
+
+impl Surfaces {
+    /// Register one. Returns false (and registers nothing) for an empty name or a size that is not
+    /// finite, positive and at most 16384.
+    pub fn add(&mut self, name: &str, width: f64, height: f64) -> bool {
+        let ok = |v: f64| v.is_finite() && v > 0.0 && v <= MAX_SIDE;
+        if name.trim().is_empty() || !ok(width) || !ok(height) {
+            return false;
+        }
+        self.0.insert(name.to_owned(), (width, height));
+        true
+    }
+
+    /// Logical `(width, height)` for a surface; `None` for an unknown name.
+    pub fn size(&self, name: &str) -> Option<(f64, f64)> {
+        self.0.get(name).copied()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+
+    pub fn names(&self) -> Vec<&str> {
+        self.0.keys().map(String::as_str).collect()
+    }
+}
+
+/// Whether the window must be resized: it has no readable size, or differs by 2 px or more.
+pub fn needs_resize(current: Option<(f64, f64)>, target: (f64, f64)) -> bool {
+    !current.is_some_and(|c| {
+        (c.0 - target.0).abs() < SAME_TOLERANCE && (c.1 - target.1).abs() < SAME_TOLERANCE
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn registers_and_looks_up_by_name() {
+        let mut s = Surfaces::default();
+        assert!(s.add("legal", 960.0, 640.0));
+        assert!(s.add("app", 1200.0, 760.0));
+        assert_eq!(s.size("legal"), Some((960.0, 640.0)));
+        assert_eq!(s.size("app"), Some((1200.0, 760.0)));
+        assert_eq!(s.size("nope"), None);
+        assert_eq!(s.size(""), None);
+        assert_eq!(s.names(), vec!["app", "legal"]);
+    }
+
+    #[test]
+    fn refuses_bad_names_and_sizes() {
+        let mut s = Surfaces::default();
+        for (n, w, h) in [
+            ("", 100.0, 100.0),
+            ("  ", 100.0, 100.0),
+            ("a", 0.0, 100.0),
+            ("a", -1.0, 100.0),
+            ("a", f64::NAN, 100.0),
+            ("a", 100.0, f64::INFINITY),
+            ("a", 100.0, 20_000.0),
+        ] {
+            assert!(!s.add(n, w, h), "{n} {w} {h}");
+        }
+        assert!(s.is_empty());
+    }
+
+    #[test]
+    fn resize_is_skipped_only_within_the_tolerance() {
+        assert!(!needs_resize(Some((960.0, 640.0)), (960.0, 640.0)));
+        assert!(!needs_resize(Some((961.0, 639.0)), (960.0, 640.0)));
+        assert!(needs_resize(Some((962.0, 640.0)), (960.0, 640.0)));
+        assert!(needs_resize(Some((960.0, 700.0)), (960.0, 640.0)));
+        assert!(needs_resize(None, (960.0, 640.0)));
+    }
+}

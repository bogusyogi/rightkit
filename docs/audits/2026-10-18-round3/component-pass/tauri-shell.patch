+/// What a close of a window does.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CloseAction {
+    /// The close goes ahead; the exit rule decides whether the app ends.
+    Proceed,
+    /// The close is cancelled and the window is hidden.
+    Hide,
+    /// The close goes ahead and the window is destroyed, but the app keeps running.
+    Destroy,
+}
+
+/// The close rule: only the main window of a close-to-tray app, and not while exiting, is kept
+/// alive; `destroy_on_close` makes that a destroy instead of a hide.
+pub fn close_action(
+    close_to_tray: bool,
+    destroy_on_close: bool,
+    is_main: bool,
+    exiting: bool,
+) -> CloseAction {
+    if !close_to_tray || !is_main || exiting {
+        CloseAction::Proceed
+    } else if destroy_on_close {
+        CloseAction::Destroy
+    } else {
+        CloseAction::Hide
+    }
+}

@@ -0,0 +1,108 @@
+#![cfg(feature = "tauri")]
+//! Orthic-Labs/rightkit#386 part B through the public API: the menu plan, the preview scheme, the
+//! WebView2 environment plan, the Settings opener and the shortcut-scope rule. The WebView2 COM paths
+//! (context menu, accelerator keys, new window, ShowPrintUI) need a live WebView2 on Windows.
+
+use std::sync::{Arc, Mutex};
+
+use rightkit_tauri_shell::devtools::{shortcut_scope_allowed, WebviewDecision};
+use rightkit_tauri_shell::os_settings::{self, DEFAULT_APPS};
+use rightkit_tauri_shell::preview::{
+    interactive_csp, serve_preview_request, PreviewKind, PreviewStore, MDX_CSP,
+};
+use rightkit_tauri_shell::print::PrintUi;
+use rightkit_tauri_shell::webview2_env::{self, Webview2Env};
+use rightkit_tauri_shell::webview2_menu::{
+    classify_frame, http_router, ContextMenuConfig, CustomItem, FrameKind, MenuContext,
+    LINK_NEW_WINDOW_ITEM_NAMES,
+};
+use rightkit_tauri_shell::ShellError;
+use tauri::http::{header, Request, StatusCode};
+
+#[test]
+fn a_viewright_style_menu_is_planned_per_frame_and_link() {
+    let picked = Arc::new(Mutex::new(Vec::<String>::new()));
+    let sink = picked.clone();
+    let config = ContextMenuConfig::new(|frame| {
+        classify_frame(frame, &["http://viewright-preview.localhost/", "viewright-preview://"])
+    })
+    .remove_items(&LINK_NEW_WINDOW_ITEM_NAMES)
+    .item(
+        CustomItem::new("Open link in tab", move |ctx| {
+            sink.lock().unwrap().push(ctx.link_uri.clone())
+        })
+        .on_link(),
+    )
+    .item(CustomItem::new("View source", |_| {}).frames(&[FrameKind::Editable]));
+
+    let ctx = |frame: &str, link: &str| MenuContext {
+        frame_uri: frame.into(),
+        link_uri: link.into(),
+        kind: config.classify(frame),
+    };
+    assert_eq!(config.plan(&ctx("about:srcdoc", "x")).items, vec![0, 1]);
+    assert_eq!(config.plan(&ctx("https://example.com/", "https://a")).items, vec![0]);
+    assert!(!config.plan(&ctx("", "")).touch);
+    assert!(!config.plan(&ctx("tauri://localhost/", "https://a")).touch);
+
+    let route = http_router(|_| {});
+    assert!(route("https://example.com"));
+    assert!(!route("file:///etc/hosts"));
+}
+
+#[test]
+fn the_preview_scheme_keeps_the_shipped_policies_and_token_rules() {
+    let store = PreviewStore::new("viewright-site").unwrap();
+    let token = store.register(PreviewKind::Mdx, "<p>x</p>".into()).unwrap();
+    let request = |uri: String| Request::builder().uri(uri).body(Vec::new()).unwrap();
+
+    let ok = serve_preview_request(&store, &request(format!("viewright-preview://localhost/{token}")));
+    assert_eq!(ok.status(), StatusCode::OK);
+    assert_eq!(
+        ok.headers().get(header::CONTENT_SECURITY_POLICY).unwrap(),
+        MDX_CSP
+    );
+    let interactive = store.register(PreviewKind::Interactive, "i".into()).unwrap();
+    let ok = serve_preview_request(&store, &request(format!("viewright-preview://localhost/{interactive}")));
+    assert_eq!(
+        ok.headers().get(header::CONTENT_SECURITY_POLICY).unwrap(),
+        interactive_csp("viewright-site").as_str()
+    );
+
+    store.revoke(&token);

+    }
+
+    #[derive(Default)]
+    struct MemSecrets(Mutex<BTreeMap<(String, String), String>>);
+
+    impl SecretsHost for MemSecrets {
+        fn presence(&self, refs: &[SecretRef]) -> Vec<Presence> {
+            let g = self.0.lock().unwrap();
+            refs.iter()
+                .map(|r| {
+                    if g.contains_key(&(r.service.clone(), r.account.clone())) {
+                        Presence::Present
+                    } else {
+                        Presence::Absent
+                    }
+                })
+                .collect()
+        }
+        fn set(&self, s: &SecretRef, v: &str) -> Result<(), HostError> {
+            self.0
+                .lock()
+                .unwrap()
+                .insert((s.service.clone(), s.account.clone()), v.to_owned());
+            Ok(())
+        }
+        fn clear(&self, s: &SecretRef) -> Result<(), HostError> {
+            self.0
+                .lock()
+                .unwrap()
+                .remove(&(s.service.clone(), s.account.clone()));
+            Ok(())
+        }
+    }
+
+    struct MemModels;
+    impl ModelsHost for MemModels {
+        fn list(&self) -> Result<Vec<ModelEntry>, HostError> {
+            Ok(vec![entry("m1", "missing", None)])
+        }
+        fn install(&self, id: &str, push: ModelPush) -> Result<(), HostError> {
+            push(entry(id, "downloading", Some(0.5)));
+            push(entry(id, "installed", None));
+            Ok(())
+        }
+        fn cancel(&self, _id: &str) -> Result<(), HostError> {
+            Ok(())
+        }
+        fn remove(&self, id: &str) -> Result<(), HostError> {
+            Err(HostError::new("in_use", format!("{id} is in use")))
+        }
+    }
+
+    fn entry(id: &str, state: &str, progress: Option<f64>) -> ModelEntry {
+        ModelEntry {
+            id: id.into(),
+            label: "Label".into(),
+            description: None,
+            size_bytes: Some(10),
+            state: state.into(),
+            progress,
+            revision: None,
+            active: None,
+            fit: None,
+            error: None,
+            removable: None,
+            shared: None,
+        }
+    }
+
+    type Events = Arc<Mutex<Vec<(String, Value)>>>;
+
+    fn sink() -> (EventSink, Events) {
+        let events: Events = Default::default();
+        let e = events.clone();
+        let sink: EventSink = Arc::new(move |name: &str, v: Value| e.lock().unwrap().push((name.to_owned(), v)));
+        (sink, events)
+    }
+
+    fn all() -> (HostHandlers, Arc<MemSettings>) {
+        let settings = Arc::new(MemSettings::default());
+        let h = HostHandlers::new()
+            .settings(settings.clone())
+            .models(MemModels)
+            .secrets(MemSecrets::default());
+        (h, settings)
+    }
+
+    #[test]
+    fn only_registered_groups_are_handled() {
+        assert!(is_host_method(SECRETS_CLEAR) && !is_host_method("render"));
+        let only_secrets = HostHandlers::new().secrets(MemSecrets::default());
+        assert!(only_secrets.handles(SECRETS_SET));
+        assert!(!only_secrets.handles(SETTINGS_GET));
+        assert!(!only_secrets.handles("render"));
+        let (h, _) = all();
+        for m in [
+            SETTINGS_GET,
+            SETTINGS_PATCH,
+            MODELS_LIST,
+            MODELS_INSTALL,
+            MODELS_CANCEL,
+            MODELS_REMOVE,
+            SECRETS_PRESENCE,
+            SECRETS_SET,
+            SECRETS_CLEAR,
+        ] {
+            assert!(h.handles(m), "{m}");
+        }
+    }
+
+    #[test]
+    fn patch_params_are_validated() {
+        let (p, e) = parse_patch_params(&json!({"patch": {"a": 1}, "expectedRevision": 3})).unwrap();
+        assert_eq!(p["a"], 1);
+        assert_eq!(e, Some(3));
+        let (_, e) = parse_patch_params(&json!({"patch": {}, "expectedRevision": null})).unwrap();
+        assert_eq!(e, None);
+        for bad in [
+            json!(null),
+            json!({}),
+            json!({"patch": []}),
+            json!({"patch": {"": 1}}),
+            json!({"patch": {}, "expectedRevision": -1}),
+            json!({"patch": {}, "expectedRevision": "3"}),
+            json!({"patch": {}, "expectedRevision": 1.5}),
+        ] {
+            assert_eq!(parse_patch_params(&bad).unwrap_err().code, "invalid", "{bad}");
+        }
+    }
+
+    #[test]
+    fn settings_get_patch_conflict_and_changed_event() {
+        let (h, _) = all();
+        let (sink, events) = sink();
+        let snap = h.call(SETTINGS_GET, Value::Null, &sink).unwrap();
+        assert_eq!(snap, json!({"values": {}, "revision": 0}));
+        let snap = h
+            .call(SETTINGS_PATCH, json!({"patch": {"theme": "dark"}, "expectedRevision": 0}), &sink)
+            .unwrap();
+        assert_eq!(snap, json!({"values": {"theme": "dark"}, "revision": 1}));
+        assert_eq!(
+            events.lock().unwrap().as_slice(),
+            &[(EVENT_SETTINGS_CHANGED.to_owned(), json!({"keys": ["theme"]}))]
+        );
+        // A stale revision is the code settings-ui retries on, and writes nothing.
+        let err = h
+            .call(SETTINGS_PATCH, json!({"patch": {"theme": "light"}, "expectedRevision": 0}), &sink)
+            .unwrap_err();
+        assert_eq!(err.code, CODE_REVISION_CONFLICT);
+        assert_eq!(
+            h.call(SETTINGS_GET, Value::Null, &sink).unwrap()["values"]["theme"],
+            "dark"
+        );
+        // null removes; an unchanged patch emits nothing.
+        h.call(SETTINGS_PATCH, json!({"patch": {"theme": null}}), &sink).unwrap();
+        let before = events.lock().unwrap().len();
+        h.call(SETTINGS_PATCH, json!({"patch": {"theme": null}}), &sink).unwrap();
+        assert_eq!(events.lock().unwrap().len(), before);
+    }
+
+    #[test]
+    fn watch_events_reach_the_sink_and_the_guard_is_kept() {
+        let (h, settings) = all();
+        let (sink, events) = sink();
+        h.start(sink);
+        assert_eq!(h.guards.lock().unwrap().len(), 1);
+        let watchers = settings.watchers.lock().unwrap().clone();
+        watchers[0](vec!["a".into(), "b".into()]);
+        watchers[0](Vec::new());
+        assert_eq!(
+            events.lock().unwrap().as_slice(),
+            &[(EVENT_SETTINGS_CHANGED.to_owned(), json!({"keys": ["a", "b"]}))]
+        );
+    }
+
+    #[test]
+    fn model_calls_validate_ids_push_rows_and_pass_errors_through() {
+        let (h, _) = all();
+        let (sink, events) = sink();
+        let list = h.call(MODELS_LIST, Value::Null, &sink).unwrap();
+        assert_eq!(list[0]["id"], "m1");
+        assert_eq!(list[0]["sizeBytes"], 10);
+        assert!(list[0].get("progress").is_none(), "None fields are omitted");
+        h.call(MODELS_INSTALL, json!({"id": "m1"}), &sink).unwrap();
+        let ev = events.lock().unwrap().clone();
+        assert_eq!(ev.len(), 2);
+        assert_eq!(ev[0].0, EVENT_MODELS_ENTRY);
+        assert_eq!(ev[0].1["state"], "downloading");
+        assert_eq!(ev[0].1["progress"], 0.5);
+        assert_eq!(h.call(MODELS_REMOVE, json!({"id": "m1"}), &sink).unwrap_err().code, "in_use");
+        for bad in [json!({}), json!({"id": ""}), json!({"id": "a\nb"}), json!({"id": 4})] {
+            assert_eq!(h.call(MODELS_CANCEL, bad, &sink).unwrap_err().code, "invalid");
+        }
+        assert!(parse_model_id(&json!({"id": "x".repeat(201)})).is_err());
+    }
+
+    #[test]
+    fn secrets_set_presence_clear_and_never_return_values() {
+        let (h, _) = all();
+        let (sink, _) = sink();
+        let r = json!({"service": "app", "account": "api-key"});
+        let other = json!({"service": "app", "account": "other"});
+        assert_eq!(
+            h.call(SECRETS_PRESENCE, json!({"refs": [r, other]}), &sink).unwrap(),
+            json!(["absent", "absent"])
+        );
+        let out = h.call(SECRETS_SET, json!({"ref": r, "value": "s3cret"}), &sink).unwrap();
+        assert_eq!(out, Value::Null, "set returns nothing");
+        assert_eq!(
+            h.call(SECRETS_PRESENCE, json!({"refs": [r, other]}), &sink).unwrap(),
+            json!(["present", "absent"])
+        );
+        h.call(SECRETS_CLEAR, json!({"ref": r}), &sink).unwrap();
+        // Clearing what is absent is success.
+        h.call(SECRETS_CLEAR, json!({"ref": r}), &sink).unwrap();
+        assert_eq!(
+            h.call(SECRETS_PRESENCE, json!({"refs": [r]}), &sink).unwrap(),
+            json!(["absent"])
+        );
+    }
+
+    #[test]
+    fn secret_params_are_checked() {
+        let ok = json!({"service": "s", "account": "a"});
+        assert!(parse_secret_one(&json!({"ref": ok})).is_ok());
+        for bad in [
+            json!({}),
+            json!({"ref": {"service": "", "account": "a"}}),
+            json!({"ref": {"service": "s", "account": "a\u{0}b"}}),
+            json!({"ref": {"service": "s"}}),
+            json!({"ref": {"service": "x".repeat(251), "account": "a"}}),
+        ] {
+            assert_eq!(parse_secret_one(&bad).unwrap_err().code, "invalid", "{bad}");
+        }
+        assert!(parse_secret_set(&json!({"ref": ok, "value": ""})).is_err());
+        assert!(parse_secret_set(&json!({"ref": ok})).is_err());
+        assert!(parse_secret_set(&json!({"ref": ok, "value": "x".repeat(MAX_SECRET_VALUE + 1)})).is_err());
+        assert!(parse_secret_refs(&json!({"refs": []})).unwrap().is_empty());
+        assert!(parse_secret_refs(&json!({"refs": vec![ok.clone(); 257]})).is_err());
+        assert!(parse_secret_refs(&json!({})).is_err());
+    }
+
+    #[test]
+    fn a_careless_presence_adapter_is_padded_to_one_answer_per_ref() {
+        struct Short;
+        impl SecretsHost for Short {
+            fn presence(&self, _: &[SecretRef]) -> Vec<Presence> {
+                vec![Presence::Present]
+            }
+            fn set(&self, _: &SecretRef, _: &str) -> Result<(), HostError> {
+                Ok(())
+            }
+            fn clear(&self, _: &SecretRef) -> Result<(), HostError> {
+                Ok(())
+            }
+        }
+        let h = HostHandlers::new().secrets(Short);
+        let (sink, _) = sink();
+        let r = json!({"service": "s", "account": "a"});
+        assert_eq!(
+            h.call(SECRETS_PRESENCE, json!({"refs": [r, r]}), &sink).unwrap(),
+            json!(["present", "unknown"])
+        );
+    }
+
+    #[test]
+    fn errors_have_the_legacy_string_and_tagged_json_shapes() {
+        let e = HostError::conflict(1, 2);
+        assert_eq!(String::from(e.clone()), format!("{CODE_REVISION_CONFLICT}: {}", e.message));
+        assert_eq!(e.to_json()["origin"], "host");
+        assert_eq!(e.to_json()["code"], CODE_REVISION_CONFLICT);
+    }
+
+    #[test]
+    fn unregistered_group_call_is_unsupported_not_a_panic() {
+        let h = HostHandlers::new();
+        let (sink, _) = sink();
+        assert_eq!(h.call(SETTINGS_GET, Value::Null, &sink).unwrap_err().code, "unsupported");
+        assert_eq!(h.call("other", Value::Null, &sink).unwrap_err().code, "unsupported");
+    }
+
+    #[test]
+    fn merge_and_changed_keys() {
+        let mut doc = Map::new();
+        doc.insert("a".into(), json!(1));
+        let before = doc.clone();
+        let patch = json!({"a": 1, "b": 2, "c": null}).as_object().unwrap().clone();
+        merge_patch(&mut doc, &patch);
+        assert_eq!(doc, json!({"a": 1, "b": 2}).as_object().unwrap().clone());
+        assert_eq!(changed_keys(&before, &doc, &patch), vec!["b".to_string()]);
+    }
+
+    #[test]
+    fn counts_calls_once() {
+        // The sink is called once per event, never twice for one patch.
+        let (h, _) = all();
+        let n = Arc::new(AtomicUsize::new(0));
+        let c = n.clone();
+        let sink: EventSink = Arc::new(move |_: &str, _: Value| {
+            c.fetch_add(1, Ordering::SeqCst);
+        });
+        h.call(SETTINGS_PATCH, json!({"patch": {"k": 1}}), &sink).unwrap();
+        assert_eq!(n.load(Ordering::SeqCst), 1);
+    }
+}

+test('host method rejections become {code, message} so settings-ui sees revision_conflict', async () => {
+  const host = fakeHost({
+    handlers: {
+      rk_shell_engine_call: ({ method }) => {
+        if (method === 'rightkit.settings.patch') throw 'revision_conflict: settings changed since revision 1; now at revision 2';
+        if (method === 'render') throw 'engine_exited: gone';
+        return null;
+      },
+    },
+  });
+  const shell = createShell(host.transport);
+  await assert.rejects(shell.engine.call('rightkit.settings.patch', { patch: {}, expectedRevision: 1 }), (e) => {
+    assert.equal(e.code, 'revision_conflict');
+    assert.match(e.message, /now at revision 2/);
+    assert.equal(e.origin, 'host');
+    return true;
+  });
+  // Other methods keep the legacy string rejection.
+  await assert.rejects(shell.engine.call('render'), (e) => e === 'engine_exited: gone');
+});

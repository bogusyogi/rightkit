+// ---------------------------------------------------------------------------------------------
+// Content-only inspector shortcut scope (Orthic-Labs/rightkit#386, part B)
+//
+// Donor: ViewRight `commands/external.rs` (`set_devtools_shortcut_scope`, the macOS inspector
+// guard). The native "open the inspector" accelerators (Cmd+Option+I on WKWebView, F12 and
+// Ctrl+Shift+I on WebView2) are handled by the engine BELOW page JavaScript, so a page cannot cancel
+// them. An app that wants them only while a content surface owns focus turns them on when that
+// surface takes focus and off when it loses it.
+// ---------------------------------------------------------------------------------------------
+
+/// Whether the shortcut scope of a webview whose policy decision is `decision` may be set to
+/// `enabled`. Turning shortcuts OFF is always allowed; turning them ON is refused for a denied
+/// webview, so no app code can re-enable the inspector keys of its own UI.
+pub fn shortcut_scope_allowed(decision: WebviewDecision, enabled: bool) -> bool {
+    !enabled || decision != WebviewDecision::Deny
+}
+
+/// Enable or disable the native inspector shortcuts of the webview labelled `label`, at run time.
+///
+/// * macOS: the private `developerExtrasEnabled` preference, which also installs WebKit's own
+///   Cmd+Option+I handler.
+/// * Windows: the inspector and view-source keys (F12, Ctrl+Shift+I/J/C, Ctrl+U) of the shell's
+///   key handler. The webview must already have been set up by the shell (it adds the handler).
+/// * Other platforms: no-op.
+///
+/// Off by default and opt-in only (ViewRight is the only app allowed to enable it): with neither
+/// `content-devtools` nor `dev-inspect` compiled in, enabling is always refused.
+///
+/// Refused with [`DevToolsError::NotAContentWebview`] when `enabled` is true and the shell denies
+/// DevTools for that webview, and with [`DevToolsError::NotInstalled`] when the shell's gate is
+/// missing. Disabling never fails on policy grounds.
+pub fn set_inspector_shortcut_scope<R: Runtime>(
+    app: &AppHandle<R>,
+    label: &str,
+    enabled: bool,
+) -> Result<(), DevToolsError> {
+    // Settled decision (rightkit#771 D2): no DevTools in any app build. The inspector keys are OFF
+    // by default and can be turned on only in a build that compiled DevTools in (`content-devtools`,
+    // which only ViewRight may ship, or the dev-only `dev-inspect`).
+    #[cfg(not(any(feature = "content-devtools", feature = "dev-inspect")))]
+    if enabled {
+        return Err(DevToolsError::NotAContentWebview {
+            label: label.to_owned(),
+        });
+    }
+    if enabled {
+        let gate = app
+            .try_state::<DevToolsGate>()
+            .ok_or(DevToolsError::NotInstalled)?;
+        if !shortcut_scope_allowed(gate.decide(label), true) {
+            return Err(DevToolsError::NotAContentWebview {
+                label: label.to_owned(),
+            });
+        }
+    }
+    #[cfg(windows)]
+    {
+        let _ = app;
+        set_devtools_keys(label, enabled);
+        Ok(())
+    }
+    #[cfg(target_os = "macos")]
+    {
+        let webview = app
+            .get_webview(label)
+            .ok_or_else(|| DevToolsError::WebviewMissing {
+                label: label.to_owned(),
+            })?;
+        macos_inspector::set_shortcuts(&webview, enabled);
+        Ok(())
+    }
+    #[cfg(not(any(windows, target_os = "macos")))]
+    {
+        let _ = (app, label, enabled);
+        Ok(())
+    }
+}
+
+/// Script run in the WebKit inspector's own frontend: no element picker (it could select the app
+/// shell), Elements tab first. Evaluates to `true` once the frontend has been configured.
+pub const INSPECTOR_FRONTEND_SETUP_JS: &str = r#"(() => {
+  const inspector = globalThis.WI;
+  if (!inspector) return false;
+  if (inspector.domManager?.inspectModeEnabled)
+    inspector.domManager.inspectModeEnabled = false;
+  if (inspector._inspectModeKeyboardShortcut)
+    inspector._inspectModeKeyboardShortcut.disabled = true;
+  if (inspector._inspectModeTabBarButton) {
+    inspector._inspectModeTabBarButton.activated = false;
+    inspector._inspectModeTabBarButton.enabled = false;
+    inspector._inspectModeTabBarButton.hidden = true;
+  }
+  inspector._updateTabBarDividers?.();
+  inspector.showElementsTab?.();
+  return true;
+})()"#;
+
+/// Whether `url` is the URL of a WebKit inspector frontend view.
+pub fn is_inspector_frontend_url(url: &str) -> bool {
+    url.starts_with("inspector-resource:")
+}
+
+/// macOS: WKInspector belongs to a whole WKWebView, so its native element picker could select
+/// the app shell if the inspected webview hosts it. [`guard`] keeps the picker off for as long as
+/// the webview exists; it is called by [`open_content_devtools`] after it opens the inspector.
+#[cfg(target_os = "macos")]
+mod macos_inspector {
+    use super::*;
+    use block2::RcBlock;
+    use objc2::msg_send;
+    use objc2::rc::Retained;
+    use objc2::runtime::{AnyClass, AnyObject};
+    use objc2_foundation::{ns_string, NSError, NSNumber, NSString};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::time::Duration;
+
+    /// Address of the inspector frontend view already configured (0 when none).
+    static CONFIGURED_FRONTEND: AtomicUsize = AtomicUsize::new(0);
+
+    pub fn set_shortcuts<R: Runtime>(webview: &Webview<R>, enabled: bool) {
+        let _ = webview.with_webview(move |platform| unsafe {
+            // SAFETY: Tauri hands over the live WKWebView; used only inside this main-thread closure.
+            let wk = &*(platform.inner() as *mut AnyObject);
+            let configuration: Retained<AnyObject> = msg_send![wk, configuration];
+            let preferences: Retained<AnyObject> = msg_send![&configuration, preferences];
+            let value = NSNumber::numberWithBool(enabled);
+            let (): () = msg_send![
+                &preferences,
+                setValue: Some(&*value),
+                forKey: ns_string!("developerExtrasEnabled")
+            ];
+        });
+    }
+
+    pub fn guard<R: Runtime>(webview: &Webview<R>) {
+        let app = webview.app_handle().clone();
+        let label = webview.label().to_owned();
+        let _ = webview.with_webview(move |platform| unsafe {
+            // SAFETY: as above. `_inspector` is WebKit SPI, the same call ViewRight shipped.
+            let wk = &*(platform.inner() as *mut AnyObject);
+            let inspector: Option<Retained<AnyObject>> = msg_send![wk, _inspector];
+            let Some(inspector) = inspector else { return };
+            // One +1 reference is held for the guard's life and released when the webview is gone.
+            let pointer = Retained::into_raw(inspector) as usize;
+            std::thread::spawn(move || run(app, label, pointer));
+        });
+    }
+
+    /// Tick on the main thread every 50 ms while the inspector is open and unconfigured, otherwise
+    /// every 250 ms, until the webview is gone or the app is shutting down.
+    fn run<R: Runtime>(app: AppHandle<R>, label: String, pointer: usize) {
+        let mut delay = Duration::from_millis(50);
+        loop {
+            std::thread::sleep(delay);
+            let alive = app.get_webview(&label).is_some();
+            let (tx, rx) = std::sync::mpsc::channel();
+            let dispatched = app.run_on_main_thread(move || {
+                // SAFETY: `pointer` is the +1 reference taken in `guard`, valid until released below.
+                let state = unsafe { tick(pointer, alive) };
+                let _ = tx.send(state);
+            });
+            let state = if dispatched.is_ok() {
+                rx.recv_timeout(Duration::from_secs(5)).ok()
+            } else {
+                None
+            };
+            match state {
+                Some(Tick::Gone) | None => return,
+                Some(Tick::Pending) => delay = Duration::from_millis(50),
+                Some(Tick::Idle) => delay = Duration::from_millis(250),
+            }
+        }
+    }
+
+    enum Tick {
+        /// Open and not yet configured.
+        Pending,
+        /// Closed, or configured.
+        Idle,
+        /// The webview is gone; the reference was released.
+        Gone,
+    }
+
+    unsafe fn tick(pointer: usize, alive: bool) -> Tick {
+        if !alive {
+            // SAFETY: gives back the +1 reference from `guard`; the pointer is never used again.
+            drop(unsafe { Retained::from_raw(pointer as *mut AnyObject) });
+            CONFIGURED_FRONTEND.store(0, Ordering::Relaxed);
+            return Tick::Gone;
+        }
+        // SAFETY: valid, retained object.
+        let inspector = unsafe { &*(pointer as *const AnyObject) };
+        let visible: bool = unsafe { msg_send![inspector, isVisible] };
+        if !visible {
+            CONFIGURED_FRONTEND.store(0, Ordering::Relaxed);
+            return Tick::Idle;
+        }
+        unsafe { configure(inspector) };
+        if CONFIGURED_FRONTEND.load(Ordering::Relaxed) == 0 {
+            Tick::Pending
+        } else {
+            Tick::Idle
+        }
+    }
+
+    unsafe fn configure(inspector: &AnyObject) {
+        let selecting: bool = unsafe { msg_send![inspector, isElementSelectionActive] };
+        if selecting {
+            let (): () = unsafe { msg_send![inspector, toggleElementSelection] };
+        }
+        if CONFIGURED_FRONTEND.load(Ordering::Relaxed) != 0 {
+            return;
+        }
+        let Some(frontend) = (unsafe { find_frontend() }) else {
+            return;
+        };
+        let loading: bool = unsafe { msg_send![&*frontend, isLoading] };
+        if loading {
+            return;
+        }
+        let address = Retained::as_ptr(&frontend) as usize;
+        let script = NSString::from_str(INSPECTOR_FRONTEND_SETUP_JS);
+        let completion: RcBlock<dyn Fn(*mut AnyObject, *mut NSError)> =
+            RcBlock::new(move |value: *mut AnyObject, error: *mut NSError| {
+                if error.is_null() && !value.is_null() {
+                    // SAFETY: `value` is the NSNumber WebKit passes to the completion handler.
+                    let configured: bool = unsafe { msg_send![&*value, boolValue] };
+                    if configured {
+                        CONFIGURED_FRONTEND.store(address, Ordering::Relaxed);
+                    }
+                }
+            });
+        let (): () = unsafe {
+            msg_send![
+                &*frontend,
+                evaluateJavaScript: &*script,
+                completionHandler: &*completion
+            ]
+        };
+    }
+
+    /// The inspector frontend WKWebView, found by walking every window's view tree.
+    unsafe fn find_frontend() -> Option<Retained<AnyObject>> {
+        let application_class = AnyClass::get(c"NSApplication")?;
+        let application: Option<Retained<AnyObject>> =
+            unsafe { msg_send![application_class, sharedApplication] };
+        let windows: Retained<AnyObject> = unsafe { msg_send![&*application?, windows] };
+        let count: usize = unsafe { msg_send![&*windows, count] };
+        for index in 0..count {
+            let window: Option<Retained<AnyObject>> =
+                unsafe { msg_send![&*windows, objectAtIndex: index] };
+            let content: Option<Retained<AnyObject>> =
+                unsafe { msg_send![&*window?, contentView] };
+            if let Some(found) = content.and_then(|view| unsafe { search(view) }) {
+                return Some(found);
+            }
+        }
+        None
+    }
+
+    unsafe fn search(view: Retained<AnyObject>) -> Option<Retained<AnyObject>> {
+        if let Some(web_view_class) = AnyClass::get(c"WKWebView") {
+            let is_web_view: bool =
+                unsafe { msg_send![&*view, isKindOfClass: web_view_class] };
+            if is_web_view {
+                let url: Option<Retained<AnyObject>> = unsafe { msg_send![&*view, URL] };
+                let text: Option<Retained<NSString>> =
+                    url.and_then(|url| unsafe { msg_send![&*url, absoluteString] });
+                if text.is_some_and(|t| is_inspector_frontend_url(&t.to_string())) {
+                    return Some(view);
+                }
+            }
+        }
+        let children: Retained<AnyObject> = unsafe { msg_send![&*view, subviews] };
+        let count: usize = unsafe { msg_send![&*children, count] };
+        for index in 0..count {
+            let child: Option<Retained<AnyObject>> =
+                unsafe { msg_send![&*children, objectAtIndex: index] };
+            if let Some(found) = child.and_then(|child| unsafe { search(child) }) {
+                return Some(found);
+            }
+        }
+        None
+    }
+}
+
+#[cfg(test)]
+mod shortcut_scope_tests {
+    use super::*;
+
+    #[test]
+    fn shortcuts_can_always_go_off_but_only_on_for_a_non_denied_webview() {
+        for decision in [
+            WebviewDecision::Deny,
+            WebviewDecision::AllowContent,
+            WebviewDecision::AllowDev,
+        ] {
+            assert!(shortcut_scope_allowed(decision, false), "{decision:?}");
+        }
+        assert!(!shortcut_scope_allowed(WebviewDecision::Deny, true));
+        assert!(shortcut_scope_allowed(WebviewDecision::AllowContent, true));
+        assert!(shortcut_scope_allowed(WebviewDecision::AllowDev, true));
+    }
+
+    #[test]
+    fn the_inspector_keys_cannot_be_turned_on_without_a_gate_or_the_devtools_features() {
+        // Settled decision rightkit#771 D2: off by default, opt-in only. With no DevTools feature
+        // compiled in, or no gate managed, enabling is refused whatever the label.
+        let app = tauri::test::mock_app();
+        for label in ["main", "content", ""] {
+            assert!(
+                set_inspector_shortcut_scope(app.handle(), label, true).is_err(),
+                "{label:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn the_frontend_is_recognised_by_its_scheme_and_the_setup_script_is_self_contained() {
+        assert!(is_inspector_frontend_url(
+            "inspector-resource:///Main.html"
+        ));
+        assert!(!is_inspector_frontend_url("https://inspector-resource:/"));
+        assert!(!is_inspector_frontend_url(""));
+        assert!(INSPECTOR_FRONTEND_SETUP_JS.contains("inspectModeEnabled = false"));
+        assert!(INSPECTOR_FRONTEND_SETUP_JS.contains("showElementsTab"));
+        assert!(INSPECTOR_FRONTEND_SETUP_JS.trim_end().ends_with("})()"));
+    }
+}

index 0000000..43051b8
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/window_icon.rs
@@ -0,0 +1,262 @@
+//! Window and taskbar icon on Windows (Orthic-Labs/rightkit#498).
+//!
+//! Donor: MailRight `lib.rs` `apply_window_icon`. In a dev build (and for any window created after
+//! startup) Windows can show the generic executable icon in the taskbar and Alt+Tab, because the
+//! icon the window class carries is not the one the app configured. Sending `WM_SETICON` with a
+//! big (32 px) and a small (16 px) icon fixes it. [`apply_icon`] does that for one window from RGBA
+//! pixels; [`apply_default_icon`] uses the app's configured default window icon; the shell does it
+//! for every webview it sees when [`crate::ShellBuilder::sync_window_icon`] is on.
+//!
+//! The pixel work ([`resize_rgba`], [`rgba_to_bgra`], [`and_mask`]) is plain Rust and unit-tested;
+//! only the two `user32` calls are Windows-only. Off Windows every function does nothing and
+//! returns `Ok`, so callers need no `cfg`.
+
+use tauri::{Runtime, WebviewWindow};
+
+use crate::ShellError;
+
+/// Large icon edge, pixels (`SM_CXICON` at 100% scale).
+pub const BIG: u32 = 32;
+/// Small icon edge, pixels (`SM_CXSMICON` at 100% scale).
+pub const SMALL: u32 = 16;
+/// Largest source edge accepted, pixels.
+pub const MAX_SOURCE_EDGE: u32 = 4096;
+
+/// Check an RGBA buffer is `width * height * 4` bytes with both edges in `1..=MAX_SOURCE_EDGE`.
+pub fn check_rgba(rgba: &[u8], width: u32, height: u32) -> Result<(), ShellError> {
+    if width == 0 || height == 0 || width > MAX_SOURCE_EDGE || height > MAX_SOURCE_EDGE {
+        return Err(ShellError::Invalid(format!(
+            "icon size {width}x{height} is outside 1..={MAX_SOURCE_EDGE}"
+        )));
+    }
+    let expected = width as usize * height as usize * 4;
+    if rgba.len() != expected {
+        return Err(ShellError::Invalid(format!(
+            "icon has {} bytes, expected {expected} for {width}x{height} RGBA",
+            rgba.len()
+        )));
+    }
+    Ok(())
+}
+
+/// Scale RGBA pixels to `target x target` with a box filter (area average, alpha-weighted so a
+/// transparent edge does not bleed dark fringes). A source already at the target size is copied.
+pub fn resize_rgba(rgba: &[u8], width: u32, height: u32, target: u32) -> Result<Vec<u8>, ShellError> {
+    check_rgba(rgba, width, height)?;
+    if target == 0 || target > MAX_SOURCE_EDGE {
+        return Err(ShellError::Invalid(format!("icon target {target} is not valid")));
+    }
+    if width == target && height == target {
+        return Ok(rgba.to_vec());
+    }
+    let (w, h, t) = (width as usize, height as usize, target as usize);
+    let mut out = vec![0u8; t * t * 4];
+    for ty in 0..t {
+        let y0 = ty * h / t;
+        let y1 = ((ty + 1) * h / t).max(y0 + 1).min(h);
+        for tx in 0..t {
+            let x0 = tx * w / t;
+            let x1 = ((tx + 1) * w / t).max(x0 + 1).min(w);
+            let (mut r, mut g, mut b, mut a, mut n) = (0u64, 0u64, 0u64, 0u64, 0u64);
+            for y in y0..y1 {
+                for x in x0..x1 {
+                    let p = (y * w + x) * 4;
+                    let alpha = rgba[p + 3] as u64;
+                    r += rgba[p] as u64 * alpha;
+                    g += rgba[p + 1] as u64 * alpha;
+                    b += rgba[p + 2] as u64 * alpha;
+                    a += alpha;
+                    n += 1;
+                }
+            }
+            let o = (ty * t + tx) * 4;
+            if a > 0 {
+                out[o] = (r / a) as u8;
+                out[o + 1] = (g / a) as u8;
+                out[o + 2] = (b / a) as u8;
+            }
+            out[o + 3] = (a / n.max(1)) as u8;
+        }
+    }
+    Ok(out)
+}
+
+/// Swap RGBA to the BGRA byte order Windows icons use.
+pub fn rgba_to_bgra(rgba: &[u8]) -> Vec<u8> {
+    let mut out = rgba.to_vec();
+    for px in out.chunks_exact_mut(4) {
+        px.swap(0, 2);
+    }
+    out
+}
+
+/// The 1-bit AND mask of a `width x height` icon: all zero (fully drawn), rows padded to 16 bits as
+/// `CreateIcon` expects. With a 32-bit colour plane Windows takes transparency from the alpha
+/// channel, so the mask never hides anything.
+pub fn and_mask(width: u32, height: u32) -> Vec<u8> {
+    let row_bytes = (width as usize).div_ceil(16) * 2;
+    vec![0u8; row_bytes * height as usize]
+}
+
+#[cfg(windows)]
+mod native {
+    use std::ffi::c_void;
+
+    #[link(name = "user32")]
+    extern "system" {
+        fn CreateIcon(
+            instance: *mut c_void,
+            width: i32,
+            height: i32,
+            planes: u8,
+            bits_per_pixel: u8,
+            and_bits: *const u8,
+            xor_bits: *const u8,
+        ) -> *mut c_void;
+        fn DestroyIcon(icon: *mut c_void) -> i32;
+        fn SendMessageW(hwnd: *mut c_void, msg: u32, wparam: usize, lparam: isize) -> isize;
+    }
+    const WM_SETICON: u32 = 0x0080;
+    const ICON_SMALL: usize = 0;
+    const ICON_BIG: usize = 1;
+
+    fn make(bgra: &[u8], mask: &[u8], edge: u32) -> Result<*mut c_void, String> {
+        // SAFETY: both buffers are valid for the sizes `CreateIcon` reads (edge*edge*4 colour bytes
+        // and ceil(edge/16)*2*edge mask bytes); a null instance is allowed.
+        let icon = unsafe {
+            CreateIcon(
+                std::ptr::null_mut(),
+                edge as i32,
+                edge as i32,
+                1,
+                32,
+                mask.as_ptr(),
+                bgra.as_ptr(),
+            )
+        };
+        if icon.is_null() {
+            Err(format!("CreateIcon({edge}) failed"))
+        } else {
+            Ok(icon)
+        }
+    }
+
+    /// `(big, small)` BGRA buffers, each with its own mask and edge.
+    pub fn set(hwnd: isize, big: (&[u8], &[u8], u32), small: (&[u8], &[u8], u32)) -> Result<(), String> {
+        let big_icon = make(big.0, big.1, big.2)?;
+        let small_icon = match make(small.0, small.1, small.2) {
+            Ok(i) => i,
+            Err(e) => {
+                // SAFETY: `big_icon` was just created and is not yet attached to anything.
+                unsafe { DestroyIcon(big_icon) };
+                return Err(e);
+            }
+        };
+        let hwnd = hwnd as *mut c_void;
+        // SAFETY: `hwnd` is a live window of this process; WM_SETICON returns the previous icon,
+        // which we created earlier (or the class icon, which `DestroyIcon` must not free).
+        unsafe {
+            SendMessageW(hwnd, WM_SETICON, ICON_BIG, big_icon as isize);
+            SendMessageW(hwnd, WM_SETICON, ICON_SMALL, small_icon as isize);
+        }
+        // The window now owns both icons for its lifetime; they are intentionally not destroyed.
+        Ok(())
+    }
+}
+
+/// Set the big and small taskbar / Alt+Tab icons of `window` from `width x height` RGBA pixels.
+/// Windows only; `Ok(())` and no effect elsewhere.
+pub fn apply_icon<R: Runtime>(
+    window: &WebviewWindow<R>,
+    rgba: &[u8],
+    width: u32,
+    height: u32,
+) -> Result<(), ShellError> {
+    check_rgba(rgba, width, height)?;
+    #[cfg(windows)]
+    {
+        let hwnd = window
+            .hwnd()
+            .map_err(|e| ShellError::Other(format!("window handle: {e}")))?;
+        let big = rgba_to_bgra(&resize_rgba(rgba, width, height, BIG)?);
+        let small = rgba_to_bgra(&resize_rgba(rgba, width, height, SMALL)?);
+        let (big_mask, small_mask) = (and_mask(BIG, BIG), and_mask(SMALL, SMALL));
+        native::set(
+            hwnd.0 as isize,
+            (&big, &big_mask, BIG),
+            (&small, &small_mask, SMALL),
+        )
+        .map_err(ShellError::Other)
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = window;
+        Ok(())
+    }
+}
+
+/// [`apply_icon`] with the app's configured default window icon (`tauri.conf.json` bundle icon).
+/// `Ok(false)` when the app has no default icon, `Ok(true)` when one was applied.
+pub fn apply_default_icon<R: Runtime>(window: &WebviewWindow<R>) -> Result<bool, ShellError> {
+    use tauri::Manager;
+    let app = window.app_handle();
+    let Some(icon) = app.default_window_icon() else {
+        return Ok(false);
+    };
+    apply_icon(window, icon.rgba(), icon.width(), icon.height())?;
+    Ok(true)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn solid(w: u32, h: u32, px: [u8; 4]) -> Vec<u8> {
+        px.iter().copied().cycle().take((w * h * 4) as usize).collect()
+    }
+
+    #[test]
+    fn rgba_size_is_checked() {
+        assert!(check_rgba(&solid(2, 2, [0; 4]), 2, 2).is_ok());
+        assert!(check_rgba(&[0; 15], 2, 2).is_err());
+        assert!(check_rgba(&[], 0, 4).is_err());
+        assert!(check_rgba(&[0; 4], 1, MAX_SOURCE_EDGE + 1).is_err());
+    }
+
+    #[test]
+    fn same_size_is_copied_and_solid_colour_survives_scaling() {
+        let src = solid(64, 64, [10, 20, 30, 255]);
+        assert_eq!(resize_rgba(&src, 64, 64, 64).unwrap(), src);
+        let small = resize_rgba(&src, 64, 64, 16).unwrap();
+        assert_eq!(small.len(), 16 * 16 * 4);
+        assert!(small.chunks_exact(4).all(|p| p == [10, 20, 30, 255]));
+        let up = resize_rgba(&solid(4, 4, [1, 2, 3, 255]), 4, 4, 32).unwrap();
+        assert!(up.chunks_exact(4).all(|p| p == [1, 2, 3, 255]));
+    }
+
+    #[test]
+    fn transparent_pixels_do_not_darken_the_colour_of_opaque_neighbours() {
+        // Left half opaque red, right half fully transparent black, halved to 1 pixel wide.
+        let mut src = Vec::new();
+        for _ in 0..2 {
+            src.extend_from_slice(&[255, 0, 0, 255]);
+            src.extend_from_slice(&[0, 0, 0, 0]);
+        }
+        let out = resize_rgba(&src, 2, 2, 1).unwrap();
+        assert_eq!(&out[..3], &[255, 0, 0]);
+        assert_eq!(out[3], 127);
+    }
+
+    #[test]
+    fn bgra_swaps_red_and_blue_only() {
+        assert_eq!(rgba_to_bgra(&[1, 2, 3, 4, 5, 6, 7, 8]), vec![3, 2, 1, 4, 7, 6, 5, 8]);
+    }
+
+    #[test]
+    fn and_mask_rows_are_padded_to_sixteen_bits() {
+        assert_eq!(and_mask(16, 16).len(), 32);
+        assert_eq!(and_mask(32, 32).len(), 128);
+        assert_eq!(and_mask(17, 2).len(), 8);
+        assert!(and_mask(16, 16).iter().all(|b| *b == 0));
+    }
+}

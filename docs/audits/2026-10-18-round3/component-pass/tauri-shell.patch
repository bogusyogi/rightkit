+/// Snapshot-atomic engine stream. The stream receiver attaches first, then `snapshot_method` (if
+/// any, and allowlisted) runs, so no event between the snapshot and the subscription is lost.
+/// Events arrive on `on_event` as `{call, tag?, event}` (the same frames as `rightkit-shell://engine`,
+/// plus `$lifecycle` changes), in order, after the snapshot was taken. Returns
+/// `{snapshot, lifecycle}`. A later subscription replaces this one. Coalescing is the engine
+/// spec's `stream_coalesce`.
+#[tauri::command]
+pub async fn rk_shell_engine_subscribe(
+    on_event: tauri::ipc::Channel<Value>,
+    snapshot_method: Option<String>,
+    params: Option<Value>,
+    tag: Option<String>,
+    app: AppHandle<Wry>,
+) -> Result<Value, String> {
+    #[cfg(feature = "engine")]
+    {
+        tauri::async_runtime::spawn_blocking(move || {
+            let state = app.state::<ShellState>();
+            let engine = state
+                .engine
+                .clone()
+                .ok_or_else(|| "no engine configured".to_string())?;
+            if let Some(m) = &snapshot_method {
+                engine
+                    .check_method(m)
+                    .map_err(|e| format!("{}: {}", e.code, e.message))?;
+            }
+            // Receiver first: nothing published from here on can be missed.
+            let rx = engine.subscribe_stream();
+            let coalesce = engine.stream_coalescer();
+            std::thread::Builder::new()
+                .name("rk-shell-engine-stream".into())
+                .spawn(move || {
+                    crate::engine_stream::run_forwarder(rx, coalesce, |v| on_event.send(v).is_ok())
+                })
+                .map_err(|e| format!("spawn engine stream: {e}"))?;
+            let snapshot = match snapshot_method {
+                Some(m) => {
+                    let handle = app.clone();
+                    engine
+                        .snapshot_tagged(
+                            &m,
+                            params.unwrap_or(Value::Null),
+                            tag,
+                            std::sync::Arc::new(move |event| {
+                                use tauri::Emitter;
+                                let _ = handle.emit(crate::EVENT_ENGINE, event);
+                            }),
+                        )
+                        .map_err(|e| format!("{}: {}", e.code, e.message))?
+                }
+                None => Value::Null,
+            };
+            Ok(json!({"snapshot": snapshot, "lifecycle": engine.lifecycle()}))
+        })
+        .await
+        .map_err(|e| e.to_string())?
+    }
+    #[cfg(not(feature = "engine"))]
+    {
+        let _ = (on_event, snapshot_method, params, tag, app);
+        Err("engine feature disabled".into())
+    }
+}

@@ -0,0 +1,145 @@
+//! Open a page of the operating system's Settings app by URI (Orthic-Labs/rightkit#386, part B).
+//!
+//! Donor: ViewRight `commands/mac_associations/windows.rs` `open_default_apps`
+//! (`explorer.exe ms-settings:defaultapps`). Only `ms-settings:` URIs with a conservative charset
+//! open: the target is passed as one argv element (never through a shell), and the allowlist keeps
+//! it from being anything but a Settings page. A different launcher than [`crate::opener`], which
+//! deliberately refuses every scheme except http(s) and mailto.
+
+use crate::opener::ExternalOpener;
+use crate::ShellError;
+
+/// Windows Settings, Default apps.
+pub const DEFAULT_APPS: &str = "ms-settings:defaultapps";
+
+/// `Ok(uri)` for `ms-settings:<page>[:<subpage>...]` with ASCII letters, digits, `-`, `_`, `.` and
+/// `:` only (case-insensitive scheme). Anything else, including a query string, is refused.
+pub fn validate_settings_uri(uri: &str) -> Result<&str, ShellError> {
+    let uri = uri.trim();
+    let page = uri
+        .get(..12)
+        .filter(|scheme| scheme.eq_ignore_ascii_case("ms-settings:"))
+        .map(|_| &uri[12..])
+        .ok_or_else(|| ShellError::Invalid(format!("{uri:?} is not an ms-settings: URI")))?;
+    let ok = !page.is_empty()
+        && !page.starts_with(':')
+        && !page.ends_with(':')
+        && !page.contains("::")
+        && page
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.' | b':'));
+    if ok {
+        Ok(uri)
+    } else {
+        Err(ShellError::Invalid(format!(
+            "{uri:?} is not a plain ms-settings: page"
+        )))
+    }
+}
+
+/// Validate `uri` and hand it to `opener` (the seam tests and other launchers use).
+pub fn open_settings_uri_with(opener: &dyn ExternalOpener, uri: &str) -> Result<(), ShellError> {
+    let uri = validate_settings_uri(uri)?;
+    opener.open(uri).map_err(ShellError::Other)
+}
+
+/// Open a Settings page on Windows with `explorer.exe`. `ShellError::Unsupported` elsewhere.
+pub fn open_settings_uri(uri: &str) -> Result<(), ShellError> {
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        use std::process::{Command, Stdio};
+
+        let uri = validate_settings_uri(uri)?;
+        let mut child = Command::new("explorer.exe");
+        child
+            .arg(uri)
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            // CREATE_NO_WINDOW: never flash a console.
+            .creation_flags(0x0800_0000);
+        child
+            .spawn()
+            .map(|mut child| {
+                // explorer.exe's exit code is not a success signal; reap without blocking.
+                std::thread::spawn(move || {
+                    let _ = child.wait();
+                });
+            })
+            .map_err(|e| ShellError::Other(format!("could not open {uri}: {e}")))
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = uri;
+        Err(ShellError::Unsupported(
+            "Settings URIs open on Windows only".into(),
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex;
+
+    #[derive(Default)]
+    struct Recorder(Mutex<Vec<String>>);
+
+    impl ExternalOpener for Recorder {
+        fn open(&self, target: &str) -> Result<(), String> {
+            self.0.lock().unwrap().push(target.to_owned());
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn only_plain_settings_pages_validate() {
+        for ok in [
+            DEFAULT_APPS,
+            "ms-settings:network-wifi",
+            "MS-SETTINGS:privacy-microphone",
+            "ms-settings:notifications:quiethours",
+            "  ms-settings:defaultapps  ",
+        ] {
+            assert!(validate_settings_uri(ok).is_ok(), "{ok:?}");
+        }
+        for bad in [
+            "",
+            "ms-settings:",
+            "ms-settings:?x=1",
+            "ms-settings:a b",
+            "ms-settings:a&calc",
+            "ms-settings:a\"b",
+            "ms-settings:a/../b",
+            "ms-settings::a",
+            "ms-settings:a:",
+            "ms-settings:a::b",
+            "ms-settings",
+            "https://example.com",
+            "file:///C:/Windows/System32/calc.exe",
+            "calc.exe",
+            "ms-settingsx:defaultapps",
+            "ms-settin\u{e9}:a",
+        ] {
+            assert!(validate_settings_uri(bad).is_err(), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn the_opener_receives_only_validated_uris() {
+        let recorder = Recorder::default();
+        open_settings_uri_with(&recorder, " ms-settings:defaultapps ").unwrap();
+        assert!(open_settings_uri_with(&recorder, "https://example.com").is_err());
+        assert_eq!(*recorder.0.lock().unwrap(), vec![DEFAULT_APPS.to_owned()]);
+    }
+
+    #[cfg(not(windows))]
+    #[test]
+    fn off_windows_the_default_launcher_is_unsupported() {
+        assert!(matches!(
+            open_settings_uri(DEFAULT_APPS),
+            Err(ShellError::Unsupported(_))
+        ));
+    }
+}

+  const seen = [];
+  const off = await shell.drop.on((e) => seen.push(e.phase));
+  host.emit(EVENTS.drop, { phase: 'enter', label: 'main', x: 1, y: 2 });
+  host.emit(EVENTS.drop, { phase: 'drop', label: 'main', x: 1, y: 2, paths: ['/a.png'], rejected: [] });

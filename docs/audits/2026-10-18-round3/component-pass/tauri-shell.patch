new file mode 100644
index 0000000..4decd36
--- /dev/null
+++ b/crates/rightkit-tauri-shell/src/host.rs
@@ -0,0 +1,998 @@
+//! In-process host handlers for the `@rightkit/settings-ui` shell-adapter contract
+//! (Orthic-Labs/rightkit#672): `rightkit.settings.get|patch`, `rightkit.models.list|install|cancel|remove`
+//! and `rightkit.secrets.presence|set|clear`, plus the `rightkit.settings.changed` and
+//! `rightkit.models.entry` events.
+//!
+//! `createShellBackends(shell)` in `@rightkit/settings-ui/shell-adapter` reaches these as engine
+//! calls (`shell.engine.call`, event `rightkit-shell://engine`). With a [`HostHandlers`] registered
+//! through [`crate::ShellBuilder::host_handlers`] the shell answers those methods itself, in the
+//! app's process, before any engine sidecar is consulted, so an app with no sidecar (or one that does
+//! not implement them) gets working preferences, local models and credential management.
+//!
+//! Each group is a trait the app (or a ready adapter) implements:
+//!
+//! * [`SettingsHost`]: a revisioned key/value document. `AppSettingsHost` (feature
+//!   `host-app-settings`) is the adapter over `rightkit-app-settings`.
+//! * [`ModelsHost`]: the app's local-model catalog and installer. The catalog is app-specific, so
+//!   there is no ready adapter; the trait carries the wire shape ([`ModelEntry`]).
+//! * [`SecretsHost`]: presence, set and clear of credential-store entries; values never come back.
+//!   `CredentialsHost` (feature `host-credentials`) is the adapter over `rightkit-credentials`,
+//!   including the `clear` (delete) the engine path could not do.
+//!
+//! A group the app did not register is not answered here: [`HostHandlers::handles`] is false for its
+//! methods and the call goes on to the engine (or fails as before). Errors reach the page as
+//! `"<code>: <message>"` strings on the legacy engine call and as `{code, message, origin: "host"}`
+//! on the tagged one; the JS bridge turns the string form into `{code, message}` for these methods,
+//! so `useSettings` sees `code === "revision_conflict"`.
+//!
+//! Wire shapes are plain Rust ([`parse_patch_params`], [`parse_secret_refs`], ...) and unit-tested
+//! without Tauri.
+
+use std::any::Any;
+use std::sync::{Arc, Mutex};
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Map, Value};
+
+pub const SETTINGS_GET: &str = "rightkit.settings.get";
+pub const SETTINGS_PATCH: &str = "rightkit.settings.patch";
+pub const MODELS_LIST: &str = "rightkit.models.list";
+pub const MODELS_INSTALL: &str = "rightkit.models.install";
+pub const MODELS_CANCEL: &str = "rightkit.models.cancel";
+pub const MODELS_REMOVE: &str = "rightkit.models.remove";
+pub const SECRETS_PRESENCE: &str = "rightkit.secrets.presence";
+pub const SECRETS_SET: &str = "rightkit.secrets.set";
+pub const SECRETS_CLEAR: &str = "rightkit.secrets.clear";
+
+/// Event call name for "these top-level settings keys changed".
+pub const EVENT_SETTINGS_CHANGED: &str = "rightkit.settings.changed";
+/// Event call name for one model entry update (progress, completion, error).
+pub const EVENT_MODELS_ENTRY: &str = "rightkit.models.entry";
+
+/// Error code of a stale `expectedRevision`.
+pub const CODE_REVISION_CONFLICT: &str = "revision_conflict";
+
+/// Longest service or account the dispatcher accepts, in bytes (the credential stores' limit).
+const MAX_SECRET_FIELD: usize = 250;
+/// Longest secret value accepted, in bytes.
+const MAX_SECRET_VALUE: usize = 64 * 1024;
+
+/// An error with the stable code the page switches on.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HostError {
+    pub code: String,
+    pub message: String,
+}
+
+impl HostError {
+    pub fn new(code: impl Into<String>, message: impl Into<String>) -> Self {
+        Self {
+            code: code.into(),
+            message: message.into(),
+        }
+    }
+    pub fn invalid(message: impl Into<String>) -> Self {
+        Self::new("invalid", message)
+    }
+    pub fn internal(message: impl Into<String>) -> Self {
+        Self::new("internal", message)
+    }
+    pub fn unsupported(message: impl Into<String>) -> Self {
+        Self::new("unsupported", message)
+    }
+    /// A stale `expectedRevision` (`settings-ui` retries on this code).
+    pub fn conflict(expected: u64, actual: u64) -> Self {
+        Self::new(
+            CODE_REVISION_CONFLICT,
+            format!("settings changed since revision {expected}; now at revision {actual}"),
+        )
+    }
+    /// The tagged-call error shape.
+    pub fn to_json(&self) -> Value {
+        json!({"code": self.code, "message": self.message, "origin": "host"})
+    }
+}
+
+impl std::fmt::Display for HostError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{}: {}", self.code, self.message)
+    }
+}
+
+impl std::error::Error for HostError {}
+
+impl From<HostError> for String {
+    fn from(e: HostError) -> String {
+        e.to_string()
+    }
+}
+
+/// Where events go: `(call name, event payload)`. The shell emits them as `rightkit-shell://engine`
+/// `{call, event}`.
+pub type EventSink = Arc<dyn Fn(&str, Value) + Send + Sync>;
+
+// ---------------------------------------------------------------------------------------------
+// Settings
+// ---------------------------------------------------------------------------------------------
+
+/// The settings document and its revision (`SettingsSnapshot` in settings-ui).
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct SettingsSnapshot {
+    pub values: Map<String, Value>,
+    pub revision: u64,
+}
+
+/// A committed patch: the new snapshot, and the top-level keys it changed (emitted as
+/// `rightkit.settings.changed` when not empty). An adapter whose store already emits its own change
+/// events returns an empty `changed`.
+#[derive(Debug, Clone, PartialEq)]
+pub struct PatchOutcome {
+    pub snapshot: SettingsSnapshot,
+    pub changed: Vec<String>,
+}
+
+/// Callback an adapter calls with the top-level keys that changed from any source.
+pub type ChangedFn = Arc<dyn Fn(Vec<String>) + Send + Sync>;
+
+/// A revisioned top-level key/value document.
+pub trait SettingsHost: Send + Sync {
+    fn load(&self) -> Result<SettingsSnapshot, HostError>;
+    /// Merge top-level keys (`null` removes one). With `expected_revision`, fail with
+    /// [`HostError::conflict`] unless the committed revision still equals it, writing nothing.
+    fn patch(
+        &self,
+        patch: Map<String, Value>,
+        expected_revision: Option<u64>,
+    ) -> Result<PatchOutcome, HostError>;
+    /// Called once when the shell starts. Call `changed` for every change from any window or
+    /// process; keep the returned guard alive (it is dropped with the handlers). Default: none.
+    fn watch(&self, changed: ChangedFn) -> Option<Box<dyn Any + Send + Sync>> {
+        let _ = changed;
+        None
+    }
+}
+
+/// Parse `{patch, expectedRevision}`. `patch` must be an object; `expectedRevision` may be absent
+/// or null (no compare-and-set) or a non-negative integer.
+pub fn parse_patch_params(params: &Value) -> Result<(Map<String, Value>, Option<u64>), HostError> {
+    let obj = params
+        .as_object()
+        .ok_or_else(|| HostError::invalid("settings.patch needs {patch, expectedRevision?}"))?;
+    let patch = obj
+        .get("patch")
+        .and_then(Value::as_object)
+        .cloned()
+        .ok_or_else(|| HostError::invalid("settings.patch: `patch` must be an object"))?;
+    if patch.keys().any(|k| k.is_empty()) {
+        return Err(HostError::invalid("settings.patch: empty key"));
+    }
+    let expected = match obj.get("expectedRevision") {
+        None | Some(Value::Null) => None,
+        Some(v) => Some(v.as_u64().ok_or_else(|| {
+            HostError::invalid("settings.patch: `expectedRevision` must be a non-negative integer")
+        })?),
+    };
+    Ok((patch, expected))
+}
+
+// ---------------------------------------------------------------------------------------------
+// Models
+// ---------------------------------------------------------------------------------------------
+
+/// One model row (`ModelEntry` in settings-ui). Optional fields are omitted when `None`.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ModelEntry {
+    pub id: String,
+    pub label: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub description: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub size_bytes: Option<u64>,
+    /// `missing | installed | downloading | verifying | error`.
+    pub state: String,
+    /// 0..1 while downloading or verifying.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub progress: Option<f64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub revision: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub active: Option<bool>,
+    /// `{kind, reasons?}` hardware fit.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub fit: Option<Value>,
+    /// `{code, message}`.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub error: Option<Value>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub removable: Option<bool>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub shared: Option<bool>,
+}
+
+/// Pushes an updated row to the page as `rightkit.models.entry`.
+pub type ModelPush = Arc<dyn Fn(ModelEntry) + Send + Sync>;
+
+/// The app's local-model catalog and installer. Calls run on a blocking thread; `install` may block
+/// until the install ends, pushing progress rows through `push`. `cancel` is called from another
+/// thread while `install` runs.
+pub trait ModelsHost: Send + Sync {
+    fn list(&self) -> Result<Vec<ModelEntry>, HostError>;
+    fn install(&self, id: &str, push: ModelPush) -> Result<(), HostError>;
+    /// Cancel keeps partial files so the next install resumes.
+    fn cancel(&self, id: &str) -> Result<(), HostError>;
+    fn remove(&self, id: &str) -> Result<(), HostError>;
+}
+
+/// Parse `{id}` to a non-empty model id of at most 200 bytes with no control characters.
+pub fn parse_model_id(params: &Value) -> Result<String, HostError> {
+    let id = params
+        .get("id")
+        .and_then(Value::as_str)
+        .ok_or_else(|| HostError::invalid("models call needs {id}"))?;
+    if id.is_empty() || id.len() > 200 || id.chars().any(char::is_control) {
+        return Err(HostError::invalid("invalid model id"));
+    }
+    Ok(id.to_owned())
+}
+
+// ---------------------------------------------------------------------------------------------
+// Secrets
+// ---------------------------------------------------------------------------------------------
+
+/// Pointer to a credential-store entry (`SecretRef` in settings-ui).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SecretRef {
+    pub service: String,
+    pub account: String,
+}
+
+/// Whether a credential exists, read passively (never the value).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Presence {
+    Present,
+    Absent,
+    /// The store could not be asked (locked, unavailable, or another service's namespace).
+    Unknown,
+}
+
+/// Credential-store management. Values go in, never come back.
+pub trait SecretsHost: Send + Sync {
+    /// One answer per ref, in order.
+    fn presence(&self, refs: &[SecretRef]) -> Vec<Presence>;
+    fn set(&self, secret: &SecretRef, value: &str) -> Result<(), HostError>;
+    /// Remove the entry; an entry that is already absent is success.
+    fn clear(&self, secret: &SecretRef) -> Result<(), HostError>;
+}
+
+/// Check one service or account: non-empty, at most 250 bytes, no control characters.
+pub fn check_secret_field(what: &str, value: &str) -> Result<(), HostError> {
+    if value.is_empty() {
+        return Err(HostError::invalid(format!("secret {what} is empty")));
+    }
+    if value.len() > MAX_SECRET_FIELD {
+        return Err(HostError::invalid(format!(
+            "secret {what} is longer than {MAX_SECRET_FIELD} bytes"
+        )));
+    }
+    if value.chars().any(char::is_control) {
+        return Err(HostError::invalid(format!(
+            "secret {what} contains a control character"
+        )));
+    }
+    Ok(())
+}
+
+fn parse_secret_ref(v: &Value) -> Result<SecretRef, HostError> {
+    let r: SecretRef = serde_json::from_value(v.clone())
+        .map_err(|_| HostError::invalid("a secret ref needs {service, account}"))?;
+    check_secret_field("service", &r.service)?;
+    check_secret_field("account", &r.account)?;
+    Ok(r)
+}
+
+/// Parse `{refs: [{service, account}]}` (at most 256 refs).
+pub fn parse_secret_refs(params: &Value) -> Result<Vec<SecretRef>, HostError> {
+    let refs = params
+        .get("refs")
+        .and_then(Value::as_array)
+        .ok_or_else(|| HostError::invalid("secrets.presence needs {refs: []}"))?;
+    if refs.len() > 256 {
+        return Err(HostError::invalid("secrets.presence takes at most 256 refs"));
+    }
+    refs.iter().map(parse_secret_ref).collect()
+}
+
+/// Parse `{ref}` for `clear`.
+pub fn parse_secret_one(params: &Value) -> Result<SecretRef, HostError> {
+    parse_secret_ref(
+        params
+            .get("ref")
+            .ok_or_else(|| HostError::invalid("secrets call needs {ref}"))?,
+    )
+}
+
+/// Parse `{ref, value}` for `set`; the value must be non-empty text of at most 64 KiB.
+pub fn parse_secret_set(params: &Value) -> Result<(SecretRef, String), HostError> {
+    let r = parse_secret_one(params)?;
+    let value = params
+        .get("value")
+        .and_then(Value::as_str)
+        .ok_or_else(|| HostError::invalid("secrets.set needs {value}"))?;
+    if value.is_empty() {
+        return Err(HostError::invalid(
+            "secrets.set: empty value (use secrets.clear to remove)",
+        ));
+    }
+    if value.len() > MAX_SECRET_VALUE {
+        return Err(HostError::invalid("secrets.set: value is too large"));
+    }
+    Ok((r, value.to_owned()))
+}
+
+// ---------------------------------------------------------------------------------------------
+// Dispatcher
+// ---------------------------------------------------------------------------------------------
+
+/// The registered groups. Build with [`HostHandlers::new`] and the group setters.
+#[derive(Default)]
+pub struct HostHandlers {
+    settings: Option<Arc<dyn SettingsHost>>,
+    models: Option<Arc<dyn ModelsHost>>,
+    secrets: Option<Arc<dyn SecretsHost>>,
+    guards: Mutex<Vec<Box<dyn Any + Send + Sync>>>,
+}
+
+/// Which group a method name belongs to.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Group {
+    Settings,
+    Models,
+    Secrets,
+}
+
+fn group_of(method: &str) -> Option<Group> {
+    match method {
+        SETTINGS_GET | SETTINGS_PATCH => Some(Group::Settings),
+        MODELS_LIST | MODELS_INSTALL | MODELS_CANCEL | MODELS_REMOVE => Some(Group::Models),
+        SECRETS_PRESENCE | SECRETS_SET | SECRETS_CLEAR => Some(Group::Secrets),
+        _ => None,
+    }
+}
+
+/// Whether `method` is one of the nine contract methods, registered or not.
+pub fn is_host_method(method: &str) -> bool {
+    group_of(method).is_some()
+}
+
+impl HostHandlers {
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn settings(mut self, host: impl SettingsHost + 'static) -> Self {
+        self.settings = Some(Arc::new(host));
+        self
+    }
+    pub fn models(mut self, host: impl ModelsHost + 'static) -> Self {
+        self.models = Some(Arc::new(host));
+        self
+    }
+    pub fn secrets(mut self, host: impl SecretsHost + 'static) -> Self {
+        self.secrets = Some(Arc::new(host));
+        self
+    }
+
+    /// Whether this set answers `method`: a contract method whose group is registered.
+    pub fn handles(&self, method: &str) -> bool {
+        match group_of(method) {
+            Some(Group::Settings) => self.settings.is_some(),
+            Some(Group::Models) => self.models.is_some(),
+            Some(Group::Secrets) => self.secrets.is_some(),
+            None => false,
+        }
+    }
+
+    /// Start the watchers (settings changes from other windows or processes). Called once by the
+    /// shell at startup; events go to `sink`.
+    pub fn start(&self, sink: EventSink) {
+        if let Some(settings) = &self.settings {
+            let changed: ChangedFn = Arc::new(move |keys: Vec<String>| {
+                if !keys.is_empty() {
+                    sink(EVENT_SETTINGS_CHANGED, json!({ "keys": keys }));
+                }
+            });
+            if let Some(guard) = settings.watch(changed) {
+                self.guards
+                    .lock()
+                    .unwrap_or_else(|e| e.into_inner())
+                    .push(guard);
+            }
+        }
+    }
+
+    /// Answer one call. `sink` receives the events the call produces (changed keys, model rows).
+    pub fn call(&self, method: &str, params: Value, sink: &EventSink) -> Result<Value, HostError> {
+        let unavailable = || HostError::unsupported(format!("{method} is not registered"));
+        match method {
+            SETTINGS_GET => {
+                let s = self.settings.as_ref().ok_or_else(unavailable)?;
+                to_json(&s.load()?)
+            }
+            SETTINGS_PATCH => {
+                let s = self.settings.as_ref().ok_or_else(unavailable)?;
+                let (patch, expected) = parse_patch_params(&params)?;
+                let out = s.patch(patch, expected)?;
+                if !out.changed.is_empty() {
+                    sink(EVENT_SETTINGS_CHANGED, json!({ "keys": out.changed }));
+                }
+                to_json(&out.snapshot)
+            }
+            MODELS_LIST => {
+                let m = self.models.as_ref().ok_or_else(unavailable)?;
+                to_json(&m.list()?)
+            }
+            MODELS_INSTALL => {
+                let m = self.models.as_ref().ok_or_else(unavailable)?;
+                let id = parse_model_id(&params)?;
+                let push_sink = Arc::clone(sink);
+                let push: ModelPush = Arc::new(move |entry: ModelEntry| {
+                    if let Ok(v) = serde_json::to_value(&entry) {
+                        push_sink(EVENT_MODELS_ENTRY, v);
+                    }
+                });
+                m.install(&id, push)?;
+                Ok(Value::Null)
+            }
+            MODELS_CANCEL => {
+                let m = self.models.as_ref().ok_or_else(unavailable)?;
+                m.cancel(&parse_model_id(&params)?)?;
+                Ok(Value::Null)
+            }
+            MODELS_REMOVE => {
+                let m = self.models.as_ref().ok_or_else(unavailable)?;
+                m.remove(&parse_model_id(&params)?)?;
+                Ok(Value::Null)
+            }
+            SECRETS_PRESENCE => {
+                let s = self.secrets.as_ref().ok_or_else(unavailable)?;
+                let refs = parse_secret_refs(&params)?;
+                let mut answers = s.presence(&refs);
+                // One answer per ref even from a careless adapter.
+                answers.resize(refs.len(), Presence::Unknown);
+                to_json(&answers)
+            }
+            SECRETS_SET => {
+                let s = self.secrets.as_ref().ok_or_else(unavailable)?;
+                let (r, value) = parse_secret_set(&params)?;
+                s.set(&r, &value)?;
+                Ok(Value::Null)
+            }
+            SECRETS_CLEAR => {
+                let s = self.secrets.as_ref().ok_or_else(unavailable)?;
+                s.clear(&parse_secret_one(&params)?)?;
+                Ok(Value::Null)
+            }
+            _ => Err(unavailable()),
+        }
+    }
+}
+
+#[cfg(feature = "tauri")]
+/// An [`EventSink`] that emits `rightkit-shell://engine` `{call, event}` to every window, the frame
+/// shape `createShellBackends` listens for.
+pub fn app_sink(app: &tauri::AppHandle<tauri::Wry>) -> EventSink {
+    use tauri::Emitter;
+    let app = app.clone();
+    Arc::new(move |call: &str, event: Value| {
+        let _ = app.emit(crate::EVENT_ENGINE, json!({"call": call, "event": event}));
+    })
+}
+
+fn to_json<T: Serialize>(v: &T) -> Result<Value, HostError> {
+    serde_json::to_value(v).map_err(|e| HostError::internal(e.to_string()))
+}
+
+// ---------------------------------------------------------------------------------------------
+// Adapters
+// ---------------------------------------------------------------------------------------------
+
+/// [`SettingsHost`] over a `rightkit-app-settings` [`Store`](rightkit_app_settings::Store) of an
+/// open key/value document. Change events come from the store's own subscription (any commit by any
+/// store of the same file in this process; call `Store::poll_external` periodically to see another
+/// process).
+#[cfg(feature = "host-app-settings")]
+pub struct AppSettingsHost {
+    store: Arc<rightkit_app_settings::Store<Map<String, Value>>>,
+}
+
+#[cfg(feature = "host-app-settings")]
+impl AppSettingsHost {
+    pub fn new(store: Arc<rightkit_app_settings::Store<Map<String, Value>>>) -> Self {
+        Self { store }
+    }
+}
+
+/// Merge `patch` into `doc` the way the contract says: `null` removes a key.
+pub fn merge_patch(doc: &mut Map<String, Value>, patch: &Map<String, Value>) {
+    for (k, v) in patch {
+        if v.is_null() {
+            doc.remove(k);
+        } else {
+            doc.insert(k.clone(), v.clone());
+        }
+    }
+}
+
+/// Top-level keys of `patch` whose value differs between `before` and `after`.
+pub fn changed_keys(
+    before: &Map<String, Value>,
+    after: &Map<String, Value>,
+    patch: &Map<String, Value>,
+) -> Vec<String> {
+    patch
+        .keys()
+        .filter(|k| before.get(*k) != after.get(*k))
+        .cloned()
+        .collect()
+}
+
+#[cfg(feature = "host-app-settings")]
+impl SettingsHost for AppSettingsHost {
+    fn load(&self) -> Result<SettingsSnapshot, HostError> {
+        let revision = self.store.revision();
+        Ok(SettingsSnapshot {
+            values: self.store.get(),
+            revision,
+        })
+    }
+
+    fn patch(
+        &self,
+        patch: Map<String, Value>,
+        expected_revision: Option<u64>,
+    ) -> Result<PatchOutcome, HostError> {
+        use rightkit_app_settings::Error;
+        let apply = |doc: &mut Map<String, Value>| -> Result<(), Error> {
+            merge_patch(doc, &patch);
+            Ok(())
+        };
+        let result = match expected_revision {
+            Some(expected) => self.store.update_at(expected, apply),
+            None => self.store.update(apply),
+        };
+        match result {
+            Ok(()) => Ok(PatchOutcome {
+                snapshot: self.load()?,
+                // The store's subscription emits the change event.
+                changed: Vec::new(),
+            }),
+            Err(Error::Conflict { expected, actual }) => Err(HostError::conflict(expected, actual)),
+            Err(Error::Invalid(m)) => Err(HostError::invalid(m)),
+            Err(e) => Err(HostError::new("settings_error", e.to_string())),
+        }
+    }
+
+    fn watch(&self, changed: ChangedFn) -> Option<Box<dyn Any + Send + Sync>> {
+        let subscription = self.store.subscribe(move |change| changed(change.keys.clone()));
+        Some(Box::new(subscription))
+    }
+}
+
+/// [`SecretsHost`] over one `rightkit-credentials` [`Store`](rightkit_credentials::Store). A ref
+/// whose `service` is not the store's namespace service is answered `unknown` (presence) or refused
+/// (set, clear): the adapter never reaches another app's namespace.
+#[cfg(feature = "host-credentials")]
+pub struct CredentialsHost {
+    store: rightkit_credentials::Store,
+}
+
+#[cfg(feature = "host-credentials")]
+impl CredentialsHost {
+    pub fn new(store: rightkit_credentials::Store) -> Self {
+        Self { store }
+    }
+
+    fn in_namespace(&self, r: &SecretRef) -> bool {
+        r.service == self.store.namespace().service()
+    }
+
+    fn check(&self, r: &SecretRef) -> Result<(), HostError> {
+        if self.in_namespace(r) {
+            Ok(())
+        } else {
+            Err(HostError::invalid(format!(
+                "secret service {:?} is not this app's credential namespace",
+                r.service
+            )))
+        }
+    }
+}
+
+#[cfg(feature = "host-credentials")]
+impl SecretsHost for CredentialsHost {
+    fn presence(&self, refs: &[SecretRef]) -> Vec<Presence> {
+        refs.iter()
+            .map(|r| {
+                if !self.in_namespace(r) {
+                    return Presence::Unknown;
+                }
+                match self.store.exists(&r.account) {
+                    Ok(true) => Presence::Present,
+                    Ok(false) => Presence::Absent,
+                    Err(_) => Presence::Unknown,
+                }
+            })
+            .collect()
+    }
+
+    fn set(&self, secret: &SecretRef, value: &str) -> Result<(), HostError> {
+        self.check(secret)?;
+        self.store
+            .set_str(&secret.account, value)
+            .map_err(|e| HostError::new("credential_store", e.to_string()))
+    }
+
+    fn clear(&self, secret: &SecretRef) -> Result<(), HostError> {
+        self.check(secret)?;
+        self.store
+            .delete(&secret.account)
+            .map(|_| ())
+            .map_err(|e| HostError::new("credential_store", e.to_string()))
+    }
+}

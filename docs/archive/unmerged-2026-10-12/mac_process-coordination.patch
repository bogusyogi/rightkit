diff --git a/crates/rightkit-process/tests/adopted_identity.rs b/crates/rightkit-process/tests/adopted_identity.rs
new file mode 100644
index 00000000..addd0976
--- /dev/null
+++ b/crates/rightkit-process/tests/adopted_identity.rs
@@ -0,0 +1,324 @@
+#![cfg(all(unix, any(target_os = "linux", target_os = "macos")))]
+
+//! Identity-checked adoption and bounded termination, against real processes: a `/bin/sleep`, a
+//! shell that leads its own process group and starts sleepers in it, and a shell that ignores
+//! `SIGTERM`.
+
+use rightkit_process::{
+    AdoptError, AdoptedProcess, ProcessIdentity, StartTime, StopOptions, StopOutcome, StopScope,
+};
+use std::{
+    io::{BufRead, BufReader, Read},
+    os::unix::process::{CommandExt, ExitStatusExt},
+    path::PathBuf,
+    process::{Child, Command, Stdio},
+    thread,
+    time::{Duration, Instant},
+};
+
+const SIGTERM: i32 = 15;
+const SIGKILL: i32 = 9;
+
+/// Kills and reaps its child when dropped, so a failing assertion leaves nothing behind.
+struct Guard(Option<Child>);
+
+impl Guard {
+    fn id(&self) -> u32 {
+        self.0.as_ref().expect("child").id()
+    }
+
+    fn child(&mut self) -> &mut Child {
+        self.0.as_mut().expect("child")
+    }
+
+    fn finish(mut self) -> std::process::ExitStatus {
+        let mut child = self.0.take().expect("child");
+        child.wait().expect("reap")
+    }
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        if let Some(mut child) = self.0.take() {
+            let _ = child.kill();
+            let _ = child.wait();
+        }
+    }
+}
+
+fn sleeper() -> Guard {
+    Guard(Some(
+        Command::new("/bin/sleep")
+            .arg("120")
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .expect("spawn sleep"),
+    ))
+}
+
+/// A shell that leads its own process group (`process_group(0)`), runs `script`, and has printed
+/// the pid of the process it started (`$!`) on its first output line.
+fn group_leader(script: &str) -> (Guard, u32, BufReader<std::process::ChildStdout>) {
+    let mut child = Command::new("/bin/sh")
+        .args(["-c", script])
+        .process_group(0)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .expect("spawn sh");
+    let mut out = BufReader::new(child.stdout.take().expect("stdout"));
+    let mut line = String::new();
+    out.read_line(&mut line).expect("read the member's pid");
+    let member = line.trim().parse::<u32>().expect("a pid");
+    (Guard(Some(child)), member, out)
+}
+
+fn another_start() -> StartTime {
+    #[cfg(target_os = "macos")]
+    {
+        "macos:1.000000".parse().expect("start time")
+    }
+    #[cfg(target_os = "linux")]
+    {
+        "linux:00000000000000000000000000000000:1"
+            .parse()
+            .expect("start time")
+    }
+}
+
+/// The process is not running: gone, or exited and awaiting its parent's reap.
+fn assert_not_running(identity: &ProcessIdentity) {
+    match identity.check() {
+        Err(AdoptError::Gone) | Ok(false) => {}
+        other => panic!("pid {} should not be running: {other:?}", identity.pid),
+    }
+}
+
+fn assert_running(identity: &ProcessIdentity) {
+    assert_eq!(identity.check(), Ok(true), "pid {}", identity.pid);
+}
+
+#[test]
+fn an_identity_round_trips_through_its_stored_form() {
+    let child = sleeper();
+    let identity = ProcessIdentity::of_pid(child.id()).expect("identity");
+    assert!(identity.executable.is_some(), "a running program is named");
+    let text = identity.to_string();
+    assert_eq!(text.parse::<ProcessIdentity>(), Ok(identity.clone()));
+    assert_running(&identity);
+}
+
+#[test]
+fn the_recorded_process_is_adopted() {
+    let child = sleeper();
+    let identity = ProcessIdentity::of_pid(child.id()).expect("identity");
+    let adopted = AdoptedProcess::adopt_checked(&identity).expect("adopt");
+    assert_eq!(adopted.id(), child.id());
+    assert_eq!(adopted.verified_start(), Some(identity.started));
+    assert!(adopted.is_running().expect("is_running"));
+}
+
+#[test]
+fn an_identity_of_a_child_is_proven_under_the_child_lock() {
+    use rightkit_process::OwnedCommand;
+    let mut command = OwnedCommand::new("/bin/sleep");
+    command.command_mut().arg("120");
+    let mut child = command.spawn().expect("spawn");
+    let identity = ProcessIdentity::of_child(&child).expect("identity");
+    assert_eq!(identity.pid, child.id());
+    assert_running(&identity);
+    child.terminate_tree().expect("terminate");
+    // Reaped: the child can no longer be described, and its number proves nothing.
+    assert_eq!(
+        ProcessIdentity::of_child(&child)
+            .expect_err("reaped")
+            .kind(),
+        std::io::ErrorKind::NotFound
+    );
+    assert_eq!(identity.check(), Err(AdoptError::Gone));
+}
+
+#[test]
+fn an_exited_process_is_gone() {
+    let mut child = sleeper();
+    let identity = ProcessIdentity::of_pid(child.id()).expect("identity");
+    child.child().kill().expect("kill");
+    child.child().wait().expect("reap");
+    assert_eq!(
+        AdoptedProcess::adopt_checked(&identity).expect_err("gone"),
+        AdoptError::Gone
+    );
+}
+
+#[test]
+fn a_pid_with_another_start_time_is_a_replaced_process() {
+    let child = sleeper();
+    let real = ProcessIdentity::of_pid(child.id()).expect("identity");
+    let stale = ProcessIdentity {
+        started: another_start(),
+        ..real.clone()
+    };
+    match AdoptedProcess::adopt_checked(&stale) {
+        Err(AdoptError::Replaced { found }) => assert_eq!(found, real.started),
+        other => panic!("expected Replaced, got {other:?}"),
+    }
+}
+
+#[test]
+fn the_same_start_time_with_another_program_is_a_mismatch() {
+    let child = sleeper();
+    let mut identity = ProcessIdentity::of_pid(child.id()).expect("identity");
+    let real = identity.executable.clone().expect("program");
+    identity.executable = Some(PathBuf::from("/definitely/not/the/program"));
+    match AdoptedProcess::adopt_checked(&identity) {
+        Err(AdoptError::ExecutableMismatch { expected, found }) => {
+            assert_eq!(expected, PathBuf::from("/definitely/not/the/program"));
+            assert_eq!(found, real);
+        }
+        other => panic!("expected ExecutableMismatch, got {other:?}"),
+    }
+    // Without an executable on record the start time alone decides.
+    identity.executable = None;
+    AdoptedProcess::adopt_checked(&identity).expect("adopt by start time");
+}
+
+#[test]
+fn a_host_or_pid_that_cannot_be_proven_is_never_a_match() {
+    let child = sleeper();
+    let real = ProcessIdentity::of_pid(child.id()).expect("identity");
+    // Recorded on another kind of host.
+    let foreign = ProcessIdentity {
+        started: "windows:133000000000000000".parse().expect("start time"),
+        ..real.clone()
+    };
+    match AdoptedProcess::adopt_checked(&foreign) {
+        Err(error @ AdoptError::Unverifiable { .. }) => assert!(error.is_unsupported()),
+        other => panic!("expected Unverifiable, got {other:?}"),
+    }
+    // Pids 0 and 1 are never adopted, whatever they look like.
+    for pid in [0, 1] {
+        let reserved = ProcessIdentity {
+            pid,
+            ..real.clone()
+        };
+        assert!(matches!(
+            AdoptedProcess::adopt_checked(&reserved),
+            Err(AdoptError::Unverifiable { .. })
+        ));
+    }
+}
+
+#[test]
+fn an_unchecked_adoption_cannot_be_stopped() {
+    let child = sleeper();
+    let adopted = AdoptedProcess::new(child.id().try_into().expect("non-zero"));
+    assert_eq!(adopted.verified_start(), None);
+    let report = adopted.stop_tree(StopOptions::default()).expect("stop");
+    assert_eq!(report.outcome, StopOutcome::NotVerified);
+    assert!(!report.term_sent && !report.kill_sent);
+    assert!(adopted.is_running().expect("is_running"), "untouched");
+}
+
+#[test]
+fn a_process_that_does_not_lead_a_group_is_stopped_alone() {
+    // The sleeper shares this test's process group: signalling the group would stop the test.
+    let child = sleeper();
+    let identity = ProcessIdentity::of_pid(child.id()).expect("identity");
+    let adopted = AdoptedProcess::adopt_checked(&identity).expect("adopt");
+    let report = adopted.stop_tree(StopOptions::default()).expect("stop");
+    assert_eq!(report.scope, StopScope::Process);
+    assert!(report.term_sent && !report.kill_sent);
+    assert_eq!(report.outcome, StopOutcome::Stopped);
+    assert_eq!(child.finish().signal(), Some(SIGTERM));
+}
+
+#[test]
+fn a_process_group_leader_stops_with_everything_in_its_group() {
+    let (leader, member, _out) = group_leader("sleep 120 & echo $!; wait");
+    let bystander = sleeper();
+    let identity = ProcessIdentity::of_pid(leader.id()).expect("identity");
+    let member_identity = ProcessIdentity::of_pid(member).expect("member identity");
+    let bystander_identity = ProcessIdentity::of_pid(bystander.id()).expect("bystander identity");
+    assert_running(&member_identity);
+
+    let adopted = AdoptedProcess::adopt_checked(&identity).expect("adopt");
+    let report = adopted
+        .stop_tree(StopOptions::default().with_grace(Duration::from_secs(10)))
+        .expect("stop");
+    assert_eq!(report.scope, StopScope::Group);
+    assert!(report.term_sent, "{report:?}");
+    assert!(!report.kill_sent, "TERM was enough: {report:?}");
+    assert_eq!(report.outcome, StopOutcome::Stopped);
+
+    assert_not_running(&member_identity);
+    assert_eq!(leader.finish().signal(), Some(SIGTERM));
+    assert_running(&bystander_identity); // another group: never touched
+}
+
+#[test]
+fn a_tree_that_ignores_term_is_killed_after_the_grace() {
+    let (leader, member, _out) = group_leader("trap '' TERM; sleep 120 & echo $!; wait");
+    let identity = ProcessIdentity::of_pid(leader.id()).expect("identity");
+    let member_identity = ProcessIdentity::of_pid(member).expect("member identity");
+    let adopted = AdoptedProcess::adopt_checked(&identity).expect("adopt");
+
+    let started = Instant::now();
+    let grace = Duration::from_millis(400);
+    let report = adopted
+        .stop_tree(StopOptions::default().with_grace(grace))
+        .expect("stop");
+    assert!(started.elapsed() >= grace, "the grace was honoured");
+    assert_eq!(report.scope, StopScope::Group);
+    assert!(report.term_sent && report.kill_sent, "{report:?}");
+    assert_eq!(report.outcome, StopOutcome::Stopped);
+
+    assert_not_running(&member_identity);
+    assert_eq!(leader.finish().signal(), Some(SIGKILL));
+}
+
+#[test]
+fn survivors_of_an_exited_leader_are_still_reached_through_its_group() {
+    // The shell starts a sleeper in its group and exits at once. Reading to the end of its output
+    // waits for that exit; the shell stays an unreaped zombie, which pins the group id.
+    let (leader, member, mut out) = group_leader("sleep 120 >/dev/null 2>&1 & echo $!");
+    let mut rest = String::new();
+    out.read_to_string(&mut rest).expect("read to the end");
+    let identity = ProcessIdentity::of_pid(leader.id()).expect("identity of the zombie");
+    // The end of its output comes a moment before the exit is complete; wait for the zombie.
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while identity.check() == Ok(true) {
+        assert!(
+            Instant::now() < deadline,
+            "the shell never finished exiting"
+        );
+        thread::sleep(Duration::from_millis(5));
+    }
+    let member_identity = ProcessIdentity::of_pid(member).expect("member identity");
+    assert_running(&member_identity);
+
+    let adopted = AdoptedProcess::adopt_checked(&identity).expect("an exited leader is adopted");
+    let report = adopted.stop_tree(StopOptions::default()).expect("stop");
+    assert_eq!(report.scope, StopScope::Group);
+    assert!(report.term_sent, "{report:?}");
+    assert_eq!(report.outcome, StopOutcome::Stopped);
+    assert_not_running(&member_identity);
+    leader.finish();
+}
+
+#[test]
+fn stopping_twice_reports_that_nothing_was_left() {
+    let (leader, _member, _out) = group_leader("sleep 120 & echo $!; wait");
+    let identity = ProcessIdentity::of_pid(leader.id()).expect("identity");
+    let adopted = AdoptedProcess::adopt_checked(&identity).expect("adopt");
+    let first = adopted.stop_tree(StopOptions::default()).expect("stop");
+    assert_eq!(first.outcome, StopOutcome::Stopped);
+    leader.finish(); // reaped: the number is free
+    let second = adopted
+        .stop_tree(StopOptions::default())
+        .expect("stop again");
+    assert_eq!(second.outcome, StopOutcome::NotRunning);
+    assert!(!second.term_sent && !second.kill_sent);
+}
diff --git a/crates/rightkit-process/tests/caller_lease.rs b/crates/rightkit-process/tests/caller_lease.rs
new file mode 100644
index 00000000..5f93cb66
--- /dev/null
+++ b/crates/rightkit-process/tests/caller_lease.rs
@@ -0,0 +1,502 @@
+#![cfg(all(unix, any(target_os = "linux", target_os = "macos")))]
+
+//! The caller lease against real processes: the worker learns of its caller's death from the
+//! kernel (no heartbeat), a new caller can claim the lease inside the grace, and `on_lost` runs
+//! once when the grace ends unclaimed. Every "the caller dies" here is a real `/bin/sleep` that is
+//! really killed.
+
+use rightkit_process::{
+    CallerLease, LeaseClaim, LeaseEnd, LeaseLoss, LeaseOptions, LeaseRecord, LossReason,
+    ProcessIdentity, StartTime,
+};
+use std::{
+    fs,
+    os::unix::fs::DirBuilderExt,
+    path::{Path, PathBuf},
+    process::{Child, Command, Stdio},
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        mpsc::{self, Receiver},
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+/// A fresh owner-only directory, removed when dropped.
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(label: &str) -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let path = std::env::temp_dir().join(format!(
+            "rk-lease-{label}-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::DirBuilder::new()
+            .mode(0o700)
+            .create(&path)
+            .expect("create the scratch directory");
+        Scratch(path)
+    }
+
+    fn lease(&self) -> PathBuf {
+        self.0.join("job.lease.json")
+    }
+
+    fn path(&self) -> &Path {
+        &self.0
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+/// A caller: a real process, killed and reaped when dropped.
+struct Caller(Option<Child>);
+
+impl Caller {
+    fn start() -> Self {
+        Caller(Some(
+            Command::new("/bin/sleep")
+                .arg("120")
+                .stdin(Stdio::null())
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .spawn()
+                .expect("spawn sleep"),
+        ))
+    }
+
+    fn identity(&self) -> ProcessIdentity {
+        ProcessIdentity::of_pid(self.0.as_ref().expect("child").id()).expect("identity")
+    }
+
+    /// Kills the caller (it stays a zombie until reaped, which is still "exited" to the kernel).
+    fn die(&mut self) {
+        self.0.as_mut().expect("child").kill().expect("kill");
+    }
+
+    /// Kills and reaps: afterwards the pid names nothing.
+    fn die_and_vanish(&mut self) {
+        self.die();
+        self.0.as_mut().expect("child").wait().expect("reap");
+    }
+}
+
+impl Drop for Caller {
+    fn drop(&mut self) {
+        if let Some(mut child) = self.0.take() {
+            let _ = child.kill();
+            let _ = child.wait();
+        }
+    }
+}
+
+fn dead_identity() -> ProcessIdentity {
+    let mut caller = Caller::start();
+    let identity = caller.identity();
+    caller.die_and_vanish();
+    identity
+}
+
+fn options(grace: Duration) -> LeaseOptions {
+    LeaseOptions::default().with_grace(grace)
+}
+
+/// Starts a watch whose `on_lost` reports on a channel.
+fn watch(
+    path: &Path,
+    holder: Option<ProcessIdentity>,
+    options: LeaseOptions,
+) -> (CallerLease, Receiver<LeaseLoss>) {
+    let (sender, receiver) = mpsc::channel();
+    let lease = CallerLease::watch(path, holder, options, move |loss| {
+        let _ = sender.send(loss);
+    })
+    .expect("watch");
+    (lease, receiver)
+}
+
+fn another_start() -> StartTime {
+    #[cfg(target_os = "macos")]
+    {
+        "macos:1.000000".parse().expect("start time")
+    }
+    #[cfg(target_os = "linux")]
+    {
+        "linux:00000000000000000000000000000000:1"
+            .parse()
+            .expect("start time")
+    }
+}
+
+const QUIET: Duration = Duration::from_millis(700);
+const PATIENCE: Duration = Duration::from_secs(20);
+
+#[test]
+fn the_worker_loses_the_lease_when_the_caller_dies_and_nobody_claims_it() {
+    let scratch = Scratch::new("lost");
+    let mut caller = Caller::start();
+    let identity = caller.identity();
+    let _claim = LeaseClaim::claim(&scratch.lease(), identity.clone(), "cli").expect("claim");
+    let grace = Duration::from_millis(500);
+    let (lease, lost) = watch(&scratch.lease(), None, options(grace));
+
+    // The caller lives: no heartbeat is needed, and nothing happens.
+    assert!(
+        lost.recv_timeout(QUIET).is_err(),
+        "no loss while the caller lives"
+    );
+    assert!(!lease.is_finished());
+
+    let died = Instant::now();
+    caller.die();
+    let loss = lost.recv_timeout(PATIENCE).expect("on_lost runs");
+    assert!(
+        died.elapsed() >= grace,
+        "on_lost waited out the grace: {:?}",
+        died.elapsed()
+    );
+    assert_eq!(loss.holder, identity);
+    assert_eq!(loss.reason, LossReason::HolderExited);
+    assert_eq!(loss.grace, grace);
+    assert_eq!(lease.wait(), LeaseEnd::Lost(loss));
+    assert!(lost.try_recv().is_err(), "on_lost ran once");
+}
+
+#[test]
+fn a_new_caller_inside_the_grace_keeps_the_worker_running() {
+    let scratch = Scratch::new("reattach");
+    let (mut first, mut second) = (Caller::start(), Caller::start());
+    let _claim = LeaseClaim::claim(&scratch.lease(), first.identity(), "cli").expect("claim");
+    let grace = Duration::from_millis(900);
+    let (lease, lost) = watch(&scratch.lease(), None, options(grace));
+
+    first.die();
+    // The restarted caller claims the lease inside the window.
+    let claim = LeaseClaim::claim(&scratch.lease(), second.identity(), "app").expect("claim");
+    assert!(
+        lost.recv_timeout(grace * 2).is_err(),
+        "the claim ended the grace: nothing is lost while the new caller lives"
+    );
+    assert!(!lease.is_finished());
+
+    // The worker now follows the new caller: when it dies, the grace starts again.
+    let died = Instant::now();
+    second.die();
+    let loss = lost.recv_timeout(PATIENCE).expect("on_lost runs");
+    assert!(died.elapsed() >= grace);
+    assert_eq!(loss.holder, claim.holder().clone());
+    assert_eq!(loss.reason, LossReason::HolderExited);
+    assert_eq!(lease.wait(), LeaseEnd::Lost(loss));
+}
+
+#[test]
+fn a_claim_written_while_the_caller_lives_moves_the_watch() {
+    let scratch = Scratch::new("handover");
+    let (mut first, mut second) = (Caller::start(), Caller::start());
+    let _first_claim = LeaseClaim::claim(&scratch.lease(), first.identity(), "cli").expect("claim");
+    let grace = Duration::from_millis(300);
+    let (lease, lost) = watch(&scratch.lease(), None, options(grace));
+
+    let second_claim =
+        LeaseClaim::claim(&scratch.lease(), second.identity(), "app").expect("claim");
+    // The old caller is no longer the one that matters.
+    first.die_and_vanish();
+    assert!(lost.recv_timeout(grace * 3).is_err());
+    second.die();
+    let loss = lost.recv_timeout(PATIENCE).expect("on_lost runs");
+    assert_eq!(&loss.holder, second_claim.holder());
+    drop(lease);
+}
+
+#[test]
+fn a_claim_naming_a_dead_process_does_not_end_the_grace() {
+    let scratch = Scratch::new("deadclaim");
+    let mut caller = Caller::start();
+    let identity = caller.identity();
+    let _claim = LeaseClaim::claim(&scratch.lease(), identity.clone(), "cli").expect("claim");
+    let grace = Duration::from_millis(600);
+    let (lease, lost) = watch(&scratch.lease(), None, options(grace));
+
+    let died = Instant::now();
+    caller.die();
+    // Someone claims with an identity that is not a live process: it cannot be watched, so it
+    // cannot take over, and it must not restart the grace either.
+    LeaseClaim::claim(&scratch.lease(), dead_identity(), "ghost").expect("claim");
+    let loss = lost.recv_timeout(PATIENCE).expect("on_lost runs");
+    assert!(died.elapsed() >= grace);
+    assert!(
+        died.elapsed() < grace * 10,
+        "the grace was not restarted by the dead claim"
+    );
+    assert_eq!(
+        loss.holder, identity,
+        "the lost caller is the one that died"
+    );
+    drop(lease);
+}
+
+#[test]
+fn releasing_the_lease_ends_the_watch_without_on_lost() {
+    let scratch = Scratch::new("release");
+    let mut caller = Caller::start();
+    let claim = LeaseClaim::claim(&scratch.lease(), caller.identity(), "cli").expect("claim");
+    let (lease, lost) = watch(&scratch.lease(), None, options(Duration::from_millis(200)));
+
+    assert!(claim.release().expect("release"));
+    assert_eq!(lease.wait(), LeaseEnd::Released);
+    assert!(!scratch.lease().exists(), "the lease is gone");
+    caller.die();
+    assert!(
+        lost.recv_timeout(Duration::from_millis(600)).is_err(),
+        "a released lease is not a lost one"
+    );
+}
+
+#[test]
+fn a_release_inside_the_grace_also_ends_the_watch() {
+    let scratch = Scratch::new("grace-release");
+    let mut caller = Caller::start();
+    let claim = LeaseClaim::claim(&scratch.lease(), caller.identity(), "cli").expect("claim");
+    let (lease, lost) = watch(&scratch.lease(), None, options(Duration::from_secs(30)));
+    caller.die();
+    assert!(lost.recv_timeout(Duration::from_millis(300)).is_err());
+    // The same caller process is gone, but its claim can still be withdrawn (a supervisor does).
+    assert!(claim.release().expect("release"));
+    assert_eq!(lease.wait(), LeaseEnd::Released);
+}
+
+#[test]
+fn stopping_or_dropping_the_lease_cancels_the_watch_without_on_lost() {
+    let scratch = Scratch::new("stop");
+    let mut caller = Caller::start();
+    let _claim = LeaseClaim::claim(&scratch.lease(), caller.identity(), "cli").expect("claim");
+    let (lease, lost) = watch(&scratch.lease(), None, options(Duration::from_millis(100)));
+    assert_eq!(lease.stop(), LeaseEnd::Stopped);
+    caller.die();
+    assert!(lost.recv_timeout(Duration::from_millis(500)).is_err());
+
+    let scratch = Scratch::new("drop");
+    let mut caller = Caller::start();
+    let _claim = LeaseClaim::claim(&scratch.lease(), caller.identity(), "cli").expect("claim");
+    let (lease, lost) = watch(&scratch.lease(), None, options(Duration::from_millis(100)));
+    drop(lease);
+    caller.die();
+    assert!(lost.recv_timeout(Duration::from_millis(500)).is_err());
+}
+
+#[test]
+fn a_caller_that_is_already_gone_starts_the_grace_at_once() {
+    let scratch = Scratch::new("gone");
+    let identity = dead_identity();
+    let _claim = LeaseClaim::claim(&scratch.lease(), identity.clone(), "cli").expect("claim");
+    let grace = Duration::from_millis(400);
+    let started = Instant::now();
+    let (lease, lost) = watch(&scratch.lease(), None, options(grace));
+    let loss = lost.recv_timeout(PATIENCE).expect("on_lost runs");
+    assert!(started.elapsed() >= grace);
+    assert_eq!(loss.holder, identity);
+    assert_eq!(loss.reason, LossReason::HolderExited);
+    drop(lease);
+}
+
+#[test]
+fn a_recycled_pid_is_a_lost_caller_not_a_watched_one() {
+    let scratch = Scratch::new("recycled");
+    let caller = Caller::start();
+    // The recorded process is gone and its pid names another process now: same pid, another
+    // start time.
+    let stale = ProcessIdentity {
+        started: another_start(),
+        ..caller.identity()
+    };
+    let _claim = LeaseClaim::claim(&scratch.lease(), stale.clone(), "cli").expect("claim");
+    let (lease, lost) = watch(&scratch.lease(), None, options(Duration::from_millis(300)));
+    let loss = lost.recv_timeout(PATIENCE).expect("on_lost runs");
+    assert_eq!(loss.holder, stale);
+    assert_eq!(loss.reason, LossReason::HolderReplaced);
+    drop(lease);
+    assert!(caller.identity().check().expect("alive"), "never signalled");
+}
+
+#[test]
+fn an_unclaimed_lease_is_not_watched_until_a_caller_claims_it() {
+    let scratch = Scratch::new("unclaimed");
+    let grace = Duration::from_millis(300);
+    let (lease, lost) = watch(&scratch.lease(), None, options(grace));
+    assert!(
+        lost.recv_timeout(grace * 3).is_err(),
+        "nothing to lose before there is a caller"
+    );
+
+    let mut caller = Caller::start();
+    let _claim = LeaseClaim::claim(&scratch.lease(), caller.identity(), "cli").expect("claim");
+    assert!(lost.recv_timeout(grace * 2).is_err());
+    let died = Instant::now();
+    caller.die();
+    lost.recv_timeout(PATIENCE).expect("on_lost runs");
+    assert!(died.elapsed() >= grace);
+    drop(lease);
+}
+
+#[test]
+fn an_explicit_holder_is_watched_without_a_lease_file() {
+    let scratch = Scratch::new("explicit");
+    let mut caller = Caller::start();
+    let identity = caller.identity();
+    // The caller handed its identity over on the command line; no file yet.
+    let (lease, lost) = watch(
+        &scratch.lease(),
+        Some(identity.clone()),
+        options(Duration::from_millis(200)),
+    );
+    assert!(lost.recv_timeout(Duration::from_millis(400)).is_err());
+    caller.die();
+    let loss = lost.recv_timeout(PATIENCE).expect("on_lost runs");
+    assert_eq!(loss.holder, identity);
+    drop(lease);
+}
+
+#[test]
+fn only_one_watcher_listens_on_a_lease() {
+    let scratch = Scratch::new("single");
+    let (first, _lost) = watch(&scratch.lease(), None, options(Duration::from_secs(5)));
+    let error = CallerLease::watch(
+        &scratch.lease(),
+        None,
+        options(Duration::from_secs(5)),
+        |_| {},
+    )
+    .expect_err("a second watcher");
+    assert_eq!(error.kind(), std::io::ErrorKind::AddrInUse);
+    assert_eq!(first.stop(), LeaseEnd::Stopped);
+    // The first watcher is gone and took its doorbell with it.
+    let (second, _lost) = watch(&scratch.lease(), None, options(Duration::from_secs(5)));
+    assert_eq!(second.stop(), LeaseEnd::Stopped);
+}
+
+#[test]
+fn the_heartbeat_fallback_judges_the_caller_by_its_heartbeat_alone() {
+    let scratch = Scratch::new("heartbeat");
+    // The caller is this very process, which stays alive throughout: only the heartbeat decides.
+    let claim = LeaseClaim::claim_current(&scratch.lease(), "hb").expect("claim");
+    let ttl = Duration::from_millis(400);
+    let (lease, lost) = watch(
+        &scratch.lease(),
+        None,
+        LeaseOptions::default()
+            .with_grace(Duration::from_millis(100))
+            .heartbeat_only(ttl),
+    );
+    for _ in 0..10 {
+        thread::sleep(Duration::from_millis(100));
+        assert!(claim.heartbeat().expect("heartbeat"));
+        assert!(
+            lost.try_recv().is_err(),
+            "a fresh heartbeat keeps the lease"
+        );
+    }
+    let stopped_beating = Instant::now();
+    let loss = lost.recv_timeout(PATIENCE).expect("on_lost runs");
+    assert!(
+        stopped_beating.elapsed() >= Duration::from_millis(450),
+        "ttl + grace after the last heartbeat: {:?}",
+        stopped_beating.elapsed()
+    );
+    assert_eq!(loss.reason, LossReason::HeartbeatExpired);
+    assert_eq!(&loss.holder, claim.holder());
+    assert_eq!(lease.wait(), LeaseEnd::Lost(loss));
+}
+
+#[test]
+fn a_heartbeat_resumed_inside_the_grace_revives_the_lease() {
+    let scratch = Scratch::new("revive");
+    let claim = LeaseClaim::claim_current(&scratch.lease(), "hb").expect("claim");
+    let ttl = Duration::from_millis(300);
+    let grace = Duration::from_millis(2_000);
+    let (lease, lost) = watch(
+        &scratch.lease(),
+        None,
+        LeaseOptions::default()
+            .with_grace(grace)
+            .heartbeat_only(ttl),
+    );
+    // Miss the ttl: the lease is lost and the grace starts. Then beat again inside the grace,
+    // and keep beating past the point where the grace would have ended.
+    thread::sleep(ttl + Duration::from_millis(400));
+    let until = Instant::now() + grace + ttl;
+    while Instant::now() < until {
+        assert!(claim.heartbeat().expect("heartbeat"));
+        assert!(
+            lost.try_recv().is_err(),
+            "the resumed heartbeat revived the lease"
+        );
+        thread::sleep(Duration::from_millis(100));
+    }
+    assert_eq!(lease.stop(), LeaseEnd::Stopped);
+}
+
+#[test]
+fn the_heartbeat_fallback_needs_a_ttl() {
+    let scratch = Scratch::new("badopts");
+    let options = LeaseOptions {
+        heartbeat_only: true,
+        ..LeaseOptions::default()
+    };
+    let error = CallerLease::watch(&scratch.lease(), None, options, |_| {}).expect_err("invalid");
+    assert_eq!(error.kind(), std::io::ErrorKind::InvalidInput);
+    let error = CallerLease::watch(
+        &scratch.lease(),
+        None,
+        LeaseOptions::default().with_heartbeat_ttl(Duration::ZERO),
+        |_| {},
+    )
+    .expect_err("invalid");
+    assert_eq!(error.kind(), std::io::ErrorKind::InvalidInput);
+}
+
+#[test]
+fn the_lease_file_names_the_caller_and_only_its_claimant_refreshes_or_releases_it() {
+    let scratch = Scratch::new("file");
+    let (first, second) = (Caller::start(), Caller::start());
+    let one = LeaseClaim::claim(&scratch.lease(), first.identity(), "cli").expect("claim");
+    let record = LeaseRecord::read(&scratch.lease()).expect("a lease");
+    assert_eq!(record.holder, first.identity());
+    assert_eq!(record.label, "cli");
+    assert!(record.heartbeat >= record.claimed);
+
+    thread::sleep(Duration::from_millis(20));
+    assert!(one.heartbeat().expect("heartbeat"));
+    let beaten = LeaseRecord::read(&scratch.lease()).expect("a lease");
+    assert_eq!(
+        beaten.claimed, record.claimed,
+        "a heartbeat keeps the claim"
+    );
+    assert!(beaten.heartbeat > record.heartbeat);
+
+    // Another caller takes over: the first no longer owns the lease.
+    let two = LeaseClaim::claim(&scratch.lease(), second.identity(), "app").expect("claim");
+    assert!(!one.heartbeat().expect("heartbeat"));
+    assert!(!one.release().expect("release"), "not the holder any more");
+    assert_eq!(
+        LeaseRecord::read(&scratch.lease())
+            .expect("still there")
+            .holder,
+        second.identity()
+    );
+    assert!(two.release().expect("release"));
+    assert!(LeaseRecord::read(&scratch.lease()).is_none());
+    // Nothing but the lease's own helper files remain once released and stopped.
+    let leftovers: Vec<String> = fs::read_dir(scratch.path())
+        .expect("read_dir")
+        .flatten()
+        .map(|entry| entry.file_name().to_string_lossy().into_owned())
+        .filter(|name| name.ends_with(".tmp"))
+        .collect();
+    assert!(leftovers.is_empty(), "{leftovers:?}");
+}

@@ -0,0 +1,585 @@
+//! Who a process is, as data that an app can store and use after a restart.
+//!
+//! A pid is only a name (see `identity`): once the process exits the kernel may give the number
+//! to an unrelated process. An app that remembers a pid across its own restart, a leftover engine
+//! it must stop or a caller it must watch, therefore remembers a [`ProcessIdentity`]: the pid
+//! together with the process's start time, read from the kernel while the process was known to be
+//! the right one. Before acting on the number again, [`ProcessIdentity::check`] (or
+//! [`AdoptedProcess::adopt_checked`](crate::AdoptedProcess::adopt_checked)) asks the kernel
+//! whether the pid still starts at that time.
+//!
+//! # The rule, and where it lives
+//!
+//! The rule is the one in `identity`: the kernel's description of a pid, read by
+//! `identity::describe_state`, is the only thing a remembered pid is trusted against. This module
+//! adds no second reader. It turns that description into portable data ([`StartTime`]) and
+//! compares it. One difference from the check an [`OwnedChild`] makes of its own leader: a child
+//! of this process also compares the *parent*, because for a child the parent never changes. A
+//! stored identity outlives its parent (that is the usual reason for storing it: the app that
+//! started the process is gone and the process was re-parented to init), so the start time alone
+//! is compared here.
+//!
+//! # Start times
+//!
+//! * macOS: `proc_pidinfo(PROC_PIDTBSDINFO)` start time, seconds and microseconds since the epoch.
+//! * Linux and Android: field 22 of `/proc/<pid>/stat`, clock ticks since boot, together with the
+//!   boot id (`/proc/sys/kernel/random/boot_id`). Ticks restart at zero on every boot, so a
+//!   stored identity that survived a reboot could otherwise match a different process that has
+//!   the same pid and starts at the same tick.
+//! * Windows: the process creation `FILETIME` (`GetProcessTimes`). Not implemented yet; see
+//!   [`observe`](crate::observe).
+//!
+//! An identity recorded on one kind of host never matches on another: [`AdoptError::Unverifiable`].
+//!
+//! # Stored form
+//!
+//! [`ProcessIdentity`] prints as one line and parses back with [`FromStr`]:
+//! `pid=4242;start=macos:1760170000.123456;exe=%2Fbin%2Fsleep`. The executable is optional and
+//! percent-encoded byte for byte, so a path that is not valid UTF-8 round trips on Unix. The form
+//! is versionless on purpose: a new field would be a new `;key=value` part that an old reader
+//! rejects instead of misreading.
+
+use crate::{observe, owned::OwnedChild};
+use std::{
+    fmt, io,
+    path::{Path, PathBuf},
+    str::FromStr,
+};
+
+/// Which kind of kernel clock a [`StartTime`] was read from. Values from different clocks are
+/// never equal and never compared.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+enum Clock {
+    Macos,
+    Linux,
+    Windows,
+}
+
+/// When a process started, as the kernel reports it. Two start times are equal only when they
+/// were read from the same kind of clock and denote the same instant, so `pid` plus `StartTime`
+/// names one process for as long as the kernel's records last.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct StartTime {
+    clock: Clock,
+    /// macOS: seconds since the epoch. Linux: ticks since boot. Windows: `FILETIME` ticks.
+    major: u64,
+    /// macOS: microseconds. Otherwise 0.
+    minor: u64,
+    /// Linux: the boot id as a 128-bit number. Otherwise 0.
+    boot: u128,
+}
+
+// Each host builds exactly one of these, so the others look unused there.
+#[allow(dead_code)]
+impl StartTime {
+    pub(crate) fn macos(seconds: u64, microseconds: u64) -> Self {
+        Self {
+            clock: Clock::Macos,
+            major: seconds,
+            minor: microseconds,
+            boot: 0,
+        }
+    }
+
+    pub(crate) fn linux(boot: u128, ticks: u64) -> Self {
+        Self {
+            clock: Clock::Linux,
+            major: ticks,
+            minor: 0,
+            boot,
+        }
+    }
+
+    pub(crate) fn windows(filetime_ticks: u64) -> Self {
+        Self {
+            clock: Clock::Windows,
+            major: filetime_ticks,
+            minor: 0,
+            boot: 0,
+        }
+    }
+
+    /// Whether both were read from the same kind of clock (and so can be compared at all).
+    fn same_clock(&self, other: &Self) -> bool {
+        self.clock == other.clock
+    }
+}
+
+impl fmt::Display for StartTime {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.clock {
+            Clock::Macos => write!(f, "macos:{}.{:06}", self.major, self.minor),
+            Clock::Linux => write!(f, "linux:{:032x}:{}", self.boot, self.major),
+            Clock::Windows => write!(f, "windows:{}", self.major),
+        }
+    }
+}
+
+impl FromStr for StartTime {
+    type Err = ParseIdentityError;
+
+    fn from_str(text: &str) -> Result<Self, Self::Err> {
+        let bad = || ParseIdentityError::new("start time");
+        if let Some(rest) = text.strip_prefix("macos:") {
+            let (seconds, micros) = rest.split_once('.').ok_or_else(bad)?;
+            let seconds = seconds.parse::<u64>().map_err(|_| bad())?;
+            let micros = micros.parse::<u64>().map_err(|_| bad())?;
+            if micros >= 1_000_000 {
+                return Err(bad());
+            }
+            Ok(Self::macos(seconds, micros))
+        } else if let Some(rest) = text.strip_prefix("linux:") {
+            let (boot, ticks) = rest.split_once(':').ok_or_else(bad)?;
+            if boot.len() != 32 || !boot.bytes().all(|b| b.is_ascii_hexdigit()) {
+                return Err(bad());
+            }
+            let boot = u128::from_str_radix(boot, 16).map_err(|_| bad())?;
+            let ticks = ticks.parse::<u64>().map_err(|_| bad())?;
+            Ok(Self::linux(boot, ticks))
+        } else if let Some(rest) = text.strip_prefix("windows:") {
+            Ok(Self::windows(rest.parse::<u64>().map_err(|_| bad())?))
+        } else {
+            Err(bad())
+        }
+    }
+}
+
+/// Text that is not a [`ProcessIdentity`] or [`StartTime`] in the stored form.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ParseIdentityError {
+    what: &'static str,
+}
+
+impl ParseIdentityError {
+    fn new(what: &'static str) -> Self {
+        Self { what }
+    }
+}
+
+impl fmt::Display for ParseIdentityError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "not a process identity: bad {}", self.what)
+    }
+}
+
+impl std::error::Error for ParseIdentityError {}
+
+/// A process, named in a way that a recycled pid cannot satisfy: its pid, when it started, and
+/// (when the host can say) the executable it runs.
+///
+/// Capture one with [`of_child`](Self::of_child) right after spawning, or
+/// [`of_pid`](Self::of_pid) when the caller knows the pid still names the intended process (it
+/// was just spawned or is the current process). Store it as text ([`Display`](fmt::Display)) and
+/// read it back with [`FromStr`]. Use it later with [`check`](Self::check),
+/// [`AdoptedProcess::adopt_checked`](crate::AdoptedProcess::adopt_checked) or a
+/// [`CallerLease`](crate::CallerLease).
+///
+/// The fields are public so an app can build or inspect one, but a hand-built identity is only as
+/// good as its caller: [`check`](Self::check) is what proves it. Compare `executable` against the
+/// value [`of_pid`](Self::of_pid) reads (the kernel's resolved path), not a path the app
+/// composed.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct ProcessIdentity {
+    pub pid: u32,
+    pub started: StartTime,
+    /// The program the process was running, as the kernel reports it. `None` when the host
+    /// would not say; the check is then by start time alone.
+    pub executable: Option<PathBuf>,
+}
+
+impl ProcessIdentity {
+    /// The identity of the process that `pid` names right now. `NotFound` when there is none,
+    /// `Unsupported` when this host cannot describe processes.
+    ///
+    /// This trusts that `pid` names the intended process at this instant. For a child this
+    /// program spawned use [`of_child`](Self::of_child), which proves it.
+    pub fn of_pid(pid: u32) -> io::Result<Self> {
+        if pid == 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "pid 0 is not a process",
+            ));
+        }
+        match observe::observe(pid)? {
+            Some(observed) => Ok(Self {
+                pid,
+                started: observed.start,
+                executable: observed.executable,
+            }),
+            None => Err(io::Error::new(
+                io::ErrorKind::NotFound,
+                format!("no process {pid}"),
+            )),
+        }
+    }
+
+    /// The identity of the current process.
+    pub fn of_current() -> io::Result<Self> {
+        Self::of_pid(std::process::id())
+    }
+
+    /// The identity of a child this program spawned. Read under the identity proof and the
+    /// child's lock (see [`OwnedChild::while_unreaped`]), so the pid is certainly the child's.
+    /// `NotFound` once the child was reaped.
+    pub fn of_child(child: &OwnedChild) -> io::Result<Self> {
+        match child.while_unreaped(Self::of_pid)? {
+            Some(identity) => identity,
+            None => Err(io::Error::new(
+                io::ErrorKind::NotFound,
+                "the child was already reaped",
+            )),
+        }
+    }
+
+    /// Whether the kernel still has this process. `Ok(true)`: the same process, running.
+    /// `Ok(false)`: the same process, but it has exited and awaits its parent's reap. An
+    /// [`AdoptError`] says why it is not (gone, the number now names another process, another
+    /// program, or this host cannot tell). Never treats "cannot tell" as a match.
+    pub fn check(&self) -> Result<bool, AdoptError> {
+        verify(self).map(|verified| !verified.zombie)
+    }
+}
+
+impl fmt::Display for ProcessIdentity {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "pid={};start={}", self.pid, self.started)?;
+        if let Some(path) = &self.executable {
+            f.write_str(";exe=")?;
+            for &byte in path_bytes(path).iter() {
+                if byte.is_ascii_alphanumeric() || matches!(byte, b'/' | b'.' | b'_' | b'-' | b'~')
+                {
+                    write!(f, "{}", byte as char)?;
+                } else {
+                    write!(f, "%{byte:02X}")?;
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+impl FromStr for ProcessIdentity {
+    type Err = ParseIdentityError;
+
+    fn from_str(text: &str) -> Result<Self, Self::Err> {
+        let mut parts = text.split(';');
+        let pid = parts
+            .next()
+            .and_then(|part| part.strip_prefix("pid="))
+            .and_then(|digits| digits.parse::<u32>().ok())
+            .ok_or_else(|| ParseIdentityError::new("pid"))?;
+        let started = parts
+            .next()
+            .and_then(|part| part.strip_prefix("start="))
+            .ok_or_else(|| ParseIdentityError::new("start time"))?
+            .parse::<StartTime>()?;
+        let executable = match parts.next() {
+            None => None,
+            Some(part) => {
+                let encoded = part
+                    .strip_prefix("exe=")
+                    .ok_or_else(|| ParseIdentityError::new("executable"))?;
+                Some(
+                    decode_path(encoded)
+                        .ok_or_else(|| ParseIdentityError::new("executable path"))?,
+                )
+            }
+        };
+        if parts.next().is_some() {
+            return Err(ParseIdentityError::new("trailing part"));
+        }
+        Ok(Self {
+            pid,
+            started,
+            executable,
+        })
+    }
+}
+
+#[cfg(unix)]
+fn path_bytes(path: &Path) -> Vec<u8> {
+    use std::os::unix::ffi::OsStrExt;
+    path.as_os_str().as_bytes().to_vec()
+}
+
+#[cfg(not(unix))]
+fn path_bytes(path: &Path) -> Vec<u8> {
+    path.to_string_lossy().into_owned().into_bytes()
+}
+
+fn decode_path(encoded: &str) -> Option<PathBuf> {
+    let mut bytes = Vec::with_capacity(encoded.len());
+    let mut input = encoded.bytes();
+    while let Some(byte) = input.next() {
+        if byte == b'%' {
+            let high = hex_value(input.next()?)?;
+            let low = hex_value(input.next()?)?;
+            bytes.push((high << 4) | low);
+        } else {
+            bytes.push(byte);
+        }
+    }
+    path_from_bytes(bytes)
+}
+
+fn hex_value(digit: u8) -> Option<u8> {
+    match digit {
+        b'0'..=b'9' => Some(digit - b'0'),
+        b'a'..=b'f' => Some(digit - b'a' + 10),
+        b'A'..=b'F' => Some(digit - b'A' + 10),
+        _ => None,
+    }
+}
+
+#[cfg(unix)]
+fn path_from_bytes(bytes: Vec<u8>) -> Option<PathBuf> {
+    use std::os::unix::ffi::OsStringExt;
+    Some(PathBuf::from(std::ffi::OsString::from_vec(bytes)))
+}
+
+#[cfg(not(unix))]
+fn path_from_bytes(bytes: Vec<u8>) -> Option<PathBuf> {
+    String::from_utf8(bytes).ok().map(PathBuf::from)
+}
+
+/// Why a stored [`ProcessIdentity`] could not be adopted or matched. Every variant means
+/// "do not act on this pid"; `Unverifiable` in particular is never to be read as a match.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum AdoptError {
+    /// No process has this pid any more.
+    Gone,
+    /// The pid is alive but it is a different process: it started at another time. The kernel
+    /// gave the number to something unrelated after the recorded process exited.
+    Replaced {
+        /// When the process that holds the pid now started.
+        found: StartTime,
+    },
+    /// The start time matches but the process runs another program than the identity records.
+    ExecutableMismatch { expected: PathBuf, found: PathBuf },
+    /// This host cannot describe the process well enough to prove it: it cannot describe
+    /// processes at all (`kind` is `Unsupported`), the process could not be read, or the identity
+    /// was recorded on another kind of host. Nothing may be done to the pid.
+    Unverifiable { kind: io::ErrorKind, reason: String },
+}
+
+impl AdoptError {
+    /// True when the host has no way to describe processes (the Windows stub today, or a Unix
+    /// host without `/proc` or `libproc`).
+    pub fn is_unsupported(&self) -> bool {
+        matches!(
+            self,
+            AdoptError::Unverifiable { kind, .. } if *kind == io::ErrorKind::Unsupported
+        )
+    }
+}
+
+impl fmt::Display for AdoptError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            AdoptError::Gone => f.write_str("no such process"),
+            AdoptError::Replaced { found } => {
+                write!(f, "the pid now names a different process (started {found})")
+            }
+            AdoptError::ExecutableMismatch { expected, found } => write!(
+                f,
+                "the process runs {} instead of {}",
+                found.display(),
+                expected.display()
+            ),
+            AdoptError::Unverifiable { reason, .. } => {
+                write!(f, "the process cannot be verified: {reason}")
+            }
+        }
+    }
+}
+
+impl std::error::Error for AdoptError {}
+
+impl From<AdoptError> for io::Error {
+    fn from(error: AdoptError) -> Self {
+        let kind = match &error {
+            AdoptError::Gone | AdoptError::Replaced { .. } => io::ErrorKind::NotFound,
+            AdoptError::ExecutableMismatch { .. } => io::ErrorKind::PermissionDenied,
+            AdoptError::Unverifiable { kind, .. } => *kind,
+        };
+        io::Error::new(kind, error)
+    }
+}
+
+/// What a successful proof found.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Verified {
+    /// The process has exited and awaits its parent's reap.
+    pub(crate) zombie: bool,
+}
+
+/// The proof: does `identity.pid` still name the process the identity describes?
+pub(crate) fn verify(identity: &ProcessIdentity) -> Result<Verified, AdoptError> {
+    verify_parts(
+        identity.pid,
+        &identity.started,
+        identity.executable.as_deref(),
+    )
+}
+
+/// [`verify`] for callers that hold the pieces (`AdoptedProcess` keeps only the start time: the
+/// executable was compared once, when the adoption was made).
+pub(crate) fn verify_parts(
+    pid: u32,
+    started: &StartTime,
+    executable: Option<&Path>,
+) -> Result<Verified, AdoptError> {
+    let observed = match observe::observe(pid) {
+        Ok(Some(observed)) => observed,
+        Ok(None) => return Err(AdoptError::Gone),
+        Err(error) => {
+            return Err(AdoptError::Unverifiable {
+                kind: error.kind(),
+                reason: error.to_string(),
+            })
+        }
+    };
+    if !observed.start.same_clock(started) {
+        return Err(AdoptError::Unverifiable {
+            kind: io::ErrorKind::Unsupported,
+            reason: "the identity was recorded on another kind of host".to_string(),
+        });
+    }
+    if observed.start != *started {
+        return Err(AdoptError::Replaced {
+            found: observed.start,
+        });
+    }
+    if let Some(expected) = executable {
+        match observed.executable {
+            Some(found) if found == expected => {}
+            Some(found) => {
+                return Err(AdoptError::ExecutableMismatch {
+                    expected: expected.to_path_buf(),
+                    found,
+                })
+            }
+            // An exited process has no program to read; the start time already matched.
+            None if observed.zombie => {}
+            None => {
+                return Err(AdoptError::Unverifiable {
+                    kind: io::ErrorKind::PermissionDenied,
+                    reason: "the process's executable could not be read".to_string(),
+                })
+            }
+        }
+    }
+    Ok(Verified {
+        zombie: observed.zombie,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn sample() -> ProcessIdentity {
+        ProcessIdentity {
+            pid: 4242,
+            started: StartTime::macos(1_760_170_000, 123_456),
+            executable: Some(PathBuf::from(
+                "/Applications/My App.app/Contents/MacOS/engine;x",
+            )),
+        }
+    }
+
+    #[test]
+    fn the_stored_form_round_trips() {
+        let identity = sample();
+        let text = identity.to_string();
+        assert!(
+            !text.contains(' ') && text.matches(';').count() == 2,
+            "{text}"
+        );
+        assert_eq!(text.parse::<ProcessIdentity>(), Ok(identity));
+    }
+
+    #[test]
+    fn each_clock_round_trips() {
+        let linux = StartTime::linux(0x0123_4567_89ab_cdef_0123_4567_89ab_cdef, 987_654);
+        let windows = StartTime::windows(133_000_000_000_000_001);
+        for start in [StartTime::macos(1, 2), linux, windows] {
+            assert_eq!(start.to_string().parse::<StartTime>(), Ok(start));
+        }
+        assert_eq!(linux.to_string().len(), "linux:".len() + 32 + 1 + 6);
+    }
+
+    #[test]
+    fn a_missing_executable_is_kept_missing() {
+        let identity = ProcessIdentity {
+            executable: None,
+            ..sample()
+        };
+        let text = identity.to_string();
+        assert!(!text.contains("exe="));
+        assert_eq!(text.parse::<ProcessIdentity>(), Ok(identity));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_path_that_is_not_utf8_round_trips() {
+        use std::os::unix::ffi::OsStringExt;
+        let identity = ProcessIdentity {
+            executable: Some(PathBuf::from(std::ffi::OsString::from_vec(vec![
+                b'/', b'b', 0xff, 0xfe, b'%', b';', b'z',
+            ]))),
+            ..sample()
+        };
+        assert_eq!(
+            identity.to_string().parse::<ProcessIdentity>(),
+            Ok(identity)
+        );
+    }
+
+    #[test]
+    fn malformed_text_is_refused() {
+        for text in [
+            "",
+            "pid=1",
+            "pid=x;start=macos:1.000000",
+            "pid=1;start=macos:1",
+            "pid=1;start=macos:1.1000000",
+            "pid=1;start=nowhere:1",
+            "pid=1;start=linux:abc:1",
+            "pid=1;start=macos:1.000000;exe=%zz",
+            "pid=1;start=macos:1.000000;exe=%2",
+            "pid=1;start=macos:1.000000;extra=1",
+            "pid=1;start=macos:1.000000;exe=/a;more",
+            "start=macos:1.000000;pid=1",
+        ] {
+            assert!(text.parse::<ProcessIdentity>().is_err(), "{text:?}");
+        }
+    }
+
+    #[test]
+    fn start_times_from_different_clocks_are_never_equal() {
+        assert_ne!(StartTime::macos(5, 0), StartTime::windows(5));
+        assert!(!StartTime::macos(5, 0).same_clock(&StartTime::linux(0, 5)));
+        assert!(StartTime::macos(5, 0).same_clock(&StartTime::macos(6, 1)));
+    }
+
+    #[test]
+    fn adopt_errors_convert_to_io_errors_of_a_matching_kind() {
+        let kind = |error: AdoptError| io::Error::from(error).kind();
+        assert_eq!(kind(AdoptError::Gone), io::ErrorKind::NotFound);
+        assert_eq!(
+            kind(AdoptError::ExecutableMismatch {
+                expected: "/a".into(),
+                found: "/b".into()
+            }),
+            io::ErrorKind::PermissionDenied
+        );
+        let unsupported = AdoptError::Unverifiable {
+            kind: io::ErrorKind::Unsupported,
+            reason: String::new(),
+        };
+        assert!(unsupported.is_unsupported());
+        assert!(!AdoptError::Gone.is_unsupported());
+    }
+}

@@ -0,0 +1,99 @@
+//! Reading and replacing the small record files that sit beside a machine lock or a caller
+//! lease. Both are written whole and replaced atomically, so a reader sees the old record or the
+//! new one and never half of one; both are read with a size limit, so a giant file planted in a
+//! shared directory costs nothing.
+
+use crate::machine_sys as sys;
+use std::{
+    fs::{self, File},
+    io::{self, Read, Write},
+    path::Path,
+    sync::atomic::{AtomicU64, Ordering},
+};
+
+/// Takes the exclusive lock on `file`, blocking in the kernel's lock call until it is granted.
+/// A call that a signal interrupts (`EINTR`) is the same wait resumed, not a retry on a timer.
+pub(crate) fn lock_exclusive(file: &File) -> io::Result<()> {
+    loop {
+        match file.lock() {
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+            other => return other,
+        }
+    }
+}
+
+/// The most a record is read from.
+pub(crate) const READ_LIMIT: u64 = 256 * 1024;
+
+/// A small file's text, or `None` if it is missing, unreadable, over [`READ_LIMIT`] or not UTF-8.
+pub(crate) fn read_small(path: &Path) -> Option<String> {
+    let mut text = String::new();
+    File::open(path)
+        .ok()?
+        .take(READ_LIMIT + 1)
+        .read_to_string(&mut text)
+        .ok()?;
+    (text.len() as u64 <= READ_LIMIT).then_some(text)
+}
+
+/// Replaces `path` with `text`: a private temporary file in the same directory (created
+/// exclusively, owner-only, never through a link), renamed over `path`.
+pub(crate) fn write_atomic(path: &Path, text: &str) -> io::Result<()> {
+    static NEXT: AtomicU64 = AtomicU64::new(0);
+    let name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("record");
+    let temp = path.with_file_name(format!(
+        "{name}.{}.{}.tmp",
+        std::process::id(),
+        NEXT.fetch_add(1, Ordering::Relaxed)
+    ));
+    let written = sys::create_new_private(&temp)
+        .and_then(|mut file| file.write_all(text.as_bytes()))
+        .and_then(|()| fs::rename(&temp, path));
+    if written.is_err() {
+        let _ = fs::remove_file(&temp);
+    }
+    written
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use crate::test_support::Scratch;
+
+    #[test]
+    fn a_record_is_replaced_whole_and_leaves_no_temporary() {
+        let scratch = Scratch::new("record");
+        let path = scratch.join("a.json");
+        assert_eq!(read_small(&path), None);
+        write_atomic(&path, "one").expect("write");
+        assert_eq!(read_small(&path).as_deref(), Some("one"));
+        write_atomic(&path, "two").expect("replace");
+        assert_eq!(read_small(&path).as_deref(), Some("two"));
+        let names: Vec<_> = std::fs::read_dir(scratch.path())
+            .expect("read_dir")
+            .flatten()
+            .map(|entry| entry.file_name())
+            .collect();
+        assert_eq!(names, vec![std::ffi::OsString::from("a.json")]);
+    }
+
+    #[test]
+    fn an_oversized_or_non_text_file_reads_as_nothing() {
+        let scratch = Scratch::new("record-limit");
+        let big = scratch.join("big");
+        std::fs::write(&big, vec![b'x'; READ_LIMIT as usize + 1]).expect("write");
+        assert_eq!(read_small(&big), None);
+        let exact = scratch.join("exact");
+        std::fs::write(&exact, vec![b'x'; READ_LIMIT as usize]).expect("write");
+        assert_eq!(
+            read_small(&exact).map(|text| text.len()),
+            Some(READ_LIMIT as usize)
+        );
+        let binary = scratch.join("binary");
+        std::fs::write(&binary, [0xff, 0xfe, 0x00]).expect("write");
+        assert_eq!(read_small(&binary), None);
+    }
+}

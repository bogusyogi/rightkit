index 00000000..eeb1e781
--- /dev/null
+++ b/crates/rightkit-process/src/observe.rs
@@ -0,0 +1,213 @@
+//! Reads what the kernel says about a pid, as the portable data `process_identity` compares:
+//! the start time, the executable and whether the process has already exited.
+//!
+//! The start time comes from `identity::describe_state`, the one reader of the kernel's
+//! description (`proc_pidinfo` on macOS, `/proc/<pid>/stat` on Linux); this module only converts
+//! it. The executable is the second factor and is read separately:
+//!
+//! * macOS: `proc_pidpath`.
+//! * Linux and Android: the `/proc/<pid>/exe` link, with the `" (deleted)"` suffix the kernel adds
+//!   when the program file was removed or replaced on disk while the process runs, so an app
+//!   update does not make a still-running engine look like another program.
+//!
+//! An exited, unreaped process (a zombie) has no program to read (checked on Darwin 27:
+//! `proc_pidpath` returns 0 for a zombie; on Linux the exe link of a zombie is not readable,
+//! which no test here exercises); its executable is not read at all, it is `None`, and `zombie`
+//! is set, which callers read as "the same process, not running".
+//!
+//! # Windows
+//!
+//! The Windows implementation is the `imp` module at the bottom of this file and is a stub that
+//! answers `Unsupported`. The Windows session fills it in with:
+//!
+//! * `OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE, FALSE, pid)`. A failure with
+//!   `ERROR_INVALID_PARAMETER` is "no such process" (`Ok(None)`); `ERROR_ACCESS_DENIED` is a
+//!   real error (the process exists but cannot be read).
+//! * The creation time from `GetProcessTimes` (the same call `ProcessHandle` uses for
+//!   `creation_time_ticks`), as `StartTime::windows(ticks)`.
+//! * `zombie`: `WaitForSingleObject(handle, 0) == WAIT_OBJECT_0`. Windows keeps no zombie, but a
+//!   process that has exited while some handle to it is open still has a creation time; that is
+//!   the same "exited, not running" state.
+//! * `executable`: `QueryFullProcessImageNameW(handle, 0, ..)` (a `PathBuf` of the Win32 path).
+//!   Compare paths case-insensitively when the identity is checked (the checker in
+//!   `process_identity` compares `PathBuf` equality; the Windows session decides whether to
+//!   normalise the case here before storing and comparing).
+
+use crate::process_identity::StartTime;
+use std::path::PathBuf;
+
+/// What `observe` read about one process.
+#[derive(Clone, Debug)]
+pub(crate) struct Observation {
+    pub(crate) start: StartTime,
+    /// The program the process runs; `None` when unreadable, and always for a zombie.
+    pub(crate) executable: Option<PathBuf>,
+    /// The process has exited and awaits its parent's reap.
+    pub(crate) zombie: bool,
+}
+
+pub(crate) use imp::observe;
+
+#[cfg(unix)]
+mod imp {
+    use super::Observation;
+    use crate::{identity, process_identity::StartTime};
+    use std::{io, path::PathBuf};
+
+    /// `Ok(None)`: no such process. `Err(Unsupported)`: this host cannot describe processes.
+    pub(crate) fn observe(pid: u32) -> io::Result<Option<Observation>> {
+        if !identity::SUPPORTED {
+            return Err(io::Error::from(io::ErrorKind::Unsupported));
+        }
+        let Some(described) = identity::describe_state(pid)? else {
+            return Ok(None);
+        };
+        let start = start_time(&described.identity)?;
+        let executable = if described.zombie {
+            None
+        } else {
+            executable_of(pid)
+        };
+        Ok(Some(Observation {
+            start,
+            executable,
+            zombie: described.zombie,
+        }))
+    }
+
+    #[cfg(target_os = "macos")]
+    fn start_time(identity: &identity::Identity) -> io::Result<StartTime> {
+        Ok(StartTime::macos(
+            identity.started_sec,
+            identity.started_usec,
+        ))
+    }
+
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    fn start_time(identity: &identity::Identity) -> io::Result<StartTime> {
+        Ok(StartTime::linux(boot_id()?, identity.started_sec))
+    }
+
+    #[cfg(not(any(target_os = "macos", target_os = "linux", target_os = "android")))]
+    fn start_time(_identity: &identity::Identity) -> io::Result<StartTime> {
+        Err(io::Error::from(io::ErrorKind::Unsupported))
+    }
+
+    /// The boot id as a number. Ticks since boot restart at zero on every boot, so a stored
+    /// start time is only comparable within one boot.
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    fn boot_id() -> io::Result<u128> {
+        let text = std::fs::read_to_string("/proc/sys/kernel/random/boot_id")?;
+        let digits: String = text.trim().chars().filter(|c| *c != '-').collect();
+        if digits.len() != 32 || !digits.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "unreadable boot id",
+            ));
+        }
+        u128::from_str_radix(&digits, 16)
+            .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "unreadable boot id"))
+    }
+
+    #[cfg(target_os = "macos")]
+    fn executable_of(pid: u32) -> Option<PathBuf> {
+        use std::os::unix::ffi::OsStringExt;
+        let mut buffer = vec![0u8; libc::PROC_PIDPATHINFO_MAXSIZE as usize];
+        // SAFETY: the buffer is exactly as long as the size passed.
+        let written = unsafe {
+            libc::proc_pidpath(
+                pid as libc::c_int,
+                buffer.as_mut_ptr().cast(),
+                buffer.len() as u32,
+            )
+        };
+        if written <= 0 {
+            return None;
+        }
+        buffer.truncate(written as usize);
+        Some(PathBuf::from(std::ffi::OsString::from_vec(buffer)))
+    }
+
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    fn executable_of(pid: u32) -> Option<PathBuf> {
+        use std::os::unix::ffi::{OsStrExt, OsStringExt};
+        let link = std::fs::read_link(format!("/proc/{pid}/exe")).ok()?;
+        // A program file replaced on disk after the process started reads back with this suffix.
+        match link.as_os_str().as_bytes().strip_suffix(b" (deleted)") {
+            Some(stripped) => Some(PathBuf::from(std::ffi::OsString::from_vec(
+                stripped.to_vec(),
+            ))),
+            None => Some(link),
+        }
+    }
+
+    #[cfg(not(any(target_os = "macos", target_os = "linux", target_os = "android")))]
+    fn executable_of(_pid: u32) -> Option<PathBuf> {
+        None
+    }
+}
+
+#[cfg(windows)]
+mod imp {
+    use super::Observation;
+    use std::io;
+
+    /// WINDOWS SESSION: implement per the module documentation. Until then no process on this
+    /// host can be proven, so every identity check answers `Unverifiable` (kind `Unsupported`)
+    /// and nothing is ever treated as a match.
+    pub(crate) fn observe(_pid: u32) -> io::Result<Option<Observation>> {
+        Err(io::Error::from(io::ErrorKind::Unsupported))
+    }
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use std::process::{Command, Stdio};
+
+    #[test]
+    fn the_current_process_is_observed_with_its_program() {
+        let observed = observe(std::process::id())
+            .expect("observe")
+            .expect("the current process exists");
+        assert!(!observed.zombie);
+        let executable = observed.executable.expect("the program is readable");
+        let expected = std::env::current_exe().expect("current_exe");
+        assert_eq!(
+            std::fs::canonicalize(executable).expect("canonicalize"),
+            std::fs::canonicalize(expected).expect("canonicalize")
+        );
+    }
+
+    #[test]
+    fn a_pid_that_is_not_there_is_none() {
+        let mut child = Command::new("/bin/sh")
+            .args(["-c", "exit 0"])
+            .stdin(Stdio::null())
+            .spawn()
+            .expect("spawn");
+        let pid = child.id();
+        child.wait().expect("reap");
+        // Reaped just now; the number is not reused within the next instant on any supported
+        // host (pids are handed out in increasing order).
+        assert!(observe(pid).expect("observe").is_none());
+    }
+
+    #[test]
+    fn an_exited_unreaped_child_is_a_zombie_without_a_program() {
+        let mut child = Command::new("/bin/sh")
+            .args(["-c", "exit 0"])
+            .stdin(Stdio::null())
+            .spawn()
+            .expect("spawn");
+        // Sleep in the kernel until it has exited, without reaping it.
+        let watch = crate::exit_watch::ExitWatch::open(child.id(), true);
+        assert!(watch
+            .wait(Some(std::time::Duration::from_secs(10)))
+            .expect("wait"));
+        let observed = observe(child.id()).expect("observe").expect("still listed");
+        assert!(observed.zombie);
+        assert!(observed.executable.is_none());
+        child.wait().expect("reap");
+    }
+}

+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use crate::test_support::Scratch;
+    use std::{io, time::Duration};
+
+    const SHORT: Option<Duration> = Some(Duration::from_millis(50));
+    const LONG: Option<Duration> = Some(Duration::from_secs(10));
+
+    #[test]
+    fn ringing_with_nobody_listening_is_not_an_error() {
+        let scratch = Scratch::new("bell-none");
+        assert!(!ring(&scratch.join("absent.bell"), b"x\n").expect("ring"));
+        let path = scratch.join("gone.bell");
+        let bell = Doorbell::create(&path, true).expect("create");
+        drop(bell);
+        assert!(!path.exists(), "dropping the owner removes the FIFO");
+        assert!(!ring(&path, b"x\n").expect("ring"));
+    }
+
+    #[test]
+    fn a_message_wakes_the_owner_and_is_read_once() {
+        let scratch = Scratch::new("bell-ring");
+        let path = scratch.join("a.bell");
+        let bell = Doorbell::create(&path, false).expect("create");
+        assert_eq!(bell.reader().wait(SHORT).expect("wait"), b"");
+        assert!(ring(&path, b"first\n").expect("ring"));
+        assert!(ring(&path, b"second\n").expect("ring"));
+        assert_eq!(bell.reader().wait(LONG).expect("wait"), b"first\nsecond\n");
+        assert_eq!(bell.reader().wait(SHORT).expect("wait"), b"");
+    }
+
+    #[test]
+    fn a_ring_from_another_thread_wakes_a_sleeper() {
+        let scratch = Scratch::new("bell-thread");
+        let path = scratch.join("a.bell");
+        let bell = Doorbell::create(&path, false).expect("create");
+        let ringer = std::thread::spawn({
+            let path = path.clone();
+            move || ring(&path, b"w\n").expect("ring")
+        });
+        assert_eq!(bell.reader().wait(LONG).expect("wait"), b"w\n");
+        assert!(ringer.join().expect("join"));
+    }
+
+    #[test]
+    fn a_live_owner_is_not_replaced_unless_taken_over() {
+        let scratch = Scratch::new("bell-owner");
+        let path = scratch.join("a.bell");
+        let first = Doorbell::create(&path, false).expect("create");
+        let error = Doorbell::create(&path, false).expect_err("second owner");
+        assert_eq!(error.kind(), io::ErrorKind::AddrInUse);
+        let second = Doorbell::create(&path, true).expect("take over");
+        // The first owner's drop must not remove the FIFO its successor now owns.
+        drop(first);
+        assert!(ring(&path, b"x\n").expect("ring"));
+        assert_eq!(second.reader().wait(LONG).expect("wait"), b"x\n");
+    }
+
+    #[test]
+    fn a_stale_fifo_with_no_listener_is_replaced() {
+        let scratch = Scratch::new("bell-stale");
+        let path = scratch.join("a.bell");
+        // A FIFO nobody listens on, as an owner that died without cleanup leaves behind.
+        let c_path = std::ffi::CString::new(path.to_str().expect("utf-8 path")).expect("c path");
+        // SAFETY: a valid NUL-terminated path.
+        assert_eq!(unsafe { libc::mkfifo(c_path.as_ptr(), 0o600) }, 0);
+        assert!(
+            !ring(&path, b"x\n").expect("ring"),
+            "nobody listens on the stale FIFO"
+        );
+        let bell = Doorbell::create(&path, false).expect("replace the stale FIFO");
+        assert!(ring(&path, b"x\n").expect("ring"));
+        assert_eq!(bell.reader().wait(LONG).expect("wait"), b"x\n");
+    }
+
+    #[test]
+    fn a_path_that_is_not_a_fifo_is_never_written() {
+        let scratch = Scratch::new("bell-regular");
+        let path = scratch.join("regular");
+        std::fs::write(&path, b"keep").expect("write");
+        // Opening a regular file for writing succeeds, so the ring must refuse it.
+        assert!(ring(&path, b"x\n").is_err());
+        assert_eq!(std::fs::read(&path).expect("read"), b"keep");
+    }
+
+    #[test]
+    fn dropping_the_stop_sender_wakes_a_sleeper() {
+        let scratch = Scratch::new("bell-stop");
+        let bell = Doorbell::create(&scratch.join("a.bell"), false).expect("create");
+        let (sender, receiver) = stop_pair().expect("pair");
+        assert!(matches!(
+            bell.reader().wait_or_stop(&receiver, SHORT).expect("wait"),
+            BellWake::TimedOut
+        ));
+        drop(sender);
+        assert!(matches!(
+            bell.reader().wait_or_stop(&receiver, LONG).expect("wait"),
+            BellWake::Stopped
+        ));
+    }
+
+    #[test]
+    fn a_leaked_stop_sender_never_fires() {
+        let scratch = Scratch::new("bell-leak");
+        let bell = Doorbell::create(&scratch.join("a.bell"), false).expect("create");
+        let (sender, receiver) = stop_pair().expect("pair");
+        sender.leak();
+        assert!(matches!(
+            bell.reader().wait_or_stop(&receiver, SHORT).expect("wait"),
+            BellWake::TimedOut
+        ));
+    }
+}
diff --git a/crates/rightkit-process/src/exit_watch.rs b/crates/rightkit-process/src/exit_watch.rs
index 91efc4f7..38c8717d 100644
--- a/crates/rightkit-process/src/exit_watch.rs
+++ b/crates/rightkit-process/src/exit_watch.rs
@@ -168,6 +168,15 @@ impl ExitWatch {
         }
     }
 
+    /// The descriptor that becomes readable when the process exits, for a caller that sleeps on
+    /// several events in one [`poll_readable`] (a caller lease waits on the caller's exit, a
+    /// doorbell and a stop signal at once). `None` when there is no descriptor: the process had
+    /// already exited when the watch was opened (`wait` then answers at once), or the host has no
+    /// event source. Ask `wait(Some(Duration::ZERO))` first; it reports a fired watch.
+    pub(crate) fn event_fd(&self) -> Option<RawFd> {
+        self.raw_fd()
+    }
+

+//! The small slice of JSON this crate needs for the records it stores itself: the machine-lock
+//! holder record and the caller-lease file. Both are flat objects of strings and non-negative
+//! integers, written by this crate and read back by this crate (or by an app's `doctor`).
+//!
+//! `rightkit-process` has no serde dependency (it is a leaf under many crates, and its only
+//! dependencies are `libc` and `windows`), so the records are encoded here instead of pulling a
+//! serialisation stack into every consumer. The reader is strict about what it accepts as JSON
+//! and bounded: input over [`MAX_LEN`] bytes or nested deeper than [`MAX_DEPTH`] is refused, so a
+//! record planted in a shared directory cannot make a reader allocate or recurse without limit.
+//!
+//! Numbers: a non-negative integer that fits `u64` is kept exactly ([`Json::Uint`]; a Windows
+//! `FILETIME` start time is above 2^53 and would not survive a float). Any other number is read
+//! as [`Json::Other`], never written, and never matches an accessor.
+
+use std::fmt::Write as _;
+
+/// Longest text the reader looks at.
+pub(crate) const MAX_LEN: usize = 1 << 20;
+/// Deepest nesting the reader follows.
+pub(crate) const MAX_DEPTH: usize = 8;
+
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum Json {
+    Null,
+    Bool(bool),
+    Uint(u64),
+    /// A number that is not a non-negative integer fitting `u64`.
+    Other,
+    Str(String),
+    Array(Vec<Json>),
+    /// Members in file order; a repeated key keeps its first value for [`Json::get`].
+    Object(Vec<(String, Json)>),
+}
+
+impl Json {
+    pub(crate) fn get(&self, key: &str) -> Option<&Json> {
+        match self {
+            Json::Object(members) => members
+                .iter()
+                .find(|(name, _)| name == key)
+                .map(|(_, value)| value),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn as_str(&self) -> Option<&str> {
+        match self {
+            Json::Str(text) => Some(text),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn as_u64(&self) -> Option<u64> {
+        match self {
+            Json::Uint(number) => Some(*number),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn as_object(&self) -> Option<&[(String, Json)]> {
+        match self {
+            Json::Object(members) => Some(members),
+            _ => None,
+        }
+    }
+}
+
+/// Reads one JSON value. `None` for anything that is not exactly one well-formed value.
+pub(crate) fn parse(text: &str) -> Option<Json> {
+    if text.len() > MAX_LEN {
+        return None;
+    }
+    let mut reader = Reader {
+        text: text.as_bytes(),
+        at: 0,
+    };
+    let value = reader.value(0)?;
+    reader.skip_space();
+    (reader.at == reader.text.len()).then_some(value)
+}
+
+struct Reader<'a> {
+    text: &'a [u8],
+    at: usize,
+}
+
+impl Reader<'_> {
+    fn skip_space(&mut self) {
+        while matches!(self.peek(), Some(b' ' | b'\t' | b'\n' | b'\r')) {
+            self.at += 1;
+        }
+    }
+
+    fn peek(&self) -> Option<u8> {
+        self.text.get(self.at).copied()
+    }
+
+    fn eat(&mut self, byte: u8) -> bool {
+        if self.peek() == Some(byte) {
+            self.at += 1;
+            true
+        } else {
+            false
+        }
+    }
+
+    fn word(&mut self, word: &str) -> bool {
+        if self.text[self.at..].starts_with(word.as_bytes()) {
+            self.at += word.len();
+            true
+        } else {
+            false
+        }
+    }
+
+    fn value(&mut self, depth: usize) -> Option<Json> {
+        if depth > MAX_DEPTH {
+            return None;
+        }
+        self.skip_space();
+        match self.peek()? {
+            b'{' => self.object(depth),
+            b'[' => self.array(depth),
+            b'"' => self.string().map(Json::Str),
+            b't' => self.word("true").then_some(Json::Bool(true)),
+            b'f' => self.word("false").then_some(Json::Bool(false)),
+            b'n' => self.word("null").then_some(Json::Null),
+            b'-' | b'0'..=b'9' => self.number(),
+            _ => None,
+        }
+    }
+
+    fn object(&mut self, depth: usize) -> Option<Json> {
+        self.at += 1; // '{'
+        let mut members = Vec::new();
+        self.skip_space();
+        if self.eat(b'}') {
+            return Some(Json::Object(members));
+        }
+        loop {
+            self.skip_space();
+            let key = self.string()?;
+            self.skip_space();
+            if !self.eat(b':') {
+                return None;
+            }
+            let value = self.value(depth + 1)?;
+            members.push((key, value));
+            self.skip_space();
+            if self.eat(b',') {
+                continue;
+            }
+            return self.eat(b'}').then_some(Json::Object(members));
+        }
+    }
+
+    fn array(&mut self, depth: usize) -> Option<Json> {
+        self.at += 1; // '['
+        let mut items = Vec::new();
+        self.skip_space();
+        if self.eat(b']') {
+            return Some(Json::Array(items));
+        }
+        loop {
+            items.push(self.value(depth + 1)?);
+            self.skip_space();
+            if self.eat(b',') {
+                continue;
+            }
+            return self.eat(b']').then_some(Json::Array(items));
+        }
+    }
+
+    fn string(&mut self) -> Option<String> {
+        if !self.eat(b'"') {
+            return None;
+        }
+        let mut out: Vec<u8> = Vec::new();
+        loop {
+            let byte = self.peek()?;
+            self.at += 1;
+            match byte {
+                b'"' => return String::from_utf8(out).ok(),
+                b'\\' => {
+                    let escape = self.peek()?;
+                    self.at += 1;
+                    match escape {
+                        b'"' => out.push(b'"'),
+                        b'\\' => out.push(b'\\'),
+                        b'/' => out.push(b'/'),
+                        b'b' => out.push(0x08),
+                        b'f' => out.push(0x0c),
+                        b'n' => out.push(b'\n'),
+                        b'r' => out.push(b'\r'),
+                        b't' => out.push(b'\t'),
+                        b'u' => {
+                            let mut unit = self.hex4()?;
+                            if (0xD800..0xDC00).contains(&unit) {
+                                // A high surrogate must be followed by a low one.
+                                if !(self.eat(b'\\') && self.eat(b'u')) {
+                                    return None;
+                                }
+                                let low = self.hex4()?;
+                                if !(0xDC00..0xE000).contains(&low) {
+                                    return None;
+                                }
+                                unit = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00);
+                            } else if (0xDC00..0xE000).contains(&unit) {
+                                return None; // a lone low surrogate
+                            }
+                            let mut buffer = [0u8; 4];
+                            let encoded = char::from_u32(unit)?.encode_utf8(&mut buffer);
+                            out.extend_from_slice(encoded.as_bytes());
+                        }
+                        _ => return None,
+                    }
+                }
+                0x00..=0x1f => return None, // control characters must be escaped
+                other => out.push(other),
+            }
+        }
+    }
+
+    fn hex4(&mut self) -> Option<u32> {
+        let digits = self.text.get(self.at..self.at + 4)?;
+        if !digits.iter().all(u8::is_ascii_hexdigit) {
+            return None;
+        }
+        let value = u32::from_str_radix(std::str::from_utf8(digits).ok()?, 16).ok()?;
+        self.at += 4;
+        Some(value)
+    }
+
+    fn number(&mut self) -> Option<Json> {
+        let start = self.at;
+        let negative = self.eat(b'-');
+        let integer = self.at;
+        while matches!(self.peek(), Some(b'0'..=b'9')) {
+            self.at += 1;
+        }
+        if self.at == integer {
+            return None;
+        }
+        let integer_end = self.at;
+        let mut plain = !negative;
+        if self.eat(b'.') {
+            plain = false;
+            let fraction = self.at;
+            while matches!(self.peek(), Some(b'0'..=b'9')) {
+                self.at += 1;
+            }
+            if self.at == fraction {
+                return None;
+            }
+        }
+        if matches!(self.peek(), Some(b'e' | b'E')) {
+            plain = false;
+            self.at += 1;
+            if matches!(self.peek(), Some(b'+' | b'-')) {
+                self.at += 1;
+            }
+            let exponent = self.at;
+            while matches!(self.peek(), Some(b'0'..=b'9')) {
+                self.at += 1;
+            }
+            if self.at == exponent {
+                return None;
+            }
+        }
+        if plain {
+            let digits = std::str::from_utf8(&self.text[start..integer_end]).ok()?;
+            if let Ok(number) = digits.parse::<u64>() {
+                return Some(Json::Uint(number));
+            }
+        }
+        Some(Json::Other)
+    }
+}
+
+/// Compact JSON text for `value`. [`Json::Other`] is written as `null`: it only ever comes from
+/// reading, and nothing here writes a value it read without looking at it.
+pub(crate) fn write(value: &Json) -> String {
+    let mut out = String::new();
+    emit(value, &mut out);
+    out
+}
+
+fn emit(value: &Json, out: &mut String) {
+    match value {
+        Json::Null | Json::Other => out.push_str("null"),
+        Json::Bool(flag) => out.push_str(if *flag { "true" } else { "false" }),
+        Json::Uint(number) => {
+            let _ = write!(out, "{number}");
+        }
+        Json::Str(text) => emit_string(text, out),
+        Json::Array(items) => {
+            out.push('[');
+            for (index, item) in items.iter().enumerate() {
+                if index > 0 {
+                    out.push(',');
+                }
+                emit(item, out);
+            }
+            out.push(']');
+        }
+        Json::Object(members) => {
+            out.push('{');
+            for (index, (key, item)) in members.iter().enumerate() {
+                if index > 0 {
+                    out.push(',');
+                }
+                emit_string(key, out);
+                out.push(':');
+                emit(item, out);
+            }
+            out.push('}');
+        }
+    }
+}
+
+fn emit_string(text: &str, out: &mut String) {
+    out.push('"');
+    for character in text.chars() {
+        match character {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            other if (other as u32) < 0x20 => {
+                let _ = write!(out, "\\u{:04x}", other as u32);
+            }
+            other => out.push(other),
+        }
+    }
+    out.push('"');
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn object(members: &[(&str, Json)]) -> Json {
+        Json::Object(
+            members
+                .iter()
+                .map(|(key, value)| ((*key).to_string(), value.clone()))
+                .collect(),
+        )
+    }
+
+    #[test]
+    fn a_record_round_trips() {
+        let value = object(&[
+            ("version", Json::Uint(1)),
+            ("holder", Json::Str("pid=1;start=macos:2.000003".into())),
+            ("big", Json::Uint(u64::MAX)),
+            (
+                "details",
+                object(&[("model", Json::Str("qwen \"21\" \\ / \n\t".into()))]),
+            ),
+            ("flags", Json::Array(vec![Json::Bool(true), Json::Null])),
+        ]);
+        assert_eq!(parse(&write(&value)), Some(value));
+    }
+
+    #[test]
+    fn exact_integers_survive_above_two_to_the_fifty_third() {
+        // A Windows FILETIME is about 1.3e17.
+        let ticks = 133_000_000_000_000_001_u64;
+        let text = write(&object(&[("t", Json::Uint(ticks))]));
+        assert_eq!(
+            parse(&text).unwrap().get("t").unwrap().as_u64(),
+            Some(ticks)
+        );
+    }
+
+    #[test]
+    fn other_numbers_parse_but_never_match_an_integer_accessor() {
+        for text in ["-1", "1.5", "2e3", "18446744073709551616"] {
+            assert_eq!(parse(text), Some(Json::Other), "{text}");
+        }
+        assert_eq!(parse("1.5").unwrap().as_u64(), None);
+        assert_eq!(write(&Json::Other), "null");
+    }
+
+    #[test]
+    fn escapes_and_surrogate_pairs_are_decoded() {
+        let value = parse(r#""a\u0041\n\ud83d\ude00\/""#).unwrap();
+        assert_eq!(value.as_str(), Some("aA\n\u{1F600}/"));
+    }
+
+    #[test]
+    fn control_characters_are_written_escaped() {
+        assert_eq!(write(&Json::Str("\u{1}".into())), "\"\\u0001\"");
+    }
+
+    #[test]
+    fn malformed_text_is_refused() {
+        for text in [
+            "",
+            "{",
+            "{\"a\":}",
+            "{\"a\":1,}",
+            "[1,]",
+            "\"unterminated",
+            "\"\\ud800\"",
+            "\"\\udc00\"",
+            "\"\\u12g4\"",
+            "\"\\u+123\"",
+            "{\"a\":1} trailing",
+            "tru",
+            "01x",
+            "\"raw\ncontrol\"",
+        ] {
+            assert_eq!(parse(text), None, "{text:?}");
+        }
+    }
+
+    #[test]
+    fn nesting_and_size_are_bounded() {
+        let deep = format!("{}{}", "[".repeat(MAX_DEPTH + 2), "]".repeat(MAX_DEPTH + 2));
+        assert_eq!(parse(&deep), None);
+        let shallow = format!("{}{}", "[".repeat(MAX_DEPTH), "]".repeat(MAX_DEPTH));
+        assert!(parse(&shallow).is_some());
+        assert_eq!(parse(&" ".repeat(MAX_LEN + 1)), None);
+    }
+
+    #[test]
+    fn the_first_of_a_repeated_key_wins() {
+        let value = parse(r#"{"k":"first","k":"second"}"#).unwrap();
+        assert_eq!(value.get("k").unwrap().as_str(), Some("first"));
+    }
+}

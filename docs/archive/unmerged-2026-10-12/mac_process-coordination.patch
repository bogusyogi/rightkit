+#[test]
+fn the_per_user_machine_directory_is_private_and_found_by_name() {
+    let app = format!("rk-lock-test-{}", std::process::id());
+    let first = rightkit_process::machine_dir(&app).expect("create");
+    let again = rightkit_process::machine_dir(&app).expect("reuse");
+    assert_eq!(first, again);
+    assert!(
+        first.starts_with("/tmp"),
+        "{first:?}: not under $TMPDIR or $HOME"
+    );
+    let mode = fs::metadata(&first).expect("stat").permissions().mode();
+    assert_eq!(mode & 0o777, 0o700);
+
+    // It is a place a lock can live.
+    let lock = MachineLock::acquire("probe", &first, options()).expect("acquire there");
+    drop(lock);
+    let _ = fs::remove_dir_all(&first);
+}
+
+#[test]
+fn retrying_against_a_wedged_holder_leaves_the_lock_takeable_when_it_lets_go() {
+    let scratch = Scratch::new("retry");
+    let dir = scratch.path();
+    let holder = MachineLock::acquire("sd", dir, options()).expect("acquire");
+    // Each timed-out attempt reuses the one parked lock call instead of adding another.
+    for _ in 0..3 {
+        let error = MachineLock::acquire("sd", dir, wait_for(Duration::from_millis(100)))
+            .expect_err("held");
+        assert!(error.busy().is_some());
+    }
+    drop(holder);
+    // The parked call got the lock when nobody wanted it, and gave it straight back.
+    let started = Instant::now();
+    let lock =
+        MachineLock::acquire("sd", dir, wait_for(Duration::from_secs(20))).expect("free again");
+    assert!(started.elapsed() < Duration::from_secs(10));
+    drop(lock);
+}
+
+#[test]
+fn two_waiters_in_one_process_are_served_one_after_the_other() {
+    let scratch = Scratch::new("two");
+    let dir = scratch.path().to_path_buf();
+    let holder = MachineLock::acquire("sd", &dir, options()).expect("acquire");
+    let events = holder.waiter_events().expect("events");
+    let spawn_waiter = |dir: PathBuf| {
+        thread::spawn(move || {
+            let lock = MachineLock::acquire("sd", &dir, wait_for(Duration::from_secs(60)))
+                .expect("served in turn");
+            // Hold it briefly, so the other waiter really has to wait for this one.
+            let at = Instant::now();
+            drop(lock);
+            at
+        })
+    };
+    let first = spawn_waiter(dir.clone());
+    let second = spawn_waiter(dir.clone());
+    let mut seen = 0;
+    while seen < 2 {
+        seen += events
+            .wait(Some(Duration::from_secs(20)))
+            .expect("wait")
+            .len();
+    }
+    assert_eq!(holder.waiters().len(), 2);
+    drop(holder);
+    first.join().expect("first");
+    second.join().expect("second");
+    assert!(matches!(MachineLock::peek("sd", &dir), Ok(LockState::Free)));
+}

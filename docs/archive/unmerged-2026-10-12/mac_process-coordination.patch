--- /dev/null
+++ b/crates/rightkit-process/src/doorbell.rs
@@ -0,0 +1,465 @@
+//! A doorbell: a way to tell a process that sleeps in `poll(2)` that something happened, so that
+//! it never wakes on a timer to look.
+//!
+//! A regular file offers no notification that works the same on macOS (kqueue vnode events) and
+//! Linux (inotify), and a rename-replaced record would need a watch on the directory besides. So
+//! whoever must be told owns a **FIFO** (a named pipe) at a path both sides know:
+//!
+//! * The owner creates it ([`Doorbell::create`]), keeps it open for reading and writing
+//!   (`O_RDWR | O_NONBLOCK`: it never sees end of file because it is its own writer) and sleeps
+//!   in `poll(2)` on it, together with whatever else it waits for.
+//! * Anyone else rings it ([`ring`]): open for writing without blocking, write one short line,
+//!   close. With no owner listening the open fails with `ENXIO`, which is "nobody to tell", not an
+//!   error. A line is at most `PIPE_BUF` bytes (512 on macOS), so lines from several ringers never
+//!   interleave.
+//! * Which one is told what is in the line; the line is a hint ("someone arrived", "re-read the
+//!   file"), never the truth. The truth stays in the file the doorbell sits beside, so a lost or
+//!   full doorbell loses a wake-up, not a fact.
+//!
+//! Why a FIFO and not a Unix datagram socket: a socket path may be at most 104 bytes on macOS and
+//! 108 on Linux, and an app's data folder is often longer; a FIFO path has no such limit. The
+//! FIFO is created owner-only (`0600`) and a ringer checks, on the descriptor it opened, that it
+//! is a FIFO owned by this user before writing, so a path swapped for something else is not
+//! written to. Writing to a FIFO whose reader just went away raises `SIGPIPE`; Rust programs
+//! ignore it, and a host that does not (a non-Rust process loading this as a library) must.
+//!
+//! A [`StopSender`] / [`StopReceiver`] pair is the matching way to stop a sleeper: dropping the
+//! sender makes the receiver's descriptor readable, so a thread asleep in `poll(2)` wakes and
+//! leaves.
+//!
+//! # Windows
+//!
+//! `imp` for Windows is a stub; every constructor answers `Unsupported`. The Windows session
+//! implements the same five items with a named auto-reset event: the owner creates it
+//! (`CreateEventW`, name `Local\rightkit-bell-<hash of the canonical path>`) and waits on it with
+//! `WaitForMultipleObjects` together with a stop event and whatever else the caller waits on;
+//! `ring` opens it (`OpenEventW(EVENT_MODIFY_STATE)`) and calls `SetEvent`. An event carries no
+//! message, so `ring` first appends the line to `<path>.msg` (open, append, close) and the owner's
+//! `drain` reads and truncates that file. The wake-up is then the event, the facts are the lines.
+
+/// Why a sleeper on a bell woke.
+#[derive(Debug)]
+#[cfg_attr(windows, allow(dead_code))] // only the Unix `imp` builds these
+pub(crate) enum BellWake {
+    /// Bytes arrived (possibly none, when another reader of the same bell took them first).
+    Message(Vec<u8>),
+    /// The stop signal fired.
+    Stopped,
+    /// The timeout passed.
+    TimedOut,
+}
+
+pub(crate) use imp::{ring, stop_pair, BellReader, Doorbell, StopReceiver, StopSender};
+
+#[cfg(unix)]
+mod imp {
+    use super::BellWake;
+    use crate::exit_watch::poll_readable;
+    use std::{
+        ffi::CString,
+        fs::{self, File, OpenOptions},
+        io::{self, Read, Write},
+        os::{
+            fd::{AsRawFd, RawFd},
+            unix::{
+                ffi::OsStrExt,
+                fs::{FileTypeExt, MetadataExt, OpenOptionsExt},
+                net::UnixStream,
+            },
+        },
+        path::{Path, PathBuf},
+        time::Duration,
+    };
+
+    /// The most one drain takes. Anything beyond is left for the next wake-up.
+    const DRAIN_LIMIT: usize = 64 * 1024;
+
+    /// The reading end of a doorbell. Clones share one descriptor description, so a message is
+    /// taken by exactly one of them.
+    #[derive(Debug)]
+    pub(crate) struct BellReader {
+        file: File,
+    }
+
+    impl BellReader {
+        pub(crate) fn try_clone(&self) -> io::Result<BellReader> {
+            Ok(BellReader {
+                file: self.file.try_clone()?,
+            })
+        }
+
+        pub(crate) fn raw_fd(&self) -> RawFd {
+            self.file.as_raw_fd()
+        }
+
+        /// Everything queued right now, without waiting.
+        pub(crate) fn drain(&self) -> io::Result<Vec<u8>> {
+            let mut out = Vec::new();
+            let mut chunk = [0u8; 512];
+            let mut reader = &self.file;
+            while out.len() < DRAIN_LIMIT {
+                match reader.read(&mut chunk) {
+                    Ok(0) => break,
+                    Ok(count) => out.extend_from_slice(&chunk[..count]),
+                    Err(error) if error.kind() == io::ErrorKind::WouldBlock => break,
+                    Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+                    Err(error) => return Err(error),
+                }
+            }
+            Ok(out)
+        }
+
+        /// Sleeps in `poll(2)` until bytes arrive or `timeout` passes (`None`: no limit); returns
+        /// what arrived, empty on a timeout.
+        pub(crate) fn wait(&self, timeout: Option<Duration>) -> io::Result<Vec<u8>> {
+            let ready = poll_readable(&[self.raw_fd()], timeout)?;
+            if ready[0] {
+                self.drain()
+            } else {
+                Ok(Vec::new())
+            }
+        }
+
+        /// [`wait`](Self::wait) that also ends when `stop` fires. The stop signal wins when both
+        /// are ready.
+        pub(crate) fn wait_or_stop(
+            &self,
+            stop: &StopReceiver,
+            timeout: Option<Duration>,
+        ) -> io::Result<BellWake> {
+            let ready = poll_readable(&[stop.raw_fd(), self.raw_fd()], timeout)?;
+            if ready[0] {
+                return Ok(BellWake::Stopped);
+            }
+            if ready[1] {
+                return Ok(BellWake::Message(self.drain()?));
+            }
+            Ok(BellWake::TimedOut)
+        }
+    }
+
+    /// The FIFO and its owner. Dropping it removes the FIFO (only if the path still names this
+    /// one: a successor that replaced it keeps its own).
+    #[derive(Debug)]
+    pub(crate) struct Doorbell {
+        reader: BellReader,
+        path: PathBuf,
+        id: (u64, u64),
+    }
+
+    impl Doorbell {
+        /// Creates the FIFO at `path` and opens it for listening. A stale FIFO there (its owner
+        /// died; the kernel closed its descriptor) is replaced. With `take_over` false a FIFO
+        /// that somebody still listens on is not replaced: `AddrInUse`.
+        pub(crate) fn create(path: &Path, take_over: bool) -> io::Result<Doorbell> {
+            if !take_over && open_writer(path)?.is_some() {
+                return Err(io::Error::new(
+                    io::ErrorKind::AddrInUse,
+                    "another process is already listening at this doorbell",
+                ));
+            }
+            match fs::remove_file(path) {
+                Ok(()) => {}
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                Err(error) => return Err(error),
+            }
+            let c_path = CString::new(path.as_os_str().as_bytes()).map_err(|_| {
+                io::Error::new(io::ErrorKind::InvalidInput, "the path contains a NUL byte")
+            })?;
+            // SAFETY: `c_path` is a valid NUL-terminated string that outlives the call.
+            if unsafe { libc::mkfifo(c_path.as_ptr(), 0o600) } != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            let file = OpenOptions::new()
+                .read(true)
+                .write(true)
+                .custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW)
+                .open(path)?;
+            let meta = file.metadata()?;
+            if !is_our_fifo(&meta) {
+                let _ = fs::remove_file(path);
+                return Err(io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "the doorbell is not a FIFO owned by this user",
+                ));
+            }
+            Ok(Doorbell {
+                reader: BellReader { file },
+                path: path.to_path_buf(),
+                id: (meta.dev(), meta.ino()),
+            })
+        }
+
+        pub(crate) fn reader(&self) -> &BellReader {
+            &self.reader
+        }
+    }
+
+    impl Drop for Doorbell {
+        fn drop(&mut self) {
+            if let Ok(meta) = fs::symlink_metadata(&self.path) {
+                if (meta.dev(), meta.ino()) == self.id {
+                    let _ = fs::remove_file(&self.path);
+                }
+            }
+        }
+    }
+
+    fn is_our_fifo(meta: &fs::Metadata) -> bool {
+        // SAFETY: geteuid takes no arguments and cannot fail.
+        meta.file_type().is_fifo() && meta.uid() == unsafe { libc::geteuid() }
+    }
+
+    /// Opens the FIFO for writing without blocking. `None` when there is nothing to ring: no
+    /// such path, or nobody listening (`ENXIO`).
+    fn open_writer(path: &Path) -> io::Result<Option<File>> {
+        match OpenOptions::new()
+            .write(true)
+            .custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW)
+            .open(path)
+        {
+            Ok(file) => Ok(Some(file)),
+            Err(error)
+                if matches!(error.raw_os_error(), Some(libc::ENXIO) | Some(libc::ENOENT)) =>
+            {
+                Ok(None)
+            }
+            Err(error) => Err(error),
+        }
+    }
+
+    /// Writes `message` (at most 512 bytes) to the doorbell at `path`. `Ok(true)`: it was
+    /// queued. `Ok(false)`: nobody is listening, or the queue is full; either way nothing is lost
+    /// that a re-read of the file would not find. `Err` for a path that is not our FIFO.
+    pub(crate) fn ring(path: &Path, message: &[u8]) -> io::Result<bool> {
+        let Some(mut file) = open_writer(path)? else {
+            return Ok(false);
+        };
+        if !is_our_fifo(&file.metadata()?) {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "the doorbell is not a FIFO owned by this user",
+            ));
+        }
+        match file.write_all(message) {
+            Ok(()) => Ok(true),
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    io::ErrorKind::WouldBlock | io::ErrorKind::BrokenPipe
+                ) =>
+            {
+                Ok(false)
+            }
+            Err(error) => Err(error),
+        }
+    }
+
+    /// The end that stops a sleeper by being dropped.
+    #[derive(Debug)]
+    pub(crate) struct StopSender {
+        _end: UnixStream,
+    }
+
+    impl StopSender {
+        /// Keeps the stop signal from ever firing: the descriptor stays open for the life of the
+        /// process.
+        pub(crate) fn leak(self) {
+            std::mem::forget(self);
+        }
+    }
+
+    /// The end a sleeper polls.
+    #[derive(Debug)]
+    pub(crate) struct StopReceiver {
+        end: UnixStream,
+    }
+
+    impl StopReceiver {
+        pub(crate) fn raw_fd(&self) -> RawFd {
+            self.end.as_raw_fd()
+        }
+    }
+
+    pub(crate) fn stop_pair() -> io::Result<(StopSender, StopReceiver)> {
+        let (sender, receiver) = UnixStream::pair()?;
+        Ok((StopSender { _end: sender }, StopReceiver { end: receiver }))
+    }
+}
+
+#[cfg(windows)]
+mod imp {
+    use super::BellWake;
+    use std::{io, path::Path, time::Duration};
+
+    fn unsupported<T>() -> io::Result<T> {
+        Err(io::Error::from(io::ErrorKind::Unsupported))
+    }
+

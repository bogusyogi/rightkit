diff --git a/crates/rightkit-process/src/adopted.rs b/crates/rightkit-process/src/adopted.rs
new file mode 100644
index 00000000..6bb074ae
--- /dev/null
+++ b/crates/rightkit-process/src/adopted.rs
@@ -0,0 +1,600 @@
+//! Identity-checked adoption and bounded termination of a process this program did not spawn.
+//!
+//! The leftover is the case: an app that started an engine (or a model server, or a renderer) was
+//! killed or crashed, and the engine, re-parented to init, outlived it. On its next start the app
+//! must find that engine and stop it, and it must be *sure* the process it stops is the engine.
+//! The number it remembered may name something else by now.
+//!
+//! * [`ProcessIdentity::of_child`] records who the engine is when it is spawned (pid, start time,
+//!   executable). The app stores the text form with its own state.
+//! * [`AdoptedProcess::adopt_checked`] proves the stored identity against the kernel. The answer
+//!   is a typed [`AdoptError`] unless it is the same process: `Gone`, `Replaced` (the pid is
+//!   alive with another start time), `ExecutableMismatch` (same start time, another program) or
+//!   `Unverifiable` (this host cannot describe processes, or this one; never read as a match).
+//! * [`AdoptedProcess::stop_tree`] stops it, bounded, and reports what it did. It proves the
+//!   identity again before **every** signal (the rule is the one in `identity`, through
+//!   `process_identity::verify_parts`; there is no second copy of it), so a process that exited
+//!   between two steps and whose number was reused is never signalled.
+//!
+//! # What "tree" means
+//!
+//! An adopted process has no job and no handle, only a pid. The tree this stops is the **process
+//! group the process leads** (`getpgid(pid) == pid`), which is what `OwnedCommand` creates for
+//! every child (`UnixContainment::ProcessGroup`, or a session leader with `Session`): the engine,
+//! its helpers and anything they started without leaving the group. A process that does not lead
+//! its own group is stopped alone and the report says `StopScope::Process`; its group is never
+//! signalled, because it may hold processes that are not the engine's. The group of a process
+//! that is *this* process's own group is refused.
+//!
+//! A group id cannot be reused while any member lives, so a group signal that follows a proof of
+//! the leader cannot reach a stranger, and when the leader exits mid-stop the surviving members
+//! still pin the id and are still reached (the leader's death does not end the stop, as it would
+//! if the stop only knew the leader). The one residual is the same as `identity`'s: the
+//! microseconds between a proof and the signal, and it needs a full pid wrap in that window.
+//!
+//! # Steps and bounds
+//!
+//! 1. Open the exit event for the leader, then prove the identity (so the proof names the process
+//!    the event is bound to). Gone or replaced: nothing is signalled.
+//! 2. Prove again, send `SIGTERM` (to the group, or to the process alone), then sleep in `poll(2)`
+//!    on the leader's exit event and one event per remaining group member, for at most
+//!    [`StopOptions::grace`]. No timer.
+//! 3. If anything is left: prove again, send `SIGKILL`, and wait the same way for at most
+//!    [`StopOptions::kill_wait`].
+//! 4. Report: [`StopReport`] says which signals were sent, to what scope, and what survived.
+//!
+//! A host with no exit event for a process (a sandbox that forbids `pidfd_open`) cannot sleep on
+//! the exit: it sleeps out the bound once, and then looks (`owned::wait_out`, the same fallback
+//! `OwnedChild::terminate_tree` uses), so the stop is still bounded.
+//!
+//! # Windows
+//!
+//! [`stop_tree`](AdoptedProcess::stop_tree) answers `Unsupported` there, and
+//! [`adopt_checked`](AdoptedProcess::adopt_checked) answers `Unverifiable` with kind
+//! `Unsupported` (see `observe`). What the Windows session implements: after the identity is
+//! proven on a *handle* (`OpenProcess(PROCESS_TERMINATE | PROCESS_QUERY_LIMITED_INFORMATION |
+//! SYNCHRONIZE)`, compare `GetProcessTimes` creation time with the stored start time, compare
+//! `QueryFullProcessImageNameW`), the handle pins the process, so there is no recycling window
+//! left to guard and no re-proof is needed per signal. A Windows process has no group; the tree
+//! is the process plus its descendants found with a Toolhelp snapshot (`th32ParentProcessID`,
+//! each descendant created after its parent), terminated with `TerminateProcess`, waiting with
+//! `WaitForMultipleObjects` on the handles. `StopOptions::grace` has no `SIGTERM` to cover on
+//! Windows; the app sends its own graceful request first, as `OwnedChild::wait_or_kill`
+//! documents.
+
+#[cfg(unix)]
+use crate::process_identity::verify_parts;
+use crate::{
+    owned::AdoptedProcess,
+    process_identity::{verify, AdoptError, ProcessIdentity, StartTime},
+};
+use std::{io, num::NonZeroU32, time::Duration};
+
+/// Bounds of a [`stop_tree`](AdoptedProcess::stop_tree).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StopOptions {
+    /// How long the tree has to leave after `SIGTERM` before `SIGKILL`. Default 5 seconds.
+    pub grace: Duration,
+    /// How long to wait for the tree to be gone after `SIGKILL`. Default 5 seconds.
+    pub kill_wait: Duration,
+}
+
+impl Default for StopOptions {
+    fn default() -> Self {
+        Self {
+            grace: Duration::from_secs(5),
+            kill_wait: Duration::from_secs(5),
+        }
+    }
+}
+
+impl StopOptions {
+    pub fn with_grace(mut self, grace: Duration) -> Self {
+        self.grace = grace;
+        self
+    }
+
+    pub fn with_kill_wait(mut self, kill_wait: Duration) -> Self {
+        self.kill_wait = kill_wait;
+        self
+    }
+}
+
+/// What a stop signalled.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StopScope {
+    /// The process group the adopted process leads.
+    Group,
+    /// The adopted process alone: it does not lead its own group.
+    Process,
+}
+
+/// How a stop ended.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum StopOutcome {
+    /// There was nothing to stop: the process was gone before any signal.
+    NotRunning,
+    /// The pid names another process than the adopted one. Nothing was signalled.
+    Replaced,
+    /// The adoption carries no identity (it was made with [`AdoptedProcess::new`]). Nothing was
+    /// signalled.
+    NotVerified,
+    /// Everything that was signalled is gone.
+    Stopped,
+    /// These pids were still alive after the last wait (after `SIGKILL`, if it was sent). The
+    /// leader if it survived, and the group members that could be listed.
+    Survivors(Vec<u32>),
+}
+
+/// What [`AdoptedProcess::stop_tree`] did.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct StopReport {
+    pub scope: StopScope,
+    /// A `SIGTERM` was delivered.
+    pub term_sent: bool,
+    /// A `SIGKILL` was delivered (the tree outlived the grace).
+    pub kill_sent: bool,
+    pub outcome: StopOutcome,
+}
+
+impl StopReport {
+    fn nothing(outcome: StopOutcome) -> Self {
+        Self {
+            scope: StopScope::Process,
+            term_sent: false,
+            kill_sent: false,
+            outcome,
+        }
+    }
+}
+
+impl AdoptedProcess {
+    /// Adopts the process `identity` names, after proving it is still that process.
+    ///
+    /// Only the same process, running or exited and awaiting its parent's reap, is adopted. An
+    /// exited leader can still be stopped (its group may have survivors). Pids 0 and 1 are never
+    /// adopted.
+    pub fn adopt_checked(identity: &ProcessIdentity) -> Result<AdoptedProcess, AdoptError> {
+        let Some(pid) = NonZeroU32::new(identity.pid).filter(|pid| pid.get() > 1) else {
+            return Err(AdoptError::Unverifiable {
+                kind: io::ErrorKind::InvalidInput,
+                reason: "pids 0 and 1 are never adopted".to_string(),
+            });
+        };
+        verify(identity)?;
+        Ok(AdoptedProcess {
+            pid,
+            verified: Some(identity.started),
+        })
+    }
+
+    /// The start time this adoption was proven against; `None` for an adoption made with
+    /// [`AdoptedProcess::new`], which proved nothing and cannot be stopped.
+    pub fn verified_start(&self) -> Option<StartTime> {
+        self.verified
+    }
+
+    /// Stops the process and its tree, bounded, proving its identity before every signal. See the
+    /// module documentation for what the tree is and for the steps. `Err` for an I/O failure
+    /// (a signal the kernel refused: the process belongs to another user), for the current
+    /// process, and for a group this process is a member of.
+    pub fn stop_tree(&self, options: StopOptions) -> io::Result<StopReport> {
+        let Some(start) = self.verified else {
+            return Ok(StopReport::nothing(StopOutcome::NotVerified));
+        };
+        stop::run(self.pid, start, options)
+    }
+}
+
+#[cfg(unix)]
+mod stop {
+    use super::{
+        verify_parts, AdoptError, StartTime, StopOptions, StopOutcome, StopReport, StopScope,
+    };
+    use crate::{
+        exit_watch::ExitWatch,
+        identity,
+        owned::wait_out,
+        unix_child::{group_members_besides, Members},
+    };
+    use std::{
+        io,
+        num::NonZeroU32,
+        time::{Duration, Instant},
+    };
+
+    #[derive(Clone, Copy)]
+    enum Signal {
+        Term,
+        Kill,
+    }
+
+    impl Signal {
+        fn number(self) -> libc::c_int {
+            match self {
+                Signal::Term => libc::SIGTERM,
+                Signal::Kill => libc::SIGKILL,
+            }
+        }
+    }
+
+    /// The leader, as the proof finds it.
+    #[derive(Clone, Copy, PartialEq, Eq)]
+    enum Standing {
+        Running,
+        /// Exited, not yet reaped by its parent: the same process, still pinning its pid.
+        Exited,
+        Gone,
+        Replaced,
+    }
+
+    enum Sent {
+        Delivered,
+        /// There was nothing to deliver to.
+        Nothing,
+    }
+
+    pub(super) fn run(
+        pid: NonZeroU32,
+        start: StartTime,
+        options: StopOptions,
+    ) -> io::Result<StopReport> {
+        let pid = pid.get();
+        if pid == std::process::id() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "a process cannot stop itself through an adoption",
+            ));
+        }
+        // The event is opened before the proof, so the proof names the process it is bound to.
+        let watch = ExitWatch::open(pid, false);
+        let scope = match standing(pid, &start)? {
+            Standing::Gone => return Ok(StopReport::nothing(StopOutcome::NotRunning)),
+            Standing::Replaced => return Ok(StopReport::nothing(StopOutcome::Replaced)),
+            // An exited leader pins its pid, and with it the group id it led.
+            Standing::Exited => StopScope::Group,
+            Standing::Running => match scope_of(pid)? {
+                Some(scope) => scope,
+                // It exited while its group was being asked for. If it is a zombie now, the
+                // group it led may live on.
+                None => match standing(pid, &start)? {
+                    Standing::Exited => StopScope::Group,
+                    Standing::Replaced => return Ok(StopReport::nothing(StopOutcome::Replaced)),
+                    Standing::Running | Standing::Gone => {
+                        return Ok(StopReport::nothing(StopOutcome::NotRunning))
+                    }
+                },
+            },
+        };
+        let mut report = StopReport {
+            scope,
+            term_sent: false,
+            kill_sent: false,
+            outcome: StopOutcome::NotRunning,
+        };
+        match send(&watch, pid, &start, scope, Signal::Term)? {
+            Sent::Delivered => report.term_sent = true,
+            Sent::Nothing => return Ok(report),
+        }
+        if !await_tree(&watch, pid, &start, scope, options.grace)? {
+            if let Sent::Delivered = send(&watch, pid, &start, scope, Signal::Kill)? {
+                report.kill_sent = true;
+            }
+            await_tree(&watch, pid, &start, scope, options.kill_wait)?;
+        }
+        let left = survivors(pid, &start, scope);
+        report.outcome = if left.is_empty() {
+            StopOutcome::Stopped
+        } else {
+            StopOutcome::Survivors(left)
+        };
+        Ok(report)
+    }
+
+    /// The proof: what `pid` is now, against the recorded start time.
+    fn standing(pid: u32, start: &StartTime) -> io::Result<Standing> {
+        match verify_parts(pid, start, None) {
+            Ok(verified) if verified.zombie => Ok(Standing::Exited),
+            Ok(_) => Ok(Standing::Running),
+            Err(AdoptError::Gone) => Ok(Standing::Gone),
+            Err(AdoptError::Replaced { .. }) => Ok(Standing::Replaced),
+            Err(other) => Err(other.into()),
+        }
+    }
+
+    fn to_pid(pid: u32) -> io::Result<libc::pid_t> {
+        libc::pid_t::try_from(pid)
+            .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "pid out of range"))
+    }
+
+    /// `Group` when the process leads its own group, `Process` otherwise; `None` when the process
+    /// vanished while asking.
+    fn scope_of(pid: u32) -> io::Result<Option<StopScope>> {
+        let id = to_pid(pid)?;
+        // SAFETY: getpgid reads a process attribute and touches no memory.
+        let group = unsafe { libc::getpgid(id) };
+        if group < 0 {
+            let error = io::Error::last_os_error();
+            return if error.raw_os_error() == Some(libc::ESRCH) {
+                Ok(None)
+            } else {
+                Err(error)
+            };
+        }
+        if group != id {
+            return Ok(Some(StopScope::Process));
+        }
+        // SAFETY: getpgrp takes no arguments and cannot fail.
+        if unsafe { libc::getpgrp() } == group {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "the adopted process leads the group this process is in; stopping it would stop this process",
+            ));
+        }
+        Ok(Some(StopScope::Group))
+    }
+
+    /// Reads the return value of `kill(2)` straight after the call, while `errno` is still the
+    /// call's: `ESRCH` is "nothing there to deliver to"; anything else is the kernel's refusal.
+    fn kill_outcome(returned: libc::c_int) -> io::Result<Sent> {
+        if returned == 0 {
+            return Ok(Sent::Delivered);
+        }
+        let error = io::Error::last_os_error();
+        match error.raw_os_error() {
+            Some(libc::ESRCH) => Ok(Sent::Nothing),
+            _ => Err(error),
+        }
+    }
+
+    /// Proves the identity, then delivers one signal. The proof is the last step before the
+    /// system call.
+    fn send(
+        watch: &ExitWatch,
+        pid: u32,
+        start: &StartTime,
+        scope: StopScope,
+        signal: Signal,
+    ) -> io::Result<Sent> {
+        let leader = standing(pid, start)?;
+        let number = signal.number();
+        let id = to_pid(pid)?;
+        match scope {
+            StopScope::Process => {
+                if leader != Standing::Running {
+                    return Ok(Sent::Nothing);
+                }
+                // Linux: through the pidfd, so no pid number is involved at all.
+                if let Some(result) = watch.send_signal(number) {
+                    return match result {
+                        Ok(()) => Ok(Sent::Delivered),
+                        Err(error) if error.raw_os_error() == Some(libc::ESRCH) => {
+                            Ok(Sent::Nothing)
+                        }
+                        Err(error) => Err(error),
+                    };
+                }
+                // SAFETY: plain kill(2) on a pid proven just above.
+                kill_outcome(unsafe { libc::kill(id, number) })
+            }
+            StopScope::Group => {
+                if !matches!(leader, Standing::Running | Standing::Exited) {
+                    // The leader is gone or replaced. The group is still the adopted one exactly
+                    // while members keep its id pinned, so look for them.
+                    match group_members_besides(pid, pid, None)? {
+                        Members::Pids(pids) if !pids.is_empty() => {}
+                        Members::Pids(_) => return Ok(Sent::Nothing),
+                        Members::Unknown => {
+                            return Err(io::Error::new(
+                                io::ErrorKind::Unsupported,
+                                "the group of a departed leader cannot be listed here, so it cannot be proven to be the adopted one",
+                            ))
+                        }
+                    }
+                }
+                // SAFETY: plain kill(2) on a group whose id is pinned by its leader (running or
+                // exited and unreaped) or by the members just listed.
+                let outcome = kill_outcome(unsafe { libc::kill(-id, number) });
+                match outcome {
+                    // macOS answers a group signal with EPERM, not ESRCH, when only zombies are
+                    // left. With the leader no longer running that is "nothing to deliver to".
+                    Err(error)
+                        if error.raw_os_error() == Some(libc::EPERM)
+                            && leader != Standing::Running =>
+                    {
+                        Ok(Sent::Nothing)
+                    }
+                    other => other,
+                }
+            }
+        }
+    }
+
+    /// Waits, for at most `timeout`, until the leader has exited and every other member of the
+    /// group has too. `true` when the tree is gone.
+    ///
+    /// Event-driven, like `OwnedChild`'s own grace: the leader through its exit watch, each
+    /// remaining member through a watch of its own, all in one `poll(2)`. A member that is a
+    /// zombie its own parent has not reaped stays listed, and its watch fires at once. A group
+    /// that cannot be listed, or a member that cannot be watched, is waited out for the rest of
+    /// the bound in one timed sleep and then looked at once.
+    fn await_tree(
+        watch: &ExitWatch,
+        pid: u32,
+        start: &StartTime,
+        scope: StopScope,
+        timeout: Duration,
+    ) -> io::Result<bool> {
+        let Some(deadline) = Instant::now().checked_add(timeout) else {
+            return Ok(false);
+        };
+        let left = || deadline.saturating_duration_since(Instant::now());
+        match watch.wait(Some(left())) {
+            Ok(true) => {}
+            Ok(false) => return Ok(false),
+            Err(error) if error.kind() == io::ErrorKind::Unsupported => {
+                wait_out(left())?;
+                return Ok(nothing_runs(pid, start, scope));
+            }
+            Err(error) => return Err(error),
+        }
+        if scope == StopScope::Process {
+            return Ok(true);
+        }
+        let mut gone: Vec<u32> = Vec::new();
+        loop {
+            let pids: Vec<u32> = match group_members_besides(pid, pid, None)? {
+                Members::Pids(pids) => pids.into_iter().filter(|p| !gone.contains(p)).collect(),
+                Members::Unknown => {
+                    wait_out(left())?;
+                    return Ok(nothing_runs(pid, start, scope));
+                }
+            };
+            if pids.is_empty() {
+                return Ok(true);
+            }
+            let watches: Vec<ExitWatch> = pids
+                .iter()
+                .map(|&member| ExitWatch::open(member, false))
+                .collect();
+            if !watches.iter().all(ExitWatch::is_supported) {
+                wait_out(left())?;
+                return Ok(nothing_runs(pid, start, scope));
+            }
+            if !ExitWatch::wait_all(&watches, left())? {
+                return Ok(false);
+            }
+            gone.extend(pids);
+        }
+    }
+
+    /// Whether neither the leader nor any listed group member runs. A group that cannot be listed
+    /// counts as still running.
+    fn nothing_runs(pid: u32, start: &StartTime, scope: StopScope) -> bool {
+        survivors_known(pid, start, scope).is_some_and(|left| left.is_empty())
+    }
+
+    /// Whether `pid` is a process that runs (not a zombie, not gone).
+    fn running(pid: u32) -> bool {
+        matches!(
+            identity::describe_state(pid),
+            Ok(Some(described)) if !described.zombie
+        )
+    }
+
+    /// What runs: the leader if it is the adopted process and runs, and the listed group members
+    /// that run. `None` when a group cannot be listed.
+    fn survivors_known(pid: u32, start: &StartTime, scope: StopScope) -> Option<Vec<u32>> {
+        let mut left = Vec::new();
+        if matches!(standing(pid, start), Ok(Standing::Running)) {
+            left.push(pid);
+        }
+        if scope == StopScope::Group {
+            match group_members_besides(pid, pid, None) {
+                Ok(Members::Pids(pids)) => {
+                    left.extend(pids.into_iter().filter(|&member| running(member)))
+                }
+                _ => return None,
+            }
+        }
+        Some(left)
+    }
+
+    /// What is still alive when the stop ends, as far as it can be listed.
+    fn survivors(pid: u32, start: &StartTime, scope: StopScope) -> Vec<u32> {
+        survivors_known(pid, start, scope).unwrap_or_else(|| {
+            if matches!(standing(pid, start), Ok(Standing::Running)) {
+                vec![pid]
+            } else {
+                Vec::new()
+            }
+        })
+    }
+}
+
+#[cfg(windows)]
+mod stop {
+    use super::{StartTime, StopOptions, StopReport};
+    use std::{io, num::NonZeroU32};
+
+    /// WINDOWS SESSION: implement per the module documentation. Nothing is signalled until then.
+    pub(super) fn run(
+        _pid: NonZeroU32,
+        _start: StartTime,
+        _options: StopOptions,
+    ) -> io::Result<StopReport> {
+        Err(io::Error::from(io::ErrorKind::Unsupported))
+    }
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use std::process::{Child, Command, Stdio};
+
+    fn sleeper() -> Child {
+        Command::new("/bin/sleep")
+            .arg("600")
+            .stdin(Stdio::null())
+            .spawn()
+            .expect("spawn")
+    }
+
+    /// A start time that no live process has on this host: it stands in for the time at which the
+    /// process we recorded started, once the kernel has given its pid to another process.
+    fn some_other_start() -> StartTime {
+        #[cfg(target_os = "macos")]
+        {
+            StartTime::macos(1, 0)
+        }
+        #[cfg(not(target_os = "macos"))]
+        {
+            StartTime::linux(0, 1)
+        }
+    }
+
+    fn end(mut child: Child) {
+        let _ = child.kill();
+        let _ = child.wait();
+    }
+
+    #[test]
+    fn a_pid_that_now_names_another_process_is_never_signalled() {
+        let mut stranger = sleeper();
+        let stale = AdoptedProcess {
+            pid: NonZeroU32::new(stranger.id()).expect("pid"),
+            verified: Some(some_other_start()),
+        };
+        let report = stale.stop_tree(StopOptions::default()).expect("stop");
+        assert_eq!(report.outcome, StopOutcome::Replaced);
+        assert!(!report.term_sent && !report.kill_sent);
+        assert!(
+            stranger.try_wait().expect("try_wait").is_none(),
+            "the stranger kept running"
+        );
+        end(stranger);
+    }
+
+    #[test]
+    fn the_current_process_is_never_stopped() {
+        let me = ProcessIdentity::of_current().expect("identity");
+        let adopted = AdoptedProcess::adopt_checked(&me).expect("adopt");
+        let error = adopt_stop(&adopted).expect_err("refused");
+        assert_eq!(error.kind(), io::ErrorKind::InvalidInput);
+    }
+
+    fn adopt_stop(adopted: &AdoptedProcess) -> io::Result<StopReport> {
+        adopted.stop_tree(StopOptions::default())
+    }
+
+    #[test]
+    fn an_adoption_without_an_identity_stops_nothing() {
+        let child = sleeper();
+        let adopted = AdoptedProcess::new(NonZeroU32::new(child.id()).expect("pid"));
+        let report = adopt_stop(&adopted).expect("stop");
+        assert_eq!(report.outcome, StopOutcome::NotVerified);
+        assert!(adopted.is_running().expect("is_running"));
+        end(child);
+    }
+}

+#![cfg(all(unix, any(target_os = "linux", target_os = "macos")))]
+
+//! The machine-wide lock against real processes and real descriptors: an OS lock that the kernel
+//! releases when the holder is killed, a record that never grants ownership, a waiter that blocks
+//! in the lock call and is woken by the holder letting go, and a holder that hears a waiter arrive.
+
+use rightkit_process::{
+    AdoptError, HolderState, LockState, MachineLock, MachineLockError, MachineLockOptions,
+    ProcessIdentity,
+};
+use std::{
+    collections::BTreeMap,
+    fs,
+    io::{BufRead, BufReader},
+    os::unix::fs::{DirBuilderExt, PermissionsExt},
+    path::{Path, PathBuf},
+    process::{Command, Stdio},
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        mpsc,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+const ROLE_DIR_ENV: &str = "RIGHTKIT_MACHINE_LOCK_TEST_DIR";
+const HELD_MARKER: &str = "MACHINE_LOCK_HELD";
+
+/// A fresh owner-only directory, removed when dropped.
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(label: &str) -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let path = std::env::temp_dir().join(format!(
+            "rk-machine-lock-{label}-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::DirBuilder::new()
+            .mode(0o700)
+            .create(&path)
+            .expect("create the scratch directory");
+        Scratch(path)
+    }
+
+    fn path(&self) -> &Path {
+        &self.0
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Kills and reaps the child when dropped, so a failing assertion leaves no process behind.
+struct KillOnDrop(std::process::Child);
+
+impl Drop for KillOnDrop {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+fn options() -> MachineLockOptions {
+    MachineLockOptions::default()
+}
+
+fn wait_for(timeout: Duration) -> MachineLockOptions {
+    options().with_timeout(timeout)
+}
+
+/// The re-exec entry point: this test binary run with `ROLE_DIR_ENV` set takes the lock `role`
+/// in that directory, says so, and holds it until it is killed. Without the variable it returns
+/// at once, so a normal run is unaffected.
+#[test]
+fn holder_role() {
+    let Some(dir) = std::env::var_os(ROLE_DIR_ENV) else {
+        return;
+    };
+    let lock = MachineLock::acquire(
+        "role",
+        Path::new(&dir),
+        options().with_detail("who", "the role process"),
+    )
+    .expect("the role takes the lock");
+    println!("{HELD_MARKER}");
+    let _lock = lock;
+    loop {
+        thread::park();
+    }
+}
+
+#[test]
+fn acquire_writes_a_record_and_drop_removes_it() {
+    let scratch = Scratch::new("record");
+    let dir = scratch.path();
+    let lock = MachineLock::acquire(
+        "gpu",
+        dir,
+        options()
+            .with_state(HolderState::Idle)
+            .with_detail("model", "qwen21")
+            .with_detail("port", "8123"),
+    )
+    .expect("acquire");
+
+    let me = ProcessIdentity::of_current().expect("identity");
+    let record = lock.record();
+    assert_eq!(record.holder, me);
+    assert_eq!(record.state, HolderState::Idle);
+    assert_eq!(
+        record.details.get("model").map(String::as_str),
+        Some("qwen21")
+    );
+    assert!(record.waiters.is_empty());
+    assert_eq!(record.holder_status(), Ok(true));
+    assert!(lock.took_over().is_none());
+
+    let on_disk = fs::read_to_string(dir.join("gpu.holder.json")).expect("record file");
+    assert!(on_disk.contains("\"model\":\"qwen21\""), "{on_disk}");
+    assert!(
+        !on_disk.contains("waiters"),
+        "waiters are not stored: {on_disk}"
+    );
+    let mode = fs::metadata(dir.join("gpu.holder.json"))
+        .expect("stat")
+        .permissions()
+        .mode();
+    assert_eq!(mode & 0o077, 0, "owner-only: {mode:o}");
+
+    match MachineLock::peek("gpu", dir) {
+        Ok(LockState::Held { record: Some(seen) }) => assert_eq!(seen.holder, me),
+        other => panic!("expected Held with a record, got {other:?}"),
+    }
+    drop(lock);
+    assert!(
+        !dir.join("gpu.holder.json").exists(),
+        "the record is removed"
+    );
+    assert!(!dir.join("gpu.bell").exists(), "the doorbell is removed");
+    assert!(matches!(MachineLock::peek("gpu", dir), Ok(LockState::Free)));
+}
+
+#[test]
+fn a_second_acquire_times_out_with_busy_carrying_the_holders_record() {
+    let scratch = Scratch::new("busy");
+    let dir = scratch.path();
+    let _holder =
+        MachineLock::acquire("sd", dir, options().with_detail("model", "qwen21")).expect("acquire");
+
+    // Zero timeout: one try.
+    let error = MachineLock::acquire("sd", dir, options()).expect_err("held");
+    assert!(error.busy().is_some(), "{error}");
+
+    let wait = Duration::from_millis(300);
+    let started = Instant::now();
+    let error = MachineLock::acquire("sd", dir, wait_for(wait)).expect_err("held");
+    let busy = error.busy().expect("Busy");
+    assert!(started.elapsed() >= wait, "waited the whole timeout");
+    assert!(busy.waited >= wait);
+    assert_eq!(busy.name, "sd");
+    let seen = busy.holder.as_ref().expect("the holder's record");
+    assert_eq!(
+        seen.details.get("model").map(String::as_str),
+        Some("qwen21")
+    );
+    assert_eq!(seen.holder_status(), Ok(true));
+    assert!(
+        seen.waiters.is_empty(),
+        "the refused caller is not a waiter any more"
+    );
+    assert!(error.to_string().contains("qwen21"), "{error}");
+}
+
+#[test]
+fn a_waiter_blocks_in_the_lock_and_is_woken_when_the_holder_lets_go() {
+    let scratch = Scratch::new("wake");
+    let dir = scratch.path().to_path_buf();
+    let holder =
+        MachineLock::acquire("sd", &dir, options().with_state(HolderState::Idle)).expect("acquire");
+    let events = holder.waiter_events().expect("events");
+
+    let waiter = thread::spawn({
+        let dir = dir.clone();
+        move || MachineLock::acquire("sd", &dir, wait_for(Duration::from_secs(30)))
+    });
+
+    // The holder hears the waiter arrive: it sleeps in poll(2) on the doorbell, no timer.
+    let arrivals = events.wait(Some(Duration::from_secs(20))).expect("wait");
+    assert_eq!(arrivals.len(), 1, "{arrivals:?}");
+    let me = ProcessIdentity::of_current().expect("identity");
+    let waiting = arrivals[0].waiter.as_ref().expect("the waiter's identity");
+    assert_eq!((waiting.pid, waiting.started), (me.pid, me.started));
+    // The waiter registered itself before it rang.
+    assert_eq!(holder.waiters().len(), 1);
+    assert_eq!(holder.record().waiters.len(), 1);
+    assert_eq!(holder.record().waiters[0].pid, me.pid);
+
+    // An idle holder yields at once: the waiter's blocked lock call returns.
+    let yielded = Instant::now();
+    drop(holder);
+    let granted = waiter
+        .join()
+        .expect("join")
+        .expect("the waiter gets the lock");
+    assert!(
+        yielded.elapsed() < Duration::from_secs(10),
+        "woken by the release, not by a timer"
+    );
+    assert!(granted.took_over().is_none(), "the holder left no record");
+    assert!(granted.waiters().is_empty());
+    assert_eq!(granted.record().holder, me);
+}
+
+#[test]
+fn an_idle_holder_is_called_back_when_a_waiter_arrives() {
+    let scratch = Scratch::new("listener");
+    let dir = scratch.path().to_path_buf();
+    let holder =
+        MachineLock::acquire("sd", &dir, options().with_state(HolderState::Idle)).expect("acquire");
+    let (sender, receiver) = mpsc::channel();
+    let listener = holder
+        .on_waiter(move |arrival| {
+            let _ = sender.send(arrival);
+        })
+        .expect("listener");
+
+    let waiter = thread::spawn({
+        let dir = dir.clone();
+        move || MachineLock::acquire("sd", &dir, wait_for(Duration::from_secs(30)))
+    });
+    let arrival = receiver
+        .recv_timeout(Duration::from_secs(20))
+        .expect("the callback ran");
+    assert_eq!(arrival.waiter.expect("identity").pid, std::process::id());
+
+    drop(listener); // stops and joins the thread
+    drop(holder);
+    waiter
+        .join()
+        .expect("join")
+        .expect("the waiter gets the lock");
+}
+
+#[test]
+fn a_killed_holder_releases_the_lock_and_its_record_is_only_a_note() {
+    let scratch = Scratch::new("dead");
+    let dir = scratch.path();
+    let mut role = KillOnDrop(
+        Command::new(std::env::current_exe().expect("test binary"))
+            .args(["--exact", "holder_role", "--nocapture", "--test-threads=1"])
+            .env(ROLE_DIR_ENV, dir)
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .expect("spawn the role"),
+    );
+    let stdout = role.0.stdout.take().expect("stdout");
+    let (sender, receiver) = mpsc::channel();
+    thread::spawn(move || {
+        for line in BufReader::new(stdout).lines() {
+            let Ok(line) = line else { break };
+            if line.contains(HELD_MARKER) {
+                let _ = sender.send(());
+            }
+        }
+    });
+    receiver
+        .recv_timeout(Duration::from_secs(60))
+        .expect("the role took the lock");
+    let role_pid = role.0.id();
+
+    // While it lives: busy, and the record names it, live.
+    let error = MachineLock::acquire("role", dir, options()).expect_err("held by the role");
+    let seen = error
+        .busy()
+        .and_then(|b| b.holder.as_ref())
+        .expect("record");
+    assert_eq!(seen.holder.pid, role_pid);
+    assert_eq!(seen.holder_status(), Ok(true));
+    assert_eq!(
+        seen.details.get("who").map(String::as_str),
+        Some("the role process")
+    );
+
+    // SIGKILL: no destructor runs, so the record stays; the kernel drops the lock.
+    role.0.kill().expect("kill");
+    role.0.wait().expect("reap");
+    assert!(
+        dir.join("role.holder.json").exists(),
+        "the record outlives the holder"
+    );
+    assert!(
+        matches!(MachineLock::peek("role", dir), Ok(LockState::Free)),
+        "a record of a dead holder does not make the lock held"
+    );
+
+    let lock = MachineLock::acquire("role", dir, options()).expect("taken at once");
+    let stale = lock
+        .took_over()
+        .expect("the dead holder's record is reported");
+    assert_eq!(stale.holder.pid, role_pid);
+    assert_eq!(
+        stale.holder_status().expect_err("the holder is gone"),
+        AdoptError::Gone
+    );
+    assert_eq!(lock.record().holder.pid, std::process::id());
+}
+
+#[test]
+fn a_record_never_grants_ownership() {
+    let scratch = Scratch::new("forged");
+    let dir = scratch.path();
+    // A record that names a live process (this one), left where a free lock sits.
+    let lock = MachineLock::acquire("sd", dir, options()).expect("acquire");
+    let record_path = dir.join("sd.holder.json");
+    let text = fs::read_to_string(&record_path).expect("record");
+    drop(lock);
+    fs::write(&record_path, &text).expect("plant the record");
+
+    assert!(
+        matches!(MachineLock::peek("sd", dir), Ok(LockState::Free)),
+        "the lock is free whatever the record says"
+    );
+    let lock = MachineLock::acquire("sd", dir, options()).expect("taken despite the record");
+    let stale = lock.took_over().expect("reported");
+    assert_eq!(
+        stale.holder,
+        ProcessIdentity::of_current().expect("identity")
+    );
+
+    // And a record that is not a record at all.
+    drop(lock);
+    fs::write(&record_path, b"{ not json").expect("plant junk");
+    let lock = MachineLock::acquire("sd", dir, options()).expect("taken");
+    assert!(lock.took_over().is_none());
+}
+
+#[test]
+fn state_and_details_are_rewritten_atomically() {
+    let scratch = Scratch::new("update");
+    let dir = scratch.path();
+    let lock = MachineLock::acquire("sd", dir, options()).expect("acquire");
+    lock.set_state(HolderState::Idle).expect("state");
+    lock.set_detail("port", "9000").expect("detail");
+    let seen = match MachineLock::peek("sd", dir) {
+        Ok(LockState::Held { record: Some(seen) }) => seen,
+        other => panic!("expected Held with a record, got {other:?}"),
+    };
+    assert_eq!(seen.state, HolderState::Idle);
+    assert_eq!(seen.details.get("port").map(String::as_str), Some("9000"));
+
+    lock.set_details(BTreeMap::from([(
+        "job".to_string(),
+        "j1 \"quoted\" \\ é".to_string(),
+    )]))
+    .expect("details");
+    let seen = lock.record();
+    assert_eq!(seen.details.len(), 1);
+    assert_eq!(
+        seen.details.get("job").map(String::as_str),
+        Some("j1 \"quoted\" \\ é")
+    );
+    let names: Vec<String> = fs::read_dir(dir)
+        .expect("read_dir")
+        .flatten()
+        .map(|entry| entry.file_name().to_string_lossy().into_owned())
+        .filter(|name| name.ends_with(".tmp"))
+        .collect();
+    assert!(names.is_empty(), "no temporary record is left: {names:?}");
+}
+
+#[test]
+fn names_and_directories_are_checked() {
+    let scratch = Scratch::new("checks");
+    let dir = scratch.path();
+    let too_long = "x".repeat(65);
+    for bad in ["", "../x", "a.b", "a b", "a/b", too_long.as_str()] {
+        match MachineLock::acquire(bad, dir, options()) {
+            Err(MachineLockError::InvalidName(name)) => assert_eq!(name, bad),
+            other => panic!("{bad:?}: expected InvalidName, got {other:?}"),
+        }
+    }
+
+    // A directory another user could write into could be used to plant a lock or a doorbell.
+    let open = dir.join("open");
+    fs::DirBuilder::new()
+        .mode(0o777)
+        .create(&open)
+        .expect("mkdir");
+    fs::set_permissions(&open, fs::Permissions::from_mode(0o777)).expect("chmod");
+    match MachineLock::acquire("sd", &open, options()) {
+        Err(MachineLockError::Io(error)) => {
+            assert_eq!(error.kind(), std::io::ErrorKind::PermissionDenied)
+        }
+        other => panic!("expected a refusal, got {other:?}"),
+    }
+    assert!(MachineLock::peek("sd", &open).is_err());
+
+    // A symbolic link to a good directory is not a directory.
+    let real = dir.join("real");
+    fs::DirBuilder::new()
+        .mode(0o700)
+        .create(&real)
+        .expect("mkdir");
+    let link = dir.join("link");
+    std::os::unix::fs::symlink(&real, &link).expect("symlink");
+    match MachineLock::acquire("sd", &link, options()) {
+        Err(MachineLockError::Io(error)) => {
+            assert_eq!(error.kind(), std::io::ErrorKind::InvalidInput)
+        }
+        other => panic!("expected a refusal, got {other:?}"),
+    }
+    MachineLock::acquire("sd", &real, options()).expect("the real directory works");
+
+    // Nothing there yet: nothing is created by looking.
+    let empty = dir.join("empty");
+    fs::DirBuilder::new()
+        .mode(0o700)
+        .create(&empty)
+        .expect("mkdir");
+    assert!(matches!(
+        MachineLock::peek("sd", &empty),
+        Ok(LockState::Free)
+    ));
+    assert_eq!(fs::read_dir(&empty).expect("read_dir").count(), 0);
+}

+++ b/crates/rightkit-process/src/machine_sys.rs
@@ -0,0 +1,273 @@
+//! The operating-system pieces of the machine-wide lock and the caller lease: a directory that
+//! only this user controls, files created owner-only and without following links, and a stable
+//! key for "the same file" (device and inode).
+//!
+//! The lock itself is `std::fs::File::lock` / `try_lock` (MSRV 1.98), which is `flock(2)` on
+//! macOS and Linux and `LockFileEx` on Windows, so it needs nothing here.
+//!
+//! # Windows
+//!
+//! `imp` for Windows is a stub; every function answers `Unsupported`. What the Windows session
+//! implements:
+//!
+//! * `machine_dir(app)`: `%PROGRAMDATA%\<app>\runtime`, not `%TEMP%` or `%APPDATA%` (the QA runners
+//!   rewrite `TEMP`, `APPDATA` and `LOCALAPPDATA`, which would hide one engine from another).
+//!   `%PROGRAMDATA%` is writable by every user, so the directory is created with an explicit DACL
+//!   (`CreateDirectoryW` with `SECURITY_ATTRIBUTES`) that grants only the current user, `SYSTEM`
+//!   and `Administrators`, and an existing directory is accepted only after checking that its
+//!   owner SID is the current user's (`GetSecurityInfo` with `OWNER_SECURITY_INFORMATION`) and
+//!   that no ACE gives `Everyone` or `Users` write access. One per-user directory per user, named
+//!   by SID or user name, since the machine is shared.
+//! * `check_dir(dir)`: the same ownership and DACL check without creating, and a refusal of a
+//!   reparse point (junction or symbolic link) as the final component.
+//! * `open_lock_file(path, create)`: `CreateFileW` with `OPEN_ALWAYS` / `OPEN_EXISTING`,
+//!   `FILE_FLAG_OPEN_REPARSE_POINT`, then refuse the handle if it is a reparse point.
+//! * `file_key(file)`: `GetFileInformationByHandle`, volume serial number and file index.
+//! * `create_new_private(path)`: `CREATE_NEW` with the owner-only DACL.
+
+pub(crate) use imp::{check_dir, create_new_private, file_key, machine_dir, open_lock_file};
+
+#[cfg(unix)]
+mod imp {
+    use std::{
+        fs::{self, File, OpenOptions},
+        io,
+        os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt, PermissionsExt},
+        path::{Path, PathBuf},
+    };
+
+    fn euid() -> u32 {
+        // SAFETY: geteuid takes no arguments and cannot fail.
+        unsafe { libc::geteuid() }
+    }
+
+    /// Whether `dir` is somewhere only this user can put files: a real directory (a symbolic
+    /// link is refused), owned by this user, and not writable by group or others. Anything else
+    /// could have been planted by another user to feed this process a lock, a record or a
+    /// doorbell of their choosing. Checked on `dir` itself; the path above it is the caller's.
+    pub(crate) fn check_dir(dir: &Path) -> io::Result<()> {
+        let meta = fs::symlink_metadata(dir)?;
+        if !meta.file_type().is_dir() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!(
+                    "{} is not a directory (a symbolic link is refused)",
+                    dir.display()
+                ),
+            ));
+        }
+        if meta.uid() != euid() {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                format!("{} belongs to another user", dir.display()),
+            ));
+        }
+        if meta.mode() & 0o022 != 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                format!("{} can be written by group or others", dir.display()),
+            ));
+        }
+        Ok(())
+    }
+
+    /// `/tmp/<app>-<uid>`, created `0700` if missing and validated if present. The literal
+    /// `/tmp`, not `$TMPDIR` and not `$HOME`: QA runners and isolated callers remap both, which
+    /// would give each caller its own lock and hide one engine from another.
+    ///
+    /// An existing directory is used only if it is a real directory (not a link), owned by this
+    /// user. A mode wider than `0700` on a directory this user owns is tightened (through the
+    /// descriptor that was checked, so the path cannot be swapped in between). Another user's
+    /// directory, or a link, at that name is an error: `/tmp` is sticky, so nobody can replace
+    /// our directory later, but whoever created the name first owns it.
+    pub(crate) fn machine_dir(app: &str) -> io::Result<PathBuf> {
+        if app.is_empty()
+            || app.len() > 48
+            || app.starts_with('.')
+            || !app
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'))
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "an app name is 1 to 48 letters, digits, '_' or '-' and does not start with '.'",
+            ));
+        }
+        let path = PathBuf::from(format!("/tmp/{app}-{}", euid()));
+        match fs::DirBuilder::new().mode(0o700).create(&path) {
+            Ok(()) => {}
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(error),
+        }
+        let dir = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW)
+            .open(&path)?;
+        let meta = dir.metadata()?;
+        if meta.uid() != euid() {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                format!(
+                    "{} exists and belongs to another user; refusing to use it",
+                    path.display()
+                ),
+            ));
+        }
+        if meta.mode() & 0o7777 != 0o700 {
+            dir.set_permissions(fs::Permissions::from_mode(0o700))?;
+        }
+        Ok(path)
+    }
+
+    /// Opens (and with `create`, creates `0600`) the file a lock is taken on. A symbolic link at
+    /// `path` is refused. `NotFound` when `create` is false and there is no such file.
+    pub(crate) fn open_lock_file(path: &Path, create: bool) -> io::Result<File> {
+        OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(create)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW)
+            .open(path)
+    }
+
+    /// Device and inode: two opens of one file agree, two files never do.
+    pub(crate) fn file_key(file: &File) -> io::Result<(u64, u64)> {
+        let meta = file.metadata()?;
+        Ok((meta.dev(), meta.ino()))
+    }
+
+    /// Creates a new `0600` file, failing if `path` exists (a planted link included).
+    pub(crate) fn create_new_private(path: &Path) -> io::Result<File> {
+        OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW)
+            .open(path)
+    }
+}
+
+#[cfg(windows)]
+mod imp {
+    use std::{fs::File, io, path::Path, path::PathBuf};
+
+    fn unsupported<T>() -> io::Result<T> {
+        Err(io::Error::from(io::ErrorKind::Unsupported))
+    }
+
+    pub(crate) fn check_dir(_dir: &Path) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub(crate) fn machine_dir(_app: &str) -> io::Result<PathBuf> {
+        unsupported()
+    }
+
+    pub(crate) fn open_lock_file(_path: &Path, _create: bool) -> io::Result<File> {
+        unsupported()
+    }
+
+    pub(crate) fn file_key(_file: &File) -> io::Result<(u64, u64)> {
+        unsupported()
+    }
+
+    pub(crate) fn create_new_private(_path: &Path) -> io::Result<File> {
+        unsupported()
+    }
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use crate::test_support::Scratch;
+    use std::{io, os::unix::fs::PermissionsExt};
+
+    #[test]
+    fn a_private_directory_passes_and_a_writable_one_does_not() {
+        let scratch = Scratch::new("sys-dir");
+        check_dir(scratch.path()).expect("owner-only directory");
+        std::fs::set_permissions(scratch.path(), std::fs::Permissions::from_mode(0o770))
+            .expect("chmod");
+        let error = check_dir(scratch.path()).expect_err("group-writable");
+        assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+        std::fs::set_permissions(scratch.path(), std::fs::Permissions::from_mode(0o755))
+            .expect("chmod");
+        check_dir(scratch.path()).expect("readable by others is fine, writable is not");
+    }
+
+    #[test]
+    fn a_symbolic_link_is_not_a_directory_for_the_check() {
+        let scratch = Scratch::new("sys-link");
+        let real = scratch.join("real");
+        std::fs::create_dir(&real).expect("mkdir");
+        let link = scratch.join("link");
+        std::os::unix::fs::symlink(&real, &link).expect("symlink");
+        assert_eq!(
+            check_dir(&link).expect_err("a link").kind(),
+            io::ErrorKind::InvalidInput
+        );
+        assert!(check_dir(&scratch.join("absent")).is_err());
+    }
+
+    #[test]
+    fn a_lock_file_is_not_followed_through_a_link_and_new_files_are_exclusive() {
+        let scratch = Scratch::new("sys-file");
+        let real = scratch.join("real");
+        std::fs::write(&real, b"").expect("write");
+        let link = scratch.join("link");
+        std::os::unix::fs::symlink(&real, &link).expect("symlink");
+        assert!(open_lock_file(&link, true).is_err());
+        assert!(open_lock_file(&scratch.join("absent"), false).is_err());
+        let file = open_lock_file(&scratch.join("new.lock"), true).expect("create");
+        let again = open_lock_file(&scratch.join("new.lock"), false).expect("open existing");
+        assert_eq!(
+            file_key(&file).expect("key"),
+            file_key(&again).expect("key")
+        );
+        assert_ne!(file_key(&file).expect("key"), {
+            let other = open_lock_file(&scratch.join("other.lock"), true).expect("create");
+            file_key(&other).expect("key")
+        });
+        let private = scratch.join("record.tmp");
+        create_new_private(&private).expect("create");
+        assert!(create_new_private(&private).is_err(), "exclusive");
+        let mode = std::fs::metadata(&private)
+            .expect("stat")
+            .permissions()
+            .mode();
+        assert_eq!(mode & 0o077, 0, "owner-only: {mode:o}");
+    }
+
+    #[test]
+    fn the_machine_directory_is_private_stable_and_tightened() {
+        let app = format!("rk-process-test-{}", std::process::id());
+        let first = machine_dir(&app).expect("create");
+        // SAFETY: geteuid cannot fail.
+        let uid = unsafe { libc::geteuid() };
+        assert_eq!(first, std::path::PathBuf::from(format!("/tmp/{app}-{uid}")));
+        let mode = std::fs::metadata(&first)
+            .expect("stat")
+            .permissions()
+            .mode();
+        assert_eq!(mode & 0o7777, 0o700);
+        // A directory this user owns but left too open is tightened, not refused.
+        std::fs::set_permissions(&first, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+        assert_eq!(machine_dir(&app).expect("reuse"), first);
+        let mode = std::fs::metadata(&first)
+            .expect("stat")
+            .permissions()
+            .mode();
+        assert_eq!(mode & 0o7777, 0o700);
+        check_dir(&first).expect("passes the check");
+        std::fs::remove_dir(&first).expect("clean up");
+        let too_long = "x".repeat(49);
+        for bad in ["", ".hidden", "a/b", "a b", too_long.as_str()] {
+            assert_eq!(
+                machine_dir(bad).expect_err("bad name").kind(),
+                io::ErrorKind::InvalidInput,
+                "{bad:?}"
+            );
+        }
+    }
+}

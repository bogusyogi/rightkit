+//! A machine-wide, single-holder lock with a record of who holds it.
+//!
+//! Some resources must exist once per machine whichever app asks: one 10 GB model server, one
+//! GPU job, one exclusive device. Two apps with different data folders cannot see each other's
+//! per-folder locks, and a lock file that only says "locked" cannot say *by whom*, so a second
+//! app either blocks blind or loads a second copy and exhausts memory. [`MachineLock`] is the
+//! admission gate for such a resource:
+//!
+//! * **The lock is the truth.** An OS advisory lock on `<name>.lock` (`flock` on macOS and Linux,
+//!   `LockFileEx` on Windows, through `std::fs::File::lock`). The kernel releases it when the
+//!   holder dies, `SIGKILL` included, so a crashed holder never wedges the machine. Nothing else
+//!   in this module grants or removes ownership.
+//! * **The record is a note, never authority.** `<name>.holder.json` names the holder (its
+//!   [`ProcessIdentity`], since when, a caller-supplied `details` map, `idle`/`busy`) so a refused
+//!   caller, a `doctor` command and a leftover sweep can say who is in the way. It is written
+//!   atomically (a temporary file renamed over it) by the holder only. A record whose holder is
+//!   not a live process ([`HolderRecord::holder_status`]) is ignored when it comes to deciding
+//!   who holds: the lock decides. The next holder overwrites it and reports it as
+//!   [`took_over`](MachineLock::took_over).
+//! * **Waiting is the kernel's.** [`acquire`](MachineLock::acquire) takes the lock without
+//!   blocking; if it is held and a timeout was given, it blocks *in the lock call itself*, on a
+//!   helper thread, and the caller waits on that with a timeout. There is no retry loop and no
+//!   timer; the kernel wakes the helper the instant the holder lets go. On timeout the caller gets
+//!   [`MachineLockError::Busy`] carrying the holder record.
+//! * **A holder hears a waiter arrive.** A waiter registers itself (a small file
+//!   `<name>.waiter.<pid>.<n>`, so that no two processes write the same file) and rings the
+//!   holder's doorbell, a FIFO `<name>.bell` that the holder owns (`doorbell` explains why a FIFO
+//!   and not a file watch or a socket). The holder subscribes with
+//!   [`waiter_events`](MachineLock::waiter_events) (sleep in `poll(2)` on it, or add its
+//!   descriptor to your own loop) or [`on_waiter`](MachineLock::on_waiter) (a callback on a
+//!   thread). An idle holder drops the lock at once instead of when it next happens to look.
+//!   [`HolderRecord::waiters`] lists the live registrations; it is assembled when the record is
+//!   read, and is not part of the stored JSON.
+//!
+//! # Where the lock lives
+//!
+//! Not under an app's data folder: apps with different data folders must meet. Use
+//! [`machine_dir`], a per-user directory the module creates `0700` under the literal `/tmp`
+//! (not `$TMPDIR`, not `$HOME`: QA runners and isolated callers remap both) and validates on
+//! every use (a real directory, owned by this user, so another user who got to the name first
+//! cannot plant locks, records or doorbells). [`acquire`](MachineLock::acquire) also refuses any
+//! directory that is a link, belongs to another user, or is writable by group or others.
+//!
+//! # Rules
+//!
+//! * One lock file, one lock kind, for every user. `MachineLock` takes `flock(2)`; `rightkit-fs`'s
+//!   `FileLock` takes an `fcntl` record lock unless `LockKind::Flock` is asked for, and the two are
+//!   not guaranteed to exclude each other (they did on macOS and need not on Linux). Move every
+//!   user of a lock name to `MachineLock` together.
+//! * A process that holds a lock must not `acquire` it again: the second call conflicts with the
+//!   first, as another process would, and waits out its timeout.
+//! * A helper thread whose `acquire` timed out stays parked in the lock call until the holder lets
+//!   go, then releases at once (nobody wants it). Later `acquire` calls on the same file reuse that
+//!   thread, so a caller that retries against a wedged holder does not accumulate threads.
+//! * [`peek`](MachineLock::peek) takes the lock for an instant when it is free; a zero-timeout
+//!   `acquire` that races it may report `Busy` once.
+//! * Dropping a `MachineLock` removes the record and the doorbell, then releases the lock.
+//!
+//! # Platforms
+//!
+//! macOS and Linux are implemented. Windows is a stub (`Unsupported`); see `machine_sys` and
+//! `doorbell` for what the Windows session implements. The lock call and the record code are
+//! portable and need no change.
+
+use crate::{
+    doorbell::{ring, stop_pair, BellReader, BellWake, Doorbell, StopSender},
+    json::{self, Json},
+    machine_sys as sys,
+    process_identity::{verify, AdoptError, ProcessIdentity, StartTime},
+    record_file::{lock_exclusive, read_small, write_atomic},
+};
+use std::{
+    collections::BTreeMap,
+    fmt,
+    fs::{self, File, TryLockError},
+    io::{self, Write},
+    marker::PhantomData,
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc, Condvar, Mutex, MutexGuard,
+    },
+    thread,
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+/// A per-user directory for machine-wide locks, outside every app's data folder and outside
+/// `$TMPDIR` / `$HOME`. Created owner-only if missing; validated (owner, mode, not a link) if
+/// present. Unix: `/tmp/<app>-<uid>`. Windows: not implemented yet (`Unsupported`); the plan is
+/// `%PROGRAMDATA%\<app>\runtime` with an owner-only DACL.
+///
+/// `app` is 1 to 48 letters, digits, `_` or `-`. Every app that must see the same lock passes the
+/// same `app` name; apps that must not interfere pass different ones.
+pub fn machine_dir(app: &str) -> io::Result<PathBuf> {
+    sys::machine_dir(app)
+}
+
+/// Whether the holder is working or can give the lock up at once. A waiter reads it to know what
+/// to expect; the holder is expected to yield promptly on a waiter's arrival when it is `Idle`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum HolderState {
+    Idle,
+    Busy,
+}
+
+impl HolderState {
+    fn as_str(self) -> &'static str {
+        match self {
+            HolderState::Idle => "idle",
+            HolderState::Busy => "busy",
+        }
+    }
+
+    fn parse(text: &str) -> Option<Self> {
+        match text {
+            "idle" => Some(HolderState::Idle),
+            "busy" => Some(HolderState::Busy),
+            _ => None,
+        }
+    }
+}
+
+/// What the holder wrote about itself.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct HolderRecord {
+    /// The process that wrote the record, as an identity a later reader can prove.
+    pub holder: ProcessIdentity,
+    /// When the hold began.
+    pub since: SystemTime,
+    pub state: HolderState,
+    /// Whatever the app wants a refused caller or a `doctor` to see (a model name, a port, a
+    /// job id, the pid of the server the holder started). Opaque to this crate.
+    pub details: BTreeMap<String, String>,
+    /// Processes registered as waiting, live ones only, by pid. Filled in when the record is
+    /// read; never stored in the JSON.
+    pub waiters: Vec<ProcessIdentity>,
+}
+
+impl HolderRecord {
+    /// Whether the recorded holder is still the process that wrote the record: `Ok(true)` it is
+    /// running, `Ok(false)` it has exited and awaits its parent's reap, `Err` it is gone, replaced
+    /// or cannot be told. The lock, not this answer, decides who holds; a holder that died while a
+    /// stray descriptor (a forked child) kept the lock leaves a record that reads `Err(Gone)`
+    /// here while the lock is still held.
+    pub fn holder_status(&self) -> Result<bool, AdoptError> {
+        verify(&self.holder).map(|verified| !verified.zombie)
+    }
+}
+
+/// What to do when taking a [`MachineLock`].
+#[derive(Clone, Debug)]
+pub struct MachineLockOptions {
+    /// How long to wait for a holder to let go. `ZERO` (the default) tries once. The wait is
+    /// the kernel's: the caller sleeps until the lock is granted or the time is up.
+    pub timeout: Duration,
+    /// The state recorded at the start of the hold (default `Busy`).
+    pub state: HolderState,
+    /// The details recorded at the start of the hold.
+    pub details: BTreeMap<String, String>,
+}
+
+impl Default for MachineLockOptions {
+    fn default() -> Self {
+        Self {
+            timeout: Duration::ZERO,
+            state: HolderState::Busy,
+            details: BTreeMap::new(),
+        }
+    }
+}
+
+impl MachineLockOptions {
+    pub fn with_timeout(mut self, timeout: Duration) -> Self {
+        self.timeout = timeout;
+        self
+    }
+
+    pub fn with_state(mut self, state: HolderState) -> Self {
+        self.state = state;
+        self
+    }
+
+    pub fn with_detail(mut self, key: impl Into<String>, value: impl Into<String>) -> Self {
+        self.details.insert(key.into(), value.into());
+        self
+    }
+}
+
+/// The lock was held for the whole wait.
+#[derive(Clone, Debug)]
+pub struct Busy {
+    /// The lock's name.
+    pub name: String,
+    /// The record the holder left, if it could be read. It may describe a holder that is no
+    /// longer alive (see [`HolderRecord::holder_status`]).
+    pub holder: Option<HolderRecord>,
+    /// How long the caller waited.
+    pub waited: Duration,
+}
+
+/// Why a [`MachineLock`] was not taken.
+#[derive(Debug)]
+#[non_exhaustive]
+pub enum MachineLockError {
+    /// Another process held the lock for the whole wait. Not retryable by default: retrying a
+    /// busy machine in a loop is how memory gets exhausted.
+    Busy(Busy),
+    /// A lock name is 1 to 64 letters, digits, `_` or `-`.
+    InvalidName(String),
+    Io(io::Error),
+}
+
+impl MachineLockError {
+    pub fn busy(&self) -> Option<&Busy> {
+        match self {
+            MachineLockError::Busy(busy) => Some(busy),
+            _ => None,
+        }
+    }
+}
+
+impl fmt::Display for MachineLockError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            MachineLockError::Busy(busy) => {
+                write!(
+                    f,
+                    "{} is held by another process (waited {:.1}s)",
+                    busy.name,
+                    busy.waited.as_secs_f64()
+                )?;
+                if let Some(record) = &busy.holder {
+                    write!(f, ": pid {}", record.holder.pid)?;
+                    for (key, value) in &record.details {
+                        write!(f, ", {key} {value}")?;
+                    }
+                }
+                Ok(())
+            }
+            MachineLockError::InvalidName(name) => write!(f, "invalid lock name {name:?}"),
+            MachineLockError::Io(error) => write!(f, "machine lock: {error}"),
+        }
+    }
+}
+
+impl std::error::Error for MachineLockError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            MachineLockError::Io(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+impl From<io::Error> for MachineLockError {
+    fn from(error: io::Error) -> Self {
+        MachineLockError::Io(error)
+    }
+}
+
+/// What [`MachineLock::peek`] found.
+#[derive(Clone, Debug)]
+pub enum LockState {
+    Free,
+    /// Held by some process. The record, if there is a readable one, may be stale.
+    Held {
+        record: Option<HolderRecord>,
+    },
+}
+
+/// The held lock. Dropping it removes the record and the doorbell, then releases the lock.
+#[derive(Debug)]
+pub struct MachineLock {
+    /// Holds the OS lock for as long as it lives.
+    file: File,
+    name: String,
+    dir: PathBuf,
+    record_path: PathBuf,
+    /// `None` when the doorbell could not be created: waiters then wait without telling the
+    /// holder, and [`waiter_events`](Self::waiter_events) answers `Unsupported`.
+    bell: Option<Doorbell>,
+    record: Mutex<HolderRecord>,
+    took_over: Option<HolderRecord>,
+}
+
+impl MachineLock {
+    /// Takes the lock `name` in `dir`.
+    ///
+    /// `dir` must exist and be a directory this user controls (see the module documentation);
+    /// [`machine_dir`] makes one. With `options.timeout` zero the lock is tried once.
+    pub fn acquire(
+        name: &str,
+        dir: &Path,
+        options: MachineLockOptions,
+    ) -> Result<MachineLock, MachineLockError> {
+        check_name(name)?;
+        sys::check_dir(dir)?;
+        let started = Instant::now();
+        let file = sys::open_lock_file(&lock_path(dir, name), true)?;
+        let held = match file.try_lock() {
+            Ok(()) => file,
+            Err(TryLockError::Error(error)) => return Err(error.into()),
+            Err(TryLockError::WouldBlock) => {
+                if options.timeout.is_zero() {
+                    return Err(busy(dir, name, started));
+                }
+                // Visible to the holder (and to `doctor`) for as long as this call waits.
+                let registration = WaiterRegistration::new(dir, name);
+                let granted = lock_blocking(&file, options.timeout);
+                // Not waiting any more, whatever the outcome: a refused caller does not list
+                // itself among the waiters it reports.
+                drop(registration);
+                match granted? {
+                    Some(held) => held,
+                    None => return Err(busy(dir, name, started)),
+                }
+            }
+        };
+        Self::finish(held, name, dir, options)
+    }
+
+    /// Who holds the lock `name` in `dir` right now, without waiting and without creating
+    /// anything. A record left behind by a holder that has gone is not reported as a holder: the
+    /// lock is free then, and `Free` is the answer.
+    pub fn peek(name: &str, dir: &Path) -> Result<LockState, MachineLockError> {
+        check_name(name)?;
+        sys::check_dir(dir)?;
+        let file = match sys::open_lock_file(&lock_path(dir, name), false) {
+            Ok(file) => file,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(LockState::Free),
+            Err(error) => return Err(error.into()),
+        };
+        match file.try_lock() {
+            Ok(()) => {
+                let _ = file.unlock();
+                Ok(LockState::Free)
+            }
+            Err(TryLockError::WouldBlock) => Ok(LockState::Held {
+                record: read_holder(dir, name),
+            }),
+            Err(TryLockError::Error(error)) => Err(error.into()),
+        }
+    }
+
+    fn finish(
+        file: File,
+        name: &str,
+        dir: &Path,
+        options: MachineLockOptions,
+    ) -> Result<MachineLock, MachineLockError> {
+        let record_path = record_path(dir, name);
+        // Whoever wrote this is not holding the lock we now hold: it exited or let go.
+        let took_over = read_record(&record_path);
+        let record = HolderRecord {
+            holder: ProcessIdentity::of_current()?,
+            since: SystemTime::now(),
+            state: options.state,
+            details: options.details,
+            waiters: Vec::new(),
+        };
+        // Replaces a doorbell a dead holder left behind. A failure is not fatal: the lock works
+        // without it, and only the holder's early warning of a waiter is lost.
+        let bell = Doorbell::create(&bell_path(dir, name), true).ok();
+        write_record(&record_path, &record)?;
+        Ok(MachineLock {
+            file,
+            name: name.to_string(),
+            dir: dir.to_path_buf(),
+            record_path,
+            bell,
+            record: Mutex::new(record),
+            took_over,
+        })
+    }
+
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    pub fn dir(&self) -> &Path {
+        &self.dir
+    }
+
+    /// The record of the previous holder, if one was left behind: it died, or let go without
+    /// cleaning up. Informational (a leftover sweep reads the server it started from here).
+    pub fn took_over(&self) -> Option<&HolderRecord> {
+        self.took_over.as_ref()
+    }
+
+    /// The current record, with the live waiters filled in.
+    pub fn record(&self) -> HolderRecord {
+        let mut record = lock_state(&self.record).clone();
+        record.waiters = list_waiters(&self.dir, &self.name);
+        record
+    }
+
+    /// The processes registered as waiting for this lock, live ones only.
+    pub fn waiters(&self) -> Vec<ProcessIdentity> {
+        list_waiters(&self.dir, &self.name)
+    }
+
+    /// Records a new state (`Idle` when the holder could give the lock up at once).
+    pub fn set_state(&self, state: HolderState) -> io::Result<()> {
+        self.update(|record| record.state = state)
+    }
+
+    /// Replaces the details.
+    pub fn set_details(&self, details: BTreeMap<String, String>) -> io::Result<()> {
+        self.update(|record| record.details = details)
+    }
+
+    /// Sets one detail.
+    pub fn set_detail(&self, key: impl Into<String>, value: impl Into<String>) -> io::Result<()> {
+        let (key, value) = (key.into(), value.into());
+        self.update(|record| {
+            record.details.insert(key, value);
+        })
+    }
+
+    fn update(&self, change: impl FnOnce(&mut HolderRecord)) -> io::Result<()> {
+        let mut record = lock_state(&self.record);
+        change(&mut record);
+        write_record(&self.record_path, &record)
+    }
+
+    /// A source of "a waiter arrived" for a holder that wants to sleep on it itself.
+    ///
+    /// Mechanism: the holder's doorbell is a FIFO (`<name>.bell`) that it keeps open; a waiter
+    /// that finds the lock held registers and writes one line to it. [`WaiterEvents::wait`]
+    /// sleeps in `poll(2)` on the FIFO, so an idle holder is woken by the arrival and not by a
+    /// timer. On Unix the events also expose their descriptor (`AsRawFd`) for a holder with its
+    /// own `poll`/`kqueue` loop. Each arrival is delivered to one reader.
+    ///
+    /// `Unsupported` where there is no doorbell (Windows today, or the doorbell could not be
+    /// created).
+    pub fn waiter_events(&self) -> io::Result<WaiterEvents> {
+        let bell = self
+            .bell
+            .as_ref()
+            .ok_or_else(|| io::Error::from(io::ErrorKind::Unsupported))?;
+        Ok(WaiterEvents {
+            reader: bell.reader().try_clone()?,
+        })
+    }
+
+    /// Runs `callback` on a thread for each arriving waiter, until the returned guard is dropped
+    /// (which stops and joins the thread). The callback is where an idle holder decides to drop
+    /// the lock. Same mechanism as [`waiter_events`](Self::waiter_events); use one of the two.
+    pub fn on_waiter(
+        &self,
+        mut callback: impl FnMut(WaiterArrival) + Send + 'static,
+    ) -> io::Result<WaiterListener<'_>> {
+        let bell = self
+            .bell
+            .as_ref()
+            .ok_or_else(|| io::Error::from(io::ErrorKind::Unsupported))?;
+        let reader = bell.reader().try_clone()?;
+        let (sender, receiver) = stop_pair()?;
+        let thread = thread::Builder::new()
+            .name("rightkit-machine-lock-listener".into())
+            .spawn(move || loop {
+                match reader.wait_or_stop(&receiver, None) {
+                    Ok(BellWake::Message(bytes)) => {
+                        for arrival in parse_arrivals(&bytes) {
+                            callback(arrival);
+                        }
+                    }
+                    Ok(BellWake::TimedOut) => {}
+                    Ok(BellWake::Stopped) | Err(_) => break,
+                }
+            })?;
+        Ok(WaiterListener {
+            stop: Some(sender),
+            thread: Some(thread),
+            _lock: PhantomData,
+        })
+    }
+}
+
+impl Drop for MachineLock {
+    fn drop(&mut self) {
+        // The record and the doorbell go before the lock does, so the next holder never finds
+        // the departing holder's doorbell in its way.
+        let _ = fs::remove_file(&self.record_path);
+        drop(self.bell.take());
+        let _ = self.file.unlock();
+    }
+}
+
+/// One waiter that arrived, as the holder hears of it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct WaiterArrival {
+    /// Who is waiting (without its executable), when the line could be read.
+    pub waiter: Option<ProcessIdentity>,
+}
+
+/// A holder's subscription to arriving waiters. See [`MachineLock::waiter_events`].
+#[derive(Debug)]
+pub struct WaiterEvents {
+    reader: BellReader,
+}
+
+impl WaiterEvents {
+    /// Sleeps until at least one waiter arrives or `timeout` passes (`None`: no limit). Empty on
+    /// a timeout.
+    pub fn wait(&self, timeout: Option<Duration>) -> io::Result<Vec<WaiterArrival>> {
+        Ok(parse_arrivals(&self.reader.wait(timeout)?))
+    }
+}
+
+#[cfg(unix)]
+impl std::os::fd::AsRawFd for WaiterEvents {
+    /// Readable when a waiter has arrived. Read it only through [`WaiterEvents::wait`].
+    fn as_raw_fd(&self) -> std::os::fd::RawFd {
+        self.reader.raw_fd()
+    }
+}
+
+/// The thread behind [`MachineLock::on_waiter`]. Dropping it stops and joins the thread; it
+/// cannot outlive the lock it listens for.
+#[derive(Debug)]
+pub struct WaiterListener<'lock> {
+    stop: Option<StopSender>,
+    thread: Option<thread::JoinHandle<()>>,
+    _lock: PhantomData<&'lock MachineLock>,
+}
+
+impl Drop for WaiterListener<'_> {
+    fn drop(&mut self) {
+        // Closing the stop end is the wake-up; then the thread has left and joining is prompt.
+        drop(self.stop.take());
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+fn parse_arrivals(bytes: &[u8]) -> Vec<WaiterArrival> {
+    String::from_utf8_lossy(bytes)
+        .lines()
+        .filter(|line| !line.trim().is_empty())
+        .map(|line| WaiterArrival {
+            waiter: parse_waiter_line(line),
+        })
+        .collect()
+}
+
+/// `w <pid> <start>`
+fn parse_waiter_line(line: &str) -> Option<ProcessIdentity> {
+    let mut parts = line.split_whitespace();
+    if parts.next()? != "w" {
+        return None;
+    }
+    let pid = parts.next()?.parse::<u32>().ok()?;
+    let started = parts.next()?.parse::<StartTime>().ok()?;
+    Some(ProcessIdentity {
+        pid,
+        started,
+        executable: None,
+    })
+}
+
+// ---------------------------------------------------------------------------------------- names
+
+fn check_name(name: &str) -> Result<(), MachineLockError> {
+    let valid = !name.is_empty()
+        && name.len() <= 64
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'));
+    if valid {
+        Ok(())
+    } else {
+        Err(MachineLockError::InvalidName(name.to_string()))
+    }
+}
+
+fn lock_path(dir: &Path, name: &str) -> PathBuf {
+    dir.join(format!("{name}.lock"))
+}
+
+fn record_path(dir: &Path, name: &str) -> PathBuf {
+    dir.join(format!("{name}.holder.json"))
+}
+
+fn bell_path(dir: &Path, name: &str) -> PathBuf {
+    dir.join(format!("{name}.bell"))
+}
+
+fn lock_state<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(|poison| poison.into_inner())
+}
+
+// -------------------------------------------------------------------------------------- record
+
+const RECORD_VERSION: u64 = 1;
+
+fn encode_record(record: &HolderRecord) -> String {
+    let since = record
+        .since
+        .duration_since(UNIX_EPOCH)
+        .ok()
+        .and_then(|elapsed| u64::try_from(elapsed.as_millis()).ok())
+        .unwrap_or(0);
+    let details = record
+        .details
+        .iter()
+        .map(|(key, value)| (key.clone(), Json::Str(value.clone())))
+        .collect();
+    let mut text = json::write(&Json::Object(vec![
+        ("version".to_string(), Json::Uint(RECORD_VERSION)),
+        ("holder".to_string(), Json::Str(record.holder.to_string())),
+        ("since_unix_ms".to_string(), Json::Uint(since)),
+        (
+            "state".to_string(),
+            Json::Str(record.state.as_str().to_string()),
+        ),
+        ("details".to_string(), Json::Object(details)),
+    ]));
+    text.push('\n');
+    text
+}
+
+fn decode_record(text: &str) -> Option<HolderRecord> {
+    let value = json::parse(text)?;
+    if value.get("version")?.as_u64()? != RECORD_VERSION {
+        return None;
+    }
+    let mut details = BTreeMap::new();
+    for (key, item) in value.get("details")?.as_object()? {
+        details.insert(key.clone(), item.as_str()?.to_string());
+    }
+    Some(HolderRecord {
+        holder: value.get("holder")?.as_str()?.parse().ok()?,
+        since: UNIX_EPOCH
+            .checked_add(Duration::from_millis(value.get("since_unix_ms")?.as_u64()?))?,
+        state: HolderState::parse(value.get("state")?.as_str()?)?,
+        details,
+        waiters: Vec::new(),
+    })
+}
+
+fn read_record(path: &Path) -> Option<HolderRecord> {
+    decode_record(&read_small(path)?)
+}
+
+/// The record with its live waiters, for a caller that is not the holder.
+fn read_holder(dir: &Path, name: &str) -> Option<HolderRecord> {
+    let mut record = read_record(&record_path(dir, name))?;
+    record.waiters = list_waiters(dir, name);
+    Some(record)
+}
+
+/// Writes the record atomically: a private temporary file in the same directory, renamed over
+/// the record, so a reader sees the old record or the new one and never half of one.
+fn write_record(path: &Path, record: &HolderRecord) -> io::Result<()> {
+    write_atomic(path, &encode_record(record))
+}
+
+fn busy(dir: &Path, name: &str, started: Instant) -> MachineLockError {
+    MachineLockError::Busy(Busy {
+        name: name.to_string(),
+        holder: read_holder(dir, name),
+        waited: started.elapsed(),
+    })
+}
+
+// ------------------------------------------------------------------------------------ waiters
+
+/// A waiter's entry, present while its `acquire` waits.
+struct WaiterRegistration {
+    path: Option<PathBuf>,
+}
+
+impl WaiterRegistration {
+    /// Registers this process as waiting and tells the holder. Best effort throughout: a waiter
+    /// that cannot register still waits.
+    fn new(dir: &Path, name: &str) -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let Ok(me) = ProcessIdentity::of_current() else {
+            return Self { path: None };
+        };
+        let path = dir.join(format!(
+            "{name}.waiter.{}.{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        let written = sys::create_new_private(&path)
+            .and_then(|mut file| file.write_all(me.to_string().as_bytes()));
+        if written.is_err() {
+            let _ = fs::remove_file(&path);
+            return Self { path: None };
+        }
+        let line = format!("w {} {}\n", me.pid, me.started);
+        let _ = ring(&bell_path(dir, name), line.as_bytes());
+        Self { path: Some(path) }
+    }
+}
+
+impl Drop for WaiterRegistration {
+    fn drop(&mut self) {
+        if let Some(path) = self.path.take() {
+            let _ = fs::remove_file(path);
+        }
+    }
+}
+
+/// The live waiters of `name`, read from the registration files. A registration whose process
+/// is gone (a waiter that crashed) is removed on the way.
+fn list_waiters(dir: &Path, name: &str) -> Vec<ProcessIdentity> {
+    let prefix = format!("{name}.waiter.");
+    let Ok(entries) = fs::read_dir(dir) else {
+        return Vec::new();
+    };
+    let mut waiters = Vec::new();
+    for entry in entries.flatten() {
+        let file_name = entry.file_name();
+        let Some(file_name) = file_name.to_str() else {
+            continue;
+        };
+        if !file_name.starts_with(&prefix) {
+            continue;
+        }
+        let path = entry.path();
+        // Unreadable or still being written: leave it for the next look.
+        let Some(identity) =
+            read_small(&path).and_then(|text| text.parse::<ProcessIdentity>().ok())
+        else {
+            continue;
+        };
+        match verify(&identity) {
+            Ok(verified) if !verified.zombie => waiters.push(identity),
+            Ok(_) | Err(AdoptError::Gone) | Err(AdoptError::Replaced { .. }) => {
+                let _ = fs::remove_file(&path);
+            }
+            Err(_) => {}
+        }
+    }
+    waiters.sort_by_key(|waiter| waiter.pid);
+    waiters
+}
+
+// ---------------------------------------------------------------- the blocking lock call
+
+type FileKey = (u64, u64);
+
+/// A blocking lock call in progress on a helper thread, shared by every acquirer of one file in
+/// this process.
+struct Pending {
+    state: Mutex<PendingState>,
+    ready: Condvar,
+}
+
+struct PendingState {
+    phase: Phase,
+    /// Acquirers currently waiting on this call. The helper keeps a granted lock only for one.
+    interested: usize,
+}
+
+enum Phase {
+    /// The helper is blocked in the kernel's lock call.
+    Waiting,
+    /// The helper holds the lock for an interested acquirer, who has not taken it yet.
+    Granted(File),
+    /// An acquirer took the grant.
+    Taken,
+    /// The helper got the lock when nobody wanted it, and released it.
+    Closed,
+    Failed(io::ErrorKind, String),
+}
+
+/// What an acquirer's wait on a [`Pending`] came to.
+enum Waited {
+    Granted(File),
+    TimedOut,
+    /// The call ended without this acquirer getting the lock; ask the kernel again.
+    Retry,
+    Failed(io::ErrorKind, String),
+}
+
+/// Helper calls in progress, one per file. This is the only process-wide state: it is what lets a
+/// caller that retries against a wedged holder reuse one parked thread instead of adding one per
+/// attempt.
+static PENDING: Mutex<Vec<(FileKey, Arc<Pending>)>> = Mutex::new(Vec::new());
+
+impl Pending {
+    fn wait(&self, deadline: Instant) -> Waited {
+        let mut guard = lock_state(&self.state);
+        loop {
+            let PendingState { phase, interested } = &mut *guard;
+            match phase {
+                Phase::Granted(_) => {
+                    let Phase::Granted(held) = std::mem::replace(phase, Phase::Taken) else {
+                        unreachable!("matched Granted just above");
+                    };
+                    *interested -= 1;
+                    return Waited::Granted(held);
+                }
+                Phase::Taken | Phase::Closed => {
+                    *interested -= 1;
+                    return Waited::Retry;
+                }
+                Phase::Failed(kind, message) => {
+                    let failed = Waited::Failed(*kind, message.clone());
+                    *interested -= 1;
+                    return failed;
+                }
+                Phase::Waiting => {}
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                *interested -= 1;
+                return Waited::TimedOut;
+            }
+            guard = self
+                .ready
+                .wait_timeout(guard, deadline - now)
+                .unwrap_or_else(|poison| poison.into_inner())
+                .0;
+        }
+    }
+}
+
+/// Takes the lock on `file`'s inode, waiting up to `timeout` for the holder to let go. Returns
+/// the descriptor that holds the lock, or `None` on a timeout.
+///
+/// The wait is the kernel's: a helper thread sits in `File::lock` (`flock(LOCK_EX)`) on a
+/// duplicate of the descriptor, which shares the open file description and so the lock, and the
+/// caller sleeps on a condition variable with a deadline. Nothing here loops on a timer.
+fn lock_blocking(file: &File, timeout: Duration) -> io::Result<Option<File>> {
+    // Far enough to be "forever" and small enough that adding it to `now` cannot overflow.
+    let timeout = timeout.min(Duration::from_secs(365 * 24 * 3600));
+    let deadline = Instant::now() + timeout;
+    let key = sys::file_key(file)?;
+    loop {
+        // The holder may have let go since the caller looked.
+        match file.try_lock() {
+            Ok(()) => return Ok(Some(file.try_clone()?)),
+            Err(TryLockError::WouldBlock) => {}
+            Err(TryLockError::Error(error)) => return Err(error),
+        }
+        let pending = join_pending(key, file)?;
+        match pending.wait(deadline) {
+            Waited::Granted(held) => return Ok(Some(held)),
+            Waited::TimedOut => return Ok(None),
+            Waited::Retry => {}
+            Waited::Failed(kind, message) => return Err(io::Error::new(kind, message)),
+        }
+    }
+}
+
+/// Joins the helper already blocked on this file, or starts one.
+fn join_pending(key: FileKey, file: &File) -> io::Result<Arc<Pending>> {
+    let mut registry = PENDING.lock().unwrap_or_else(|poison| poison.into_inner());
+    if let Some((_, pending)) = registry.iter().find(|(known, _)| *known == key) {
+        let mut state = lock_state(&pending.state);
+        if matches!(state.phase, Phase::Waiting) {
+            state.interested += 1;
+            drop(state);
+            return Ok(Arc::clone(pending));
+        }
+    }
+    let pending = Arc::new(Pending {
+        state: Mutex::new(PendingState {
+            phase: Phase::Waiting,
+            interested: 1,
+        }),
+        ready: Condvar::new(),
+    });
+    let held = file.try_clone()?;
+    let helper = Arc::clone(&pending);
+    thread::Builder::new()
+        .name("rightkit-machine-lock".into())
+        .spawn(move || run_helper(key, held, helper))?;
+    registry.retain(|(known, _)| *known != key);
+    registry.push((key, Arc::clone(&pending)));
+    Ok(pending)
+}
+
+/// The helper thread: one blocking lock call, then hand the lock to a waiting acquirer or give
+/// it straight back.
+fn run_helper(key: FileKey, file: File, pending: Arc<Pending>) {
+    let result = lock_exclusive(&file);
+    {
+        let mut state = lock_state(&pending.state);
+        match result {
+            Ok(()) if state.interested > 0 => state.phase = Phase::Granted(file),
+            Ok(()) => {
+                // Every acquirer gave up while this call waited: nobody wants the lock.
+                let _ = file.unlock();
+                state.phase = Phase::Closed;
+            }
+            Err(error) => state.phase = Phase::Failed(error.kind(), error.to_string()),
+        }
+        pending.ready.notify_all();
+    }
+    let mut registry = PENDING.lock().unwrap_or_else(|poison| poison.into_inner());
+    registry.retain(|(known, entry)| !(*known == key && Arc::ptr_eq(entry, &pending)));
+}

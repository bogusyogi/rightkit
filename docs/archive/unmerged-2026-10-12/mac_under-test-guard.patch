+    fn unix_cargo_test_and_example_binaries_are_tests() {
+        assert!(is_test("/work/rightkit/target/debug/deps/e2e-1a2b3c4d"));
+        assert!(is_test("/work/rightkit/target/release/deps/budget-9f"));
+        assert!(is_test("/work/rightkit/target/debug/examples/svc_host"));
+        assert!(is_test(
+            "/work/rightkit/target/aarch64-apple-darwin/debug/deps/e2e-1a2b3c4d"

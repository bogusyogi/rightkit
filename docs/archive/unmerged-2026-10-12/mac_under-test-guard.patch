+//! Under test, no resolver returns a real user's folder. This binary lives in
+//! `target/<profile>/deps`, so the process is under test; the public resolvers must refuse the
+//! real per-user default, and the explicit-root forms must keep working. Reads the environment
+//! only (never writes it), so it can run beside other tests; a developer who exported an override
+//! variable skips the refusals, which would then be overrides.
+
+use rightkit_models::error::ErrorCode;
+use rightkit_models::suite::catalog::parakeet_spec;
+use rightkit_models::suite::discover::{find_existing_elsewhere, find_existing_under};
+use rightkit_models::suite::handle::sibling_parakeet_dirs;
+use rightkit_models::suite::paths;
+use rightkit_models::suite::whisper::{resolve_whisper_model, WhisperKind};
+use rightkit_models::suite::{
+    device_id_get_or_create, lease, store, EntryState, ModelStore, VerifyMode,
+};
+
+fn overridden() -> bool {
+    ["RIGHT_SUITE_DIR", "ORTHIC_SHARED_DIR"]
+        .iter()
+        .any(|var| std::env::var_os(var).is_some_and(|v| !v.is_empty()))
+}
+
+fn panics_under_test(f: impl FnOnce() + std::panic::UnwindSafe, resolver: &str) {
+    let payload = std::panic::catch_unwind(f).expect_err("must panic under test");
+    let text = payload
+        .downcast_ref::<String>()
+        .cloned()
+        .or_else(|| payload.downcast_ref::<&str>().map(|s| s.to_string()))
+        .expect("a text panic");
+    assert!(text.contains(resolver), "{resolver}: {text}");
+    assert!(text.contains("under test"), "{resolver}: {text}");
+}
+
+#[test]
+fn infallible_resolvers_panic_with_the_resolver_named() {
+    if overridden() {
+        return;
+    }
+    panics_under_test(|| drop(sibling_parakeet_dirs()), "sibling_parakeet_dirs()");
+    panics_under_test(
+        || drop(find_existing_elsewhere(&parakeet_spec(), true)),
+        "find_existing_elsewhere()",
+    );
+    panics_under_test(|| drop(ModelStore::shared("app")), "ModelStore::shared()");
+    panics_under_test(
+        || drop(lease::current_holder("family")),
+        "lease::current_holder()",
+    );
+}
+
+#[test]
+fn fallible_resolvers_return_a_typed_or_string_error() {
+    if overridden() {
+        return;
+    }
+    let text = device_id_get_or_create("HeardRight").unwrap_err();
+    assert!(text.contains("device_id_get_or_create()"), "{text}");
+    assert!(text.contains("under test"), "{text}");
+
+    let error = resolve_whisper_model(WhisperKind::Ggml).unwrap_err();
+    assert_eq!(error.code, ErrorCode::UnderTest);
+    assert!(error.message.contains("resolve_whisper_model()"), "{error}");
+    let error = paths::shared_runtime_dir("onnxruntime", "1.20.1").unwrap_err();
+    assert_eq!(error.code, ErrorCode::UnderTest);
+
+    let text = lease::try_acquire_compat("family", "app")
+        .err()
+        .expect("refused");
+    assert!(text.contains("lease::try_acquire_compat()"), "{text}");
+    assert!(text.contains("under test"), "{text}");

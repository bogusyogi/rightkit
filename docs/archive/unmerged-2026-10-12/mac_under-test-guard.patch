+        // And again once the folder exists (canonical comparison).
+        std::fs::create_dir_all(&real).unwrap();
+        assert!(points_into(&real.join("shared"), &protected).is_some());
+        assert!(points_into(&tmp.path().join("other"), &protected).is_none());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_symlink_into_the_protected_folder_is_still_inside_it() {
+        let tmp = tempfile::tempdir().unwrap();

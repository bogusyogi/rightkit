index 00000000..1365044c
--- /dev/null
+++ b/crates/rightkit-service/src/under_test.rs
@@ -0,0 +1,299 @@
+//! "Is this process a test?" and the rule that keeps a test away from a real user's folders.
+//!
+//! A resolver that would hand back the real per-user folder by default must not do so while the
+//! process is under test; see the README section "Under test". This file is duplicated, by
+//! design, in `rightkit-models` (neither crate depends on the other for it); keep the two
+//! identical below this header.
+//!
+//! A process is under test when
+//!
+//! * the environment variable [`UNDER_TEST_ENV`] (`RIGHTKIT_UNDER_TEST`) is set to a non-empty
+//!   value other than `0`, or
+//! * its executable sits directly in a Cargo `deps` or `examples` directory whose parent chain
+//!   looks like a Cargo target profile ([`exe_is_cargo_test_binary`]).
+//!
+//! The second rule cannot be switched off: `RIGHTKIT_UNDER_TEST=0` only fails to switch the first
+//! one on. The program in `<profile>/<exe>` itself (`cargo run`, a dev build) is not a test.
+
+use std::ffi::OsStr;
+use std::path::{Component, Path, PathBuf};
+use std::sync::OnceLock;
+
+/// Set to any non-empty value other than `0` to mark a process as a test run.
+pub(crate) const UNDER_TEST_ENV: &str = "RIGHTKIT_UNDER_TEST";
+
+/// Whether an environment value marks the process as a test: non-empty after trimming, not `0`.
+pub(crate) fn env_marks_under_test(value: Option<&OsStr>) -> bool {
+    value.is_some_and(|v| {
+        let v = v.to_string_lossy();
+        let v = v.trim();
+        !v.is_empty() && v != "0"
+    })
+}
+
+/// Whether `exe` is a Cargo-built test, bench or example binary, judged by its path alone.
+///
+/// Pure and platform-independent: `/` and `\` both separate segments, so a Windows path is
+/// judged the same way on every host. The shapes that count:
+///
+/// * `<dir>/<debug|release>/deps/<exe>` and `<dir>/<debug|release>/examples/<exe>`, where `<dir>`
+///   is the target directory (any name, `CARGO_TARGET_DIR` may be anything) or a target triple
+///   under it;
+/// * the same with a custom profile name, when the directory above the profile is named `target`
+///   or is a target triple directly below one named `target`.
+///
+/// Not a test: `<profile>/<exe>` itself (`cargo run`), an installed app, and any path that only
+/// contains the word `deps` or `examples` somewhere other than directly above the executable.
+pub(crate) fn exe_is_cargo_test_binary(exe: &Path) -> bool {
+    let text = exe.to_string_lossy();
+    let parts: Vec<&str> = text.split(['/', '\\']).filter(|p| !p.is_empty()).collect();
+    let n = parts.len();
+    // At least `<target-dir>/<profile>/deps/<exe>`.
+    if n < 4 {
+        return false;
+    }
+    let holder = parts[n - 2];
+    if !(holder.eq_ignore_ascii_case("deps") || holder.eq_ignore_ascii_case("examples")) {
+        return false;
+    }
+    let profile = parts[n - 3];
+    if profile.eq_ignore_ascii_case("debug") || profile.eq_ignore_ascii_case("release") {
+        return true;
+    }
+    // A custom profile directory: only under a directory literally named `target`, directly or
+    // below one target triple.
+    let above = parts[n - 4];
+    if above.eq_ignore_ascii_case("target") {
+        return true;
+    }
+    n >= 5 && above.contains('-') && parts[n - 5].eq_ignore_ascii_case("target")
+}
+
+/// Whether this process is under test: [`UNDER_TEST_ENV`] now, or its own executable's path.
+pub(crate) fn under_test() -> bool {
+    if env_marks_under_test(std::env::var_os(UNDER_TEST_ENV).as_deref()) {
+        return true;
+    }
+    static EXE_IS_TEST: OnceLock<bool> = OnceLock::new();
+    *EXE_IS_TEST.get_or_init(|| {
+        std::env::current_exe()
+            .map(|exe| exe_is_cargo_test_binary(&exe))
+            .unwrap_or(false)
+    })
+}
+
+const WHY: &str = "this process is under test (RIGHTKIT_UNDER_TEST is set, or the executable is a \
+cargo test, bench or example binary), and no test may read or write a real user's data";
+
+/// The message for a resolver that would return the real per-user folder by default.
+pub(crate) fn default_refusal(resolver: &str, remedy: &str) -> String {
+    format!("{resolver} would use the real per-user folder, but {WHY}; {remedy}")
+}
+
+/// The message for an explicit path that points into the real per-user folder.
+pub(crate) fn override_refusal(resolver: &str, path: &Path, real: &Path) -> String {
+    format!(
+        "{resolver} was given {}, which is inside the real per-user folder {}, but {WHY}; point it at a temp directory",
+        path.display(),
+        real.display()
+    )
+}
+
+/// The protected folder that `candidate` is, or lies inside, if any. Canonicalised paths are
+/// compared where they exist (the deepest existing ancestor is canonicalised and the rest
+/// appended), else lexically.
+pub(crate) fn points_into<'a>(candidate: &Path, protected: &'a [PathBuf]) -> Option<&'a PathBuf> {
+    let candidate = components_of(&normalize(candidate));
+    protected
+        .iter()
+        .find(|p| candidate.starts_with(&components_of(&normalize(p))))
+}
+
+/// Path components as comparable strings; case-folded where the file system usually is.
+fn components_of(path: &Path) -> Vec<String> {
+    let fold = cfg!(any(windows, target_os = "macos"));
+    path.components()
+        .map(|c| {
+            let s = c.as_os_str().to_string_lossy().into_owned();
+            if fold {
+                s.to_lowercase()
+            } else {
+                s
+            }
+        })
+        .collect()
+}
+
+/// `.` and `..` removed lexically.
+fn lexical_clean(path: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for component in path.components() {
+        match component {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                if !out.pop() {
+                    out.push("..");
+                }
+            }
+            other => out.push(other.as_os_str()),
+        }
+    }
+    out
+}
+
+/// The path with its deepest existing ancestor canonicalised (symlinks resolved), the missing
+/// tail appended lexically; the lexical form when nothing exists.
+fn normalize(path: &Path) -> PathBuf {
+    let lexical = lexical_clean(path);
+    let mut existing: &Path = &lexical;
+    let mut tail: Vec<&OsStr> = Vec::new();
+    loop {
+        if let Ok(mut resolved) = std::fs::canonicalize(existing) {
+            for part in tail.iter().rev() {
+                resolved.push(*part);
+            }
+            return resolved;
+        }
+        match (existing.parent(), existing.file_name()) {
+            (Some(parent), Some(name)) => {
+                tail.push(name);
+                existing = parent;
+            }
+            _ => return lexical.clone(),
+        }
+    }
+}
+

+        assert!(!is_test(
+            "/work/rightkit/target/aarch64-apple-darwin/debug/rightkit-app"
+        ));
+        assert!(!is_test(r"C:\work\rightkit\target\debug\rightkit-app.exe"));
+        assert!(!is_test(
+            r"C:\work\rightkit\target\x86_64-pc-windows-msvc\release\rightkit-app.exe"
+        ));
+    }
+
+    #[test]
+    fn installed_apps_and_stray_deps_words_are_not_tests() {
+        assert!(!is_test(
+            "/Applications/HeardRight.app/Contents/MacOS/heardright"
+        ));
+        assert!(!is_test("/usr/local/bin/heardright-engine"));
+        assert!(!is_test(r"C:\Program Files\HeardRight\heardright.exe"));
+        assert!(!is_test(r"C:\Program Files\HeardRight\deps\helper.exe"));
+        // `deps` or `examples` elsewhere than directly above the executable.
+        assert!(!is_test("/home/u/deps/app/bin/tool"));
+        assert!(!is_test("/home/u/examples/app/tool"));
+        assert!(!is_test("/home/u/target/deps/tool"));
+        assert!(!is_test("/opt/app/custom/deps/helper"));
+        assert!(!is_test("/opt/deps/helper"));
+        assert!(!is_test("/work/rightkit/target/debug/deps/nested/tool"));
+        // Too shallow to be `<target-dir>/<profile>/deps/<exe>`, and relative or empty paths.
+        assert!(!is_test("/debug/deps/tool"));

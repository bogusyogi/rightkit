+        assert!(points_into(&tmp.path().join("data").join("Orthic Labs2"), &protected).is_none());
+        assert!(points_into(&tmp.path().join("data"), &protected).is_none());
+        assert!(points_into(&tmp.path().join("other"), &protected).is_none());
+        // `..` is resolved lexically.
+        assert!(points_into(
+            &tmp.path()

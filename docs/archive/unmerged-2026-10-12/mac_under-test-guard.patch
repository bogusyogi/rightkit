+        assert!(is_test("/Volumes/D/cargo-out/debug/deps/e2e-1a2b3c4d"));
+        assert!(is_test(
+            "/Volumes/D/cargo-out/x86_64-apple-darwin/release/deps/e2e-1a2b3c4d"
+        ));
+        // A custom profile counts under a `target` directory, with or without a triple.
+        assert!(is_test("/work/target/release-lto/deps/e2e-1a2b3c4d"));
+        assert!(is_test(
+            "/work/target/aarch64-apple-darwin/dev-fast/examples/svc_host"
+        ));
+    }
+
+    #[test]
+    fn windows_cargo_test_and_example_binaries_are_tests_on_every_host() {
+        assert!(is_test(
+            r"C:\work\rightkit\target\debug\deps\e2e-1a2b3c4d.exe"
+        ));
+        assert!(is_test(
+            r"C:\work\rightkit\target\x86_64-pc-windows-msvc\release\deps\e2e-1a2b3c4d.exe"

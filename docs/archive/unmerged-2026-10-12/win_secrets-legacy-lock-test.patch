From 538785cdc8c20d4738c50d328c3277eb842587b3 Mon Sep 17 00:00:00 2001
From: adrdsouza <102761952+adrdsouza@users.noreply.github.com>
Date: Mon, 12 Oct 2026 06:22:13 +0530
Subject: [PATCH] rightkit-secrets (Windows): the legacy-lock name test
 compares the name without its terminating NUL

legacy_lock_name returns the UTF-16 name as CreateMutexW takes it, NUL included. The test converted the whole
buffer and compared it with a string that has no NUL, so it failed on the Windows leg although the name is the
expected one. The test now checks that the last unit is the terminator and compares the rest. No product change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/rightkit-secrets/src/windows.rs | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/crates/rightkit-secrets/src/windows.rs b/crates/rightkit-secrets/src/windows.rs
index 583d52b5..b08b8d36 100644
--- a/crates/rightkit-secrets/src/windows.rs
+++ b/crates/rightkit-secrets/src/windows.rs
@@ -467,11 +467,12 @@ mod tests {
     /// 16 bytes, computed outside this crate.
     #[test]
     fn the_legacy_lock_has_the_name_older_versions_take() {
-        let name =
-            String::from_utf16(&legacy_lock_name("dev.rightkit.secrets.legacy", "db").unwrap())
-                .unwrap();
+        // The name is built for `CreateMutexW`, so it ends with the terminating NUL.
+        let name = legacy_lock_name("dev.rightkit.secrets.legacy", "db").unwrap();
+        let (terminator, text) = name.split_last().unwrap();
+        assert_eq!(*terminator, 0);
         assert_eq!(
-            name,
+            String::from_utf16(text).unwrap(),
             "Local\\rightkit-secrets-4a09df4ea76be3781179b6dbb18cb6b1"
         );
     }

{
  "name": "@rightkit/ml-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Private ASR model tooling: a bake-off adapter contract with ten model adapters, a WER scorer, a bundle-size qualifier, and CoreML conversion and benchmark scripts.",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "bin": {
    "rk-asr-wer": "wer/score-asr-wer.mjs",
    "rk-bundle-qualify": "asr-bakeoff/bundle-qualify.mjs"
  },
  "exports": {
    "./wer": "./wer/score-asr-wer.mjs",
    "./bundle-qualify": "./asr-bakeoff/bundle-qualify.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "asr-bakeoff",
    "wer",
    "coreml",
    "requirements",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "test": "node wer/score-asr-wer.mjs --self-test"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/ml-lab"
  }
}

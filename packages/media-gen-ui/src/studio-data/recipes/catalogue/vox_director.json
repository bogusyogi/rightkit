{
  "schema_version": "1.0.0",
  "id": "vox_director",
  "title": "Vox-style explainer: topic to beats and script, keyframes, motion scenes, narration and captions",
  "source": {
    "template": "crates/genright-studio/src/pipeline_workflows.rs fn templates(), vox_director steps (keyframes, narration, scenes, captions; script and beats are native)",
    "plan": "docs/plans/2026-10-08-genright-execution-plan.md:144 (G11 names the Vox-style explainer)",
    "donor": "github.com/Alisa0808/vox-director (pattern source, per pipeline_workflows.rs header; no donor code)"
  },
  "inputs": [
    {"name": "topic", "type": "text"},
    {"name": "aspect", "type": "text"},
    {"name": "hook_image_prompt", "type": "text"},
    {"name": "scene_video_prompt", "type": "text"}
  ],
  "nodes": [
    {
      "id": "script",
      "kind": "native",
      "output": "text",
      "native": "script",
      "params": {"topic": {"input": "topic", "type": "text"}},
      "depends_on": []
    },
    {
      "id": "beats",
      "kind": "native",
      "output": "data",
      "native": "beats",
      "params": {},
      "depends_on": []
    },
    {
      "id": "keyframes",
      "kind": "image",
      "route": {"provider": "fal", "model": "fal-ai/flux-2/klein/9b"},
      "params": {
        "prompt": {"input": "hook_image_prompt", "type": "text"},
        "aspect": {"input": "aspect", "type": "text"}
      },
      "depends_on": ["beats"]
    },
    {
      "id": "narration",
      "kind": "voice",
      "route": {"provider": "local-qts", "model": "qwen3-tts-0.6b-q8_0"},
      "params": {
        "prompt": {"node": "script", "type": "text"}
      },
      "depends_on": ["script"]
    },
    {
      "id": "scenes",
      "kind": "video",
      "route": {"provider": "fal", "model": "fal-ai/veo3.1/fast/image-to-video"},
      "params": {
        "prompt": {"input": "scene_video_prompt", "type": "text"},
        "aspect": {"input": "aspect", "type": "text"},
        "duration": 8,
        "image_url": {"node": "keyframes", "type": "image"}
      },
      "depends_on": ["keyframes", "narration"]
    },
    {
      "id": "captions",
      "kind": "native",
      "output": "video",
      "native": "compose_video",
      "params": {},
      "depends_on": ["scenes", "narration"]
    }
  ],
  "outputs": [{"name": "video", "from": "captions"}],
  "review": {
    "required": true,
    "policy": "Default: review required. The per-recipe review policy (plan :92) is not yet expressed per recipe in the source."
  }
}

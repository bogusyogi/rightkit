{
  "schema_version": "1.0.0",
  "id": "motion_transfer",
  "title": "Motion transfer: move a subject with the motion of a source video",
  "source": {
    "template": "crates/genright-studio/data/recipes/templates.json:templates.motion_transfer (slots, prompt lead and lock, routes)",
    "plan": "docs/plans/2026-10-08-genright-execution-plan.md:56 (G2 motion-transfer pair) and :143-144 (G11 names it)"
  },
  "inputs": [
    {"name": "subject_image", "type": "image"},
    {"name": "motion_video", "type": "video"},
    {"name": "source_seconds", "type": "number"}
  ],
  "nodes": [
    {
      "id": "motion",
      "kind": "motion_control",
      "route": {"provider": "fal", "model": "fal-ai/kling-video/v3/pro/motion-control"},
      "route_alternatives": [
        {"provider": "fal", "model": "fal-ai/kling-video/v3/standard/motion-control"},
        {"provider": "wavespeed", "model": "kwaivgi/kling-v3.0-pro/motion-control"},
        {"provider": "wavespeed", "model": "kwaivgi/kling-v3.0-std/motion-control"},
        {"provider": "wavespeed", "model": "wavespeed-ai/wan-2.2/animate-2"}
      ],
      "params": {
        "prompt": "Animate the subject from the identity image with the motion of the source video. Keep the subject's face, hair, body, outfit and the background exactly as in the identity image. Transfer only the movement.",
        "video_url": {"input": "motion_video"},
        "image_url": {"input": "subject_image"},
        "source_seconds": {"input": "source_seconds"}
      },
      "depends_on": []
    }
  ],
  "outputs": [{"name": "clip", "from": "motion"}],
  "review": {
    "required": true,
    "policy": "Default: review required. The per-recipe review policy (plan :92) is not yet expressed per recipe in the source."
  }
}

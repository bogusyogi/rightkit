{
  "name": "@rightkit/docx-editor",
  "version": "0.1.1",
  "description": "DOCX editing pane over @eigenpal/docx-editor with a host-owned toolbar, find, print and Markdown export.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./documents/docx/DocxPane": {
      "types": "./dist/documents/docx/DocxPane.d.ts",
      "import": "./dist/documents/docx/DocxPane.js"
    },
    "./documents/docx/blankDocx": {
      "types": "./dist/documents/docx/blankDocx.d.ts",
      "import": "./dist/documents/docx/blankDocx.js"
    },
    "./documents/docx/docxToMarkdown": {
      "types": "./dist/documents/docx/docxToMarkdown.d.ts",
      "import": "./dist/documents/docx/docxToMarkdown.js"
    },
    "./documents/docx/menuApi": {
      "types": "./dist/documents/docx/menuApi.d.ts",
      "import": "./dist/documents/docx/menuApi.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "patches",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@eigenpal/docx-editor-core": "1.9.0",
    "@eigenpal/docx-editor-react": "1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@rightkit/document-core": "workspace:^",
    "@rightkit/platform-ui": "workspace:^",
    "@rightkit/theme": "workspace:^",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.8"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter \"@rightkit/docx-editor^...\" run build && vitest run"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/docx-editor"
  },
  "packageManager": "pnpm@12.16.1"
}

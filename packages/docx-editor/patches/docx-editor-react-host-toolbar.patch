+/**
+ * Host-owned toolbar bridge. A host uses this to render its own DOCX
+ * toolbar while Eigenpal keeps the document engine, layout, dialogs, command
+ * plumbing, and selection-restoration internals.
+ */
+export interface DocxHostToolbarContext {
+  selectionFormatting: SelectionFormatting;
+  disabled: boolean;
+  canUndo: boolean;
+  canRedo: boolean;
+  editingMode: EditorMode;
+  zoom: number;
+  format: (action: FormattingAction) => void;
+  undo: () => void;
+  redo: () => void;
+  save: () => void | Promise<void>;
+  print: () => void;
+  open: () => void;
+  setEditingMode: (mode: EditorMode) => void;
+  setZoom: (zoom: number) => void;
+  refocusEditor: () => void;
+  insertTable: (rows: number, columns: number) => void;
+  insertImage: () => void;
+  insertPageBreak: () => void;
+  insertTOC: () => void;
+  pageSetup: () => void;
+  /** Data a host-rebuilt toolbar/menus need (eigenpal's own controls had these). */
+  documentStyles: Style[] | undefined;
+  theme: Theme | null | undefined;
+}

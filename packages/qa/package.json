{
  "name": "@rightkit/qa",
  "version": "0.6.2",
  "description": "Shared QA evidence, ownership, browser helpers, and release-backdoor guards for Right Suite apps.",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "bin": {
    "rightkit-qa-journeys": "dist/journeys/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chrome": {
      "types": "./dist/chrome.d.ts",
      "import": "./dist/chrome.js"
    },
    "./journeys": {
      "types": "./dist/journeys/index.d.ts",
      "import": "./dist/journeys/index.js"
    },
    "./journeys-fixture-adapter": "./journeys-fixture-adapter.mjs",
    "./ts-register": "./ts-register.mjs",
    "./ts-hooks": "./ts-hooks.mjs"
  },
  "files": [
    "dist",
    "ts-register.mjs",
    "ts-hooks.mjs",
    "journeys-fixture-adapter.mjs",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @rightkit/qa-chrome build && pnpm run build && vitest run && node --test public-storage.test.mjs ts-register.test.mjs",
    "test:adoption-contract": "pnpm run build && vitest run --config vitest.adoption.config.ts"
  },
  "dependencies": {
    "@rightkit/qa-chrome": "0.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/qa"
  },
  "rightkit": {
    "publishCheck": {
      "binSmoke": {
        "rightkit-qa-journeys": [
          "--help"
        ]
      },
      "skipImport": [
        "./journeys-fixture-adapter"
      ]
    }
  }
}

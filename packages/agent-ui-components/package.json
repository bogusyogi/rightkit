{
  "name": "@rightkit/agent-ui-components",
  "version": "0.1.0",
  "description": "Coding-agent UI components: app frame, chat, composer, review, panels, delivery, remote and usage.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@rightkit/agent-ui-core": "workspace:^",
    "@rightkit/agent-ui-hooks": "workspace:^",
    "@rightkit/agent-ui-settings": "workspace:^",
    "@rightkit/agent-ui-workbench": "workspace:^",
    "@rightkit/app-update": "workspace:^",
    "@rightkit/dictation-ui": "workspace:^",
    "@rightkit/legal-ui": "workspace:^",
    "@rightkit/platform-ui": "workspace:^",
    "@rightkit/react-shell": "workspace:^",
    "@rightkit/settings-ui": "workspace:^",
    "@rightkit/terminal-ui": "workspace:^",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/agent-ui-components"
  },
  "packageManager": "pnpm@12.16.1"
}

{
  "name": "@rightkit/license",
  "version": "0.2.0",
  "packageManager": "pnpm@11.24.0",
  "description": "The one license client for every Right Suite app (online token-exchange against the unified RightApps backend, with per-kind offline grace).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "LICENSE-MIT", "LICENSE-APACHE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tauri-apps/plugin-http": "^2",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@tauri-apps/plugin-http": "^2"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/plugin-http": { "optional": true }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orthic-Labs/rightkit.git",
    "directory": "packages/license"
  }
}

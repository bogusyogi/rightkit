{
  "name": "@rightkit/workspace-ui",
  "version": "0.2.1",
  "description": "Calendar, contacts, drive, tasks and meeting views and their navs, over a typed workspace client and state the host supplies.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./lib/avatar": {
      "types": "./dist/lib/avatar.d.ts",
      "import": "./dist/lib/avatar.js"
    },
    "./lib/calendarUtils": {
      "types": "./dist/lib/calendarUtils.d.ts",
      "import": "./dist/lib/calendarUtils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@rightkit/react-shell": "workspace:^",
    "@rightkit/settings-ui": "workspace:^",
    "lucide-react": "^1.57.0"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/workspace-ui"
  },
  "packageManager": "pnpm@12.16.1"
}

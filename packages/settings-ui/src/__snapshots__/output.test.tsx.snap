exports[`licenseSection output > free, ids, plan slot and custom labels, key typed 1`] = `"<div id="s"><p>plan</p><section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="license.status"><div class="rk-sr__text"><div class="rk-sr__label">Licence</div><div class="rk-sr__desc"><span role="status" id="st">No licence key is active on this device.</span></div></div><div class="rk-sr__control"><div class="rk-sr__buttons"><span class="rk-badge rk-badge--neutral">Free</span></div></div></div><div class="rk-sr rk-sr--stacked" data-setting-id="license.activate"><div class="rk-sr__text"><div class="rk-sr__label">Licence key</div><div class="rk-sr__desc">hint</div></div><div class="rk-sr__control"><form id="f" class="rk-sr__inline"><input class="rk-input" id="k" aria-label="Licence key" placeholder="XXXX-XXXX-XXXX-XXXX" autocomplete="off" spellcheck="false" value="ABC"><button type="submit" class="rk-btn rk-btn--primary rk-btn--sm" id="a">Activate</button></form></div></div></div></section></div>"`;

exports[`licenseSection output > free, with purchase row 1`] = `"<section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="license.status"><div class="rk-sr__text"><div class="rk-sr__label">Licence</div><div class="rk-sr__desc"><span role="status">No licence key is active on this device.</span></div></div><div class="rk-sr__control"><div class="rk-sr__buttons"><span class="rk-badge rk-badge--neutral">Free</span></div></div></div><div class="rk-sr rk-sr--stacked" data-setting-id="license.activate"><div class="rk-sr__text"><div class="rk-sr__label">Licence key</div><div class="rk-sr__desc">Paste the key from your purchase email.</div></div><div class="rk-sr__control"><form class="rk-sr__inline"><input class="rk-input" aria-label="Licence key" placeholder="XXXX-XXXX-XXXX-XXXX" autocomplete="off" spellcheck="false" value=""><button type="submit" class="rk-btn rk-btn--primary rk-btn--sm" disabled="">Activate</button></form></div></div><div class="rk-sr"><div class="rk-sr__text"><div class="rk-sr__label">Need a licence?</div></div><div class="rk-sr__control"><button type="button" class="rk-btn rk-btn--ghost rk-btn--sm">Get a licence</button></div></div></div></section>"`;

exports[`licenseSection output > invalid licence 1`] = `"<section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="license.status"><div class="rk-sr__text"><div class="rk-sr__label">Licence</div><div class="rk-sr__desc"><span role="status">That licence key was not accepted.</span></div></div><div class="rk-sr__control"><div class="rk-sr__buttons"><span class="rk-badge rk-badge--bad">Invalid</span></div></div></div><div class="rk-sr rk-sr--stacked" data-setting-id="license.activate"><div class="rk-sr__text"><div class="rk-sr__label">Licence key</div><div class="rk-sr__desc">Paste the key from your purchase email.</div></div><div class="rk-sr__control"><form class="rk-sr__inline"><input class="rk-input" aria-label="Licence key" placeholder="XXXX-XXXX-XXXX-XXXX" autocomplete="off" spellcheck="false" value="" aria-invalid="true"><button type="submit" class="rk-btn rk-btn--primary rk-btn--sm" disabled="">Activate</button></form></div></div></div></section>"`;

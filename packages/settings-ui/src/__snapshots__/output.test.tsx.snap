// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`doctorSection output > after run all, ids and details wrapper 1`] = `"<div id="sec"><section class="rk-sg"><h3 class="rk-sg__title">Engine</h3><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="doctor.run"><div class="rk-sr__text"><div class="rk-sr__label">System check</div><div class="rk-sr__desc"><span role="status" id="sum">Last run: 1 of 3 passed.</span></div></div><div class="rk-sr__control"><button type="button" class="rk-btn rk-btn--secondary rk-btn--sm" id="all">Run all</button></div></div><details class="rk-doctor__details"><summary>Details</summary><ul class="rk-doctor__checks" id="lst"><li id="c-a" class="rk-doctor__check" data-check-id="a" data-status="ok"><div class="rk-doctor__text"><span class="rk-doctor__label">A</span><span class="rk-doctor__detail">fine</span></div><div class="rk-sr__buttons"><span class="rk-badge rk-badge--ok">ok</span><button type="button" class="rk-btn rk-btn--ghost rk-btn--sm" id="r-a" aria-label="Re-run A">Re-run</button></div></li><li id="c-b" class="rk-doctor__check" data-check-id="b" data-status="fail"><div class="rk-doctor__text"><span class="rk-doctor__label">B</span><span class="rk-doctor__detail">broken</span><span class="rk-doctor__fix">Fix: reinstall</span></div><div class="rk-sr__buttons"><span class="rk-badge rk-badge--bad">needs attention</span><button type="button" class="rk-btn rk-btn--ghost rk-btn--sm" id="r-b" aria-label="Re-run B">Re-run</button></div></li><li id="c-c" class="rk-doctor__check" data-check-id="c" data-status="fail"><div class="rk-doctor__text"><span class="rk-doctor__label">C</span><span class="rk-doctor__detail">boom</span></div><div class="rk-sr__buttons"><span class="rk-badge rk-badge--bad">needs attention</span><button type="button" class="rk-btn rk-btn--ghost rk-btn--sm" id="r-c" aria-label="Re-run C">Re-run</button></div></li></ul></details></div></section></div>"`;

exports[`doctorSection output > empty 1`] = `"<section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="doctor.run"><div class="rk-sr__text"><div class="rk-sr__label">System check</div><div class="rk-sr__desc"><span role="status">Run the checks to see the engine status.</span></div></div><div class="rk-sr__control"><button type="button" class="rk-btn rk-btn--secondary rk-btn--sm" disabled="">Run all</button></div></div><ul class="rk-doctor__checks"></ul></div></section>"`;

exports[`doctorSection output > idle 1`] = `"<section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="doctor.run"><div class="rk-sr__text"><div class="rk-sr__label">System check</div><div class="rk-sr__desc"><span role="status">Run the checks to see the engine status.</span></div></div><div class="rk-sr__control"><button type="button" class="rk-btn rk-btn--secondary rk-btn--sm">Run all</button></div></div><ul class="rk-doctor__checks"><li class="rk-doctor__check" data-check-id="a" data-status="idle"><div class="rk-doctor__text"><span class="rk-doctor__label">A</span><span class="rk-doctor__detail">first</span></div><div class="rk-sr__buttons"><span class="rk-badge rk-badge--neutral">not run</span><button type="button" class="rk-btn rk-btn--ghost rk-btn--sm" aria-label="Re-run A">Re-run</button></div></li><li class="rk-doctor__check" data-check-id="b" data-status="idle"><div class="rk-doctor__text"><span class="rk-doctor__label">B</span></div><div class="rk-sr__buttons"><span class="rk-badge rk-badge--neutral">not run</span><button type="button" class="rk-btn rk-btn--ghost rk-btn--sm" aria-label="Re-run B">Re-run</button></div></li><li class="rk-doctor__check" data-check-id="c" data-status="idle"><div class="rk-doctor__text"><span class="rk-doctor__label">C</span></div><div class="rk-sr__buttons"><span class="rk-badge rk-badge--neutral">not run</span><button type="button" class="rk-btn rk-btn--ghost rk-btn--sm" aria-label="Re-run C">Re-run</button></div></li></ul></div></section>"`;

exports[`doctorSection output > running 1`] = `"<section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="doctor.run"><div class="rk-sr__text"><div class="rk-sr__label">System check</div><div class="rk-sr__desc"><span role="status">Running diagnostics…</span></div></div><div class="rk-sr__control"><button type="button" class="rk-btn rk-btn--secondary rk-btn--sm" disabled="">Checking…</button></div></div><ul class="rk-doctor__checks"><li class="rk-doctor__check" data-check-id="a" data-status="running"><div class="rk-doctor__text"><span class="rk-doctor__label">A</span></div><div class="rk-sr__buttons"><span class="rk-badge rk-badge--neutral">checking</span><button type="button" class="rk-btn rk-btn--ghost rk-btn--sm" aria-label="Re-run A" disabled="">Checking…</button></div></li></ul></div></section>"`;

exports[`licenseSection output > activation error 1`] = `"<section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="license.status"><div class="rk-sr__text"><div class="rk-sr__label">Licence</div><div class="rk-sr__desc"><span role="status">No licence key is active on this device.</span></div></div><div class="rk-sr__control"><div class="rk-sr__buttons"><span class="rk-badge rk-badge--neutral">Free</span></div></div></div><div class="rk-sr rk-sr--stacked" data-setting-id="license.activate"><div class="rk-sr__text"><div class="rk-sr__label">Licence key</div><div class="rk-sr__desc">Could not reach the licence server. Check your connection and try again.</div></div><div class="rk-sr__control"><form class="rk-sr__inline"><input class="rk-input" aria-label="Licence key" placeholder="XXXX-XXXX-XXXX-XXXX" autocomplete="off" spellcheck="false" value="K"><button type="submit" class="rk-btn rk-btn--primary rk-btn--sm">Activate</button></form></div></div></div></section>"`;

exports[`licenseSection output > active, confirm off 1`] = `"<section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="license.status"><div class="rk-sr__text"><div class="rk-sr__label">Licence</div><div class="rk-sr__desc"><span role="status">Lifetime licence is active.</span></div></div><div class="rk-sr__control"><div class="rk-sr__buttons"><span class="rk-badge rk-badge--accent">pro</span><span class="rk-badge rk-badge--ok">Lifetime</span></div></div></div><div class="rk-sr" data-setting-id="license.deactivate"><div class="rk-sr__text"><div class="rk-sr__label">Deactivate this device</div><div class="rk-sr__desc">Frees the seat so you can activate another device.</div></div><div class="rk-sr__control"><button type="button" class="rk-btn rk-btn--ghost rk-btn--sm">Deactivate</button></div></div></div></section>"`;

exports[`licenseSection output > active, confirm on (idle then armed) > armed 1`] = `"<section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="license.status"><div class="rk-sr__text"><div class="rk-sr__label">Licence</div><div class="rk-sr__desc"><span role="status" id="st">Lifetime licence is active.</span></div></div><div class="rk-sr__control"><div class="rk-sr__buttons"><span class="rk-badge rk-badge--accent">Pro</span><span class="rk-badge rk-badge--ok">Lifetime</span></div></div></div><div class="rk-sr" data-setting-id="license.deactivate"><div class="rk-sr__text"><div class="rk-sr__label">Deactivate this device</div><div class="rk-sr__desc">Frees the seat so you can activate another device.</div></div><div class="rk-sr__control"><button type="button" class="rk-btn rk-btn--danger rk-btn--sm" id="d">Confirm deactivate</button></div></div></div></section>"`;


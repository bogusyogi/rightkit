exports[`0.3.4 default output > custom nav heading, renderNavItem, search off 1`] = `"<div class="rk-settings" data-testid="settings-panel"><nav class="rk-settings__nav" aria-label="Prefs"><h2 class="rk-settings__title">Prefs</h2><div><div class="rk-settings__group">App</div><button type="button" data-section-id="general" class="rk-settings__item is-active" aria-current="page" data-active="true"><em>General*</em></button></div><div><button type="button" data-section-id="privacy" class="rk-settings__item"><em>Privacy</em></button></div><div><div class="rk-settings__group">Info</div><button type="button" data-section-id="about" class="rk-settings__item"><em>About</em></button></div></nav><div class="rk-settings__body"><article class="rk-settings__section" aria-labelledby="rk-sec-general"><h1 id="rk-sec-general" class="rk-settings__h1">General</h1><section class="rk-sg"><h3 class="rk-sg__title">Startup</h3><p class="rk-sg__desc">How the app starts.</p><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="launch"><div class="rk-sr__text"><div class="rk-sr__label">Launch at login</div><div class="rk-sr__desc">Start with the computer.</div></div><div class="rk-sr__control"><input aria-label="Launch" type="checkbox"></div></div><div class="rk-sr rk-sr--stacked" data-setting-id="dock"><div class="rk-sr__text"><div class="rk-sr__label">Show in dock</div></div><div class="rk-sr__control"><input aria-label="Dock"></div></div><div class="rk-sr"><div class="rk-sr__text"><div class="rk-sr__label">Plain row</div></div></div></div></section><section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr"><div class="rk-sr__text"><div class="rk-sr__label">Untitled group row</div></div><div class="rk-sr__control">x</div></div></div></section></article><div class="rk-settings__saving" aria-live="polite"></div></div></div>"`;

exports[`0.3.4 default output > full panel with icons, badge, footer, groups and rows 1`] = `"<div class="rk-settings" data-testid="settings-panel"><nav class="rk-settings__nav" aria-label="Settings"><h2 class="rk-settings__title">Settings</h2><input class="rk-input rk-settings__search" placeholder="Search settings" aria-label="Search settings" type="search" value=""><div><div class="rk-settings__group">App</div><button type="button" data-section-id="general" class="rk-settings__item is-active" aria-current="page" data-active="true"><span class="rk-settings__icon" aria-hidden="true"><i>g</i></span><span class="rk-settings__label">General</span><span class="rk-settings__badge">NEW</span></button></div><div><button type="button" data-section-id="privacy" class="rk-settings__item"><span class="rk-settings__label">Privacy</span></button></div><div><div class="rk-settings__group">Info</div><button type="button" data-section-id="about" class="rk-settings__item"><span class="rk-settings__label">About</span></button></div><div class="rk-settings__navfooter"><span>v1</span></div></nav><div class="rk-settings__body"><article class="rk-settings__section" aria-labelledby="rk-sec-general"><h1 id="rk-sec-general" class="rk-settings__h1">General</h1><section class="rk-sg"><h3 class="rk-sg__title">Startup</h3><p class="rk-sg__desc">How the app starts.</p><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="launch"><div class="rk-sr__text"><div class="rk-sr__label">Launch at login</div><div class="rk-sr__desc">Start with the computer.</div></div><div class="rk-sr__control"><input aria-label="Launch" type="checkbox"></div></div><div class="rk-sr rk-sr--stacked" data-setting-id="dock"><div class="rk-sr__text"><div class="rk-sr__label">Show in dock</div></div><div class="rk-sr__control"><input aria-label="Dock"></div></div><div class="rk-sr"><div class="rk-sr__text"><div class="rk-sr__label">Plain row</div></div></div></div></section><section class="rk-sg"><div class="rk-sg__rows"><div class="rk-sr"><div class="rk-sr__text"><div class="rk-sr__label">Untitled group row</div></div><div class="rk-sr__control">x</div></div></div></section></article><div class="rk-settings__saving" aria-live="polite"></div></div></div>"`;

exports[`0.3.4 default output > hideNav (no search) 1`] = `"<div class="rk-settings rk-settings--no-nav" data-testid="settings-panel"><div class="rk-settings__body"><article class="rk-settings__section" aria-labelledby="rk-sec-privacy"><h1 id="rk-sec-privacy" class="rk-settings__h1">Privacy</h1><section class="rk-sg"><h3 class="rk-sg__title">Data</h3><div class="rk-sg__rows"><div class="rk-sr" data-setting-id="telemetry"><div class="rk-sr__text"><div class="rk-sr__label">Share telemetry</div></div><div class="rk-sr__control">t</div></div></div></section></article><div class="rk-settings__saving" aria-live="polite"></div></div></div>"`;


{
  "name": "@rightkit/settings-ui",
  "version": "0.4.1",
  "description": "Settings panel frame, search and standard sections (appearance, updates, license, legal, diagnostics, models, API keys, about) persisted through rightkit-settings. The panel shell and primitives (/core) need only React.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./standard": {
      "types": "./dist/standard-entry.d.ts",
      "import": "./dist/standard-entry.js"
    },
    "./settings.css": "./settings.css",
    "./shell-adapter": {
      "types": "./dist/shell-adapter.d.ts",
      "import": "./dist/shell-adapter.js"
    }
  },
  "files": [
    "dist",
    "settings.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@rightkit/app-shell": ">=0.2.0 <1",
    "@rightkit/license": ">=0.1.0",
    "@rightkit/logs": ">=0.1.0",
    "@rightkit/theme": ">=0.2.0 <1",
    "@rightkit/updates": ">=0.2.0",
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@rightkit/license": "workspace:*",
    "@rightkit/logs": "workspace:*",
    "@rightkit/qa-chrome": "workspace:*",
    "@rightkit/theme": "workspace:*",
    "@rightkit/updates": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter \"@rightkit/settings-ui^...\" run build",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/settings-ui"
  },
  "packageManager": "pnpm@11.24.0",
  "peerDependenciesMeta": {
    "@rightkit/license": {
      "optional": true
    },
    "@rightkit/logs": {
      "optional": true
    },
    "@rightkit/theme": {
      "optional": true
    },
    "@rightkit/updates": {
      "optional": true
    }
  }
}

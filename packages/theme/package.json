{
  "name": "@rightkit/theme",
  "version": "0.2.4",
  "description": "Brand file to CSS tokens generator for Right Suite apps: light/dark/system, derived dark accent, WCAG contrast and hard-coded-colour checks, runtime brand application.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rightkit-theme": "bin/rightkit-theme.mjs"
  },
  "rightkit": {
    "publishCheck": {
      "binSmoke": {
        "rightkit-theme": {
          "args": [],
          "exitCode": 1,
          "output": "rightkit-theme generate|contrast|tokens"
        }
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@rightkit/qa-chrome": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter \"@rightkit/theme^...\" run build && pnpm run build && vitest run"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orthic-Labs/rightkit.git",
    "directory": "packages/theme"
  },
  "packageManager": "pnpm@11.24.0"
}

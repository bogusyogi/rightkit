{
  "name": "@rightkit/system-ui",
  "version": "0.1.0",
  "description": "System monitor views (activity, storage, cleanup, duplicates, drive health, apps, chat) and chart helpers for desktop utility apps.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./activityLease": {
      "types": "./dist/activityLease.d.ts",
      "import": "./dist/activityLease.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./components/Chart": {
      "types": "./dist/components/Chart.d.ts",
      "import": "./dist/components/Chart.js"
    },
    "./lib/qr": {
      "types": "./dist/lib/qr.d.ts",
      "import": "./dist/lib/qr.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./onboarding/gate": {
      "types": "./dist/onboarding/gate.d.ts",
      "import": "./dist/onboarding/gate.js"
    },
    "./views/LauncherSettings": {
      "types": "./dist/views/LauncherSettings.d.ts",
      "import": "./dist/views/LauncherSettings.js"
    },
    "./views/NearbySettings": {
      "types": "./dist/views/NearbySettings.d.ts",
      "import": "./dist/views/NearbySettings.js"
    },
    "./views/Storage": {
      "types": "./dist/views/Storage.d.ts",
      "import": "./dist/views/Storage.js"
    },
    "./views/membrane.css": "./dist/views/membrane.css",
    "./views/monitor.css": "./dist/views/monitor.css",
    "./views/settings.css": "./dist/views/settings.css",
    "./views/settingsKit": {
      "types": "./dist/views/settingsKit.d.ts",
      "import": "./dist/views/settingsKit.js"
    },
    "./visible": {
      "types": "./dist/visible.d.ts",
      "import": "./dist/visible.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@rightkit/legal-ui": "workspace:^",
    "@rightkit/logs": "workspace:^",
    "@rightkit/onboarding": "workspace:^",
    "@rightkit/platform-ui": "workspace:^",
    "@rightkit/react-shell": "workspace:^",
    "@rightkit/settings-ui": "workspace:^",
    "@rightkit/tauri": "workspace:^",
    "@rightkit/tauri-shell": "workspace:^",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "^1.57.0"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter \"@rightkit/system-ui^...\" run build && vitest run"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/system-ui"
  },
  "packageManager": "pnpm@12.16.1"
}

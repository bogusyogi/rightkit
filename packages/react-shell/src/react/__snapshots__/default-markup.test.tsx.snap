// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Titlebar default markup > macos: traffic-light space and no caption buttons 1`] = `"<header class="rk-top" data-tauri-drag-region="true"><div class="rk-top__side" data-tauri-drag-region="true"><span class="rk-top__lights" data-tauri-drag-region="true"></span><span>S</span></div><div class="rk-top__title" data-tauri-drag-region="true">Doc</div><div class="rk-top__drag" data-tauri-drag-region="true"></div></header>"`;

exports[`Titlebar default markup > minimal: no start, title, end or adapter 1`] = `"<header class="rk-top" data-tauri-drag-region="true"><div class="rk-top__side" data-tauri-drag-region="true"></div><div class="rk-top__drag" data-tauri-drag-region="true"></div></header>"`;

exports[`Titlebar default markup > windows: start, title, end and caption buttons 1`] = `"<header class="rk-top" data-tauri-drag-region="true"><div class="rk-top__side" data-tauri-drag-region="true"><span>S</span></div><div class="rk-top__title" data-tauri-drag-region="true">Doc</div><div class="rk-top__drag" data-tauri-drag-region="true"></div><div class="rk-top__end" data-tauri-drag-region="true"><span>E</span></div><div class="rk-caption"><button type="button" class="rk-caption__btn" title="Minimize window" aria-label="Minimize window"><svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><rect x="0" y="4.5" width="10" height="1" fill="currentColor"></rect></svg></button><button type="button" class="rk-caption__btn" title="Maximize or restore window" aria-label="Maximize or restore window"><svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><rect x="0.5" y="0.5" width="9" height="9" fill="none" stroke="currentColor"></rect></svg></button><button type="button" class="rk-caption__btn rk-caption__close" title="Close window" aria-label="Close window"><svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M0.5 0.5 9.5 9.5M9.5 0.5 0.5 9.5" stroke="currentColor" stroke-width="1"></path></svg></button></div></header>"`;

{
  "name": "@rightkit/document-workspace",
  "version": "0.1.1",
  "description": "Multi-format document workspace shell: tabs, sidebar, document router, loaders, savers and actions.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@rightkit/app-update": "workspace:^",
    "@rightkit/document-core": "workspace:^",
    "@rightkit/docx-editor": "workspace:^",
    "@rightkit/html-editor": "workspace:^",
    "@rightkit/legal": "workspace:^",
    "@rightkit/legal-ui": "workspace:^",
    "@rightkit/license": "workspace:^",
    "@rightkit/markdown-editor": "workspace:^",
    "@rightkit/media-ui": "workspace:^",
    "@rightkit/onboarding": "workspace:^",
    "@rightkit/platform-ui": "workspace:^",
    "@rightkit/react-shell": "workspace:^",
    "@rightkit/settings-ui": "workspace:^",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "1.42.8",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter \"@rightkit/document-workspace^...\" run build && vitest run"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/document-workspace"
  },
  "packageManager": "pnpm@12.16.1"
}

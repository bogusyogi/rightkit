{
  "name": "@rightkit/media-ui",
  "version": "0.3.4",
  "description": "Brand-neutral media player and image viewer/editor for Right Suite apps.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "fabric": "^7.4.0",
    "react": ">=18 <21",
    "react-dom": ">=18 <21",
    "react-image-crop": "^11.1.2"
  },
  "peerDependenciesMeta": {
    "fabric": {
      "optional": true
    },
    "react-image-crop": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rightkit/qa-chrome": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fabric": "^7.4.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-image-crop": "^11.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm --filter @rightkit/qa-chrome run build && node test/browser-e2e.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/media-ui"
  },
  "packageManager": "pnpm@11.24.0"
}

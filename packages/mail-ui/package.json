{
  "name": "@rightkit/mail-ui",
  "version": "0.1.0",
  "description": "Mail client UI: inbox, reader, compose editor, recipients, attachments, account switcher and the mail store.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components/AccountSwitcher": {
      "types": "./dist/components/AccountSwitcher.d.ts",
      "import": "./dist/components/AccountSwitcher.js"
    },
    "./components/Icons": {
      "types": "./dist/components/Icons.d.ts",
      "import": "./dist/components/Icons.js"
    },
    "./hooks/dialog": {
      "types": "./dist/hooks/dialog.d.ts",
      "import": "./dist/hooks/dialog.js"
    },
    "./hooks/useDrive": {
      "types": "./dist/hooks/useDrive.d.ts",
      "import": "./dist/hooks/useDrive.js"
    },
    "./lib/calendarUtils": {
      "types": "./dist/lib/calendarUtils.d.ts",
      "import": "./dist/lib/calendarUtils.js"
    },
    "./lib/ipc": {
      "types": "./dist/lib/ipc.d.ts",
      "import": "./dist/lib/ipc.js"
    },
    "./lib/ipc/agentApprovals": {
      "types": "./dist/lib/ipc/agentApprovals.d.ts",
      "import": "./dist/lib/ipc/agentApprovals.js"
    },
    "./lib/mail": {
      "types": "./dist/lib/mail.d.ts",
      "import": "./dist/lib/mail.js"
    },
    "./lib/preferences": {
      "types": "./dist/lib/preferences.d.ts",
      "import": "./dist/lib/preferences.js"
    },
    "./lib/visibleText": {
      "types": "./dist/lib/visibleText.d.ts",
      "import": "./dist/lib/visibleText.js"
    },
    "./store/index": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./store/types": {
      "types": "./dist/store/types.d.ts",
      "import": "./dist/store/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@rightkit/legal": "workspace:^",
    "@rightkit/legal-ui": "workspace:^",
    "@rightkit/license": "workspace:^",
    "@rightkit/logs": "workspace:^",
    "@rightkit/onboarding": "workspace:^",
    "@rightkit/pdf-ui": "workspace:^",
    "@rightkit/platform-ui": "workspace:^",
    "@rightkit/react-shell": "workspace:^",
    "@rightkit/settings-ui": "workspace:^",
    "@rightkit/theme": "workspace:^",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-font-family": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "^3.4.17",
    "tailwindcss": "4.3.3",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter \"@rightkit/mail-ui^...\" run build && node --import tsx --test \"test/*.test.ts\""
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/mail-ui"
  },
  "packageManager": "pnpm@12.16.1"
}

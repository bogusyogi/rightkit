{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}

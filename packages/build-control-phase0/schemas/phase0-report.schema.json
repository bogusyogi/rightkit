{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rightkit.dev/schemas/build-control-phase0-report-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "status", "inventory", "capacity", "adapters"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "rightkit-build-control-phase0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED_EXTERNAL"] },
    "inventory": { "type": "object" },
    "capacity": { "type": "object" },
    "adapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/adapter" } }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "status", "steps"],
      "properties": {
        "adapter": { "enum": ["cargo", "swiftpm", "node-pnpm", "node-gyp", "cmake", "make", "raw-compiler"] },
        "status": { "enum": ["PASS", "FAIL", "SKIPPED_TOOL_UNAVAILABLE", "BLOCKED_EXTERNAL"] },
        "fixture": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}

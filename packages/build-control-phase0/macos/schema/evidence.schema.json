{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rightkit.build-control-phase0.macos.report/v1",
  "type": "object",
  "required": ["schema", "version", "generatedAt", "status", "machine", "gates", "evidence"],
  "properties": {
    "schema": { "const": "rightkit.build-control-phase0.macos.report/v1" },
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED_EXTERNAL", "PENDING_USER_APPROVAL"] },
    "machine": { "type": "object" },
    "gates": { "type": "array", "items": { "type": "object", "required": ["id", "status", "detail", "evidence"] } },
    "evidence": { "type": "array", "minItems": 8 }
  },
  "additionalProperties": false
}

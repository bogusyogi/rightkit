{
  "name": "@rightkit/legal",
  "version": "0.3.1",
  "packageManager": "pnpm@11.24.0",
  "description": "Legal manifest, assent receipt, and release-contract primitives for proprietary Right Suite desktop apps.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orthic-Labs/rightkit.git",
    "directory": "packages/legal"
  }
}

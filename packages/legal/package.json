{
  "name": "@rightkit/legal",
  "version": "0.6.3",
  "packageManager": "pnpm@11.24.0",
  "description": "Legal manifest, assent receipt, and release-contract primitives for proprietary Right Suite desktop apps.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./tooling": {
      "types": "./dist/tooling.d.ts",
      "import": "./dist/tooling.js"
    }
  },
  "bin": {
    "legal-snapshot": "./bin/legal-snapshot.mjs",
    "generate-npm-license-appendix": "./bin/npm-license-appendix.mjs",
    "rightkit-legal": "./bin/rightkit-legal.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@rightkit/release": "^0.4.1 || ^0.5.0 || ^0.6.0"
  },
  "peerDependenciesMeta": {
    "@rightkit/release": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src && pnpm run test:tooling",
    "test:tooling": "pnpm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/legal"
  },
  "rightkit": {
    "publishCheck": {
      "binSmoke": {
        "legal-snapshot": [
          "--help"
        ],
        "generate-npm-license-appendix": [
          "--help"
        ],
        "rightkit-legal": [
          "--help"
        ]
      }
    }
  }
}

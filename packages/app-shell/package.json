{
  "name": "@rightkit/app-shell",
  "version": "0.5.0",
  "description": "Brand-neutral React frame for Right Suite desktop apps: optional fused sidebar+titlebar layout with slots, command palette, shortcut registry/help, toasts, modals, context menus, ui kit, theme hooks.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./shell.css": "./shell.css",
    "./suite-aliases.css": "./suite-aliases.css"
  },
  "files": [
    "dist",
    "shell.css",
    "suite-aliases.css",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@rightkit/platform-ui": ">=0.2.1 <1",
    "@tauri-apps/plugin-os": ">=2 <3",
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "devDependencies": {
    "@rightkit/platform-ui": "workspace:*",
    "@rightkit/qa-chrome": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter \"@rightkit/app-shell^...\" run build",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/app-shell"
  },
  "packageManager": "pnpm@11.24.0",
  "peerDependenciesMeta": {
    "@tauri-apps/plugin-os": {
      "optional": true
    }
  }
}

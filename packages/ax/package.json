{
  "name": "@rightkit/ax",
  "version": "0.3.2",
  "description": "Suite-wide agent-experience (AX) + agent-plugins.org conformance layer: plugin scaffolding/validation and AXA-1 static/conformance/behavioral gates over one product's MCP/CLI surface.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "right-ax": "cli/right-ax.mjs"
  },
  "rightkit": {
    "publishCheck": {
      "binSmoke": {
        "right-ax": [
          "--version"
        ]
      }
    }
  },
  "exports": {
    "./manifest": "./manifest.mjs",
    "./ax/static": "./ax/static.mjs",
    "./ax/conformance": "./ax/conformance.mjs",
    "./ax/behavioral": "./ax/behavioral.mjs",
    "./ax/adversarial": "./ax/adversarial.mjs",
    "./ax/ownership-review": "./ax/ownership-review.mjs",
    "./ax/report": "./ax/report.mjs",
    "./plugin/scaffold": "./plugin/scaffold.mjs",
    "./plugin/validate": "./plugin/validate.mjs",
    "./plugin/portable-core": "./plugin/portable-core.mjs",
    "./plugin/hooks": "./plugin/hooks.mjs",
    "./plugin/skill-gate": "./plugin/skill-gate.mjs",
    "./plugin/marketplace": "./plugin/marketplace.mjs"
  },
  "files": [
    "cli",
    "plugin",
    "ax",
    "lib",
    "adopt.mjs",
    "manifest.mjs",
    "manifest.schema.json"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test --test-concurrency=1 *.test.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/ax"
  },
  "packageManager": "pnpm@11.25.0"
}

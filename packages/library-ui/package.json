{
  "name": "@rightkit/library-ui",
  "version": "0.1.0",
  "description": "Library and queue UI for transcripts and downloads: queue board, job cards, library list, detail reader and history.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.css": "./dist/*.css",
    "./*.json": "./dist/*.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@rightkit/app-update": "workspace:^",
    "@rightkit/dictation-ui": "workspace:^",
    "@rightkit/doc-render": "workspace:^",
    "@rightkit/license": "workspace:^",
    "@rightkit/media-ui": "workspace:^",
    "@rightkit/platform-ui": "workspace:^",
    "@rightkit/react-shell": "workspace:^",
    "@rightkit/settings-ui": "workspace:^",
    "@rightkit/tauri-shell": "workspace:^",
    "@rightkit/theme": "workspace:^",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-process": "~2.4.0",
    "lucide-react": "^1.34.0"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "devDependencies": {
    "@rightkit/qa": "workspace:^",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter \"@rightkit/library-ui^...\" run build && node --import tsx --test \"test/queue/*.test.ts\""
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/library-ui"
  },
  "packageManager": "pnpm@12.16.1"
}

{
  "name": "@rightkit/hooks",
  "version": "0.1.2",
  "description": "Neutral lifecycle runtime shared by independently installable agent systems.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "lib/runtime.mjs",
  "exports": {
    ".": "./lib/runtime.mjs"
  },
  "bin": {
    "rightkit-hooks": "./bin/rightkit-hooks.mjs"
  },
  "rightkit": {
    "publishCheck": {
      "binSmoke": {
        "rightkit-hooks": {
          "args": [],
          "exitCode": 64,
          "output": "usage: rightkit-hooks"
        }
      }
    }
  },
  "files": [
    "bin",
    "lib",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/hooks"
  },
  "packageManager": "pnpm@11.24.0"
}

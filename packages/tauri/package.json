{
  "name": "@rightkit/tauri",
  "version": "0.3.0",
  "description": "Typed host adapters for shared Right Suite Tauri commands.",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "rightkit": {
    "publishCheck": {
      "skipImport": [
        "./dialog"
      ]
    }
  },
  "dependencies": {
    "@rightkit/logs": "^0.1.6"
  },
  "peerDependencies": {
    "@rightkit/app-update": ">=0.2.5 <0.5",
    "@tauri-apps/plugin-dialog": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/plugin-dialog": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:contracts": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext type-tests/contract.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/tauri"
  }
}

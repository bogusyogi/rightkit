{
  "name": "@rightkit/git",
  "version": "0.2.20",
  "description": "Public-repo-only GitHub Actions workflow layer: templates, visibility gate, sync/drift/adopt/uninstall for right-git.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "right-git": "cli/right-git.mjs"
  },
  "files": [
    "cli",
    "policy",
    "templates",
    "*.mjs",
    "*.json"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test *.test.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/claude.git",
    "directory": "tools/rightkit/packages/git"
  },
  "packageManager": "pnpm@11.24.0"
}

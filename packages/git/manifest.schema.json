{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rightkit.dev/schemas/rightgit-manifest-v1.json",
  "title": "right-git per-repo manifest (.rightgit.json)",
  "description": "Declares which right-git lanes a public repo installs and how templates should be parameterized. Hand-validated by manifest.mjs — this file documents the contract, it is not fed to a JSON Schema validator at runtime.",
  "type": "object",
  "required": ["schemaVersion", "compile", "lanes", "matrix", "packageManager", "templateVersion"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "compile": {
      "const": "github-actions-only"
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "ci",
          "qualification",
          "package-smoke",
          "release-candidate",
          "publish-npm",
          "publish-package-managers"
        ]
      }
    },
    "matrix": {
      "type": "object",
      "required": ["os", "node"],
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "node": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "packageManager": {
      "type": "string",
      "pattern": "^(pnpm|npm|yarn)@\\d+\\.\\d+\\.\\d+$"
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": {
          "type": "object",
          "required": ["oidc", "provenance"],
          "additionalProperties": false,
          "properties": {
            "oidc": { "type": "boolean", "const": true },
            "provenance": { "type": "boolean" }
          }
        },
        "homebrew": {
          "type": "object",
          "required": ["tap", "formulaName"],
          "additionalProperties": false,
          "properties": {
            "tap": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
            "formulaName": { "type": "string", "minLength": 1 }
          }
        },
        "winget": {
          "type": "object",
          "required": ["packageIdentifier"],
          "additionalProperties": false,
          "properties": {
            "packageIdentifier": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "templateVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
    ,"ownership": {
      "type": "object",
      "required": ["roots"],
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:\\.|(?!.*\\.\\.)(?!.*\\\\)(?!.*\\s)[A-Za-z0-9][A-Za-z0-9._/-]*)$" }
        }
      }
    }
    ,"profile": { "enum": ["node", "rust-hybrid"] },
    "rustCache": {
      "type": "object",
      "required": ["workspaces"],
      "additionalProperties": false,
      "properties": {
        "workspaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:\\.|(?!.*\\.\\.)(?!.*\\s)[A-Za-z0-9][A-Za-z0-9._/-]*)$" }
        },
        "requiredForGate": { "type": "boolean" }
      }
    },
    "gate": {
      "type": "object", "required": ["path"], "additionalProperties": false,
      "properties": { "path": { "type": "string", "pattern": "^(?!.*\\.\\.)(?!.*\\s)[A-Za-z0-9][A-Za-z0-9._/-]*$" } }
    },
    "qaEvidencePath": {
      "type": "string",
      "description": "rust-hybrid only. Safe relative path under $RUNNER_TEMP where the gate writes QA evidence; rendered as ${{ runner.temp }}/<path> and uploaded with if: always().",
      "pattern": "^(?!.*\\.\\.)(?!.*\\s)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "qaEvidenceRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90,
      "default": 7,
      "description": "rust-hybrid only, requires qaEvidencePath. Artifact retention in days."
    },
    "ciAllOs": {
      "type": "boolean",
      "default": false,
      "description": "rust-hybrid only. When true, the ci job runs the gate on every matrix.os runner in declared order (fail-fast: false). When false or unset, the ci job uses one runner (preferring the first windows-* entry, else the first matrix.os entry)."
    },
    "ciIncremental": {
      "type": "boolean",
      "default": false,
      "description": "rust-hybrid only. When true, the ci job uses Swatinem/rust-cache with cache-workspace-crates, CARGO_INCREMENTAL=1, and caches Xcode DerivedData on macOS legs."
    },
    "devArtifact": {
      "type": "object",
      "additionalProperties": false,
      "description": "rust-hybrid only. Dev builds on push to the default branch (never PRs). mac 'sign' Developer ID-signs (no notarization) in a separate job using the release environment; windows 'unsigned' uploads built files as-is.",
      "properties": {
        "mac": { "enum": ["sign", "none"] },
        "windows": { "enum": ["unsigned", "none"] },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 90, "default": 7 },
        "macAppPath": { "type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/ -]*\\.app$", "description": "Repository-relative path of the built .app (required when mac is 'sign')." },
        "macEntitlements": { "type": "string", "pattern": "^(?!.*\\.\\.)(?!.*\\s)[A-Za-z0-9][A-Za-z0-9._/-]*$", "description": "Optional repository-relative entitlements plist for codesign." },
        "windowsGlob": { "type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/*?-]*$", "description": "Repository-relative glob of built files to upload (required when windows is 'unsigned')." }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["buildScript", "checkScript", "admissionScript", "stageSummaryScript", "artifactRoot", "os"],
      "additionalProperties": false,
      "properties": {
        "buildScript": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$" },
        "checkScript": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$" },
        "admissionScript": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$",
          "description": "Runs in the unconditional `admission` job (workflow_dispatch envelope validation). Required for every release-candidate lane, signed or not."
        },
        "stageSummaryScript": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$",
          "description": "Runs (init/finalize) in the `candidate` job and, when configured, the windows-sign/macos-sign jobs. Required for every release-candidate lane, signed or not."
        },
        "artifactRoot": { "type": "string", "pattern": "^(?!.*\\.\\.)(?!.*\\s)[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        "os": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["os", "platform", "architecture"],
            "additionalProperties": false,
            "properties": {
              "os": { "type": "string", "minLength": 1 },
              "platform": { "enum": ["windows", "macos", "linux"] },
              "architecture": { "enum": ["x86_64", "arm64"] }
            }
          }
        },
        "signWindows": { "type": "boolean" },
        "signMacos": { "type": "boolean" },
        "releaseChain": {
          "type": "object",
          "required": ["evidenceVerificationScript", "windowsFinalizeScript", "installedQualificationScript", "publishScript", "qualificationRunnerVariable"],
          "additionalProperties": false,
          "properties": {
            "evidenceVerificationScript": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$",
              "description": "Runs in the `publish` job before the publish step, verifying the aggregated same-run signed/qualification evidence."
            },
            "windowsFinalizeScript": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$" },
            "macosFinalizeScript": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$" },
            "installedQualificationScript": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$" },
            "publishScript": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$" },
            "qualificationRunnerVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "publishSecrets": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
            }
          }
        }
      }
    }
  }
}

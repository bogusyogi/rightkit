{
  "name": "@rightkit/social-ui",
  "version": "0.1.1",
  "description": "Social media management UI: accounts, drafts, approvals and analytics screens with their data layer.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./data/source": {
      "types": "./dist/data/source.d.ts",
      "import": "./dist/data/source.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@rightkit/platform-ui": "workspace:^",
    "@rightkit/react-shell": "workspace:^",
    "@rightkit/tauri-shell": "workspace:^",
    "@tauri-apps/api": "^2.12.4"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/social-ui"
  },
  "packageManager": "pnpm@12.16.1"
}

{
  "name": "@rightkit/legal-ui",
  "version": "0.4.0",
  "description": "The one first-run / re-acceptance legal gate screen for Right Suite desktop apps.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legal-ui.css": "./legal-ui.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "CHANGELOG.md",
    "legal-ui.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview:build": "node preview/build.mjs",
    "preview:verify": "pnpm run build && pnpm run preview:build && node preview/verify.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/legal-ui"
  },
  "packageManager": "pnpm@11.24.0"
}

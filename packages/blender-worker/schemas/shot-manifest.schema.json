{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renderright:shot-manifest.schema.json",
  "title": "RenderRight generated-source shot manifest",
  "type": "object",
  "required": ["schema", "type", "job_id", "worker_version", "blender_version", "recipe", "source", "fps", "artifacts", "shots"],
  "properties": {
    "schema": {"const": 1},
    "type": {"const": "generated_source"},
    "job_id": {"type": "string"},
    "worker_version": {"type": "string"},
    "blender_version": {"type": "string"},
    "recipe": {"type": "object", "required": ["id", "version", "sha256"], "properties": {"id": {"enum": ["hero", "turntable", "exploded", "film"]}, "version": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "source": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "fps": {"type": "object", "required": ["num", "den"], "properties": {"num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["id", "path", "mime", "sha256", "bytes", "role"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "mime": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}, "role": {"enum": ["movie", "hero"]}}, "additionalProperties": false}},
    "shots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "start_frame", "end_frame", "source_start_frame", "camera", "artifact_id", "source_sha256", "regen"], "properties": {
      "id": {"type": "string"}, "start_frame": {"type": "integer", "minimum": 0}, "end_frame": {"type": "integer", "minimum": 1}, "source_start_frame": {"type": "integer", "minimum": 0},
      "camera": {"type": "object"}, "artifact_id": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "regen": {"type": "object", "required": ["provider", "model", "params"], "properties": {"provider": {"const": "local-blender"}, "model": {"type": "string"}, "params": {"type": "object", "properties": {
        "mechanism_json": {"type": ["string", "null"]}, "mechanism_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "shot_id": {"enum": ["establish", "top_detail", "profile", "hero"]}, "prompt": {"type": "string", "maxLength": 4000},
        "camera": {"type": "object", "properties": {"lens_mm": {"type": "number", "minimum": 15, "maximum": 200}, "azimuth_deg": {"type": "number", "minimum": -360, "maximum": 360}, "elevation_deg": {"type": "number", "minimum": -89, "maximum": 89}, "distance_scale": {"type": "number", "minimum": 0.25, "maximum": 4}}, "additionalProperties": false},
        "shot_start_frame": {"type": "integer", "minimum": 0}, "source_frame_count": {"type": "integer", "minimum": 1, "maximum": 1200}
      }, "additionalProperties": true}}, "additionalProperties": false}
    }, "additionalProperties": true}}
  },
  "additionalProperties": true
}

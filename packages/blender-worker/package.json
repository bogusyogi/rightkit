{
  "name": "@rightkit/blender-worker",
  "version": "0.1.1",
  "description": "Blender render worker (Python): job protocol, scene authoring, product review and look development, shipped as source for a host to install.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./schemas/job.schema.json": "./schemas/job.schema.json",
    "./schemas/result-manifest.schema.json": "./schemas/result-manifest.schema.json",
    "./schemas/shot-manifest.schema.json": "./schemas/shot-manifest.schema.json",
    "./schemas/worker-manifest.schema.json": "./schemas/worker-manifest.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "schemas",
    "worker",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/blender-worker"
  }

{
  "name": "@rightkit/onboarding",
  "version": "0.3.3",
  "description": "First-run onboarding framework: ordered steps, progress, skip/resume, legal gate first, permissions, model download and licence/trial steps.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./onboarding.css": "./onboarding.css"
  },
  "files": [
    "dist",
    "onboarding.css",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@rightkit/react-shell": ">=0.2.0 <1",
    "@rightkit/legal-ui": ">=0.1.2 <1",
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@rightkit/react-shell": "workspace:*",
    "@rightkit/legal-ui": "workspace:*",
    "@rightkit/qa-chrome": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^25.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter \"@rightkit/onboarding^...\" run build",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orthic-Labs/rightkit.git",
    "directory": "packages/onboarding"
  },
  "packageManager": "pnpm@11.24.0"
}

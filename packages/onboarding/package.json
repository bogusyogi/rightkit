{
  "name": "@rightkit/onboarding",
  "version": "0.1.0",
  "description": "First-run onboarding framework: ordered steps, progress, skip/resume, legal gate first, permissions, model download and licence/trial steps.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./onboarding.css": "./onboarding.css"
  },
  "files": ["dist", "onboarding.css", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "sideEffects": ["*.css"],
  "peerDependencies": {
    "@rightkit/app-shell": ">=0.1.0 <1",
    "@rightkit/legal-ui": ">=0.1.0",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@rightkit/app-shell": "workspace:*",
    "@rightkit/legal-ui": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/claude.git",
    "directory": "tools/rightkit/packages/onboarding"
  },
  "packageManager": "pnpm@11.24.0"
}

{
  "name": "@rightkit/agent-ui-web",
  "version": "0.1.0",
  "description": "Browser client for a coding-agent daemon: transcript, input bar, diff, model and usage panels.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.css": "./dist/*.css",
    "./*.json": "./dist/*.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node app/scripts/test-auth-url-safety.mjs && node app/scripts/test-markdown-security.mjs && node app/scripts/test-message-payload.mjs && node app/scripts/test-session-events.mjs && node app/scripts/test-session-message-body.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/agent-ui-web"
  },
  "packageManager": "pnpm@12.16.1"
}

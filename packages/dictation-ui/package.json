{
  "name": "@rightkit/dictation-ui",
  "version": "0.3.0",
  "description": "Headless dictation controls, setup hooks and recording pill behavior for host-rendered interfaces.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pill": {
      "types": "./dist/pill/index.d.ts",
      "import": "./dist/pill/index.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding/index.d.ts",
      "import": "./dist/onboarding/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@rightkit/library-ui": "workspace:^",
    "@rightkit/platform-ui": "workspace:^",
    "@rightkit/settings-ui": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/dictation-ui"
  },
  "packageManager": "pnpm@12.16.1"
}

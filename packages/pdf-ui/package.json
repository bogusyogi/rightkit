{
  "name": "@rightkit/pdf-ui",
  "version": "0.1.0",
  "description": "Brand-neutral read-only PDF viewer (pdf.js) for Right Suite apps.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": ["dist", "styles.css", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "sideEffects": ["*.css"],
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "node test/browser-e2e.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/claude.git",
    "directory": "tools/rightkit/packages/pdf-ui"
  },
  "packageManager": "pnpm@11.24.0"
}

// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PdfViewer default markup > renders the default toolbar, find bar and page region 1`] = `"<div class="rk-pdf-viewer " data-loading="true"><div class="rk-pdf-toolbar"><button type="button" disabled="" aria-label="Previous page">‹</button><form><input aria-label="Page number" value="1"/><span>/ —</span></form><button type="button" disabled="" aria-label="Next page">›</button><button type="button" aria-label="Zoom out">−</button><form><input aria-label="Zoom percentage" value="100"/>%</form><button type="button" aria-label="Zoom in">+</button><button type="button" aria-label="Fit width">Fit</button><button type="button" aria-label="Rotate">↻</button><button type="button" aria-pressed="false">Outline</button><button type="button" aria-pressed="false">Pages</button><form class="rk-pdf-find"><input aria-label="Find in PDF" placeholder="Find" value=""/><button type="submit">Find</button><button type="button" disabled="">Next</button></form></div><div class="rk-pdf-body"><div class="rk-pdf-scroll" role="region" aria-label="PDF pages" tabindex="0"><div class="rk-pdf-pages"></div></div></div></div>"`;

exports[`PdfViewer default markup > renders the outline panel and a render cap from the initial view 1`] = `"<div class="rk-pdf-viewer " data-loading="true"><div class="rk-pdf-toolbar"><button type="button" aria-label="Previous page">‹</button><form><input aria-label="Page number" value="2"/><span>/ —</span></form><button type="button" disabled="" aria-label="Next page">›</button><button type="button" aria-label="Zoom out">−</button><form><input aria-label="Zoom percentage" value="150"/>%</form><button type="button" aria-label="Zoom in">+</button><button type="button" aria-label="Fit width">Fit</button><button type="button" aria-label="Rotate">↻</button><button type="button" aria-pressed="true">Outline</button><button type="button" aria-pressed="false">Pages</button><form class="rk-pdf-find"><input aria-label="Find in PDF" placeholder="Find" value=""/><button type="submit">Find</button><button type="button" disabled="">Next</button></form></div><div class="rk-pdf-body"><aside class="rk-pdf-outline" aria-label="PDF outline"><ul></ul></aside><div class="rk-pdf-scroll" role="region" aria-label="PDF pages" tabindex="0"><div class="rk-pdf-pages"></div></div></div></div>"`;

exports[`PdfViewer default markup > renders with the find bar hidden 1`] = `"<div class="rk-pdf-viewer " data-loading="true"><div class="rk-pdf-toolbar"><button type="button" disabled="" aria-label="Previous page">‹</button><form><input aria-label="Page number" value="1"/><span>/ —</span></form><button type="button" disabled="" aria-label="Next page">›</button><button type="button" aria-label="Zoom out">−</button><form><input aria-label="Zoom percentage" value="100"/>%</form><button type="button" aria-label="Zoom in">+</button><button type="button" aria-label="Fit width">Fit</button><button type="button" aria-label="Rotate">↻</button><button type="button" aria-pressed="false">Outline</button><button type="button" aria-pressed="false">Pages</button></div><div class="rk-pdf-body"><div class="rk-pdf-scroll" role="region" aria-label="PDF pages" tabindex="0"><div class="rk-pdf-pages"></div></div></div></div>"`;

exports[`PdfViewer default markup > renders with the toolbar hidden and a host toolbar slot 1`] = `"<div class="rk-pdf-viewer host" data-loading="true"><div class="rk-pdf-body"><div class="rk-pdf-scroll" role="region" aria-label="PDF pages" tabindex="0"><div class="rk-pdf-pages"></div></div></div></div>"`;

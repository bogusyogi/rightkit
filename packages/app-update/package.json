{
  "name": "@rightkit/app-update",
  "version": "0.2.5",
  "description": "Shared runtime update policy helper for Right Suite Tauri apps.",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract-vectors": {
      "types": "./dist/contract-vectors.d.ts",
      "import": "./dist/contract-vectors.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orthic-Labs/rightkit.git",
    "directory": "packages/app-update"
  }
}

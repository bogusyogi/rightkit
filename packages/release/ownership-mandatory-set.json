  "appAmendments": {
    "ember": {
      "issue": "Orthic-Labs/rightkit#280",
      "source": "Orthic-Labs/ember#240 port to the mandatory set",
      "profile": "desktop",
      "note": "App-specific not-applicable rulings, ratified for Ember. An app declares them in rightkit-mandatory.json notApplicable with the reason given here. Free and open source apps (MIT OR Apache-2.0, no paid features, activation or signer) and apps with no daemon, no SQLite state and no restart-surviving jobs owe none of these rows.",
      "notApplicable": {
        "M3": "No engine child process and no restart-surviving jobs: exports and imports are in-process jobs on the activity stack. The ffmpeg sidecar already runs through rightkit-ffmpeg.",
        "M4": "No engine child process and no restart-surviving jobs: exports and imports are in-process jobs on the activity stack.",
        "M6": "No local service or daemon-discovered data location. The control channel and MCP are opt-in developer and agent ports.",
        "M7": "No local service or daemon-discovered data location. The control channel and MCP are opt-in developer and agent ports.",
        "M9": "No SQLite app state. Preferences are JSON through rightkit-app-settings; the photo catalog is a JSON-lines journal.",
        "M12": "Free and open source (MIT OR Apache-2.0): no paid features, activation or signer. rightkit-device identity is adopted. Applies to OSS apps.",
        "M13": "Free and open source (MIT OR Apache-2.0): no paid features, activation or signer. Applies to OSS apps.",
        "M14": "@rightkit/legal needs six proprietary roles and imports node:crypto, so it cannot run in a webview; @rightkit/onboarding mandates a legal step first. Ember ships @rightkit/legal-ui for its licences and notices and holds its first-run notice until its text is approved. OSS profile; the legal and onboarding owners need an OSS mode and a mode without a legal step.",
        "M22": "rightkit-agent-tools needs a daemon-backed app control service. Ember's agent surface is its own MCP server over engine command ids, being ported to rightkit-mcp. Applies to non-daemon apps."
      }
    }
  },

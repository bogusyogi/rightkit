{
  "name": "@rightkit/release",
  "version": "0.6.46",
  "description": "Portable release CLI/SDK with fail-closed public GitHub Releases and private R2 + RightApps distribution.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "right-release": "cli/right-release.mjs",
    "rightkit-gate": "bin/rightkit-gate.mjs",
    "rightkit-linux-setup": "bin/rightkit-linux-setup.mjs",
    "rightkit-agent-hook": "bin/rightkit-agent-hook.mjs"
  },
  "exports": {
    "./bin/rightkit-agent-hook.mjs": "./bin/rightkit-agent-hook.mjs",
    "./bin/rightkit-gate.mjs": "./bin/rightkit-gate.mjs",
    "./bin/rightkit-linux-setup.mjs": "./bin/rightkit-linux-setup.mjs",
    "./cargo-contract.mjs": "./cargo-contract.mjs",
    "./cargo-target.mjs": "./cargo-target.mjs",
    "./cli/right-release.mjs": "./cli/right-release.mjs",
    "./development.mjs": "./development.mjs",
    "./direct-bootstrap.mjs": "./direct-bootstrap.mjs",
    "./disk-policy.mjs": "./disk-policy.mjs",
    "./dmg-build.mjs": "./dmg-build.mjs",
    "./door.mjs": "./door.mjs",
    "./engine-locator.mjs": "./engine-locator.mjs",
    "./github-release.mjs": "./github-release.mjs",
    "./legal-contract.mjs": "./legal-contract.mjs",
    "./linux-setup.mjs": "./linux-setup.mjs",
    "./macos-file-evidence.mjs": "./macos-file-evidence.mjs",
    "./macos-notarization.mjs": "./macos-notarization.mjs",
    "./macos-signing-identity.mjs": "./macos-signing-identity.mjs",
    "./macos-signing-session.mjs": "./macos-signing-session.mjs",
    "./managed-cargo.mjs": "./managed-cargo.mjs",
    "./native-release-finalization.mjs": "./native-release-finalization.mjs",
    "./notary-auth.mjs": "./notary-auth.mjs",
    "./package.json": "./package.json",
    "./packaged-app-identity.mjs": "./packaged-app-identity.mjs",
    "./pe-content.mjs": "./pe-content.mjs",
    "./publication-gate.mjs": "./publication-gate.mjs",
    "./qa-build-features.mjs": "./qa-build-features.mjs",
    "./release-dependencies.mjs": "./release-dependencies.mjs",
    "./sign-windows.mjs": "./sign-windows.mjs",
    "./signing-agent-client.mjs": "./signing-agent-client.mjs",
    "./stage-binary.mjs": "./stage-binary.mjs",
    "./stage-sidecar.mjs": "./stage-sidecar.mjs",
    "./supply-chain-evidence.mjs": "./supply-chain-evidence.mjs",
    "./tauri-bundle-marker.mjs": "./tauri-bundle-marker.mjs"
  },
  "rightkit": {
    "publishCheck": {
      "skipImport": [],
      "binSmoke": {
        "right-release": [
          "--version"
        ],
        "rightkit-gate": [
          "--version"
        ],
        "rightkit-linux-setup": [
          "--version"
        ],
        "rightkit-agent-hook": {
          "args": [],
          "output": "{}"
        }
      }
    }
  },
  "files": [
    "cli",
    "bin",
    "templates",
    "*.mjs",
    "*.json",
    "deny-default.toml",
    "*.sh",
    "msix-repair-guard.ps1",
    "bin/darwin/rightkit-swap",
    "*.py",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "!*.test.mjs",
    "!cli/*.test.mjs",
    "!standalone-clone-evidence.json",
    "!refusals.json",
    "!provenance-real-receipt.fixture.json"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test affected-units.test.mjs batch-workspace.test.mjs unit-list-compile.test.mjs snapshot-dependency-reuse.test.mjs publisher-requirement-scan.test.mjs node-check-cache.test.mjs preparation-diagnostics.test.mjs gate-coverage-timing.test.mjs failure-class.test.mjs cargo-width.test.mjs ci-compile-admission.test.mjs ownership-mark-note.test.mjs handle-revocation.test.mjs test-run-output.test.mjs ownership-auto-recover.test.mjs",
    "test:registry-parity": "node registry-parity.mjs --allow-unpublished",
    "test:signer:windows": "node sign-release-manifest.integration.mjs",
    "prepublishOnly": "pnpm test:signer:windows && pnpm test:registry-parity",
    "verify:standalone": "node standalone-clone-verify.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/release"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@rightkit/outdated": "0.3.0",
    "smol-toml": "1.9.1"
  }
}

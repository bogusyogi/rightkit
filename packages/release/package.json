{
  "name": "@rightkit/release",
  "version": "0.6.5",
  "description": "Portable release CLI/SDK with fail-closed public GitHub Releases and private R2 + RightApps distribution.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "right-release": "cli/right-release.mjs",
    "rightkit-gate": "bin/rightkit-gate.mjs"
  },
  "rightkit": {
    "publishCheck": {
      "binSmoke": {
        "right-release": [
          "--version"
        ],
        "rightkit-gate": [
          "--version"
        ]
      }
    }
  },
  "files": [
    "cli",
    "bin",
    "templates",
    "*.mjs",
    "*.json",
    "*.sh",
    "msix-repair-guard.ps1",
    "bin/darwin/rightkit-swap",
    "*.py",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "!*.test.mjs",
    "!standalone-clone-evidence.json",
    "!refusals.json"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --import ./test-support/broker-guard.mjs --test --test-concurrency=1 --test-force-exit *.test.mjs cli/*.test.mjs",
    "test:registry-parity": "node registry-parity.mjs --allow-unpublished",
    "test:signer:windows": "node sign-release-manifest.integration.mjs",
    "prepublishOnly": "pnpm test && pnpm test:signer:windows && pnpm test:registry-parity",
    "doctor:all": "node --test right-suite-contract.test.mjs",
    "verify:standalone": "node standalone-clone-verify.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogusyogi/rightkit.git",
    "directory": "packages/release"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "smol-toml": "1.9.1"
  }
}

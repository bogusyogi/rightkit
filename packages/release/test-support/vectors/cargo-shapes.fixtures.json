{
  "schema": "rustright.cargo-shapes.fixtures.v1",
  "note": "GB-01/GB-02/GB-67 shared vectors. Owner: RustRight (the admitted grammar); consumer: RightKit's command-shape table, wrapper and planners must accept exactly the rows the broker accepts. Every row is evaluated by the production parser in rustright-policy (tests/cargo_shapes.rs): normalize_build_request, then ThinCommandPolicy::classify, then command_policy::{grant_command, carried_refusal}, then build_rules::test_run_refusal. argv excludes the leading `cargo`. `normalizedArgv` is normalize_build_request's output: the standard aliases b c d r t expanded, nothing else. `spawnedArgv`, present only where it differs from `normalizedArgv`, is what the broker's per-request rewrites then make of it, in the broker's order (BR29 every_failure_cargo_argv: --keep-going for build, check, clippy and doc, --no-fail-fast for test and bench; release_profile_argv: --profile release; compile_only_test_argv: --no-run for test and bench), before the per-host pins (--target, --target-dir) that need a registered triple and a workspace. `refused` rows carry the typed code the broker answers with and run zero processes. `grant` is accepted by a stage grant's allowlist; `compile` is the broker's compile classification (the receipt then carries freshness, attribution and toolchain evidence, or typed unavailable evidence). The broker carries compiles only (BROKER-CONTRACT interface item 14, GC-A11): a snapshot-bound request that compiles nothing is refused at admission whatever its argv, so no row says whether a non-compiling call is carried, and a `grant` of true on one is the allowlist's answer, not an admission.",
  "aliases": {"b": "build", "c": "check", "d": "doc", "r": "run", "t": "test"},
  "rows": [
    {"name": "alias b", "argv": ["b", "--locked"], "normalizedArgv": ["build", "--locked"], "spawnedArgv": ["build", "--profile", "release", "--keep-going", "--locked"], "command": "build", "compile": true, "grant": true, "carriedRefusal": false},
    {"name": "alias c", "argv": ["c"], "normalizedArgv": ["check"], "spawnedArgv": ["check", "--profile", "release", "--keep-going"], "command": "check", "compile": true, "grant": false, "carriedRefusal": false},
    {"name": "alias t with package", "argv": ["t", "-p", "x"], "normalizedArgv": ["test", "-p", "x"], "spawnedArgv": ["test", "--no-run", "--profile", "release", "--no-fail-fast", "-p", "x"], "command": "test", "compile": true, "grant": false, "carriedRefusal": false},
    {"name": "alias r locked", "argv": ["r", "--locked"], "normalizedArgv": ["run", "--locked"], "spawnedArgv": ["run", "--profile", "release", "--locked"], "command": "run", "compile": true, "grant": true, "carriedRefusal": false},
    {"name": "alias d", "argv": ["d"], "normalizedArgv": ["doc"], "spawnedArgv": ["doc", "--profile", "release", "--keep-going"], "command": "doc", "compile": true, "grant": false, "carriedRefusal": false},

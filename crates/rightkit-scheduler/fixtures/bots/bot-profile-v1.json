{
  "schemaVersion": 1,
  "id": "bot-reviewer",
  "name": "Review Bot",
  "rolePack": "reviewer.v1",
  "model": "catalog/reviewer",
  "project": "current",
  "tools": ["read_file", "search"],
  "permissions": ["fs.read"],
  "browser": {"mode": "disabled", "profile": null, "allowNetwork": false},
  "budget": {"maxTokens": 32000, "maxSeconds": 900, "maxCostMicros": 2000000},
  "verifier": {"rolePack": "verifier.v1", "model": "catalog/verifier", "required": true},
  "concurrency": "queue-one",
  "concurrencyCap": 1,
  "triggers": [
    {"id": "daily-review", "schedule": "cron", "expression": "0 9 * * *", "paused": true}
  ]
}

      "depends_on": []
    },
    {
      "id": "review_clip",
      "kind": "avatar",
      "route": "ask",
      "params": {
        "prompt": {"input": "prompt", "type": "text"},
        "image_url": {"input": "character_image", "type": "image"},
        "audio_url": {"node": "speech", "type": "audio"},
        "duration": 15
      },
      "depends_on": ["speech"]
    }
  ],
  "outputs": [{"name": "clip", "from": "review_clip"}],
  "review": {
    "required": true,
    "policy": "Default: review required. The per-recipe review policy (plan :92) is not yet expressed per recipe in the source. The 15-second duration is the plan's figure."
  }

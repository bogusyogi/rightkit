{
  "schema_version": "1.0.0",
  "id": "ugc_character_review_15s",
  "title": "15-second UGC character review: a character speaks a review script",
  "source": {
    "template": "none in the repository: no prompt, route or node content",
    "plan": "docs/plans/2026-10-08-genright-execution-plan.md:143-144 (G11 names the 15-second UGC character review)"
  },
  "inputs": [
    {"name": "character_image", "type": "image"},
    {"name": "script_text", "type": "text"},
    {"name": "prompt", "type": "text"}

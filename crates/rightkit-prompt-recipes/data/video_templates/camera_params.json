{
 "_meta": {
  "version": "1.0.0",
  "issue": "bogusyogi/genright#279",
  "principle": "Per-model parameter overlay. The prompt text is always kept (fallback); params are additive. Adapters apply params only when support status is 'documented', or 'unverified' with an explicit opt-in.",
  "sources": {
   "kling_camera_control": "Kling API camera_control {type: simple|down_back|forward_up|right_turn_forward|left_turn_forward, config:{horizontal,vertical,pan,tilt,roll,zoom}}, simple needs exactly one non-zero axis (range -10..10 from Kling API docs, via https://docs.comfy.org/built-in-nodes/partner-node/video/kwai_vgi/kling-camera-controls). Sign convention per that page: zoom negative narrows FOV (push in), pan positive = up, tilt positive = right. Not every Kling model/mode supports it; fal Kling v1.6 pro i2v schema has no camera_control (https://fal.ai/models/fal-ai/kling-video/v1.6/pro/image-to-video/api).",
   "seedance_camera_fixed": "Boolean camera_fixed 'Whether to fix the camera position' on fal ByteDance Seedance v1 pro i2v (https://fal.ai/models/fal-ai/bytedance/seedance/v1/pro/image-to-video/api). Not verified for Seedance 2.",
   "veo": "Veo exposes no camera parameter (Gemini API / fal veo3.1 schemas); camera is prompt-only. Not fetched this pass, treat as unverified negative.",
   "wan_happy": "WaveSpeed Wan / HappyHorse image-to-video adapters take no camera parameter; prompt-only."
  }
 },
 "models": {
  "kling-3-pro": {
   "family": "kling",
   "param": "kling_camera_control",
   "request_field": "camera_control",
   "status": "unverified"
  },
  "seedance-2-fast": {
   "family": "seedance",
   "param": "seedance_camera_fixed",
   "request_field": "camera_fixed",
   "status": "unverified"
  }
 },
 "families_prompt_only": [
  "veo",
  "wan",
  "happy"
 ],
 "effects": {
  "note": "Transition and text-overlay effect templates have no native provider parameter on any served model; they stay prompt/post-process only.",
  "native": []
 },

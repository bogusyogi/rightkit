{
  "_meta": {
    "model_slug": "imagen-4-standard",
    "version": "1.0.0",
    "official_doc_url": "https://docs.cloud.google.com/vertex-ai/generative-ai/docs/models/imagen/4-0-generate",
    "schema_last_verified": "2026-05-05",
    "research_sources": [
      "https://docs.cloud.google.com/vertex-ai/generative-ai/docs/models/imagen/4-0-generate",
      "https://docs.cloud.google.com/vertex-ai/generative-ai/docs/image/configure-aspect-ratio",
      "https://docs.cloud.google.com/vertex-ai/generative-ai/docs/image/img-gen-prompt-guide",
      "https://ai.google.dev/gemini-api/docs/imagen"
    ],
    "pricing_tier_id": "imagen-4-standard",
    "_invoice_status_note": "See recipes/image/invoice-status.json[imagen-4-standard]. ESTIMATE — needs invoice reconciliation."
  },
  "required_fields": {
    "prompt": { "type": "string", "required": true, "max_length": 4000 }
  },
  "optional_fields": {
    "negative_prompt": {
      "type": "string",
      "supported": true,
      "max_length": 500,
      "_note": "WaveSpeed Imagen route supports explicit negative_prompt. Use natural-language phrases."
    },
    "seed": { "type": "integer", "supported": true },
    "resolution": { "type": "enum", "enum": ["1K", "2K", "4K"], "default": "1K" },
    "num_images": { "type": "integer", "min": 1, "max": 4, "default": 1 },
    "enable_base64_output": { "type": "boolean", "default": false }
  },
  "negative_prompt_policy": {
    "strategy": "imagen_field",
    "_note": "Imagen 4 takes a separate negative prompt field, not inline in prompt. Pass natural-language phrases there."
  },
  "reference_syntax": {
    "method": "none",
    "max_references": 0,
    "_note": "WaveSpeed Imagen 4 text-to-image route does not document image_urls."
  },
  "official_prompt_template": {
    "_format": "structured-object",
    "slots": ["subject", "context_and_background", "style"],
    "_ordering": "natural-language descriptive prompt",
    "_renderer_id": "imagen_default"
  },
  "validator_rules": [
    {
      "id": "prompt_required",
      "kind": "length",
      "field": "prompt",
      "min": 1,
      "throws": "imagen-4-standard: prompt is required and must be non-empty"
    }
  ]
}

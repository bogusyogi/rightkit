          "required": true,
          "min": 0
        },
        {
          "param": "lora_size_class",
          "type": "string",
          "send": false,
          "required": true,
          "enum": [
            "up_to_2gb",
            "2_3gb",
            "3_4gb",
            "4_5gb"
          ]
        }
      ],
      "pricing": {
        "kind": "per_megapixel",
        "usd": 0.021,
        "megapixels_param": "megapixels",

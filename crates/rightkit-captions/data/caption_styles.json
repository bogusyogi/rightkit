      "max_width": { "landscape": 760, "portrait": 860 },
      "max_chars_per_line": 20,
      "max_lines": 2
    },
    {
      "id": "karaoke-pop", "name": "Karaoke pop",
      "description": "Uppercase bold white, the spoken word lights up yellow as it is said.",
      "font": { "landscape": 50, "portrait": 58 },
      "weight": "bold",
      "uppercase": true,
      "text_color": "#FFFFFF",
      "outline": { "color": "#000000", "pct": 10 },
      "shadow": { "color": "#000000", "alpha_pct": 70, "pct": 6 },
      "karaoke": { "highlight_color": "#FFE600", "mode": "active" },
      "anchor": { "landscape": 880, "portrait": 700 },
      "max_width": { "landscape": 760, "portrait": 860 },
      "max_chars_per_line": 20,
      "max_lines": 2
    },
    {
      "id": "karaoke-fill", "name": "Karaoke fill",
      "description": "Words fill in green on a dark box and stay lit until the cue ends.",
      "font": { "landscape": 44, "portrait": 50 },
      "weight": "bold",
      "text_color": "#FFFFFF",
      "box": { "color": "#000000", "alpha_pct": 70, "hpad_pct": 45, "vpad_pct": 40, "radius_pct": 28 },
      "karaoke": { "highlight_color": "#3DFF8A", "mode": "progressive" },
      "anchor": { "landscape": 900, "portrait": 740 },
      "max_width": { "landscape": 800, "portrait": 880 }
    },
    {
      "id": "card-classic", "name": "Caption card",
      "description": "The original CutRight caption card: bold white on a rounded 72 percent black card.",
      "font": { "landscape": 42, "portrait": 46 },
      "weight": "bold",
      "text_color": "#FFFFFF",
      "box": { "color": "#000000", "alpha_pct": 72, "hpad_pct": 70, "vpad_pct": 42, "radius_pct": 28 },
      "anchor": { "landscape": 900, "portrait": 760 },
      "max_width": { "landscape": 780, "portrait": 860 }

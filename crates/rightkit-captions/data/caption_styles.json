      "font": { "landscape": 46, "portrait": 52 },
      "weight": "bold",
      "text_color": "#FFFFFF",
      "outline": { "color": "#000000", "pct": 7 },
      "shadow": { "color": "#000000", "alpha_pct": 60, "pct": 5 },
      "anchor": { "landscape": 900, "portrait": 760 },
      "max_width": { "landscape": 800, "portrait": 880 }
    },
    {
      "id": "shorts-pop", "name": "Shorts pop",

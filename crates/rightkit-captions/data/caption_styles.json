      "weight": "bold",
      "text_color": "#FFFFFF",
      "emphasis_color": "#FFC400",
      "box": { "color": "#101820", "alpha_pct": 78, "hpad_pct": 70, "vpad_pct": 42, "radius_pct": 34 },
      "anchor": { "landscape": 900, "portrait": 760 },
      "max_width": { "landscape": 780, "portrait": 860 }
    },
    {
      "id": "minimal-lower", "name": "Minimal lower third",
      "description": "Small regular white text with a light shadow, no box.",
      "font": { "landscape": 36, "portrait": 40 },
      "weight": "regular",
      "text_color": "#FFFFFF",
      "shadow": { "color": "#000000", "alpha_pct": 80, "pct": 6 },
      "outline": { "color": "#000000", "pct": 4 },

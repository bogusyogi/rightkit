{
  "schema": "cutright.caption-styles.v1",
  "segmentation": {
    "landscape": { "max_chars_per_line": 42, "max_lines": 2, "max_chars_per_second": 21.0, "min_cue_ms": 600, "max_cue_ms": 7000, "max_gap_ms": 700 },
    "portrait":  { "max_chars_per_line": 24, "max_lines": 2, "max_chars_per_second": 18.0, "min_cue_ms": 600, "max_cue_ms": 4500, "max_gap_ms": 700 }
  },
  "styles": [
    {
      "id": "classic-box", "name": "Classic box",
      "description": "White text on a translucent black box (the default burn-in look).",
      "font": { "landscape": 42, "portrait": 46 },
      "weight": "regular",
      "text_color": "#FFFFFF",
      "box": { "color": "#000000", "alpha_pct": 60, "hpad_pct": 40, "vpad_pct": 40, "radius_pct": 0 },
      "anchor": { "landscape": 900, "portrait": 760 },
      "max_width": { "landscape": 800, "portrait": 880 }
    },
    {
      "id": "clean-outline", "name": "Clean outline",

<?xml version="1.0" encoding="utf-8"?>
<!-- Sample app manifest fragment (rightkit#209). The library declares no backup rules: the app
     points its <application> at the two files in res/xml/ (copy them into the app module). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/rightkit_backup_rules"
        android:dataExtractionRules="@xml/rightkit_data_extraction_rules" />
</manifest>

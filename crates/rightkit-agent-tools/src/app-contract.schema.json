{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rightkit-agent-tools/app-contract/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "schema",
    "app",
    "app_version",
    "bundle_id",
    "platforms",
    "exit_codes",
    "conventions",
    "tools"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "pattern": "\\S"
    },
    "contract_version": {
      "const": 2
    },
    "schema": {
      "const": "rightkit-agent-tools/app-contract/1"
    },
    "app": {
      "type": "string",
      "pattern": "\\S"
    },
    "app_version": {
      "type": "string",
      "pattern": "\\S"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "exit_codes": {
      "type": "object"
    },
    "conventions": {
      "type": "object"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "summary",
          "input_schema",
          "output_schema",
          "effect",
          "approval",
          "availability",
          "licence",
          "long_running",
          "idempotent"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "summary": {
            "type": "string",
            "pattern": "\\S"
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "events_schema": {
            "type": [
              "object",
              "null"
            ]
          },
          "effect": {
            "enum": [
              "read",
              "write",
              "external",
              "spend",
              "destroy"
            ]
          },
          "approval": {
            "enum": [
              "none",
              "yes",
              "in_app"
            ]
          },
          "availability": {
            "enum": [
              "engine",
              "host"
            ]
          },
          "licence": {
            "type": "string",
            "pattern": "\\S"
          },
          "long_running": {
            "type": "boolean"
          },
          "idempotent": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "effect": {
                  "enum": [
                    "external",
                    "destroy"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "approval": {
                  "enum": [
                    "yes",
                    "in_app"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "effect": {
                  "const": "spend"
                }
              }
            },
            "then": {
              "properties": {
                "approval": {
                  "const": "in_app"
                }
              }
            }
          }
        ]
      }
    }
  }
}

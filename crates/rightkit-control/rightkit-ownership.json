          "ecosystem": "cargo",
          "name": "rdev"
        },
        {
          "id": "control.cargo.uiautomation",
          "type": "dependency",
          "ecosystem": "cargo",
          "name": "uiautomation"
        },
        {
          "id": "control.cargo.accessibility-sys",
          "type": "dependency",
          "ecosystem": "cargo",
          "name": "accessibility-sys"
        },
        {
          "id": "control.npm.nut-js",
          "type": "dependency",
          "ecosystem": "npm",
          "name": "@nut-tree/nut-js"
        },
        {
          "id": "control.npm.robotjs",
          "type": "dependency",

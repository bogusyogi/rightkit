{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RightApp",
  "mainBinaryName": "rightapp",
  "version": "0.1.0",
  "identifier": "app.rightsuite.rightapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5190",
    "beforeDevCommand": "pnpm build:engine && pnpm dev",
    "beforeBuildCommand": "pnpm build && pnpm build:engine"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RightApp",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; frame-ancestors 'none'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**"] }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://PLACEHOLDER-UPDATE-HOST.invalid/rightapp/updates/latest.json"],
      "pubkey": "PLACEHOLDER-REPLACE-WITH-SUITE-UPDATER-PUBKEY",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Damned Ventures LLC",
    "externalBin": ["binaries/rightapp-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

{
  "schema": 1,
  "layerBoundaries": [
    {
      "id": "mail-behavior",
      "root": "packages/mail-ui/src",
      "from": {
        "include": ["views/useSidebarModel.ts", "views/useComposeSettingsModel.ts", "views/useStorageSettingsModel.ts"]
      },
      "forbid": {
        "include": ["**/*.tsx", "**/*.jsx", "**/*.css", "lib/theme.ts"]
      },
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts", ".css"]
    },
    {
      "id": "mail-appearance-behavior",
      "root": "packages/mail-ui/src",
      "from": {
        "include": ["lib/theme.ts"]
      },
      "forbid": {
        "include": ["**/*.tsx", "**/*.jsx", "**/*.css"]
      },
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts", ".css"]
    },
    {
      "id": "video-workspace-behavior",
      "root": "packages/video-ui/src",
      "from": {
        "include": ["workspace.ts"]
      },
      "forbid": {
        "include": ["**/*.tsx", "**/*.jsx", "**/*.css", "app/lib/shell.ts"]
      },
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts", ".css"]
    }
  ]
}

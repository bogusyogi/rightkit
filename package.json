{
  "name": "rightkit-shared",
  "private": true,
  "description": "Canonical source workspace for shared RightKit npm packages and Rust crates.",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "test:pdf-ui": "pnpm --filter @rightkit/pdf-ui test",
    "test:doc-render": "pnpm --filter @rightkit/doc-render test",
    "test:settings-ui": "pnpm --filter @rightkit/settings-ui test",
    "test:onboarding": "pnpm --filter @rightkit/onboarding test",
    "test": "pnpm run test:legal && pnpm run test:legal-ui && pnpm run test:license && pnpm run test:logs && pnpm run test:platform-ui && pnpm run test:tauri && pnpm run test:updates && pnpm run test:agent-room-mcp",
    "test:release": "pnpm --dir packages/release test",
    "test:git": "pnpm --dir packages/git test",
    "test:hooks": "pnpm --dir packages/hooks test",
    "test:ax": "pnpm --dir packages/ax test",
    "test:legal": "pnpm --dir packages/legal test",
    "test:legal-ui": "pnpm --dir packages/legal-ui test",
    "test:license": "pnpm --dir packages/license test",
    "test:logs": "pnpm --dir packages/logs test",
    "test:platform-ui": "pnpm --dir packages/platform-ui test",
    "test:tauri": "pnpm --dir packages/tauri test",
    "test:updates": "pnpm --dir packages/updates test",
    "test:agent-room-mcp": "pnpm --dir packages/agent-room-mcp test",
    "doctor:release": "pnpm --dir packages/release doctor:all",
    "test:qa": "pnpm --dir packages/qa test",
    "test:build-control-phase0": "pnpm --dir packages/build-control-phase0 test",
    "run:build-control-phase0": "pnpm --dir packages/build-control-phase0 run run",
    "test:build-control": "pnpm --dir packages/build-control-core test && pnpm --dir packages/build-control-broker test && pnpm --dir packages/build-control-clients test && pnpm --dir packages/build-control-policy test && pnpm --dir packages/build-control-staging test",
    "test:swift-contracts": "node --test swift/contracts/contracts.test.mjs",
    "build:qa": "pnpm --dir packages/qa build",
    "build:license": "pnpm --dir packages/license build",
    "build:logs": "pnpm --dir packages/logs build",
    "build:tauri": "pnpm --dir packages/tauri build",
    "build:updates": "pnpm --dir packages/updates build"
  }
}

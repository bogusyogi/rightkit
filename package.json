{
  "name": "rightkit-shared",
  "private": true,
  "description": "Canonical source workspace for shared RightKit npm packages and Rust crates.",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "test:release": "pnpm --dir packages/release test",
    "test:git": "pnpm --dir packages/git test",
    "test:ax": "pnpm --dir packages/ax test",
    "doctor:release": "pnpm --dir packages/release doctor:all",
    "test:qa": "pnpm --dir packages/qa test",
    "test:swift-contracts": "node --test swift/contracts/contracts.test.mjs",
    "build:qa": "pnpm --dir packages/qa build",
    "build:license": "pnpm --dir packages/license build",
    "build:logs": "pnpm --dir packages/logs build",
    "build:tauri": "pnpm --dir packages/tauri build",
    "build:updates": "pnpm --dir packages/updates build"
  }
}

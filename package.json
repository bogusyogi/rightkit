{
  "name": "rightkit-shared",
  "private": true,
  "description": "Canonical source workspace for shared RightKit npm packages and Rust crates.",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:pdf-ui": "pnpm --filter @rightkit/pdf-ui test",
    "test:doc-render": "pnpm --filter @rightkit/doc-render test",
    "test:settings-ui": "pnpm --filter @rightkit/settings-ui test",
    "test:onboarding": "pnpm --filter @rightkit/onboarding test",
    "test": "node scripts/check-syntax.mjs && pnpm run test:legal && pnpm run test:legal-ui && pnpm run test:license && pnpm run test:logs && pnpm run test:platform-ui && pnpm run test:tauri && pnpm run test:app-update && pnpm run test:release && pnpm run test:ci && pnpm run test:hooks && pnpm run test:ax && pnpm run test:qa && pnpm run test:doc-render && pnpm run test:pdf-ui && pnpm run test:settings-ui && pnpm run test:onboarding && pnpm run test:theme && pnpm run test:react-shell && pnpm run test:i18n && pnpm run test:media-ui && pnpm run test:qa-chrome && pnpm run test:ownership-approval && pnpm run test:characterization && pnpm run test:infrastructure",
    "test:theme": "pnpm --dir packages/theme test",
    "test:react-shell": "pnpm --dir packages/react-shell test",
    "test:i18n": "pnpm --dir packages/i18n test",
    "test:media-ui": "pnpm --dir packages/media-ui test",
    "test:qa-chrome": "pnpm --dir packages/qa-chrome test",
    "test:ownership-approval": "node --test \"ownership-approval/**/*.test.mjs\"",
    "test:characterization": "node --test \"characterization/**/*.test.mjs\"",
    "test:infrastructure": "node --test \"infrastructure/**/*.test.mjs\"",
    "test:release": "pnpm --dir packages/release test",
    "test:ci": "pnpm --dir packages/ci test",
    "test:hooks": "pnpm --dir packages/hooks test",
    "test:ax": "pnpm --dir packages/ax test",
    "test:legal": "pnpm --dir packages/legal test",
    "test:legal-ui": "pnpm --dir packages/legal-ui test",
    "test:license": "pnpm --dir packages/license test",
    "test:logs": "pnpm --dir packages/logs test",
    "test:platform-ui": "pnpm --dir packages/platform-ui test",
    "test:tauri": "pnpm --dir packages/tauri test",
    "test:app-update": "pnpm --dir packages/app-update test",
    "doctor:release": "pnpm --dir packages/release doctor:all",
    "test:qa": "pnpm --dir packages/qa test",
    "test:build-control": "pnpm --dir packages/build-control-policy test",
    "test:swift-contracts": "node --test swift/contracts/contracts.test.mjs",
    "build:qa": "pnpm --dir packages/qa build",
    "build:license": "pnpm --dir packages/license build",
    "build:logs": "pnpm --dir packages/logs build",
    "build:tauri": "pnpm --dir packages/tauri build",
    "build:app-update": "pnpm --dir packages/app-update build",
    "test:ci-gate": "node --test \"scripts/ci/*.test.mjs\""
  },
  "devDependencies": {
    "@rightkit/ci": "workspace:*",
    "@rightkit/release": "workspace:*"
  }
}
